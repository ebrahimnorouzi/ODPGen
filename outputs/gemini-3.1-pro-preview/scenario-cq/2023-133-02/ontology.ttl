@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "kHealth-Asthma Causal Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern representing pediatric asthma patients, their symptoms, medication intake, outdoor environmental allergens, and weighted causal relations between these factors." .

### Classes ###

:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "A pediatric asthma patient participating in the continuous self-monitoring project." .

:AsthmaSymptom a owl:Class ;
    rdfs:label "Asthma Symptom" ;
    rdfs:comment "A symptom experienced by an asthma patient." .

:Cough a owl:Class ;
    rdfs:subClassOf :AsthmaSymptom ;
    rdfs:label "Cough" ;
    rdfs:comment "A cough symptom experienced by the patient." .

:ChestTightness a owl:Class ;
    rdfs:subClassOf :AsthmaSymptom ;
    rdfs:label "Chest Tightness" ;
    rdfs:comment "A chest tightness symptom experienced by the patient." .

:Wheezing a owl:Class ;
    rdfs:subClassOf :AsthmaSymptom ;
    rdfs:label "Wheezing" ;
    rdfs:comment "A wheezing symptom experienced by the patient." .

:BreathingPattern a owl:Class ;
    rdfs:subClassOf :AsthmaSymptom ;
    rdfs:label "Breathing Pattern" ;
    rdfs:comment "A breathing pattern symptom or anomaly experienced by the patient." .

:MedicationIntake a owl:Class ;
    rdfs:label "Medication Intake" ;
    rdfs:comment "The event or record of a patient taking asthma medication." .

:OutdoorEnvironmentalAllergen a owl:Class ;
    rdfs:label "Outdoor Environmental Allergen" ;
    rdfs:comment "An outdoor environment feature or allergen, such as pollen or AQI, that affects the patient." .

:Pollen a owl:Class ;
    rdfs:subClassOf :OutdoorEnvironmentalAllergen ;
    rdfs:label "Pollen" ;
    rdfs:comment "Pollen present in the outdoor environment." .

:AQI a owl:Class ;
    rdfs:subClassOf :OutdoorEnvironmentalAllergen ;
    rdfs:label "AQI" ;
    rdfs:comment "Air Quality Index (AQI) feature of the outdoor environment, treated as an allergen/causal factor in this model." .

:CausalRelation a owl:Class ;
    rdfs:label "Causal Relation" ;
    rdfs:comment "A reified causal edge representing a cause-and-effect relationship with an associated weight." .

### Object Properties ###

:experiencesSymptom a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :AsthmaSymptom ;
    rdfs:label "experiences symptom" ;
    rdfs:comment "Relates a patient to an asthma symptom they experience." .

:hasMedicationIntake a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :MedicationIntake ;
    rdfs:label "has medication intake" ;
    rdfs:comment "Relates a patient to their intake of medication." .

:isExposedTo a owl:ObjectProperty ;
    rdfs:domain :Patient ;
    rdfs:range :OutdoorEnvironmentalAllergen ;
    rdfs:label "is exposed to" ;
    rdfs:comment "Relates a patient to an outdoor environmental allergen they are exposed to." .

:hasCause a owl:ObjectProperty ;
    rdfs:domain :CausalRelation ;
    rdfs:label "has cause" ;
    rdfs:comment "Indicates the source or cause in a causal relation (e.g., an allergen or symptom)." .

:hasEffect a owl:ObjectProperty ;
    rdfs:domain :CausalRelation ;
    rdfs:label "has effect" ;
    rdfs:comment "Indicates the outcome or effect in a causal relation (e.g., a symptom or medication intake)." .

### Datatype Properties ###

:hasEffectWeight a owl:DatatypeProperty ;
    rdfs:domain :CausalRelation ;
    rdfs:range xsd:decimal ;
    rdfs:label "has effect weight" ;
    rdfs:comment "The numerical weight of the causal effect." .