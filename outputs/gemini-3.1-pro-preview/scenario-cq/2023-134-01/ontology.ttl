@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Solid App Governance Ontology Design Pattern" ;
    rdfs:comment "An OWL ontology design pattern representing governance, privacy policies, and data access requests in Solid applications." .

# ---------------------------------------------------------
# Classes
# ---------------------------------------------------------

:SolidActor a owl:Class ;
    rdfs:label "Solid Actor" ;
    rdfs:comment "An entity participating in the Solid ecosystem, such as a user or provider." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "The role assumed by a Solid actor." .

:User a owl:Class ;
    rdfs:subClassOf :SolidActor ;
    rdfs:label "User" ;
    rdfs:comment "A person or entity that uses Solid apps and owns a Pod." .

:PodProvider a owl:Class ;
    rdfs:subClassOf :SolidActor ;
    rdfs:label "Pod Provider" ;
    rdfs:comment "An entity that provides Solid Pod infrastructure." .

:AppProvider a owl:Class ;
    rdfs:subClassOf :SolidActor ;
    rdfs:label "App Provider" ;
    rdfs:comment "An entity that provides a Solid application." .

:Pod a owl:Class ;
    rdfs:label "Pod" ;
    rdfs:comment "A personal online data store in the Solid ecosystem." .

:SolidSpecification a owl:Class ;
    rdfs:label "Solid Specification" ;
    rdfs:comment "A technical specification that a Pod infrastructure complies with." .

:Functionality a owl:Class ;
    rdfs:label "Functionality" ;
    rdfs:comment "A specific feature or capability installed within a Pod." .

:DataCategory a owl:Class ;
    rdfs:label "Data Category" ;
    rdfs:comment "A classification of data stored in a Pod." .

:PersonalData a owl:Class ;
    rdfs:subClassOf :DataCategory ;
    rdfs:label "Personal Data" ;
    rdfs:comment "Data that relates to an identified or identifiable living individual." .

:App a owl:Class ;
    rdfs:label "App" ;
    rdfs:comment "A Solid application or service used to access data." .

:PrivacyNotice a owl:Class ;
    rdfs:label "Privacy Notice" ;
    rdfs:comment "A machine-readable declaration of data handling practices." .

:DataRequirement a owl:Class ;
    rdfs:label "Data Requirement" ;
    rdfs:comment "A declaration of the data an app needs to function." .

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A set of rules or preferences governing data access and usage." .

:PrivacyPolicy a owl:Class ;
    rdfs:subClassOf :Policy ;
    rdfs:label "Privacy Policy" ;
    rdfs:comment "A policy specifically expressing privacy preferences and requirements." .

:PrivacyPreference a owl:Class ;
    rdfs:label "Privacy Preference" ;
    rdfs:comment "A user's specific preference regarding their privacy." .

:DataRequest a owl:Class ;
    rdfs:label "Data Request" ;
    rdfs:comment "An incoming request from an app or actor to access data." .

:Decision a owl:Class ;
    rdfs:label "Decision" ;
    rdfs:comment "A user's decision regarding a data request or data use." .

:ProvenanceMetadata a owl:Class ;
    rdfs:label "Provenance Metadata" ;
    rdfs:comment "Records kept for accountability, logging, and auditing." .