@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Maritime Ship Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing ships, their physical dimensions, trajectories, propulsion systems, and associated heterogeneous data sources in the maritime domain." .

### Classes ###

:Ship a owl:Class ;
    rdfs:label "Ship" ;
    rdfs:comment "A large watercraft that travels the world's oceans and other sufficiently deep waterways." .

:ContainerShip a owl:Class ;
    rdfs:subClassOf :Ship ;
    rdfs:label "Container Ship" ;
    rdfs:comment "A ship designed specifically to hold cargo in standard containers." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organized body of people with a particular purpose, such as a company or society that can own ships." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human being, capable of owning a ship." .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographical place or area where a ship is typically located." .

:Route a owl:Class ;
    rdfs:label "Route" ;
    rdfs:comment "A sequence of waypoints or a path planned or taken by a ship." .

:PredictedRoute a owl:Class ;
    rdfs:subClassOf :Route ;
    rdfs:label "Predicted Route" ;
    rdfs:comment "A route that a ship is expected or forecasted to take." .

:Trajectory a owl:Class ;
    rdfs:label "Trajectory" ;
    rdfs:comment "The path followed by a ship moving through space over time." .

:TrajectoryPart a owl:Class ;
    rdfs:label "Trajectory Part" ;
    rdfs:comment "A specific segment or portion of a ship's trajectory." .

:Dimension a owl:Class ;
    rdfs:label "Dimension" ;
    rdfs:comment "The physical measurements of a ship, such as length, width, and depth." .

:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:comment "A standard of measurement, such as meters or knots." .

:GPSAntenna a owl:Class ;
    rdfs:label "GPS Antenna" ;
    rdfs:comment "A device used to receive signals from GPS satellites, placed on a ship." .

:ShipStructure a owl:Class ;
    rdfs:label "Ship Structure" ;
    rdfs:comment "A structural part or section of a ship." .

:Bow a owl:Class ;
    rdfs:subClassOf :ShipStructure ;
    rdfs:label "Bow" ;
    rdfs:comment "The forward part of the hull of a ship." .

:Stern a owl:Class ;
    rdfs:subClassOf :ShipStructure ;
    rdfs:label "Stern" ;
    rdfs:comment "The back or aft-most part of a ship." .

:Port a owl:Class ;
    rdfs:subClassOf :ShipStructure ;
    rdfs:label "Port" ;
    rdfs:comment "The left side of a ship when facing forward." .

:Starboard a owl:Class ;
    rdfs:subClassOf :ShipStructure ;
    rdfs:label "Starboard" ;
    rdfs:comment "The right side of a ship when facing forward." .

:Engine a owl:Class ;
    rdfs:label "Engine" ;
    rdfs:comment "A machine with moving parts that converts power into motion to drive a ship." .

:ElectricEngine a owl:Class ;
    rdfs:subClassOf :Engine ;
    rdfs:label "Electric Engine" ;
    rdfs:comment "An engine powered exclusively by electricity." .

:Fuel a owl:Class ;
    rdfs:label "Fuel" ;
    rdfs:comment "Material such as coal, gas, or oil that is burned to produce heat or power for an engine." .

:PropulsionSystem a owl:Class ;
    rdfs:label "Propulsion System" ;
    rdfs:comment "The complete system used to generate thrust to move a ship." .

:NonMotorizedPropulsionSystem a owl:Class ;
    rdfs:subClassOf :PropulsionSystem ;
    rdfs:label "Non-Motorized Propulsion System" ;
    rdfs:comment "A propulsion system that does not rely on an engine." .

:PropulsionTechnology a owl:Class ;
    rdfs:label "Propulsion Technology" ;
    rdfs:comment "The specific technological method or principle used for propulsion." .

:MotorizedPropulsionTechnology a owl:Class ;
    rdfs:subClassOf :PropulsionTechnology ;
    rdfs:label "Motorized Propulsion Technology" ;
    rdfs:comment "Propulsion technology powered by engines." .

:WindAssistedPropulsion a owl:Class ;
    rdfs:subClassOf :PropulsionTechnology ;
    rdfs:label "Wind Assisted Propulsion" ;
    rdfs:comment "Propulsion technology that uses wind to assist motorized propulsion." .

:Propulsor a owl:Class ;
    rdfs:label "Propulsor" ;
    rdfs:comment "A mechanical device that gives propulsion." .

:JetPropulsor a owl:Class ;
    rdfs:subClassOf :Propulsor ;
    rdfs:label "Jet Propulsor" ;
    rdfs:comment "A propulsor that creates thrust by ejecting a jet of fluid." .

:BladedPropulsor a owl:Class ;
    rdfs:subClassOf :Propulsor ;
    rdfs:label "Bladed Propulsor" ;
    rdfs:comment "A propulsor utilizing blades to generate thrust." .

:SpecialDesignBladedPropulsor a owl:Class ;
    rdfs:subClassOf :BladedPropulsor ;
    rdfs:label "Special Design Bladed Propulsor" ;
    rdfs:comment "A bladed propulsor that follows a specialized or non-standard design." .

:Propeller a owl:Class ;
    rdfs:subClassOf :BladedPropulsor ;
    rdfs:label "Propeller" ;
    rdfs:comment "A type of fan that transmits power by converting rotational motion into thrust." .

:ScrewPropeller a owl:Class ;
    rdfs:subClassOf :Propeller ;
    rdfs:label "Screw Propeller" ;
    rdfs:comment "A propeller with helical blades rotating around a shaft." .

:FixedPitchPropeller a owl:Class ;
    rdfs:subClassOf :Propeller ;
    rdfs:label "Fixed Pitch Propeller" ;
    rdfs:comment "A propeller whose blade pitch cannot be altered." .

:SupercavitatingPropeller a owl:Class ;
    rdfs:subClassOf :Propeller ;
    rdfs:label "Supercavitating Propeller" ;
    rdfs:comment "A propeller designed to operate efficiently under supercavitating conditions." .

:Sail a owl:Class ;
    rdfs:subClassOf :Propulsor ;
    rdfs:label "Sail" ;
    rdfs:comment "A piece of material extended on a mast to catch the wind and propel a boat or ship." .

:CavitationPreventionMechanism a owl:Class ;
    rdfs:label "Cavitation Prevention Mechanism" ;
    rdfs:comment "A mechanism or design feature used to prevent cavitation on motorized propulsion technologies." .

:ShipData a owl:Class ;
    rdfs:label "Ship Data" ;
    rdfs:comment "Heterogeneous data representing information about a ship." .

:SonarData a owl:Class ;
    rdfs:subClassOf :ShipData ;
    rdfs:label "Sonar Data" ;
    rdfs:comment "Acoustic data or signatures representing how a ship sounds on sonar." .

:ImageData a owl:Class ;
    rdfs:subClassOf :ShipData ;
    rdfs:label "Image Data" ;
    rdfs:comment "Visual resources or pictures showing what a ship looks like." .

:TextualData a owl:Class ;
    rdfs:subClassOf :ShipData ;
    rdfs:label "Textual Data" ;
    rdfs:comment "Written descriptions or textual information about a ship." .

### Object Properties ###

:hasDimension a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :Dimension ;
    rdfs:label "has dimension" ;
    rdfs:comment "Relates a ship to its physical dimensions." .

:hasUnit a owl:ObjectProperty ;
    rdfs:range :Unit ;
    rdfs:label "has unit" ;
    rdfs:comment "Relates a measurement (like draught) to its unit of measure." .

:hasTypicalLocation a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :Location ;
    rdfs:label "has typical location" ;
    rdfs:comment "Relates a ship to its typical geographical location." .

:hasOwner a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:label "has owner" ;
    rdfs:comment "Relates a ship to its owner (Person or Organization)." .

:ownsShip a owl:ObjectProperty ;
    owl:inverseOf :hasOwner ;
    rdfs:range :Ship ;
    rdfs:label "owns ship" ;
    rdfs:comment "Relates an owner to the ship they own." .

:hasRelativePlacement a owl:ObjectProperty ;
    rdfs:domain :GPSAntenna ;
    rdfs:range :ShipStructure ;
    rdfs:label "has relative placement" ;
    rdfs:comment "Describes where a GPS antenna is placed relative to the ship's structure." .

:hasRoute a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :Route ;
    rdfs:label "has route" ;
    rdfs:comment "Relates a ship to a route it takes." .

:hasPredictedRoute a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :PredictedRoute ;
    rdfs:label "has predicted route" ;
    rdfs:comment "Relates a ship to its forecasted route." .

:hasTrajectory a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :Trajectory ;
    rdfs:label "has trajectory" ;
    rdfs:comment "Relates a ship to its trajectory." .

:hasTrajectoryPart a owl:ObjectProperty ;
    rdfs:domain :Trajectory ;
    rdfs:range :TrajectoryPart ;
    rdfs:label "has trajectory part" ;
    rdfs:comment "Relates a trajectory to a specific segment of it." .

:hasEngine a owl:ObjectProperty ;
    rdfs:domain :Ship ;
    rdfs:range :Engine ;
    rdfs:label "has engine" ;
    rdfs:comment "Relates a ship to an engine installed on it." .

:poweredBy a owl:ObjectProperty ;
    rdfs:domain :Engine ;
    rdfs:range :Fuel ;
    rdfs:label "powered by" ;
    rdfs:comment "Relates an engine to the fuel or power source it uses." .

:drives a owl:ObjectProperty ;
    rdfs:domain :Engine ;
    rdfs:range :Propulsor ;
    rdfs:label "drives" ;
    rdfs:comment "Relates an engine to the propulsor it drives." .