@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Evaluation Request Context Ontology Design Pattern" ;
    rdfs:comment "An ODP representing evaluation requests, their target assets, actions, assignees, issuers, and associated contextual constraints (temporal, spatial, role, capability)." .

# --- Classes ---

:EvaluationRequest a owl:Class ;
    rdfs:label "Evaluation Request" ;
    rdfs:comment "A formal request for an action to be evaluated against contextual constraints." .

:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "The requested action to be performed on a target asset." .

:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "An entity, such as an assignee or issuer, involved in the evaluation request." .

:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "The target asset upon which the requested action is to be performed." .

:Context a owl:Class ;
    rdfs:label "Context" ;
    rdfs:comment "Contextual information used to further constrain the evaluation request." .

:TemporalContext a owl:Class ;
    rdfs:subClassOf :Context ;
    rdfs:label "Temporal Context" ;
    rdfs:comment "Time-based constraints for the evaluation request (e.g., weekdays)." .

:SpatialContext a owl:Class ;
    rdfs:subClassOf :Context ;
    rdfs:label "Spatial Context" ;
    rdfs:comment "Location-based constraints for the evaluation request (e.g., EU)." .

:RoleContext a owl:Class ;
    rdfs:subClassOf :Context ;
    rdfs:label "Role Context" ;
    rdfs:comment "Role-based constraints for the evaluation request (e.g., employee)." .

:CapabilityContext a owl:Class ;
    rdfs:subClassOf :Context ;
    rdfs:label "Capability Context" ;
    rdfs:comment "Request-capability constraints for the evaluation request." .

# --- Object Properties ---

:hasAction a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range :Action ;
    rdfs:label "has action" ;
    rdfs:comment "Links an evaluation request to the specific action being requested." .

:hasIssuer a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range :Party ;
    rdfs:label "has issuer" ;
    rdfs:comment "Links an evaluation request to the party that issued it." .

:hasAssignee a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range :Party ;
    rdfs:label "has assignee" ;
    rdfs:comment "Links an evaluation request to the party assigned to perform the action." .

:hasTargetAsset a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range :Asset ;
    rdfs:label "has target asset" ;
    rdfs:comment "Links an evaluation request to the asset targeted by the action." .

:hasContext a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range :Context ;
    rdfs:label "has context" ;
    rdfs:comment "Links an evaluation request to its contextual constraints." .

# --- Datatype Properties ---

:issuedAt a owl:DatatypeProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:range xsd:dateTime ;
    rdfs:label "issued at" ;
    rdfs:comment "The date and time when the evaluation request was issued." .