@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Solid App Governance Pattern" ;
    rdfs:comment "An ontology design pattern for governing Solid apps, focusing on data registries, storage locations, and privacy policies." .

:SolidActor a owl:Class ;
    rdfs:label "Solid Actor" ;
    rdfs:comment "An entity (such as a user, app provider, or Pod provider) participating in the Solid ecosystem." .

:DataRegistry a owl:Class ;
    rdfs:label "Data Registry" ;
    rdfs:comment "A registry used to discover categories of data, their locations, and associated policies." .

:DataCategory a owl:Class ;
    rdfs:label "Data Category" ;
    rdfs:comment "A specific type or category of data available within the Solid ecosystem." .

:Pod a owl:Class ;
    rdfs:label "Pod" ;
    rdfs:comment "A personal online data store in the Solid ecosystem where data is stored." .

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A policy expressing privacy preferences, requirements, or data handling practices." .

:maintainedBy a owl:ObjectProperty ;
    rdfs:label "maintained by" ;
    rdfs:comment "Indicates the Solid Actor responsible for maintaining the registry." ;
    rdfs:domain :DataRegistry ;
    rdfs:range :SolidActor .

:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:comment "The date and time when the registry was created." ;
    rdfs:domain :DataRegistry ;
    rdfs:range xsd:dateTime .

:updatedAt a owl:DatatypeProperty ;
    rdfs:label "updated at" ;
    rdfs:comment "The date and time when the registry was last updated." ;
    rdfs:domain :DataRegistry ;
    rdfs:range xsd:dateTime .

:hasDataCategory a owl:ObjectProperty ;
    rdfs:label "has data category" ;
    rdfs:comment "Links a registry to the categories of data it makes available for discovery." ;
    rdfs:domain :DataRegistry ;
    rdfs:range :DataCategory .

:storedAt a owl:ObjectProperty ;
    rdfs:label "stored at" ;
    rdfs:comment "Indicates the Pod or storage location where a specific category of data is stored." ;
    rdfs:domain :DataCategory ;
    rdfs:range :Pod .

:hasPolicy a owl:ObjectProperty ;
    rdfs:label "has policy" ;
    rdfs:comment "Associates a data category or resource with a specific privacy policy." ;
    rdfs:domain :DataCategory ;
    rdfs:range :Policy .