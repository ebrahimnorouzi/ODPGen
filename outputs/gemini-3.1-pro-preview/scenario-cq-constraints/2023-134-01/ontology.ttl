@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Solid App Governance Policy Pattern" ;
    rdfs:comment "An ontology design pattern for representing privacy policies, data access requests, and governance metadata in Solid applications." .

# --- Classes ---

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A privacy or access policy expressing preferences, requirements, or consent." .

:Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "An entity (user, provider, etc.) interacting with the Solid ecosystem." .

:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "A Solid application or service used to access data." .

:AccessMode a owl:Class ;
    rdfs:label "Access Mode" ;
    rdfs:comment "The mode of access requested or granted (e.g., read, write)." .

:PersonalData a owl:Class ;
    rdfs:label "Personal Data" ;
    rdfs:comment "Personal data stored within a Solid Pod." .

:Purpose a owl:Class ;
    rdfs:label "Purpose" ;
    rdfs:comment "The specific purpose for which data access is requested or granted." .

:Pod a owl:Class ;
    rdfs:label "Pod" ;
    rdfs:comment "A personal online data store in the Solid ecosystem." .

:LogEntry a owl:Class ;
    rdfs:label "Log Entry" ;
    rdfs:comment "A record of data access or policy changes for accountability and compliance." .

# --- Object Properties ---

:hasCreator a owl:ObjectProperty ;
    rdfs:label "has creator" ;
    rdfs:comment "Links a policy to the actor who created it." ;
    rdfs:domain :Policy ;
    rdfs:range :Actor .

:hasAssignee a owl:ObjectProperty ;
    rdfs:label "has assignee" ;
    rdfs:comment "Links a policy to the actor it is assigned to or targets." ;
    rdfs:domain :Policy ;
    rdfs:range :Actor .

:usedApplication a owl:ObjectProperty ;
    rdfs:label "used application" ;
    rdfs:comment "Indicates the application used to access data under a policy." ;
    rdfs:domain :Policy ;
    rdfs:range :Application .

:hasAccessMode a owl:ObjectProperty ;
    rdfs:label "has access mode" ;
    rdfs:comment "Specifies the access mode granted or requested by the policy." ;
    rdfs:domain :Policy ;
    rdfs:range :AccessMode .

:targetsPersonalData a owl:ObjectProperty ;
    rdfs:label "targets personal data" ;
    rdfs:comment "Indicates the personal data governed by the policy." ;
    rdfs:domain :Policy ;
    rdfs:range :PersonalData .

:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    rdfs:comment "Specifies the purpose for data access." ;
    rdfs:domain :Policy ;
    rdfs:range :Purpose .

:storedIn a owl:ObjectProperty ;
    rdfs:label "stored in" ;
    rdfs:comment "Indicates the Pod where the personal data is stored." ;
    rdfs:domain :PersonalData ;
    rdfs:range :Pod .

# --- Datatype Properties ---

:policyIdentifier a owl:DatatypeProperty ;
    rdfs:label "policy identifier" ;
    rdfs:comment "A unique identifier for the policy." ;
    rdfs:domain :Policy ;
    rdfs:range xsd:string .

:issuedDate a owl:DatatypeProperty ;
    rdfs:label "issued date" ;
    rdfs:comment "The date and time when the policy was issued." ;
    rdfs:domain :Policy ;
    rdfs:range xsd:dateTime .