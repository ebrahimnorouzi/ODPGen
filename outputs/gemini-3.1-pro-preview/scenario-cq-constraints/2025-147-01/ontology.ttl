@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Maritime Ship Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing ships, their trajectories, propulsion systems, and data representations in the maritime domain." .

# --- Classes ---

:Ship a owl:Class ;
    rdfs:label "Ship" ;
    rdfs:comment "A large watercraft used in the maritime domain." .

:ContainerShip a owl:Class ;
    rdfs:subClassOf :Ship ;
    rdfs:label "Container Ship" ;
    rdfs:comment "A ship specifically designed to carry goods in containers." .

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity such as a company or institution that can own a ship." .

:Dimension a owl:Class ;
    rdfs:label "Dimension" ;
    rdfs:comment "A measurable physical extent of a ship." .

:Draught a owl:Class ;
    rdfs:subClassOf :Dimension ;
    rdfs:label "Draught" ;
    rdfs:comment "The vertical distance between the waterline and the bottom of the hull." .

:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:comment "A standard of measurement for dimensions." .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographical place or position of a ship." .

:Route a owl:Class ;
    rdfs:label "Route" ;
    rdfs:comment "A path or course taken or predicted to be taken by a ship." .

:Trajectory a owl:Class ;
    rdfs:label "Trajectory" ;
    rdfs:comment "The actual path followed by a moving ship over time." .

:TrajectoryPart a owl:Class ;
    rdfs:label "Trajectory Part" ;
    rdfs:comment "A specific segment or part of a trajectory." .

:GPSAntenna a owl:Class ;
    rdfs:label "GPS Antenna" ;
    rdfs:comment "An antenna used to receive GPS signals for positioning." .

:ShipStructure a owl:Class ;
    rdfs:label "Ship Structure" ;
    rdfs:comment "A structural part or area of a ship (e.g., bow, stern, port, starboard)." .

:Engine a owl:Class ;
    rdfs:label "Engine" ;
    rdfs:comment "A machine that converts power into motion to drive a ship." .

:ElectricEngine a owl:Class ;
    rdfs:subClassOf :Engine ;
    rdfs:label "Electric Engine" ;
    rdfs:comment "An engine powered exclusively by electricity." .

:Fuel a owl:Class ;
    rdfs:label "Fuel" ;
    rdfs:comment "Material consumed by an engine to produce power." .

:PropulsionSystem a owl:Class ;
    rdfs:label "Propulsion System" ;
    rdfs:comment "A complete system that provides thrust to move a ship." .

:PropulsionTechnology a owl:Class ;
    rdfs:label "Propulsion Technology" ;
    rdfs:comment "The underlying technological principle used for propulsion." .

:MotorizedPropulsion a owl:Class ;
    rdfs:subClassOf :PropulsionTechnology ;
    rdfs:label "Motorized Propulsion" ;
    rdfs:comment "Propulsion technology that is powered by an engine." .

:WindPropulsion a owl:Class ;
    rdfs:subClassOf :PropulsionTechnology ;
    rdfs:label "Wind Propulsion" ;
    rdfs:comment "Propulsion technology that utilizes wind power." .

:Propulsor a owl:Class ;
    rdfs:label "Propulsor" ;
    rdfs:comment "A mechanical device (e.g., propeller, jet) that imparts momentum to a fluid to generate thrust." .

:JetPropulsor a owl:Class ;
    rdfs:subClassOf :Propulsor ;
    rdfs:label "Jet Propulsor" ;
    rdfs:comment "A propulsor that generates thrust using a jet of fluid." .

:BladedPropulsor a owl:Class ;
    rdfs:subClassOf :Propulsor ;
    rdfs:label "Bladed Propulsor" ;
    rdfs:comment "A propulsor equipped with blades." .

:ScrewPropeller a owl:Class ;
    rdfs:subClassOf :BladedPropulsor ;
    rdfs:label "Screw Propeller" ;
    rdfs:comment "A bladed propulsor with helical blades." .