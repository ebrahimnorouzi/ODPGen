@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "ODRL Policy Evaluation Context Ontology" ;
    rdfs:comment "An ontology design pattern representing real-world context information for evaluating ODRL policies, including parties, assets, rules, actions, and events." .

### Classes ###

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A policy being evaluated." .

:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "An entity, such as a person or organization, involved in a policy." .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A physical or virtual location of a party." .

:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "A resource, such as a video stream, targeted by an action or policy." .

:AssetCollection a owl:Class ;
    rdfs:label "Asset Collection" ;
    rdfs:comment "A collection of assets governed by a policy." .

:PartyCollection a owl:Class ;
    rdfs:label "Party Collection" ;
    rdfs:comment "A collection of parties involved in a policy." .

:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "An operation performed or attempted on an asset." .

:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:comment "A rule within a policy that dictates permissions, prohibitions, or duties." .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An occurrence that has happened and may be relevant to policy evaluation." .

:Recipient a owl:Class ;
    rdfs:label "Recipient" ;
    rdfs:comment "An entity receiving the result of an exercised rule." .

:RecipientCategory a owl:Class ;
    rdfs:label "Recipient Category" ;
    rdfs:comment "A classification or grouping of recipients." .

:RuleResult a owl:Class ;
    rdfs:label "Rule Result" ;
    rdfs:comment "The outcome or artifact generated by exercising a rule." .

:FinancialPayment a owl:Class ;
    rdfs:label "Financial Payment" ;
    rdfs:comment "A monetary transaction made in relation to a policy or rule." .

:Purpose a owl:Class ;
    rdfs:label "Purpose" ;
    rdfs:comment "The reason or intent behind an action, such as an academic research project." .

### Object Properties ###

:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:comment "Relates a party to their location." ;
    rdfs:domain :Party ;
    rdfs:range :Location .

:hasAssetCollection a owl:ObjectProperty ;
    rdfs:label "has asset collection" ;
    rdfs:comment "Relates a policy to its collection of assets." ;
    rdfs:domain :Policy ;
    rdfs:range :AssetCollection .

:hasAsset a owl:ObjectProperty ;
    rdfs:label "has asset" ;
    rdfs:comment "Relates a collection to an individual asset." ;
    rdfs:domain :AssetCollection ;
    rdfs:range :Asset .

:hasPartyCollection a owl:ObjectProperty ;
    rdfs:label "has party collection" ;
    rdfs:comment "Relates a policy to its collection of parties." ;
    rdfs:domain :Policy ;
    rdfs:range :PartyCollection .

:hasParty a owl:ObjectProperty ;
    rdfs:label "has party" ;
    rdfs:comment "Relates a collection to an individual party." ;
    rdfs:domain :PartyCollection ;
    rdfs:range :Party .

:hasPurpose a owl:ObjectProperty ;
    rdfs:label "has purpose" ;
    rdfs:comment "Relates an action to its intended purpose." ;
    rdfs:domain :Action ;
    rdfs:range :Purpose .

:targetAsset a owl:ObjectProperty ;
    rdfs:label "target asset" ;
    rdfs:comment "Relates an action to the asset it affects." ;
    rdfs:domain :Action ;
    rdfs:range :Asset .

:hasResult a owl:ObjectProperty ;
    rdfs:label "has result" ;
    rdfs:comment "Relates a rule to the result produced when it is exercised." ;
    rdfs:domain :Rule ;
    rdfs:range :RuleResult .

:hasRecipient a owl:ObjectProperty ;
    rdfs:label "has recipient" ;
    rdfs:comment "Relates a rule result to its recipient." ;
    rdfs:domain :RuleResult ;
    rdfs:range :Recipient .

:hasRecipientCategory a owl:ObjectProperty ;
    rdfs:label "has recipient category" ;
    rdfs:comment "Relates a rule result to a category of recipients." ;
    rdfs:domain :RuleResult ;
    rdfs:range :RecipientCategory .

### Datatype Properties ###

:currentTime a owl:DatatypeProperty ;
    rdfs:label "current time" ;
    rdfs:comment "The current system or context time." ;
    rdfs:range xsd:dateTime .

:actionStatus a owl:DatatypeProperty ;
    rdfs:label "action status" ;
    rdfs:comment "The status of an action, such as 'performed' or 'attempted'." ;
    rdfs:domain :Action ;
    rdfs:range xsd:string .

:exercisedCount a owl:DatatypeProperty ;
    rdfs:label "exercised count" ;
    rdfs:comment "The number of times a rule has been exercised." ;
    rdfs:domain :Rule ;
    rdfs:range xsd:integer .

:exercisedDuration a owl:DatatypeProperty ;
    rdfs:label "exercised duration" ;
    rdfs:comment "The length of time a rule has been exercised." ;
    rdfs:domain :Rule ;
    rdfs:range xsd:string .

:eventInformation a owl:DatatypeProperty ;
    rdfs:label "event information" ;
    rdfs:comment "Details or data available about an event." ;
    rdfs:domain :Event ;
    rdfs:range xsd:string .

:paymentAmount a owl:DatatypeProperty ;
    rdfs:label "payment amount" ;
    rdfs:comment "The monetary value of a financial payment." ;
    rdfs:domain :FinancialPayment ;
    rdfs:range xsd:decimal .

:temporalStart a owl:DatatypeProperty ;
    rdfs:label "temporal start" ;
    rdfs:comment "The starting minute or time index for an action's access to an asset." ;
    rdfs:domain :Action ;
    rdfs:range xsd:decimal .

:temporalEnd a owl:DatatypeProperty ;
    rdfs:label "temporal end" ;
    rdfs:comment "The ending minute or time index for an action's access to an asset." ;
    rdfs:domain :Action ;
    rdfs:range xsd:decimal .