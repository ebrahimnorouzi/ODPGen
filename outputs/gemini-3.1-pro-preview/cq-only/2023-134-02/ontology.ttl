@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Data Logging and Interaction Ontology" ;
    rdfs:comment "An Ontology Design Pattern (ODP) representing logs, actions performed on data, and the entities and applications interacting with or generating that data." .

### Classes ###

:Log a owl:Class ;
    rdfs:label "Log" ;
    rdfs:comment "A record of an event, action, or interaction." .

:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "An operation or activity performed on data." .

:CreateAction a owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Create Action" ;
    rdfs:comment "An action representing the creation of new data." .

:UpdateAction a owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Update Action" ;
    rdfs:comment "An action representing the modification of existing data." .

:EraseAction a owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Erase Action" ;
    rdfs:comment "An action representing the deletion or erasure of data." .

:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:comment "The digital information or resource being acted upon, stored, or generated." .

:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "An actor, such as a user, organization, or agent, that interacts with data or publishes logs." .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "The physical or virtual storage environment where data is kept." .

:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "A software application or service utilized to generate data." .

### Object Properties ###

:hasAction a owl:ObjectProperty ;
    rdfs:domain :Log ;
    rdfs:range :Action ;
    rdfs:label "has action" ;
    rdfs:comment "Relates a log entry to the specific action it records." .

:actsOn a owl:ObjectProperty ;
    rdfs:domain :Action ;
    rdfs:range :Data ;
    rdfs:label "acts on" ;
    rdfs:comment "Relates an action to the data that is being affected by it." .

:interactsWith a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Data ;
    rdfs:label "interacts with" ;
    rdfs:comment "Relates an entity to the data it is interacting with." .

:publishedBy a owl:ObjectProperty ;
    rdfs:domain :Log ;
    rdfs:range :Entity ;
    rdfs:label "published by" ;
    rdfs:comment "Relates a log to the entity responsible for issuing or publishing it." .

:storedAt a owl:ObjectProperty ;
    rdfs:domain :Data ;
    rdfs:range :Location ;
    rdfs:label "stored at" ;
    rdfs:comment "Relates data to the location where it is currently stored." .

:generatedBy a owl:ObjectProperty ;
    rdfs:domain :Data ;
    rdfs:range :Application ;
    rdfs:label "generated by" ;
    rdfs:comment "Relates data to the application or service that created or generated it." .

### Datatype Properties ###

:issuedAt a owl:DatatypeProperty ;
    rdfs:domain :Log ;
    rdfs:range xsd:dateTime ;
    rdfs:label "issued at" ;
    rdfs:comment "The specific date and time when the log was issued." .