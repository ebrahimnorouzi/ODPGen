@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Legal Court and Bad Check Ontology" ;
    rdfs:comment "An ontology design pattern representing court hierarchies, jurisdictions, and bad check financial regulations." .

# Classes

:Court a owl:Class ;
    rdfs:label "Court" ;
    rdfs:comment "A tribunal presided over by a judge, judges, or a magistrate in civil and criminal cases." .

:DistrictCourt a owl:Class ;
    rdfs:subClassOf :Court ;
    rdfs:label "District Court" ;
    rdfs:comment "A court that has jurisdiction over a specific district." .

:State a owl:Class ;
    rdfs:label "State" ;
    rdfs:comment "A principal administrative division of a country." .

:District a owl:Class ;
    rdfs:label "District" ;
    rdfs:comment "An administrative division or geographical region within a state." .

:BadCheck a owl:Class ;
    rdfs:label "Bad Check" ;
    rdfs:comment "A check drawn on a nonexistent account or on an account with insufficient funds." .

:CheckTransactionType a owl:Class ;
    rdfs:label "Check Transaction Type" ;
    rdfs:comment "The classification or type of a check transaction." .

:CheckPayment a owl:Class ;
    rdfs:label "Check Payment" ;
    rdfs:comment "The payment event or record associated with a check." .

:TransactionStatus a owl:Class ;
    rdfs:label "Transaction Status" ;
    rdfs:comment "The current state or status of a financial transaction." .

# Object Properties

:locatedInState a owl:ObjectProperty ;
    rdfs:label "located in state" ;
    rdfs:comment "Relates an entity, such as a district court, to the state it is located in." ;
    rdfs:domain :DistrictCourt ;
    rdfs:range :State .

:hasDistrict a owl:ObjectProperty ;
    rdfs:label "has district" ;
    rdfs:comment "Relates a state to a district within its administrative boundaries." ;
    rdfs:domain :State ;
    rdfs:range :District .

:hasAuthorityOver a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has authority over" ;
    rdfs:comment "Relates a court to another court over which it has hierarchical authority or appellate jurisdiction." ;
    rdfs:domain :Court ;
    rdfs:range :Court .

:hasTransactionType a owl:ObjectProperty ;
    rdfs:label "has transaction type" ;
    rdfs:comment "Relates a bad check to its specific transaction type." ;
    rdfs:domain :BadCheck ;
    rdfs:range :CheckTransactionType .

:hasPayment a owl:ObjectProperty ;
    rdfs:label "has payment" ;
    rdfs:comment "Relates a bad check to its corresponding payment event." ;
    rdfs:domain :BadCheck ;
    rdfs:range :CheckPayment .

:hasTransactionStatus a owl:ObjectProperty ;
    rdfs:label "has transaction status" ;
    rdfs:comment "Relates a check payment to its current processing status." ;
    rdfs:domain :CheckPayment ;
    rdfs:range :TransactionStatus .

# Datatype Properties

:paymentDate a owl:DatatypeProperty ;
    rdfs:label "payment date" ;
    rdfs:comment "The date and time when a check payment occurred." ;
    rdfs:domain :CheckPayment ;
    rdfs:range xsd:dateTime .