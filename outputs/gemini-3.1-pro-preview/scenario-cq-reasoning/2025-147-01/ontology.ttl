@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Maritime Ship Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing ships, their characteristics, trajectories, propulsion systems, and associated data resources in the maritime domain." .

# --- Classes ---

:Ship a owl:Class ;
    rdfs:label "Ship" ;
    rdfs:comment "A large watercraft that travels the world's oceans and other sufficiently deep waterways." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasIdentifier ; owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
                    [ a owl:Restriction ; owl:onProperty :hasOwner ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .