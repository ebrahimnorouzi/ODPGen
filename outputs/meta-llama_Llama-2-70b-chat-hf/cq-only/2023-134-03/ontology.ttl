@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Registry Ontology" ;
rdfs:comment "An ontology for representing registry information".

:Registry a owl:Class ;
rdfs:label "Registry" ;
rdfs:comment "A registry of data".

:Maintainer a owl:Class ;
rdfs:label "Maintainer" ;
rdfs:comment "An entity responsible for maintaining the registry".

:maintains a owl:ObjectProperty ;
rdfs:label "maintains" ;
rdfs:comment "The maintainer of the registry".

:RegistryCreated a owl:DatatypeProperty ;
rdfs:label "created" ;
rdfs:comment "The date the registry was created".

:RegistryUpdated a owl:DatatypeProperty ;
rdfs:label "updated" ;
rdfs:comment "The date the registry was last updated".

:DataType a owl:Class ;
rdfs:label "DataType" ;
rdfs:comment "A type of data".

:DataLocation a owl:Class ;
rdfs:label "DataLocation" ;
rdfs:comment "A location where data is stored".

:stores a owl:ObjectProperty ;
rdfs:label "stores" ;
rdfs:comment "The location where the data is stored".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy associated with the data".

:associatedWith a owl:ObjectProperty ;
rdfs:label "associatedWith" ;
rdfs:comment "The policy associated with the data".