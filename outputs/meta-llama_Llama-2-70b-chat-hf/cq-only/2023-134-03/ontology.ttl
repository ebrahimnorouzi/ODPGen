@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Registry Ontology" ;
rdfs:comment "An ontology for representing registry information".

:Registry a owl:Class ;
rdfs:label "Registry" ;
rdfs:comment "A registry of data".

:Maintainer a owl:Class ;
rdfs:label "Maintainer" ;
rdfs:comment "An entity responsible for maintaining the registry".

:hasMaintainer a owl:ObjectProperty ;
rdfs:label "has maintainer" ;
rdfs:comment "A registry has a maintainer" ;
:Registry :hasMaintainer :Maintainer.

:createdAt a owl:DatatypeProperty ;
rdfs:label "created at" ;
rdfs:comment "The date and time when the registry was created" ;
:Registry :createdAt xsd:dateTime.

:updatedAt a owl:DatatypeProperty ;
rdfs:label "updated at" ;
rdfs:comment "The date and time when the registry was last updated" ;
:Registry :updatedAt xsd:dateTime.

:dataType a owl:Class ;
rdfs:label "Data Type" ;
rdfs:comment "A type of data stored in the registry".

:hasDataType a owl:ObjectProperty ;
rdfs:label "has data type" ;
rdfs:comment "A registry has a data type" ;
:Registry :hasDataType :dataType.

:storageLocation a owl:Class ;
rdfs:label "Storage Location" ;
rdfs:comment "A location where data is stored".

:hasStorageLocation a owl:ObjectProperty ;
rdfs:label "has storage location" ;
rdfs:comment "A registry has a storage location" ;
:Registry :hasStorageLocation :storageLocation.

:policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy associated with the data".

:hasPolicy a owl:ObjectProperty ;
rdfs:label "has policy" ;
rdfs:comment "A registry has a policy" ;
:Registry :hasPolicy :policy.