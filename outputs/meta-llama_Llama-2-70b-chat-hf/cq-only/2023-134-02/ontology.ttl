@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Data Log Ontology" ; rdfs:comment "An ontology for describing data logs.".

# Classes
:DataLog a owl:Class ; rdfs:label "Data Log" ; rdfs:comment "A data log entry.".
:Entity a owl:Class ; rdfs:label "Entity" ; rdfs:comment "An entity interacting with the data.".
:Publisher a owl:Class ; rdfs:label "Publisher" ; rdfs:comment "An entity publishing the log.".
:Action a owl:Class ; rdfs:label "Action" ; rdfs:comment "An action being performed on the data.".
:Storage a owl:Class ; rdfs:label "Storage" ; rdfs:comment "A storage location for the data.".
:Application a owl:Class ; rdfs:label "Application" ; rdfs:comment "An application or service generating the data.".

# Properties
:hasAction a owl:ObjectProperty ; rdfs:label "has action" ; rdfs:comment "The action being performed on the data.".
:hasEntity a owl:ObjectProperty ; rdfs:label "has entity" ; rdfs:comment "The entity interacting with the data.".
:hasPublisher a owl:ObjectProperty ; rdfs:label "has publisher" ; rdfs:comment "The entity publishing the log.".
:hasStorage a owl:ObjectProperty ; rdfs:label "has storage" ; rdfs:comment "The storage location for the data.".
:hasApplication a owl:ObjectProperty ; rdfs:label "has application" ; rdfs:comment "The application or service generating the data.".
:issued a owl:DatatypeProperty ; rdfs:label "issued" ; rdfs:comment "The date and time the log was issued.".

# Individuals
:dataLog a DataLog ; hasAction create ; hasEntity User123 ; hasPublisher Admin456 ; hasStorage LocalDrive ; hasApplication DataGenerator.
:dataLog2 a DataLog ; hasAction update ; hasEntity User789 ; hasPublisher Admin456 ; hasStorage CloudStorage ; hasApplication DataEditor.
:dataLog3 a DataLog ; hasAction erase ; hasEntity User123 ; hasPublisher Admin456 ; hasStorage LocalDrive ; hasApplication DataCleaner.