@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Court Ontology" ; rdfs:comment "An ontology for court information".

# Classes
:Court a owl:Class ; rdfs:label "Court" ; rdfs:comment "A court of law".
:DistrictCourt a owl:Class ; rdfs:label "District Court" ; rdfs:comment "A district court".
:State a owl:Class ; rdfs:label "State" ; rdfs:comment "A state in a country".

# Properties
:hasJurisdiction a owl:ObjectProperty ; rdfs:label "has jurisdiction" ; rdfs:comment "A court has jurisdiction over a district".
:isLocatedIn a owl:ObjectProperty ; rdfs:label "is located in" ; rdfs:comment "A court is located in a state".
:hasAuthorityOver a owl:ObjectProperty ; rdfs:label "has authority over" ; rdfs:comment "A court has authority over a lower court".
:transactionType a owl:DataProperty ; rdfs:label "transaction type" ; rdfs:comment "The type of a check transaction".
:paymentDate a owl:DataProperty ; rdfs:label "payment date" ; rdfs:comment "The date a check payment was made".
:transactionStatus a owl:DataProperty ; rdfs:label "transaction status" ; rdfs:comment "The status of a check payment transaction".

# Individuals
:Court1 a :Court ; rdfs:label "Court 1" ; rdfs:comment "A specific court".
:Court2 a :Court ; rdfs:label "Court 2" ; rdfs:comment "Another specific court".
:DistrictCourt1 a :DistrictCourt ; rdfs:label "District Court 1" ; rdfs:comment "A specific district court".
:DistrictCourt2 a :DistrictCourt ; rdfs:label "District Court 2" ; rdfs:comment "Another specific district court".
:State1 a :State ; rdfs:label "State 1" ; rdfs:comment "A specific state".
:State2 a :State ; rdfs:label "State 2" ; rdfs:comment "Another specific state".

# Axioms
:Court1 :hasJurisdiction :DistrictCourt1.
:Court2 :hasJurisdiction :DistrictCourt2.
:DistrictCourt1 :isLocatedIn :State1.
:DistrictCourt2 :isLocatedIn :State2.
:Court1 :hasAuthorityOver :DistrictCourt1.
:Court2 :hasAuthorityOver :DistrictCourt2.
:transactionType :hasValue "bad check".
:paymentDate :hasValue "2022-01-01".
:transactionStatus :hasValue "paid".