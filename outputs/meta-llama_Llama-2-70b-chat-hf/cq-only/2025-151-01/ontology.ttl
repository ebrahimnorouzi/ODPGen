@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Evaluation Request Ontology" ;
rdfs:comment "An ontology for representing evaluation requests and their associated information.".

:EvaluationRequest a owl:Class ;
rdfs:label "EvaluationRequest" ;
rdfs:comment "A request for evaluating a target asset.".

:Requester a owl:Class ;
rdfs:label "Requester" ;
rdfs:comment "The party issuing the evaluation request.".

:TargetAsset a owl:Class ;
rdfs:label "TargetAsset" ;
rdfs:comment "The asset being evaluated.".

:EvaluationRequest a owl:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "The evaluation request associated with a target asset.".

:RequesterOf a owl:ObjectProperty ;
rdfs:label "requesterOf" ;
rdfs:comment "The party issuing the evaluation request.".

:TargetOf a owl:ObjectProperty ;
rdfs:label "targetOf" ;
rdfs:comment "The target asset being evaluated.".

:When a owl:DatatypeProperty ;
rdfs:label "when" ;
rdfs:comment "The date and time the evaluation request was issued.".

:AdditionalContext a owl:AnnotationProperty ;
rdfs:label "additionalContext" ;
rdfs:comment "Additional contextual information that can be included in the evaluation request to further constrain it.".

:EvaluationRequest a owl:Class, rdfs:Class ;
rdfs:label "EvaluationRequest" ;
rdfs:comment "A request for evaluating a target asset.".

:Requester a owl:Class, rdfs:Class ;
rdfs:label "Requester" ;
rdfs:comment "The party issuing the evaluation request.".

:TargetAsset a owl:Class, rdfs:Class ;
rdfs:label "TargetAsset" ;
rdfs:comment "The asset being evaluated.".

:EvaluationRequest a owl:ObjectProperty, rdfs:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "The evaluation request associated with a target asset.".

:RequesterOf a owl:ObjectProperty, rdfs:ObjectProperty ;
rdfs:label "requesterOf" ;
rdfs:comment "The party issuing the evaluation request.".

:TargetOf a owl:ObjectProperty, rdfs:ObjectProperty ;
rdfs:label "targetOf" ;
rdfs:comment "The target asset being evaluated.".

:When a owl:DatatypeProperty, rdfs:DatatypeProperty ;
rdfs:label "when" ;
rdfs:comment "The date and time the evaluation request was issued.".

:AdditionalContext a owl:AnnotationProperty, rdfs:AnnotationProperty ;
rdfs:label "additionalContext" ;
rdfs:comment "Additional contextual information that can be included in the evaluation request to further constrain it.".