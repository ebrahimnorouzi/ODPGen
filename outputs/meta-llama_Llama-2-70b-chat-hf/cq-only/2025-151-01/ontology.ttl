@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Evaluation Request Ontology" ; rdfs:comment "An ontology for representing evaluation requests.".

# Classes

:EvaluationRequest a owl:Class ; rdfs:label "EvaluationRequest" ; rdfs:comment "A request for evaluating a target asset.".
:Party a owl:Class ; rdfs:label "Party" ; rdfs:comment "A party involved in the evaluation request.".
:Asset a owl:Class ; rdfs:label "Asset" ; rdfs:comment "A target asset being evaluated.".
:Context a owl:Class ; rdfs:label "Context" ; rdfs:comment "Additional contextual information included in the evaluation request.".

# Properties

:hasRequester a owl:ObjectProperty ; rdfs:label "hasRequester" ; rdfs:comment "The party issuing the evaluation request.".
:hasTarget a owl:ObjectProperty ; rdfs:label "hasTarget" ; rdfs:comment "The target asset being evaluated.".
:hasContext a owl:ObjectProperty ; rdfs:label "hasContext" ; rdfs:comment "Additional contextual information included in the evaluation request.".
:issuedOn a owl:DatatypeProperty ; rdfs:label "issuedOn" ; rdfs:comment "The date and time when the evaluation request was issued.".

# Individuals

:EvaluationRequest-1 a :EvaluationRequest ;
  hasRequester :Party-1 ;
  hasTarget :Asset-1 ;
  hasContext :Context-1 ;
  issuedOn "2022-01-01T12:00:00".

:Party-1 a :Party ; rdfs:label "Party A".
:Asset-1 a :Asset ; rdfs:label "Asset 1".
:Context-1 a :Context ; rdfs:label "Context 1".