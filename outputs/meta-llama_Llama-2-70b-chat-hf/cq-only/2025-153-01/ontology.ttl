@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Referent Tracking Ontology" ; rdfs:comment "An ontology for tracking referents and their associations over time.".

# Classes

:Referent a owl:Class ; rdfs:label "Referent" ; rdfs:comment "A entity that can be referenced by a persistent identifier.".
:Observation a owl:Class ; rdfs:label "Observation" ; rdfs:comment "A observation associated with a specific referent.".
:Transition a owl:Class ; rdfs:label "Transition" ; rdfs:comment "A transition between two referents.".
:Rule a owl:Class ; rdfs:label "Rule" ; rdfs:comment "A rule that triggered a specific transition.".

# Properties

:hasReferent a owl:ObjectProperty ; rdfs:label "has referent" ; rdfs:comment "A referent that is associated with a persistent identifier.".
:wasReferencedAt a owl:ObjectProperty ; rdfs:label "was referenced at" ; rdfs:comment "A timestamp at which a referent was referenced.".
:referentTransition a owl:ObjectProperty ; rdfs:label "referent transition" ; rdfs:comment "A transition between two referents.".
:observationAssociatedWith a owl:ObjectProperty ; rdfs:label "observation associated with" ; rdfs:comment "An observation that is associated with a specific referent.".
:transitionTriggeredBy a owl:ObjectProperty ; rdfs:label "transition triggered by" ; rdfs:comment "A rule that triggered a specific transition.".
:temporalBinding a owl:ObjectProperty ; rdfs:label "temporal binding" ; rdfs:comment "A temporal binding between a referent and a timestamp.".

# Individuals

:Referent1 a :Referent ; rdfs:label "Referent 1".
:Referent2 a :Referent ; rdfs:label "Referent 2".
:Observation1 a :Observation ; rdfs:label "Observation 1" ; :hasReferent :Referent1.
:Observation2 a :Observation ; rdfs:label "Observation 2" ; :hasReferent :Referent2.
:Transition1 a :Transition ; rdfs:label "Transition 1" ; :referentTransition :Referent1 :Referent2.
:Transition2 a :Transition ; rdfs:label "Transition 2" ; :referentTransition :Referent2 :Referent1.
:Rule1 a :Rule ; rdfs:label "Rule 1" ; :transitionTriggeredBy :Transition1.
:Rule2 a :Rule ; rdfs:label "Rule 2" ; :transitionTriggeredBy :Transition2.