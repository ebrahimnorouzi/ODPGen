@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Referent Tracking Ontology" ; rdfs:comment "An ontology for tracking referents and their associations over time.".

:Referent a owl:Class ; rdfs:label "Referent" ; rdfs:comment "A entity that can be referenced by a persistent identifier.".
:PersistentIdentifier a owl:Class ; rdfs:label "Persistent Identifier" ; rdfs:comment "A unique identifier that references a referent.".
:Reference a owl:ObjectProperty ; rdfs:label "Reference" ; rdfs:comment "A relationship between a persistent identifier and a referent.".
:TimeStamp a owl:Class ; rdfs:label "Time Stamp" ; rdfs:comment "A point in time.".
:ReferentTransition a owl:Class ; rdfs:label "Referent Transition" ; rdfs:comment "A change in the referent associated with a persistent identifier.".
:Observation a owl:Class ; rdfs:label "Observation" ; rdfs:comment "A piece of data associated with a referent and a time stamp.".
:FullSequence a owl:Class ; rdfs:label "Full Sequence" ; rdfs:comment "A sequence of referents over time.".
:Rule a owl:Class ; rdfs:label "Rule" ; rdfs:comment "A set of conditions and actions that trigger a referent transition.".
:Gap a owl:Class ; rdfs:label "Gap" ; rdfs:comment "A gap in the temporal binding of a persistent identifier.".
:Overlap a owl:Class ; rdfs:label "Overlap" ; rdfs:comment "An overlap in the temporal binding of a persistent identifier.".
:Rebuild a owl:Class ; rdfs:label "Rebuild" ; rdfs:comment "The ability to rebuild a complete context for a given time point.".

:ReferentTransition
  a owl:ObjectProperty ;
  rdfs:label "Transition" ;
  rdfs:comment "A relationship between a persistent identifier and a new referent.".

:Observation
  a owl:ObjectProperty ;
  rdfs:label "Observe" ;
  rdfs:comment "A relationship between a referent and a time stamp.".

:FullSequence
  a owl:ObjectProperty ;
  rdfs:label "Sequence" ;
  rdfs:comment "A relationship between a referent and a sequence of referents over time.".

:Rule
  a owl:ObjectProperty ;
  rdfs:label "Trigger" ;
  rdfs:comment "A relationship between a rule and a referent transition.".

:Gap
  a owl:ObjectProperty ;
  rdfs:label "Gap" ;
  rdfs:comment "A relationship between a persistent identifier and a gap in its temporal binding.".

:Overlap
  a owl:ObjectProperty ;
  rdfs:label "Overlap" ;
  rdfs:comment "A relationship between a persistent identifier and an overlap in its temporal binding.".

:Rebuild
  a owl:ObjectProperty ;
  rdfs:label "Rebuild" ;
  rdfs:comment "A relationship between a referent and the ability to rebuild a complete context for a given time point.".