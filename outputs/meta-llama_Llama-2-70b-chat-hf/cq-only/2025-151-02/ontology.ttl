@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "My Ontology" ;
rdfs:comment "This is my ontology for answering competency questions.".

:Time a owl:Class ;
rdfs:label "Time" ;
rdfs:comment "Represents the current time.".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "Represents a physical location.".

:Asset a owl:Class ;
rdfs:label "Asset" ;
rdfs:comment "Represents an asset that is part of an asset collection.".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "Represents a party that is part of a party collection.".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "Represents an action that has been performed or attempted.".

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "Represents a rule that has been exercised.".

:Event a owl:Class ;
rdfs:label "Event" ;
rdfs:comment "Represents an event that has occurred.".

:Payment a owl:Class ;
rdfs:label "Payment" ;
rdfs:comment "Represents a financial payment that has been made.".

:Amount a owl:DatatypeProperty ;
rdfs:label "Amount" ;
rdfs:comment "The amount of a payment.".

:Exercise a owl:ObjectProperty ;
rdfs:label "Exercise" ;
rdfs:comment "Indicates that a rule has been exercised.".

:HasExercised a owl:ObjectProperty ;
rdfs:label "HasExercised" ;
rdfs:comment "Indicates that a rule has been exercised a certain number of times.".

:Recipient a owl:Class ;
rdfs:label "Recipient" ;
rdfs:comment "Represents a recipient or category of recipients who can receive the result of a rule.".

:CanReceive a owl:ObjectProperty ;
rdfs:label "CanReceive" ;
rdfs:comment "Indicates that a recipient can receive the result of a rule.".