@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Relational Database Ontology" ;
rdfs:comment "An ontology for representing relational databases and their schemas.".

# Classes

:Table a owl:Class ;
rdfs:label "Table" ;
rdfs:comment "A table in a relational database.".

:Column a owl:Class ;
rdfs:label "Column" ;
rdfs:comment "A column in a table.".

:PrimaryKey a owl:Class ;
rdfs:label "PrimaryKey" ;
rdfs:comment "A primary key relationship between columns.".

:ForeignKey a owl:Class ;
rdfs:label "ForeignKey" ;
rdfs:comment "A foreign key relationship between columns.".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy for a specific agent.".

:ReadAction a owl:Class ;
rdfs:label "ReadAction" ;
rdfs:comment "A high-level read action.".

:ModifyAction a owl:Class ;
rdfs:label "ModifyAction" ;
rdfs:comment "A high-level modify action.".

:ViewActionScope a owl:Class ;
rdfs:label "ViewActionScope" ;
rdfs:comment "A scope for view actions.".

:ProcessActionScope a owl:Class ;
rdfs:label "ProcessActionScope" ;
rdfs:comment "A scope for process actions.".

:ProhibitedModifyAction a owl:Class ;
rdfs:label "ProhibitedModifyAction" ;
rdfs:comment "A prohibited modify action on a table.".

:TableLevelReadProhibition a owl:Class ;
rdfs:label "TableLevelReadProhibition" ;
rdfs:comment "A table-level read prohibition for processing.".

:TableLevelReadProhibitionForViewing a owl:Class ;
rdfs:label "TableLevelReadProhibitionForViewing" ;
rdfs:comment "A table-level read prohibition for viewing.".

:ConditionalRowLevelReadRestriction a owl:Class ;
rdfs:label "ConditionalRowLevelReadRestriction" ;
rdfs:comment "A conditional row-level read restriction for later enforcement.".

:SQLQuery a owl:Class ;
rdfs:label "SQLQuery" ;
rdfs:comment "A SQL query as an AST-based semantic graph.".

:SelectStatement a owl:Class ;
rdfs:label "SelectStatement" ;
rdfs:comment "A select statement in a SQL query.".

:UpdateStatement a owl:Class ;
rdfs:label "UpdateStatement" ;
rdfs:comment "An update statement in a SQL query.".

:QueryStatement a owl:Class ;
rdfs:label "QueryStatement" ;
rdfs:comment "A query statement in a SQL query.".

:Agent a owl:Class ;
rdfs:label "Agent" ;
rdfs:comment "An agent that executes a query.".

:SemanticActionType a owl:Class ;
rdfs:label "SemanticActionType" ;
rdfs:comment "A semantic action type for a query statement.".

:Scope a owl:Class ;
rdfs:label "Scope" ;
rdfs:comment "An operational scope for a query statement.".