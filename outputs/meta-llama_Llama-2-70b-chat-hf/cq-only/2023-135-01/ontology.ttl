@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "C. S. Lewis Ontology" ; rdfs:comment "An ontology for answering questions about C. S. Lewis".

:Author a owl:Class ; rdfs:label "Author" ; rdfs:comment "A person who has written a book".
:Book a owl:Class ; rdfs:label "Book" ; rdfs:comment "A written work".
:Write a owl:ObjectProperty ; rdfs:label "write" ; rdfs:comment "The author of a book".
:Pseudonym a owl:Class ; rdfs:label "Pseudonym" ; rdfs:comment "A fictional name used by an author".
:Use a owl:ObjectProperty ; rdfs:label "use" ; rdfs:comment "The pseudonym used by an author".
:Poem a owl:Class ; rdfs:label "Poem" ; rdfs:comment "A piece of poetry".
:Collection a owl:Class ; rdfs:label "Collection" ; rdfs:comment "A collection of written works".
:SpiritInBondage a :Poem ; rdfs:label "Spirit in Bondage" ; rdfs:comment "A collection of poems by C. S. Lewis".

:River a owl:Class ; rdfs:label "River" ; rdfs:comment "A natural flowing body of water".
:NationalPark a owl:Class ; rdfs:label "National Park" ; rdfs:comment "A protected area of land".
:Cross a owl:ObjectProperty ; rdfs:label "cross" ; rdfs:comment "A river that flows through a national park".

:Trajectory a owl:Class ; rdfs:label "Trajectory" ; rdfs:comment "The path of a river".
:Show a owl:ObjectProperty ; rdfs:label "show" ; rdfs:comment "The trajectory of a river".