@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Slippery Pavement Ontology" ; rdfs:comment "An ontology for representing and reasoning about slippery pavements.".

# Classes

:SlipperyPavement a owl:Class ; rdfs:label "Slippery Pavement" ; rdfs:comment "A pavement that is slippery.".
:Event a owl:Class ; rdfs:label "Event" ; rdfs:comment "An event that can affect the slipperiness of a pavement.".
:SprinklerSystem a owl:Class ; rdfs:label "Sprinkler System" ; rdfs:comment "A system that can wet a pavement.".

# Object Properties

:causesSlipperiness a owl:ObjectProperty ; rdfs:label "causes slipperiness" ; rdfs:comment "A relationship between an event and a slippery pavement.".
:hasCausalLink a owl:ObjectProperty ; rdfs:label "has causal link" ; rdfs:comment "A relationship between two events that can affect the slipperiness of a pavement.".
:isOn a owl:ObjectProperty ; rdfs:label "is on" ; rdfs:comment "A relationship between a sprinkler system and its state.".

# Data Properties

:wetness a owl:DatatypeProperty ; rdfs:label "wetness" ; rdfs:comment "A property of a pavement that indicates its wetness.".

# Annotation Properties

:description a owl:AnnotationProperty ; rdfs:label "description" ; rdfs:comment "A property for providing a brief description of a class or property.".

# Individuals

:SlipperyPavement1 a :SlipperyPavement ; rdfs:label "Slippery Pavement 1" ; rdfs:comment "A specific slippery pavement.".
:SlipperyPavement2 a :SlipperyPavement ; rdfs:label "Slippery Pavement 2" ; rdfs:comment "Another specific slippery pavement.".
:Event1 a :Event ; rdfs:label "Event 1" ; rdfs:comment "A specific event that can affect the slipperiness of a pavement.".
:Event2 a :Event ; rdfs:label "Event 2" ; rdfs:comment "Another specific event that can affect the slipperiness of a pavement.".
:SprinklerSystem1 a :SprinklerSystem ; rdfs:label "Sprinkler System 1" ; rdfs:comment "A specific sprinkler system.".