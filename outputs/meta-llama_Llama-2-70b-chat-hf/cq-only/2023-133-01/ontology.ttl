@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Slippery Pavement Ontology" ; rdfs:comment "An ontology for representing and reasoning about slippery pavement.".

# Classes
:SlipperyPavement a owl:Class ; rdfs:label "Slippery Pavement" ; rdfs:comment "A class representing a slippery pavement.".
:Event a owl:Class ; rdfs:label "Event" ; rdfs:comment "A class representing an event that can affect the slipperiness of a pavement.".
:Sprinkler a owl:Class ; rdfs:label "Sprinkler" ; rdfs:comment "A class representing a sprinkler system that can wet a pavement.".

# Properties
:hasCause a owl:ObjectProperty ; rdfs:label "has cause" ; rdfs:comment "A property representing a causal relationship between two events.".
:hasEffect a owl:ObjectProperty ; rdfs:label "has effect" ; rdfs:comment "A property representing a causal relationship between an event and a slippery pavement.".
:isWet a owl:DatatypeProperty ; rdfs:label "is wet" ; rdfs:comment "A property representing whether a pavement is wet or not.".

# Individuals
:pavement a :SlipperyPavement ; rdfs:label "Pavement" ; rdfs:comment "A individual representing a slippery pavement.".
:event1 a :Event ; rdfs:label "Event 1" ; rdfs:comment "A individual representing an event that can make the pavement slippery.".
:event2 a :Event ; rdfs:label "Event 2" ; rdfs:comment "A individual representing another event that can make the pavement slippery.".
:sprinkler a :Sprinkler ; rdfs:label "Sprinkler" ; rdfs:comment "A individual representing a sprinkler system that can wet the pavement.".

# Axioms
:pavement hasCause :event1.
:pavement hasCause :event2.
:event1 hasEffect :pavement.
:event2 hasEffect :pavement.
:sprinkler hasCause :pavement.
:pavement isWet true.