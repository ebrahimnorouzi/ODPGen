@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Policy Ontology" ;
rdfs:comment "An ontology for representing policies and their associated information".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy is a set of rules and guidelines that govern the use of data".

:UniqueIdentifier a owl:Property ;
rdfs:label "Unique Identifier" ;
rdfs:comment "A unique identifier for the policy" ;
owl:domain :Policy ;
owl:range xsd:string.

:Creator a owl:Property ;
rdfs:label "Creator" ;
rdfs:comment "The person or entity that created the policy" ;
owl:domain :Policy ;
owl:range :Person.

:IssueDate a owl:Property ;
rdfs:label "Issue Date" ;
rdfs:comment "The date the policy was issued" ;
owl:domain :Policy ;
owl:range xsd:date.

:Assignee a owl:Property ;
rdfs:label "Assignee" ;
rdfs:comment "The person or entity that is assigned to follow the policy" ;
owl:domain :Policy ;
owl:range :Person.

:Application a owl:Class ;
rdfs:label "Application" ;
rdfs:comment "An application or service that is used to access data".

:AccessMode a owl:Property ;
rdfs:label "Access Mode" ;
rdfs:comment "The mode in which the data is being accessed" ;
owl:domain :Application ;
owl:range :AccessMode.

:PersonalData a owl:Class ;
rdfs:label "Personal Data" ;
rdfs:comment "Data that is related to an individual person".

:Purpose a owl:Property ;
rdfs:label "Purpose" ;
rdfs:comment "The reason for accessing the data" ;
owl:domain :PersonalData ;
owl:range xsd:string.