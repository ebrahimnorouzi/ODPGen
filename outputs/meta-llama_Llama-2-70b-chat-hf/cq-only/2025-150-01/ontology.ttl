@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "An ontology for describing MQTT concepts and their relationships.".

:MQTT a owl:Class ;
  rdfs:label "MQTT" ;
  rdfs:comment "Represents the MQTT protocol and its components.".

:Broker a owl:Class ;
  rdfs:label "Broker" ;
  rdfs:comment "Represents an MQTT broker, which is responsible for routing messages between clients." ;
  owl:subClassOf :MQTT.

:Client a owl:Class ;
  rdfs:label "Client" ;
  rdfs:comment "Represents an MQTT client, which can connect to a broker and send/receive messages." ;
  owl:subClassOf :MQTT.

:NetworkConnection a owl:Class ;
  rdfs:label "NetworkConnection" ;
  rdfs:comment "Represents a network connection between a client and a broker." ;
  owl:subClassOf :MQTT.

:TLS a owl:Class ;
  rdfs:label "TLS" ;
  rdfs:comment "Represents a TLS (Transport Layer Security) connection, which is a secure way to establish a network connection." ;
  owl:subClassOf :NetworkConnection.

:Initiated a owl:Class ;
  rdfs:label "Initiated" ;
  rdfs:comment "Represents a network connection that was initiated by a client." ;
  owl:subClassOf :NetworkConnection.

:Accepted a owl:Class ;
  rdfs:label "Accepted" ;
  rdfs:comment "Represents a network connection that was accepted by a broker." ;
  owl:subClassOf :NetworkConnection.

:Participant a owl:Class ;
  rdfs:label "Participant" ;
  rdfs:comment "Represents a participant in an MQTT communication, which can be a client or a broker." ;
  owl:subClassOf :MQTT.

:UseCase a owl:Class ;
  rdfs:label "UseCase" ;
  rdfs:comment "Represents a use case for an MQTT application, which describes a set of related MQTT interactions." ;
  owl:subClassOf :MQTT.

:SOSA a owl:Class ;
  rdfs:label "SOSA" ;
  rdfs:comment "Represents a SOSA (Sensor Observation Service) system, which is an OGC (Open Geospatial Consortium) standard for sensor networks." ;
  owl:subClassOf :MQTT.

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "Represents a sensor in a SOSA system, which can observe and publish data." ;
  owl:subClassOf :SOSA.

:Actuator a owl:Class ;
  rdfs:label "Actuator" ;
  rdfs:comment "Represents an actuator in a SOSA system, which can receive and execute commands." ;
  owl:subClassOf :SOSA.