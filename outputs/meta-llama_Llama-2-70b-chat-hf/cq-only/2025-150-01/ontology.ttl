@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "An ontology for describing MQTT concepts and their relationships.".

:MQTT a owl:Class ;
  rdfs:label "MQTT" ;
  rdfs:comment "Represents the MQTT protocol and its components.".

:Broker a owl:Class ;
  rdfs:label "Broker" ;
  rdfs:comment "Represents an MQTT broker, which is responsible for routing messages between clients." ;
  owl:subClassOf :MQTT.

:Client a owl:Class ;
  rdfs:label "Client" ;
  rdfs:comment "Represents an MQTT client, which can connect to a broker and send/receive messages." ;
  owl:subClassOf :MQTT.

:NetworkConnection a owl:Class ;
  rdfs:label "NetworkConnection" ;
  rdfs:comment "Represents a network connection between a client and a broker." ;
  owl:subClassOf :MQTT.

:TLS a owl:Class ;
  rdfs:label "TLS" ;
  rdfs:comment "Represents a TLS (Transport Layer Security) connection." ;
  owl:subClassOf :NetworkConnection.

:Initiated a owl:Class ;
  rdfs:label "Initiated" ;
  rdfs:comment "Represents a network connection that was initiated by a client." ;
  owl:subClassOf :NetworkConnection.

:Accepted a owl:Class ;
  rdfs:label "Accepted" ;
  rdfs:comment "Represents a network connection that was accepted by a broker." ;
  owl:subClassOf :NetworkConnection.

:Participant a owl:Class ;
  rdfs:label "Participant" ;
  rdfs:comment "Represents a participant in an MQTT communication, either a client or a broker." ;
  owl:subClassOf :MQTT.

:MQTTTopic a owl:Class ;
  rdfs:label "MQTTTopic" ;
  rdfs:comment "Represents an MQTT topic, which is a named entity that can be published to or subscribed from." ;
  owl:subClassOf :MQTT.

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTTTopicFilter" ;
  rdfs:comment "Represents a filter for an MQTT topic, which can be used to match a specific topic or a set of topics." ;
  owl:subClassOf :MQTT.

:MQTTTopicSubject a owl:Class ;
  rdfs:label "MQTTTopicSubject" ;
  rdfs:comment "Represents a subject that can be observed or acted upon through an MQTT topic." ;
  owl:subClassOf :MQTT.

:SOSA a owl:Class ;
  rdfs:label "SOSA" ;
  rdfs:comment "Represents a SOSA (Sensor Observation Service) system, which can be used to observe or act upon a FeatureOfInterest." ;
  owl:subClassOf :MQTT.