@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Relational Database Security Ontology" ;
rdfs:comment "An ontology for securing access to a relational database queried via SQL.".

:User a owl:Class ;
rdfs:label "User" ;
rdfs:comment "An individual who interacts with the relational database.".

:Role a owl:Class ;
rdfs:label "Role" ;
rdfs:comment "A set of permissions granted to a user.".

:Permission a owl:Class ;
rdfs:label "Permission" ;
rdfs:comment "A specific access right granted to a user.".

:Query a owl:Class ;
rdfs:label "Query" ;
rdfs:comment "A request for data from the relational database.".

:Result a owl:Class ;
rdfs:label "Result" ;
rdfs:comment "The output of a query.".

:SQL a owl:Class ;
rdfs:label "SQL" ;
rdfs:comment "The query language used to interact with the relational database.".

:UserHasRole a owl:ObjectProperty ;
rdfs:label "has role" ;
rdfs:comment "A user has a specific role." ;
domain :User ;
range :Role.

:RoleHasPermission a owl:ObjectProperty ;
rdfs:label "has permission" ;
rdfs:comment "A role has a specific permission." ;
domain :Role ;
range :Permission.

:QueryHasResult a owl:ObjectProperty ;
rdfs:label "has result" ;
rdfs:comment "A query has a specific result." ;
domain :Query ;
range :Result.

:SQLQuery a owl:ObjectProperty ;
rdfs:label "is query" ;
rdfs:comment "A query is written in SQL." ;
domain :Query ;
range :SQL.

:UserHasQuery a owl:ObjectProperty ;
rdfs:label "has query" ;
rdfs:comment "A user has a specific query." ;
domain :User ;
range :Query.

:ResultHasData a owl:ObjectProperty ;
rdfs:label "has data" ;
rdfs:comment "A result has specific data." ;
domain :Result ;
range :Data.

:Data a owl:Class ;
rdfs:label "Data" ;
rdfs:comment "The output data of a query.".

:DataHasValue a owl:ObjectProperty ;
rdfs:label "has value" ;
rdfs:comment "Data has a specific value." ;
domain :Data ;
range :Value.

:Value a owl:Class ;
rdfs:label "Value" ;
rdfs:comment "A specific value in the output data.".

:UserHasPassword a owl:ObjectProperty ;
rdfs:label "has password" ;
rdfs:comment "A user has a specific password." ;
domain :User ;
range :Password.

:Password a owl:Class ;
rdfs:label "Password" ;
rdfs:comment "A secret password for a user.".