@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Sprinkler Use Case Ontology" ;
rdfs:comment "An ontology for representing the causal relations between events in the sprinkler use case scenario".

:RainySeason a owl:Class ;
rdfs:label "Rainy Season" ;
rdfs:comment "A class representing the event of rainy season".

:Sprinkler a owl:Class ;
rdfs:label "Sprinkler" ;
rdfs:comment "A class representing the event of the sprinkler being on".

:Rain a owl:Class ;
rdfs:label "Rain" ;
rdfs:comment "A class representing the event of rain".

:WetPavement a owl:Class ;
rdfs:label "Wet Pavement" ;
rdfs:comment "A class representing the event of the pavement being wet".

:SlipperyPavement a owl:Class ;
rdfs:label "Slippery Pavement" ;
rdfs:comment "A class representing the event of the pavement being slippery".

:RainySeason :hasCause :Rain ;
rdfs:label "Rainy season causes rain" ;
rdfs:comment "The rainy season event causes the rain event".

:Rain :hasCause :WetPavement ;
rdfs:label "Rain causes wet pavement" ;
rdfs:comment "The rain event causes the wet pavement event".

:WetPavement :hasCause :SlipperyPavement ;
rdfs:label "Wet pavement causes slippery pavement" ;
rdfs:comment "The wet pavement event causes the slippery pavement event".

:Sprinkler :hasEffect :WetPavement ;
rdfs:label "Sprinkler causes wet pavement" ;
rdfs:comment "The sprinkler event has an effect on the wet pavement event".

:SlipperyPavement :hasEffect :Sprinkler ;
rdfs:label "Slippery pavement has effect on sprinkler" ;
rdfs:comment "The slippery pavement event has an effect on the sprinkler event".