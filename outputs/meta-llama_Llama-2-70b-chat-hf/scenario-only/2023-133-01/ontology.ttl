@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Sprinkler Use Case Ontology" ;
rdfs:comment "An ontology for representing the causal relations between events in the sprinkler use case.".

:Event a owl:Class ;
rdfs:label "Event" ;
rdfs:comment "A class representing an event in the sprinkler use case.".

:RainySeason a :Event ;
rdfs:label "Rainy Season" ;
rdfs:comment "An event representing the rainy season.".

:SprinklerOn a :Event ;
rdfs:label "Sprinkler On" ;
rdfs:comment "An event representing the sprinkler being on.".

:Raining a :Event ;
rdfs:label "Raining" ;
rdfs:comment "An event representing rainfall.".

:PavementWet a :Event ;
rdfs:label "Pavement Wet" ;
rdfs:comment "An event representing the pavement being wet.".

:PavementSlippery a :Event ;
rdfs:label "Pavement Slippery" ;
rdfs:comment "An event representing the pavement being slippery.".

:CausalRelation a owl:ObjectProperty ;
rdfs:label "Causal Relation" ;
rdfs:comment "A property representing a causal relation between two events.".

:EffectWeight a xsd:Decimal ;
rdfs:label "Effect Weight" ;
rdfs:comment "A property representing the effect weight of a causal relation.".

:RainySeason :CausalRelation :SprinklerOn.
:SprinklerOn :CausalRelation :Raining.
:Raining :CausalRelation :PavementWet.
:PavementWet :CausalRelation :PavementSlippery.

:RainySeason :EffectWeight "0.6".
:SprinklerOn :EffectWeight "0.8".
:Raining :EffectWeight "0.7".
:PavementWet :EffectWeight "0.9".