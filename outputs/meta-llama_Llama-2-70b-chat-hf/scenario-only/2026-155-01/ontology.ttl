@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Cultural Heritage Survey ODP" ;
rdfs:comment "Ontology for modeling scientific survey activities performed on cultural heritage entities".

### Classes

:Survey a owl:Class ;
rdfs:label "Survey" ;
rdfs:comment "Represents a scientific survey activity performed on cultural heritage entities".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "Represents a specific observation made during a survey".

:Method a owl:Class ;
rdfs:label "Method" ;
rdfs:comment "Represents a specific method used during a survey".

:EquipmentConfiguration a owl:Class ;
rdfs:label "EquipmentConfiguration" ;
rdfs:comment "Represents a specific configuration of equipment used during a survey".

:InterpretationProcess a owl:Class ;
rdfs:label "InterpretationProcess" ;
rdfs:comment "Represents the process of interpreting data collected during a survey".

### Properties

:hasObservations a owl:ObjectProperty ;
rdfs:label "has observations" ;
rdfs:comment "Relates a survey to the observations made during that survey".

:usedMethod a owl:ObjectProperty ;
rdfs:label "used method" ;
rdfs:comment "Relates a survey to the method used during that survey".

:usedEquipmentConfiguration a owl:ObjectProperty ;
rdfs:label "used equipment configuration" ;
rdfs:comment "Relates a survey to the equipment configuration used during that survey".

:generatedInterpretation a owl:ObjectProperty ;
rdfs:label "generated interpretation" ;
rdfs:comment "Relates a survey to the interpretation process that generated the interpretation".

### Axioms

:Survey rdfs:subClassOf owl:Process.
:Observation rdfs:subClassOf owl:Event.
:Method rdfs:subClassOf owl:Concept.
:EquipmentConfiguration rdfs:subClassOf owl:Concept.
:InterpretationProcess rdfs:subClassOf owl:Process.

:hasObservations rdfs:domain :Survey ;
rdfs:range :Observation.

:usedMethod rdfs:domain :Survey ;
rdfs:range :Method.

:usedEquipmentConfiguration rdfs:domain :Survey ;
rdfs:range :EquipmentConfiguration.

:generatedInterpretation rdfs:domain :Survey ;
rdfs:range :InterpretationProcess.

:Survey owl:disjointWith :Observation.
:Survey owl:disjointWith :Method.
:Survey owl:disjointWith :EquipmentConfiguration.
:Survey owl:disjointWith :InterpretationProcess.