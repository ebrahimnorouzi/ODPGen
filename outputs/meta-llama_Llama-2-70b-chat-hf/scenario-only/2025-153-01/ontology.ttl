@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Temporal Indirection Ontology" ;
rdfs:comment "An ontology for modeling temporal indirection in various domains.".

:TemporalIndirection a owl:Class ;
rdfs:label "Temporal Indirection" ;
rdfs:comment "A class representing temporal indirection.".

:PersistentIdentifier a owl:Class ;
rdfs:label "Persistent Identifier" ;
rdfs:comment "A class representing a persistent identifier.".

:FrontMonth a owl:Class ;
rdfs:label "Front Month" ;
rdfs:comment "A class representing the front month of a futures contract.".

:FuturesContract a owl:Class ;
rdfs:label "Futures Contract" ;
rdfs:comment "A class representing a futures contract.".

:RealTimeMarketAttribute a owl:Class ;
rdfs:label "Real-Time Market Attribute" ;
rdfs:comment "A class representing a real-time market attribute.".

:LastTradePrice a owl:Property ;
rdfs:label "lastTradePrice" ;
rdfs:comment "A property representing the last trade price of a futures contract.".

:TradingVolume a owl:Property ;
rdfs:label "tradingVolume" ;
rdfs:comment "A property representing the trading volume of a futures contract.".

:SettlementValue a owl:Property ;
rdfs:label "settlementValue" ;
rdfs:comment "A property representing the settlement value of a futures contract.".

:CurrentContract a owl:Property ;
rdfs:label "currentContract" ;
rdfs:comment "A property representing the current contract instance.".

:TemporalIndirection a owl:SubClassOf :PersistentIdentifier.
:FrontMonth a owl:SubClassOf :FuturesContract.
:FuturesContract a owl:SubClassOf :RealTimeMarketAttribute.
:LastTradePrice a owl:SubPropertyOf :currentContract.
:TradingVolume a owl:SubPropertyOf :currentContract.
:SettlementValue a owl:SubPropertyOf :currentContract.

:CL1 a :PersistentIdentifier ;
rdfs:label "CL1" ;
rdfs:comment "A persistent identifier for the front-month crude oil futures contract.".

:February2025 a :FrontMonth ;
rdfs:label "February 2025" ;
rdfs:comment "A front-month crude oil futures contract for February 2025.".

:March2025 a :FrontMonth ;
rdfs:label "March 2025" ;
rdfs:comment "A front-month crude oil futures contract for March 2025.".

:CurrentContract a :FuturesContract ;
rdfs:label "Current Contract" ;
rdfs:comment "The current futures contract instance.".

:LastTradePrice a :RealTimeMarketAttribute ;
rdfs:label "Last Trade Price" ;
rdfs:comment "The last trade price of the current futures contract.".

:TradingVolume a :RealTimeMarketAttribute ;
rdfs:label "Trading Volume" ;
rdfs:comment "The trading volume of the current futures contract.".

:SettlementValue a :RealTimeMarketAttribute ;
rdfs:label "Settlement Value" ;
rdfs:comment "The settlement value of the current futures contract.".