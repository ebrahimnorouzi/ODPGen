@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Patterns Ontology" ;
rdfs:comment "An ontology for modeling governance patterns in Solid applications".

:Identity a owl:Class ;
rdfs:label "Identity" ;
rdfs:comment "Represents the identity of a Solid actor or role".

:SolidActor a owl:Class ;
rdfs:label "SolidActor" ;
rdfs:comment "Represents an actor in a Solid application".

:SolidRole a owl:Class ;
rdfs:label "SolidRole" ;
rdfs:comment "Represents a role in a Solid application".

:Pod a owl:Class ;
rdfs:label "Pod" ;
rdfs:comment "Represents a Solid Pod".

:App a owl:Class ;
rdfs:label "App" ;
rdfs:comment "Represents a Solid app".

:DataCategory a owl:Class ;
rdfs:label "DataCategory" ;
rdfs:comment "Represents a category of data in a Solid Pod".

:PrivacyPolicy a owl:Class ;
rdfs:label "PrivacyPolicy" ;
rdfs:comment "Represents a privacy policy for a Solid app or Pod".

:Consent a owl:Class ;
rdfs:label "Consent" ;
rdfs:comment "Represents a consent decision for a Solid app or Pod".

:Provenance a owl:Class ;
rdfs:label "Provenance" ;
rdfs:comment "Represents provenance metadata for a Solid app or Pod".

:LegalCompliance a owl:Class ;
rdfs:label "LegalCompliance" ;
rdfs:comment "Represents legal compliance information for a Solid app or Pod".

:SolidActor rdfs:subClassOf :Identity.
:SolidRole rdfs:subClassOf :Identity.
:Pod rdfs:subClassOf :SolidActor.
:App rdfs:subClassOf :SolidActor.
:DataCategory rdfs:subClassOf :Pod.
:PrivacyPolicy rdfs:subClassOf :App.
:Consent rdfs:subClassOf :App.
:Provenance rdfs:subClassOf :App.
:LegalCompliance rdfs:subClassOf :App.

:hasDataCategory a owl:ObjectProperty ;
rdfs:label "hasDataCategory" ;
rdfs:comment "Relates a Solid app or Pod to its data categories".

:hasPrivacyPolicy a owl:ObjectProperty ;
rdfs:label "hasPrivacyPolicy" ;
rdfs:comment "Relates a Solid app or Pod to its privacy policy".

:hasConsent a owl:ObjectProperty ;
rdfs:label "hasConsent" ;
rdfs:comment "Relates a Solid app or Pod to its consent decisions".

:hasProvenance a owl:ObjectProperty ;
rdfs:label "hasProvenance" ;
rdfs:comment "Relates a Solid app or Pod to its provenance metadata".

:hasLegalCompliance a owl:ObjectProperty ;
rdfs:label "hasLegalCompliance" ;
rdfs:comment "Relates a Solid app or Pod to its legal compliance information".

:SolidActor owl:hasClass :Identity.
:SolidRole owl:hasClass :Identity.
:Pod owl:hasClass :SolidActor.