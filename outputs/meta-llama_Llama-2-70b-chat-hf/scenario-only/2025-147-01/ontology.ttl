@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Maritime Domain Ontology" ;
rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

# Fleet Management and Operational Planning
:Vessel a owl:Class ;
rdfs:label "Vessel" ;
rdfs:comment "A physical ship or boat.".

:VesselType a owl:Class ;
rdfs:label "VesselType" ;
rdfs:comment "A category of vessels based on their characteristics.".

:VesselCharacteristic a owl:Class ;
rdfs:label "VesselCharacteristic" ;
rdfs:comment "A property or feature of a vessel.".

:VesselHasCharacteristic a owl:ObjectProperty ;
rdfs:label "VesselHasCharacteristic" ;
rdfs:comment "A relationship between a vessel and a characteristic.".

:VesselHasType a owl:ObjectProperty ;
rdfs:label "VesselHasType" ;
rdfs:comment "A relationship between a vessel and its type.".

# Search and Rescue (SAR) Operations
:VesselTrajectory a owl:Class ;
rdfs:label "VesselTrajectory" ;
rdfs:comment "A sequence of locations and timestamps for a vessel.".

:VesselTrajectoryPoint a owl:Class ;
rdfs:label "VesselTrajectoryPoint" ;
rdfs:comment "A single location and timestamp in a vessel trajectory.".

:VesselTrajectoryHasPoint a owl:ObjectProperty ;
rdfs:label "VesselTrajectoryHasPoint" ;
rdfs:comment "A relationship between a vessel trajectory and a trajectory point.".

# Semantic Data Integration, Search and Analysis
:DataSource a owl:Class ;
rdfs:label "DataSource" ;
rdfs:comment "A source of data, such as an AIS feed or ship registry.".

:DataHasVessel a owl:ObjectProperty ;
rdfs:label "DataHasVessel" ;
rdfs:comment "A relationship between data and a vessel.".

:VesselHasData a owl:ObjectProperty ;
rdfs:label "VesselHasData" ;
rdfs:comment "A relationship between a vessel and data associated with it.".

# Digital Twins and Life Cycle Simulations
:PropulsionSystem a owl:Class ;
rdfs:label "PropulsionSystem" ;
rdfs:comment "A system that provides propulsion for a vessel.".

:PropulsionSystemType a owl:Class ;
rdfs:label "PropulsionSystemType" ;
rdfs:comment "A category of propulsion systems based on their characteristics.".

:VesselHasPropulsionSystem a owl:ObjectProperty ;
rdfs:label "VesselHasPropulsionSystem" ;
rdfs:comment "A relationship between a vessel and its propulsion system.".

:DigitalTwin a owl:Class ;
rdfs:label "DigitalTwin" ;
rdfs:comment "A digital representation of a vessel and its components.".

:DigitalTwinHasVessel a owl:ObjectProperty ;
rdfs:label "DigitalTwinHasVessel" ;
rdfs:comment "A relationship between a digital twin and the vessel it represents.".

:DigitalTwinHasPropulsionSystem a owl:ObjectProperty ;
rdfs:label "DigitalTwinHasPropulsionSystem" ;
rdfs:comment "A relationship between a digital twin and its propulsion system.".