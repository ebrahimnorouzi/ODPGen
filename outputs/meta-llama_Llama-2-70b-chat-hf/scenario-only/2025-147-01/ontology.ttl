@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Maritime Domain Ontology" ;
rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

:Ship a owl:Class ;
rdfs:label "Ship" ;
rdfs:comment "A physical vessel navigating through water.".

:VesselCharacteristics a owl:Class ;
rdfs:label "VesselCharacteristics" ;
rdfs:comment "A set of properties describing a ship's technical specifications.".

:VesselTrajectory a owl:Class ;
rdfs:label "VesselTrajectory" ;
rdfs:comment "A sequence of geospatial coordinates representing a ship's movement over time.".

:PropulsionSystem a owl:Class ;
rdfs:label "PropulsionSystem" ;
rdfs:comment "A system responsible for generating thrust to propel a ship forward.".

:DigitalTwin a owl:Class ;
rdfs:label "DigitalTwin" ;
rdfs:comment "A virtual representation of a physical ship, used for simulation and analysis purposes.".

:FleetManagement a owl:Class ;
rdfs:label "FleetManagement" ;
rdfs:comment "The process of managing a fleet of ships, including operational planning and logistics.".

:SearchAndRescue a owl:Class ;
rdfs:label "SearchAndRescue" ;
rdfs:comment "Emergency response operations aimed at locating and assisting vessels in distress.".

:SemanticDataIntegration a owl:Class ;
rdfs:label "SemanticDataIntegration" ;
rdfs:comment "The process of integrating heterogeneous data sources using semantic web technologies.".

:LifeCycleSimulation a owl:Class ;
rdfs:label "LifeCycleSimulation" ;
rdfs:comment "A digital simulation of a ship's lifecycle, including its design, construction, operation, and decommissioning.".

:Ship rdfs:subClassOf :VesselCharacteristics.
:Ship rdfs:subClassOf :VesselTrajectory.
:Ship rdfs:subClassOf :PropulsionSystem.
:Ship rdfs:subClassOf :DigitalTwin.
:FleetManagement rdfs:subClassOf :SemanticDataIntegration.
:SearchAndRescue rdfs:subClassOf :SemanticDataIntegration.
:LifeCycleSimulation rdfs:subClassOf :SemanticDataIntegration.

:hasVesselCharacteristics :Ship :VesselCharacteristics ;
rdfs:label "hasVesselCharacteristics" ;
rdfs:comment "A ship's technical specifications.".

:hasVesselTrajectory :Ship :VesselTrajectory ;
rdfs:label "hasVesselTrajectory" ;
rdfs:comment "A ship's movement history.".

:hasPropulsionSystem :Ship :PropulsionSystem ;
rdfs:label "hasPropulsionSystem" ;
rdfs:comment "A ship's propulsion system.".

:hasDigitalTwin :Ship :DigitalTwin ;
rdfs:label "hasDigitalTwin" ;
rdfs:comment "A virtual representation of a ship.".

:isPartOfFleet :Ship :FleetManagement ;
rdfs:label "isPartOfFleet" ;
rdfs:comment "A ship's association with a fleet.".