@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Request Ontology" ;
rdfs:comment "Formal description of a requested action by an assignee on a target asset, which can be enriched with further contextual information.".

:Request a owl:Class ;
rdfs:label "Request" ;
rdfs:comment "A request made by an assignee on a target asset.".

:Assignee a owl:Class ;
rdfs:label "Assignee" ;
rdfs:comment "An individual who made a request.".

:TargetAsset a owl:Class ;
rdfs:label "Target Asset" ;
rdfs:comment "The asset on which the request is made.".

:Context a owl:Class ;
rdfs:label "Context" ;
rdfs:comment "Additional information about the request.".

:TemporalContext a owl:SubClassOf :Context ;
rdfs:label "Temporal Context" ;
rdfs:comment "Context related to time.".

:SpatialContext a owl:SubClassOf :Context ;
rdfs:label "Spatial Context" ;
rdfs:comment "Context related to location.".

:RoleContext a owl:SubClassOf :Context ;
rdfs:label "Role Context" ;
rdfs:comment "Context related to the role of the assignee.".

:RequestCapabilityContext a owl:SubClassOf :Context ;
rdfs:label "Request Capability Context" ;
rdfs:comment "Context related to the capabilities of the assignee.".

:Allowed a owl:ObjectProperty ;
rdfs:label "Allowed" ;
rdfs:comment "Indicates whether the request is allowed.".

:Denied a owl:ObjectProperty ;
rdfs:label "Denied" ;
rdfs:comment "Indicates whether the request is denied.".

:Evaluation a owl:Class ;
rdfs:label "Evaluation" ;
rdfs:comment "The result of evaluating a request.".

:Evaluation a owl:SubClassOf :Request.

:Allowed a owl:ObjectProperty ;
rdfs:domain :Evaluation ;
rdfs:range :Boolean.

:Denied a owl:ObjectProperty ;
rdfs:domain :Evaluation ;
rdfs:range :Boolean.

:Context a owl:ObjectProperty ;
rdfs:domain :Request ;
rdfs:range :Context.

:Evaluation a owl:ObjectProperty ;
rdfs:domain :Request ;
rdfs:range :Evaluation.