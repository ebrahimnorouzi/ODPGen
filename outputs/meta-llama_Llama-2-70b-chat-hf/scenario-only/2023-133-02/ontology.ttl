@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Asthma Patient Monitoring Ontology" ;
rdfs:comment "An ontology for representing data collected about pediatric asthma patients, including symptoms, medication intake, and outdoor environmental factors.".

:Patient a owl:Class ;
rdfs:label "Patient" ;
rdfs:comment "A person diagnosed with asthma.".

:Symptom a owl:Class ;
rdfs:label "Symptom" ;
rdfs:comment "A symptom experienced by a patient, such as cough, chest tightness, wheezing, or breathing patterns.".

:Medication a owl:Class ;
rdfs:label "Medication" ;
rdfs:comment "A medication taken by a patient to treat their asthma symptoms.".

:OutdoorEnvironment a owl:Class ;
rdfs:label "Outdoor Environment" ;
rdfs:comment "The outdoor environment in which a patient lives, including pollen and air quality index (AQI) levels.".

:CausalRelation a owl:ObjectProperty ;
rdfs:label "Causal Relation" ;
rdfs:comment "A relation between two entities, where the presence of one entity (the cause) affects the other entity (the effect).".

:Patient hasSymptom :Symptom ;
rdfs:label "hasSymptom" ;
rdfs:comment "A patient experiences a symptom.".

:Patient takesMedication :Medication ;
rdfs:label "takesMedication" ;
rdfs:comment "A patient takes a medication to treat their asthma symptoms.".

:OutdoorEnvironment hasPollen xsd:boolean ;
rdfs:label "hasPollen" ;
rdfs:comment "The outdoor environment contains pollen.".

:OutdoorEnvironment hasAQI xsd:integer ;
rdfs:label "hasAQI" ;
rdfs:comment "The outdoor environment has an air quality index (AQI) level.".

:CausalRelation( :Patient, :Symptom, "0.8"^^xsd:decimal ) ;
rdfs:label "Causal Relation between Patient and Symptom" ;
rdfs:comment "The presence of outdoor allergen: pollen/AQI causes a patient to experience a cough with a causal effect weight of 0.8.".

:CausalRelation( :Patient, :Medication, "0.4"^^xsd:decimal ) ;
rdfs:label "Causal Relation between Patient and Medication" ;
rdfs:comment "The presence of outdoor allergen: pollen/AQI causes a patient to take a medication with a causal effect weight of 0.4.".