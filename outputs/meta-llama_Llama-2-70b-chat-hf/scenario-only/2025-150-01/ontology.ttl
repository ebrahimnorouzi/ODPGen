@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "MQTT Payload Ontology" ;
rdfs:comment "An ontology for modeling automated process data captured and transmitted via MQTT packets.".

:Payload a owl:Class ;
rdfs:label "Payload" ;
rdfs:comment "A class representing an MQTT payload.".

:Format a owl:Class ;
rdfs:label "Format" ;
rdfs:comment "A class representing the format of an MQTT payload.".

:PlainText a :Format ;
rdfs:label "PlainText" ;
rdfs:comment "A class representing a plain text format.".

:CSV a :Format ;
rdfs:label "CSV" ;
rdfs:comment "A class representing a comma-separated values format.".

:JSON a :Format ;
rdfs:label "JSON" ;
rdfs:comment "A class representing a JSON format.".

:CharacterSet a owl:Class ;
rdfs:label "CharacterSet" ;
rdfs:comment "A class representing a character set.".

:UTF8 a :CharacterSet ;
rdfs:label "UTF8" ;
rdfs:comment "A class representing the UTF-8 character set.".

:PayloadHasFormat a owl:ObjectProperty ;
rdfs:label "PayloadHasFormat" ;
rdfs:comment "A property representing the format of a payload.".

:PayloadHasCharacterSet a owl:ObjectProperty ;
rdfs:label "PayloadHasCharacterSet" ;
rdfs:comment "A property representing the character set of a payload.".

:PayloadHasData a owl:ObjectProperty ;
rdfs:label "PayloadHasData" ;
rdfs:comment "A property representing the data contained in a payload.".

:Data a owl:Class ;
rdfs:label "Data" ;
rdfs:comment "A class representing the data contained in a payload.".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "A class representing an observation related to a payload.".

:Actuation a owl:Class ;
rdfs:label "Actuation" ;
rdfs:comment "A class representing an actuation related to a payload.".

:PayloadIsRelatedToObservation a owl:ObjectProperty ;
rdfs:label "PayloadIsRelatedToObservation" ;
rdfs:comment "A property representing the relationship between a payload and an observation.".

:PayloadIsRelatedToActuation a owl:ObjectProperty ;
rdfs:label "PayloadIsRelatedToActuation" ;
rdfs:comment "A property representing the relationship between a payload and an actuation.".