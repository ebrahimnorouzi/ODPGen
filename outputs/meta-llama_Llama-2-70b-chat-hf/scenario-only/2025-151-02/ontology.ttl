@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "ODRL Policy Evaluation Ontology" ;
rdfs:comment "An ontology for representing real-world information aiding the evaluation of ODRL Policies.".

:Person a owl:Class ;
rdfs:label "Person" ;
rdfs:comment "A person who needs access to a video stream.".

:VideoStream a owl:Class ;
rdfs:label "VideoStream" ;
rdfs:comment "A video stream that can be accessed.".

:AccessRequest a owl:Class ;
rdfs:label "AccessRequest" ;
rdfs:comment "A request for access to a video stream.".

:Minutes a owl:Class ;
rdfs:label "Minutes" ;
rdfs:comment "A set of minutes within a video stream.".

:AcademicResearchProject a owl:Class ;
rdfs:label "AcademicResearchProject" ;
rdfs:comment "A research project that requires access to a video stream.".

:Bob a :Person ;
rdfs:label "Bob" ;
rdfs:comment "The person who needs access to the video stream.".

:videoStream a :VideoStream ;
rdfs:label "Video Stream" ;
rdfs:comment "The video stream that Bob needs access to.".

:accessRequest a :AccessRequest ;
rdfs:label "Access Request" ;
rdfs:comment "The access request made by Bob.".

:minutes4to9 a :Minutes ;
rdfs:label "Minutes 4-9" ;
rdfs:comment "The minutes within the video stream that Bob needs access to.".

:academicResearchProject a :AcademicResearchProject ;
rdfs:label "Academic Research Project" ;
rdfs:comment "The research project that Bob is working on.".

:Bob a :academicResearchProject :videoStream.
:videoStream a :accessRequest :minutes4to9.