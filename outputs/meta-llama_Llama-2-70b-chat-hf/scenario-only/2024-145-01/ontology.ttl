@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Legal Tasks Ontology" ;
rdfs:comment "An ontology for modeling legal tasks and their related information.".

:LegalTask a owl:Class ;
rdfs:label "LegalTask" ;
rdfs:comment "A legal task, such as a court case or a legal document.".

:Court a owl:Class ;
rdfs:label "Court" ;
rdfs:comment "A court of law.".

:CourtHierarchy a owl:Class ;
rdfs:label "CourtHierarchy" ;
rdfs:comment "A hierarchy of courts, with higher courts having jurisdiction over lower courts.".

:BadCheckCrime a owl:Class ;
rdfs:label "BadCheckCrime" ;
rdfs:comment "A crime related to writing bad checks.".

:Regulation a owl:Class ;
rdfs:label "Regulation" ;
rdfs:comment "A regulation related to bad check crime.".

:LegalTask hasCourt :Court ;
rdfs:label "hasCourt" ;
rdfs:comment "The court associated with a legal task.".

:LegalTask hasCourtHierarchy :CourtHierarchy ;
rdfs:label "hasCourtHierarchy" ;
rdfs:comment "The court hierarchy associated with a legal task.".

:LegalTask hasBadCheckCrime :BadCheckCrime ;
rdfs:label "hasBadCheckCrime" ;
rdfs:comment "The bad check crime associated with a legal task.".

:LegalTask hasRegulation :Regulation ;
rdfs:label "hasRegulation" ;
rdfs:comment "The regulation associated with a legal task.".