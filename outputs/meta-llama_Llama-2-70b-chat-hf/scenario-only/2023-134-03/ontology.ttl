@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Patterns Ontology" ;
rdfs:comment "An ontology for modeling governance patterns in Solid applications".

### Classes

:SolidActor a owl:Class ;
rdfs:label "Solid Actor" ;
rdfs:comment "A Solid actor is an entity that provides a Pod or an app".

:SolidPod a owl:Class ;
rdfs:label "Solid Pod" ;
rdfs:comment "A Solid Pod is a container for data and apps".

:SolidApp a owl:Class ;
rdfs:label "Solid App" ;
rdfs:comment "A Solid app is a software application that runs on a Solid Pod".

:DataCategory a owl:Class ;
rdfs:label "Data Category" ;
rdfs:comment "A data category is a classification of data based on its purpose or sensitivity".

:PrivacyPolicy a owl:Class ;
rdfs:label "Privacy Policy" ;
rdfs:comment "A privacy policy is a set of rules and guidelines for handling personal data".

### Properties

:hasRole a owl:ObjectProperty ;
rdfs:label "has role" ;
rdfs:comment "A Solid actor has a role in providing a Pod or an app".

:provides a owl:ObjectProperty ;
rdfs:label "provides" ;
rdfs:comment "A Solid Pod provides a home for apps and data".

:runsOn a owl:ObjectProperty ;
rdfs:label "runs on" ;
rdfs:comment "A Solid app runs on a Solid Pod".

:hasDataCategory a owl:ObjectProperty ;
rdfs:label "has data category" ;
rdfs:comment "A Solid app has access to data categories in a Pod".

:hasPrivacyPolicy a owl:ObjectProperty ;
rdfs:label "has privacy policy" ;
rdfs:comment "A Solid app has a privacy policy that governs its data handling practices".

### Axioms

:SolidActor subClassOf owl:Agent ;
rdfs:label "Solid Actor is a type of agent".

:SolidPod subClassOf owl:Resource ;
rdfs:label "Solid Pod is a type of resource".

:SolidApp subClassOf owl:Agent ;
rdfs:label "Solid App is a type of agent".

:DataCategory subClassOf owl:Class ;
rdfs:label "Data Category is a type of class".

:PrivacyPolicy subClassOf owl:Policy ;
rdfs:label "Privacy Policy is a type of policy".

:hasRole domain :SolidActor ;
rdfs:label "Role is played by Solid Actor".

:provides range :SolidPod ;
rdfs:label "Solid Pod is provided by Solid Actor".

:runsOn domain :SolidApp ;
rdfs:label "Solid App runs on Solid Pod".

:hasDataCategory domain :SolidApp ;
rdfs:label "Solid App has access to data categories in Solid Pod".

:hasPrivacyPolicy domain :SolidApp ;
rdfs:label "Solid App has a privacy policy that governs its data handling practices".

### Disjointness

:SolidActor disjointWith :SolidPod, :SolidApp ;
rdfs:label "Solid Actor is disjoint from Solid Pod and Solid App".