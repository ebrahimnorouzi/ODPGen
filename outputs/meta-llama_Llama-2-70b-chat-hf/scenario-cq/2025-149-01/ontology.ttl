@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
:rdfs:label "Relational Database Access Control Ontology" ;
:rdfs:comment "An ontology for securing access to a relational database queried via SQL.".

; :Scenario-requirement-to-axiom mapping

; 1. Can the ontology represent a relational database as a first-class schema entity?
:Database a owl:Class ;
:rdfs:label "Database" ;
:rdfs:comment "A relational database.".

; 2. Can the ontology represent tables belonging to a database?
:Table a owl:Class ;
:rdfs:label "Table" ;
:rdfs:comment "A table in a relational database.".

; 3. Can the ontology represent columns belonging to a table?
:Column a owl:Class ;
:rdfs:label "Column" ;
:rdfs:comment "A column in a table.".

; 4. Can the ontology represent primary-key relationships in the schema?
:PrimaryKey a owl:ObjectProperty ;
:rdfs:label "PrimaryKey" ;
:rdfs:comment "A primary key relationship between two columns.".

; 5. Can the ontology represent foreign-key relationships and distinguish same-named columns across different tables when they are not semantically linked?
:ForeignKey a owl:ObjectProperty ;
:rdfs:label "ForeignKey" ;
:rdfs:comment "A foreign key relationship between two columns.".

; 6. Can the ontology define a policy for a specific agent?
:Policy a owl:Class ;
:rdfs:label "Policy" ;
:rdfs:comment "A policy for a specific agent.".

; 7. Can a policy specify a high-level ReadAction?
:ReadAction a owl:Class ;
:rdfs:label "ReadAction" ;
:rdfs:comment "A high-level read action.".

; 8. Can a policy specify a high-level ModifyAction?
:ModifyAction a owl:Class ;
:rdfs:label "ModifyAction" ;
:rdfs:comment "A high-level modify action.".

; 9. Can a policy specify a ViewActionScope for read operations?
:ViewActionScope a owl:Class ;
:rdfs:label "ViewActionScope" ;
:rdfs:comment "A view action scope for read operations.".

; 10. Can a policy specify a ProcessActionScope for read operations?
:ProcessActionScope a owl:Class ;
:rdfs:label "ProcessActionScope" ;
:rdfs:comment "A process action scope for read operations.".

; 11. Can a policy be defined at table level?
:TablePolicy a owl:Class ;
:rdfs:label "TablePolicy" ;
:rdfs:comment "A policy defined at table level.".

; 12. Can a policy be defined at column level?
:ColumnPolicy a owl:Class ;
:rdfs:label "ColumnPolicy" ;
:rdfs:comment "A policy defined at column level.".

; 13. Can a policy be defined at row level using conditions?
:RowPolicy a owl:Class ;
:rdfs:label "RowPolicy" ;
:rdfs:comment "A policy defined at row level using conditions.".

; 14. Can the ontology express a prohibited modify action on a table?
:ProhibitedModifyAction a owl:Class ;
:rdfs:label "ProhibitedModifyAction" ;
:rdfs:comment "A prohibited modify action on a table.".

; 15. Can the ontology express a table-level read prohibition for
