@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid applications".

:Solid a owl:Class ;
rdfs:label "Solid" ;
rdfs:comment "A Solid application or service".

:Identity a owl:Class ;
rdfs:label "Identity" ;
rdfs:comment "A Solid actor's identity".

:Role a owl:Class ;
rdfs:label "Role" ;
rdfs:comment "A Solid actor's role".

:Pod a owl:Class ;
rdfs:label "Pod" ;
rdfs:comment "A Solid Pod".

:App a owl:Class ;
rdfs:label "App" ;
rdfs:comment "A Solid app".

:DataCategory a owl:Class ;
rdfs:label "DataCategory" ;
rdfs:comment "A category of data in a Pod".

:PrivacyPolicy a owl:Class ;
rdfs:label "PrivacyPolicy" ;
rdfs:comment "A privacy policy for a Solid app".

:Consent a owl:Class ;
rdfs:label "Consent" ;
rdfs:comment "A consent record for a Solid app".

:AccessRequest a owl:Class ;
rdfs:label "AccessRequest" ;
rdfs:comment "An access request for a Solid app".

:AccessMode a owl:Class ;
rdfs:label "AccessMode" ;
rdfs:comment "The access mode for an access request".

:PersonalData a owl:Class ;
rdfs:label "PersonalData" ;
rdfs:comment "Personal data being accessed".

:Purpose a owl:Class ;
rdfs:label "Purpose" ;
rdfs:comment "The purpose of an access request".

:SolidUser a owl:Class ;
rdfs:label "SolidUser" ;
rdfs:comment "A user of a Solid app".

:SolidProvider a owl:Class ;
rdfs:label "SolidProvider" ;
rdfs:comment "A provider of a Solid app or Pod".

:PolicyIssued a owl:ObjectProperty ;
rdfs:label "policyIssued" ;
rdfs:comment "The date a privacy policy was issued".

:PolicyCreator a owl:ObjectProperty ;
rdfs:label "policyCreator" ;
rdfs:comment "The creator of a privacy policy".

:Assignee a owl:ObjectProperty ;
rdfs:label "assignee" ;
rdfs:comment "The assignee of a privacy policy".

:AppUsed a owl:ObjectProperty ;
rdfs:label "appUsed" ;
rdfs:comment "The app being used to access data".

:AccessRequested a owl:ObjectProperty ;
rdfs:label "accessRequested" ;
rdfs:comment "The data being accessed".

:AccessModeRequested a owl:ObjectProperty ;
rdfs:label "accessModeRequested" ;
rdfs:comment "The access mode being requested".

:PurposeOfAccess a owl:ObjectProperty ;
rdfs:label "purposeOfAccess" ;
rdfs:comment "The purpose of the access request".

:ConsentRecord a owl:ObjectProperty ;
rdfs:label "consentRecord" ;
rdfs:comment "A record of consent for a Solid app".