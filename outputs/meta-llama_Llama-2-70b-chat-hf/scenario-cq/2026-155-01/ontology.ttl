@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Cultural Heritage Survey ODP" ;
rdfs:comment "Ontology for modeling scientific survey activities performed on cultural heritage entities".

:Survey a owl:Class ;
rdfs:label "Survey" ;
rdfs:comment "Represents a scientific survey activity performed on a cultural heritage entity".

:Investigation a owl:Class ;
rdfs:label "Investigation" ;
rdfs:comment "Represents a specific investigation or analysis activity within a survey".

:Method a owl:Class ;
rdfs:label "Method" ;
rdfs:comment "Represents a specific investigation technique or method used in a survey".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "Represents a specific observation or measurement produced during a survey".

:Expert a owl:Class ;
rdfs:label "Expert" ;
rdfs:comment "Represents an individual with a specific role or expertise participating in a survey".

:Equipment a owl:Class ;
rdfs:label "Equipment" ;
rdfs:comment "Represents the hardware, software, or technical configurations used in a survey".

:Interpretation a owl:Class ;
rdfs:label "Interpretation" ;
rdfs:comment "Represents a conclusion or claim supported by the observations produced during a survey".

:PostProcessedOutput a owl:Class ;
rdfs:label "Post-processed Output" ;
rdfs:comment "Represents an output produced after the data acquisition process, such as an interactive image, spectrum, or dataset".

:AcquisitionParameter a owl:Class ;
rdfs:label "Acquisition Parameter" ;
rdfs:comment "Represents a parameter characterizing a specific photographic acquisition cycle within a survey, such as exposure time, ISO, or aperture".

:Survey
  a owl:hasClass :Investigation ;
  a owl:hasClass :Method ;
  a owl:hasClass :Observation ;
  a owl:hasClass :Expert ;
  a owl:hasClass :Equipment ;
  a owl:hasClass :Interpretation.

:Investigation
  a owl:hasClass :Method ;
  a owl:hasClass :Observation.

:Method
  a owl:hasClass :Observation.

:Expert
  a owl:hasClass :Role.

:Equipment
  a owl:hasClass :Configuration.

:Interpretation
  a owl:hasClass :Conclusion.

:PostProcessedOutput
  a owl:hasClass :Output.

:AcquisitionParameter
  a owl:hasClass :Parameter.