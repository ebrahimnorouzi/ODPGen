@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Cultural Heritage Survey ODP" ;
rdfs:comment "Ontology for modeling scientific survey activities performed on cultural heritage entities".

### Classes

:Survey a owl:Class ;
rdfs:label "Survey" ;
rdfs:comment "Represents a scientific survey activity performed on a cultural heritage entity".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "Represents a single observation or measurement produced during a survey".

:Method a owl:Class ;
rdfs:label "Method" ;
rdfs:comment "Represents an investigation technique or method used during a survey".

:Equipment a owl:Class ;
rdfs:label "Equipment" ;
rdfs:comment "Represents the hardware, software, and technical configurations used to conduct a survey".

:Expert a owl:Class ;
rdfs:label "Expert" ;
rdfs:comment "Represents an individual with a specific role or expertise participating in a survey".

:Interpretation a owl:Class ;
rdfs:label "Interpretation" ;
rdfs:comment "Represents a conclusion or claim supported by the observations produced during a survey".

### Properties

:has_method a owl:ObjectProperty ;
rdfs:label "has method" ;
rdfs:comment "Relates a survey to the method or investigation technique used".

:has_observations a owl:ObjectProperty ;
rdfs:label "has observations" ;
rdfs:comment "Relates a survey to the observations produced during the activity".

:has_equipment a owl:ObjectProperty ;
rdfs:label "has equipment" ;
rdfs:comment "Relates a survey to the hardware, software, and technical configurations used".

:has_experts a owl:ObjectProperty ;
rdfs:label "has experts" ;
rdfs:comment "Relates a survey to the individuals with specific roles or expertise participating in the activity".

:has_interpretations a owl:ObjectProperty ;
rdfs:label "has interpretations" ;
rdfs:comment "Relates a survey to the conclusions or claims supported by the observations produced during the activity".

:is_part_of a owl:ObjectProperty ;
rdfs:label "is part of" ;
rdfs:comment "Relates an observation to the survey it was produced during".

:uses_parameter a owl:ObjectProperty ;
rdfs:label "uses parameter" ;
rdfs:comment "Relates a survey to the acquisition parameters used during the activity".

### Individuals

:Survey1 a :Survey ;
rdfs:label "Survey 1" ;
has_method :Method1.

:Survey2 a :Survey ;
rdfs:label "Survey 2" ;
has_method :Method2.

:Observation1 a :Observation ;
rdfs:label "Observation 1" ;
is_part_of :Survey1.

:Observation2 a :Observation ;
rdfs:label "Observation 2" ;
is_part_of :Survey2.

:Method1 a :Method ;
rdfs:label "Method 1".

:Method2 a :Method ;
rdfs:label "Method 2".