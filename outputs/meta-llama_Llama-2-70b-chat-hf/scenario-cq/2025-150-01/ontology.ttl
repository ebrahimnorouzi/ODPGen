@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "An ontology for describing MQTT messages and their relationships.".

### Classes

:MQTT a owl:Class ;
  rdfs:label "MQTT" ;
  rdfs:comment "Represents an MQTT message.".

:MQTTClient a owl:Class ;
  rdfs:label "MQTTClient" ;
  rdfs:comment "Represents an MQTT client.".

:MQTTBroker a owl:Class ;
  rdfs:label "MQTTBroker" ;
  rdfs:comment "Represents an MQTT broker.".

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTTNetworkConnection" ;
  rdfs:comment "Represents an MQTT network connection.".

:MQTTTopic a owl:Class ;
  rdfs:label "MQTTTopic" ;
  rdfs:comment "Represents an MQTT topic.".

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTTTopicFilter" ;
  rdfs:comment "Represents an MQTT topic filter.".

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTTControlPacket" ;
  rdfs:comment "Represents an MQTT control packet.".

:MQTTPublishPacket a owl:Class ;
  rdfs:label "MQTTPublishPacket" ;
  rdfs:comment "Represents an MQTT publish packet.".

:MQTTSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTTSUBSCRIBEPacket" ;
  rdfs:comment "Represents an MQTT subscribe packet.".

:MQTTUNSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTTUNSUBSCRIBEPacket" ;
  rdfs:comment "Represents an MQTT unsubscribe packet.".

:SOSA a owl:Class ;
  rdfs:label "SOSA" ;
  rdfs:comment "Represents a SOSA system.".

:SOSASensor a owl:Class ;
  rdfs:label "SOSASensor" ;
  rdfs:comment "Represents a SOSA sensor.".

:SOSAActuator a owl:Class ;
  rdfs:label "SOSAActuator" ;
  rdfs:comment "Represents a SOSA actuator.".

:SOSAObservation a owl:Class ;
  rdfs:label "SOSAObservation" ;
  rdfs:comment "Represents a SOSA observation.".

:SOSAProperty a owl:Class ;
  rdfs:label "SOSAProperty" ;
  rdfs:comment "Represents a SOSA property.".

:SOSAFeatureOfInterest a owl:Class ;
  rdfs:label "SOSAFeatureOfInterest" ;
  rdfs:comment "Represents a SOSA feature of interest.".

### Properties

:hasClient a owl:ObjectProperty ;
  rdfs:label "hasClient" ;
  rdfs:comment "A client that sends or receives an MQTT message.".