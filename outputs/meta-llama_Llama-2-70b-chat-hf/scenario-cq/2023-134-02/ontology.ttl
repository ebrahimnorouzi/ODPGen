@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid applications".

:Solid a owl:Class ;
rdfs:label "Solid" ;
rdfs:comment "A Solid application or service".

:Pod a owl:Class ;
rdfs:label "Pod" ;
rdfs:comment "A Solid Pod".

:App a owl:Class ;
rdfs:label "App" ;
rdfs:comment "A Solid application".

:Identity a owl:Class ;
rdfs:label "Identity" ;
rdfs:comment "An identity of a Solid actor".

:Role a owl:Class ;
rdfs:label "Role" ;
rdfs:comment "A role of a Solid actor".

:Metadata a owl:Class ;
rdfs:label "Metadata" ;
rdfs:comment "Metadata about a Solid Pod or app".

:DataCategory a owl:Class ;
rdfs:label "DataCategory" ;
rdfs:comment "A category of data in a Solid Pod".

:PrivacyPolicy a owl:Class ;
rdfs:label "PrivacyPolicy" ;
rdfs:comment "A privacy policy of a Solid user".

:Consent a owl:Class ;
rdfs:label "Consent" ;
rdfs:comment "A consent record of a Solid user".

:Provenance a owl:Class ;
rdfs:label "Provenance" ;
rdfs:comment "Provenance metadata of a Solid Pod or app".

:LegalCompliance a owl:Class ;
rdfs:label "LegalCompliance" ;
rdfs:comment "Legal compliance information of a Solid Pod or app".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "An action performed on data in a Solid Pod or app".

:Entity a owl:Class ;
rdfs:label "Entity" ;
rdfs:comment "An entity interacting with data in a Solid Pod or app".

:Log a owl:Class ;
rdfs:label "Log" ;
rdfs:comment "A log of events in a Solid Pod or app".

:Issue a owl:Class ;
rdfs:label "Issue" ;
rdfs:comment "An issue related to data handling in a Solid Pod or app".

:Resolution a owl:Class ;
rdfs:label "Resolution" ;
rdfs:comment "A resolution of an issue related to data handling in a Solid Pod or app".

:SolidUser a owl:Class ;
rdfs:label "SolidUser" ;
rdfs:comment "A user of a Solid application or service".

:SolidProvider a owl:Class ;
rdfs:label "SolidProvider" ;
rdfs:comment "A provider of a Solid Pod or app".

:DataHandling a owl:Class ;
rdfs:label "DataHandling" ;
rdfs:comment "A data handling process in a Solid Pod or app".

:DataRequest a owl:Class ;
rdfs:label "DataRequest" ;
rdfs:comment "A data request from a Solid user".

:DataResponse a owl:Class ;
rdfs:label "DataResponse" ;
rdfs:comment "A data response to a Solid user".