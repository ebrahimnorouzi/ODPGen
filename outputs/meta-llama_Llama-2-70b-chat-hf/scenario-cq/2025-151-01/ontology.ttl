@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Evaluation Request Ontology" ;
rdfs:comment "An ontology for describing evaluation requests and their context".

# Scenario-requirement-to-axiom mapping

# 1. Formal description of a requested action by an assignee on a target asset
:Assignee a owl:Class ;
rdfs:label "Assignee" ;
rdfs:comment "An individual or organization responsible for performing an action".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "A specific task or activity to be performed".

:TargetAsset a owl:Class ;
rdfs:label "Target Asset" ;
rdfs:comment "The asset on which the action is to be performed".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request to evaluate an action on a target asset".

:Evaluation a owl:Class ;
rdfs:label "Evaluation" ;
rdfs:comment "The process of assessing the feasibility, relevance, and impact of an action".

# 2. Access is allowed only to employees
:Employee a owl:Class ;
rdfs:label "Employee" ;
rdfs:comment "An individual working for an organization".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request to evaluate an action on a target asset".

:Employee a owl:ObjectProperty ;
rdfs:label "employee" ;
rdfs:comment "An employee who is authorized to perform an action".

:EvaluationRequest a owl:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "An evaluation request issued by an employee".

# 3. Only on weekdays
:Weekday a owl:Class ;
rdfs:label "Weekday" ;
rdfs:comment "A day of the week, Monday through Friday".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request to evaluate an action on a target asset".

:Weekday a owl:ObjectProperty ;
rdfs:label "weekday" ;
rdfs:comment "The day of the week on which the evaluation request was issued".

:EvaluationRequest a owl:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "An evaluation request issued on a weekday".

# 4. Only from the EU
:EU a owl:Class ;
rdfs:label "EU" ;
rdfs:comment "The European Union".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request to evaluate an action on a target asset".

:EU a owl:ObjectProperty ;
rdfs:label "eu" ;
rdfs:comment "The EU country in which the evaluation request was issued".

:EvaluationRequest a owl:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "An evaluation request issued from the EU".