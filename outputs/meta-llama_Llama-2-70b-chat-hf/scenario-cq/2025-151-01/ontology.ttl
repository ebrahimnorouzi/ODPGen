@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Evaluation Request Ontology" ;
rdfs:comment "An ontology for describing evaluation requests and their context".

:EvaluationRequest a owl:Class ;
rdfs:label "EvaluationRequest" ;
rdfs:comment "A request for evaluating a target asset".

:RequestedAction a owl:ObjectProperty ;
rdfs:label "requestedAction" ;
rdfs:comment "The action requested by the evaluation request".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "An entity that issues an evaluation request".

:IssuingParty a owl:ObjectProperty ;
rdfs:label "issuingParty" ;
rdfs:comment "The party that issued the evaluation request".

:TargetAsset a owl:Class ;
rdfs:label "TargetAsset" ;
rdfs:comment "The asset being evaluated".

:Target a owl:ObjectProperty ;
rdfs:label "target" ;
rdfs:comment "The target asset of the evaluation request".

:When a owl:DatatypeProperty ;
rdfs:label "when" ;
rdfs:comment "The date and time when the evaluation request was issued".

:AdditionalContext a owl:Class ;
rdfs:label "AdditionalContext" ;
rdfs:comment "Additional contextual information that can be included in the evaluation request".

:IncludesContext a owl:ObjectProperty ;
rdfs:label "includesContext" ;
rdfs:comment "The additional context included in the evaluation request".

:EU a owl:Class ;
rdfs:label "EU" ;
rdfs:comment "The European Union".

:Weekday a owl:Class ;
rdfs:label "Weekday" ;
rdfs:comment "A day of the week".

:Employee a owl:Class ;
rdfs:label "Employee" ;
rdfs:comment "An employee of an organization".

:AllowedAccess a owl:ObjectProperty ;
rdfs:label "allowedAccess" ;
rdfs:comment "The access allowed to the evaluation request".