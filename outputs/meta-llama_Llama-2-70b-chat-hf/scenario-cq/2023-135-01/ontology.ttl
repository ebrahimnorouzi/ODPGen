@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Author Pseudonym Ontology" ;
rdfs:comment "An ontology for representing authors, their pseudonyms, and their published works.".

:Author a owl:Class ;
rdfs:label "Author" ;
rdfs:comment "A person who has written a book.".

:Pseudonym a owl:Class ;
rdfs:label "Pseudonym" ;
rdfs:comment "A name used by an author instead of their real name.".

:Book a owl:Class ;
rdfs:label "Book" ;
rdfs:comment "A written work published by an author.".

:Write a owl:ObjectProperty ;
rdfs:label "write" ;
rdfs:comment "The author wrote a book." ;
:Author :Write :Book.

:Use a owl:ObjectProperty ;
rdfs:label "use" ;
rdfs:comment "An author uses a pseudonym." ;
:Author :Use :Pseudonym.

:Change a owl:ObjectProperty ;
rdfs:label "change" ;
rdfs:comment "An author changes their name." ;
:Author :Change :Pseudonym.

:SpiritInBondage a :Book ;
rdfs:label "Spirit in Bondage" ;
rdfs:comment "A collection of poems written by C. S. Lewis.".

:CSPseudonym a :Pseudonym ;
rdfs:label "C. S. Lewis" ;
rdfs:comment "A pseudonym used by C. S. Lewis.".

:Lewis a :Author ;
rdfs:label "C. S. Lewis" ;
rdfs:comment "A famous author.".

:Trajectory a owl:Class ;
rdfs:label "Trajectory" ;
rdfs:comment "A path followed by a river.".

:River a owl:Class ;
rdfs:label "River" ;
rdfs:comment "A natural flowing body of water.".

:Cross a owl:ObjectProperty ;
rdfs:label "cross" ;
rdfs:comment "A river crosses a national park." ;
:River :Cross :NationalPark.

:NationalPark a owl:Class ;
rdfs:label "National Park" ;
rdfs:comment "A protected area of land.".