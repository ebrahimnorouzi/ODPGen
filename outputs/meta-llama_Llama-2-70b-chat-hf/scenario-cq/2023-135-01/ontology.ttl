@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
:rdfs:label "Author Name Changes Ontology" ;
:rdfs:comment "An ontology for representing author name changes and their published works.".

; :Scenario-requirement-to-axiom mapping

; 1. C. S. Lewis published a collection of poems under a pseudonym.
:Pseudonym a owl:Class ;
:rdfs:label "Pseudonym" ;
:rdfs:comment "A pseudonym used by an author to publish works.".

:Author a owl:Class ;
:rdfs:label "Author" ;
:rdfs:comment "An author who has published works under a pseudonym.".

:Publishes a owl:ObjectProperty ;
:rdfs:label "publishes" ;
:rdfs:comment "The relationship between an author and their published works.".

:SpiritInBondage a :Pseudonym ;
:rdfs:label "Spirit in Bondage" ;
:rdfs:comment "A collection of poems published by C. S. Lewis under the pseudonym 'Clive Hamilton'.".

:CliveHamilton a :Pseudonym ;
:rdfs:label "Clive Hamilton" ;
:rdfs:comment "The pseudonym used by C. S. Lewis to publish 'Spirit in Bondage'.".

; 2. C. S. Lewis used an alternative name to assume the role of a book writer.
:AlternativeName a owl:Class ;
:rdfs:label "Alternative Name" ;
:rdfs:comment "An alternative name used by an author to assume a different role.".

:BookWriter a owl:Class ;
:rdfs:label "Book Writer" ;
:rdfs:comment "An author who has written and published books.".

:Assumes a owl:ObjectProperty ;
:rdfs:label "assumes" ;
:rdfs:comment "The relationship between an author and their alternative name.".

:CliveStaplesLewis a :Author, :BookWriter ;
:rdfs:label "Clive Staples Lewis" ;
:rdfs:comment "An author who has written and published books under the pseudonym 'Clive Hamilton'.".

; 3. Show the trajectories of rivers which cross national parks.
:River a owl:Class ;
:rdfs:label "River" ;
:rdfs:comment "A natural flowing body of water.".

:NationalPark a owl:Class ;
:rdfs:label "National Park" ;
:rdfs:comment "A protected area of land or sea designated as a national park.".

:Crosses a owl:ObjectProperty ;
:rdfs:label "crosses" ;
:rdfs:comment "The relationship between a river and a national park that it crosses.".

:Trajectory a owl:Class ;
:rdfs:label "Trajectory" ;
:rdfs:comment "The path or course along which a river flows.".

:Show a owl:ObjectProperty ;
:rdfs:label "show" ;
:rdfs:comment "The relationship between a trajectory and the river that follows it.".

:RiverTrajectory a :Trajectory ;
:rdfs:label "River Trajectory" ;
:rdfs:comment "A trajectory that represents the path of a river.".

:NationalParkBoundary a owl:Class ;
:rdfs:label "National Park Boundary" ;
:rdfs:comment "A boundary that represents the limits of a national park.".

:CrossesBoundary a owl:ObjectProperty ;
:rdfs:label "crosses
