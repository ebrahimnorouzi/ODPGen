@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "ODRL Policy Evaluation Ontology" ;
rdfs:comment "An ontology for representing information relevant to the evaluation of ODRL policies.".

# Scenario-requirement-to-axiom mapping

# Requirement 1: Bob wants to have access to a certain video stream
:VideoStream a owl:Class ;
rdfs:label "Video Stream" ;
rdfs:comment "A class representing a video stream.".

:Access a owl:Class ;
rdfs:label "Access" ;
rdfs:comment "A class representing the ability to access a resource.".

:Bob a :Person ;
rdfs:label "Bob" ;
rdfs:comment "An individual representing Bob.".

:videoStreamAccess a owl:Class ;
rdfs:label "Video Stream Access" ;
rdfs:comment "A class representing the access to a video stream.".

:hasAccess a owl:ObjectProperty ;
rdfs:label "has access" ;
rdfs:comment "An object property representing the relationship between an individual and a resource that they have access to.".

:VideoStreamAccess a owl:ObjectProperty ;
rdfs:label "video stream access" ;
rdfs:comment "An object property representing the relationship between an individual and a video stream that they have access to.".

:between a owl:ObjectProperty ;
rdfs:label "between" ;
rdfs:comment "An object property representing the relationship between two resources.".

# CQ-to-axiom mapping

# CQ 1: What is the current time?
:Time a owl:Class ;
rdfs:label "Time" ;
rdfs:comment "A class representing a time.".

:currentTime a :Time ;
rdfs:label "current time" ;
rdfs:comment "An individual representing the current time.".

# CQ 2: What is the location of a party?
:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "A class representing a party.".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "A class representing a location.".

:partyLocation a owl:ObjectProperty ;
rdfs:label "party location" ;
rdfs:comment "An object property representing the relationship between a party and their location.".

# CQ 3: What assets are part of the asset collection of the policy that is being evaluated?
:Asset a owl:Class ;
rdfs:label "Asset" ;
rdfs:comment "A class representing an asset.".

:AssetCollection a owl:Class ;
rdfs:label "Asset Collection" ;
rdfs:comment "A class representing a collection of assets.".

:partOf a owl:ObjectProperty ;
rdfs:label "part of" ;
rdfs:comment "An object property representing the relationship between an asset and the asset collection that it is part of.".

# CQ 4: Which parties are part of the party collection of the policy that is being evaluated?
:PartyCollection a owl:Class ;
rdfs:label "Party Collection" ;
rdfs:comment "A class representing a collection of parties.".

:member a owl:ObjectProperty ;
rdfs:label "member" ;
rdfs:comment "An object property representing the relationship between a party and the party collection that they are a member of.".