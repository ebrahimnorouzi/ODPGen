@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
:rdfs:label "Court Hierarchy and Bad Check Crime Ontology" ;
:rdfs:comment "An ontology for managing court hierarchies and bad check crime related regulations".

; :Scenario-requirement-to-axiom mapping

; 1. List all district courts in a given state.
:DistrictCourt a owl:Class ;
:rdfs:label "District Court" ;
:rdfs:comment "A court of law that has jurisdiction over a specific district.".

:State a owl:Class ;
:rdfs:label "State" ;
:rdfs:comment "A political entity that is a member of a federation.".

:districtCourtInState a owl:ObjectProperty ;
:rdfs:label "districtCourtInState" ;
:rdfs:comment "A relationship between a district court and the state in which it is located.".

:listDistrictCourtsInState a owl:ObjectProperty ;
:rdfs:label "listDistrictCourtsInState" ;
:rdfs:comment "A relationship between a state and a list of district courts located in that state.".

; 2. In which state is a given district court instance located?
:DistrictCourt a owl:Class ;
:rdfs:label "District Court" ;
:rdfs:comment "A court of law that has jurisdiction over a specific district.".

:State a owl:Class ;
:rdfs:label "State" ;
:rdfs:comment "A political entity that is a member of a federation.".

:location a owl:ObjectProperty ;
:rdfs:label "location" ;
:rdfs:comment "A relationship between a district court and the state in which it is located.".

; 3. How many districts are in a given state of India?
:District a owl:Class ;
:rdfs:label "District" ;
:rdfs:comment "A subdivision of a state.".

:numberOfDistricts a owl:ObjectProperty ;
:rdfs:label "numberOfDistricts" ;
:rdfs:comment "A relationship between a state and the number of districts located in that state.".

; 4. Which court has authority over a given court?
:Court a owl:Class ;
:rdfs:label "Court" ;
:rdfs:comment "A court of law that has jurisdiction over a specific district.".

:hasAuthorityOver a owl:ObjectProperty ;
:rdfs:label "hasAuthorityOver" ;
:rdfs:comment "A relationship between two courts, where one court has authority over the other.".

; 5. What is the check transaction type for a bad check?
:CheckTransaction a owl:Class ;
:rdfs:label "CheckTransaction" ;
:rdfs:comment "A financial transaction involving a check.".

:transactionType a owl:ObjectProperty ;
:rdfs:label "transactionType" ;
:rdfs:comment "A relationship between a check transaction and the type of transaction.".

; 6. When is a check payment of a bad check?
:CheckPayment a owl:Class ;
:rdfs:label "CheckPayment" ;
:rdfs:comment "A payment made by a check.".

:paymentDate a owl:ObjectProperty ;
:rdfs:label "paymentDate" ;
:rdfs:comment "A relationship between a check payment and the date on which the payment was made.".

; 7. What is the transaction status of a given check payment?
:CheckPayment a owl:Class ;
:rdfs:label "CheckPayment"
