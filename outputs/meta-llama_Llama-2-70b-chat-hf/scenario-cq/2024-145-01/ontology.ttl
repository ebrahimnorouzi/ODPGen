@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Court Hierarchy and Bad Check Crime Ontology" ;
rdfs:comment "An ontology for managing court hierarchies and bad check crime related regulations".

:Court a owl:Class ;
rdfs:label "Court" ;
rdfs:comment "A court of law".

:DistrictCourt a owl:Class ;
rdfs:label "District Court" ;
rdfs:comment "A district court".

:State a owl:Class ;
rdfs:label "State" ;
rdfs:comment "A state in a country".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "A physical location".

:CourtHierarchy a owl:Class ;
rdfs:label "Court Hierarchy" ;
rdfs:comment "A hierarchy of courts".

:Authority a owl:ObjectProperty ;
rdfs:label "has authority over" ;
rdfs:comment "A relationship between two courts where one court has authority over the other".

:CheckTransaction a owl:Class ;
rdfs:label "Check Transaction" ;
rdfs:comment "A transaction involving a check".

:CheckPayment a owl:Class ;
rdfs:label "Check Payment" ;
rdfs:comment "A payment made by a check".

:TransactionStatus a owl:Class ;
rdfs:label "Transaction Status" ;
rdfs:comment "The status of a transaction".

:BadCheck a owl:Class ;
rdfs:label "Bad Check" ;
rdfs:comment "A check that has bounced".

:CheckTransactionType a owl:ObjectProperty ;
rdfs:label "check transaction type" ;
rdfs:comment "The type of a check transaction".

:CheckPaymentDate a owl:ObjectProperty ;
rdfs:label "check payment date" ;
rdfs:comment "The date a check payment was made".

:TransactionStatus a owl:ObjectProperty ;
rdfs:label "transaction status" ;
rdfs:comment "The status of a transaction".