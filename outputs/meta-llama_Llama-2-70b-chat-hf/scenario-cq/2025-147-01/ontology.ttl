@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Maritime Domain Ontology" ;
rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

:Ship a owl:Class ;
rdfs:label "Ship" ;
rdfs:comment "A vessel that travels through water.".

:Identification a owl:Class ;
rdfs:label "Identification" ;
rdfs:comment "A unique identifier for a ship.".

:Dimensions a owl:Class ;
rdfs:label "Dimensions" ;
rdfs:comment "The physical characteristics of a ship.".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "The geographical position of a ship.".

:Owner a owl:Class ;
rdfs:label "Owner" ;
rdfs:comment "The person or organization responsible for a ship.".

:Speed a owl:Class ;
rdfs:label "Speed" ;
rdfs:comment "The rate at which a ship moves.".

:ContainerShip a owl:Class ;
rdfs:label "ContainerShip" ;
rdfs:comment "A ship designed to carry containers.".

:GermanFlag a owl:Class ;
rdfs:label "GermanFlag" ;
rdfs:comment "A ship that is registered under the German flag.".

:GPSAntenna a owl:Class ;
rdfs:label "GPSAntenna" ;
rdfs:comment "A device that receives GPS signals and determines the ship's position.".

:Organization a owl:Class ;
rdfs:label "Organization" ;
rdfs:comment "A group of people or entities that owns or operates a ship.".

:ShipRoute a owl:Class ;
rdfs:label "ShipRoute" ;
rdfs:comment "A path that a ship follows.".

:Trajectory a owl:Class ;
rdfs:label "Trajectory" ;
rdfs:comment "A sequence of positions and times that a ship follows.".

:Draught a owl:Class ;
rdfs:label "Draught" ;
rdfs:comment "The depth of a ship's hull below the waterline.".

:Engine a owl:Class ;
rdfs:label "Engine" ;
rdfs:comment "A device that converts energy into motion.".

:PropulsionSystem a owl:Class ;
rdfs:label "PropulsionSystem" ;
rdfs:comment "A system that generates motion for a ship.".

:JetPropulsor a owl:Class ;
rdfs:label "JetPropulsor" ;
rdfs:comment "A propulsion system that uses a jet of water to create thrust.".

:BladedPropulsor a owl:Class ;
rdfs:label "BladedPropulsor" ;
rdfs:comment "A propulsion system that uses blades to create thrust.".

:ScrewPropeller a owl:Class ;
rdfs:label "ScrewPropeller" ;
rdfs:comment "A propulsion system that uses a screw-like mechanism to create thrust.".

:MotorizedPropulsion a owl:Class ;
rdfs:label "MotorizedPropulsion" ;
rdfs:comment "A propulsion system that uses an engine to generate motion.".