@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Asthma Ontology" ;
rdfs:comment "An ontology for representing and reasoning about asthma-related data.".

# Scenario-requirement-to-axiom mapping

# 1. Symptoms
:Symptom a owl:Class ;
rdfs:label "Symptom" ;
rdfs:comment "A symptom experienced by an asthma patient.".

:Cough a owl:Class ;
rdfs:label "Cough" ;
rdfs:comment "A cough is a symptom of asthma." ;
owl:subClassOf :Symptom.

:ChestTightness a owl:Class ;
rdfs:label "ChestTightness" ;
rdfs:comment "Chest tightness is a symptom of asthma." ;
owl:subClassOf :Symptom.

:Wheezing a owl:Class ;
rdfs:label "Wheezing" ;
rdfs:comment "Wheezing is a symptom of asthma." ;
owl:subClassOf :Symptom.

:BreathingPatterns a owl:Class ;
rdfs:label "BreathingPatterns" ;
rdfs:comment "Breathing patterns are a symptom of asthma." ;
owl:subClassOf :Symptom.

# 2. Medication
:Medication a owl:Class ;
rdfs:label "Medication" ;
rdfs:comment "A medication taken by an asthma patient.".

:Intake a owl:Class ;
rdfs:label "Intake" ;
rdfs:comment "The intake of a medication by an asthma patient." ;
owl:subClassOf :Medication.

# 3. Outdoor Environment
:OutdoorEnvironment a owl:Class ;
rdfs:label "OutdoorEnvironment" ;
rdfs:comment "The outdoor environment surrounding an asthma patient.".

:Pollen a owl:Class ;
rdfs:label "Pollen" ;
rdfs:comment "Pollen is an outdoor environmental allergen." ;
owl:subClassOf :OutdoorEnvironment.

:AQI a owl:Class ;
rdfs:label "AQI" ;
rdfs:comment "Air Quality Index (AQI) is an outdoor environmental allergen." ;
owl:subClassOf :OutdoorEnvironment.

# 4. Causal Relations
:CausalRelation a owl:Class ;
rdfs:label "CausalRelation" ;
rdfs:comment "A causal relation between two concepts.".

:Causes a owl:ObjectProperty ;
rdfs:label "Causes" ;
rdfs:comment "A causal relation between two concepts." ;
owl:domain :CausalRelation ;
owl:range :CausalRelation.

:EffectWeight a owl:ObjectProperty ;
rdfs:label "EffectWeight" ;
rdfs:comment "The effect weight of a causal relation." ;
owl:domain :CausalRelation ;
owl:range xsd:decimal.

# CQ-to-axiom mapping

# 1. Is the medication intake by the patient caused by the presence of outdoor environmental allergen such as pollen or AQI?
:CausalRelation a owl:Class ;
rdfs:label "CausalRelation" ;
rdfs:comment "A causal relation between two concepts.".