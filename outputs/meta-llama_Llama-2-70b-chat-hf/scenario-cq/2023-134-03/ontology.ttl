@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid apps and data".

# Scenario-requirement-to-axiom mapping

# C1. Identity of Solid actors and their roles is unknown
:Actor a owl:Class ;
rdfs:label "Actor" ;
rdfs:comment "A Solid actor, such as a user or an organization".

:Role a owl:Class ;
rdfs:label "Role" ;
rdfs:comment "A role played by a Solid actor, such as a provider or a user".

:Actor rdfs:subClassOf :Role.

# C2. No metadata about Solid infrastructure
:Infrastructure a owl:Class ;
rdfs:label "Infrastructure" ;
rdfs:comment "A Solid infrastructure component, such as a Pod or an app".

:Specification a owl:Class ;
rdfs:label "Specification" ;
rdfs:comment "A Solid specification, such as a data model or a protocol".

:Infrastructure rdfs:subClassOf :Specification.

# C3. Availability/Discovery of categories of data
:DataCategory a owl:Class ;
rdfs:label "DataCategory" ;
rdfs:comment "A category of data, such as personal or sensitive".

:Data a owl:Class ;
rdfs:label "Data" ;
rdfs:comment "A piece of data, such as a text file or an image".

:Data rdfs:subClassOf :DataCategory.

# C4. Pod and app providers do not provide information on their data handling practices
:Provider a owl:Class ;
rdfs:label "Provider" ;
rdfs:comment "A Solid provider, such as a Pod or app provider".

:PrivacyNotice a owl:Class ;
rdfs:label "PrivacyNotice" ;
rdfs:comment "A machine-readable privacy notice for a Solid provider".

:Provider rdfs:subClassOf :PrivacyNotice.

# C5. Users cannot express their privacy policies
:PrivacyPolicy a owl:Class ;
rdfs:label "PrivacyPolicy" ;
rdfs:comment "A privacy policy for a Solid user".

:User a owl:Class ;
rdfs:label "User" ;
rdfs:comment "A Solid user".

:User rdfs:subClassOf :PrivacyPolicy.

# C6. No logging or record-keeping
:Log a owl:Class ;
rdfs:label "Log" ;
rdfs:comment "A record of events or actions in a Solid system".

:Audit a owl:Class ;
rdfs:label "Audit" ;
rdfs:comment "A record of all changes to a Solid system".

:Log rdfs:subClassOf :Audit.

# C7. No legal compliance checks
:Compliance a owl:Class ;
rdfs:label "Compliance" ;
rdfs:comment "A legal compliance check for a Solid system".

:Authority a owl:Class ;
rdfs:label "Authority" ;
rdfs:comment "A legal authority for a Solid system".

:Compliance rdfs:subClassOf :Authority.