@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Temporal Indirection Ontology" ;
rdfs:comment "An ontology for modeling temporal indirection in various domains.".

:PersistentIdentifier a owl:Class ;
rdfs:label "Persistent Identifier" ;
rdfs:comment "A unique identifier that remains constant over time, even as the entity it references changes.".

:TemporalBinding a owl:Class ;
rdfs:label "Temporal Binding" ;
rdfs:comment "A binding between a persistent identifier and a specific entity that is valid for a certain period of time.".

:Referent a owl:Class ;
rdfs:label "Referent" ;
rdfs:comment "The entity that is currently referenced by a persistent identifier.".

:PastReferent a owl:Class ;
rdfs:label "Past Referent" ;
rdfs:comment "An entity that was referenced by a persistent identifier at a past timestamp.".

:Transition a owl:Class ;
rdfs:label "Transition" ;
rdfs:comment "A change in the referent of a persistent identifier that occurs at a specific timestamp.".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "A piece of data associated with a specific referent and timestamp.".

:Sequence a owl:Class ;
rdfs:label "Sequence" ;
rdfs:comment "A list of referents and their corresponding timestamps.".

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "A set of conditions that trigger a transition between referents.".

:Gap a owl:Class ;
rdfs:label "Gap" ;
rdfs:comment "A period of time during which there is no referent for a persistent identifier.".

:Overlap a owl:Class ;
rdfs:label "Overlap" ;
rdfs:comment "A period of time during which there are multiple referents for a persistent identifier.".

:Context a owl:Class ;
rdfs:label "Context" ;
rdfs:comment "A set of information that describes the state of a system at a specific timestamp.".

:Rebuild a owl:Class ;
rdfs:label "Rebuild" ;
rdfs:comment "The process of recreating a complete context for a given time point.".