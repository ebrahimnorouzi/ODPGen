@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Temporal Indirection Ontology" ;
  rdfs:comment "An ontology for modeling temporal indirection in various domains.".

:PersistentIdentifier a owl:Class ;
  rdfs:label "Persistent Identifier" ;
  rdfs:comment "A unique identifier that remains constant over time, even as the entity it references changes.".

:TemporalBinding a owl:Class ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "A binding between a persistent identifier and a specific entity that is valid for a certain period of time.".

:TemporalReference a owl:Class ;
  rdfs:label "Temporal Reference" ;
  rdfs:comment "A reference to a specific entity at a particular point in time.".

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "The entity that is being referenced by a persistent identifier.".

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "A change in the referent of a persistent identifier.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A piece of data associated with a specific referent and time.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "A set of conditions that trigger a transition.".

:Gap a owl:Class ;
  rdfs:label "Gap" ;
  rdfs:comment "A period of time during which a persistent identifier was not associated with any referent.".

:Overlap a owl:Class ;
  rdfs:label "Overlap" ;
  rdfs:comment "A period of time during which a persistent identifier was associated with multiple referents.".

:Context a owl:Class ;
  rdfs:label "Context" ;
  rdfs:comment "A set of information associated with a specific time point.".

:Rebuild a owl:Class ;
  rdfs:label "Rebuild" ;
  rdfs:comment "The process of reconstructing a complete context for a given time point.".

:PersistentIdentifier :has_referent :Referent.
:TemporalBinding :has_persistent_identifier :PersistentIdentifier ;
  :has_referent :Referent.
:TemporalReference :has_persistent_identifier :PersistentIdentifier ;
  :has_referent :Referent.
:Transition :has_persistent_identifier :PersistentIdentifier ;
  :has_referent :Referent.
:Observation :has_temporal_reference :TemporalReference.
:Rule :has_condition :Condition.
:Gap :has_temporal_binding :TemporalBinding.
:Overlap :has_temporal_binding :TemporalBinding.
:Context :has_temporal_reference :TemporalReference.
:Rebuild :has_context :Context.