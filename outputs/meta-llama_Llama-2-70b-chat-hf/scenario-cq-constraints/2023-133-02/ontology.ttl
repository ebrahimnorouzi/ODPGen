@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Asthma Ontology" ;
rdfs:comment "An ontology for describing concepts related to asthma and its management".

:AsthmaPatient a owl:Class ;
rdfs:label "Asthma Patient" ;
rdfs:comment "An individual who has been diagnosed with asthma".

:Symptom a owl:Class ;
rdfs:label "Symptom" ;
rdfs:comment "A physical or mental phenomenon that indicates the presence of a disease or condition".

:Cough a owl:Class ;
rdfs:label "Cough" ;
rdfs:comment "A sudden, forceful expulsion of air from the lungs".

:ChestTightness a owl:Class ;
rdfs:label "Chest Tightness" ;
rdfs:comment "A feeling of tension or constriction in the chest".

:Wheezing a owl:Class ;
rdfs:label "Wheezing" ;
rdfs:comment "A high-pitched whistling sound when breathing".

:BreathingPatterns a owl:Class ;
rdfs:label "Breathing Patterns" ;
rdfs:comment "The way in which a person breathes".

:Medication a owl:Class ;
rdfs:label "Medication" ;
rdfs:comment "A substance used to treat or prevent disease".

:Intake a owl:Class ;
rdfs:label "Intake" ;
rdfs:comment "The act of consuming a substance, such as medication".

:OutdoorEnvironment a owl:Class ;
rdfs:label "Outdoor Environment" ;
rdfs:comment "The external surroundings, including weather and air quality".

:Pollen a owl:Class ;
rdfs:label "Pollen" ;
rdfs:comment "Fine particles produced by plants, which can cause allergic reactions".

:AQI a owl:Class ;
rdfs:label "Air Quality Index" ;
rdfs:comment "A measure of the quality of the air, based on factors such as pollution levels".

:CausalRelation a owl:Class ;
rdfs:label "Causal Relation" ;
rdfs:comment "A relationship between two concepts, where one concept is the cause of the other".

:EffectWeight a owl:Class ;
rdfs:label "Effect Weight" ;
rdfs:comment "A measure of the strength of a causal relation, expressed as a numerical value".

:PatientExperiencesCough a owl:ObjectProperty ;
rdfs:label "Patient Experiences Cough" ;
rdfs:comment "A relationship between a patient and a cough symptom".

:CoughCausedByPollen a owl:ObjectProperty ;
rdfs:label "Cough Caused By Pollen" ;
rdfs:comment "A relationship between a cough symptom and the presence of pollen".

:CoughCausedByAQI a owl:ObjectProperty ;
rdfs:label "Cough Caused By AQI" ;
rdfs:comment "A relationship between a cough symptom and the air quality index".

:MedicationTakenDueToCough a owl:ObjectProperty ;
rdfs:label "Medication Taken Due To Cough" ;
rdfs:comment "A relationship between a medication and a cough symptom".