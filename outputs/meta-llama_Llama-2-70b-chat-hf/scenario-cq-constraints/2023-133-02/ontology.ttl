@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Asthma Ontology" ;
rdfs:comment "An ontology for describing concepts related to asthma and its management.".

:Asthma a owl:Class ;
rdfs:label "Asthma" ;
rdfs:comment "A chronic respiratory disease characterized by inflammation, airway obstruction, and bronchospasm.".

:Symptom a owl:Class ;
rdfs:label "Symptom" ;
rdfs:comment "A subjective or objective indication of a disease or condition.".

:Cough a owl:Class ;
rdfs:label "Cough" ;
rdfs:comment "A sudden, forceful expulsion of air from the lungs.".

:ChestTightness a owl:Class ;
rdfs:label "ChestTightness" ;
rdfs:comment "A feeling of tightness or constriction in the chest.".

:Wheezing a owl:Class ;
rdfs:label "Wheezing" ;
rdfs:comment "A high-pitched whistling sound produced by the movement of air through narrowed or constricted airways.".

:BreathingPatterns a owl:Class ;
rdfs:label "BreathingPatterns" ;
rdfs:comment "The way in which a person breathes, including the rate, depth, and rhythm of breathing.".

:Medication a owl:Class ;
rdfs:label "Medication" ;
rdfs:comment "A substance used to prevent or treat disease or illness.".

:Intake a owl:ObjectProperty ;
rdfs:label "Intake" ;
rdfs:comment "The act of taking a medication or substance into the body.".

:OutdoorEnvironment a owl:Class ;
rdfs:label "OutdoorEnvironment" ;
rdfs:comment "The external environment outside of a building or structure.".

:Pollen a owl:Class ;
rdfs:label "Pollen" ;
rdfs:comment "Fine particles produced by plants, typically carried by the wind or by insects, and often causing allergic reactions in people.".

:AQI a owl:Class ;
rdfs:label "AirQualityIndex" ;
rdfs:comment "A measure of the quality of the air, taking into account factors such as pollution and allergens.".

:CausalRelation a owl:ObjectProperty ;
rdfs:label "CausalRelation" ;
rdfs:comment "A relationship between two concepts, where the presence of one concept (the cause) affects the presence or intensity of the other concept (the effect).".

:EffectWeight a owl:DatatypeProperty ;
rdfs:label "EffectWeight" ;
rdfs:comment "A numerical value representing the strength of a causal relation, where higher values indicate a stronger causal relationship.".

:ProbableCause a owl:ObjectProperty ;
rdfs:label "ProbableCause" ;
rdfs:comment "A relationship between two concepts, where the presence of one concept (the cause) makes it probable that the other concept (the effect) will also be present.".

:AsthmaSymptom a owl:ObjectProperty ;
rdfs:label "AsthmaSymptom" ;
rdfs:comment "A relationship between an asthma patient and a symptom of asthma, such as cough, chest tightness, or wheezing.".