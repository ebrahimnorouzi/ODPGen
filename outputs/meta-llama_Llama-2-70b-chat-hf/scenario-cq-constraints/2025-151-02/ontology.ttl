@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "ODRL Policy Evaluation Ontology" ;
rdfs:comment "An ontology for representing information relevant to the evaluation of ODRL policies.".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy that regulates access to assets.".

:Asset a owl:Class ;
rdfs:label "Asset" ;
rdfs:comment "A digital asset that can be accessed.".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "An entity that can access assets.".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "An action that can be performed on an asset.".

:Event a owl:Class ;
rdfs:label "Event" ;
rdfs:comment "An event that has occurred.".

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "A rule that regulates access to an asset.".

:Exercise a owl:Class ;
rdfs:label "Exercise" ;
rdfs:comment "An exercise of a rule.".

:Recipient a owl:Class ;
rdfs:label "Recipient" ;
rdfs:comment "An entity that can receive the result of a rule exercise.".

:Payment a owl:Class ;
rdfs:label "Payment" ;
rdfs:comment "A financial payment made in relation to an asset.".

:Time a owl:Class ;
rdfs:label "Time" ;
rdfs:comment "A moment in time.".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "A physical location.".

:AssetCollection a owl:Class ;
rdfs:label "AssetCollection" ;
rdfs:comment "A collection of assets.".

:PartyCollection a owl:Class ;
rdfs:label "PartyCollection" ;
rdfs:comment "A collection of parties.".

:PolicyHasAsset a owl:ObjectProperty ;
rdfs:label "hasAsset" ;
rdfs:comment "A policy has an asset as part of its asset collection.".

:PolicyHasParty a owl:ObjectProperty ;
rdfs:label "hasParty" ;
rdfs:comment "A policy has a party as part of its party collection.".

:AssetHasLocation a owl:ObjectProperty ;
rdfs:label "hasLocation" ;
rdfs:comment "An asset has a location.".

:PartyHasRole a owl:ObjectProperty ;
rdfs:label "hasRole" ;
rdfs:comment "A party has a role in a policy.".

:ActionHasExercise a owl:ObjectProperty ;
rdfs:label "hasExercise" ;
rdfs:comment "An action has an exercise.".

:ExerciseHasRule a owl:ObjectProperty ;
rdfs:label "hasRule" ;
rdfs:comment "An exercise has a rule.".

:RuleHasRecipient a owl:ObjectProperty ;
rdfs:label "hasRecipient" ;
rdfs:comment "A rule has a recipient.".

:RecipientHasPayment a owl:ObjectProperty ;
rdfs:label "hasPayment" ;
rdfs:comment "A recipient has a payment.".

:TimeHasEvent a owl:ObjectProperty ;
rdfs:label "hasEvent" ;
rdfs:comment "A time has an event.".