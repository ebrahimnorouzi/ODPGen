@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "ODRL Policy Evaluation Ontology" ;
rdfs:comment "An ontology for representing information relevant to the evaluation of ODRL policies.".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy that regulates access to assets.".

:Asset a owl:Class ;
rdfs:label "Asset" ;
rdfs:comment "A digital asset that can be accessed.".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "An entity that can access assets.".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "An action that can be performed on an asset.".

:Event a owl:Class ;
rdfs:label "Event" ;
rdfs:comment "An event that has occurred.".

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "A rule that regulates access to an asset.".

:Exercise a owl:Class ;
rdfs:label "Exercise" ;
rdfs:comment "An exercise of a rule.".

:Recipient a owl:Class ;
rdfs:label "Recipient" ;
rdfs:comment "An entity that can receive the result of a rule exercise.".

:Payment a owl:Class ;
rdfs:label "Payment" ;
rdfs:comment "A financial payment made in relation to an exercise.".

:Time a owl:Class ;
rdfs:label "Time" ;
rdfs:comment "A moment in time.".

:Location a owl:Class ;
rdfs:label "Location" ;
rdfs:comment "A physical location.".

:AssetCollection a owl:Class ;
rdfs:label "AssetCollection" ;
rdfs:comment "A collection of assets.".

:PartyCollection a owl:Class ;
rdfs:label "PartyCollection" ;
rdfs:comment "A collection of parties.".

:PolicyExercise a owl:Class ;
rdfs:label "PolicyExercise" ;
rdfs:comment "An exercise of a policy.".

:PolicyEvaluation a owl:Class ;
rdfs:label "PolicyEvaluation" ;
rdfs:comment "An evaluation of a policy.".

:CurrentTime a owl:Property ;
rdfs:label "currentTime" ;
rdfs:comment "The current time.".

:LocationOfParty a owl:Property ;
rdfs:label "locationOfParty" ;
rdfs:comment "The location of a party.".

:AssetsInAssetCollection a owl:Property ;
rdfs:label "assetsInAssetCollection" ;
rdfs:comment "The assets in an asset collection.".

:PartiesInPartyCollection a owl:Property ;
rdfs:label "partiesInPartyCollection" ;
rdfs:comment "The parties in a party collection.".

:ActionsPerformed a owl:Property ;
rdfs:label "actionsPerformed" ;
rdfs:comment "The actions that have been performed.".

:RuleExercised a owl:Property ;
rdfs:label "ruleExercised" ;
rdfs:comment "The rule that has been exercised.".

:NumberOfTimesRuleExercised a owl:Property ;
rdfs:label "numberOfTimesRuleExercised" ;
rdfs:comment "The number of times a rule has been exercised.".