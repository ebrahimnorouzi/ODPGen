@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Author Name Changes Ontology" ;
rdfs:comment "An ontology for representing author name changes and their associated works.".

:Author a owl:Class ;
rdfs:label "Author" ;
rdfs:comment "An author who has published works under different names.".

:Pseudonym a owl:Class ;
rdfs:label "Pseudonym" ;
rdfs:comment "A pseudonym used by an author to publish works.".

:Work a owl:Class ;
rdfs:label "Work" ;
rdfs:comment "A published work by an author.".

:Author-Pseudonym a owl:ObjectProperty ;
rdfs:label "author-pseudonym" ;
rdfs:comment "The relationship between an author and their pseudonym.".

:Pseudonym-Work a owl:ObjectProperty ;
rdfs:label "pseudonym-work" ;
rdfs:comment "The relationship between a pseudonym and the work published under that pseudonym.".

:C_S_Lewis a :Author ;
rdfs:label "C. S. Lewis" ;
rdfs:comment "A famous author who used pseudonyms to publish some of his works.".

:Spirit_in_Bondage a :Work ;
rdfs:label "Spirit in Bondage" ;
rdfs:comment "A collection of poems published by C. S. Lewis under the pseudonym Clive Hamilton.".

:Clive_Hamilton a :Pseudonym, :Author-Pseudonym ;
rdfs:label "Clive Hamilton" ;
rdfs:comment "A pseudonym used by C. S. Lewis to publish the collection of poems Spirit in Bondage.".