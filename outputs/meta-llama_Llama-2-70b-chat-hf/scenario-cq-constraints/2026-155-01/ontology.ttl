@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Cultural Heritage Survey ODP" ;
rdfs:comment "Ontology for modeling scientific survey activities performed on cultural heritage entities".

:Survey a owl:Class ;
rdfs:label "Survey" ;
rdfs:comment "A scientific survey activity performed on a cultural heritage entity".

:Investigation a owl:Class ;
rdfs:label "Investigation" ;
rdfs:comment "A specific investigation technique or method adopted in a survey".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "An observation produced during a survey or investigation activity".

:Expert a owl:Class ;
rdfs:label "Expert" ;
rdfs:comment "An individual with a specific role in a survey or investigation activity".

:Equipment a owl:Class ;
rdfs:label "Equipment" ;
rdfs:comment "Hardware, software, or technical configurations used to conduct a survey".

:Interpretation a owl:Class ;
rdfs:label "Interpretation" ;
rdfs:comment "An interpretation or claim supported by observations produced during a survey".

:PostProcessedOutput a owl:Class ;
rdfs:label "Post-processed Output" ;
rdfs:comment "An output produced after processing data collected during a survey, such as interactive images, spectra, or datasets".

:Acquisition a owl:Class ;
rdfs:label "Acquisition" ;
rdfs:comment "A specific acquisition cycle within a survey, characterized by acquisition parameters".

:AcquisitionParameter a owl:Class ;
rdfs:label "Acquisition Parameter" ;
rdfs:comment "A parameter characterizing a specific acquisition cycle, such as exposure time, ISO, or aperture".

:Survey obs:hasObservation :Observation.
:Investigation obs:hasObservation :Observation.
:Observation obs:hasExpert :Expert.
:Observation obs:hasEquipment :Equipment.
:Interpretation obs:hasObservation :Observation.
:PostProcessedOutput obs:hasAcquisition :Acquisition.
:Acquisition obs:hasAcquisitionParameter :AcquisitionParameter.