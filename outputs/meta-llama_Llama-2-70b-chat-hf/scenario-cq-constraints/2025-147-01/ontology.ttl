@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel that travels through water.".

:Identification a owl:Class ;
  rdfs:label "Identification" ;
  rdfs:comment "A means of identifying a ship.".

:Dimensions a owl:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "The size and shape of a ship.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A place where a ship can be found.".

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "An entity that owns a ship.".

:Speed a owl:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "The rate at which a ship moves.".

:ContainerShip a owl:Class ;
  rdfs:label "ContainerShip" ;
  rdfs:comment "A ship designed to carry containers.".

:GermanFlag a owl:Class ;
  rdfs:label "GermanFlag" ;
  rdfs:comment "A flag that represents Germany.".

:GPSAntenna a owl:Class ;
  rdfs:label "GPSAntenna" ;
  rdfs:comment "A device that receives GPS signals.".

:ShipRoute a owl:Class ;
  rdfs:label "ShipRoute" ;
  rdfs:comment "A path that a ship follows.".

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "A sequence of locations that a ship visits.".

:PropulsionSystem a owl:Class ;
  rdfs:label "PropulsionSystem" ;
  rdfs:comment "A system that propels a ship forward.".

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "A device that converts energy into motion.".

:Fuel a owl:Class ;
  rdfs:label "Fuel" ;
  rdfs:comment "A substance that is burned to produce energy.".

:Sail a owl:Class ;
  rdfs:label "Sail" ;
  rdfs:comment "A device that uses wind to propel a ship.".

:WindAssistedPropulsion a owl:Class ;
  rdfs:label "WindAssistedPropulsion" ;
  rdfs:comment "A system that uses wind to assist in propelling a ship.".

:SupercavitatingPropeller a owl:Class ;
  rdfs:label "SupercavitatingPropeller" ;
  rdfs:comment "A propeller that uses cavitation to increase efficiency.".

:FixedPitchPropeller a owl:Class ;
  rdfs:label "FixedPitchPropeller" ;
  rdfs:comment "A propeller with blades that have a fixed pitch.".

:BladedPropeller a owl:Class ;
  rdfs:label "BladedPropeller" ;
  rdfs:comment "A propeller with blades that are designed to optimize efficiency.".