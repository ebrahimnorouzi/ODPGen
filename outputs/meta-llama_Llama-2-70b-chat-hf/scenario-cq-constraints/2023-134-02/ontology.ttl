@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid applications".

:Solid a owl:Class ;
rdfs:label "Solid" ;
rdfs:comment "A class representing a Solid application".

:Solidactor a owl:Class ;
rdfs:label "Solid Actor" ;
rdfs:comment "A class representing an entity interacting with a Solid application".

:Solidpod a owl:Class ;
rdfs:label "Solid Pod" ;
rdfs:comment "A class representing a Solid Pod".

:Solidapp a owl:Class ;
rdfs:label "Solid App" ;
rdfs:comment "A class representing a Solid application".

:DataCategory a owl:Class ;
rdfs:label "Data Category" ;
rdfs:comment "A class representing a category of data".

:DataHandlingPractice a owl:Class ;
rdfs:label "Data Handling Practice" ;
rdfs:comment "A class representing a data handling practice".

:PrivacyPolicy a owl:Class ;
rdfs:label "Privacy Policy" ;
rdfs:comment "A class representing a privacy policy".

:Consent a owl:Class ;
rdfs:label "Consent" ;
rdfs:comment "A class representing consent".

:Provenance a owl:Class ;
rdfs:label "Provenance" ;
rdfs:comment "A class representing provenance metadata".

:LegalCompliance a owl:Class ;
rdfs:label "Legal Compliance" ;
rdfs:comment "A class representing legal compliance".

:Action a owl:ObjectProperty ;
rdfs:label "Action" ;
rdfs:comment "A property representing an action performed on data".

:Entity a owl:ObjectProperty ;
rdfs:label "Entity" ;
rdfs:comment "A property representing the entity interacting with data".

:Publisher a owl:ObjectProperty ;
rdfs:label "Publisher" ;
rdfs:comment "A property representing the entity publishing a log".

:IssueDate a owl:DatatypeProperty ;
rdfs:label "Issue Date" ;
rdfs:comment "A property representing the date a log was issued".

:StorageLocation a owl:DatatypeProperty ;
rdfs:label "Storage Location" ;
rdfs:comment "A property representing the location where data is stored".

:Application a owl:ObjectProperty ;
rdfs:label "Application" ;
rdfs:comment "A property representing the application or service used to generate data".