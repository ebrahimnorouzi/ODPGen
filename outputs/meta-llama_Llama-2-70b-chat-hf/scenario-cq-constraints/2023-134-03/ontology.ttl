@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid apps and data".

:SolidApp a owl:Class ;
rdfs:label "Solid App" ;
rdfs:comment "A software application built on the Solid platform".

:SolidPod a owl:Class ;
rdfs:label "Solid Pod" ;
rdfs:comment "A personal data store on the Solid platform".

:DataCategory a owl:Class ;
rdfs:label "Data Category" ;
rdfs:comment "A category of data stored in a Solid Pod".

:PrivacyPolicy a owl:Class ;
rdfs:label "Privacy Policy" ;
rdfs:comment "A policy governing the use of personal data".

:Consent a owl:Class ;
rdfs:label "Consent" ;
rdfs:comment "An agreement to a privacy policy".

:Provenance a owl:Class ;
rdfs:label "Provenance" ;
rdfs:comment "Metadata about the origin and history of data".

:LegalCompliance a owl:Class ;
rdfs:label "Legal Compliance" ;
rdfs:comment "A class representing compliance with legal requirements".

:SolidApp rdfs:subClassOf :SolidPod.
:SolidPod rdfs:subClassOf :DataCategory.
:DataCategory rdfs:subClassOf :PrivacyPolicy.
:PrivacyPolicy rdfs:subClassOf :Consent.
:Consent rdfs:subClassOf :Provenance.
:Provenance rdfs:subClassOf :LegalCompliance.

:WhoMaintainingRegistry a owl:Property ;
rdfs:label "Who is maintaining the registry?" ;
rdfs:comment "A property representing the entity responsible for maintaining the registry".

:WhenCreatedUpdated a owl:Property ;
rdfs:label "When was the registry created/updated?" ;
rdfs:comment "A property representing the date the registry was created or last updated".

:TypesOfData a owl:Property ;
rdfs:label "What types of data are available?" ;
rdfs:comment "A property representing the types of data stored in the registry".

:DataLocation a owl:Property ;
rdfs:label "Where is a specific type of data being stored?" ;
rdfs:comment "A property representing the location of a specific type of data".

:PolicyAssociatedWithData a owl:Property ;
rdfs:label "What policy is associated with the data?" ;
rdfs:comment "A property representing the policy associated with a specific type of data".