@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid apps".

:Solid a owl:Class ;
rdfs:label "Solid" ;
rdfs:comment "A class representing a Solid app".

:Solidactor a owl:Class ;
rdfs:label "Solid Actor" ;
rdfs:comment "A class representing an actor in a Solid app".

:Solidpod a owl:Class ;
rdfs:label "Solid Pod" ;
rdfs:comment "A class representing a Solid pod".

:Solidapp a owl:Class ;
rdfs:label "Solid App" ;
rdfs:comment "A class representing a Solid app".

:Identity a owl:ObjectProperty ;
rdfs:label "Identity" ;
rdfs:comment "A property representing the identity of a Solid actor".

:Role a owl:ObjectProperty ;
rdfs:label "Role" ;
rdfs:comment "A property representing the role of a Solid actor".

:Metadata a owl:ObjectProperty ;
rdfs:label "Metadata" ;
rdfs:comment "A property representing metadata about a Solid infrastructure".

:Availability a owl:ObjectProperty ;
rdfs:label "Availability" ;
rdfs:comment "A property representing the availability of data in a Solid pod".

:Discovery a owl:ObjectProperty ;
rdfs:label "Discovery" ;
rdfs:comment "A property representing the discovery of data in a Solid pod".

:Privacy a owl:ObjectProperty ;
rdfs:label "Privacy" ;
rdfs:comment "A property representing privacy policies in a Solid app".

:Compliance a owl:ObjectProperty ;
rdfs:label "Compliance" ;
rdfs:comment "A property representing legal compliance in a Solid app".

:Registry a owl:Class ;
rdfs:label "Registry" ;
rdfs:comment "A class representing a registry of Solid apps".

:Registry-entry a owl:Class ;
rdfs:label "Registry Entry" ;
rdfs:comment "A class representing an entry in a registry of Solid apps".

:Created a owl:DatatypeProperty ;
rdfs:label "Created" ;
rdfs:comment "A property representing the creation date of a registry entry".

:Updated a owl:DatatypeProperty ;
rdfs:label "Updated" ;
rdfs:comment "A property representing the last update date of a registry entry".

:Maintainer a owl:ObjectProperty ;
rdfs:label "Maintainer" ;
rdfs:comment "A property representing the maintainer of a registry entry".

:Type a owl:ObjectProperty ;
rdfs:label "Type" ;
rdfs:comment "A property representing the type of data available in a Solid pod".

:Location a owl:ObjectProperty ;
rdfs:label "Location" ;
rdfs:comment "A property representing the location of data in a Solid pod".

:Policy a owl:ObjectProperty ;
rdfs:label "Policy" ;
rdfs:comment "A property representing the policy associated with data in a Solid pod".