@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Relational Database Access Control Ontology" ;
  rdfs:comment "Ontology for securing access to a relational database".

:Database a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A database is a collection of tables".

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "A table is a collection of columns".

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "A column is a single data field in a table".

:PrimaryKey a owl:Class ;
  rdfs:label "Primary Key" ;
  rdfs:comment "A primary key is a unique identifier for a table".

:ForeignKey a owl:Class ;
  rdfs:label "Foreign Key" ;
  rdfs:comment "A foreign key is a reference to a primary key in another table".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy defines access control rules for a database".

:ReadAction a owl:Class ;
  rdfs:label "Read Action" ;
  rdfs:comment "A read action allows access to a table or column".

:ModifyAction a owl:Class ;
  rdfs:label "Modify Action" ;
  rdfs:comment "A modify action allows changes to a table or column".

:ViewActionScope a owl:Class ;
  rdfs:label "View Action Scope" ;
  rdfs:comment "A view action scope defines the visibility of a table or column".

:ProcessActionScope a owl:Class ;
  rdfs:label "Process Action Scope" ;
  rdfs:comment "A process action scope defines the accessibility of a table or column".

:TableLevelPolicy a owl:Class ;
  rdfs:label "Table Level Policy" ;
  rdfs:comment "A table level policy applies to a specific table".

:ColumnLevelPolicy a owl:Class ;
  rdfs:label "Column Level Policy" ;
  rdfs:comment "A column level policy applies to a specific column".

:RowLevelPolicy a owl:Class ;
  rdfs:label "Row Level Policy" ;
  rdfs:comment "A row level policy applies to a specific row".

:ConditionalPolicy a owl:Class ;
  rdfs:label "Conditional Policy" ;
  rdfs:comment "A conditional policy applies to a table or column based on a condition".

:SQLQuery a owl:Class ;
  rdfs:label "SQL Query" ;
  rdfs:comment "A SQL query is a semantic graph representing a database query".

:SelectStatement a owl:Class ;
  rdfs:label "Select Statement" ;
  rdfs:comment "A select statement is a SQL query that retrieves data from a table".

:UpdateStatement a owl:Class ;
  rdfs:label "Update Statement" ;
  rdfs:comment "An update statement is a SQL query that modifies data in a table".

:QueryStatement a owl:Class ;
  rdfs:label "Query Statement" ;
  rdfs:comment "A query statement is a SQL query that retrieves or modifies data".

:TableRef a owl:Class ;
  rdfs:label "Table Reference" ;
  rdfs:comment "A table reference is a reference to a table in a query".