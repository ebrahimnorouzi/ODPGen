@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Evaluation Request Ontology" ;
rdfs:comment "An ontology for describing evaluation requests and their context".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request to evaluate a target asset".

:RequestedAction a owl:Class ;
rdfs:label "Requested Action" ;
rdfs:comment "The action requested by the evaluation request".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "A person or organization involved in the evaluation request".

:TargetAsset a owl:Class ;
rdfs:label "Target Asset" ;
rdfs:comment "The asset being evaluated".

:EvaluationContext a owl:Class ;
rdfs:label "Evaluation Context" ;
rdfs:comment "Additional contextual information included in the evaluation request".

:TemporalContext a owl:Class ;
rdfs:label "Temporal Context" ;
rdfs:comment "Context related to time".

:SpatialContext a owl:Class ;
rdfs:label "Spatial Context" ;
rdfs:comment "Context related to location".

:RoleContext a owl:Class ;
rdfs:label "Role Context" ;
rdfs:comment "Context related to roles and permissions".

:RequestCapabilityContext a owl:Class ;
rdfs:label "Request Capability Context" ;
rdfs:comment "Context related to the capabilities of the requester".

:EvaluationRequest a owl:Individual ;
rdfs:label "Evaluation Request 1" ;
rdfs:comment "An example evaluation request".

:RequestedAction a owl:Individual ;
rdfs:label "Action 1" ;
rdfs:comment "An example requested action".

:Party a owl:Individual ;
rdfs:label "Party 1" ;
rdfs:comment "An example party".

:TargetAsset a owl:Individual ;
rdfs:label "Asset 1" ;
rdfs:comment "An example target asset".

:EvaluationContext a owl:Individual ;
rdfs:label "Context 1" ;
rdfs:comment "An example evaluation context".

:TemporalContext a owl:Individual ;
rdfs:label "Context 2" ;
rdfs:comment "An example temporal context".

:SpatialContext a owl:Individual ;
rdfs:label "Context 3" ;
rdfs:comment "An example spatial context".

:RoleContext a owl:Individual ;
rdfs:label "Context 4" ;
rdfs:comment "An example role context".

:RequestCapabilityContext a owl:Individual ;
rdfs:label "Context 5" ;
rdfs:comment "An example request capability context".