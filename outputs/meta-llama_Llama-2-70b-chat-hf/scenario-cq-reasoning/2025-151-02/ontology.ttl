@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "ODRL Policy Evaluation Ontology" ;
rdfs:comment "An ontology for representing information relevant to the evaluation of ODRL policies.".

:Policy a owl:Class ;
rdfs:label "Policy" ;
rdfs:comment "A policy that can be evaluated.".

:Asset a owl:Class ;
rdfs:label "Asset" ;
rdfs:comment "An asset that is part of a policy's asset collection.".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "A party that is part of a policy's party collection.".

:Action a owl:Class ;
rdfs:label "Action" ;
rdfs:comment "An action that has been performed or attempted.".

:Event a owl:Class ;
rdfs:label "Event" ;
rdfs:comment "An event that has occurred.".

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "A rule that has been exercised.".

:Recipient a owl:Class ;
rdfs:label "Recipient" ;
rdfs:comment "A recipient or category of recipients that can receive the result of a rule.".

:Payment a owl:Class ;
rdfs:label "Payment" ;
rdfs:comment "A financial payment that has been made.".

:Policy p:hasAsset :Asset.
:Policy p:hasParty :Party.
:Policy p:hasAction :Action.
:Action p:hasEvent :Event.
:Event p:hasRule :Rule.
:Rule p:hasRecipient :Recipient.
:Rule p:hasPayment :Payment.

:Asset p:hasLocation :Location.
:Party p:hasName xsd:string.
:Action p:hasTime xsd:dateTime.
:Event p:hasInformation xsd:string.
:Rule p:hasExerciseTime xsd:dateTime.
:Recipient p:hasCategory xsd:string.
:Payment p:hasAmount xsd:decimal.