@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Persistent Identifier Ontology" ;
rdfs:comment "An ontology for modeling persistent identifiers and their referents.".

:PersistentIdentifier a owl:Class ;
rdfs:label "Persistent Identifier" ;
rdfs:comment "A unique identifier that remains constant over time, even as the entity it references changes.".

:Referent a owl:Class ;
rdfs:label "Referent" ;
rdfs:comment "The entity that a persistent identifier references.".

:Reference a owl:ObjectProperty ;
rdfs:label "Reference" ;
rdfs:comment "The relationship between a persistent identifier and its referent." ;
domain :PersistentIdentifier ;
range :Referent.

:Transition a owl:Class ;
rdfs:label "Transition" ;
rdfs:comment "A change in the referent of a persistent identifier.".

:TransitionTime a owl:DatatypeProperty ;
rdfs:label "Transition Time" ;
rdfs:comment "The time at which a transition occurred." ;
domain :Transition.

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "An attribute associated with a specific referent.".

:ObservationTime a owl:DatatypeProperty ;
rdfs:label "Observation Time" ;
rdfs:comment "The time at which an observation was made." ;
domain :Observation.

:Rule a owl:Class ;
rdfs:label "Rule" ;
rdfs:comment "A set of criteria that trigger a transition.".

:RuleTrigger a owl:ObjectProperty ;
rdfs:label "Rule Trigger" ;
rdfs:comment "The relationship between a rule and the transition it triggers." ;
domain :Rule ;
range :Transition.

:Gap a owl:Class ;
rdfs:label "Gap" ;
rdfs:comment "A gap in the temporal binding of a persistent identifier.".

:Overlap a owl:Class ;
rdfs:label "Overlap" ;
rdfs:comment "An overlap in the temporal binding of a persistent identifier.".

:Context a owl:Class ;
rdfs:label "Context" ;
rdfs:comment "A set of observations associated with a specific referent and time.".

:ContextTime a owl:DatatypeProperty ;
rdfs:label "Context Time" ;
rdfs:comment "The time at which a context was observed." ;
domain :Context.