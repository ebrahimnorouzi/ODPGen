@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Legal Tasks Ontology" ;
rdfs:comment "An ontology for managing legal tasks and court hierarchies".

:Court a owl:Class ;
rdfs:label "Court" ;
rdfs:comment "A court of law".

:DistrictCourt a owl:SubClassOf :Court ;
rdfs:label "District Court" ;
rdfs:comment "A district court".

:State a owl:Class ;
rdfs:label "State" ;
rdfs:comment "A state in a country".

:District a owl:Class ;
rdfs:label "District" ;
rdfs:comment "A district in a state".

:CourtHierarchy a owl:ObjectProperty ;
rdfs:label "Court Hierarchy" ;
rdfs:comment "A relationship between courts".

:Authority a owl:ObjectProperty ;
rdfs:label "Authority" ;
rdfs:comment "A relationship between courts".

:CheckTransaction a owl:Class ;
rdfs:label "Check Transaction" ;
rdfs:comment "A transaction involving a check".

:CheckPayment a owl:SubClassOf :CheckTransaction ;
rdfs:label "Check Payment" ;
rdfs:comment "A payment made by check".

:TransactionStatus a owl:ObjectProperty ;
rdfs:label "Transaction Status" ;
rdfs:comment "The status of a transaction".

:BadCheck a owl:Class ;
rdfs:label "Bad Check" ;
rdfs:comment "A check that has bounced".

:CheckTransactionType a owl:ObjectProperty ;
rdfs:label "Check Transaction Type" ;
rdfs:comment "The type of a check transaction".

:When a owl:ObjectProperty ;
rdfs:label "When" ;
rdfs:comment "The time at which a check payment is made".