@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Solid Governance Ontology" ;
rdfs:comment "An ontology for governing Solid apps".

# C1 - Identity of Solid actors and their roles is unknown
:SolidActor a owl:Class ;
rdfs:label "Solid Actor" ;
rdfs:comment "An actor that provides or uses a Solid pod".

:SolidUser a :SolidActor ;
rdfs:label "Solid User" ;
rdfs:comment "A user of a Solid app".

:SolidProvider a :SolidActor ;
rdfs:label "Solid Provider" ;
rdfs:comment "An entity that provides a Solid pod".

# C2 - No metadata about Solid infrastructure
:SolidPods a owl:Class ;
rdfs:label "Solid Pods" ;
rdfs:comment "A collection of Solid pods".

:SolidPod a :SolidPods ;
rdfs:label "Solid Pod" ;
rdfs:comment "A pod that runs a Solid app".

:SolidSpecification a owl:Class ;
rdfs:label "Solid Specification" ;
rdfs:comment "A specification for a Solid pod".

:SolidFunctionality a owl:Class ;
rdfs:label "Solid Functionality" ;
rdfs:comment "A functionality installed within a Solid pod".

# C3 - Availability/Discovery of categories of data
:DataCategory a owl:Class ;
rdfs:label "Data Category" ;
rdfs:comment "A category of data stored in a Solid pod".

:DataCategoryType a owl:ObjectProperty ;
rdfs:label "Data Category Type" ;
rdfs:comment "The type of data category".

:SolidPodHasDataCategory a owl:ObjectProperty ;
rdfs:label "Solid Pod Has Data Category" ;
rdfs:comment "A relationship between a Solid pod and a data category".

# C4 - Pod and app providers do not provide information on their data handling practices
:PrivacyNotice a owl:Class ;
rdfs:label "Privacy Notice" ;
rdfs:comment "A machine-readable privacy notice for a Solid app".

:DataHandlingPractices a owl:Class ;
rdfs:label "Data Handling Practices" ;
rdfs:comment "The practices used by a Solid app to handle data".

:SolidAppProvidesPrivacyNotice a owl:ObjectProperty ;
rdfs:label "Solid App Provides Privacy Notice" ;
rdfs:comment "A relationship between a Solid app and its privacy notice".

:SolidAppUsesDataHandlingPractices a owl:ObjectProperty ;
rdfs:label "Solid App Uses Data Handling Practices" ;
rdfs:comment "A relationship between a Solid app and its data handling practices".

# C5 - Users cannot express their privacy policies
:PrivacyPolicy a owl:Class ;
rdfs:label "Privacy Policy" ;
rdfs:comment "A policy that governs a user's privacy preferences".

:PrivacyPreferrence a owl:Class ;
rdfs:label "Privacy Preference" ;
rdfs:comment "A preference regarding a user's privacy".