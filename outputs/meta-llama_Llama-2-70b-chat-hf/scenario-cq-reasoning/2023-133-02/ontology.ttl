@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Asthma Ontology" ;
rdfs:comment "An ontology for describing asthma symptoms, medication intake, and outdoor environmental factors.".

:AsthmaPatient a owl:Class ;
rdfs:label "Asthma Patient" ;
rdfs:comment "An individual who has asthma.".

:Symptom a owl:Class ;
rdfs:label "Symptom" ;
rdfs:comment "A symptom experienced by an asthma patient.".

:Cough a owl:Class ;
rdfs:label "Cough" ;
rdfs:comment "A cough experienced by an asthma patient.".

:ChestTightness a owl:Class ;
rdfs:label "Chest Tightness" ;
rdfs:comment "Chest tightness experienced by an asthma patient.".

:Wheezing a owl:Class ;
rdfs:label "Wheezing" ;
rdfs:comment "Wheezing experienced by an asthma patient.".

:BreathingPatterns a owl:Class ;
rdfs:label "Breathing Patterns" ;
rdfs:comment "Breathing patterns experienced by an asthma patient.".

:Medication a owl:Class ;
rdfs:label "Medication" ;
rdfs:comment "A medication taken by an asthma patient.".

:Pollen a owl:Class ;
rdfs:label "Pollen" ;
rdfs:comment "Pollen in the outdoor environment.".

:AQI a owl:Class ;
rdfs:label "AQI" ;
rdfs:comment "Air Quality Index in the outdoor environment.".

:Presence a owl:Class ;
rdfs:label "Presence" ;
rdfs:comment "The presence of an outdoor environmental factor.".

:CausalRelation a owl:ObjectProperty ;
rdfs:label "Causal Relation" ;
rdfs:comment "A causal relation between two entities.".

:EffectWeight a owl:DatatypeProperty ;
rdfs:label "Effect Weight" ;
rdfs:comment "The effect weight of a causal relation.".

:AsthmaPatient :hasSymptom :Symptom.
:AsthmaPatient :hasMedication :Medication.
:Symptom :isCausedBy :Presence.
:Presence :hasEffectWeight :EffectWeight.
:Medication :isCausedBy :Presence.
:Cough :isA :Symptom.
:ChestTightness :isA :Symptom.
:Wheezing :isA :Symptom.
:BreathingPatterns :isA :Symptom.
:Pollen :isA :Presence.
:AQI :isA :Presence.