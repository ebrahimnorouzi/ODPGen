@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Evaluation Request Ontology" ;
rdfs:comment "An ontology for describing evaluation requests and their context".

:EvaluationRequest a owl:Class ;
rdfs:label "Evaluation Request" ;
rdfs:comment "A request for evaluating a target asset".

:Party a owl:Class ;
rdfs:label "Party" ;
rdfs:comment "A person or organization issuing an evaluation request".

:TargetAsset a owl:Class ;
rdfs:label "Target Asset" ;
rdfs:comment "The asset being evaluated".

:EvaluationContext a owl:Class ;
rdfs:label "Evaluation Context" ;
rdfs:comment "Additional contextual information for evaluating a target asset".

:TemporalContext a owl:Class ;
rdfs:label "Temporal Context" ;
rdfs:comment "Context related to time".

:SpatialContext a owl:Class ;
rdfs:label "Spatial Context" ;
rdfs:comment "Context related to location".

:RoleContext a owl:Class ;
rdfs:label "Role Context" ;
rdfs:comment "Context related to roles and permissions".

:RequestCapabilityContext a owl:Class ;
rdfs:label "Request Capability Context" ;
rdfs:comment "Context related to the capabilities of the requester".

:EvaluationRequest a owl:ObjectProperty ;
rdfs:label "evaluationRequest" ;
rdfs:comment "The evaluation request made by a party".

:Party a owl:ObjectProperty ;
rdfs:label "party" ;
rdfs:comment "The party issuing the evaluation request".

:TargetAsset a owl:ObjectProperty ;
rdfs:label "targetAsset" ;
rdfs:comment "The target asset being evaluated".

:EvaluationContext a owl:ObjectProperty ;
rdfs:label "evaluationContext" ;
rdfs:comment "The context in which the evaluation request was made".

:TemporalContext a owl:ObjectProperty ;
rdfs:label "temporalContext" ;
rdfs:comment "The temporal context of the evaluation request".

:SpatialContext a owl:ObjectProperty ;
rdfs:label "spatialContext" ;
rdfs:comment "The spatial context of the evaluation request".

:RoleContext a owl:ObjectProperty ;
rdfs:label "roleContext" ;
rdfs:comment "The role context of the evaluation request".

:RequestCapabilityContext a owl:ObjectProperty ;
rdfs:label "requestCapabilityContext" ;
rdfs:comment "The request capability context of the evaluation request".