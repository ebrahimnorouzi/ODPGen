@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Author Pseudonym Ontology" ;
rdfs:comment "An ontology for representing authors, their pseudonyms, and their published works.".

:Author a owl:Class ;
rdfs:label "Author" ;
rdfs:comment "A person who has written a book or other written work.".

:Pseudonym a owl:Class ;
rdfs:label "Pseudonym" ;
rdfs:comment "A fictional name used by an author to conceal their real identity.".

:Book a owl:Class ;
rdfs:label "Book" ;
rdfs:comment "A written or printed work consisting of pages glued or sewn together along one side and bound in covers.".

:Write a owl:ObjectProperty ;
rdfs:label "write" ;
rdfs:comment "The act of creating a written work." ;
domain :Author ;
range :Book.

:Use a owl:ObjectProperty ;
rdfs:label "use" ;
rdfs:comment "The act of using a pseudonym." ;
domain :Author ;
range :Pseudonym.

:HasPseudonym a owl:ObjectProperty ;
rdfs:label "has pseudonym" ;
rdfs:comment "The relationship between an author and their pseudonym." ;
domain :Author ;
range :Pseudonym.

:HasBook a owl:ObjectProperty ;
rdfs:label "has book" ;
rdfs:comment "The relationship between an author and their published book." ;
domain :Author ;
range :Book.

:SpiritInBondage a :Book ;
rdfs:label "Spirit in Bondage" ;
rdfs:comment "A collection of poems written by C. S. Lewis.".

:C SLewis a :Author ;
rdfs:label "C. S. Lewis" ;
rdfs:comment "A famous author who used the pseudonym Clive Hamilton.".

:CliveHamilton a :Pseudonym ;
rdfs:label "Clive Hamilton" ;
rdfs:comment "A pseudonym used by C. S. Lewis.".

:UsePseudonym a owl:ObjectProperty ;
rdfs:label "use pseudonym" ;
rdfs:comment "The act of using a pseudonym." ;
domain :Author ;
range :Pseudonym.

:HasTrajectory a owl:ObjectProperty ;
rdfs:label "has trajectory" ;
rdfs:comment "The relationship between a river and its trajectory." ;
domain :River ;
range :Trajectory.

:Trajectory a owl:Class ;
rdfs:label "Trajectory" ;
rdfs:comment "A path or course along which something moves or extends.".

:River a owl:Class ;
rdfs:label "River" ;
rdfs:comment "A natural flowing body of water.".

:NationalPark a owl:Class ;
rdfs:label "National Park" ;
rdfs:comment "A protected area of outstanding natural beauty or historical significance.".

:Crosses a owl:ObjectProperty ;
rdfs:label "crosses" ;
rdfs:comment "The relationship between a river and a national park." ;
domain :River ;
range :NationalPark.