@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Author and Work Ontology" ;
rdfs:comment "An ontology for representing authors, their works, and their pseudonyms.".

Author a owl:Thing ;
rdfs:label "Author" ;
rdfs:comment "An author who has written works.".

hasName a rdfs:String ;
rdfs:label "name" ;
rdfs:comment "The name of the author.".