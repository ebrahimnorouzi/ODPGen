@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Ontology for Rule-based System" ;
  rdfs:comment "An ontology to support rule-based systems with time, location, assets, parties, actions, events, and financial transactions.".

# Time
:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "Represents a point in time.".

:hasTime rdf:Property ;
  rdfs:label "hasTime" ;
  rdfs:comment "Relates an event or action to a specific time.".

# Location
:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Represents a physical place.".

:takesPlace rdf:Property ;
  rdfs:label "takesPlace" ;
  rdfs:comment "Relates an event or action to a specific location.".

# Asset
:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Represents a tangible or intangible object of value.".

:belongsToCollection rdf:Property ;
  rdfs:label "belongsToCollection" ;
  rdfs:comment "Relates an asset to a specific collection.".

:AssetCollection a owl:Class ;
  rdfs:label "Asset Collection" ;
  rdfs:comment "Represents a group of assets.".

# Party
:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "Represents an individual or organization involved in a rule-based system.".

:belongsToPolicy rdf:Property ;
  rdfs:label "belongsToPolicy" ;
  rdfs:comment "Relates a party to a specific policy.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "Represents a set of rules and conditions for a rule-based system.".

:hasPartyCollection rdf:Property ;
  rdfs:label "hasPartyCollection" ;
  rdfs:comment "Relates a policy to its party collection.".

# Action
:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Represents an activity or operation performed or attempted.".

:performed rdf:Property ;
  rdfs:label "performed" ;
  rdfs:comment "Relates an action to a specific party.".

:attempted rdf:Property ;
  rdfs:label "attempted" ;
  rdfs:comment "Relates an action to a specific party that attempted but did not perform the action.".

# Event
:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Represents a significant occurrence or happening.".

:hasInformation rdf:Property ;
  rdfs:label "hasInformation" ;
  rdfs:comment "Relates an event to the available information about it.".

# Financial Transaction
:FinancialTransaction a owl:Class ;
  rdfs:label "Financial Transaction" ;
  rdfs:comment "Represents a monetary transfer or exchange.".

:hasAmount rdf:Property ;
  rdfs:label "hasAmount" ;
  rdfs:comment "Relates a financial transaction to the amount involved.".