@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODP for Competency Questions" ;
  rdfs:comment "An ontology to support answering competency questions.".

# Time
:CurrentTime a owl:Class ;
  rdfs:label "Current Time" ;
  rdfs:comment "Represents the current time.".

:hasTime a owl:ObjectProperty ;
  rdfs:label "Has Time" ;
  rdfs:comment "Relates an event to its time.".

# Location
:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Represents a physical location.".

:isAt a owl:ObjectProperty ;
  rdfs:label "Is At" ;
  rdfs:comment "Relates an event or party to its location.".

# Asset
:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Represents a tangible or intangible item of value.".

:isPartOf a owl:ObjectProperty ;
  rdfs:label "Is Part Of" ;
  rdfs:comment "Relates an asset to a collection it belongs to.".

:AssetCollection a owl:Class ;
  rdfs:label "Asset Collection" ;
  rdfs:comment "Represents a collection of assets.".

# Party
:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "Represents an individual or group involved in an event.".

:isPartOf a owl:ObjectProperty ;
  rdfs:label "Is Part Of" ;
  rdfs:comment "Relates a party to a collection it belongs to.".

:PartyCollection a owl:Class ;
  rdfs:label "Party Collection" ;
  rdfs:comment "Represents a collection of parties.".

# Action
:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Represents an activity or operation.".

:wasPerformed a owl:ObjectProperty ;
  rdfs:label "Was Performed" ;
  rdfs:comment "Relates an action to the party that performed it.".

:wasAttempted a owl:ObjectProperty ;
  rdfs:label "Was Attempted" ;
  rdfs:comment "Relates an action to the party that attempted it.".

# Rule
:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "Represents a set of conditions and actions.".

:wasExercised a owl:ObjectProperty ;
  rdfs:label "Was Exercised" ;
  rdfs:comment "Relates a rule to the event that triggered its exercise.".

# Event
:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Represents a significant occurrence.".

:hasInformation a owl:ObjectProperty ;
  rdfs:label "Has Information" ;
  rdfs:comment "Relates an event to the information available about it.".

# Duration
:Duration a owl:Class ;
  rdfs:label "Duration" ;
  rdfs:comment "Represents the length of time for an event or rule exercise.".