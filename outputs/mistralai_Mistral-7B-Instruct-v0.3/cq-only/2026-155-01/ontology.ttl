@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Property Investigation Ontology" ;
  rdfs:comment "An ontology to model cultural property investigations and related activities.".

# Cultural Property and Feature of Interest
:CulturalProperty a owl:Class ;
  rdfs:label "Cultural Property" ;
  rdfs:comment "Represents a cultural property.".

:FeatureOfInterest a owl:Class ;
  rdfs:label "Feature of Interest" ;
  rdfs:comment "Represents a specific feature of interest within a cultural property.".

# Survey or Investigation Activity
:SurveyActivity a owl:Class ;
  rdfs:label "Survey Activity" ;
  rdfs:comment "Represents a survey or investigation activity performed on a cultural property or feature of interest.".

:hasPerformed rdf:Property ;
  rdfs:domain :CulturalProperty ;
  rdfs:range :SurveyActivity ;
  rdfs:label "Performed Survey Activity" ;
  rdfs:comment "Indicates a survey activity performed on a cultural property or feature of interest.".

# Investigation Technique
:InvestigationTechnique a owl:Class ;
  rdfs:label "Investigation Technique" ;
  rdfs:comment "Represents a method or technique used in a survey or investigation activity.".

:usedTechnique rdf:Property ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :InvestigationTechnique ;
  rdfs:label "Used Technique" ;
  rdfs:comment "Indicates the technique used in a survey or investigation activity.".

# Observation
:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Represents an observation produced during a survey or investigation activity.".

:producedBy rdf:Property ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :Observation ;
  rdfs:label "Produced By" ;
  rdfs:comment "Indicates an observation produced during a survey or investigation activity.".

# Expert and Role
:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "Represents an expert participating in a survey or investigation activity.".

:hasRole rdf:Property ;
  rdfs:domain :Expert ;
  rdfs:range :Role ;
  rdfs:label "Has Role" ;
  rdfs:comment "Indicates the role of an expert in a survey or investigation activity.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Represents a role of an expert in a survey or investigation activity.".

# Hardware, Software, and Technical Configuration
:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "Represents hardware used to conduct a specific survey or investigation activity.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "Represents software used to conduct a specific survey or investigation activity.".

:TechnicalConfiguration a owl:Class ;
  rdfs:label "Technical Configuration" ;
  rdfs:comment "Represents the technical configuration used to conduct a specific survey or investigation activity.".