@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Investigation Ontology" ;
  rdfs:comment "An ontology for modeling cultural heritage investigation activities.".

# Cultural Property and Feature of Interest
:CulturalProperty a owl:Class ;
  rdfs:label "Cultural Property" ;
  rdfs:comment "A physical object or site of cultural significance.".

:FeatureOfInterest a owl:Class ;
  rdfs:label "Feature of Interest" ;
  rdfs:comment "A specific aspect or detail of a cultural property that is the focus of investigation.".

:hasFeatureOfInterest owl:ObjectProperty ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range :FeatureOfInterest ;
  rdfs:label "Has Feature of Interest" ;
  rdfs:comment "Relates an investigation activity to a feature of interest.".

# Investigation Activity
:InvestigationActivity a owl:Class ;
  rdfs:label "Investigation Activity" ;
  rdfs:comment "A specific survey or investigation conducted on a cultural property or feature of interest.".

:performedOn owl:ObjectProperty ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range [ owl:unionOf (:CulturalProperty :FeatureOfInterest) ] ;
  rdfs:label "Performed On" ;
  rdfs:comment "Relates an investigation activity to the cultural property or feature of interest it was conducted on.".

# Investigation Method and Technique
:InvestigationMethod a owl:Class ;
  rdfs:label "Investigation Method" ;
  rdfs:comment "A specific method or technique used in an investigation activity.".

:usedIn owl:ObjectProperty ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range :InvestigationMethod ;
  rdfs:label "Used In" ;
  rdfs:comment "Relates an investigation activity to the method or technique used.".

# Observation
:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A result or finding produced during an investigation activity.".

:producedBy owl:ObjectProperty ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range :Observation ;
  rdfs:label "Produced By" ;
  rdfs:comment "Relates an observation to the investigation activity that produced it.".

# Expert and Role
:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "A person with specialized knowledge in a relevant field.".

:hasRole owl:ObjectProperty ;
  rdfs:domain :Expert ;
  rdfs:range :Role ;
  rdfs:label "Has Role" ;
  rdfs:comment "Relates an expert to the role they played in an investigation activity.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A specific role an expert played in an investigation activity.".

# Equipment and Configuration
:Equipment a owl:Class ;
  rdfs:label "Equipment" ;
  rdfs:comment "Hardware, software, or other tools used in an investigation activity.".