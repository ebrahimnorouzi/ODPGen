@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODP for Persistent Identifiers" ;
  rdfs:comment "An ontology to support competency questions about persistent identifiers.".

# Classes
:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "A generic class for any entity that can be referenced.".

:Referent a owl:Class ;
  rdfs:subClassOf [ owl:onProperty :hasReferent ] ;
  rdfs:label "Referent" ;
  rdfs:comment "A specific entity that is referenced by a persistent identifier.".

:Observation a owl:Class ;
  rdfs:subClassOf [ owl:onProperty :hasObservation ] ;
  rdfs:label "Observation" ;
  rdfs:comment "An event or fact associated with a referent.".

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "A change in the referent of a persistent identifier.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "A set of conditions that trigger a transition.".

# Properties
:hasReferent a owl:ObjectProperty ;
  rdfs:domain :Entity ;
  rdfs:range :Referent ;
  rdfs:label "hasReferent" ;
  rdfs:comment "Relates an entity to the referent it currently references.".

:hasObservation a owl:ObjectProperty ;
  rdfs:domain :Referent ;
  rdfs:range :Observation ;
  rdfs:label "hasObservation" ;
  rdfs:comment "Relates a referent to an observation associated with it.".

:hasTransition a owl:ObjectProperty ;
  rdfs:domain :Referent ;
  rdfs:range :Transition ;
  rdfs:label "hasTransition" ;
  rdfs:comment "Relates a referent to a transition that occurred.".

:hasRule a owl:ObjectProperty ;
  rdfs:domain :Transition ;
  rdfs:range :Rule ;
  rdfs:label "hasRule" ;
  rdfs:comment "Relates a transition to the rule that triggered it.".

:hasTimestamp a owl:DatatypeProperty ;
  rdfs:domain [ owl:onClass :Transition ; owl:onClass :Observation ] ;
  rdfs:range xsd:dateTime ;
  rdfs:label "hasTimestamp" ;
  rdfs:comment "Relates a transition or observation to the timestamp when it occurred.".

# Axioms
:Referent rdfs:subClass [ a owl:Restriction ;
                             owl:onProperty :hasReferent ;
                             owl:allValuesFrom :Entity ].

:Observation rdfs:subClass [ a owl:Restriction ;
                              owl:onProperty :hasObservation ;
                              owl:allValuesFrom :Referent ].

:Transition rdfs:subClass [ a owl:Restriction ;
                              owl:onProperty :hasTransition ;
                              owl:allValuesFrom :Referent ].