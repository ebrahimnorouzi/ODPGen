@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "MQTT Ontology" ;
    rdfs:comment "Ontology for modeling MQTT Clients, Brokers, NetworkConnections, SOSA systems, sensors, actuators, topics, filters, and control packets.".

# Classes
:MQTTBroker a owl:Class ;
    rdfs:label "MQTT Broker" ;
    rdfs:comment "A MQTT Broker that manages connections between MQTT Clients.".

:MQTTClient a owl:Class ;
    rdfs:label "MQTT Client" ;
    rdfs:comment "An MQTT Client that connects to a MQTT Broker.".

:NetworkConnection a owl:Class ;
    rdfs:label "Network Connection" ;
    rdfs:comment "A connection between two MQTT Clients or a MQTT Client and a MQTT Broker.".

:SOSAPlatform a owl:Class ;
    rdfs:label "SOSA Platform" ;
    rdfs:comment "A platform that runs MQTT Clients.".

:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "A SOSA sensor that publishes observations to MQTT Topics.".

:Actuator a owl:Class ;
    rdfs:label "Actuator" ;
    rdfs:comment "A SOSA actuator that listens to MQTT Topics for commands.".

:FeatureOfInterest a owl:Class ;
    rdfs:label "Feature of Interest" ;
    rdfs:comment "A SOSA Feature of Interest that is represented as an MQTT Topic.".

:Property a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "A SOSA Property that is represented as an MQTT Topic.".

:Topic a owl:Class ;
    rdfs:label "MQTT Topic" ;
    rdfs:comment "An MQTT Topic that MQTT Clients can publish or subscribe to.".

:TopicFilter a owl:Class ;
    rdfs:label "MQTT Topic Filter" ;
    rdfs:comment "An MQTT Topic Filter that specifies a pattern for matching MQTT Topics.".

:ControlPacket a owl:Class ;
    rdfs:label "MQTT Control Packet" ;
    rdfs:comment "An MQTT Control Packet that is used for managing connections and subscriptions.".

:Publish a owl:Class ;
    rdfs:label "MQTT PUBLISH Packet" ;
    rdfs:comment "An MQTT PUBLISH Packet that is used for publishing observations or actuations.".

:Subscribe a owl:Class ;
    rdfs:label "MQTT SUBSCRIBE Packet" ;
    rdfs:comment "An MQTT SUBSCRIBE Packet that is used for subscribing to MQTT Topics.".

:Unsubscribe a owl:Class ;
    rdfs:label "MQTT UNSUBSCRIBE Packet" ;
    rdfs:comment "An MQTT UNSUBSCRIBE Packet that is used for unsubscribing from MQTT Topics.".