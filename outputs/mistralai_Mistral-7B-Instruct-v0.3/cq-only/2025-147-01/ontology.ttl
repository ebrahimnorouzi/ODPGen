@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Ship Ontology" ;
  rdfs:comment "An ontology for describing ships and their properties.".

# Ships
:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A watercraft used for transportation.".

:hasShipID a owl:ObjectProperty ;
  rdfs:label "Ship ID" ;
  rdfs:comment "The unique identifier for a ship.".

# Dimensions
:hasLength a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "The length of the ship in meters.".
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal.

:hasWidth a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "The width of the ship in meters.".
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal.

:hasDraught a owl:DatatypeProperty ;
  rdfs:label "Draught" ;
  rdfs:comment "The draught of the ship in meters.".
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal.

# Ownership
:hasOwner a owl:ObjectProperty ;
  rdfs:label "Owner" ;
  rdfs:comment "The organization or individual that owns the ship.".

# Location
:hasRegistrationCountry a owl:ObjectProperty ;
  rdfs:label "Registration Country" ;
  rdfs:comment "The country where the ship is registered.".

# Speed
:hasAverageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "The average speed of the ship over ground in knots.".
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal.

# Engines
:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "A device that converts energy into mechanical motion.".

:hasEngineType a owl:ObjectProperty ;
  rdfs:label "Engine Type" ;
  rdfs:comment "The type of engine used in the ship.".

:hasNumberOfEngines a owl:DatatypeProperty ;
  rdfs:label "Number of Engines" ;
  rdfs:comment "The number of engines in the ship.".
  rdfs:domain :Ship ;
  rdfs:range xsd:nonNegativeInteger.

# Propulsion
:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "A system that provides forward motion for the ship.".

:hasPropulsionTechnology a owl:ObjectProperty ;
  rdfs:label "Propulsion Technology" ;
  rdfs:comment "The technology used by the propulsion system.".

:hasPropulsionType a owl:ObjectProperty ;
  rdfs:label "Propulsion Type" ;
  rdfs:comment "The type of propulsion system used by the ship.".

:hasGPSAntennaPlacement a owl:ObjectProperty ;
  rdfs:label "GPS Antenna Placement" ;
  rdfs:comment "The location of the GPS antenna on the ship.".