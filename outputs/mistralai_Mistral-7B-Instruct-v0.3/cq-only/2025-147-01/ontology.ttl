@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Ship Ontology" ;
  rdfs:comment "An ontology for modeling ships and related concepts.".

# Ships
:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A watercraft used for transportation.".

:hasID a owl:ObjectProperty ;
  rdfs:label "Has ID" ;
  rdfs:comment "Identifies a specific ship.".
  domain :Ship ;
  range xsd:string.

# Dimensions
:length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "The length of the ship.".
  domain :Ship ;
  range xsd:nonNegativeInteger.

:width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "The width of the ship.".
  domain :Ship ;
  range xsd:nonNegativeInteger.

:draught a owl:DatatypeProperty ;
  rdfs:label "Draught" ;
  rdfs:comment "The draught of the ship.".
  domain :Ship ;
  range xsd:nonNegativeInteger.

# Location
:registeredIn a owl:ObjectProperty ;
  rdfs:label "Registered in" ;
  rdfs:comment "The country where the ship is registered.".
  domain :Ship ;
  range :Country.

:typicalLocation a owl:ObjectProperty ;
  rdfs:label "Typical Location" ;
  rdfs:comment "The typical location of the ship.".
  domain :Ship ;
  range :Location.

# Ownership
:owner a owl:ObjectProperty ;
  rdfs:label "Owner" ;
  rdfs:comment "The owner of the ship.".
  domain :Ship ;
  range :Organization.

# Speed
:averageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "The average speed of the ship over ground.".
  domain :Ship ;
  range xsd:nonNegativeFloat.

# Engines
:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "A device that converts energy into mechanical motion.".

:type a owl:ObjectProperty ;
  rdfs:label "Type" ;
  rdfs:comment "The type of engine.".
  domain :Engine ;
  range :EngineType.

:power a owl:ObjectProperty ;
  rdfs:label "Power" ;
  rdfs:comment "The power source of the engine.".
  domain :Engine ;
  range :PowerSource.

:drivenBy a owl:ObjectProperty ;
  rdfs:label "Driven By" ;
  rdfs:comment "What is driven by the engine.".
  domain :Engine ;
  range :DrivenBy.

# Propulsion Systems
:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "A system that provides forward motion for a ship.".

:typePropulsion a owl:ObjectProperty ;
  rdfs:label "Type of Propulsion" ;
  rdfs:comment "The type of propulsion system.".
  domain :PropulsionSystem ;
  range :PropulsionType.