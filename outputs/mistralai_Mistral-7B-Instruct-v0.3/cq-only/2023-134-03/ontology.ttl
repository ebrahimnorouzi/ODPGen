@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Registry Ontology" ;
  rdfs:comment "An ontology for modeling a data registry.".

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry of data.".

:Maintainer a owl:Class ;
  rdfs:label "Maintainer" ;
  rdfs:comment "The person or entity maintaining the registry.".

:CreationDate a owl:DatatypeProperty ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date ;
  rdfs:label "Creation Date" ;
  rdfs:comment "The date when the registry was created.".

:UpdateDate a owl:DatatypeProperty ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date ;
  rdfs:label "Update Date" ;
  rdfs:comment "The date when the registry was last updated.".

:DataType a owl:Class ;
  rdfs:label "DataType" ;
  rdfs:comment "The type of data available in the registry.".

:StorageLocation a owl:ObjectProperty ;
  rdfs:domain :DataType ;
  rdfs:range :Location ;
  rdfs:label "Storage Location" ;
  rdfs:comment "The location where a specific type of data is stored.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A physical or logical location where data is stored.".

:Policy a owl:ObjectProperty ;
  rdfs:domain :DataType ;
  rdfs:range :Policy ;
  rdfs:label "Policy" ;
  rdfs:comment "The policy associated with a specific type of data.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A set of rules governing the access, use, and management of data.".