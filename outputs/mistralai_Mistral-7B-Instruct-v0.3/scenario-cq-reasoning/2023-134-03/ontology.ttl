@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Ontology" ;
  rdfs:comment "An ontology for governing Solid apps.".

# Classes
:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "A Solid actor, such as a user or a service.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role played by an actor in the Solid ecosystem.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A Solid Pod containing user data.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "A Solid app.".

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "A category of data stored in a Pod.".

:DataHandlingPolicy a owl:Class ;
  rdfs:label "Data Handling Policy" ;
  rdfs:comment "A policy governing the handling of data in a Pod or app.".

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "A policy expressing a user's privacy preferences.".

# Object Properties
:maintains rdf:Property ;
  rdfs:domain :Actor ;
  rdfs:range :Registry ;
  rdfs:label "Maintains" ;
  rdfs:comment "The actor responsible for maintaining the registry.".

:created rdf:Property ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Created" ;
  rdfs:comment "The creation date of the registry.".

:updated rdf:Property ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Updated" ;
  rdfs:comment "The last update date of the registry.".

:provides rdf:Property ;
  rdfs:domain :Pod ;
  rdfs:range :DataCategory ;
  rdfs:label "Provides" ;
  rdfs:comment "The data category provided by the Pod.".

:stores rdf:Property ;
  rdfs:domain :DataCategory ;
  rdfs:range :Pod ;
  rdfs:label "Stores" ;
  rdfs:comment "The Pod where a specific data category is stored.".

:associatedWith rdf:Property ;
  rdfs:domain :DataHandlingPolicy ;
  rdfs:range :Pod ;
  rdfs:label "Associated With" ;
  rdfs:comment "The Pod to which a data handling policy is associated.".

:associatedWith rdf:Property ;
  rdfs:domain :DataHandlingPolicy ;
  rdfs:range :App ;
  rdfs:label "Associated With" ;
  rdfs:comment "The app to which a data handling policy is associated.".

:hasPrivacyPolicy rdf:Property ;
  rdfs:domain :Actor ;
  rdfs:range :PrivacyPolicy ;
  rdfs:label "Has Privacy Policy" ;
  rdfs:comment "The privacy policy of an actor.".