@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Ontology" ;
  rdfs:comment "An ontology for governing Solid apps.".

# Atomic Requirements

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "A Solid actor, such as a user or an app.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "The role of an actor in the Solid ecosystem.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A Solid user's personal data store.".

:Infrastructure a owl:Class ;
  rdfs:label "Infrastructure" ;
  rdfs:comment "The Solid specification or functionalities installed within a Pod.".

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "A category of data stored in a Pod.".

:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "The practice followed by a Pod or app regarding data handling.".

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "The privacy preferences and requirements of a Solid user.".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "A record of data interactions in a Pod.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "The type of action performed on data, e.g., create, update, erase.".

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "The data stored in a Pod.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "The application or service used to generate or interact with data.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "The place where data is stored or the log is issued.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "The point in time when an action was performed or a log was issued.".

# Properties

:hasRole a owl:ObjectProperty ;
  domain :Actor ;
  range :Role ;
  rdfs:label "Has Role" ;
  rdfs:comment "The role an actor plays in the Solid ecosystem.".

:providesPod a owl:ObjectProperty ;
  domain :Actor ;
  range :Pod ;
  rdfs:label "Provides Pod" ;
  rdfs:comment "The Pod provided by an actor.".

:hasInfrastructure a owl:ObjectProperty ;
  domain :Pod ;
  range :Infrastructure ;
  rdfs:label "Has Infrastructure" ;
  rdfs:comment "The Solid specification or functionalities installed within a Pod.".

:hasDataCategory a owl:ObjectProperty ;
  domain :Data ;
  range :DataCategory ;
  rdfs:label "Has Data Category" ;
  rdfs:comment "The category of data stored in a Pod.".