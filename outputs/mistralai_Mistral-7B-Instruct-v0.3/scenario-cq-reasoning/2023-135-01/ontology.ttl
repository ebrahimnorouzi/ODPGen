:Ontology a owl:Ontology ;
    rdfs:label "Pseudonym Ontology" ;
    rdfs:comment "An ontology for authors adopting different names to publish books.".

:Author rdfs:subClassOf owl:Thing.
:Pseudonym rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Pseudonym" ;
    rdfs:comment "A name adopted by an author to publish books.".
:RealName rdfs:subClassOf owl:NamedIndividual ;
    rdfs:label "Real Name" ;
    rdfs:comment "The real name of an author.".
:Book rdfs:subClassOf owl:Thing ;
    rdfs:label "Book" ;
    rdfs:comment "A published work.".

:PublishedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Pseudonym ;
    rdfs:label "Published By" ;
    rdfs:comment "The pseudonym under which a book was published.".

:HasAuthor rdf:type owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range :Author ;
    rdfs:label "Has Author" ;
    rdfs:comment "The author(s) of a book.".

:IsPseudonymOf rdf:type owl:ObjectProperty ;
    rdfs:domain :RealName ;
    rdfs:range :Pseudonym ;
    rdfs:label "Is Pseudonym Of" ;
    rdfs:comment "The pseudonym associated with a real name.".