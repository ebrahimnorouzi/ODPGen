@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT messages and their semantics in the context of the EKI project.".

# Requirement 1: Model MQTT Brokers
:Broker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Represents an MQTT Broker.".

:hasBrokerID a owl:ObjectProperty ;
  rdfs:domain :Broker ;
  rdfs:range xsd:string ;
  rdfs:label "Has Broker ID" ;
  rdfs:comment "Identifies the MQTT Broker.".

:hasHostPort a owl:ObjectProperty ;
  rdfs:domain :Broker ;
  rdfs:range xsd:string ;
  rdfs:label "Has Host and Port" ;
  rdfs:comment "Specifies the host and port of the MQTT Broker.".

# Requirement 2: Model MQTT Clients
:Client a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Represents an MQTT Client.".

:hasClientID a owl:ObjectProperty ;
  rdfs:domain :Client ;
  rdfs:range xsd:string ;
  rdfs:label "Has Client ID" ;
  rdfs:comment "Identifies the MQTT Client.".

:runsOn a owl:ObjectProperty ;
  rdfs:domain :Client ;
  rdfs:range :SOSAPlatform ;
  rdfs:label "Runs on SOSA Platform" ;
  rdfs:comment "Specifies the SOSA platform the MQTT Client runs on.".

:hosts a owl:ObjectProperty ;
  rdfs:domain :Client ;
  rdfs:range :SOSASystem ;
  rdfs:label "Hosts SOSA System" ;
  rdfs:comment "Specifies the SOSA system the MQTT Client hosts.".

# Requirement 3: Model MQTT NetworkConnections
:NetworkConnection a owl:Class ;
  rdfs:label "MQTT NetworkConnection" ;
  rdfs:comment "Represents an MQTT NetworkConnection.".

:isSecure a owl:ObjectProperty ;
  rdfs:domain :NetworkConnection ;
  rdfs:range xsd:boolean ;
  rdfs:label "Is Secure" ;
  rdfs:comment "Indicates whether the MQTT NetworkConnection is TLS-secured.".

:isInitiatedBy a owl:ObjectProperty ;
  rdfs:domain :NetworkConnection ;
  rdfs:range (:Client | :Broker) ;
  rdfs:label "Is Initiated By" ;
  rdfs:comment "Specifies the MQTT participant that initiated the NetworkConnection.".

# Requirement 4: Model MQTT Participants
:Participant a owl:Class ;
  rdfs:subClassOf [ a owl:Class ;
                    rdfs:subClassOf (:Broker | :Client) ] ;
  rdfs:label "MQTT Participant" ;
  rdfs:comment "Represents an MQTT Broker or Client.".