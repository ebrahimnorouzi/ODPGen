@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "An ontology for modeling evaluation requests on assets.".

# Atomic Requirements
:RequestedAction a owl:Class ;
  rdfs:label "Requested Action" ;
  rdfs:comment "The action requested in the evaluation request.".

:Issuer a owl:Class ;
  rdfs:label "Issuer" ;
  rdfs:comment "The party issuing the evaluation request.".

:TargetAsset a owl:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset targeted by the evaluation request.".

:IssueTime a owl:DatatypeProperty ;
  rdfs:label "Issue Time" ;
  rdfs:comment "The time when the evaluation request was issued.".
  owl:domain :EvaluationRequest ;
  owl:range xsd:dateTime.

:AdditionalContext a owl:Class ;
  rdfs:label "Additional Context" ;
  rdfs:comment "Additional contextual information related to the evaluation request.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "The role of the issuer.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "The location from where the request was issued.".

:Capability a owl:Class ;
  rdfs:label "Capability" ;
  rdfs:comment "The capability required to perform the requested action.".

:EvaluationRequest a owl:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "A request for an evaluation on a target asset.".
  owl:disjointWith :Issuer, :TargetAsset, :IssueTime, :AdditionalContext, :Role, :Location, :Capability.

:hasIssuer a owl:ObjectProperty ;
  rdfs:label "Has Issuer" ;
  rdfs:comment "The issuer of the evaluation request.".
  owl:domain :EvaluationRequest ;
  owl:range :Issuer.

:hasTargetAsset a owl:ObjectProperty ;
  rdfs:label "Has Target Asset" ;
  rdfs:comment "The target asset of the evaluation request.".
  owl:domain :EvaluationRequest ;
  owl:range :TargetAsset.

:hasAdditionalContext a owl:ObjectProperty ;
  rdfs:label "Has Additional Context" ;
  rdfs:comment "Additional contextual information related to the evaluation request.".
  owl:domain :EvaluationRequest ;
  owl:range :AdditionalContext.

:hasRole a owl:ObjectProperty ;
  rdfs:label "Has Role" ;
  rdfs:comment "The role of the issuer.".
  owl:domain :Issuer ;
  owl:range :Role.

:hasLocation a owl:ObjectProperty ;
  rdfs:label "Has Location" ;
  rdfs:comment "The location from where the request was issued.".
  owl:domain :Issuer ;
  owl:range :Location.

:hasCapability a owl:ObjectProperty ;
  rdfs:label "Has Capability" ;
  rdfs:comment "The capability required to perform the requested action.".
  owl:domain :RequestedAction ;
  owl:range :Capability.