:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "An ontology for modeling evaluation requests with temporal, spatial, role, and request-capability context.".

:Request a owl:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "A formal description of a requested action on a target asset.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "The action being requested.".

:TargetAsset a owl:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset that the action is being requested on.".

:Employee a owl:Class ;
  rdfs:label "Employee" ;
  rdfs:comment "An employee who can issue an evaluation request.".

:Weekday a owl:Class ;
  rdfs:label "Weekday" ;
  rdfs:comment "A day of the week.".

:EU a owl:Class ;
  rdfs:label "EU" ;
  rdfs:comment "The European Union.".

:Issuer a owl:ObjectProperty ;
  rdfs:label "Issuer" ;
  rdfs:comment "The employee who issued the evaluation request.".

:Target a owl:ObjectProperty ;
  rdfs:label "Target" ;
  rdfs:comment "The target asset of the evaluation request.".

:Time a owl:DatatypeProperty ;
  rdfs:label "Time" ;
  rdfs:comment "The time when the evaluation request was issued.".