@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "An ontology for addressing governance challenges in Solid apps.".

# Classes
:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "A person or entity involved in Solid.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A function or position within Solid.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A Solid user's personal data store.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "A Solid application.".

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "A classification of data in a Pod.".

:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "A method or policy for handling data in a Pod or app.".

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "A user's privacy preferences and requirements.".

:AccessMode a owl:Class ;
  rdfs:label "Access Mode" ;
  rdfs:comment "The method used to access data in a Pod.".

:PersonalData a owl:Class ;
  rdfs:label "Personal Data" ;
  rdfs:comment "Data related to an individual.".

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "The reason for accessing personal data.".

# Object Properties
:hasIdentifier a owl:ObjectProperty ;
  rdfs:domain :PrivacyPolicy ;
  rdfs:range xsd:string ;
  rdfs:label "Has Identifier" ;
  rdfs:comment "The unique identifier of a privacy policy.".

:hasCreator a owl:ObjectProperty ;
  rdfs:domain :PrivacyPolicy ;
  rdfs:range :Actor ;
  rdfs:label "Has Creator" ;
  rdfs:comment "The actor who created the privacy policy.".

:hasIssueDate a owl:ObjectProperty ;
  rdfs:domain :PrivacyPolicy ;
  rdfs:range xsd:date ;
  rdfs:label "Has Issue Date" ;
  rdfs:comment "The date the privacy policy was issued.".

:hasAssignee a owl:ObjectProperty ;
  rdfs:domain :PrivacyPolicy ;
  rdfs:range :Actor ;
  rdfs:label "Has Assignee" ;
  rdfs:comment "The actor to whom the privacy policy applies.".

:usesApp a owl:ObjectProperty ;
  rdfs:domain :AccessRequest ;
  rdfs:range :App ;
  rdfs:label "Uses App" ;
  rdfs:comment "The app being used to access the data.".

:requestsAccessMode a owl:ObjectProperty ;
  rdfs:domain :AccessRequest ;
  rdfs:range :AccessMode ;
  rdfs:label "Requests Access Mode" ;
  rdfs:comment "The access mode being requested.".