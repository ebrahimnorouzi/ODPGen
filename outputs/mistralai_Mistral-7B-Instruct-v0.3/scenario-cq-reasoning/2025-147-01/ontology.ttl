:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties.".

# Ships
:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "Represents a ship.".

:hasID a owl:ObjectProperty ;
  rdfs:domain :Ship ;
  rdfs:range xsd:string ;
  rdfs:label "hasID" ;
  rdfs:comment "Identifies a ship.".

# Dimensions
:length a owl:DatatypeProperty ;
  rdfs:domain :Ship ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "length" ;
  rdfs:comment "Describes the length of a ship.".

:width a owl:DatatypeProperty ;
  rdfs:domain :Ship ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "width" ;
  rdfs:comment "Describes the width of a ship.".

:draught a owl:DatatypeProperty ;
  rdfs:domain :Ship ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "draught" ;
  rdfs:comment "Describes the draught of a ship.".

# Location
:location a owl:ObjectProperty ;
  rdfs:domain :Ship ;
  rdfs:range :GeographicalLocation ;
  rdfs:label "location" ;
  rdfs:comment "Describes the typical location of a ship.".

:GeographicalLocation a owl:Class ;
  rdfs:label "GeographicalLocation" ;
  rdfs:comment "Represents a geographical location.".

# Ownership
:owner a owl:ObjectProperty ;
  rdfs:domain :Ship ;
  rdfs:range :Organization ;
  rdfs:label "owner" ;
  rdfs:comment "Identifies the owner of a ship.".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "Represents an organization.".

# Speed
:averageSpeed a owl:DatatypeProperty ;
  rdfs:domain :Ship ;
  rdfs:range xsd:nonNegativeFloat ;
  rdfs:label "averageSpeed" ;
  rdfs:comment "Specifies the average speed over ground of a ship.".

# Registration
:registeredUnder a owl:ObjectProperty ;
  rdfs:domain :Ship ;
  rdfs:range :Country ;
  rdfs:label "registeredUnder" ;
  rdfs:comment "Identifies the country under which a ship is registered.".

:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "Represents a country.".

# Trajectory
:trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "Represents a ship's trajectory.".

:startLocation a owl:ObjectProperty ;
  rdfs:domain :Trajectory ;
  rdfs:range :GeographicalLocation ;
  rdfs:label "startLocation" ;
  rdfs:comment "Identifies the starting location of a trajectory.".

:endLocation a owl:ObjectProperty ;
  rdfs:domain :Trajectory ;
  rdfs:range :GeographicalLocation ;
  rdfs:label "endLocation" ;
  rdfs:comment "Identifies the ending location of a trajectory.".

# Propulsion Systems
:propulsionSystem a owl:Class ;
  rdfs:label "PropulsionSystem" ;
  rdfs:comment "Represents a propulsion system.".