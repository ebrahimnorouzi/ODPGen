:Ontology a owl:Ontology ;
  rdfs:label "Persistent Identifier Ontology" ;
  rdfs:comment "Ontology for managing persistent identifiers across domains.".

:PID a owl:Class ;
  rdfs:label "PersistentIdentifier" ;
  rdfs:comment "Unique string identifier.".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "Anything that can be identified by a PID.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Data associated with an entity.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "Governs PID transitions.".