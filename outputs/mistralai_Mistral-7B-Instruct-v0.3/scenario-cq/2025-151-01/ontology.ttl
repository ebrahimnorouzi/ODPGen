:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "An ontology for modeling evaluation requests on assets, with temporal, spatial, role, and request-capability context.".

:Request a owl:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "A formal description of a requested action on a target asset.".

:Action a owl:Class ;
  rdfs:label "Requested Action" ;
  rdfs:comment "The action that is being requested on the target asset.".

:Party a owl:Class ;
  rdfs:label "Request Issuer" ;
  rdfs:comment "The party issuing the evaluation request.".

:Employee a owl:Class ;
  rdfs:label "Employee" ;
  rdfs:comment "A member of the organization who is authorized to issue evaluation requests.".

:Asset a owl:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset that is the target of the evaluation request.".

:Time a owl:Class ;
  rdfs:label "Request Time" ;
  rdfs:comment "The time when the evaluation request was issued.".

:Weekday a owl:Class ;
  rdfs:label "Weekday" ;
  rdfs:comment "A day of the week.".

:Location a owl:Class ;
  rdfs:label "Request Location" ;
  rdfs:comment "The location from which the evaluation request was issued.".

:EU a owl:Class ;
  rdfs:label "European Union" ;
  rdfs:comment "The geographical region where the request originates.".

:RequestCapability a owl:Class ;
  rdfs:label "Request Capability" ;
  rdfs:comment "Additional contextual information that can be included in the evaluation request to further constrain it.".

:hasAction a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :Action ;
  rdfs:label "Has Requested Action" ;
  rdfs:comment "The action that is being requested.".

:hasIssuer a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :Party ;
  rdfs:label "Has Request Issuer" ;
  rdfs:comment "The party issuing the evaluation request.".

:hasTarget a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :Asset ;
  rdfs:label "Has Target Asset" ;
  rdfs:comment "The target asset of the evaluation request.".

:hasTime a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :Time ;
  rdfs:label "Has Request Time" ;
  rdfs:comment "The time when the evaluation request was issued.".

:hasWeekday a owl:ObjectProperty ;
  rdfs:domain :Time ;
  rdfs:range :Weekday ;
  rdfs:label "Has Weekday" ;
  rdfs:comment "The day of the week when the evaluation request was issued.".

:hasLocation a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :Location ;
  rdfs:label "Has Request Location" ;
  rdfs:comment "The location from which the evaluation request was issued.".

:hasEU a owl:ObjectProperty ;
  rdfs:domain :Location ;
  rdfs:range :EU ;
  rdfs:label "Has EU Origin" ;
  rdfs:comment "Indicates whether the location is within the European Union.".

:hasCapability a owl:ObjectProperty ;
  rdfs:domain :Request ;
  rdfs:range :RequestCapability ;
  rdfs:label "Has Request Capability" ;
  rdfs:comment "Additional contextual information that can be included in the evaluation request.".