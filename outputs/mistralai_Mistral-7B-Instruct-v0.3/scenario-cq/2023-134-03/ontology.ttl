:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "An ontology for Solid apps governance patterns.".

:SolidActor a owl:Class ;
  rdfs:label "Solid Actor" ;
  rdfs:comment "Represents a Solid actor.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Represents a role of a Solid actor.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "Represents a Solid Pod.".

:Infrastructure a owl:Class ;
  rdfs:label "Infrastructure" ;
  rdfs:comment "Represents the Solid infrastructure.".

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "Represents a category of data.".

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Represents a piece of data.".

:DataHandlingPolicy a owl:Class ;
  rdfs:label "Data Handling Policy" ;
  rdfs:comment "Represents a policy for handling data.".

:Maintainer rdf:Property ;
  rdfs:label "Maintainer" ;
  rdfs:comment "Indicates the maintainer of the registry.".

:CreationDate rdf:Property ;
  rdfs:label "Creation Date" ;
  rdfs:comment "Indicates the creation date of the registry.".

:DataCategory rdf:Property ;
  rdfs:label "Data Category" ;
  rdfs:comment "Indicates the category of the data.".

:StorageLocation rdf:Property ;
  rdfs:label "Storage Location" ;
  rdfs:comment "Indicates the location where the data is stored.".

:AssociatedPolicy rdf:Property ;
  rdfs:label "Associated Policy" ;
  rdfs:comment "Indicates the policy associated with the data.".