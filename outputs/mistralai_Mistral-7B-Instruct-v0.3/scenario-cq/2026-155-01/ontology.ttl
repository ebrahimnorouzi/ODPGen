@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

# Scenario-requirement-to-axiom mapping

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "A scientific survey activity performed on a cultural property or feature of interest.".

:InvestigationActivity a owl:Class ;
  rdfs:label "InvestigationActivity" ;
  rdfs:comment "A specific activity within a survey.".

:CulturalProperty a owl:Class ;
  rdfs:label "CulturalProperty" ;
  rdfs:comment "A cultural heritage entity.".

:FeatureOfInterest a owl:Class ;
  rdfs:label "FeatureOfInterest" ;
  rdfs:comment "A specific feature of a cultural property.".

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "An investigation technique adopted in a survey or investigation activity.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A result produced during a survey or investigation activity.".

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "A person with specialized knowledge in a specific field.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A function or position within a survey or investigation activity.".

:EquipmentConfiguration a owl:Class ;
  rdfs:label "EquipmentConfiguration" ;
  rdfs:comment "The combination of hardware, software, and technical settings used in a survey or investigation activity.".

:Interpretation a owl:Class ;
  rdfs:label "Interpretation" ;
  rdfs:comment "A claim or conclusion derived from observations produced during a survey.".

:PostprocessedOutput a owl:Class ;
  rdfs:label "PostprocessedOutput" ;
  rdfs:comment "A result of a post-processing step on an acquisition or observation activity.".

:AcquisitionParameter a owl:Class ;
  rdfs:label "AcquisitionParameter" ;
  rdfs:comment "A characteristic of an acquisition cycle within a survey.".

# Property axioms

:performedOn rdf:Property ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range [ rdf:type owl:Class ; owl:unionOf ( :CulturalProperty, :FeatureOfInterest ) ] ;
  rdfs:label "performedOn" ;
  rdfs:comment "The cultural property or feature of interest on which an investigation activity was performed.".

:adoptedIn rdf:Property ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range :Method ;
  rdfs:label "adoptedIn" ;
  rdfs:comment "The method adopted in a specific investigation activity.".

:producedDuring rdf:Property ;
  rdfs:domain :InvestigationActivity ;
  rdfs:range :Observation ;
  rdfs:label "producedDuring" ;
  rdfs:comment "The observations produced during a specific investigation activity.".