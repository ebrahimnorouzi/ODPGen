@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "RDB Access Control Ontology" ;
  rdfs:comment "An ontology for securing access to a relational database.".

# Scenario-requirement-to-axiom mapping:
:RelationalDatabase a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "Represents a relational database as a first-class schema entity.".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "Represents a database instance.".

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "Represents a table belonging to a database.".

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "Represents a column belonging to a table.".

:PrimaryKey a owl:ObjectProperty ;
  rdfs:label "Primary Key" ;
  rdfs:comment "Represents primary-key relationships in the schema.".

:ForeignKey a owl:ObjectProperty ;
  rdfs:label "Foreign Key" ;
  rdfs:comment "Represents foreign-key relationships.".

:SameNamedColumn a owl:ObjectProperty ;
  rdfs:label "Same-Named Column" ;
  rdfs:comment "Distinguishes same-named columns across different tables when they are not semantically linked.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "Defines a policy for a specific agent.".

:ReadAction a owl:ObjectProperty ;
  rdfs:label "Read Action" ;
  rdfs:comment "Specifies a high-level read action.".

:ModifyAction a owl:ObjectProperty ;
  rdfs:label "Modify Action" ;
  rdfs:comment "Specifies a high-level modify action.".

:ViewActionScope a owl:ObjectProperty ;
  rdfs:label "View Action Scope" ;
  rdfs:comment "Specifies a view action scope for read operations.".

:ProcessActionScope a owl:ObjectProperty ;
  rdfs:label "Process Action Scope" ;
  rdfs:comment "Specifies a process action scope for read operations.".

:TableLevelPolicy a owl:Class ;
  rdfs:label "Table Level Policy" ;
  rdfs:comment "Defines a policy at table level.".

:ColumnLevelPolicy a owl:Class ;
  rdfs:label "Column Level Policy" ;
  rdfs:comment "Defines a policy at column level.".

:RowLevelPolicy a owl:Class ;
  rdfs:label "Row Level Policy" ;
  rdfs:comment "Defines a policy at row level using conditions.".

:ProhibitedModifyAction a owl:ObjectProperty ;
  rdfs:label "Prohibited Modify Action" ;
  rdfs:comment "Expresses a prohibited modify action on a table.".

:TableReadProhibition a owl:Class ;
  rdfs:label "Table Read Prohibition" ;
  rdfs:comment "Expresses a table-level read prohibition for processing.".