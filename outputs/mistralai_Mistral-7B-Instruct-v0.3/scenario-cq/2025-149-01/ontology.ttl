@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "RDB Access Control Ontology" ;
  rdfs:comment "An ontology for representing and reasoning about access control policies for relational databases.".

# Scenario-requirement-to-axiom mapping:
:RelationalDatabase a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A first-class schema entity representing a relational database.".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A class for grouping tables.".

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "A class for representing tables in a database.".

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "A class for representing columns in a table.".

:PrimaryKey a owl:ObjectProperty ;
  rdfs:label "Primary Key" ;
  rdfs:comment "A property for representing primary-key relationships in the schema.".

:ForeignKey a owl:ObjectProperty ;
  rdfs:label "Foreign Key" ;
  rdfs:comment "A property for representing foreign-key relationships.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A class for defining access control policies.".

:ReadAction a owl:ObjectProperty ;
  rdfs:label "Read Action" ;
  rdfs:comment "A property for specifying a high-level read action.".

:ModifyAction a owl:ObjectProperty ;
  rdfs:label "Modify Action" ;
  rdfs:comment "A property for specifying a high-level modify action.".

:ViewActionScope a owl:ObjectProperty ;
  rdfs:label "View Action Scope" ;
  rdfs:comment "A property for specifying a view action scope for read operations.".

:ProcessActionScope a owl:ObjectProperty ;
  rdfs:label "Process Action Scope" ;
  rdfs:comment "A property for specifying a process action scope for read operations.".

:TableLevelPolicy a owl:Class ;
  rdfs:label "Table Level Policy" ;
  rdfs:comment "A class for policies defined at table level.".

:ColumnLevelPolicy a owl:Class ;
  rdfs:label "Column Level Policy" ;
  rdfs:comment "A class for policies defined at column level.".

:RowLevelPolicy a owl:Class ;
  rdfs:label "Row Level Policy" ;
  rdfs:comment "A class for policies defined at row level using conditions.".

:ProhibitedModifyAction a owl:ObjectProperty ;
  rdfs:label "Prohibited Modify Action" ;
  rdfs:comment "A property for expressing a prohibited modify action on a table.".

:ReadProhibitionForProcessing a owl:ObjectProperty ;
  rdfs:label "Table-level Read Prohibition for Processing" ;
  rdfs:comment "A property for expressing a table-level read prohibition for processing.".

:ReadProhibitionForViewing a owl:ObjectProperty ;
  rdfs:label "Table-level Read Prohibition for Viewing" ;
  rdfs:comment "A property for expressing a table-level read prohibition for viewing.".