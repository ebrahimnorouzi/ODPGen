@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Persistent Identifier Ontology" ;
  rdfs:comment "An ontology for managing persistent identifiers across various domains.".

:PersistentIdentifier a owl:Class ;
  rdfs:label "Persistent Identifier" ;
  rdfs:comment "A unique identifier that dynamically resolves to a specific entity.".

:CurrentReferent a owl:ObjectProperty ;
  domain :PersistentIdentifier ;
  range :Entity ;
  rdfs:label "Current Referent" ;
  rdfs:comment "The entity currently referenced by the persistent identifier.".

:PastReferent a owl:ObjectProperty ;
  domain :PersistentIdentifier ;
  range :Entity ;
  rdfs:label "Past Referent" ;
  rdfs:comment "The entity referenced by the persistent identifier at a past timestamp.".

:TransitionTime a owl:DatatypeProperty ;
  domain :Transition ;
  range xsd:dateTime ;
  rdfs:label "Transition Time" ;
  rdfs:comment "The timestamp when a referent transition occurred.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation associated with a specific referent.".

:hasObservation a owl:ObjectProperty ;
  domain :Entity ;
  range :Observation ;
  rdfs:label "Has Observation" ;
  rdfs:comment "The observations associated with a specific entity.".

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "A transition between two referents of a persistent identifier.".

:Predecessor a owl:ObjectProperty ;
  domain :Transition ;
  range :Entity ;
  rdfs:label "Predecessor" ;
  rdfs:comment "The predecessor referent in a transition.".

:Successor a owl:ObjectProperty ;
  domain :Transition ;
  range :Entity ;
  rdfs:label "Successor" ;
  rdfs:comment "The successor referent in a transition.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "The rule that triggered a specific transition.".

:TriggeredBy a owl:ObjectProperty ;
  domain :Transition ;
  range :Rule ;
  rdfs:label "Triggered By" ;
  rdfs:comment "The rule that triggered a specific transition.".

:Gap a owl:Class ;
  rdfs:label "Gap" ;
  rdfs:comment "A gap in the sequence of referents over time.".

:Overlap a owl:Class ;
  rdfs:label "Overlap" ;
  rdfs:comment "An overlap in the sequence of referents over time.".

:Context a owl:Class ;
  rdfs:label "Context" ;
  rdfs:comment "The complete context for a specific time point.".

:AtTime a owl:ObjectProperty ;
  domain :Context ;
  range xsd:dateTime ;
  rdfs:label "At Time" ;
  rdfs:comment "The timestamp for a specific context.".

:Contains a owl:ObjectProperty ;
  domain :Context ;
  range :Entity ;
  rdfs:label "Contains" ;
  rdfs:comment "The entities contained in a specific context.".