@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "An ontology for representing ODRL policies and their evaluation.".

# Scenario-requirement-to-axiom mapping
:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "A digital item subject to an ODRL policy.".

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "An entity involved in an ODRL policy.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "An operation that can be performed on an asset.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An occurrence of an action or a rule exercise.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "A condition in an ODRL policy.".

:Payment a owl:Class ;
  rdfs:label "Payment" ;
  rdfs:comment "A financial transaction related to an ODRL policy.".

# CQ-to-axiom mapping
:CurrentTime rdf:Property ;
  rdfs:label "Current Time" ;
  rdfs:comment "The current point in time.".

:Location rdf:Property ;
  rdfs:label "Location" ;
  rdfs:comment "The geographical position of a party.".

:hasAsset owl:ObjectProperty ;
  rdfs:label "Has Asset" ;
  rdfs:comment "A party or a rule has an asset.".

:hasParty owl:ObjectProperty ;
  rdfs:label "Has Party" ;
  rdfs:comment "A policy has a party.".

:performedAction owl:ObjectProperty ;
  rdfs:label "Performed Action" ;
  rdfs:comment "A party or an event performed an action.".

:exercisedRule owl:ObjectProperty ;
  rdfs:label "Exercised Rule" ;
  rdfs:comment "An event exercised a rule.".

:hasEvent owl:ObjectProperty ;
  rdfs:label "Has Event" ;
  rdfs:comment "A rule or a party has an event.".

:hasRecipient owl:ObjectProperty ;
  rdfs:label "Has Recipient" ;
  rdfs:comment "A rule has a recipient or a category of recipients.".

:hasPayment owl:ObjectProperty ;
  rdfs:label "Has Payment" ;
  rdfs:comment "A party or an event has a payment.".

:amount xsd:decimal ;
  rdfs:label "Amount" ;
  rdfs:comment "The monetary value of a payment.".

# Intentionally excluded concepts:
- No scenario concepts were explicitly left out as they are all necessary for answering the CQs.