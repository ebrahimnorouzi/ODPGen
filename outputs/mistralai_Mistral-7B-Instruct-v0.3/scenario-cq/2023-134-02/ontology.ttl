:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "An ontology for governing Solid apps and their data.".

:SolidActor a owl:Class ;
  rdfs:label "Solid Actor" ;
  rdfs:comment "Represents a Solid actor, such as a user or an app.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Represents the role of a Solid actor.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "Represents a Solid Pod.".

:Infrastructure a owl:Class ;
  rdfs:label "Infrastructure" ;
  rdfs:comment "Represents the Solid infrastructure.".

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "Represents a category of data.".

:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "Represents the data handling practices of a Pod or an app.".

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "Represents the privacy policy of a Solid actor.".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "Represents a log entry.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Represents an action performed on data.".

:Interaction a owl:Class ;
  rdfs:label "Interaction" ;
  rdfs:comment "Represents an interaction between a Solid actor and data.".

:Provider a owl:Class ;
  rdfs:label "Provider" ;
  rdfs:comment "Represents the provider of a Pod or an app.".

:PublishTime a xsd:dateTime ;
  rdfs:label "Publish Time" ;
  rdfs:comment "Represents the time when a log was published.".

:Location a xsd:string ;
  rdfs:label "Location" ;
  rdfs:comment "Represents the location where data is stored.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "Represents a Solid app.".

:GeneratedBy a owl:ObjectProperty ;
  rdfs:label "Generated By" ;
  rdfs:comment "Indicates the entity that generated a log.".

:PerformedOn a owl:ObjectProperty ;
  rdfs:label "Performed On" ;
  rdfs:comment "Indicates the data on which an action was performed.".

:PublishedBy a owl:ObjectProperty ;
  rdfs:label "Published By" ;
  rdfs:comment "Indicates the entity that published a log.".

:HasRole a owl:ObjectProperty ;
  rdfs:label "Has Role" ;
  rdfs:comment "Indicates the role of a Solid actor.".

:Provides a owl:ObjectProperty ;
  rdfs:label "Provides" ;
  rdfs:comment "Indicates the provider of a Pod or an app.".

:HandlesData a owl:ObjectProperty ;
  rdfs:label "Handles Data" ;
  rdfs:comment "Indicates the data handling practices of a Pod or an app.".

:HasPrivacyPolicy a owl:ObjectProperty ;
  rdfs:label "Has Privacy Policy" ;
  rdfs:comment "Indicates the privacy policy of a Solid actor.".

:StoresData a owl:ObjectProperty ;
  rdfs:label "Stores Data" ;
  rdfs:comment "Indicates the location where data is stored.".