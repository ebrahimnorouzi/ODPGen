:Ontology a owl:Ontology ;
  rdfs:label "Maritime Ships Ontology" ;
  rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "Represents a ship.".

:Identifier a owl:ObjectProperty ;
  rdfs:label "Identifier" ;
  rdfs:comment "Identifies a ship.".

:Dimensions a owl:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "Describes the dimensions of a ship.".

:Length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "The length of a ship.".

:Width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "The width of a ship.".

:Height a owl:DatatypeProperty ;
  rdfs:label "Height" ;
  rdfs:comment "The height of a ship.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Represents the typical location of a ship.".

:Latitude a owl:DatatypeProperty ;
  rdfs:label "Latitude" ;
  rdfs:comment "The latitude of a ship.".

:Longitude a owl:DatatypeProperty ;
  rdfs:label "Longitude" ;
  rdfs:comment "The longitude of a ship.".

:Owner a owl:ObjectProperty ;
  rdfs:label "Owner" ;
  rdfs:comment "The owner of a ship.".

:AverageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "The average speed over ground of a ship.".

:Flag a owl:Class ;
  rdfs:label "Flag" ;
  rdfs:comment "Represents the flag under which a ship is registered.".

:ContainerShip a owl:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "A container ship.".

:GPSAntennaPlacement a owl:ObjectProperty ;
  rdfs:label "GPS Antenna Placement" ;
  rdfs:comment "The placement of the GPS antenna on a ship.".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "Represents an organization.".

:Route a owl:Class ;
  rdfs:label "Route" ;
  rdfs:comment "Represents a ship route.".

:TrajectoryPart a owl:Class ;
  rdfs:label "Trajectory Part" ;
  rdfs:comment "Represents a part of a ship trajectory.".

:TrajectoryType a owl:Enum ;
  rdfs:label "Trajectory Type" ;
  rdfs:comment "Distinguishes types of trajectories.".
  :TrajectoryType "Linear" ;
  :TrajectoryType "Circular" ;
  :TrajectoryType "Random".

:Draught a owl:DatatypeProperty ;
  rdfs:label "Draught" ;
  rdfs:comment "The draught of a ship.".

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "Represents an engine.".

:EngineType a owl:Enum ;
  rdfs:label "Engine Type" ;
  rdfs:comment "Distinguishes types of engines.".
  :EngineType "Diesel" ;
  :EngineType "Electric" ;
  :EngineType "Steam" ;
  :EngineType "Gas".