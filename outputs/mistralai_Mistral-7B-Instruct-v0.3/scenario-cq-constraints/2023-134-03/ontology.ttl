:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Ontology" ;
  rdfs:comment "An ontology for describing governance patterns in Solid apps.".

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "A person or entity involved in the Solid ecosystem.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A personal online data store in the Solid ecosystem.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "An application running in the Solid ecosystem.".

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A repository of information about Solid actors, Pods, and Apps.".

:Maintainer rdf:type owl:ObjectProperty ;
  rdfs:domain :Actor ;
  rdfs:range :Registry ;
  rdfs:label "Maintainer" ;
  rdfs:comment "The actor responsible for maintaining the registry.".

:CreationDate a owl:DatatypeProperty ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date ;
  rdfs:label "Creation Date" ;
  rdfs:comment "The date the registry was created or last updated.".

:DataCategory rdf:type owl:ObjectProperty ;
  rdfs:domain :Pod ;
  rdfs:range :DataCategory ;
  rdfs:label "Data Category" ;
  rdfs:comment "The type of data available in the Pod.".

:DataLocation rdf:type owl:ObjectProperty ;
  rdfs:domain :Pod ;
  rdfs:range xsd:string ;
  rdfs:label "Data Location" ;
  rdfs:comment "The location where a specific type of data is stored in the Pod.".

:Policy rdf:type owl:ObjectProperty ;
  rdfs:domain :Pod ;
  rdfs:range :Policy ;
  rdfs:label "Policy" ;
  rdfs:comment "The policy associated with the data in the Pod.".