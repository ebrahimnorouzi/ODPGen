@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Solid Data Governance Ontology" ;
    rdfs:comment "An ontology for governing data in Solid apps.".

:SolidActor a owl:Class ;
    rdfs:label "Solid Actor" ;
    rdfs:comment "Represents a Solid actor, such as a user or a Pod provider.".

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "Represents the role of a Solid actor.".

:Registry a owl:Class ;
    rdfs:label "Registry" ;
    rdfs:comment "Represents a registry of Solid data.".

:DataCategory a owl:Class ;
    rdfs:label "Data Category" ;
    rdfs:comment "Represents a category of data available in Solid Pods.".

:Data a owl:Class ;
    rdfs:label "Data" ;
    rdfs:comment "Represents a piece of data stored in a Solid Pod.".

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "Represents the location of a piece of data in a Solid Pod.".

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "Represents the privacy policy associated with a piece of data.".

:maintainer rdf:property ;
    rdfs:domain :SolidActor ;
    rdfs:range :SolidActor ;
    rdfs:label "Maintainer" ;
    rdfs:comment "The Solid actor maintaining the registry.".

:creationDate rdf:property ;
    rdfs:domain :Registry ;
    rdfs:range xsd:date ;
    rdfs:label "Creation Date" ;
    rdfs:comment "The date the registry was created or updated.".

:dataCategory rdf:property ;
    rdfs:domain :Data ;
    rdfs:range :DataCategory ;
    rdfs:label "Data Category" ;
    rdfs:comment "The category of the data.".

:location rdf:property ;
    rdfs:domain :Data ;
    rdfs:range :Location ;
    rdfs:label "Location" ;
    rdfs:comment "The location of the data in the Solid Pod.".

:policy rdf:property ;
    rdfs:domain :Data ;
    rdfs:range :Policy ;
    rdfs:label "Policy" ;
    rdfs:comment "The privacy policy associated with the data.".