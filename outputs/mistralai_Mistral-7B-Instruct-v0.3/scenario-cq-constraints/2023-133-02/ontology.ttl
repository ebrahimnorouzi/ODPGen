@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "kHealth-Asthma Ontology" ;
    rdfs:comment "An ontology for modeling asthma symptoms, medication intake, and outdoor environmental allergens in the kHealth-Asthma project.".

:AsthmaPatient a owl:Class ;
    rdfs:label "Asthma Patient" ;
    rdfs:comment "A person suffering from asthma.".

:Symptom a owl:Class ;
    rdfs:label "Symptom" ;
    rdfs:comment "A health condition experienced by an asthma patient.".

:Medication a owl:Class ;
    rdfs:label "Medication" ;
    rdfs:comment "A drug used to treat asthma symptoms.".

:Environment a owl:Class ;
    rdfs:label "Environment" ;
    rdfs:comment "The outdoor environment where the asthma patient is located.".

:Allergen a owl:Class ;
    rdfs:label "Allergen" ;
    rdfs:comment "A substance that triggers an asthma symptom.".

:Pollen a :Allergen ;
    rdfs:label "Pollen" ;
    rdfs:comment "Outdoor pollen that can trigger asthma symptoms.".

:AQI a :Allergen ;
    rdfs:label "Air Quality Index" ;
    rdfs:comment "A measure of the quality of the air in the outdoor environment.".

:CausalRelation a owl:ObjectProperty ;
    rdfs:domain [ a :AsthmaPatient ; owl:intersectionOf ( :Symptom owl:union :Medication owl:union :Environment ) ] ;
    rdfs:range :CausalEffect ;
    rdfs:label "Causal Relation" ;
    rdfs:comment "A relation between an asthma patient, a symptom, medication, or environment feature and a causal effect.".

:CausalEffect a owl:Class ;
    rdfs:label "Causal Effect" ;
    rdfs:comment "The effect of a causal relation between an asthma patient, a symptom, medication, or environment feature.".

:EffectWeight a xsd:decimal ;
    rdfs:label "Effect Weight" ;
    rdfs:comment "The weight of the effect of a causal relation.".