@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Persistent Identifier Ontology" ;
  rdfs:comment "An ontology for modeling persistent identifiers and their temporal bindings.".

:PersistentIdentifier a owl:Class ;
  rdfs:label "Persistent Identifier" ;
  rdfs:comment "A unique identifier that dynamically resolves to a specific entity over time.".

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "The entity that a persistent identifier currently or previously referred to.".

:TemporalBinding a owl:Class ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "The association between a persistent identifier and a referent at a specific point in time.".

:hasReferent rdf:property ;
  rdfs:domain :PersistentIdentifier ;
  rdfs:range :Referent ;
  rdfs:label "Has Referent" ;
  rdfs:comment "The referent that a persistent identifier currently or previously referred to.".

:hasTemporalBinding rdf:property ;
  rdfs:domain :Referent ;
  rdfs:range :TemporalBinding ;
  rdfs:label "Has Temporal Binding" ;
  rdfs:comment "The temporal binding associated with a referent.".

:hasStartTime rdf:property ;
  rdfs:domain :TemporalBinding ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Has Start Time" ;
  rdfs:comment "The start time of a temporal binding.".

:hasEndTime rdf:property ;
  rdfs:domain :TemporalBinding ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Has End Time" ;
  rdfs:comment "The end time of a temporal binding.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation associated with a specific referent.".

:hasObservation rdf:property ;
  rdfs:domain :Referent ;
  rdfs:range :Observation ;
  rdfs:label "Has Observation" ;
  rdfs:comment "The observations associated with a specific referent.".

:TransitionRule a owl:Class ;
  rdfs:label "Transition Rule" ;
  rdfs:comment "The rule that triggered a referent transition.".

:hasTransitionRule rdf:property ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :TransitionRule ;
  rdfs:label "Has Transition Rule" ;
  rdfs:comment "The transition rule that triggered a referent transition.".