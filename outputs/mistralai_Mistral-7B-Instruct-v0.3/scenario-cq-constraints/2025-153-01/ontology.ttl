:Ontology a owl:Ontology ;
  rdfs:label "Persistent Identifier Ontology" ;
  rdfs:comment "An ontology for modeling persistent identifiers and their temporal bindings.".

:PI a owl:Class ;
  rdfs:label "Persistent Identifier" ;
  rdfs:comment "A unique identifier that dynamically resolves to a specific entity over time.".

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "The entity that a persistent identifier currently or previously referred to.".

:TemporalBinding a owl:ObjectProperty ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "The relationship between a persistent identifier and a specific referent at a given timestamp." ;
  domain :PI ;
  range :Referent ;
  owl:inverseOf :ResolvedBy.

:ResolvedBy a owl:ObjectProperty ;
  rdfs:label "Resolved By" ;
  rdfs:comment "The relationship between a referent and the persistent identifier that currently or previously referred to it." ;
  domain :Referent ;
  range :PI ;
  owl:inverseOf :TemporalBinding.

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation associated with a specific referent.".

:HasObservation a owl:ObjectProperty ;
  rdfs:label "Has Observation" ;
  rdfs:comment "The relationship between a referent and an observation associated with it." ;
  domain :Referent ;
  range :Observation.

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "A change in the referent associated with a persistent identifier.".

:Triggers a owl:ObjectProperty ;
  rdfs:label "Triggers" ;
  rdfs:comment "The relationship between a transition and the rules that triggered it." ;
  domain :Transition ;
  range rdf:PlainLiteral.

:Gap a owl:Class ;
  rdfs:label "Gap" ;
  rdfs:comment "A period during which a persistent identifier did not have a valid referent.".

:Overlap a owl:Class ;
  rdfs:label "Overlap" ;
  rdfs:comment "A period during which multiple persistent identifiers referred to the same referent.".

:Context a owl:Class ;
  rdfs:label "Context" ;
  rdfs:comment "The complete information about a specific time point, including all persistent identifiers, their referents, observations, and transitions.".

:HasContext a owl:ObjectProperty ;
  rdfs:label "Has Context" ;
  rdfs:comment "The relationship between a specific time point and its associated context." ;
  domain xsd:dateTime ;
  range :Context.