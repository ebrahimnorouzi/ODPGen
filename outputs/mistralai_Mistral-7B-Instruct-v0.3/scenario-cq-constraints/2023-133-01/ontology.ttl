@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Sprinkler Use Case" ;
    rdfs:comment "An ontology for the sprinkler use case, modeling causal relations between events.".

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Abstract class for events.".

:RainySeason a :Event ;
    rdfs:label "Rainy Season" ;
    rdfs:comment "Event representing the rainy season.".

:SprinklerOn a :Event ;
    rdfs:label "Sprinkler On" ;
    rdfs:comment "Event representing the sprinkler being on.".

:Raining a :Event ;
    rdfs:label "Raining" ;
    rdfs:comment "Event representing it is raining.".

:PavementWet a :Event ;
    rdfs:label "Pavement Wet" ;
    rdfs:comment "Event representing the pavement is wet.".

:PavementSlippery a :Event ;
    rdfs:label "Pavement Slippery" ;
    rdfs:comment "Event representing the pavement is slippery.".

:CausalRelation a owl:ObjectProperty ;
    rdfs:domain :Event ;
    rdfs:range :Event ;
    rdfs:label "Causal Relation" ;
    rdfs:comment "Property for causal relations between events.".

:EffectWeight a xsd:decimal ;
    rdfs:label "Effect Weight" ;
    rdfs:comment "Data type for effect weights.".

:Mediation a :Event ;
    rdfs:label "Mediation" ;
    rdfs:comment "Event representing the mediation between two other events.".

:RainCausesPavementWet a :CausalRelation ;
    :effectWeight xsd:decimal "0.6" ;
    rdfs:label "Rain Causes Pavement Wet" ;
    rdfs:comment "Causal relation between rain and pavement being wet.".

:PavementWetCausesPavementSlippery a :CausalRelation ;
    rdfs:label "Pavement Wet Causes Pavement Slippery" ;
    rdfs:comment "Causal relation between pavement being wet and pavement being slippery.".