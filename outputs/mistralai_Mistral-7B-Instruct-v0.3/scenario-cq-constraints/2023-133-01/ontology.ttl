:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case" ;
  rdfs:comment "An ontology for the sprinkler use case, modeling causal relations between events and their effects.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Abstract class for events.".

:RainySeason a :Event ;
  rdfs:label "Rainy Season" ;
  rdfs:comment "Event representing the rainy season.".

:SprinklerOn a :Event ;
  rdfs:label "Sprinkler On" ;
  rdfs:comment "Event representing the sprinkler being on.".

:Raining a :Event ;
  rdfs:label "Raining" ;
  rdfs:comment "Event representing it is raining.".

:PavementWet a :Event ;
  rdfs:label "Pavement Wet" ;
  rdfs:comment "Event representing the pavement is wet.".

:PavementSlippery a :Event ;
  rdfs:label "Pavement Slippery" ;
  rdfs:comment "Event representing the pavement is slippery.".

:Causes a owl:ObjectProperty ;
  rdfs:domain :Event ;
  rdfs:range :Event ;
  rdfs:label "Causes" ;
  rdfs:comment "Property for causal relations between events.".

:EffectWeight a xsd:decimal ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "Datatype for effect weights.".

:MediatedBy a owl:ObjectProperty ;
  rdfs:domain :Event ;
  rdfs:range :Event ;
  rdfs:label "Mediated By" ;
  rdfs:comment "Property for events that mediate causal relations.".

:NotWet a :Event ;
  rdfs:label "Pavement Not Wet" ;
  rdfs:comment "Event representing the pavement is not wet.".

:NoEffect a :Event ;
  rdfs:label "No Effect" ;
  rdfs:comment "Event representing no effect on the pavement being slippery.".

:RainySeason causes :Raining ;
  :Causes rdfs:subPropertyOf :Causes ;
  :Raining :Causes :PavementWet ;
  :PavementWet :Causes :PavementSlippery ;
  :SprinklerOn :Causes :Raining ;
  :Raining :MediatedBy :PavementWet ;
  :PavementNotWet a :Event ;
  :PavementNotWet :MediatedBy :NoEffect ;
  :NoEffect rdfs:subClassOf :Event.