:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "An ontology for modeling evaluation requests with temporal, spatial, role, and request-capability context.".

:Request a owl:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "A formal description of a requested action by an assignee on a target asset.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "The requested action on a target asset.".

:Assignee a owl:Class ;
  rdfs:label "Assignee" ;
  rdfs:comment "The party issuing the evaluation request.".

:Employee a owl:Class ;
  rdfs:label "Employee" ;
  rdfs:comment "An employee of the organization.".

:TargetAsset a owl:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset that is the target of the evaluation request.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "The time when the evaluation request was issued.".

:Weekday a owl:Class ;
  rdfs:label "Weekday" ;
  rdfs:comment "A day of the week.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "The spatial location from which the request is made.".

:EU a owl:Class ;
  rdfs:label "EU" ;
  rdfs:comment "The European Union.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "The role of the assignee.".

:RequestCapability a owl:Class ;
  rdfs:label "Request Capability" ;
  rdfs:comment "Additional contextual information that can be included in the evaluation request.".

:hasAction a owl:ObjectProperty ;
  rdfs:label "hasAction" ;
  rdfs:comment "The action requested on the target asset.".
  domain :Request ;
  range :Action.

:hasAssignee a owl:ObjectProperty ;
  rdfs:label "hasAssignee" ;
  rdfs:comment "The assignee who issued the evaluation request.".
  domain :Request ;
  range :Assignee.

:hasTargetAsset a owl:ObjectProperty ;
  rdfs:label "hasTargetAsset" ;
  rdfs:comment "The target asset of the evaluation request.".
  domain :Request ;
  range :TargetAsset.

:hasTime a owl:ObjectProperty ;
  rdfs:label "hasTime" ;
  rdfs:comment "The time when the evaluation request was issued.".
  domain :Request ;
  range :Time.

:hasWeekday a owl:ObjectProperty ;
  rdfs:label "hasWeekday" ;
  rdfs:comment "The day of the week when the evaluation request was issued.".
  domain :Time ;
  range :Weekday.

:hasLocation a owl:ObjectProperty ;
  rdfs:label "hasLocation" ;
  rdfs:comment "The location from which the evaluation request was made.".
  domain :Request ;
  range :Location.

:hasRole a owl:ObjectProperty ;
  rdfs:label "hasRole" ;
  rdfs:comment "The role of the assignee.".
  domain :Assignee ;
  range :Role.

:hasRequestCapability a owl:ObjectProperty ;
  rdfs:label "hasRequestCapability" ;
  rdfs:comment "Additional contextual information that can be included in the evaluation request.".
  domain :Request ;
  range :RequestCapability.

:isEmployee a owl:ObjectProperty ;
  rdfs:label "isEmployee" ;
  rdfs:comment "Indicates whether an individual is an employee.".