@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Solid Data Governance Ontology" ;
    rdfs:comment "An ontology for governing data in Solid apps.".

:Action rdf:type owl:Enum ;
    rdfs:label "Action" ;
    rdfs:comment "Enumeration of actions performed on data." ;
    owl:value :Create ;
    owl:value :Update ;
    owl:value :Erase.

:Entity rdf:type owl:Class ;
    rdfs:label "Entity" ;
    rdfs:comment "Represents any actor or system in the Solid ecosystem.".

:InteractingEntity rdf:type owl:ObjectProperty ;
    rdfs:domain :Log ;
    rdfs:range :Entity ;
    rdfs:label "Interacting Entity" ;
    rdfs:comment "The entity interacting with the data.".

:PublishingEntity rdf:type owl:ObjectProperty ;
    rdfs:domain :Log ;
    rdfs:range :Entity ;
    rdfs:label "Publishing Entity" ;
    rdfs:comment "The entity publishing the log.".

:Data rdf:type owl:Class ;
    rdfs:label "Data" ;
    rdfs:comment "Represents any piece of data in a Solid Pod.".

:StoredIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Data ;
    rdfs:range :Pod ;
    rdfs:label "Stored In" ;
    rdfs:comment "The Pod where the data is stored.".

:Pod rdf:type owl:Class ;
    rdfs:label "Pod" ;
    rdfs:comment "Represents a Solid Pod.".

:Application rdf:type owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "Represents a Solid application or service.".

:GeneratedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Data ;
    rdfs:range :Application ;
    rdfs:label "Generated By" ;
    rdfs:comment "The application or service that generated the data.".

:Log rdf:type owl:Class ;
    rdfs:label "Log" ;
    rdfs:comment "Represents a log entry recording data access or modification.".

:Issued rdf:type owl:DatatypeProperty ;
    rdfs:domain :Log ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Issued" ;
    rdfs:comment "The timestamp of the log entry.".

:Where rdf:type owl:ObjectProperty ;
    rdfs:domain :Data ;
    rdfs:range :Pod ;
    rdfs:label "Where" ;
    rdfs:comment "The location of the data within the Pod.".