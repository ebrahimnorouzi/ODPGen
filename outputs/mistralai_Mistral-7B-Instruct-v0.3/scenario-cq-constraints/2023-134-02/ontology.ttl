:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "An ontology for modeling governance patterns in Solid apps.".

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity that interacts with data in a Solid app.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A function or position of an actor in a Solid app.".

:Action a owl:ObjectProperty ;
  rdfs:domain :Actor ;
  rdfs:range :ActionType ;
  rdfs:label "Action" ;
  rdfs:comment "The type of action being performed on the data.".

:ActionType rdfs:Class ;
  rdfs:subClassOf xsd:string ;
  rdfs:label "Action Type" ;
  rdfs:comment "The type of action, e.g., create, update, erase.".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "The publisher or the holder of the log.".

:PublishTime a owl:DatatypeProperty ;
  rdfs:domain :Log ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Publish Time" ;
  rdfs:comment "The time when the log was issued.".

:Location a owl:ObjectProperty ;
  rdfs:domain :Data ;
  rdfs:range :LocationType ;
  rdfs:label "Location" ;
  rdfs:comment "The location where the data is being stored.".

:LocationType rdfs:Class ;
  rdfs:subClassOf xsd:string ;
  rdfs:label "Location Type" ;
  rdfs:comment "The type of location, e.g., Pod, external service.".

:App a owl:Class ;
  rdfs:label "App" ;
  rdfs:comment "The application or service generating the data.".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "A record of data interactions in a Solid app.".

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "The data being stored or interacted with in a Solid app.".

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "The storage container for a Solid user's data.".

:DisjointEntities :Pod :App.
  owl:disjointWith :App.
  owl:disjointWith :Pod.
  rdfs:label "Disjoint Entities" ;
  rdfs:comment "Pods and apps are separate entities.".