:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "An ontology for representing ODRL policies and their evaluation for academic research purposes.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "Represents the current time.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Represents the location of a party.".

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Represents an asset that is part of an asset collection in an ODRL policy.".

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "Represents a party that is part of a party collection in an ODRL policy.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Represents an action that has been performed or attempted.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Represents an event that has occurred.".

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "Represents a rule in an ODRL policy.".

:Recipient a owl:Class ;
  rdfs:label "Recipient" ;
  rdfs:comment "Represents a recipient or category of recipients that can receive the result of a rule.".

:FinancialPayment a owl:Class ;
  rdfs:label "FinancialPayment" ;
  rdfs:comment "Represents a financial payment that has been made.".

:HasTime rdf:Property ;
  rdfs:label "hasTime" ;
  rdfs:comment "Relates a time to an event or action.".

:hasLocation rdf:Property ;
  rdfs:label "hasLocation" ;
  rdfs:comment "Relates a location to a party or event.".

:hasAsset rdf:Property ;
  rdfs:label "hasAsset" ;
  rdfs:comment "Relates an asset to an ODRL policy.".

:hasParty rdf:Property ;
  rdfs:label "hasParty" ;
  rdfs:comment "Relates a party to an ODRL policy.".

:performedAction rdf:Property ;
  rdfs:label "performedAction" ;
  rdfs:comment "Relates an action to a party.".

:occurredEvent rdf:Property ;
  rdfs:label "occurredEvent" ;
  rdfs:comment "Relates an event to a party.".

:exercisedRule rdf:Property ;
  rdfs:label "exercisedRule" ;
  rdfs:comment "Relates a rule to an event.".

:hasRecipient rdf:Property ;
  rdfs:label "hasRecipient" ;
  rdfs:comment "Relates a rule to its recipients.".

:hasFinancialPayment rdf:Property ;
  rdfs:label "hasFinancialPayment" ;
  rdfs:comment "Relates a rule to a financial payment.".

:amount rdfs:DatatypeProperty ;
  rdfs:label "amount" ;
  rdfs:comment "Represents the amount of a financial payment.".