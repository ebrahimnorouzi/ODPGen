:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "An ontology for governing Solid apps.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy governing data access in Solid apps.".

:PolicyID a owl:DatatypeProperty ;
  rdfs:label "Policy Identifier" ;
  rdfs:comment "The unique identifier of the policy.".

:Creator a owl:ObjectProperty ;
  rdfs:label "Creator" ;
  rdfs:comment "The creator of the policy.".

:IssueDate a owl:DatatypeProperty ;
  rdfs:label "Issue Date" ;
  rdfs:comment "The date the policy was issued.".

:Assignee a owl:ObjectProperty ;
  rdfs:label "Assignee" ;
  rdfs:comment "The assignee of the policy.".

:App a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "An application or service used to access data.".

:AccessMode a owl:EnumValuedProperty ;
  rdfs:label "Access Mode" ;
  rdfs:comment "The mode of access requested.".
  :AccessMode rdf:type owl:EnumProperty ;
  :AccessMode rdf:value "Read" ;
  :AccessMode rdf:value "Write" ;
  :AccessMode rdf:value "Execute".

:PersonalData a owl:Class ;
  rdfs:label "Personal Data" ;
  rdfs:comment "The personal data being accessed.".

:Purpose a owl:DatatypeProperty ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose for accessing the data.".

:Policy rdf:type owl:FunctionalProperty ;
  rdf:domain :Policy ;
  rdf:range :App ;
  rdfs:label "Applies to" ;
  rdfs:comment "The application or service this policy applies to.".

:Request rdf:type owl:FunctionalProperty ;
  rdf:domain :Policy ;
  rdf:range :AccessMode ;
  rdfs:label "Access Mode Requested" ;
  rdfs:comment "The access mode requested in this policy.".

:Data rdf:type owl:FunctionalProperty ;
  rdf:domain :Policy ;
  rdf:range :PersonalData ;
  rdfs:label "Data Accessed" ;
  rdfs:comment "The personal data being accessed according to this policy.".

:Purpose rdf:type owl:FunctionalProperty ;
  rdf:domain :Policy ;
  rdf:range xsd:string ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose for accessing the data according to this policy.".