@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Cultural Heritage Survey ODP" ;
    rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a owl:Class ;
    rdfs:label "Survey" ;
    rdfs:comment "A scientific survey activity performed on a cultural property." ;
    owl:disjointWith :EquipmentConfiguration.

:InvestigationActivity a owl:Class ;
    rdfs:label "Investigation Activity" ;
    rdfs:comment "A specific activity within a survey." ;
    owl:disjointWith :EquipmentConfiguration.

:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "An investigation technique adopted in a survey or investigation activity." ;
    owl:disjointWith :EquipmentConfiguration.

:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "A result produced during a survey or investigation activity." ;
    owl:disjointWith :EquipmentConfiguration.

:Expert a owl:Class ;
    rdfs:label "Expert" ;
    rdfs:comment "A person with specialized knowledge in a specific field." ;
    owl:disjointWith :EquipmentConfiguration.

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A function or position within a survey or investigation activity." ;

:EquipmentConfiguration a owl:Class ;
    rdfs:label "Equipment Configuration" ;
    rdfs:comment "The hardware, software, and technical configurations used to conduct a specific survey or investigation activity." ;

:Interpretation a owl:Class ;
    rdfs:label "Interpretation" ;
    rdfs:comment "An interpretation or claim supported by the observations produced during a survey." ;

:PostProcessedOutput a owl:Class ;
    rdfs:label "Post-processed Output" ;
    rdfs:comment "A processed output (e.g., interactive images, spectra, datasets) related to the underlying acquisition or observation activities." ;

:AcquisitionParameter a owl:Class ;
    rdfs:label "Acquisition Parameter" ;
    rdfs:comment "Characteristics of a specific photographic acquisition cycle within a survey." ;

:hasSurvey rdf:property ;
    rdfs:label "has Survey" ;
    rdfs:comment "Relates an investigation activity to the survey it belongs to." ;
    owl:domain :InvestigationActivity ;
    owl:range :Survey.

:adoptsMethod rdf:property ;
    rdfs:label "adopts Method" ;
    rdfs:comment "Relates an investigation activity to the method it uses." ;
    owl:domain :InvestigationActivity ;
    owl:range :Method.

:producesObservation rdf:property ;
    rdfs:label "produces Observation" ;
    rdfs:comment "Relates an investigation activity to the observations it produces." ;
    owl:domain :InvestigationActivity ;
    owl:range :Observation.

:participatesIn rdf:property ;
    rdfs:label "participates In" ;
    rdfs:comment "Relates an expert to a survey or investigation activity." ;
    owl:domain :Expert ;
    owl:range :InvestigationActivity.