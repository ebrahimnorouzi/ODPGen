@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Cultural Heritage Survey ODP" ;
    rdfs:comment "Models the structure of scientific survey activities on cultural heritage entities.".

# Survey and Investigation
:Survey a owl:Class ;
    rdfs:label "Survey" ;
    rdfs:comment "A scientific survey activity performed on a cultural property.".

:Investigation a owl:Class ;
    rdfs:label "Investigation" ;
    rdfs:comment "A scientific investigation activity performed on a specific feature of interest.".

:performedOn rdf:Property ;
    rdfs:domain :Survey, :Investigation ;
    rdfs:range :CulturalProperty ;
    rdfs:label "performedOn" ;
    rdfs:comment "The cultural property or feature of interest that the survey or investigation was performed on.".

# Method and Technique
:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "The method or investigation technique adopted in a specific survey or investigation activity.".

:adoptedIn rdf:Property ;
    rdfs:domain :Survey, :Investigation ;
    rdfs:range :Method ;
    rdfs:label "adoptedIn" ;
    rdfs:comment "The method or technique adopted in the survey or investigation activity.".

# Observation
:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "The observations produced during a given survey or investigation activity.".

:producedDuring rdf:Property ;
    rdfs:domain :Observation ;
    rdfs:range :Survey, :Investigation ;
    rdfs:label "producedDuring" ;
    rdfs:comment "The survey or investigation activity that produced the observation.".

# Expert and Role
:Expert a owl:Class ;
    rdfs:label "Expert" ;
    rdfs:comment "The experts who participated in the survey or investigation activity.".

:participatedWith rdf:Property ;
    rdfs:domain :Survey, :Investigation ;
    rdfs:range :Expert ;
    rdfs:label "participatedWith" ;
    rdfs:comment "The expert who participated in the survey or investigation activity.".

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "The role of the expert in the survey or investigation activity.".

# Equipment Configuration
:EquipmentConfiguration a owl:Class ;
    rdfs:label "Equipment Configuration" ;
    rdfs:comment "The hardware, software, and technical configurations used to conduct a specific survey or investigation activity.".

:usedFor rdf:Property ;
    rdfs:domain :Survey, :Investigation ;
    rdfs:range :EquipmentConfiguration ;
    rdfs:label "usedFor" ;
    rdfs:comment "The survey or investigation activity for which the equipment configuration was used.".

# Interpretation
:Interpretation a owl:Class ;
    rdfs:label "Interpretation" ;
    rdfs:comment "The interpretations or claims supported by the observations produced during a survey.".