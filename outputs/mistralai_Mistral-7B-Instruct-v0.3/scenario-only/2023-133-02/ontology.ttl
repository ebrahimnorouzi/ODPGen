@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "An ontology for modeling asthma patients, their symptoms, medication intake, and outdoor environment features, with causal relations and effect weights.".

# Classes
:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A person participating in the kHealth-Asthma project.".

:AsthmaPatient a owl:Class ;
  rdfs:subClassOf [ a owl:Restriction ;
                     rdf:property :age ;
                     xsd:minInclusive "0" ] ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A pediatric asthma patient participating in the kHealth-Asthma project.".

:Symptom a owl:Class ;
  rdfs:label "Symptom" ;
  rdfs:comment "A symptom experienced by an asthma patient.".

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication taken by an asthma patient.".

:EnvironmentFeature a owl:Class ;
  rdfs:label "Environment Feature" ;
  rdfs:comment "An outdoor environmental factor affecting an asthma patient.".

:OutdoorAllergen a owl:Class ;
  rdfs:subClassOf [ a owl:Restriction ;
                     rdf:property :type ;
                     rdf:datatype xsd:string ;
                     owl:hasValue "allergen" ] ;
  rdfs:label "Outdoor Allergen" ;
  rdfs:comment "An outdoor allergen affecting an asthma patient.".

:AirQualityIndex a owl:Class ;
  rdfs:subClassOf [ a owl:Restriction ;
                     rdf:property :type ;
                     rdf:datatype xsd:string ;
                     owl:hasValue "AQI" ] ;
  rdfs:label "Air Quality Index" ;
  rdfs:comment "The air quality index affecting an asthma patient.".

# Properties
:hasAge a owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range xsd:integer ;
  rdfs:label "Age" ;
  rdfs:comment "The age of a person.".

:hasSymptom a owl:ObjectProperty ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Symptom ;
  rdfs:label "Has Symptom" ;
  rdfs:comment "The symptom experienced by an asthma patient.".

:takesMedication a owl:ObjectProperty ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication ;
  rdfs:label "Takes Medication" ;
  rdfs:comment "The medication taken by an asthma patient.".

:hasEnvironmentFeature a owl:ObjectProperty ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :EnvironmentFeature ;
  rdfs:label "Has Environment Feature" ;
  rdfs:comment "The environmental feature affecting an asthma patient.".