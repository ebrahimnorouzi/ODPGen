@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Database Access Control Ontology" ;
  rdfs:comment "This ontology models the access control to a relational database queried via SQL.".

# Classes
:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A relational database.".

:User a owl:Class ;
  rdfs:label "User" ;
  rdfs:comment "A user who queries the database.".

:Query a owl:Class ;
  rdfs:label "SQL Query" ;
  rdfs:comment "A Structured Query Language query.".

:Permission a owl:Class ;
  rdfs:label "Permission" ;
  rdfs:comment "A right to execute a specific query.".

# Object Properties
:queries a owl:ObjectProperty ;
  rdfs:domain :User ;
  rdfs:range :Query ;
  rdfs:label "queries" ;
  rdfs:comment "A user can execute a query.".

:hasPermission a owl:ObjectProperty ;
  rdfs:domain :User ;
  rdfs:range :Permission ;
  rdfs:label "hasPermission" ;
  rdfs:comment "A user has a permission to execute a specific query.".

# Data Properties
:queryId a owl:DatatypeProperty ;
  rdfs:domain :Query ;
  rdfs:range xsd:string ;
  rdfs:label "queryId" ;
  rdfs:comment "The unique identifier of a query.".

:permissionId a owl:DatatypeProperty ;
  rdfs:domain :Permission ;
  rdfs:range xsd:string ;
  rdfs:label "permissionId" ;
  rdfs:comment "The unique identifier of a permission.".

# Axioms
:Database disjoint owl:Thing.
:User disjoint owl:Thing.
:Query disjoint owl:Thing.
:Permission disjoint owl:Thing.

:Permission owl:FunctionalProperty :permissionId.