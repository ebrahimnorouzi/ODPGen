@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Patterns" ;
  rdfs:comment "This ontology models the governance patterns for Solid apps to address identified challenges.".

# Identity and Roles
:SolidActor a owl:Class ;
  rdfs:label "Solid Actor" ;
  rdfs:comment "Represents any entity providing Pods or apps in the Solid ecosystem.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Represents the function or position of a SolidActor.".

:Provides a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; rdfs:label "SolidActor" ] ;
  rdfs:range [ a owl:Class ; rdfs:label "Pod" ; rdfs:label "App" ] ;
  rdfs:label "Provides".

# Solid Infrastructure
:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "Represents a Solid user's data storage container.".

:Specification a owl:Class ;
  rdfs:label "Specification" ;
  rdfs:comment "Represents the version or standard of Solid specification a Pod is running.".

:InstalledFunctionality a owl:Class ;
  rdfs:label "Installed Functionality" ;
  rdfs:comment "Represents the functionalities installed within a Pod.".

# Data Categories
:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "Represents a category of data stored in a Pod.".

:DataExists a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; rdfs:label "DataCategory" ] ;
  rdfs:range [ a owl:Class ; rdfs:label "Pod" ] ;
  rdfs:label "Data Exists".

# Data Handling Practices
:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "Represents the data handling practices of a Pod or app.".

# User Privacy Policies
:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "Represents the privacy preferences and requirements of a Solid user.".

# Provenance Metadata
:ConsentRecord a owl:Class ;
  rdfs:label "Consent Record" ;
  rdfs:comment "Represents the record of user consent for data access or handling.".

:DataAccess a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; rdfs:label "Pod" ] ;
  rdfs:range [ a owl:Class ; rdfs:label "DataAccessEvent" ] ;
  rdfs:label "Data Access".

:DataHandling a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; rdfs:label "Pod" ] ;
  rdfs:range [ a owl:Class ; rdfs:label "DataHandlingEvent" ] ;
  rdfs:label "Data Handling".