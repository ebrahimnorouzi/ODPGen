@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Vessel Ontology" ;
  rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

# Vessel and its properties
:Vessel a owl:Class ;
  rdfs:label "Vessel" ;
  rdfs:comment "Represents a maritime vessel.".

:hasVesselID a owl:ObjectProperty ;
  rdfs:domain :Vessel ;
  rdfs:range xsd:string ;
  rdfs:label "Vessel ID" ;
  rdfs:comment "Unique identifier for a vessel.".

:hasName a owl:ObjectProperty ;
  rdfs:domain :Vessel ;
  rdfs:range xsd:string ;
  rdfs:label "Name" ;
  rdfs:comment "Name of the vessel.".

:hasType a owl:ObjectProperty ;
  rdfs:domain :Vessel ;
  rdfs:range :VesselType ;
  rdfs:label "Type" ;
  rdfs:comment "Type of the vessel.".

:VesselType a owl:Class ;
  rdfs:label "Vessel Type" ;
  rdfs:comment "Represents a type of maritime vessel.".

# Propulsion system
:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "Represents the propulsion system of a vessel.".

:hasPropulsionSystem a owl:ObjectProperty ;
  rdfs:domain :Vessel ;
  rdfs:range :PropulsionSystem ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "The propulsion system of a vessel.".