@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance ODP" ;
  rdfs:comment "This ontology addresses the governance challenges in Solid apps.".

# Identity and Roles
:SolidActor a owl:Class ;
  rdfs:label "Solid Actor" ;
  rdfs:comment "Represents a Solid user or provider.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Represents the function or position of a SolidActor.".

:Provides a owl:ObjectProperty ;
  rdfs:domain :SolidActor ;
  rdfs:range :Pod ;
  rdfs:label "Provides" ;
  rdfs:comment "Indicates that a SolidActor provides a Pod.".

:Uses a owl:ObjectProperty ;
  rdfs:domain :SolidActor ;
  rdfs:range :App ;
  rdfs:label "Uses" ;
  rdfs:comment "Indicates that a SolidActor uses an App.".

# Solid Infrastructure
:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "Represents a Solid Pod.".

:Specification a owl:Class ;
  rdfs:label "Specification" ;
  rdfs:comment "Represents a Solid specification.".

:Runs a owl:ObjectProperty ;
  rdfs:domain :Pod ;
  rdfs:range :Specification ;
  rdfs:label "Runs" ;
  rdfs:comment "Indicates that a Pod runs a specific Solid specification.".

# Data Categories and Access
:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "Represents a category of data in a Pod.".

:ExistsIn a owl:ObjectProperty ;
  rdfs:domain :DataCategory ;
  rdfs:range :Pod ;
  rdfs:label "Exists In" ;
  rdfs:comment "Indicates that a DataCategory exists in a Pod.".

# Data Handling Practices
:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "Represents the practices of a Pod or App regarding data handling.".

:Declares a owl:ObjectProperty ;
  rdfs:domain :Pod ;
  rdfs:range :DataHandlingPractice ;
  rdfs:label "Declares" ;
  rdfs:comment "Indicates that a Pod declares its data handling practices.".

# Privacy Policies and Preferences
:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "Represents the privacy policy of a SolidActor.".

:Expresses a owl:ObjectProperty ;
  rdfs:domain :SolidActor ;
  rdfs:range :PrivacyPolicy ;
  rdfs:label "Expresses" ;
  rdfs:comment "Indicates that a SolidActor expresses its privacy policy.".

# Provenance and Accountability
:Provenance a owl:Class ;
  rdfs:label "Provenance" ;
  rdfs:comment "Represents the provenance metadata for accountability.".