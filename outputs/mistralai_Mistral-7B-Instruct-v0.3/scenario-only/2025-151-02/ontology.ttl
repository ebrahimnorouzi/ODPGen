@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "This ontology represents real-world information aiding the evaluation of ODRL Policies.".

# Intent: Model the concept of a digital media resource with time-based access restrictions.
:DigitalMedia a owl:Class ;
  rdfs:label "Digital Media" ;
  rdfs:comment "Represents a digital media resource.".

:VideoStream a owl:Class ;
  rdfs:subClassOf :DigitalMedia ;
  rdfs:label "Video Stream" ;
  rdfs:comment "Represents a video stream.".

:TimeInterval a owl:Class ;
  rdfs:label "Time Interval" ;
  rdfs:comment "Represents a specific time interval.".

:Minutes a owl:DatatypeProperty ;
  rdfs:domain :TimeInterval ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "Minutes" ;
  rdfs:comment "Represents the number of minutes in a time interval.".

:AccessRight a owl:Class ;
  rdfs:label "Access Right" ;
  rdfs:comment "Represents an access right to a digital media resource.".

:View a owl:ObjectProperty ;
  rdfs:domain :AccessRight ;
  rdfs:range :DigitalMedia ;
  rdfs:label "View" ;
  rdfs:comment "Indicates that the access right allows viewing the digital media resource.".

:TimeRestriction a owl:ObjectProperty ;
  rdfs:domain :AccessRight ;
  rdfs:range :TimeInterval ;
  rdfs:label "Time Restriction" ;
  rdfs:comment "Indicates the time interval during which the access right is valid.".

:AcademicResearchProject a owl:Class ;
  rdfs:label "Academic Research Project" ;
  rdfs:comment "Represents an academic research project.".