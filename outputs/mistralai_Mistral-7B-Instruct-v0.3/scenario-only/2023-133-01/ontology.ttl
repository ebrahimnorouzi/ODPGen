@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "CBN Sprinkler Ontology" ;
  rdfs:comment "This ontology models the causal relationships between events in a sprinkler use case.".

# Classes
:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An occurrence of a specific situation or action.".

:CausalEvent a owl:Class ;
  rdf:subClassOf :Event ;
  rdfs:label "Causal Event" ;
  rdfs:comment "An event that causes another event.".

:MediatedEvent a owl:Class ;
  rdf:subClassOf :CausalEvent ;
  rdfs:label "Mediated Event" ;
  rdfs:comment "A causal event that is mediated by another event.".

:Effect a owl:Class ;
  rdf:subClassOf :Event ;
  rdfs:label "Effect" ;
  rdfs:comment "The result or consequence of a cause.".

:DirectEffect a owl:Class ;
  rdf:subClassOf :Effect ;
  rdfs:label "Direct Effect" ;
  rdfs:comment "An effect that is directly caused by a cause.".

:IndirectEffect a owl:Class ;
  rdf:subClassOf :Effect ;
  rdfs:label "Indirect Effect" ;
  rdfs:comment "An effect that is mediated by another event.".

# Object Properties
:causes a owl:ObjectProperty ;
  rdfs:domain :CausalEvent ;
  rdfs:range :Event ;
  rdfs:label "causes" ;
  rdfs:comment "The event that causes another event.".

:isMediatedBy a owl:ObjectProperty ;
  rdfs:domain :MediatedEvent ;
  rdfs:range :Event ;
  rdfs:label "is mediated by" ;
  rdfs:comment "The event that mediates the causal relationship between two events.".

:hasDirectEffect a owl:ObjectProperty ;
  rdfs:domain :Event ;
  rdfs:range :DirectEffect ;
  rdfs:label "has direct effect" ;
  rdfs:comment "The direct effect of a cause.".

:hasIndirectEffect a owl:ObjectProperty ;
  rdfs:domain :Event ;
  rdfs:range :IndirectEffect ;
  rdfs:label "has indirect effect" ;
  rdfs:comment "The indirect effect of a cause, mediated by another event.".

# Datatype Properties
:hasEffectWeight a owl:DatatypeProperty ;
  rdfs:domain :CausalEvent ;
  rdfs:range xsd:decimal ;
  rdfs:label "has effect weight" ;
  rdfs:comment "The weight of the effect of a causal event.".