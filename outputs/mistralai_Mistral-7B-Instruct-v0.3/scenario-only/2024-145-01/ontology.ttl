@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Legal Tasks and Court Hierarchies" ;
  rdfs:comment "This ontology models legal tasks, court hierarchies, and bad check crime related regulations.".

# Court Hierarchy
:Court a owl:Class ;
  rdfs:label "Court" ;
  rdfs:comment "Represents a court in the legal system.".

:SupremeCourt a :Court ;
  rdfs:label "Supreme Court" ;
  rdfs:comment "The highest court in the legal system.".

:AppellateCourt a owl:Class ;
  rdfs:label "Appellate Court" ;
  rdfs:comment "A court that hears appeals from lower courts.".

:DistrictCourt a owl:Class ;
  rdfs:label "District Court" ;
  rdfs:comment "A court of general jurisdiction in a district.".

:SubCourt a owl:Class ;
  rdfs:label "Sub-Court" ;
  rdfs:comment "A court that operates under a district court.".

:isSubCourtOf a owl:ObjectProperty ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :SubCourt ;
  rdfs:label "isSubCourtOf" ;
  rdfs:comment "Indicates a sub-court that operates under a district court.".

# Legal Tasks
:LegalTask a owl:Class ;
  rdfs:label "Legal Task" ;
  rdfs:comment "Represents a legal task that needs to be performed.".

:CourtCase a :LegalTask ;
  rdfs:label "Court Case" ;
  rdfs:comment "A legal task that involves a court case.".

:Legislation a :LegalTask ;
  rdfs:label "Legislation" ;
  rdfs:comment "A legal task that involves creating or interpreting legislation.".

:Regulation a :LegalTask ;
  rdfs:label "Regulation" ;
  rdfs:comment "A legal task that involves creating or interpreting regulations.".

:BadCheckCrime a :LegalTask ;
  rdfs:label "Bad Check Crime" ;
  rdfs:comment "A legal task related to bad check crimes.".

# Assumptions and Exclusions
- This ontology assumes a hierarchical court system with a Supreme Court, Appellate Courts, District Courts, and Sub-Courts.
- This ontology does not model the specific roles or individuals within the court system.
- This ontology does not model the specific laws, regulations, or court cases that would be handled by the court system.