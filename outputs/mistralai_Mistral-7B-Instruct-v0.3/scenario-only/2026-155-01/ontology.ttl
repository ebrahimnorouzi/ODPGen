@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities on cultural heritage entities.".

# Survey
:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "A scientific survey activity on cultural heritage.".

:hasSurveyID a owl:ObjectProperty ;
  rdfs:domain :Survey ;
  rdfs:range xsd:string ;
  rdfs:label "hasSurveyID" ;
  rdfs:comment "The unique identifier for a survey.".

:hasStartDate a owl:DatatypeProperty ;
  rdfs:domain :Survey ;
  rdfs:range xsd:date ;
  rdfs:label "hasStartDate" ;
  rdfs:comment "The start date of a survey.".

:hasEndDate a owl:DatatypeProperty ;
  rdfs:domain :Survey ;
  rdfs:range xsd:date ;
  rdfs:label "hasEndDate" ;
  rdfs:comment "The end date of a survey.".

# Observation
:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation made during a survey.".

:hasObservationID a owl:ObjectProperty ;
  rdfs:domain :Observation ;
  rdfs:range xsd:string ;
  rdfs:label "hasObservationID" ;
  rdfs:comment "The unique identifier for an observation.".

:hasSurvey a owl:ObjectProperty ;
  rdfs:domain :Observation ;
  rdfs:range :Survey ;
  rdfs:label "hasSurvey" ;
  rdfs:comment "The survey in which the observation was made.".

# Method
:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "A scientific method used in a survey.".

:hasMethodID a owl:ObjectProperty ;
  rdfs:domain :Method ;
  rdfs:range xsd:string ;
  rdfs:label "hasMethodID" ;
  rdfs:comment "The unique identifier for a method.".

:hasSurvey a owl:ObjectProperty ;
  rdfs:domain :Method ;
  rdfs:range :Survey ;
  rdfs:label "hasSurvey" ;
  rdfs:comment "The survey in which the method was used.".

# Equipment Configuration
:EquipmentConfiguration a owl:Class ;
  rdfs:label "Equipment Configuration" ;
  rdfs:comment "A specific arrangement of equipment used in a survey.".

:hasEquipmentConfigurationID a owl:ObjectProperty ;
  rdfs:domain :EquipmentConfiguration ;
  rdfs:range xsd:string ;
  rdfs:label "hasEquipmentConfigurationID" ;
  rdfs:comment "The unique identifier for an equipment configuration.".

:hasSurvey a owl:ObjectProperty ;
  rdfs:domain :EquipmentConfiguration ;
  rdfs:range :Survey ;
  rdfs:label "hasSurvey" ;
  rdfs:comment "The survey in which the equipment configuration was used.".