@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Challenge a owl:Class ;
  rdfs:label "Challenge" ;
  rdfs:comment "Challenge in governance patterns in Solid apps".

:IdentityChallenge a :Challenge ;
  rdfs:label "Identity Challenge" ;
  rdfs:comment "Challenge related to identity of Solid actors and their roles".

:MetadataChallenge a :Challenge ;
  rdfs:label "Metadata Challenge" ;
  rdfs:comment "Challenge related to metadata about Solid infrastructure".

:DataAvailabilityChallenge a :Challenge ;
  rdfs:label "Data Availability Challenge" ;
  rdfs:comment "Challenge related to availability/discovery of categories of data".

:DataHandlingChallenge a :Challenge ;
  rdfs:label "Data Handling Challenge" ;
  rdfs:comment "Challenge related to data handling practices of Pod and app providers".

:PrivacyPolicyChallenge a :Challenge ;
  rdfs:label "Privacy Policy Challenge" ;
  rdfs:comment "Challenge related to users expressing their privacy policies".

:LoggingChallenge a :Challenge ;
  rdfs:label "Logging Challenge" ;
  rdfs:comment "Challenge related to logging or record-keeping in Pods".

:LegalComplianceChallenge a :Challenge ;
  rdfs:label "Legal Compliance Challenge" ;
  rdfs:comment "Challenge related to legal compliance checks in Solid".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "Policy in governance patterns in Solid apps".

:PolicyIdentifier a owl:DatatypeProperty ;
  rdfs:label "Policy Identifier" ;
  rdfs:comment "Unique identifier of the policy" ;
  domain :Policy ;
  range xsd:string.

:PolicyCreator a owl:ObjectProperty ;
  rdfs:label "Policy Creator" ;
  rdfs:comment "Creator of the policy" ;
  domain :Policy ;
  range :Actor.

:PolicyIssueDate a owl:DatatypeProperty ;
  rdfs:label "Policy Issue Date" ;
  rdfs:comment "Date when the policy was issued" ;
  domain :Policy ;
  range xsd:date.

:PolicyAssignee a owl:ObjectProperty ;
  rdfs:label "Policy Assignee" ;
  rdfs:comment "Assignee of the policy" ;
  domain :Policy ;
  range :Actor.

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "Application/service being used to access the data".

:AccessMode a owl:Class ;
  rdfs:label "Access Mode" ;
  rdfs:comment "Access mode being requested".

:PersonalData a owl:Class ;
  rdfs:label "Personal Data" ;
  rdfs:comment "Personal data being accessed".

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "Purpose for accessing the data".

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "Actor in governance patterns in Solid apps".