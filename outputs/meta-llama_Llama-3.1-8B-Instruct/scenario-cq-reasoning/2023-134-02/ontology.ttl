@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Type of action performed on data".

:Create a :Action ;
  rdfs:label "Create" ;
  rdfs:comment "Action of creating data".

:Update a :Action ;
  rdfs:label "Update" ;
  rdfs:comment "Action of updating data".

:Erase a :Action ;
  rdfs:label "Erase" ;
  rdfs:comment "Action of erasing data".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "Entity interacting with data".

:User a :Entity ;
  rdfs:label "User" ;
  rdfs:comment "Entity that is a user".

:Provider a :Entity ;
  rdfs:label "Provider" ;
  rdfs:comment "Entity that is a provider".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "Record of actions performed on data".

:Publish a owl:ObjectProperty ;
  rdfs:label "Publish" ;
  rdfs:comment "Entity publishing the log" ;
  rdfs:domain :Log ;
  rdfs:range :Entity.

:Issue a owl:DatatypeProperty ;
  rdfs:label "Issue" ;
  rdfs:comment "When the log was issued" ;
  rdfs:domain :Log ;
  rdfs:range xsd:date.

:Store a owl:ObjectProperty ;
  rdfs:label "Store" ;
  rdfs:comment "Where the data is being stored" ;
  rdfs:domain :Data ;
  rdfs:range :Location.

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "Application/service generating the data".

:Use a owl:ObjectProperty ;
  rdfs:label "Use" ;
  rdfs:comment "Application/service being used to generate the data" ;
  rdfs:domain :Data ;
  rdfs:range :Application.

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Data being stored".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Location where the data is being stored".

:Governance a owl:Class ;
  rdfs:label "Governance" ;
  rdfs:comment "Governance patterns in Solid apps".

:Privacy a owl:ObjectProperty ;
  rdfs:label "Privacy" ;
  rdfs:comment "Privacy policies and requirements" ;
  rdfs:domain :User ;
  rdfs:range :Governance.

:Consent a owl:ObjectProperty ;
  rdfs:label "Consent" ;
  rdfs:comment "Consent records" ;
  rdfs:domain :User ;
  rdfs:range :Governance.

:Access a owl:ObjectProperty ;
  rdfs:label "Access" ;
  rdfs:comment "Access to data" ;
  rdfs:domain :User ;
  rdfs:range :Governance.

:Change a owl:ObjectProperty ;
  rdfs:label "Change" ;
  rdfs:comment "Changes to data handling policies" ;
  rdfs:domain :Provider ;
  rdfs:range :Governance.

:Compliance a owl:Class ;
  rdfs:label "Compliance" ;
  rdfs:comment "Legal compliance checks".

:Check a owl:ObjectProperty ;
  rdfs:label "Check" ;
  rdfs:comment "Performing legal compliance checks" ;
  rdfs:domain :User ;
  rdfs:range :Compliance.

:Right a owl:Class ;
  rdfs:label "Right" ;
  rdfs:comment "GDPR-related rights".

:Withdraw a owl:ObjectProperty ;
  rdfs:label "Withdraw" ;
  rdfs:comment "Withdrawing consent" ;
  rdfs:domain :User ;
  rdfs:range :Right.