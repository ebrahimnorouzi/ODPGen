@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Court Hierarchy and Bad Check Regulation Ontology" ;
  rdfs:comment "Ontology for court hierarchies and bad check crime related regulations".

:LegalTask rdfs:subClassOf owl:Thing ;
  rdfs:label "Legal Task" ;
  rdfs:comment "A legal task that requires managing complex information".

:manages rdfs:domain :LegalTask ;
  rdfs:range xsd:string ;
  rdfs:label "Manages" ;
  rdfs:comment "Manages complex information".

:CourtHierarchy rdfs:subClassOf owl:Thing ;
  rdfs:label "Court Hierarchy" ;
  rdfs:comment "A court hierarchy that captures court relationships".

:hasCourt rdfs:domain :CourtHierarchy ;
  rdfs:range :Court ;
  rdfs:label "Has Court" ;
  rdfs:comment "Has a court in the hierarchy".