@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Legal Task Ontology" ;
  rdfs:comment "Captures court hierarchies and bad check regulations".

:LegalTask a owl:Class ;
  rdfs:label "Legal Task" ;
  rdfs:comment "Represents a legal task".

:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "Represents a task".

:hasSubtask a owl:ObjectProperty ;
  rdfs:label "has subtask" ;
  rdfs:comment "A task has subtasks" ;
  owl:inverseOf :subtaskOf.

:subtaskOf a owl:ObjectProperty ;
  rdfs:label "subtask of" ;
  rdfs:comment "A subtask is part of a task" ;
  owl:inverseOf :hasSubtask.

:hasCourt a owl:ObjectProperty ;
  rdfs:label "has court" ;
  rdfs:comment "A task is associated with a court" ;
  owl:inverseOf :courtOf.

:courtOf a owl:ObjectProperty ;
  rdfs:label "court of" ;
  rdfs:comment "A court is associated with a task" ;
  owl:inverseOf :hasCourt.

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "has district" ;
  rdfs:comment "A court is associated with a district" ;
  owl:inverseOf :districtOf.

:districtOf a owl:ObjectProperty ;
  rdfs:label "district of" ;
  rdfs:comment "A district is associated with a court" ;
  owl:inverseOf :hasDistrict.

:hasState a owl:ObjectProperty ;
  rdfs:label "has state" ;
  rdfs:comment "A district is associated with a state" ;
  owl:inverseOf :stateOf.

:stateOf a owl:ObjectProperty ;
  rdfs:label "state of" ;
  rdfs:comment "A state is associated with a district" ;
  owl:inverseOf :hasState.

:hasCheck a owl:ObjectProperty ;
  rdfs:label "has check" ;
  rdfs:comment "A task is associated with a check" ;
  owl:inverseOf :checkOf.

:checkOf a owl:ObjectProperty ;
  rdfs:label "check of" ;
  rdfs:comment "A check is associated with a task" ;
  owl:inverseOf :hasCheck.

:hasTransaction a owl:ObjectProperty ;
  rdfs:label "has transaction" ;
  rdfs:comment "A check is associated with a transaction" ;
  owl:inverseOf :transactionOf.

:transactionOf a owl:ObjectProperty ;
  rdfs:label "transaction of" ;
  rdfs:comment "A transaction is associated with a check" ;
  owl:inverseOf :hasTransaction.

:hasType a owl:ObjectProperty ;
  rdfs:label "has type" ;
  rdfs:comment "A transaction has a type" ;
  owl:inverseOf :typeOf.

:typeOf a owl:ObjectProperty ;
  rdfs:label "type of" ;
  rdfs:comment "A type is associated with a transaction" ;
  owl:inverseOf :hasType.

:hasStatus a owl:ObjectProperty ;
  rdfs:label "has status" ;
  rdfs:comment "A transaction has a status" ;
  owl:inverseOf :statusOf.

:statusOf a owl:ObjectProperty ;
  rdfs:label "status of" ;
  rdfs:comment "A status is associated with a transaction" ;
  owl:inverseOf :hasStatus.

:hasPayment a owl:ObjectProperty ;
  rdfs:label "has payment" ;
  rdfs:comment "A transaction has a payment" ;
  owl:inverseOf :paymentOf.

:paymentOf a owl:ObjectProperty ;
  rdfs:label "payment of" ;
  rdfs:comment "A payment is associated with a transaction" ;
  owl:inverseOf :hasPayment.

:hasDate a owl:DatatypeProperty ;
  rdfs:label "has date" ;
  rdfs:comment "A payment has a date" ;
  owl:inverseOf :dateOf.