@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case Ontology" ;
  rdfs:comment "Reasoning about the cause of a slippery pavement".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An event in the sprinkler use case".

:Cause a owl:ObjectProperty ;
  rdfs:label "Cause" ;
  rdfs:comment "A causal relation between two events" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:Effect a owl:ObjectProperty ;
  rdfs:label "Effect" ;
  rdfs:comment "The effect of one event on another" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:Pavement a owl:Class ;
  rdfs:label "Pavement" ;
  rdfs:comment "The pavement in the sprinkler use case".

:SlipperyPavement a owl:Class ;
  rdfs:label "Slippery Pavement" ;
  rdfs:comment "The pavement is slippery" ;
  rdfs:subClassOf :Pavement.

:WetPavement a owl:Class ;
  rdfs:label "Wet Pavement" ;
  rdfs:comment "The pavement is wet" ;
  rdfs:subClassOf :Pavement.

:RainySeason a owl:Class ;
  rdfs:label "Rainy Season" ;
  rdfs:comment "It is rainy season" ;
  rdfs:subClassOf :Event.

:SprinklerOn a owl:Class ;
  rdfs:label "Sprinkler On" ;
  rdfs:comment "The sprinkler is on" ;
  rdfs:subClassOf :Event.

:Rain a owl:Class ;
  rdfs:label "Rain" ;
  rdfs:comment "It is raining" ;
  rdfs:subClassOf :Event.

:CausalLink a owl:Class ;
  rdfs:label "Causal Link" ;
  rdfs:comment "A causal link between two events" ;
  rdfs:subClassOf :Event.

:Weight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The effect weight of a causal link" ;
  rdfs:domain :CausalLink ;
  rdfs:range xsd:float.

:Outcome a owl:Class ;
  rdfs:label "Outcome" ;
  rdfs:comment "The outcome of an event" ;
  rdfs:subClassOf :Event.

:SprinklerSystem a owl:Class ;
  rdfs:label "Sprinkler System" ;
  rdfs:comment "The sprinkler system" ;
  rdfs:subClassOf :Event.

:TurnOn a owl:ObjectProperty ;
  rdfs:label "Turn On" ;
  rdfs:comment "The action of turning on the sprinkler system" ;
  rdfs:domain :SprinklerSystem ;
  rdfs:range :Event.

:TurnOff a owl:ObjectProperty ;
  rdfs:label "Turn Off" ;
  rdfs:comment "The action of turning off the sprinkler system" ;
  rdfs:domain :SprinklerSystem ;
  rdfs:range :Event.

:Mediated a owl:ObjectProperty ;
  rdfs:label "Mediated" ;
  rdfs:comment "The effect of one event on another is mediated by a third event" ;
  rdfs:domain :Effect ;
  rdfs:range :Event.

:Disjoint a owl:ObjectProperty ;
  rdfs:label "Disjoint" ;
  rdfs:comment "Two events are disjoint" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:SlipperyPavementDisjoint a owl:Class ;
  rdfs:label "Slippery Pavement Disjoint" ;
  rdfs:comment "The pavement is slippery and not wet" ;
  rdfs:subClassOf :Disjoint ;
  rdfs:comment "The pavement is slippery and not wet" ;
  rdfs:comment "The pavement is slippery and not wet" ;
  rdfs:subClassOf :SlipperyPavement :WetPavement.