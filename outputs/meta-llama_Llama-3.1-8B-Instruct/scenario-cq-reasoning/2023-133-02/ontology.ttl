@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Asthma Patient Ontology" ;
  rdfs:comment "Ontology for asthma patient data".

:Patient a owl:Class ;
  rdfs:label "Patient" ;
  rdfs:comment "Asthma patient" ;
  owl:disjointWith :Symptom ;
  owl:disjointWith :Medication ;
  owl:disjointWith :OutdoorEnvironmentFeature.

:Symptom a owl:Class ;
  rdfs:label "Symptom" ;
  rdfs:comment "Asthma symptom" ;
  owl:disjointWith :Patient ;
  owl:disjointWith :Medication ;
  owl:disjointWith :OutdoorEnvironmentFeature.

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "Medication for asthma" ;
  owl:disjointWith :Patient ;
  owl:disjointWith :Symptom ;
  owl:disjointWith :OutdoorEnvironmentFeature.