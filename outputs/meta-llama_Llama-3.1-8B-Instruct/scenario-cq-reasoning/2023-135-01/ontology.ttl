@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Authorship Ontology" ;
  rdfs:comment "Ontology for authors and their adopted names".

:Author a rdfs:Class ;
  rdfs:label "Author" ;
  rdfs:comment "An individual who writes books".

:Name a rdfs:Class ;
  rdfs:label "Name" ;
  rdfs:comment "A personal name".

:adoptedName a owl:Property ;
  rdfs:label "adopted name" ;
  rdfs:comment "A name adopted by an author for publishing" ;
  owl:domain :Author ;
  owl:range :Name.

:Book a rdfs:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A written work".

:publishedBy a owl:Property ;
  rdfs:label "published by" ;
  rdfs:comment "The author of a book" ;
  owl:domain :Book ;
  owl:range :Author.

:Author rdfs:subClassOf owl:Thing.
:Name rdfs:subClassOf owl:Thing.