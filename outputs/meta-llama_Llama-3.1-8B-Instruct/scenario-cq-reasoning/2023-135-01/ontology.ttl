@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Author Name Changes Ontology" ;
  rdfs:comment "Modeling author name changes and pseudonyms.".

:Author a owl:Class ;
  rdfs:label "Author" ;
  rdfs:comment "An individual who writes books.".

:Name a owl:Class ;
  rdfs:label "Name" ;
  rdfs:comment "A label used to identify an individual.".

:Pseudonym a owl:Class ;
  rdfs:label "Pseudonym" ;
  rdfs:comment "A name used by an author to conceal their identity.".

:usesPseudonym a owl:ObjectProperty ;
  rdfs:label "uses pseudonym" ;
  rdfs:comment "An author uses a pseudonym." ;
  domain :Author ;
  range :Pseudonym.

:hasName a owl:ObjectProperty ;
  rdfs:label "has name" ;
  rdfs:comment "An individual has a name." ;
  domain :Author ;
  range :Name.

:NameChange a owl:Class ;
  rdfs:label "Name Change" ;
  rdfs:comment "An event where an individual changes their name.".

:occurs a owl:ObjectProperty ;
  rdfs:label "occurs" ;
  rdfs:comment "A name change occurs." ;
  domain :NameChange ;
  range xsd:gYear.

:Authorship a owl:Class ;
  rdfs:label "Authorship" ;
  rdfs:comment "The act of writing a book.".

:writes a owl:ObjectProperty ;
  rdfs:label "writes" ;
  rdfs:comment "An author writes a book." ;
  domain :Author ;
  range :Book.

:Book a owl:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A written work.".

:hasTitle a owl:DatatypeProperty ;
  rdfs:label "has title" ;
  rdfs:comment "A book has a title." ;
  domain :Book ;
  range xsd:string.

:hasAuthor a owl:ObjectProperty ;
  rdfs:label "has author" ;
  rdfs:comment "A book has an author." ;
  domain :Book ;
  range :Author.

:hasPublisher a owl:ObjectProperty ;
  rdfs:label "has publisher" ;
  rdfs:comment "A book has a publisher." ;
  domain :Book ;
  range :Publisher.

:Publisher a owl:Class ;
  rdfs:label "Publisher" ;
  rdfs:comment "A company that publishes books.".

:hasPublicationDate a owl:DatatypeProperty ;
  rdfs:label "has publication date" ;
  rdfs:comment "A book has a publication date." ;
  domain :Book ;
  range xsd:date.

:hasBook a owl:ObjectProperty ;
  rdfs:label "has book" ;
  rdfs:comment "An author has written a book." ;
  domain :Author ;
  range :Book.

:hasNameChange a owl:ObjectProperty ;
  rdfs:label "has name change" ;
  rdfs:comment "An author has undergone a name change." ;
  domain :Author ;
  range :NameChange.

:hasPseudonym a owl:ObjectProperty ;
  rdfs:label "has pseudonym" ;
  rdfs:comment "An author uses a pseudonym." ;
  domain :Author ;
  range :Pseudonym.

:hasBookTitle a owl:DatatypeProperty ;
  rdfs:label "has book title" ;
  rdfs:comment "A book has a title." ;
  domain :Book ;
  range xsd:string.

:hasAuthorship a owl:ObjectProperty ;
  rdfs:label "has authorship" ;
  rdfs:comment "An author has written a book." ;
  domain :Author ;
  range :Authorship.

:hasNameChangeDate a owl:DatatypeProperty ;
  rdfs:label "has name change date" ;
  rdfs:comment "A name change occurs on a specific date." ;
  domain :NameChange ;
  range xsd:date.