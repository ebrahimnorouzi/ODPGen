@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Time and Event Management Ontology" ;
  rdfs:comment "Ontology for managing time and events.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "A point in time.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A geographical location.".

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "An item of value.".

:AssetCollection a owl:Class ;
  rdfs:label "Asset Collection" ;
  rdfs:comment "A collection of assets.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A set of rules governing behavior.".

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "An individual or organization.".

:PartyCollection a owl:Class ;
  rdfs:label "Party Collection" ;
  rdfs:comment "A collection of parties.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "An event or occurrence.".

:RuleExercise a owl:Class ;
  rdfs:label "Rule Exercise" ;
  rdfs:comment "An instance of a rule being exercised.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An occurrence or happening.".

:Recipient a owl:Class ;
  rdfs:label "Recipient" ;
  rdfs:comment "An individual or organization receiving information.".

:Category a owl:Class ;
  rdfs:label "Category" ;
  rdfs:comment "A group of recipients.".

:FinancialPayment a owl:Class ;
  rdfs:label "Financial Payment" ;
  rdfs:comment "A payment of money.".

:Amount a owl:Class ;
  rdfs:label "Amount" ;
  rdfs:comment "A quantity of money.".

:hasCurrentTime a owl:ObjectProperty ;
  rdfs:label "has current time" ;
  rdfs:comment "The current time." ;
  rdfs:domain :Event ;
  rdfs:range :Time.

:hasLocation a owl:ObjectProperty ;
  rdfs:label "has location" ;
  rdfs:comment "The location of an event." ;
  rdfs:domain :Event ;
  rdfs:range :Location.

:hasAsset a owl:ObjectProperty ;
  rdfs:label "has asset" ;
  rdfs:comment "An asset that is part of an asset collection." ;
  rdfs:domain :AssetCollection ;
  rdfs:range :Asset.

:hasPolicy a owl:ObjectProperty ;
  rdfs:label "has policy" ;
  rdfs:comment "The policy that governs an asset collection." ;
  rdfs:domain :AssetCollection ;
  rdfs:range :Policy.

:hasParty a owl:ObjectProperty ;
  rdfs:label "has party" ;
  rdfs:comment "A party that is part of a party collection." ;
  rdfs:domain :PartyCollection ;
  rdfs:range :Party.

:hasAction a owl:ObjectProperty ;
  rdfs:label "has action" ;
  rdfs:comment "An action that has been performed or attempted." ;
  rdfs:domain :Event ;
  rdfs:range :Action.

:hasExerciseCount a owl:ObjectProperty ;
  rdfs:label "has exercise count" ;
  rdfs:comment "The number of times a rule has been exercised." ;
  rdfs:domain :RuleExercise ;
  rdfs:range xsd:integer.

:hasEventInfo a owl:ObjectProperty ;
  rdfs:label "has event info" ;
  rdfs:comment "Information about an event." ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:hasExerciseDuration a owl:ObjectProperty ;
  rdfs:label "has exercise duration" ;
  rdfs:comment "The duration for which a rule has been exercised." ;
  rdfs:domain :RuleExercise ;
  rdfs:range xsd:duration.