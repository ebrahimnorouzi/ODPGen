@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Ship Ontology" ;
  rdfs:comment "Ontology for modeling ships and their properties".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes".

:ShipID a owl:Class ;
  rdfs:label "Ship ID" ;
  rdfs:comment "Unique identifier for a ship".

:Dimensions a owl:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "Measurements of a ship's size".

:Length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "Length of the ship" ;
  rdfs:domain :Ship ;
  rdfs:range xsd:double.

:Width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "Width of the ship" ;
  rdfs:domain :Ship ;
  rdfs:range xsd:double.

:Height a owl:DatatypeProperty ;
  rdfs:label "Height" ;
  rdfs:comment "Height of the ship" ;
  rdfs:domain :Ship ;
  rdfs:range xsd:double.

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Typical location of a ship".

:Latitude a owl:DatatypeProperty ;
  rdfs:label "Latitude" ;
  rdfs:comment "Latitude of the ship's location" ;
  rdfs:domain :Location ;
  rdfs:range xsd:decimal.

:Longitude a owl:DatatypeProperty ;
  rdfs:label "Longitude" ;
  rdfs:comment "Longitude of the ship's location" ;
  rdfs:domain :Location ;
  rdfs:range xsd:decimal.

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "Organization or individual owning a ship".

:ShipOwner a owl:ObjectProperty ;
  rdfs:label "Ship Owner" ;
  rdfs:comment "Relationship between a ship and its owner" ;
  rdfs:domain :Ship ;
  rdfs:range :Owner.

:Speed a owl:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "Average speed of a ship over ground".

:SpeedOverGround a owl:DatatypeProperty ;
  rdfs:label "Speed Over Ground" ;
  rdfs:comment "Average speed of the ship over ground" ;
  rdfs:domain :Speed ;
  rdfs:range xsd:double.

:ContainerShip a owl:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "Ship designed for transporting containers".

:GermanFlag a owl:Class ;
  rdfs:label "German Flag" ;
  rdfs:comment "Ship registered under the German flag".

:GPSAntenna a owl:Class ;
  rdfs:label "GPS Antenna" ;
  rdfs:comment "GPS antenna placement on a ship".

:AntennaPlacement a owl:DatatypeProperty ;
  rdfs:label "Antenna Placement" ;
  rdfs:comment "Placement of the GPS antenna on the ship" ;
  rdfs:domain :GPSAntenna ;
  rdfs:range :Bow.

:Bow a owl:Class ;
  rdfs:label "Bow" ;
  rdfs:comment "Front of the ship".

:Stern a owl:Class ;
  rdfs:label "Stern" ;
  rdfs:comment "Rear of the ship".

:Port a owl:Class ;
  rdfs:label "Port" ;
  rdfs:comment "Left side of the ship".

:Starboard a owl:Class ;
  rdfs:label "Starboard" ;
  rdfs:comment "Right side of the ship".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "Company or entity owning ships".

:ShipRoute a owl:Class ;
  rdfs:label "Ship Route" ;
  rdfs:comment "Route taken by a ship".