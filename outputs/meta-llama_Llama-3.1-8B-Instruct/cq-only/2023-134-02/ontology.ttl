@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Log Data Ontology" ;
  rdfs:comment "Ontology for modeling log data".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Type of action performed on the data".

:Create a owl:Class ;
  rdfs:label "Create" ;
  rdfs:comment "Action of creating data" ;
  rdfs:subClassOf :Action.

:Update a owl:Class ;
  rdfs:label "Update" ;
  rdfs:comment "Action of updating data" ;
  rdfs:subClassOf :Action.

:Erase a owl:Class ;
  rdfs:label "Erase" ;
  rdfs:comment "Action of erasing data" ;
  rdfs:subClassOf :Action.

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "Entity interacting with the data".

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "Human entity" ;
  rdfs:subClassOf :Entity.

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "Organizational entity" ;
  rdfs:subClassOf :Entity.

:LogPublisher a owl:Class ;
  rdfs:label "Log Publisher" ;
  rdfs:comment "Entity publishing the log" ;
  rdfs:subClassOf :Entity.

:LogIssueDate a owl:DatatypeProperty ;
  rdfs:label "Log Issue Date" ;
  rdfs:comment "Date when the log was issued" ;
  rdfs:domain :Log ;
  rdfs:range xsd:date.

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "Log entry" ;
  rdfs:subClassOf :Statement.

:Statement a owl:Class ;
  rdfs:label "Statement" ;
  rdfs:comment "Statement about the data" ;
  rdfs:subClassOf :Log.

:DataLocation a owl:DatatypeProperty ;
  rdfs:label "Data Location" ;
  rdfs:comment "Location where the data is being stored" ;
  rdfs:domain :Log ;
  rdfs:range xsd:string.

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "Application/service generating the data".

:Uses a owl:ObjectProperty ;
  rdfs:label "Uses" ;
  rdfs:comment "Application/service used to generate the data" ;
  rdfs:domain :Log ;
  rdfs:range :Application.