@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "Ontology for modeling evaluation requests.".

:RequestedAction a rdfs:Class ;
  rdfs:label "Requested Action" ;
  rdfs:comment "The action being requested in the evaluation.".

:Party a rdfs:Class ;
  rdfs:label "Party" ;
  rdfs:comment "The entity issuing the evaluation request.".

:TargetAsset a rdfs:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset being evaluated.".

:EvaluationRequest a rdfs:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "The request for an evaluation.".

:issued a owl:DatatypeProperty ;
  rdfs:label "Issued Date" ;
  rdfs:comment "The date the evaluation request was issued." ;
  rdfs:range xsd:date.

:requestedAction a owl:ObjectProperty ;
  rdfs:label "Requested Action" ;
  rdfs:comment "The action being requested in the evaluation." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :RequestedAction.

:issuedBy a owl:ObjectProperty ;
  rdfs:label "Issued By" ;
  rdfs:comment "The party issuing the evaluation request." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :Party.

:targets a owl:ObjectProperty ;
  rdfs:label "Targets" ;
  rdfs:comment "The target asset of the evaluation request." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :TargetAsset.

:additionalContext a owl:ObjectProperty ;
  rdfs:label "Additional Context" ;
  rdfs:comment "Additional contextual information to further constrain the evaluation request." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range rdf:Resource.

:Party :hasName :Name ;
  rdfs:label "Has Name" ;
  rdfs:comment "The name of the party." ;
  rdfs:domain :Party ;
  rdfs:range :Name.

:Name a rdfs:Class ;
  rdfs:label "Name" ;
  rdfs:comment "The name of a party.".