@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Policy Access Ontology" ;
  rdfs:comment "Ontology for modeling policy access information".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy that governs access to data".

:PolicyID a owl:DatatypeProperty ;
  rdfs:label "Policy ID" ;
  rdfs:comment "Unique identifier of the policy" ;
  owl:datatype xsd:string.

:PolicyCreator a owl:Class ;
  rdfs:label "Policy Creator" ;
  rdfs:comment "Person who created the policy".

:PolicyCreator rdf:type owl:Restriction ;
  owl:onProperty :hasPolicyCreator ;
  owl:allValuesFrom :Person.

:hasPolicyCreator a owl:ObjectProperty ;
  rdfs:label "Has Policy Creator" ;
  rdfs:comment "Relationship between policy and its creator".

:PolicyIssueDate a owl:DatatypeProperty ;
  rdfs:label "Policy Issue Date" ;
  rdfs:comment "Date when the policy was issued" ;
  owl:datatype xsd:date.

:Assignee a owl:Class ;
  rdfs:label "Assignee" ;
  rdfs:comment "Person assigned the policy".

:Assignee rdf:type owl:Restriction ;
  owl:onProperty :hasAssignee ;
  owl:allValuesFrom :Person.

:hasAssignee a owl:ObjectProperty ;
  rdfs:label "Has Assignee" ;
  rdfs:comment "Relationship between policy and its assignee".

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "Application or service used to access data".

:Application rdf:type owl:Restriction ;
  owl:onProperty :usesApplication ;
  owl:allValuesFrom :Application.

:usesApplication a owl:ObjectProperty ;
  rdfs:label "Uses Application" ;
  rdfs:comment "Relationship between policy and application".

:AccessMode a owl:Class ;
  rdfs:label "Access Mode" ;
  rdfs:comment "Mode of access requested by the policy".

:AccessMode rdf:type owl:Restriction ;
  owl:onProperty :requestsAccessMode ;
  owl:allValuesFrom :AccessMode.

:requestsAccessMode a owl:ObjectProperty ;
  rdfs:label "Requests Access Mode" ;
  rdfs:comment "Relationship between policy and access mode".

:PersonalData a owl:Class ;
  rdfs:label "Personal Data" ;
  rdfs:comment "Personal data being accessed by the policy".

:PersonalData rdf:type owl:Restriction ;
  owl:onProperty :accessesPersonalData ;
  owl:allValuesFrom :PersonalData.

:accessesPersonalData a owl:ObjectProperty ;
  rdfs:label "Accesses Personal Data" ;
  rdfs:comment "Relationship between policy and personal data".

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "Purpose for accessing the data".

:Purpose rdf:type owl:Restriction ;
  owl:onProperty :forPurpose ;
  owl:allValuesFrom :Purpose.

:forPurpose a owl:ObjectProperty ;
  rdfs:label "For Purpose" ;
  rdfs:comment "Relationship between policy and purpose".

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "Person involved in policy access".