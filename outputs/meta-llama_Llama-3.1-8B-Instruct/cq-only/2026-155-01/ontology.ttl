@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Survey Investigation Ontology" ;
  rdfs:comment "Ontology for survey and investigation activities".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "Activity performed on a cultural property or feature of interest".

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "Survey or investigation activity" ;
  rdfs:subClassOf :Activity.

:Investigation a owl:Class ;
  rdfs:label "Investigation" ;
  rdfs:comment "Investigation activity" ;
  rdfs:subClassOf :Activity.

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "Method or investigation technique adopted in a survey or investigation activity".

:Technique a owl:Class ;
  rdfs:label "Technique" ;
  rdfs:comment "Investigation technique adopted in a survey or investigation activity" ;
  rdfs:subClassOf :Method.

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Observation produced during a survey or investigation activity".

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "Expert participating in a survey or investigation activity".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Role of an expert in a survey or investigation activity".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "Hardware used to conduct a survey or investigation activity".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "Software used to conduct a survey or investigation activity".

:Configuration a owl:Class ;
  rdfs:label "Configuration" ;
  rdfs:comment "Technical configuration used to conduct a survey or investigation activity".

:Parameter a owl:Class ;
  rdfs:label "Parameter" ;
  rdfs:comment "Acquisition parameter characterising a photographic acquisition cycle".

:Acquisition a owl:Class ;
  rdfs:label "Acquisition" ;
  rdfs:comment "Acquisition or observation activity" ;
  rdfs:subClassOf :Activity.

:Output a owl:Class ;
  rdfs:label "Output" ;
  rdfs:comment "Post-processed output related to an acquisition or observation activity".

:Claim a owl:Class ;
  rdfs:label "Claim" ;
  rdfs:comment "Interpretation or claim supported by observations".

:Observation_has_Method :hasMethod a owl:ObjectProperty ;
  rdfs:label "hasMethod" ;
  rdfs:comment "Method adopted in an observation" ;
  rdfs:domain :Observation ;
  rdfs:range :Method.

:Activity_has_Method :hasMethod a owl:ObjectProperty ;
  rdfs:label "hasMethod" ;
  rdfs:comment "Method adopted in an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Method.

:Activity_has_Observation :hasObservation a owl:ObjectProperty ;
  rdfs:label "hasObservation" ;
  rdfs:comment "Observation produced during an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Observation.

:Activity_has_Expert :hasExpert a owl:ObjectProperty ;
  rdfs:label "hasExpert" ;
  rdfs:comment "Expert participating in an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Expert.

:Activity_has_Role :hasRole a owl:ObjectProperty ;
  rdfs:label "hasRole" ;
  rdfs:comment "Role of an expert in an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Role.

:Activity_has_Hardware :hasHardware a owl:ObjectProperty ;
  rdfs:label "hasHardware" ;
  rdfs:comment "Hardware used in an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Hardware.