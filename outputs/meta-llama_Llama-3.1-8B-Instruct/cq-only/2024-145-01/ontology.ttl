@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "District Court Ontology" ;
  rdfs:comment "Ontology for modeling district courts and their relationships".

:DistrictCourt a owl:Class ;
  rdfs:label "District Court" ;
  rdfs:comment "A district court is a court that has authority over a specific geographic area".

:State a owl:Class ;
  rdfs:label "State" ;
  rdfs:comment "A state is a geographic area with its own government".

:hasDistrictCourt a owl:ObjectProperty ;
  rdfs:label "has District Court" ;
  rdfs:comment "A state has one or more district courts" ;
  rdfs:domain :State ;
  rdfs:range :DistrictCourt.

:locatedIn a owl:ObjectProperty ;
  rdfs:label "located in" ;
  rdfs:comment "A district court is located in a state" ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :State.

:hasAuthorityOver a owl:ObjectProperty ;
  rdfs:label "has authority over" ;
  rdfs:comment "A court has authority over another court" ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :DistrictCourt.

:District a owl:Class ;
  rdfs:label "District" ;
  rdfs:comment "A district is a geographic area within a state".

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "has district" ;
  rdfs:comment "A state has one or more districts" ;
  rdfs:domain :State ;
  rdfs:range :District.

:India a owl:Class ;
  rdfs:label "India" ;
  rdfs:comment "A country with its own government".

:hasDistricts a owl:DatatypeProperty ;
  rdfs:label "number of districts" ;
  rdfs:comment "The number of districts in a state" ;
  rdfs:domain :State ;
  rdfs:range xsd:int.

:Check a owl:Class ;
  rdfs:label "Check" ;
  rdfs:comment "A financial transaction".

:hasTransactionType a owl:ObjectProperty ;
  rdfs:label "has transaction type" ;
  rdfs:comment "A check has a transaction type" ;
  rdfs:domain :Check ;
  rdfs:range :TransactionType.

:TransactionType a owl:Class ;
  rdfs:label "Transaction Type" ;
  rdfs:comment "A type of financial transaction".

:hasStatus a owl:ObjectProperty ;
  rdfs:label "has status" ;
  rdfs:comment "A check payment has a status" ;
  rdfs:domain :CheckPayment ;
  rdfs:range :TransactionStatus.

:TransactionStatus a owl:Class ;
  rdfs:label "Transaction Status" ;
  rdfs:comment "The status of a financial transaction".

:isBad a owl:DatatypeProperty ;
  rdfs:label "is bad" ;
  rdfs:comment "Whether a check is bad" ;
  rdfs:domain :Check ;
  rdfs:range xsd:boolean.

:paymentDate a owl:DatatypeProperty ;
  rdfs:label "payment date" ;
  rdfs:comment "The date of payment for a bad check" ;
  rdfs:domain :CheckPayment ;
  rdfs:range xsd:date.

:CheckPayment a owl:Class ;
  rdfs:label "Check Payment" ;
  rdfs:comment "A payment for a bad check".