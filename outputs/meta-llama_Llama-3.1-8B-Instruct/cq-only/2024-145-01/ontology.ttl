@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "District Court Ontology" ;
  rdfs:comment "Ontology for modeling district courts and their relationships.".

:DistrictCourt a rdfs:Class ;
  rdfs:label "District Court" ;
  rdfs:comment "A district court is a court that has jurisdiction over a particular geographic area.".

:State a rdfs:Class ;
  rdfs:label "State" ;
  rdfs:comment "A state is a geographic area with its own government.".

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "has district" ;
  rdfs:comment "A state has one or more districts." ;
  rdfs:domain :State ;
  rdfs:range :DistrictCourt.

:locatedIn a owl:ObjectProperty ;
  rdfs:label "located in" ;
  rdfs:comment "A district court is located in a particular state." ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :State.

:hasAuthority a owl:ObjectProperty ;
  rdfs:label "has authority over" ;
  rdfs:comment "A higher court has authority over a lower court." ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :DistrictCourt.

:Check a rdfs:Class ;
  rdfs:label "Check" ;
  rdfs:comment "A check is a financial instrument.".

:badCheck a owl:DatatypeProperty ;
  rdfs:label "bad check" ;
  rdfs:comment "A check that is not paid." ;
  rdfs:domain :Check ;
  rdfs:range xsd:boolean.

:checkPayment a rdfs:Class ;
  rdfs:label "Check Payment" ;
  rdfs:comment "A payment made using a check.".

:transactionStatus a owl:DatatypeProperty ;
  rdfs:label "transaction status" ;
  rdfs:comment "The status of a transaction." ;
  rdfs:domain :CheckPayment ;
  rdfs:range xsd:string.

:checkPaymentDate a owl:DatatypeProperty ;
  rdfs:label "check payment date" ;
  rdfs:comment "The date of a check payment." ;
  rdfs:domain :CheckPayment ;
  rdfs:range xsd:date.

:hasCheckType a owl:ObjectProperty ;
  rdfs:label "has check type" ;
  rdfs:comment "A check has a type." ;
  rdfs:domain :Check ;
  rdfs:range :CheckType.

:CheckType a rdfs:Class ;
  rdfs:label "Check Type" ;
  rdfs:comment "A type of check.".

:badCheckType a owl:DatatypeProperty ;
  rdfs:label "bad check type" ;
  rdfs:comment "The type of a bad check." ;
  rdfs:domain :CheckType ;
  rdfs:range xsd:string.

:India a :State ;
  rdfs:label "India" ;
  rdfs:comment "A country with its own government.".

:districtsInIndia a owl:DatatypeProperty ;
  rdfs:label "districts in India" ;
  rdfs:comment "The number of districts in a given state of India." ;
  rdfs:domain :State ;
  rdfs:range xsd:integer.