@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "Formal description of a requested action by an assignee on a target asset.".

:Request a :Action ;
  rdfs:label "Request" ;
  rdfs:comment "Formal description of a requested action.".

:Action rdfs:subClassOf :Request ;
  rdfs:label "Action" ;
  rdfs:comment "Requested action.".

:Assignee a :Party ;
  rdfs:label "Assignee" ;
  rdfs:comment "Party issuing the evaluation request.".

:Party rdfs:subClassOf :Role ;
  rdfs:label "Party" ;
  rdfs:comment "Role in the evaluation request.".

:Role rdfs:subClassOf :Request ;
  rdfs:label "Role" ;
  rdfs:comment "Role in the evaluation request.".

:Target a :Asset ;
  rdfs:label "Target" ;
  rdfs:comment "Target asset of the evaluation request.".

:Asset rdfs:subClassOf :Request ;
  rdfs:label "Asset" ;
  rdfs:comment "Asset in the evaluation request.".

:TemporalContext a :Context ;
  rdfs:label "Temporal Context" ;
  rdfs:comment "Temporal context of the evaluation request.".

:Context rdfs:subClassOf :Request ;
  rdfs:label "Context" ;
  rdfs:comment "Context of the evaluation request.".

:EU a :Location ;
  rdfs:label "EU" ;
  rdfs:comment "Location in the evaluation request.".

:Location rdfs:subClassOf :Request ;
  rdfs:label "Location" ;
  rdfs:comment "Location in the evaluation request.".

:Weekday a :Day ;
  rdfs:label "Weekday" ;
  rdfs:comment "Day in the evaluation request.".

:Day rdfs:subClassOf :Request ;
  rdfs:label "Day" ;
  rdfs:comment "Day in the evaluation request.".

:RequestCapability a :Capability ;
  rdfs:label "Request Capability" ;
  rdfs:comment "Request capability in the evaluation request.".

:Capability rdfs:subClassOf :Request ;
  rdfs:label "Capability" ;
  rdfs:comment "Capability in the evaluation request.".

:Allowed a :Request ;
  rdfs:label "Allowed" ;
  rdfs:comment "Allowed evaluation requests.".

:Request :Allowed [
  a owl:Restriction ;
  owl:onProperty :Request ;
  owl:someValuesFrom :Employee ;
  owl:onProperty :Request ;
  owl:someValuesFrom :EU ;
  owl:onProperty :Request ;
  owl:someValuesFrom :Weekday ;
  owl:onProperty :Request ;
  owl:someValuesFrom :RequestCapability ;
].

:Employee a :Role ;
  rdfs:label "Employee" ;
  rdfs:comment "Role in the evaluation request.".

:EU a :Location ;
  rdfs:label "EU" ;
  rdfs:comment "Location in the evaluation request.".

:Weekday a :Day ;
  rdfs:label "Weekday" ;
  rdfs:comment "Day in the evaluation request.".

:RequestCapability a :Capability ;
  rdfs:label "Request Capability" ;
  rdfs:comment "Request capability in the evaluation request.".

:Allowed a owl:Restriction ;
  owl:onProperty :Request ;
  owl:someValuesFrom :Employee ;
  owl:onProperty :Request ;
  owl:someValuesFrom :EU ;
  owl:onProperty :Request ;
  owl:someValuesFrom :Weekday ;
  owl:onProperty :Request ;
  owl:someValuesFrom :RequestCapability ;
  rdfs:label "Allowed" ;
  rdfs:comment "Allowed evaluation requests.".