@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "Formal description of a requested action by an assignee on a target asset.".

:Request a owl:Class ;
  rdfs:label "Request" ;
  rdfs:comment "Formal description of a requested action by an assignee on a target asset.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "The requested action.".

:Assignee a owl:Class ;
  rdfs:label "Assignee" ;
  rdfs:comment "The party issuing the evaluation request.".

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "The target asset of the evaluation request.".

:TemporalContext a owl:Class ;
  rdfs:label "Temporal Context" ;
  rdfs:comment "Temporal context of the evaluation request.".

:TemporalContext a owl:disjointWith :SpatialContext.

:TemporalContext a owl:disjointWith :RoleContext.

:TemporalContext a owl:disjointWith :RequestCapabilityContext.

:SpatialContext a owl:Class ;
  rdfs:label "Spatial Context" ;
  rdfs:comment "Spatial context of the evaluation request.".

:SpatialContext a owl:disjointWith :TemporalContext.

:SpatialContext a owl:disjointWith :RoleContext.

:SpatialContext a owl:disjointWith :RequestCapabilityContext.

:RoleContext a owl:Class ;
  rdfs:label "Role Context" ;
  rdfs:comment "Role context of the evaluation request.".

:RoleContext a owl:disjointWith :TemporalContext.

:RoleContext a owl:disjointWith :SpatialContext.

:RoleContext a owl:disjointWith :RequestCapabilityContext.

:RequestCapabilityContext a owl:Class ;
  rdfs:label "Request Capability Context" ;
  rdfs:comment "Request capability context of the evaluation request.".

:RequestCapabilityContext a owl:disjointWith :TemporalContext.

:RequestCapabilityContext a owl:disjointWith :SpatialContext.

:RequestCapabilityContext a owl:disjointWith :RoleContext.

:Employee a owl:Class ;
  rdfs:label "Employee" ;
  rdfs:comment "Employee.".

:EU a owl:Class ;
  rdfs:label "EU" ;
  rdfs:comment "EU.".

:Weekday a owl:Class ;
  rdfs:label "Weekday" ;
  rdfs:comment "Weekday.".

:Request a owl:disjointWith :Employee.

:Request a owl:disjointWith :EU.

:Request a owl:disjointWith :Weekday.

:Request a owl:subClassOf :RequestCapabilityContext.

:Request a owl:subClassOf :RoleContext.

:Request a owl:subClassOf :SpatialContext.

:Request a owl:subClassOf :TemporalContext.

:Request a owl:subClassOf :Action.

:Request a owl:subClassOf :Assignee.

:Request a owl:subClassOf :Asset.

:Request a owl:subClassOf :TemporalContext.

:Request a owl:subClassOf :SpatialContext.

:Request a owl:subClassOf :RoleContext.

:Request a owl:subClassOf :RequestCapabilityContext.

:Request a owl:subClassOf :Action.

:Request a owl:subClassOf :Assignee.

:Request a owl:subClassOf :Asset.

:Request a owl:subClassOf :TemporalContext.

:Request a owl:subClassOf :SpatialContext.

:Request a owl:subClassOf :RoleContext.

:Request a owl:subClassOf :RequestCapabilityContext.

:Request a owl:subClassOf :Action.

:Request a owl:subClassOf :Assignee.

:Request a owl:subClassOf :Asset.

:Request a owl:subClassOf :TemporalContext.

:Request a owl:subClassOf :SpatialContext.

:Request a owl:subClassOf :RoleContext.

:Request a owl:subClassOf :RequestCapabilityContext.

:Request a owl:subClassOf :Action.

:Request a owl:subClassOf :Assignee.

:Request a owl:subClassOf :Asset.