@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.
@prefix mqtt: <http://example.org/mqtt#>.
@prefix qos:  <http://example.org/qos#>.
@prefix sosa: <http://www.opengis.net/def/property/OGC/0.0.4/>.
@prefix qudt: <http://qudt.org/>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT message protocol in industrial and IoT settings".

:MQTT a owl:Class ;
  rdfs:label "MQTT" ;
  rdfs:comment "Message Queuing Telemetry Transport protocol".

:MQTTClient a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Client participating in MQTT protocol" ;
  rdfs:subClassOf :MQTT.

:MQTTBroker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Broker participating in MQTT protocol" ;
  rdfs:subClassOf :MQTT.

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "Network connection between MQTT clients and brokers" ;
  rdfs:subClassOf :MQTT.

:MQTTTopic a owl:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "Topic in MQTT protocol".

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "Filter applied to MQTT topics".

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "Control packet in MQTT protocol".

:MQTTPublishPacket a owl:Class ;
  rdfs:label "MQTT Publish Packet" ;
  rdfs:comment "Publish packet in MQTT protocol".

:MQTTSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "SUBSCRIBE packet in MQTT protocol".

:MQTTUNSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "UNSUBSCRIBE packet in MQTT protocol".

:MQTTClientID a owl:DatatypeProperty ;
  rdfs:label "MQTT Client ID" ;
  rdfs:comment "Unique identifier for MQTT client" ;
  rdfs:domain :MQTTClient ;
  rdfs:range xsd:string.

:MQTTBrokerHost a owl:DatatypeProperty ;
  rdfs:label "MQTT Broker Host" ;
  rdfs:comment "Host of MQTT broker" ;
  rdfs:domain :MQTTBroker ;
  rdfs:range xsd:string.

:MQTTBrokerPort a owl:DatatypeProperty ;
  rdfs:label "MQTT Broker Port" ;
  rdfs:comment "Port of MQTT broker" ;
  rdfs:domain :MQTTBroker ;
  rdfs:range xsd:integer.

:MQTTNetworkConnectionTLS a owl:DatatypeProperty ;
  rdfs:label "MQTT Network Connection TLS" ;
  rdfs:comment "TLS security of MQTT network connection" ;
  rdfs:domain :MQTTNetworkConnection ;
  rdfs:range xsd:boolean.

:MQTTTopicName a owl:DatatypeProperty ;
  rdfs:label "MQTT Topic Name" ;
  rdfs:comment "Name of MQTT topic" ;
  rdfs:domain :MQTTTopic ;
  rdfs:range xsd:string.

:MQTTTopicFilterPattern a owl:DatatypeProperty ;
  rdfs:label "MQTT Topic Filter Pattern" ;
  rdfs:comment "Pattern of MQTT topic filter" ;
  rdfs:domain :MQTTTopicFilter ;
  rdfs:range xsd:string.

:MQTTControlPacketPacketIdentifier a owl:DatatypeProperty ;
  rdfs:label "MQTT Control Packet Packet Identifier" ;
  rdfs:comment "Identifier of MQTT control packet" ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range xsd:integer.