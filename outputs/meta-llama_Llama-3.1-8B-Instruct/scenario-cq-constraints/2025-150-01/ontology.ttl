@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.
@prefix mqtt: <http://example.org/mqtt#>.
@prefix qos:  <http://example.org/qos#>.
@prefix sosa: <http://www.opengis.net/def/property/OGC/0/0616/>.
@prefix qudt: <http://qudt.org/>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT message protocol for IoT and industrial settings".

:MQTTClient a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Client in MQTT message protocol".

:MQTTBroker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Broker in MQTT message protocol".

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "Network connection in MQTT message protocol".

:MQTTParticipant a owl:Class ;
  rdfs:label "MQTT Participant" ;
  rdfs:comment "Participant in MQTT message protocol".

:MQTTClientID a owl:DatatypeProperty ;
  rdfs:label "MQTT Client ID" ;
  rdfs:comment "Client ID in MQTT message protocol" ;
  domain :MQTTClient ;
  range xsd:string.

:MQTTNetworkConnectionTLS a owl:DatatypeProperty ;
  rdfs:label "MQTT Network Connection TLS" ;
  rdfs:comment "TLS status of MQTT network connection" ;
  domain :MQTTNetworkConnection ;
  range xsd:boolean.

:MQTTNetworkConnectionInitiator a owl:DatatypeProperty ;
  rdfs:label "MQTT Network Connection Initiator" ;
  rdfs:comment "Initiator of MQTT network connection" ;
  domain :MQTTNetworkConnection ;
  range :MQTTParticipant.

:MQTTNetworkConnectionAccepted a owl:DatatypeProperty ;
  rdfs:label "MQTT Network Connection Accepted" ;
  rdfs:comment "Accepted status of MQTT network connection" ;
  domain :MQTTNetworkConnection ;
  range xsd:boolean.

:MQTTTopic a owl:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "Topic in MQTT message protocol".

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "Topic filter in MQTT message protocol".

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "Control packet in MQTT message protocol".

:MQTTPublishPacket a owl:Class ;
  rdfs:label "MQTT Publish Packet" ;
  rdfs:comment "Publish packet in MQTT message protocol".

:MQTTSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "SUBSCRIBE packet in MQTT message protocol".

:MQTTUnsubscribePacket a owl:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "UNSUBSCRIBE packet in MQTT message protocol".

:MQTTClient a owl:disjointWith :MQTTBroker.

:MQTTClientID rdfs:subPropertyOf :MQTTClient.
:MQTTNetworkConnectionTLS rdfs:subPropertyOf :MQTTNetworkConnection.
:MQTTNetworkConnectionInitiator rdfs:subPropertyOf :MQTTNetworkConnection.
:MQTTNetworkConnectionAccepted rdfs:subPropertyOf :MQTTNetworkConnection.

:MQTTTopic rdfs:subClassOf :MQTTParticipant.
:MQTTTopicFilter rdfs:subClassOf :MQTTTopic.
:MQTTControlPacket rdfs:subClassOf :MQTTParticipant.
:MQTTPublishPacket rdfs:subClassOf :MQTTControlPacket.
:MQTTSUBSCRIBEPacket rdfs:subClassOf :MQTTControlPacket.
:MQTTUnsubscribePacket rdfs:subClassOf :MQTTControlPacket.

:MQTTClientID rdfs:domain :MQTTClient.
:MQTTNetworkConnectionTLS rdfs:domain :MQTTNetworkConnection.