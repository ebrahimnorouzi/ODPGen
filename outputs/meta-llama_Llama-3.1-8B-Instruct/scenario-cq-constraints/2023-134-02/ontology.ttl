@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Type of action performed on the data".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "Entity interacting with the data".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "Log entry".

:Timestamp a owl:DatatypeProperty ;
  rdfs:label "Timestamp" ;
  rdfs:comment "Timestamp of the log entry" ;
  owl:datatype xsd:dateTime ;
  owl:domain :Log ;
  owl:range xsd:dateTime.

:Issuer a owl:ObjectProperty ;
  rdfs:label "Issuer" ;
  rdfs:comment "Entity publishing the log" ;
  owl:domain :Log ;
  owl:range :Entity.

:DataLocation a owl:ObjectProperty ;
  rdfs:label "Data Location" ;
  rdfs:comment "Location where the data is being stored" ;
  owl:domain :Data ;
  owl:range :Location.

:Application a owl:ObjectProperty ;
  rdfs:label "Application" ;
  rdfs:comment "Application/service generating the data" ;
  owl:domain :Data ;
  owl:range :Application.

:ActionType a owl:DatatypeProperty ;
  rdfs:label "Action Type" ;
  rdfs:comment "Type of action performed on the data" ;
  owl:domain :Action ;
  owl:range xsd:string.

:EntityRole a owl:DatatypeProperty ;
  rdfs:label "Entity Role" ;
  rdfs:comment "Role of the entity interacting with the data" ;
  owl:domain :Entity ;
  owl:range xsd:string.

:DataCategory a owl:Class ;
  rdfs:label "Data Category" ;
  rdfs:comment "Category of the data".

:DataHandlingPractice a owl:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "Practice of handling data".

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "Privacy policy of the entity".

:ConsentRecord a owl:Class ;
  rdfs:label "Consent Record" ;
  rdfs:comment "Record of consent".

:Provenance a owl:Class ;
  rdfs:label "Provenance" ;
  rdfs:comment "Provenance metadata".

:LegalCompliance a owl:Class ;
  rdfs:label "Legal Compliance" ;
  rdfs:comment "Legal compliance information".