@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Authorship and Pseudonyms" ;
  rdfs:comment "Modeling authorship and pseudonyms in literature".

:Author a owl:Class ;
  rdfs:label "Author" ;
  rdfs:comment "A person who writes books".

:Pseudonym a owl:Class ;
  rdfs:label "Pseudonym" ;
  rdfs:comment "A name used by an author to publish books".

:Book a owl:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A written work".

:Publishes a owl:ObjectProperty ;
  rdfs:label "Publishes" ;
  rdfs:comment "An author publishes a book" ;
  rdfs:domain :Author ;
  rdfs:range :Book.

:Uses a owl:ObjectProperty ;
  rdfs:label "Uses" ;
  rdfs:comment "An author uses a pseudonym to publish a book" ;
  rdfs:domain :Author ;
  rdfs:range :Pseudonym.

:HasName a owl:DatatypeProperty ;
  rdfs:label "Has Name" ;
  rdfs:comment "A name associated with an author or pseudonym" ;
  rdfs:domain :Author ;
  rdfs:domain :Pseudonym ;
  rdfs:range xsd:string.

:Title a owl:DatatypeProperty ;
  rdfs:label "Title" ;
  rdfs:comment "The title of a book" ;
  rdfs:domain :Book ;
  rdfs:range xsd:string.

:Authorship a owl:Class ;
  rdfs:label "Authorship" ;
  rdfs:comment "The relationship between an author and their books".

:Authorship a owl:equivalentClass :Publishes.

:Authorship a owl:disjointWith :Uses.

:Authorship a owl:disjointWith :HasName.

:Authorship a owl:disjointWith :Title.