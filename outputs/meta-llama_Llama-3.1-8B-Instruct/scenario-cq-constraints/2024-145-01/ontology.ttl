@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Court and Bad Check Ontology" ;
  rdfs:comment "Ontology for court and bad check information".

:State a owl:Class ;
  rdfs:label "State" ;
  rdfs:comment "A state in the United States".

:DistrictCourt a owl:Class ;
  rdfs:label "District Court" ;
  rdfs:comment "A district court in the United States" ;
  rdfs:subClassOf :Court.

:Court a owl:Class ;
  rdfs:label "Court" ;
  rdfs:comment "A court in the United States".

:StateOfIndia a owl:Class ;
  rdfs:label "State of India" ;
  rdfs:comment "A state in India".

:District a owl:Class ;
  rdfs:label "District" ;
  rdfs:comment "A district in a state".

:BadCheck a owl:Class ;
  rdfs:label "Bad Check" ;
  rdfs:comment "A bad check transaction".

:CheckTransactionType a owl:Class ;
  rdfs:label "Check Transaction Type" ;
  rdfs:comment "The type of check transaction".

:CheckPayment a owl:Class ;
  rdfs:label "Check Payment" ;
  rdfs:comment "A check payment".

:TransactionStatus a owl:Class ;
  rdfs:label "Transaction Status" ;
  rdfs:comment "The status of a transaction".

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "has District" ;
  rdfs:comment "A district court is located in a district" ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :District.

:locatedIn a owl:ObjectProperty ;
  rdfs:label "located in" ;
  rdfs:comment "A district court is located in a state" ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :State.

:hasAuthority a owl:ObjectProperty ;
  rdfs:label "has authority over" ;
  rdfs:comment "A court has authority over another court" ;
  rdfs:domain :Court ;
  rdfs:range :Court.

:checkTransactionType a owl:DatatypeProperty ;
  rdfs:label "check transaction type" ;
  rdfs:comment "The type of check transaction" ;
  rdfs:domain :BadCheck ;
  rdfs:range xsd:string.

:paymentDate a owl:DatatypeProperty ;
  rdfs:label "payment date" ;
  rdfs:comment "The date of a check payment" ;
  rdfs:domain :CheckPayment ;
  rdfs:range xsd:date.

:transactionStatus a owl:DatatypeProperty ;
  rdfs:label "transaction status" ;
  rdfs:comment "The status of a transaction" ;
  rdfs:domain :CheckPayment ;
  rdfs:range :TransactionStatus.