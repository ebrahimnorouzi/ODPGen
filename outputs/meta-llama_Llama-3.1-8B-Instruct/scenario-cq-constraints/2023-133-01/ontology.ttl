@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case Ontology" ;
  rdfs:comment "Ontology for reasoning about the cause of a slippery pavement".

:WeatherCondition a rdfs:Class ;
  rdfs:label "Weather Condition" ;
  rdfs:comment "Weather condition such as rainy season or rain".

:SprinklerStatus a rdfs:Class ;
  rdfs:label "Sprinkler Status" ;
  rdfs:comment "Status of the sprinkler system, either on or off".

:PavementCondition a rdfs:Class ;
  rdfs:label "Pavement Condition" ;
  rdfs:comment "Condition of the pavement, either wet or slippery".

:WeatherEvent a rdfs:Class ;
  rdfs:label "Weather Event" ;
  rdfs:comment "Event related to weather, such as rainy season or rain".

:SprinklerEvent a rdfs:Class ;
  rdfs:label "Sprinkler Event" ;
  rdfs:comment "Event related to the sprinkler system, either on or off".

:PavementEvent a rdfs:Class ;
  rdfs:label "Pavement Event" ;
  rdfs:comment "Event related to the pavement, either wet or slippery".

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "Causal relation between events" ;
  rdfs:domain :WeatherEvent ;
  rdfs:range :PavementEvent.

:effectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "Weight of the causal effect" ;
  rdfs:domain :causes ;
  rdfs:range xsd:float.

:hasSprinklerStatus a owl:ObjectProperty ;
  rdfs:label "has Sprinkler Status" ;
  rdfs:comment "Relation between sprinkler system and its status" ;
  rdfs:domain :SprinklerEvent ;
  rdfs:range :SprinklerStatus.

:hasPavementCondition a owl:ObjectProperty ;
  rdfs:label "has Pavement Condition" ;
  rdfs:comment "Relation between pavement and its condition" ;
  rdfs:domain :PavementEvent ;
  rdfs:range :PavementCondition.

:isWet a owl:ObjectProperty ;
  rdfs:label "is Wet" ;
  rdfs:comment "Relation between pavement and its wet condition" ;
  rdfs:domain :PavementEvent ;
  rdfs:range :WeatherEvent.

:isSlippery a owl:ObjectProperty ;
  rdfs:label "is Slippery" ;
  rdfs:comment "Relation between pavement and its slippery condition" ;
  rdfs:domain :PavementEvent ;
  rdfs:range :WeatherEvent.