@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case Ontology" ;
  rdfs:comment "Reasoning about the cause of a slippery pavement".

:WeatherEvent a owl:Class ;
  rdfs:label "Weather Event" ;
  rdfs:comment "An event related to weather".

:RainySeason a owl:Class ;
  rdfs:label "Rainy Season" ;
  rdfs:comment "A season with significant rainfall" ;
  rdfs:subClassOf :WeatherEvent.

:SprinklerStatus a owl:Class ;
  rdfs:label "Sprinkler Status" ;
  rdfs:comment "The status of the sprinkler system".

:On a owl:DatatypeProperty ;
  rdfs:label "Sprinkler Status: On" ;
  rdfs:comment "The sprinkler system is on" ;
  rdfs:domain :SprinklerStatus ;
  rdfs:range xsd:boolean.

:Rain a owl:Class ;
  rdfs:label "Rain" ;
  rdfs:comment "Precipitation in the form of water" ;
  rdfs:subClassOf :WeatherEvent.

:PavementCondition a owl:Class ;
  rdfs:label "Pavement Condition" ;
  rdfs:comment "The state of the pavement".

:Wet a owl:DatatypeProperty ;
  rdfs:label "Pavement Condition: Wet" ;
  rdfs:comment "The pavement is wet" ;
  rdfs:domain :PavementCondition ;
  rdfs:range xsd:boolean.

:Slippery a owl:DatatypeProperty ;
  rdfs:label "Pavement Condition: Slippery" ;
  rdfs:comment "The pavement is slippery" ;
  rdfs:domain :PavementCondition ;
  rdfs:range xsd:boolean.

:CausalLink a owl:ObjectProperty ;
  rdfs:label "Causal Link" ;
  rdfs:comment "A causal relation between events" ;
  rdfs:domain :WeatherEvent ;
  rdfs:range :WeatherEvent.

:EffectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The strength of the causal link" ;
  rdfs:domain :CausalLink ;
  rdfs:range xsd:float.

:Mediates a owl:ObjectProperty ;
  rdfs:label "Mediates" ;
  rdfs:comment "An intermediate event in a causal chain" ;
  rdfs:domain :CausalLink ;
  rdfs:range :WeatherEvent.

:Outcome a owl:ObjectProperty ;
  rdfs:label "Outcome" ;
  rdfs:comment "The effect of an event on another event" ;
  rdfs:domain :WeatherEvent ;
  rdfs:range :WeatherEvent.

:TurnOn a owl:DatatypeProperty ;
  rdfs:label "Turn On/Off" ;
  rdfs:comment "The outcome of turning the sprinkler system on/off" ;
  rdfs:domain :WeatherEvent ;
  rdfs:range xsd:boolean.

:WeatherEvent :WeatherEvent.
:RainySeason :WeatherEvent.
:SprinklerStatus :WeatherEvent.
:Rain :WeatherEvent.
:PavementCondition :WeatherEvent.
:Wet :PavementCondition.
:Slippery :PavementCondition.
:CausalLink :WeatherEvent.
:EffectWeight :CausalLink.
:Mediates :CausalLink.
:Outcome :WeatherEvent.
:TurnOn :WeatherEvent.