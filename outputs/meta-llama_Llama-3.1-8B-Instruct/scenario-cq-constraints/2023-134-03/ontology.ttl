@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Challenge a owl:Class ;
  rdfs:label "Challenge" ;
  rdfs:comment "A challenge in governance patterns for Solid apps".

:Challenge1 a owl:Class ;
  rdfs:label "Identity of Solid Actors and Roles" ;
  rdfs:comment "Challenge 1: Identity of Solid actors and their roles is unknown" ;
  rdfs:subClassOf :Challenge.

:Challenge2 a owl:Class ;
  rdfs:label "No Metadata about Solid Infrastructure" ;
  rdfs:comment "Challenge 2: No metadata about Solid infrastructure" ;
  rdfs:subClassOf :Challenge.

:Challenge3 a owl:Class ;
  rdfs:label "Availability/Discovery of Categories of Data" ;
  rdfs:comment "Challenge 3: Availability/Discovery of categories of data" ;
  rdfs:subClassOf :Challenge.

:Challenge4 a owl:Class ;
  rdfs:label "Pod and App Providers' Data Handling Practices" ;
  rdfs:comment "Challenge 4: Pod and app providers do not provide information on their data handling practices" ;
  rdfs:subClassOf :Challenge.

:Challenge5 a owl:Class ;
  rdfs:label "Users' Privacy Policies" ;
  rdfs:comment "Challenge 5: Users cannot express their privacy policies" ;
  rdfs:subClassOf :Challenge.

:Challenge6 a owl:Class ;
  rdfs:label "No Logging or Record-Keeping" ;
  rdfs:comment "Challenge 6: No logging or record-keeping" ;
  rdfs:subClassOf :Challenge.

:Challenge7 a owl:Class ;
  rdfs:label "No Legal Compliance Checks" ;
  rdfs:comment "Challenge 7: No legal compliance checks" ;
  rdfs:subClassOf :Challenge.

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry for governance patterns in Solid apps".

:RegistryMaintainer a owl:Class ;
  rdfs:label "Registry Maintainer" ;
  rdfs:comment "The entity maintaining the registry" ;
  rdfs:subClassOf :Registry.

:RegistryCreationDate a owl:DatatypeProperty ;
  rdfs:label "Registry Creation Date" ;
  rdfs:comment "The date the registry was created or updated" ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date.

:DataType a owl:Class ;
  rdfs:label "Data Type" ;
  rdfs:comment "A type of data available in the registry".

:DataStorageLocation a owl:ObjectProperty ;
  rdfs:label "Data Storage Location" ;
  rdfs:comment "The location where a specific type of data is being stored" ;
  rdfs:domain :DataType ;
  rdfs:range :Registry.

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy associated with the data".

:PolicyAssociation a owl:ObjectProperty ;
  rdfs:label "Policy Association" ;
  rdfs:comment "The association between a policy and the data" ;
  rdfs:domain :Policy ;
  rdfs:range :DataType.