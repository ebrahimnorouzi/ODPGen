@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "Ontology for modeling asthma patient data and causal relations.".

:AsthmaPatient a owl:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A patient with asthma.".

:AsthmaSymptom a owl:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "A symptom of asthma, such as cough or wheezing.".

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication taken by the patient.".

:OutdoorAllergen a owl:Class ;
  rdfs:label "Outdoor Allergen" ;
  rdfs:comment "An outdoor allergen, such as pollen or AQI.".

:hasSymptom a owl:ObjectProperty ;
  rdfs:label "has Symptom" ;
  rdfs:comment "The patient has a symptom." ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:hasMedication a owl:ObjectProperty ;
  rdfs:label "has Medication" ;
  rdfs:comment "The patient takes a medication." ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "The presence of an allergen causes a symptom or medication intake." ;
  rdfs:domain :OutdoorAllergen ;
  rdfs:range :AsthmaSymptom.

:hasEffectWeight a owl:ObjectProperty ;
  rdfs:label "has Effect Weight" ;
  rdfs:comment "The effect weight of a causal relation." ;
  rdfs:domain :causes ;
  rdfs:range xsd:float.

:hasCausalEffect a owl:ObjectProperty ;
  rdfs:label "has Causal Effect" ;
  rdfs:comment "The causal effect of a symptom or medication intake." ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range xsd:float.

:hasProbableCause a owl:ObjectProperty ;
  rdfs:label "has Probable Cause" ;
  rdfs:comment "The probable cause of a symptom." ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range :OutdoorAllergen.