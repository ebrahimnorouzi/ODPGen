@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "Ontology for kHealth-Asthma project".

:AsthmaPatient a owl:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "Patient with asthma".

:AsthmaSymptom a owl:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "Symptoms of asthma".

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "Medications for asthma".

:OutdoorAllergen a owl:Class ;
  rdfs:label "Outdoor Allergen" ;
  rdfs:comment "Outdoor environmental allergens".

:EffectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "Weight of effect" ;
  rdfs:range xsd:float.

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "Causal relation" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom ;
  owl:inverseOf :isCausedBy.

:isCausedBy a owl:ObjectProperty ;
  rdfs:label "is Caused By" ;
  rdfs:comment "Inverse of causes" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range :AsthmaPatient ;
  owl:inverseOf :causes.

:hasMedication a owl:ObjectProperty ;
  rdfs:label "has Medication" ;
  rdfs:comment "Medication intake" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:hasSymptom a owl:ObjectProperty ;
  rdfs:label "has Symptom" ;
  rdfs:comment "Asthma symptom" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:hasAllergen a owl:ObjectProperty ;
  rdfs:label "has Allergen" ;
  rdfs:comment "Outdoor environmental allergen" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :OutdoorAllergen.