@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Relational Database Access Policy Ontology" ;
  rdfs:comment "Ontology for modeling relational database access policies.".

:Database a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A relational database.".

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "A table in a relational database." ;
  rdfs:subClassOf :Database.

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "A column in a table." ;
  rdfs:subClassOf :Table.

:PrimaryKey a owl:Class ;
  rdfs:label "Primary Key" ;
  rdfs:comment "A primary key in a table." ;
  rdfs:subClassOf :Column.

:ForeignKey a owl:Class ;
  rdfs:label "Foreign Key" ;
  rdfs:comment "A foreign key in a table." ;
  rdfs:subClassOf :Column.

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy for database access.".

:Agent a owl:Class ;
  rdfs:label "Agent" ;
  rdfs:comment "An agent that can execute a policy.".

:ReadAction a owl:Class ;
  rdfs:label "Read Action" ;
  rdfs:comment "A read action in a policy.".

:ModifyAction a owl:Class ;
  rdfs:label "Modify Action" ;
  rdfs:comment "A modify action in a policy.".

:ViewActionScope a owl:Class ;
  rdfs:label "View Action Scope" ;
  rdfs:comment "A view action scope in a policy.".

:ProcessActionScope a owl:Class ;
  rdfs:label "Process Action Scope" ;
  rdfs:comment "A process action scope in a policy.".

:TablePolicy a owl:Class ;
  rdfs:label "Table Policy" ;
  rdfs:comment "A policy defined at table level." ;
  rdfs:subClassOf :Policy.

:ColumnPolicy a owl:Class ;
  rdfs:label "Column Policy" ;
  rdfs:comment "A policy defined at column level." ;
  rdfs:subClassOf :Policy.

:RowPolicy a owl:Class ;
  rdfs:label "Row Policy" ;
  rdfs:comment "A policy defined at row level." ;
  rdfs:subClassOf :Policy.

:ProhibitedModifyAction a owl:Class ;
  rdfs:label "Prohibited Modify Action" ;
  rdfs:comment "A prohibited modify action on a table." ;
  rdfs:subClassOf :ModifyAction.

:TableReadProhibition a owl:Class ;
  rdfs:label "Table Read Prohibition" ;
  rdfs:comment "A table-level read prohibition for processing." ;
  rdfs:subClassOf :ReadAction.

:TableReadProhibitionForViewing a owl:Class ;
  rdfs:label "Table Read Prohibition for Viewing" ;
  rdfs:comment "A table-level read prohibition for viewing." ;
  rdfs:subClassOf :ReadAction.

:ConditionalRowLevelReadRestriction a owl:Class ;
  rdfs:label "Conditional Row-Level Read Restriction" ;
  rdfs:comment "A conditional row-level read restriction for later enforcement." ;
  rdfs:subClassOf :ReadAction.

:SQLQuery a owl:Class ;
  rdfs:label "SQL Query" ;
  rdfs:comment "A SQL query as an AST-based semantic graph.".

:SelectStatement a owl:Class ;
  rdfs:label "Select Statement" ;
  rdfs:comment "A select statement in a SQL query." ;
  rdfs:subClassOf :SQLQuery.

:UpdateStatement a owl:Class ;
  rdfs:label "Update Statement" ;
  rdfs:comment "An update statement in a SQL query." ;
  rdfs:subClassOf :SQLQuery.