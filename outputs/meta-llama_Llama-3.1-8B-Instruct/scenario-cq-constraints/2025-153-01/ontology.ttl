@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Temporal Identifier Ontology" ;
  rdfs:comment "Modeling temporal indirection in financial information systems".

:TemporalIdentifier a owl:Class ;
  rdfs:label "Temporal Identifier" ;
  rdfs:comment "Persistent identifier for dynamic referents".

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "Entity referenced by a temporal identifier".

:Timestamp a owl:Class ;
  rdfs:label "Timestamp" ;
  rdfs:comment "Instant in time".

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "Change in referent over time".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Real-time market attribute associated with a referent".

:TemporalBinding a owl:Class ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "Association between a temporal identifier and a referent at a timestamp".

:TransitionRule a owl:Class ;
  rdfs:label "Transition Rule" ;
  rdfs:comment "Rule triggering a referent transition".

:TemporalIdentifierReference a owl:ObjectProperty ;
  rdfs:label "References" ;
  rdfs:comment "Temporal identifier referencing a referent" ;
  domain :TemporalIdentifier ;
  range :Referent.

:TemporalBindingTimestamp a owl:ObjectProperty ;
  rdfs:label "At Timestamp" ;
  rdfs:comment "Temporal binding associated with a timestamp" ;
  domain :TemporalBinding ;
  range :Timestamp.

:TemporalBindingTransition a owl:ObjectProperty ;
  rdfs:label "Transition" ;
  rdfs:comment "Temporal binding associated with a transition" ;
  domain :TemporalBinding ;
  range :Transition.

:ObservationReferent a owl:ObjectProperty ;
  rdfs:label "Associated with" ;
  rdfs:comment "Observation associated with a referent" ;
  domain :Observation ;
  range :Referent.

:TransitionRuleTriggered a owl:ObjectProperty ;
  rdfs:label "Triggered by" ;
  rdfs:comment "Transition rule triggered by a temporal binding" ;
  domain :TransitionRule ;
  range :TemporalBinding.