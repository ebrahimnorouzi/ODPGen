@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "Scientific survey activity performed on a cultural property or feature of interest.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Result of a survey or investigation activity.".

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "Investigation technique adopted in a survey or investigation activity.".

:EquipmentConfiguration a owl:Class ;
  rdfs:label "Equipment Configuration" ;
  rdfs:comment "Hardware, software, and technical configurations used to conduct a survey.".

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "Person participating in a survey or investigation activity.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Position or function of an expert in a survey or investigation activity.".

:Acquisition a owl:Class ;
  rdfs:label "Acquisition" ;
  rdfs:comment "Process of obtaining data or observations during a survey.".

:Parameter a owl:Class ;
  rdfs:label "Parameter" ;
  rdfs:comment "Characteristic of an acquisition, such as exposure time or ISO.".

:PostProcessedOutput a owl:Class ;
  rdfs:label "Post-Processed Output" ;
  rdfs:comment "Result of processing observations or data from a survey.".

:Claim a owl:Class ;
  rdfs:label "Claim" ;
  rdfs:comment "Interpretation or conclusion supported by observations from a survey.".

:hasMethod a owl:ObjectProperty ;
  rdfs:label "has Method" ;
  rdfs:comment "Relationship between a survey and the method adopted." ;
  rdfs:domain :Survey ;
  rdfs:range :Method.

:hasObservation a owl:ObjectProperty ;
  rdfs:label "has Observation" ;
  rdfs:comment "Relationship between a survey and the observations produced." ;
  rdfs:domain :Survey ;
  rdfs:range :Observation.

:hasExpert a owl:ObjectProperty ;
  rdfs:label "has Expert" ;
  rdfs:comment "Relationship between a survey and the experts participating." ;
  rdfs:domain :Survey ;
  rdfs:range :Expert.

:hasRole a owl:ObjectProperty ;
  rdfs:label "has Role" ;
  rdfs:comment "Relationship between an expert and their role in a survey." ;
  rdfs:domain :Expert ;
  rdfs:range :Role.

:hasEquipmentConfiguration a owl:ObjectProperty ;
  rdfs:label "has Equipment Configuration" ;
  rdfs:comment "Relationship between a survey and the equipment configurations used." ;
  rdfs:domain :Survey ;
  rdfs:range :EquipmentConfiguration.

:hasAcquisition a owl:ObjectProperty ;
  rdfs:label "has Acquisition" ;
  rdfs:comment "Relationship between a survey and the acquisition process." ;
  rdfs:domain :Survey ;
  rdfs:range :Acquisition.

:hasParameter a owl:ObjectProperty ;
  rdfs:label "has Parameter" ;
  rdfs:comment "Relationship between an acquisition and its parameters." ;
  rdfs:domain :Acquisition ;
  rdfs:range :Parameter.

:hasPostProcessedOutput a owl:ObjectProperty ;
  rdfs:label "has Post-Processed Output" ;
  rdfs:comment "Relationship between a survey and the post-processed outputs." ;
  rdfs:domain :Survey ;
  rdfs:range :PostProcessedOutput.

:hasClaim a owl:ObjectProperty ;
  rdfs:label "has Claim" ;
  rdfs:comment "Relationship between a survey and the claims supported by observations." ;
  rdfs:domain :Survey ;
  rdfs:range :Claim.