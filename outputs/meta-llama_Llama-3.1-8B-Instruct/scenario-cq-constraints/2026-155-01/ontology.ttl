@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "Scientific survey activity performed on a cultural property or feature of interest.".

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "Investigation technique adopted in a survey or investigation activity.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Result of a survey or investigation activity.".

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "Person participating in a survey or investigation activity.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Position or function of an expert in a survey or investigation activity.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "Equipment used to conduct a survey or investigation activity.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "Technical configuration used to conduct a survey or investigation activity.".

:Acquisition a owl:Class ;
  rdfs:label "Acquisition" ;
  rdfs:comment "Process of collecting data during a survey or investigation activity.".

:Parameter a owl:Class ;
  rdfs:label "Parameter" ;
  rdfs:comment "Characteristic of an acquisition process.".

:Output a owl:Class ;
  rdfs:label "Output" ;
  rdfs:comment "Result of a post-processing activity.".

:Survey_has_Method :Survey :Method owl:hasPart ;
  rdfs:label "Survey has method" ;
  rdfs:comment "Relationship between a survey and its adopted method.".

:Survey_has_Observation :Survey :Observation owl:hasPart ;
  rdfs:label "Survey has observation" ;
  rdfs:comment "Relationship between a survey and its produced observations.".

:Survey_has_Expert :Survey :Expert :Role owl:hasPart ;
  rdfs:label "Survey has expert" ;
  rdfs:comment "Relationship between a survey and its participating experts.".

:Survey_has_Hardware :Survey :Hardware owl:hasPart ;
  rdfs:label "Survey has hardware" ;
  rdfs:comment "Relationship between a survey and its used equipment.".

:Survey_has_Software :Survey :Software owl:hasPart ;
  rdfs:label "Survey has software" ;
  rdfs:comment "Relationship between a survey and its used technical configurations.".

:Observation_has_Parameter :Observation :Parameter owl:hasPart ;
  rdfs:label "Observation has parameter" ;
  rdfs:comment "Relationship between an observation and its characterising parameters.".

:Acquisition_has_Parameter :Acquisition :Parameter owl:hasPart ;
  rdfs:label "Acquisition has parameter" ;
  rdfs:comment "Relationship between an acquisition process and its characterising parameters.".

:Output_has_Acquisition :Output :Acquisition owl:hasPart ;
  rdfs:label "Output has acquisition" ;
  rdfs:comment "Relationship between a post-processing output and its underlying acquisition activity.".