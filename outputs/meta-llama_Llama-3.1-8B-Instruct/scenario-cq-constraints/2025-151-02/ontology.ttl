@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "Ontology for representing information aiding the evaluation of ODRL Policies.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "Time point or duration.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Geographical location.".

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Resource or item being managed.".

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "Individual or organization involved in a policy.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Event or activity related to a policy.".

:RuleExercise a owl:Class ;
  rdfs:label "Rule Exercise" ;
  rdfs:comment "Instance of a rule being applied.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Occurrence or situation related to a policy.".

:Recipient a owl:Class ;
  rdfs:label "Recipient" ;
  rdfs:comment "Individual or group receiving the result of a rule.".

:FinancialPayment a owl:Class ;
  rdfs:label "Financial Payment" ;
  rdfs:comment "Transaction involving monetary exchange.".

:hasTime rdf:type owl:DatatypeProperty ;
  rdfs:label "has Time" ;
  rdfs:comment "Time point or duration associated with an event." ;
  rdfs:domain :Event ;
  rdfs:range xsd:dateTime.

:hasLocation rdf:type owl:DatatypeProperty ;
  rdfs:label "has Location" ;
  rdfs:comment "Geographical location associated with an event." ;
  rdfs:domain :Event ;
  rdfs:range :Location.

:hasAsset rdf:type owl:DatatypeProperty ;
  rdfs:label "has Asset" ;
  rdfs:comment "Resource or item being managed associated with a policy." ;
  rdfs:domain :Policy ;
  rdfs:range :Asset.

:hasParty rdf:type owl:DatatypeProperty ;
  rdfs:label "has Party" ;
  rdfs:comment "Individual or organization involved in a policy." ;
  rdfs:domain :Policy ;
  rdfs:range :Party.

:hasAction rdf:type owl:DatatypeProperty ;
  rdfs:label "has Action" ;
  rdfs:comment "Event or activity related to a policy." ;
  rdfs:domain :Policy ;
  rdfs:range :Action.

:hasRuleExercise rdf:type owl:DatatypeProperty ;
  rdfs:label "has Rule Exercise" ;
  rdfs:comment "Instance of a rule being applied." ;
  rdfs:domain :Policy ;
  rdfs:range :RuleExercise.

:hasRecipient rdf:type owl:DatatypeProperty ;
  rdfs:label "has Recipient" ;
  rdfs:comment "Individual or group receiving the result of a rule." ;
  rdfs:domain :RuleExercise ;
  rdfs:range :Recipient.

:hasFinancialPayment rdf:type owl:DatatypeProperty ;
  rdfs:label "has Financial Payment" ;
  rdfs:comment "Transaction involving monetary exchange." ;
  rdfs:domain :Policy ;
  rdfs:range :FinancialPayment.