@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "Formalized conceptual model for representing ships and their properties.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes.".

:ShipDimension a owl:Class ;
  rdfs:label "Ship Dimension" ;
  rdfs:comment "Description of a ship's dimensions.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Information about a ship's typical location.".

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "Entity that owns a ship.".

:Speed a owl:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "Average speed over ground of a ship.".

:ContainerShip a owl:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "Ship used for transporting containers.".

:GermanFlag a owl:Class ;
  rdfs:label "German Flag" ;
  rdfs:comment "Flag under which a ship is registered.".

:GPSAntenna a owl:Class ;
  rdfs:label "GPS Antenna" ;
  rdfs:comment "Device used to receive GPS signals.".

:ShipRoute a owl:Class ;
  rdfs:label "Ship Route" ;
  rdfs:comment "Information about a ship's route.".

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "Description of a ship's trajectory.".

:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "System used to propel a ship.".

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "Device used to power a ship's propulsion system.".

:PowerSource a owl:Class ;
  rdfs:label "Power Source" ;
  rdfs:comment "Source of energy used to power a ship's propulsion system.".

:Propeller a owl:Class ;
  rdfs:label "Propeller" ;
  rdfs:comment "Device used to convert energy into motion.".

:BladedPropulsor a owl:Class ;
  rdfs:label "Bladed Propulsor" ;
  rdfs:comment "Type of propulsor that uses blades.".

:JetPropulsor a owl:Class ;
  rdfs:label "Jet Propulsor" ;
  rdfs:comment "Type of propulsor that uses jets.".

:Sail a owl:Class ;
  rdfs:label "Sail" ;
  rdfs:comment "Device used to harness wind energy.".

:WindAssistedPropulsion a owl:Class ;
  rdfs:label "Wind Assisted Propulsion" ;
  rdfs:comment "Type of propulsion that uses wind energy.".

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Information used to represent a ship.".

:SonarData a owl:Class ;
  rdfs:label "Sonar Data" ;
  rdfs:comment "Information about a ship's sonar signature.".

:Image a owl:Class ;
  rdfs:label "Image" ;
  rdfs:comment "Visual representation of a ship.".

:Text a owl:Class ;
  rdfs:label "Text" ;
  rdfs:comment "Written description of a ship.".

:Sound a owl:Class ;
  rdfs:label "Sound" ;
  rdfs:comment "Audio representation of a ship.".

:hasDimension :ShipDimension ;
  rdfs:label "has dimension" ;
  rdfs:comment "A ship has dimensions.".

:hasLocation :Location ;
  rdfs:label "has location" ;
  rdfs:comment "A ship has a typical location.".

:hasOwner :Owner ;
  rdfs:label "has owner" ;
  rdfs:comment "A ship has an owner.".