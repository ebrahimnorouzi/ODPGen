@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "Formalized conceptual model for representing ships and their properties.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes.".

:VesselCharacteristic a owl:Class ;
  rdfs:label "Vessel Characteristic" ;
  rdfs:comment "A property of a ship, such as its dimensions or speed.".

:Dimension a owl:Class ;
  rdfs:label "Dimension" ;
  rdfs:comment "A measurement of a ship's size.".

:Length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "The length of a ship." ;
  domain :Ship ;
  range xsd:double.

:Width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "The width of a ship." ;
  domain :Ship ;
  range xsd:double.

:Height a owl:DatatypeProperty ;
  rdfs:label "Height" ;
  rdfs:comment "The height of a ship." ;
  domain :Ship ;
  range xsd:double.

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A point on the Earth's surface.".

:Latitude a owl:DatatypeProperty ;
  rdfs:label "Latitude" ;
  rdfs:comment "The latitude of a ship's location." ;
  domain :Location ;
  range xsd:double.

:Longitude a owl:DatatypeProperty ;
  rdfs:label "Longitude" ;
  rdfs:comment "The longitude of a ship's location." ;
  domain :Location ;
  range xsd:double.

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "A person or organization that owns a ship.".

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A human being.".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "A group of people or entities that work together.".

:Speed a owl:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "A measure of a ship's velocity.".

:AverageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "The average speed of a ship over a period of time." ;
  domain :Ship ;
  range xsd:double.

:ContainerShip a owl:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "A type of ship used for transporting containers." ;
  subClassOf :Ship.

:GPSAntenna a owl:Class ;
  rdfs:label "GPS Antenna" ;
  rdfs:comment "A device used to receive GPS signals.".

:Placement a owl:Class ;
  rdfs:label "Placement" ;
  rdfs:comment "The position of a GPS antenna on a ship.".

:Bow a owl:Class ;
  rdfs:label "Bow" ;
  rdfs:comment "The front of a ship.".

:Stern a owl:Class ;
  rdfs:label "Stern" ;
  rdfs:comment "The back of a ship.".

:Port a owl:Class ;
  rdfs:label "Port" ;
  rdfs:comment "The left side of a ship.".

:Starboard a owl:Class ;
  rdfs:label "Starboard" ;
  rdfs:comment "The right side of a ship.".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "A group of people or entities that work together.".

:ShipRoute a owl:Class ;
  rdfs:label "Ship Route" ;
  rdfs:comment "A path followed by a ship.".

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "A sequence of points in space.".