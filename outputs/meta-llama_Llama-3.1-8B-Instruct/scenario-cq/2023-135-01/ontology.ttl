@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Authorship and Pseudonyms Ontology" ;
  rdfs:comment "An ontology for modeling authorship and pseudonyms.".

:Author a owl:Class ;
  rdfs:label "Author" ;
  rdfs:comment "An individual who creates literary works.".

:Name a owl:Class ;
  rdfs:label "Name" ;
  rdfs:comment "A label or identifier used to refer to an individual.".

:Pseudonym a owl:Class ;
  rdfs:label "Pseudonym" ;
  rdfs:comment "A name used by an author to conceal their identity.".

:Book a owl:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A written or printed work consisting of pages glued or sewn together.".

:Published a owl:ObjectProperty ;
  rdfs:label "Published" ;
  rdfs:comment "The act of making a book available to the public." ;
  rdfs:domain :Author ;
  rdfs:range :Book.

:Uses a owl:ObjectProperty ;
  rdfs:label "Uses" ;
  rdfs:comment "The act of adopting a pseudonym." ;
  rdfs:domain :Author ;
  rdfs:range :Pseudonym.

:HasName a owl:ObjectProperty ;
  rdfs:label "Has Name" ;
  rdfs:comment "The relationship between an individual and their name." ;
  rdfs:domain :Author ;
  rdfs:range :Name.

:Authorship a owl:Class ;
  rdfs:label "Authorship" ;
  rdfs:comment "The act of creating a literary work.".

:BookTitle a owl:Class ;
  rdfs:label "Book Title" ;
  rdfs:comment "The title of a book.".

:Title a owl:ObjectProperty ;
  rdfs:label "Title" ;
  rdfs:comment "The name given to a book." ;
  rdfs:domain :Book ;
  rdfs:range :BookTitle.

:AuthorshipOf a owl:ObjectProperty ;
  rdfs:label "Authorship Of" ;
  rdfs:comment "The relationship between an author and their literary work." ;
  rdfs:domain :Author ;
  rdfs:range :Book.

:C. S. Lewis a owl:NamedIndividual ;
  rdfs:label "C. S. Lewis" ;
  rdfs:comment "A renowned author.".

:Spirit in Bondage a owl:NamedIndividual ;
  rdfs:label "Spirit in Bondage" ;
  rdfs:comment "A collection of poems.".

:PublishedBy a owl:ObjectProperty ;
  rdfs:label "Published By" ;
  rdfs:comment "The act of publishing a book." ;
  rdfs:domain :Book ;
  rdfs:range :Author.

:C. S. Lewis :Uses :Pseudonym1.
:Spirit in Bondage :PublishedBy :C. S. Lewis.
:Spirit in Bondage :Title "Spirit in Bondage".