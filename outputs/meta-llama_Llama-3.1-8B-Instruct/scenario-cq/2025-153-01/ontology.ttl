@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Temporal Identifier Ontology" ;
  rdfs:comment "Ontology for temporal identifiers and their referents.".

:TemporalIdentifier a owl:Class ;
  rdfs:label "Temporal Identifier" ;
  rdfs:comment "A persistent identifier that resolves to a referent over time.".

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "An entity referenced by a temporal identifier.".

:ReferentTransition a owl:Class ;
  rdfs:label "Referent Transition" ;
  rdfs:comment "An event where a temporal identifier transitions to a new referent.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A measurement or event associated with a referent.".

:TemporalBinding a owl:Class ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "A mapping of a temporal identifier to a referent at a specific timestamp.".

:Timestamp a owl:DatatypeProperty ;
  rdfs:label "Timestamp" ;
  rdfs:comment "A point in time when a temporal binding is valid." ;
  rdfs:range xsd:dateTime.

:ReferentTransitionTimestamp a owl:DatatypeProperty ;
  rdfs:label "Referent Transition Timestamp" ;
  rdfs:comment "A point in time when a referent transition occurs." ;
  rdfs:range xsd:dateTime.

:TemporalIdentifier a owl:ObjectProperty ;
  rdfs:label "Temporal Identifier" ;
  rdfs:comment "A temporal identifier that resolves to a referent." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :Referent.

:ReferentTransition a owl:ObjectProperty ;
  rdfs:label "Referent Transition" ;
  rdfs:comment "A referent transition that occurs at a specific timestamp." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :ReferentTransition.

:Observation a owl:ObjectProperty ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation associated with a referent." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :Observation.

:TemporalBindingSequence a owl:ObjectProperty ;
  rdfs:label "Temporal Binding Sequence" ;
  rdfs:comment "A sequence of temporal bindings that resolve to a referent over time." ;
  rdfs:domain :TemporalIdentifier ;
  rdfs:range :TemporalBinding.

:Rules a owl:ObjectProperty ;
  rdfs:label "Rules" ;
  rdfs:comment "Rules that trigger referent transitions." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :Rules.

:TemporalBindingGap a owl:ObjectProperty ;
  rdfs:label "Temporal Binding Gap" ;
  rdfs:comment "A gap in temporal bindings that may indicate missing data." ;
  rdfs:domain :TemporalIdentifier ;
  rdfs:range :TemporalBinding.

:TemporalBindingOverlap a owl:ObjectProperty ;
  rdfs:label "Temporal Binding Overlap" ;
  rdfs:comment "An overlap in temporal bindings that may indicate conflicting data." ;
  rdfs:domain :TemporalIdentifier ;
  rdfs:range :TemporalBinding.

:CompleteContext a owl:ObjectProperty ;
  rdfs:label "Complete Context" ;
  rdfs:comment "A complete context that can be rebuilt for any time point." ;
  rdfs:domain :TemporalIdentifier ;
  rdfs:range :TemporalBinding.