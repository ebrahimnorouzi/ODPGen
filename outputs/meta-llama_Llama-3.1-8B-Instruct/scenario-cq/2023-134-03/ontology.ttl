@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "An ontology for governance patterns in Solid apps".

:Actor a rdfs:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity providing a Pod or an app".

:Role a rdfs:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A function or position within a Pod or an app".

:Pod a rdfs:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A container for user data in Solid".

:App a rdfs:Class ;
  rdfs:label "App" ;
  rdfs:comment "A software application running on a Pod".

:Infrastructure a rdfs:Class ;
  rdfs:label "Infrastructure" ;
  rdfs:comment "The underlying system supporting a Pod".

:Specification a rdfs:Class ;
  rdfs:label "Specification" ;
  rdfs:comment "A set of rules or standards for a Pod".

:Category a rdfs:Class ;
  rdfs:label "Category" ;
  rdfs:comment "A classification of data within a Pod".

:Data a rdfs:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Information stored within a Pod".

:Provider a rdfs:Class ;
  rdfs:label "Provider" ;
  rdfs:comment "An entity providing a Pod or an app".

:DataHandlingPractice a rdfs:Class ;
  rdfs:label "Data Handling Practice" ;
  rdfs:comment "A description of how data is handled within a Pod".

:PrivacyPolicy a rdfs:Class ;
  rdfs:label "Privacy Policy" ;
  rdfs:comment "A statement of how data is used and protected".

:User a rdfs:Class ;
  rdfs:label "User" ;
  rdfs:comment "An individual interacting with a Pod or an app".

:Registry a rdfs:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A database of information about Pods and apps".

:RegistryMaintainer a owl:Class ;
  rdfs:label "Registry Maintainer" ;
  rdfs:comment "An entity responsible for maintaining a registry".

:RegistryCreationDate a owl:DatatypeProperty ;
  rdfs:label "Registry Creation Date" ;
  rdfs:comment "The date a registry was created" ;
  rdfs:range xsd:date.

:RegistryUpdateDate a owl:DatatypeProperty ;
  rdfs:label "Registry Update Date" ;
  rdfs:comment "The date a registry was last updated" ;
  rdfs:range xsd:date.

:DataCategory a owl:DatatypeProperty ;
  rdfs:label "Data Category" ;
  rdfs:comment "A classification of data within a Pod" ;
  rdfs:range :Category.

:DataStorageLocation a owl:DatatypeProperty ;
  rdfs:label "Data Storage Location" ;
  rdfs:comment "The location where data is stored within a Pod" ;
  rdfs:range xsd:string.

:Policy a owl:DatatypeProperty ;
  rdfs:label "Policy" ;
  rdfs:comment "A statement of how data is used and protected" ;
  rdfs:range :PrivacyPolicy.

:RegistryMaintainer a owl:inverseOf :maintainsRegistry.

:maintainsRegistry a owl:ObjectProperty ;
  rdfs:label "Maintains Registry" ;
  rdfs:comment "An entity responsible for maintaining a registry" ;
  rdfs:domain :Registry ;
  rdfs:range :RegistryMaintainer.

:hasActor a owl:ObjectProperty ;
  rdfs:label "Has Actor" ;
  rdfs:comment "An entity providing a Pod or an app" ;
  rdfs:domain :Pod ;
  rdfs:range :Actor.

:hasRole a owl:ObjectProperty ;
  rdfs:label "Has Role" ;
  rdfs:comment "A function or position within a Pod or an app" ;
  rdfs:domain :Actor ;
  rdfs:range :Role.