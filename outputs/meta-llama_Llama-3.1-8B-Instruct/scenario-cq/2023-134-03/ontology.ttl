@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry for governance patterns in Solid apps".

:RegistryMaintainer a owl:Class ;
  rdfs:label "Registry Maintainer" ;
  rdfs:comment "An entity maintaining the registry".

:RegistryCreationDate a owl:DatatypeProperty ;
  rdfs:label "Registry Creation Date" ;
  rdfs:comment "The date the registry was created" ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date.

:RegistryUpdateDate a owl:DatatypeProperty ;
  rdfs:label "Registry Update Date" ;
  rdfs:comment "The date the registry was last updated" ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date.

:DataType a owl:Class ;
  rdfs:label "Data Type" ;
  rdfs:comment "A category of data".

:DataStorageLocation a owl:Class ;
  rdfs:label "Data Storage Location" ;
  rdfs:comment "A location where data is stored".

:DataPolicy a owl:Class ;
  rdfs:label "Data Policy" ;
  rdfs:comment "A policy associated with data".

:RegistryMaintainerRegistry a owl:ObjectProperty ;
  rdfs:label "Maintains Registry" ;
  rdfs:comment "An entity maintaining the registry" ;
  rdfs:domain :RegistryMaintainer ;
  rdfs:range :Registry.

:RegistryRegistryCreationDate a owl:ObjectProperty ;
  rdfs:label "Registry Creation Date" ;
  rdfs:comment "The date the registry was created" ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date.

:RegistryRegistryUpdateDate a owl:ObjectProperty ;
  rdfs:label "Registry Update Date" ;
  rdfs:comment "The date the registry was last updated" ;
  rdfs:domain :Registry ;
  rdfs:range xsd:date.

:DataHasDataType a owl:ObjectProperty ;
  rdfs:label "Has Data Type" ;
  rdfs:comment "A category of data" ;
  rdfs:domain :DataStorageLocation ;
  rdfs:range :DataType.

:DataStorageLocationHasData a owl:ObjectProperty ;
  rdfs:label "Has Data" ;
  rdfs:comment "A location where data is stored" ;
  rdfs:domain :DataStorageLocation ;
  rdfs:range :Data.

:DataHasDataPolicy a owl:ObjectProperty ;
  rdfs:label "Has Data Policy" ;
  rdfs:comment "A policy associated with data" ;
  rdfs:domain :DataStorageLocation ;
  rdfs:range :DataPolicy.