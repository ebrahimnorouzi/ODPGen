@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Legal Task Ontology" ;
  rdfs:comment "Ontology for legal tasks and court hierarchies".

:State a owl:Class ;
  rdfs:label "State" ;
  rdfs:comment "A state in the United States".

:DistrictCourt a owl:Class ;
  rdfs:label "District Court" ;
  rdfs:comment "A district court in the United States".

:StateDistrictCourt a owl:Class ;
  rdfs:label "State-District Court" ;
  rdfs:comment "A state-district court in the United States".

:India a owl:Class ;
  rdfs:label "India" ;
  rdfs:comment "A country in Asia".

:District a owl:Class ;
  rdfs:label "District" ;
  rdfs:comment "A district in India".

:StateDistrict a owl:Class ;
  rdfs:label "State-District" ;
  rdfs:comment "A state-district in India".

:Authority a owl:Class ;
  rdfs:label "Authority" ;
  rdfs:comment "A court with authority over another court".

:Check a owl:Class ;
  rdfs:label "Check" ;
  rdfs:comment "A financial transaction".

:TransactionType a owl:Class ;
  rdfs:label "Transaction Type" ;
  rdfs:comment "The type of transaction".

:PaymentDate a owl:DatatypeProperty ;
  rdfs:label "Payment Date" ;
  rdfs:comment "The date of payment" ;
  rdfs:domain :Check ;
  rdfs:range xsd:date.

:TransactionStatus a owl:Class ;
  rdfs:label "Transaction Status" ;
  rdfs:comment "The status of a transaction".

:BadCheck a owl:Class ;
  rdfs:label "Bad Check" ;
  rdfs:comment "A check with insufficient funds".

:CheckTransactionType a owl:DatatypeProperty ;
  rdfs:label "Check Transaction Type" ;
  rdfs:comment "The type of check transaction" ;
  rdfs:domain :BadCheck ;
  rdfs:range xsd:string.

:hasAuthority a owl:ObjectProperty ;
  rdfs:label "Has Authority Over" ;
  rdfs:comment "A court has authority over another court" ;
  rdfs:domain :Authority ;
  rdfs:range :Authority.

:locatedIn a owl:ObjectProperty ;
  rdfs:label "Located In" ;
  rdfs:comment "A district court is located in a state" ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :State.

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "Has District" ;
  rdfs:comment "A state has districts" ;
  rdfs:domain :State ;
  rdfs:range :District.

:hasStateDistrict a owl:ObjectProperty ;
  rdfs:label "Has State-District" ;
  rdfs:comment "A state has state-districts" ;
  rdfs:domain :State ;
  rdfs:range :StateDistrict.

:hasCheck a owl:ObjectProperty ;
  rdfs:label "Has Check" ;
  rdfs:comment "A bad check has a check transaction type" ;
  rdfs:domain :BadCheck ;
  rdfs:range :CheckTransactionType.

:hasPaymentDate a owl:ObjectProperty ;
  rdfs:label "Has Payment Date" ;
  rdfs:comment "A check has a payment date" ;
  rdfs:domain :Check ;
  rdfs:range :PaymentDate.

:hasTransactionStatus a owl:ObjectProperty ;
  rdfs:label "Has Transaction Status" ;
  rdfs:comment "A check payment has a transaction status" ;
  rdfs:domain :CheckPayment ;
  rdfs:range :TransactionStatus.

:CheckPayment a owl:Class ;
  rdfs:label "Check Payment" ;
  rdfs:comment "A payment of a check".