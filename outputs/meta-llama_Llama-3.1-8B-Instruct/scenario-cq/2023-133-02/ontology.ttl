@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "Ontology for the kHealth-Asthma project".

:AsthmaPatient a rdfs:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A patient with asthma".

:AsthmaSymptom a rdfs:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "A symptom of asthma, e.g., cough, chest tightness, wheezing, breathing patterns".

:Medication a rdfs:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication taken by the patient".

:OutdoorAllergen a rdfs:Class ;
  rdfs:label "Outdoor Allergen" ;
  rdfs:comment "An outdoor allergen, e.g., pollen, air quality index (AQI)".

:CausalRelation a rdfs:Class ;
  rdfs:label "Causal Relation" ;
  rdfs:comment "A causal relation between two entities".

:hasEffectWeight a rdf:Property ;
  rdfs:label "has Effect Weight" ;
  rdfs:comment "The effect weight of a causal relation" ;
  rdfs:range xsd:float.

:causes a rdf:Property ;
  rdfs:label "causes" ;
  rdfs:comment "The causal relation between two entities" ;
  rdfs:domain :CausalRelation ;
  rdfs:range :AsthmaSymptom.

:hasCausalEffect a rdf:Property ;
  rdfs:label "has Causal Effect" ;
  rdfs:comment "The causal effect of an outdoor allergen on a patient's symptoms" ;
  rdfs:domain :OutdoorAllergen ;
  rdfs:range :AsthmaSymptom.

:hasMedicationIntake a rdf:Property ;
  rdfs:label "has Medication Intake" ;
  rdfs:comment "The medication intake of a patient" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:hasSymptom a rdf:Property ;
  rdfs:label "has Symptom" ;
  rdfs:comment "The symptoms of a patient" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:hasOutdoorAllergen a rdf:Property ;
  rdfs:label "has Outdoor Allergen" ;
  rdfs:comment "The outdoor allergen affecting a patient" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :OutdoorAllergen.

:hasCausalEffectWeight a rdf:Property ;
  rdfs:label "has Causal Effect Weight" ;
  rdfs:comment "The causal effect weight of a causal relation" ;
  rdfs:domain :CausalRelation ;
  rdfs:range xsd:float.

:hasProbableCause a rdf:Property ;
  rdfs:label "has Probable Cause" ;
  rdfs:comment "The probable cause of a patient's symptom" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range :OutdoorAllergen.

:hasEffectOnMedication a rdf:Property ;
  rdfs:label "has Effect on Medication" ;
  rdfs:comment "The effect of a patient's symptom on medication intake" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range :Medication.

:hasEffectOnPatient a rdf:Property ;
  rdfs:label "has Effect on Patient" ;
  rdfs:comment "The effect of an outdoor allergen on a patient" ;
  rdfs:domain :OutdoorAllergen ;
  rdfs:range :AsthmaPatient.

:hasCounterfactualEffect a rdf:Property ;
  rdfs:label "has Counterfactual Effect" ;
  rdfs:comment "The counterfactual effect of an outdoor allergen on medication intake" ;
  rdfs:domain :OutdoorAllergen ;
  rdfs:range :Medication.