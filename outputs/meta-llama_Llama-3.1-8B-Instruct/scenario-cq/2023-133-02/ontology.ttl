@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "Ontology for the kHealth-Asthma project".

:AsthmaPatient a owl:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A patient with asthma".

:AsthmaSymptom a owl:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "A symptom of asthma".

:Cough a owl:Class ;
  rdfs:label "Cough" ;
  rdfs:comment "A symptom of asthma, cough".

:ChestTightness a owl:Class ;
  rdfs:label "Chest Tightness" ;
  rdfs:comment "A symptom of asthma, chest tightness".

:Wheezing a owl:Class ;
  rdfs:label "Wheezing" ;
  rdfs:comment "A symptom of asthma, wheezing".

:BreathingPattern a owl:Class ;
  rdfs:label "Breathing Pattern" ;
  rdfs:comment "A symptom of asthma, breathing pattern".

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication for asthma".

:OutdoorAllergen a owl:Class ;
  rdfs:label "Outdoor Allergen" ;
  rdfs:comment "An outdoor allergen, such as pollen or AQI".

:Pollen a owl:Class ;
  rdfs:label "Pollen" ;
  rdfs:comment "An outdoor allergen, pollen".

:AQI a owl:Class ;
  rdfs:label "Air Quality Index" ;
  rdfs:comment "An outdoor allergen, air quality index".

:hasSymptom a owl:ObjectProperty ;
  rdfs:label "has Symptom" ;
  rdfs:comment "A patient has a symptom" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:hasMedication a owl:ObjectProperty ;
  rdfs:label "has Medication" ;
  rdfs:comment "A patient has a medication" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:hasOutdoorAllergen a owl:ObjectProperty ;
  rdfs:label "has Outdoor Allergen" ;
  rdfs:comment "A patient is exposed to an outdoor allergen" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :OutdoorAllergen.

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "One thing causes another" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range :AsthmaPatient.

:hasEffectWeight a owl:DatatypeProperty ;
  rdfs:label "has Effect Weight" ;
  rdfs:comment "The effect weight of a causal relation" ;
  rdfs:domain :causes ;
  rdfs:range xsd:float.

:hasCausalEffect a owl:ObjectProperty ;
  rdfs:label "has Causal Effect" ;
  rdfs:comment "A causal effect of a relation" ;
  rdfs:domain :causes ;
  rdfs:range :AsthmaSymptom.