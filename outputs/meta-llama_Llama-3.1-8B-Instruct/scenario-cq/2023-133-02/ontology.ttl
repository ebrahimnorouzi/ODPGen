@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "kHealth-Asthma Ontology" ;
  rdfs:comment "Ontology for the kHealth-Asthma project".

:AsthmaPatient a owl:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A patient with asthma".

:AsthmaSymptom a owl:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "A symptom of asthma".

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication for asthma".

:OutdoorEnvironmentalAllergen a owl:Class ;
  rdfs:label "Outdoor Environmental Allergen" ;
  rdfs:comment "An allergen in the outdoor environment".

:hasSymptom a owl:ObjectProperty ;
  rdfs:label "has Symptom" ;
  rdfs:comment "A patient has a symptom" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:hasMedication a owl:ObjectProperty ;
  rdfs:label "has Medication" ;
  rdfs:comment "A patient has a medication" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:hasAllergen a owl:ObjectProperty ;
  rdfs:label "has Allergen" ;
  rdfs:comment "A patient is exposed to an allergen" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :OutdoorEnvironmentalAllergen.

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "One thing causes another" ;
  rdfs:domain :OutdoorEnvironmentalAllergen ;
  rdfs:range :AsthmaSymptom.

:effectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The weight of the effect of one thing on another" ;
  rdfs:domain :causes ;
  rdfs:range xsd:float.

:hasMedicationIntake a owl:ObjectProperty ;
  rdfs:label "has Medication Intake" ;
  rdfs:comment "A patient has a medication intake" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:hasSymptomEffect a owl:ObjectProperty ;
  rdfs:label "has Symptom Effect" ;
  rdfs:comment "A symptom has an effect on medication intake" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range xsd:float.