@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT protocol for EKI project".

:MQTT a rdfs:Class ;
  rdfs:label "MQTT" ;
  rdfs:comment "Message Queuing Telemetry Transport protocol".

:MQTTClient a rdfs:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Client in MQTT protocol" ;
  rdfs:subClassOf :MQTT.

:MQTTBroker a rdfs:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Broker in MQTT protocol" ;
  rdfs:subClassOf :MQTT.

:MQTTNetworkConnection a rdfs:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "Network connection in MQTT protocol" ;
  rdfs:subClassOf :MQTT.

:MQTTTopic a rdfs:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "Topic in MQTT protocol".

:MQTTTopicFilter a rdfs:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "Topic filter in MQTT protocol".

:MQTTControlPacket a rdfs:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "Control packet in MQTT protocol".

:MQTTPublishPacket a rdfs:Class ;
  rdfs:label "MQTT Publish Packet" ;
  rdfs:comment "Publish packet in MQTT protocol" ;
  rdfs:subClassOf :MQTTControlPacket.

:MQTTSUBSCRIBEPacket a rdfs:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "SUBSCRIBE packet in MQTT protocol" ;
  rdfs:subClassOf :MQTTControlPacket.

:MQTTUnsubscribePacket a rdfs:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "UNSUBSCRIBE packet in MQTT protocol" ;
  rdfs:subClassOf :MQTTControlPacket.

:MQTTClientID a rdfs:Class ;
  rdfs:label "MQTT Client ID" ;
  rdfs:comment "Client ID in MQTT protocol".

:MQTTTopicName a rdfs:Class ;
  rdfs:label "MQTT Topic Name" ;
  rdfs:comment "Topic name in MQTT protocol".

:MQTTTopicFilterPattern a rdfs:Class ;
  rdfs:label "MQTT Topic Filter Pattern" ;
  rdfs:comment "Topic filter pattern in MQTT protocol".

:MQTTControlPacketIdentifier a rdfs:Class ;
  rdfs:label "MQTT Control Packet Identifier" ;
  rdfs:comment "Control packet identifier in MQTT protocol".

:MQTTQoS a rdfs:Class ;
  rdfs:label "MQTT QoS" ;
  rdfs:comment "Quality of Service in MQTT protocol".

:MQTTRETAIN a rdfs:Class ;
  rdfs:label "MQTT RETAIN" ;
  rdfs:comment "RETAIN flag in MQTT protocol".

:MQTTDUP a rdfs:Class ;
  rdfs:label "MQTT DUP" ;
  rdfs:comment "DUP flag in MQTT protocol".

:MQTTNetworkConnectionTLS a rdfs:Class ;
  rdfs:label "MQTT Network Connection TLS" ;
  rdfs:comment "TLS-secured network connection in MQTT protocol".

:MQTTNetworkConnectionInitiated a rdfs:Class ;
  rdfs:label "MQTT Network Connection Initiated" ;
  rdfs:comment "Initiated network connection in MQTT protocol".

:MQTTNetworkConnectionAccepted a rdfs:Class ;
  rdfs:label "MQTT Network Connection Accepted" ;
  rdfs:comment "Accepted network connection in MQTT protocol".

:MQTTClientPlatform a rdfs:Class ;
  rdfs:label "MQTT Client Platform" ;
  rdfs:comment "Client platform in MQTT protocol".