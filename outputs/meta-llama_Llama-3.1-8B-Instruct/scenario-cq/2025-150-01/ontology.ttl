@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT message protocol for IoT and industrial settings".

:MQTTClient a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Entity that connects to an MQTT Broker".

:MQTTBroker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Entity that manages MQTT NetworkConnections".

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "Connection between an MQTT Client and an MQTT Broker".

:MQTTParticipant a owl:Class ;
  rdfs:label "MQTT Participant" ;
  rdfs:comment "Entity that uses an MQTT NetworkConnection".

:MQTTClientID a owl:DatatypeProperty ;
  rdfs:label "MQTT Client ID" ;
  rdfs:comment "Unique identifier for an MQTT Client" ;
  rdfs:range xsd:string.

:MQTTClientPlatform a owl:Class ;
  rdfs:label "MQTT Client Platform" ;
  rdfs:comment "Platform on which an MQTT Client runs".

:SOSAPlatform a owl:Class ;
  rdfs:label "SOSA Platform" ;
  rdfs:comment "Platform that hosts SOSA systems".

:SOSASystem a owl:Class ;
  rdfs:label "SOSA System" ;
  rdfs:comment "System that uses an SOSA platform".

:SOSAFeatureOfInterest a owl:Class ;
  rdfs:label "SOSA Feature Of Interest" ;
  rdfs:comment "Feature of interest in an SOSA system".

:SOSAProperty a owl:Class ;
  rdfs:label "SOSA Property" ;
  rdfs:comment "Property in an SOSA system".

:MQTTTopic a owl:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "Topic in an MQTT message".

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "Filter applied to an MQTT topic".

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "Packet used to control an MQTT connection".

:MQTTPublishPacket a owl:Class ;
  rdfs:label "MQTT Publish Packet" ;
  rdfs:comment "Packet used to publish an MQTT message".

:MQTTSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "Packet used to subscribe to an MQTT topic".

:MQTTUnsubscribePacket a owl:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "Packet used to unsubscribe from an MQTT topic".

:MQTTBrokerConfig a owl:Class ;
  rdfs:label "MQTT Broker Configuration" ;
  rdfs:comment "Configuration of an MQTT Broker".

:MQTTBrokerHost a owl:DatatypeProperty ;
  rdfs:label "MQTT Broker Host" ;
  rdfs:comment "Host of an MQTT Broker" ;
  rdfs:range xsd:string.

:MQTTBrokerPort a owl:DatatypeProperty ;
  rdfs:label "MQTT Broker Port" ;
  rdfs:comment "Port of an MQTT Broker" ;
  rdfs:range xsd:integer.

:MQTTNetworkConnectionTLS a owl:DatatypeProperty ;
  rdfs:label "MQTT Network Connection TLS" ;
  rdfs:comment "TLS security of an MQTT Network Connection" ;
  rdfs:range xsd:boolean.

:MQTTNetworkConnectionInitiatedBy a owl:ObjectProperty ;
  rdfs:label "MQTT Network Connection Initiated By" ;
  rdfs:comment "Entity that initiated an MQTT Network Connection" ;
  rdfs:domain :MQTTNetworkConnection ;
  rdfs:range :MQTTParticipant.