:Ontology a owl:Ontology ;
  rdfs:label "MQTT Ontology" ;
  rdfs:comment "Modeling MQTT message protocol for IoT and industrial settings".

:MQTT a owl:Class ;
  rdfs:label "Message Queuing Telemetry Transport" ;
  rdfs:comment "MQTT message protocol for IoT and industrial settings".

:MQTTClient a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "Entity that connects to an MQTT Broker".

:MQTTBroker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "Entity that manages MQTT NetworkConnections".

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "Connection between an MQTT Client and an MQTT Broker".

:MQTTNetworkConnectionInitiatedBy a owl:ObjectProperty ;
  rdfs:label "Initiated by" ;
  rdfs:comment "Property indicating who initiated the connection" ;
  rdfs:domain :MQTTNetworkConnection ;
  rdfs:range :MQTTClient.

:MQTTNetworkConnectionAcceptedBy a owl:ObjectProperty ;
  rdfs:label "Accepted by" ;
  rdfs:comment "Property indicating who accepted the connection" ;
  rdfs:domain :MQTTNetworkConnection ;
  rdfs:range :MQTTBroker.

:MQTTNetworkConnectionTLS a owl:DatatypeProperty ;
  rdfs:label "TLS-secured" ;
  rdfs:comment "Property indicating whether the connection is TLS-secured" ;
  rdfs:domain :MQTTNetworkConnection ;
  rdfs:range xsd:boolean.

:MQTTClientID a owl:DatatypeProperty ;
  rdfs:label "Client ID" ;
  rdfs:comment "Property indicating the client ID of an MQTT Client" ;
  rdfs:domain :MQTTClient ;
  rdfs:range xsd:string.

:MQTTTopic a owl:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "Topic in an MQTT message".

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "Filter applied to an MQTT Topic".

:MQTTTopicFilterPattern a owl:Class ;
  rdfs:label "MQTT Topic Filter Pattern" ;
  rdfs:comment "Pattern used in an MQTT Topic Filter".

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "Control packet in an MQTT message".

:MQTTPublishPacket a owl:Class ;
  rdfs:label "MQTT Publish Packet" ;
  rdfs:comment "Publish packet in an MQTT message".

:MQTTSUBSCRIBEPacket a owl:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "SUBSCRIBE packet in an MQTT message".

:MQTTUnsubscribePacket a owl:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "UNSUBSCRIBE packet in an MQTT message".

:MQTTFixedHeader a owl:Class ;
  rdfs:label "MQTT Fixed Header" ;
  rdfs:comment "Fixed header in an MQTT message".

:MQTTVariableHeader a owl:Class ;
  rdfs:label "MQTT Variable Header" ;
  rdfs:comment "Variable header in an MQTT message".

:MQTTPayload a owl:Class ;
  rdfs:label "MQTT Payload" ;
  rdfs:comment "Payload in an MQTT message".

:MQTTQoS a owl:Class ;
  rdfs:label "MQTT QoS" ;
  rdfs:comment "Quality of Service in an MQTT message".

:MQTTPacketIdentifier a owl:DatatypeProperty ;
  rdfs:label "Packet Identifier" ;
  rdfs:comment "Property indicating the packet identifier of an MQTT Control Packet" ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range xsd:integer.

:MQTTRETAIN a owl:DatatypeProperty ;
  rdfs:label "RETAIN flag" ;
  rdfs:comment "Property indicating whether the RETAIN flag is set" ;
  rdfs:domain :MQTTPublishPacket ;
  rdfs:range xsd:boolean.

:MQTTDUP a owl:DatatypeProperty ;
  rdfs:label "DUP flag" ;
  rdfs:comment "Property indicating whether the DUP flag is set" ;
  rdfs:domain :MQTTPublishPacket ;
  rdfs:range xsd:boolean.