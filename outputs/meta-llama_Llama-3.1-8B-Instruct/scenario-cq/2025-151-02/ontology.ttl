@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "Ontology for representing ODRL policies and their evaluation.".

:Time a owl:Class ;
  rdfs:label "Time" ;
  rdfs:comment "Represents a point in time.".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Represents a geographical location.".

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "Represents a digital or physical asset.".

:AssetCollection a owl:Class ;
  rdfs:label "Asset Collection" ;
  rdfs:comment "Represents a collection of assets.".

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "Represents an individual or organization.".

:PartyCollection a owl:Class ;
  rdfs:label "Party Collection" ;
  rdfs:comment "Represents a collection of parties.".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Represents an action performed or attempted.".

:RuleExercise a owl:Class ;
  rdfs:label "Rule Exercise" ;
  rdfs:comment "Represents the exercise of a rule.".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Represents an occurrence or event.".

:FinancialPayment a owl:Class ;
  rdfs:label "Financial Payment" ;
  rdfs:comment "Represents a financial payment.".

:hasTime rdf:type owl:DatatypeProperty ;
  rdfs:label "has Time" ;
  rdfs:comment "Associates an asset or event with a point in time." ;
  rdfs:domain :Asset ;
  rdfs:domain :Event ;
  rdfs:range xsd:dateTime.

:hasLocation rdf:type owl:DatatypeProperty ;
  rdfs:label "has Location" ;
  rdfs:comment "Associates a party or asset with a geographical location." ;
  rdfs:domain :Party ;
  rdfs:domain :Asset ;
  rdfs:range :Location.

:hasAsset rdf:type owl:ObjectProperty ;
  rdfs:label "has Asset" ;
  rdfs:comment "Associates an asset collection with its assets." ;
  rdfs:domain :AssetCollection ;
  rdfs:range :Asset.

:hasParty rdf:type owl:ObjectProperty ;
  rdfs:label "has Party" ;
  rdfs:comment "Associates a party collection with its parties." ;
  rdfs:domain :PartyCollection ;
  rdfs:range :Party.

:performedBy rdf:type owl:ObjectProperty ;
  rdfs:label "performedBy" ;
  rdfs:comment "Associates an action with the party that performed it." ;
  rdfs:domain :Action ;
  rdfs:range :Party.

:exerciseCount rdf:type owl:DatatypeProperty ;
  rdfs:label "exerciseCount" ;
  rdfs:comment "Counts the number of times a rule has been exercised." ;
  rdfs:domain :RuleExercise ;
  rdfs:range xsd:integer.

:hasEvent rdf:type owl:ObjectProperty ;
  rdfs:label "has Event" ;
  rdfs:comment "Associates an asset or party with an event." ;
  rdfs:domain :Asset ;
  rdfs:domain :Party ;
  rdfs:range :Event.

:hasDuration rdf:type owl:DatatypeProperty ;
  rdfs:label "has Duration" ;
  rdfs:comment "Associates a rule exercise with its duration." ;
  rdfs:domain :RuleExercise ;
  rdfs:range xsd:duration.

:receivesResult rdf:type owl:ObjectProperty ;
  rdfs:label "receivesResult" ;
  rdfs:comment "Associates a recipient with the result of a rule exercise." ;
  rdfs:domain :RuleExercise ;
  rdfs:range :Party.