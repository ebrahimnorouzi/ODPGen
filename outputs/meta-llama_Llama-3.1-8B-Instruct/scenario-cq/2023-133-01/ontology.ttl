@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case Ontology" ;
  rdfs:comment "Ontology for reasoning about the cause of a slippery pavement".

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An event in the sprinkler use case".

:Cause a owl:ObjectProperty ;
  rdfs:label "Cause" ;
  rdfs:comment "A causal relation between two events" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:Effect a owl:ObjectProperty ;
  rdfs:label "Effect" ;
  rdfs:comment "The outcome of a causal relation" ;
  rdfs:domain :Cause ;
  rdfs:range :Event.

:Pavement a owl:Class ;
  rdfs:label "Pavement" ;
  rdfs:comment "The pavement in the sprinkler use case".

:SlipperyPavement a owl:Class ;
  rdfs:label "Slippery Pavement" ;
  rdfs:comment "The pavement is slippery" ;
  rdfs:subClassOf :Pavement.

:WetPavement a owl:Class ;
  rdfs:label "Wet Pavement" ;
  rdfs:comment "The pavement is wet" ;
  rdfs:subClassOf :Pavement.

:RainySeason a owl:Class ;
  rdfs:label "Rainy Season" ;
  rdfs:comment "It is rainy season" ;
  rdfs:subClassOf :Event.

:SprinklerOn a owl:Class ;
  rdfs:label "Sprinkler On" ;
  rdfs:comment "The sprinkler is on" ;
  rdfs:subClassOf :Event.

:Rain a owl:Class ;
  rdfs:label "Rain" ;
  rdfs:comment "It is raining" ;
  rdfs:subClassOf :Event.

:CausalLink a owl:Class ;
  rdfs:label "Causal Link" ;
  rdfs:comment "A causal link between two events" ;
  rdfs:subClassOf :Event.

:EffectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The strength of a causal link" ;
  rdfs:domain :CausalLink ;
  rdfs:range xsd:float.

:Sprinkler a owl:Class ;
  rdfs:label "Sprinkler" ;
  rdfs:comment "The sprinkler system".

:TurnOn a owl:ObjectProperty ;
  rdfs:label "Turn On" ;
  rdfs:comment "The action of turning the sprinkler system on" ;
  rdfs:domain :Sprinkler ;
  rdfs:range :Event.

:TurnOff a owl:ObjectProperty ;
  rdfs:label "Turn Off" ;
  rdfs:comment "The action of turning the sprinkler system off" ;
  rdfs:domain :Sprinkler ;
  rdfs:range :Event.

:Mediates a owl:ObjectProperty ;
  rdfs:label "Mediates" ;
  rdfs:comment "A causal relation is mediated by another event" ;
  rdfs:domain :Cause ;
  rdfs:range :Event.

:HasEffect a owl:ObjectProperty ;
  rdfs:label "Has Effect" ;
  rdfs:comment "An event has an effect on another event" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:Outcome a owl:ObjectProperty ;
  rdfs:label "Outcome" ;
  rdfs:comment "The outcome of an event" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:Condition a owl:ObjectProperty ;
  rdfs:label "Condition" ;
  rdfs:comment "A condition for an event to occur" ;
  rdfs:domain :Event ;
  rdfs:range :Event.

:EffectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The strength of a causal link" ;
  rdfs:domain :CausalLink ;
  rdfs:range xsd:float.