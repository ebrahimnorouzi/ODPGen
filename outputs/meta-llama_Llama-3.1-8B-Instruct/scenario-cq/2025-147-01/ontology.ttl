@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "A formalized and extensible conceptual model for representing ships and their properties in a machine-interpretable way.".

:Ship a rdfs:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes.".

:ShipID a rdfs:Class ;
  rdfs:label "Ship ID" ;
  rdfs:comment "A unique identifier for a ship." ;
  rdfs:subClassOf :Ship.

:Dimensions a rdfs:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "The physical characteristics of a ship." ;
  rdfs:subClassOf :Ship.

:Location a rdfs:Class ;
  rdfs:label "Location" ;
  rdfs:comment "The geographical position of a ship." ;
  rdfs:subClassOf :Ship.

:Owner a rdfs:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "The entity responsible for a ship." ;
  rdfs:subClassOf :Ship.

:Speed a rdfs:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "The rate of movement of a ship." ;
  rdfs:subClassOf :Ship.

:ContainerShip a rdfs:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "A type of ship designed for transporting containers." ;
  rdfs:subClassOf :Ship.

:GermanFlag a rdfs:Class ;
  rdfs:label "German Flag" ;
  rdfs:comment "A flag under which a ship is registered." ;
  rdfs:subClassOf :Ship.

:GPSAntenna a rdfs:Class ;
  rdfs:label "GPS Antenna" ;
  rdfs:comment "A device used to receive GPS signals." ;
  rdfs:subClassOf :Ship.

:Route a rdfs:Class ;
  rdfs:label "Route" ;
  rdfs:comment "A path followed by a ship." ;
  rdfs:subClassOf :Ship.

:Trajectory a rdfs:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "The path followed by a ship over time." ;
  rdfs:subClassOf :Ship.

:PropulsionSystem a rdfs:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "A system used to propel a ship." ;
  rdfs:subClassOf :Ship.

:Engine a rdfs:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "A device used to generate power for a ship." ;
  rdfs:subClassOf :PropulsionSystem.

:Propeller a rdfs:Class ;
  rdfs:label "Propeller" ;
  rdfs:comment "A device used to convert power into motion for a ship." ;
  rdfs:subClassOf :PropulsionSystem.

:Sail a rdfs:Class ;
  rdfs:label "Sail" ;
  rdfs:comment "A device used to harness wind power for a ship." ;
  rdfs:subClassOf :PropulsionSystem.

:PropulsionTechnology a rdfs:Class ;
  rdfs:label "Propulsion Technology" ;
  rdfs:comment "A method used to propel a ship." ;
  rdfs:subClassOf :PropulsionSystem.

:JetPropulsor a rdfs:Class ;
  rdfs:label "Jet Propulsor" ;
  rdfs:comment "A type of propulsion system that uses a jet of fluid to generate thrust." ;
  rdfs:subClassOf :PropulsionTechnology.

:BladedPropulsor a rdfs:Class ;
  rdfs:label "Bladed Propulsor" ;
  rdfs:comment "A type of propulsion system that uses blades to generate thrust." ;
  rdfs:subClassOf :PropulsionTechnology.