@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "Formalized conceptual model for representing ships and their properties.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes.".

:ShipID a owl:DatatypeProperty ;
  rdfs:label "Ship ID" ;
  rdfs:comment "Unique identifier for a ship." ;
  rdfs:range xsd:string.

:Dimensions a owl:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "Measurements of a ship's size.".

:Length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "Measurement of a ship's length." ;
  rdfs:range xsd:double.

:Width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "Measurement of a ship's width." ;
  rdfs:range xsd:double.

:Height a owl:DatatypeProperty ;
  rdfs:label "Height" ;
  rdfs:comment "Measurement of a ship's height." ;
  rdfs:range xsd:double.

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Geographical position of a ship.".

:Latitude a owl:DatatypeProperty ;
  rdfs:label "Latitude" ;
  rdfs:comment "Geographical latitude of a ship." ;
  rdfs:range xsd:decimal.

:Longitude a owl:DatatypeProperty ;
  rdfs:label "Longitude" ;
  rdfs:comment "Geographical longitude of a ship." ;
  rdfs:range xsd:decimal.

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "Entity responsible for a ship's operation.".

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "Company or entity owning a ship.".

:ShipRoute a owl:Class ;
  rdfs:label "Ship Route" ;
  rdfs:comment "Path followed by a ship.".

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "Series of positions of a ship over time.".

:Speed a owl:DatatypeProperty ;
  rdfs:label "Speed" ;
  rdfs:comment "Measurement of a ship's speed." ;
  rdfs:range xsd:double.

:AverageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "Measurement of a ship's average speed." ;
  rdfs:range xsd:double.

:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion System" ;
  rdfs:comment "Mechanism used to propel a ship.".

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "Machine used to generate power for a ship.".

:PowerSource a owl:Class ;
  rdfs:label "Power Source" ;
  rdfs:comment "Entity providing energy for a ship.".

:Propeller a owl:Class ;
  rdfs:label "Propeller" ;
  rdfs:comment "Device used to convert energy into motion.".

:BladedPropeller a owl:Class ;
  rdfs:label "Bladed Propeller" ;
  rdfs:comment "Propeller with blades.".

:ScrewPropeller a owl:Class ;
  rdfs:label "Screw Propeller" ;
  rdfs:comment "Propeller with a screw-like design.".

:JetPropulsor a owl:Class ;
  rdfs:label "Jet Propulsor" ;
  rdfs:comment "Device using jets to generate thrust.".

:WindAssistedPropulsion a owl:Class ;
  rdfs:label "Wind-Assisted Propulsion" ;
  rdfs:comment "Mechanism using wind to enhance propulsion.".

:ShipEngine a owl:Class ;
  rdfs:label "Ship Engine" ;
  rdfs:comment "Engine used to power a ship.".