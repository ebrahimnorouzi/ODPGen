@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Maritime Domain Ontology" ;
  rdfs:comment "Formalized conceptual model for representing ships and their properties.".

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel used for transportation or other purposes.".

:ShipID a owl:Class ;
  rdfs:label "Ship ID" ;
  rdfs:comment "Unique identifier for a ship.".

:Dimensions a owl:Class ;
  rdfs:label "Dimensions" ;
  rdfs:comment "Measurements of a ship's size.".

:Length a owl:DatatypeProperty ;
  rdfs:label "Length" ;
  rdfs:comment "Length of a ship." ;
  domain :Ship ;
  range xsd:double.

:Width a owl:DatatypeProperty ;
  rdfs:label "Width" ;
  rdfs:comment "Width of a ship." ;
  domain :Ship ;
  range xsd:double.

:Height a owl:DatatypeProperty ;
  rdfs:label "Height" ;
  rdfs:comment "Height of a ship." ;
  domain :Ship ;
  range xsd:double.

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Geographical position of a ship.".

:Latitude a owl:DatatypeProperty ;
  rdfs:label "Latitude" ;
  rdfs:comment "Latitude of a ship's location." ;
  domain :Location ;
  range xsd:decimal.

:Longitude a owl:DatatypeProperty ;
  rdfs:label "Longitude" ;
  rdfs:comment "Longitude of a ship's location." ;
  domain :Location ;
  range xsd:decimal.

:Owner a owl:Class ;
  rdfs:label "Owner" ;
  rdfs:comment "Entity responsible for a ship's operation.".

:ShipOwner a owl:ObjectProperty ;
  rdfs:label "Ship Owner" ;
  rdfs:comment "Relationship between a ship and its owner." ;
  domain :Ship ;
  range :Owner.

:Speed a owl:Class ;
  rdfs:label "Speed" ;
  rdfs:comment "Rate of movement of a ship.".

:AverageSpeed a owl:DatatypeProperty ;
  rdfs:label "Average Speed" ;
  rdfs:comment "Average speed of a ship over a period." ;
  domain :Ship ;
  range xsd:double.

:ContainerShip a owl:Class ;
  rdfs:label "Container Ship" ;
  rdfs:comment "Ship designed for transporting containers.".

:Flag a owl:Class ;
  rdfs:label "Flag" ;
  rdfs:comment "Nationality of a ship.".

:GermanFlag a owl:Class ;
  rdfs:label "German Flag" ;
  rdfs:comment "Nationality of a ship registered under the German flag.".

:GPS a owl:Class ;
  rdfs:label "GPS" ;
  rdfs:comment "Global Positioning System used for navigation.".

:Antenna a owl:Class ;
  rdfs:label "Antenna" ;
  rdfs:comment "Device used for receiving GPS signals.".

:Placement a owl:Class ;
  rdfs:label "Placement" ;
  rdfs:comment "Position of a GPS antenna relative to a ship's structure.".

:Route a owl:Class ;
  rdfs:label "Route" ;
  rdfs:comment "Path followed by a ship.".

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "Series of positions of a ship over time.".

:Propulsion a owl:Class ;
  rdfs:label "Propulsion" ;
  rdfs:comment "Method of generating thrust for a ship.".

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "Machine used for generating propulsion.".

:Power a owl:Class ;
  rdfs:label "Power" ;
  rdfs:comment "Energy source used to drive a ship's engine.".

:Driven a owl:Class ;
  rdfs:label "Driven" ;
  rdfs:comment "Component of a ship driven by its engine.".