@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request Ontology" ;
  rdfs:comment "Describes a requested action on a target asset with contextual information".

:Request a :Request ;
  rdfs:label "Request" ;
  rdfs:comment "A formal description of a requested action on a target asset".

:Request a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasAction ;
    owl:allValuesFrom :Action
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasTarget ;
    owl:allValuesFrom :TargetAsset
  ].

:Action a rdfs:Class ;
  rdfs:label "Action" ;
  rdfs:comment "The requested action on the target asset".

:TargetAsset a rdfs:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "The asset being evaluated".

:Party a rdfs:Class ;
  rdfs:label "Party" ;
  rdfs:comment "The party issuing the evaluation request".

:Requester a :Party ;
  rdfs:label "Requester" ;
  rdfs:comment "The party issuing the evaluation request".

:Requester a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasRole ;
    owl:allValuesFrom :Role
  ].

:Role a rdfs:Class ;
  rdfs:label "Role" ;
  rdfs:comment "The role of the party issuing the evaluation request".

:TemporalContext a rdfs:Class ;
  rdfs:label "Temporal Context" ;
  rdfs:comment "Temporal constraints on the evaluation request".

:TemporalContext a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasDate ;
    owl:allValuesFrom xsd:date
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasTime ;
    owl:allValuesFrom xsd:time
  ].

:SpatialContext a rdfs:Class ;
  rdfs:label "Spatial Context" ;
  rdfs:comment "Spatial constraints on the evaluation request".

:SpatialContext a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasLocation ;
    owl:allValuesFrom :Location
  ].

:Location a rdfs:Class ;
  rdfs:label "Location" ;
  rdfs:comment "The location of the evaluation request".

:RequestCapability a rdfs:Class ;
  rdfs:label "Request Capability" ;
  rdfs:comment "The capability of the party issuing the evaluation request".

:RequestCapability a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasCapability ;
    owl:allValuesFrom :Capability
  ].

:Capability a rdfs:Class ;
  rdfs:label "Capability" ;
  rdfs:comment "The capability of the party issuing the evaluation request".

:EU a :Location ;
  rdfs:label "European Union" ;
  rdfs:comment "The European Union location".

:Weekday a :TemporalContext ;
  rdfs:label "Weekday" ;
  rdfs:comment "A weekday temporal context".

:Employee a :Role ;
  rdfs:label "Employee" ;
  rdfs:comment "An employee role".

:Request a owl:Thing ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasTemporalContext ;
    owl:allValuesFrom :TemporalContext
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasSpatialContext ;
    owl:allValuesFrom :SpatialContext
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasRequestCapability ;
    owl:allValuesFrom :RequestCapability
  ].