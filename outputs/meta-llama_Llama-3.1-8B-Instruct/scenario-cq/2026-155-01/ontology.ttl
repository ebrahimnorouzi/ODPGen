@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a rdfs:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "A scientific survey activity performed on a cultural property or feature of interest.".

:Observation a rdfs:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation produced during a survey or investigation activity.".

:Method a rdfs:Class ;
  rdfs:label "Method" ;
  rdfs:comment "A method or investigation technique adopted in a survey or investigation activity.".

:EquipmentConfiguration a rdfs:Class ;
  rdfs:label "Equipment Configuration" ;
  rdfs:comment "A hardware, software, and technical configuration used to conduct a survey or investigation activity.".

:Interpretation a rdfs:Class ;
  rdfs:label "Interpretation" ;
  rdfs:comment "An interpretation or claim supported by observations produced during a survey.".

:Expert a rdfs:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "An expert who participated in a survey or investigation activity.".

:Role a rdfs:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role played by an expert in a survey or investigation activity.".

:Acquisition a rdfs:Class ;
  rdfs:label "Acquisition" ;
  rdfs:comment "An acquisition or observation activity.".

:PostProcessedOutput a rdfs:Class ;
  rdfs:label "Post-Processed Output" ;
  rdfs:comment "A post-processed output, such as an interactive image, spectrum, or dataset.".

:AcquisitionParameter a rdfs:Class ;
  rdfs:label "Acquisition Parameter" ;
  rdfs:comment "An acquisition parameter, such as exposure time, ISO, or aperture.".

:Survey_has_Method :Survey_has_Method ;
  rdfs:label "has method" ;
  rdfs:comment "A survey or investigation activity adopted a method or investigation technique." ;
  rdfs:domain :Survey ;
  rdfs:range :Method.

:Survey_has_Observation :Survey_has_Observation ;
  rdfs:label "has observation" ;
  rdfs:comment "A survey or investigation activity produced an observation." ;
  rdfs:domain :Survey ;
  rdfs:range :Observation.

:Survey_has_EquipmentConfiguration :Survey_has_EquipmentConfiguration ;
  rdfs:label "has equipment configuration" ;
  rdfs:comment "A survey or investigation activity used an equipment configuration." ;
  rdfs:domain :Survey ;
  rdfs:range :EquipmentConfiguration.

:Survey_has_Expert :Survey_has_Expert ;
  rdfs:label "has expert" ;
  rdfs:comment "A survey or investigation activity involved an expert." ;
  rdfs:domain :Survey ;
  rdfs:range :Expert.

:Survey_has_Role :Survey_has_Role ;
  rdfs:label "has role" ;
  rdfs:comment "An expert played a role in a survey or investigation activity." ;
  rdfs:domain :Survey ;
  rdfs:range :Role.

:Observation_has_Interpretation :Observation_has_Interpretation ;
  rdfs:label "has interpretation" ;
  rdfs:comment "An observation supports an interpretation or claim." ;
  rdfs:domain :Observation ;
  rdfs:range :Interpretation.

:Acquisition_has_PostProcessedOutput :Acquisition_has_PostProcessedOutput ;
  rdfs:label "has post-processed output" ;
  rdfs:comment "An acquisition or observation activity produced a post-processed output." ;
  rdfs:domain :Acquisition ;
  rdfs:range :PostProcessedOutput.

:Acquisition_has_AcquisitionParameter :Acquisition_has_AcquisitionParameter ;
  rdfs:label "has acquisition parameter" ;
  rdfs:comment "An acquisition or observation activity had acquisition parameters." ;
  rdfs:domain :Acquisition ;
  rdfs:range :AcquisitionParameter.