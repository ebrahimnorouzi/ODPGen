@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "Scientific survey activity performed on a cultural property or feature of interest.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Result of a survey or investigation activity.".

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "Investigation technique adopted in a survey or investigation activity.".

:EquipmentConfiguration a owl:Class ;
  rdfs:label "Equipment Configuration" ;
  rdfs:comment "Hardware, software, and technical configurations used to conduct a survey.".

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "Person participating in a survey or investigation activity.".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "Position or function of an expert in a survey or investigation activity.".

:Acquisition a owl:Class ;
  rdfs:label "Acquisition" ;
  rdfs:comment "Process of obtaining data or observations during a survey.".

:PostProcessedOutput a owl:Class ;
  rdfs:label "Post-Processed Output" ;
  rdfs:comment "Result of processing observations or data obtained during a survey.".

:Interpretation a owl:Class ;
  rdfs:label "Interpretation" ;
  rdfs:comment "Claim or conclusion supported by observations produced during a survey.".

:AcquisitionParameter a owl:Class ;
  rdfs:label "Acquisition Parameter" ;
  rdfs:comment "Characteristic of a photographic acquisition cycle within a survey.".

:hasSurvey a owl:ObjectProperty ;
  rdfs:label "has Survey" ;
  rdfs:comment "Relationship between a survey and a cultural property or feature of interest." ;
  rdfs:domain :Survey ;
  rdfs:range :Survey.

:hasMethod a owl:ObjectProperty ;
  rdfs:label "has Method" ;
  rdfs:comment "Relationship between a survey and an adopted investigation technique." ;
  rdfs:domain :Survey ;
  rdfs:range :Method.

:hasObservation a owl:ObjectProperty ;
  rdfs:label "has Observation" ;
  rdfs:comment "Relationship between a survey and the observations produced during it." ;
  rdfs:domain :Survey ;
  rdfs:range :Observation.

:hasExpert a owl:ObjectProperty ;
  rdfs:label "has Expert" ;
  rdfs:comment "Relationship between a survey and a participating expert." ;
  rdfs:domain :Survey ;
  rdfs:range :Expert.

:hasRole a owl:ObjectProperty ;
  rdfs:label "has Role" ;
  rdfs:comment "Relationship between an expert and their position or function in a survey." ;
  rdfs:domain :Expert ;
  rdfs:range :Role.

:hasEquipmentConfiguration a owl:ObjectProperty ;
  rdfs:label "has Equipment Configuration" ;
  rdfs:comment "Relationship between a survey and the hardware, software, and technical configurations used." ;
  rdfs:domain :Survey ;
  rdfs:range :EquipmentConfiguration.

:hasAcquisition a owl:ObjectProperty ;
  rdfs:label "has Acquisition" ;
  rdfs:comment "Relationship between a survey and the process of obtaining data or observations." ;
  rdfs:domain :Survey ;
  rdfs:range :Acquisition.

:hasPostProcessedOutput a owl:ObjectProperty ;
  rdfs:label "has Post-Processed Output" ;
  rdfs:comment "Relationship between a survey and the result of processing observations or data." ;
  rdfs:domain :Survey ;
  rdfs:range :PostProcessedOutput.

:hasInterpretation a owl:ObjectProperty ;
  rdfs:label "has Interpretation" ;
  rdfs:comment "Relationship between a survey and the claim or conclusion supported by observations." ;
  rdfs:domain :Survey ;
  rdfs:range :Interpretation.