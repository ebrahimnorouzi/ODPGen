@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Governance Patterns in Solid Apps Ontology" ;
  rdfs:comment "Ontology for governance patterns in Solid apps".

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "Type of action performed on the data".

:Create a :Action ;
  rdfs:label "Create" ;
  rdfs:comment "Action of creating data".

:Update a :Action ;
  rdfs:label "Update" ;
  rdfs:comment "Action of updating data".

:Erase a :Action ;
  rdfs:label "Erase" ;
  rdfs:comment "Action of erasing data".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "Entity interacting with the data".

:User a :Entity ;
  rdfs:label "User" ;
  rdfs:comment "Entity that is a user".

:Provider a :Entity ;
  rdfs:label "Provider" ;
  rdfs:comment "Entity that is a provider".

:Log a owl:Class ;
  rdfs:label "Log" ;
  rdfs:comment "Log entry".

:Publish a owl:ObjectProperty ;
  rdfs:label "publishes" ;
  rdfs:comment "Entity that publishes the log" ;
  rdfs:domain :Log ;
  rdfs:range :Entity.

:Issue a owl:ObjectProperty ;
  rdfs:label "issued" ;
  rdfs:comment "Time when the log was issued" ;
  rdfs:domain :Log ;
  rdfs:range xsd:dateTime.

:Store a owl:ObjectProperty ;
  rdfs:label "stores" ;
  rdfs:comment "Location where the data is being stored" ;
  rdfs:domain :Data ;
  rdfs:range :Location.

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "Application/service used to generate the data".

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Data being stored".

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "Location where the data is being stored".

:Governance a owl:Class ;
  rdfs:label "Governance" ;
  rdfs:comment "Governance pattern in Solid apps".

:Identity a owl:ObjectProperty ;
  rdfs:label "has identity" ;
  rdfs:comment "Entity that has an identity" ;
  rdfs:domain :Entity ;
  rdfs:range :Identity.

:Role a owl:ObjectProperty ;
  rdfs:label "has role" ;
  rdfs:comment "Entity that has a role" ;
  rdfs:domain :Entity ;
  rdfs:range :Role.

:Metadata a owl:ObjectProperty ;
  rdfs:label "has metadata" ;
  rdfs:comment "Entity that has metadata" ;
  rdfs:domain :Entity ;
  rdfs:range :Metadata.

:Category a owl:ObjectProperty ;
  rdfs:label "has category" ;
  rdfs:comment "Entity that has a category" ;
  rdfs:domain :Data ;
  rdfs:range :Category.

:Privacy a owl:ObjectProperty ;
  rdfs:label "has privacy" ;
  rdfs:comment "Entity that has privacy information" ;
  rdfs:domain :Entity ;
  rdfs:range :Privacy.

:Policy a owl:ObjectProperty ;
  rdfs:label "has policy" ;
  rdfs:comment "Entity that has a policy" ;
  rdfs:domain :Entity ;
  rdfs:range :Policy.

:Compliance a owl:ObjectProperty ;
  rdfs:label "has compliance" ;
  rdfs:comment "Entity that has compliance information" ;
  rdfs:domain :Entity ;
  rdfs:range :Compliance.

:LogEntry a owl:Class ;
  rdfs:label "Log Entry" ;
  rdfs:comment "Log entry".