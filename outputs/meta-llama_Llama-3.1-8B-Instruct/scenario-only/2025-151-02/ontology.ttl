@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "ODRL Policy Evaluation Ontology" ;
  rdfs:comment "Aims to model real-world information for ODRL policy evaluation.".

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A set of rules governing access to a resource.".

:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "A piece of information or content.".

:TimeRange a owl:Class ;
  rdfs:label "Time Range" ;
  rdfs:comment "A specific time interval.".

:TimeRangeStart a owl:DatatypeProperty ;
  rdfs:label "Start Time" ;
  rdfs:comment "The start time of a time range." ;
  rdfs:domain :TimeRange ;
  rdfs:range xsd:dateTime.

:TimeRangeEnd a owl:DatatypeProperty ;
  rdfs:label "End Time" ;
  rdfs:comment "The end time of a time range." ;
  rdfs:domain :TimeRange ;
  rdfs:range xsd:dateTime.

:PolicyRule a owl:Class ;
  rdfs:label "Policy Rule" ;
  rdfs:comment "A condition or constraint in a policy.".

:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "A specific requirement or constraint.".

:Access a owl:Class ;
  rdfs:label "Access" ;
  rdfs:comment "The permission to access a resource.".

:AccessRight a owl:Class ;
  rdfs:label "Access Right" ;
  rdfs:comment "A specific type of access permission.".

:AcademicResearch a owl:Class ;
  rdfs:label "Academic Research" ;
  rdfs:comment "A research project with academic purposes.".

:ProjectPurpose a owl:DatatypeProperty ;
  rdfs:label "Project Purpose" ;
  rdfs:comment "The purpose of a research project." ;
  rdfs:domain :AcademicResearch ;
  rdfs:range xsd:string.

:PolicyEvaluator a owl:Class ;
  rdfs:label "Policy Evaluator" ;
  rdfs:comment "An entity evaluating the applicability of a policy.".

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "A person, organization, or other entity.".

:Bob a owl:Class ;
  rdfs:label "Bob" ;
  rdfs:comment "A specific person.".

:VideoStream a owl:Class ;
  rdfs:label "Video Stream" ;
  rdfs:comment "A video content stream.".

:VideoStreamAccess a owl:Class ;
  rdfs:label "Video Stream Access" ;
  rdfs:comment "Access to a video stream.".

:VideoStreamAccessRight a owl:Class ;
  rdfs:label "Video Stream Access Right" ;
  rdfs:comment "A specific type of access permission to a video stream.".

:VideoStreamTimeRange a owl:Class ;
  rdfs:label "Video Stream Time Range" ;
  rdfs:comment "A specific time interval for a video stream.".

:VideoStreamTimeRangeStart a owl:DatatypeProperty ;
  rdfs:label "Video Stream Time Range Start" ;
  rdfs:comment "The start time of a video stream time range." ;
  rdfs:domain :VideoStreamTimeRange ;
  rdfs:range xsd:dateTime.

:VideoStreamTimeRangeEnd a owl:DatatypeProperty ;
  rdfs:label "Video Stream Time Range End" ;
  rdfs:comment "The end time of a video stream time range." ;
  rdfs:domain :VideoStreamTimeRange ;
  rdfs:range xsd:dateTime.

:VideoStreamAccessEvaluator a owl:Class ;
  rdfs:label "Video Stream Access Evaluator" ;
  rdfs:comment "An entity evaluating the applicability of a video stream access policy.".

:VideoStreamAccessPolicy a owl:Class ;
  rdfs:label "Video Stream Access Policy" ;
  rdfs:comment "A policy governing access to a video stream.".