@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Sprinkler Use Case Ontology" ;
  rdfs:comment "Reasoning about the cause of a slippery pavement".

:WeatherEvent a owl:Class ;
  rdfs:label "Weather Event" ;
  rdfs:comment "An event related to weather".

:RainySeason a owl:Class ;
  rdfs:label "Rainy Season" ;
  rdfs:comment "A season with significant rainfall" ;
  rdfs:subClassOf :WeatherEvent.

:SprinklerStatus a owl:Class ;
  rdfs:label "Sprinkler Status" ;
  rdfs:comment "The status of a sprinkler system".

:SprinklerOn a owl:Class ;
  rdfs:label "Sprinkler On" ;
  rdfs:comment "The sprinkler system is turned on" ;
  rdfs:subClassOf :SprinklerStatus.

:Weather a owl:Class ;
  rdfs:label "Weather" ;
  rdfs:comment "The current weather conditions".

:Rain a owl:Class ;
  rdfs:label "Rain" ;
  rdfs:comment "Precipitation in the form of rain" ;
  rdfs:subClassOf :Weather.

:PavementCondition a owl:Class ;
  rdfs:label "Pavement Condition" ;
  rdfs:comment "The state of a pavement".

:PavementWet a owl:Class ;
  rdfs:label "Pavement Wet" ;
  rdfs:comment "The pavement is wet" ;
  rdfs:subClassOf :PavementCondition.

:PavementSlippery a owl:Class ;
  rdfs:label "Pavement Slippery" ;
  rdfs:comment "The pavement is slippery" ;
  rdfs:subClassOf :PavementCondition.

:CausalRelation a owl:Class ;
  rdfs:label "Causal Relation" ;
  rdfs:comment "A relation between events where one causes the other".

:EffectWeight a owl:DatatypeProperty ;
  rdfs:label "Effect Weight" ;
  rdfs:comment "The weight of the effect of one event on another" ;
  rdfs:domain :CausalRelation ;
  rdfs:range xsd:float.

:causes a owl:ObjectProperty ;
  rdfs:label "Causes" ;
  rdfs:comment "One event causes another" ;
  rdfs:domain :WeatherEvent ;
  rdfs:range :WeatherEvent.

:mediatedBy a owl:ObjectProperty ;
  rdfs:label "Mediated By" ;
  rdfs:comment "One event causes another through a third event" ;
  rdfs:domain :CausalRelation ;
  rdfs:range :WeatherEvent.