@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Legal Task Management Ontology" ;
  rdfs:comment "Models legal tasks and their associated information.".

:LegalTask a owl:Class ;
  rdfs:label "Legal Task" ;
  rdfs:comment "Represents a legal task, such as managing court hierarchies or bad check crime regulations.".

:TaskType a owl:Class ;
  rdfs:label "Task Type" ;
  rdfs:comment "Categorizes legal tasks, e.g., court hierarchy management or bad check crime regulation.".

:TaskType :hasSubtype :CourtHierarchyManagement ;
  rdfs:label "Court Hierarchy Management" ;
  rdfs:comment "Task type for managing court hierarchies.".

:TaskType :hasSubtype :BadCheckCrimeRegulation ;
  rdfs:label "Bad Check Crime Regulation" ;
  rdfs:comment "Task type for managing bad check crime regulations.".

:LegalTask :hasType :TaskType ;
  rdfs:label "Task Type" ;
  rdfs:comment "Associates a legal task with its corresponding task type." ;
  owl:inverseOf :TaskType :hasTask.

:LegalTask :hasSubtask :LegalTask ;
  rdfs:label "Has Subtask" ;
  rdfs:comment "Indicates a subtask relationship between legal tasks." ;
  owl:transitiveProperty.

:LegalTask :hasCourtHierarchy :CourtHierarchy ;
  rdfs:label "Has Court Hierarchy" ;
  rdfs:comment "Associates a legal task with its corresponding court hierarchy." ;
  owl:inverseOf :CourtHierarchy :hasTask.

:CourtHierarchy a owl:Class ;
  rdfs:label "Court Hierarchy" ;
  rdfs:comment "Represents a court hierarchy, including its structure and relationships.".

:CourtHierarchy :hasLevel :CourtLevel ;
  rdfs:label "Has Level" ;
  rdfs:comment "Associates a court hierarchy with its corresponding level." ;
  owl:transitiveProperty.

:CourtLevel a owl:Class ;
  rdfs:label "Court Level" ;
  rdfs:comment "Represents a level in a court hierarchy.".

:CourtLevel :hasSublevel :CourtLevel ;
  rdfs:label "Has Sublevel" ;
  rdfs:comment "Indicates a sublevel relationship between court levels." ;
  owl:transitiveProperty.

:BadCheckCrimeRegulation a owl:Class ;
  rdfs:label "Bad Check Crime Regulation" ;
  rdfs:comment "Represents a bad check crime regulation, including its details and relationships.".

:BadCheckCrimeRegulation :hasRegulation :Regulation ;
  rdfs:label "Has Regulation" ;
  rdfs:comment "Associates a bad check crime regulation with its corresponding regulation." ;
  owl:inverseOf :Regulation :hasBadCheckCrime.

:Regulation a owl:Class ;
  rdfs:label "Regulation" ;
  rdfs:comment "Represents a regulation, including its details and relationships.".

:Regulation :hasDetail :RegulationDetail ;
  rdfs:label "Has Detail" ;
  rdfs:comment "Associates a regulation with its corresponding detail." ;
  owl:transitiveProperty.

:RegulationDetail a owl:Class ;
  rdfs:label "Regulation Detail" ;
  rdfs:comment "Represents a detail of a regulation, including its specifics and relationships.".

:RegulationDetail :hasSpecification :Specification ;
  rdfs:label "Has Specification" ;
  rdfs:comment "Associates a regulation detail with its corresponding specification." ;
  owl:transitiveProperty.

:Specification a owl:Class ;
  rdfs:label "Specification" ;
  rdfs:comment "Represents a specification, including its details and relationships.".