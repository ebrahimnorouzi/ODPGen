@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Action Request Context Ontology" ;
  rdfs:comment "Formal description of a requested action by an assignee on a target asset.".

:Request a owl:Class ;
  rdfs:label "Request" ;
  rdfs:comment "Formal description of a requested action by an assignee on a target asset.".

:Assignee a owl:Class ;
  rdfs:label "Assignee" ;
  rdfs:comment "Person or entity requesting the action.".

:TargetAsset a owl:Class ;
  rdfs:label "Target Asset" ;
  rdfs:comment "Asset on which the action is requested.".

:TemporalContext a owl:Class ;
  rdfs:label "Temporal Context" ;
  rdfs:comment "Temporal information about the request.".

:TemporalContext rdfs:subClassOf owl:Thing.

:TemporalContext a owl:Class ;
  rdfs:comment "Temporal information about the request.".

