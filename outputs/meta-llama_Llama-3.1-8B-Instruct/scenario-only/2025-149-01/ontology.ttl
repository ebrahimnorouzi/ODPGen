@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Relational Database Access Ontology" ;
  rdfs:comment "Ontology for modeling access to relational databases queried via SQL.".

:User a owl:Class ;
  rdfs:label "User" ;
  rdfs:comment "An individual who accesses the relational database.".

:Database a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A relational database instance.".

:SQLQuery a owl:Class ;
  rdfs:label "SQL Query" ;
  rdfs:comment "A query expressed in Structured Query Language (SQL).".

:Access a owl:Class ;
  rdfs:label "Access" ;
  rdfs:comment "The act of accessing a relational database.".

:hasUser a owl:ObjectProperty ;
  rdfs:label "has User" ;
  rdfs:comment "The user who performed the access." ;
  rdfs:domain :Access ;
  rdfs:range :User.

:hasDatabase a owl:ObjectProperty ;
  rdfs:label "has Database" ;
  rdfs:comment "The relational database instance being accessed." ;
  rdfs:domain :Access ;
  rdfs:range :Database.

:hasSQLQuery a owl:ObjectProperty ;
  rdfs:label "has SQL Query" ;
  rdfs:comment "The SQL query executed during access." ;
  rdfs:domain :Access ;
  rdfs:range :SQLQuery.

:UserID a owl:DatatypeProperty ;
  rdfs:label "User ID" ;
  rdfs:comment "A unique identifier for the user." ;
  rdfs:domain :User ;
  rdfs:range xsd:string.

:DatabaseName a owl:DatatypeProperty ;
  rdfs:label "Database Name" ;
  rdfs:comment "The name of the relational database instance." ;
  rdfs:domain :Database ;
  rdfs:range xsd:string.

:SQLQueryText a owl:DatatypeProperty ;
  rdfs:label "SQL Query Text" ;
  rdfs:comment "The text of the SQL query." ;
  rdfs:domain :SQLQuery ;
  rdfs:range xsd:string.

:AccessTime a owl:DatatypeProperty ;
  rdfs:label "Access Time" ;
  rdfs:comment "The timestamp of the access event." ;
  rdfs:domain :Access ;
  rdfs:range xsd:dateTime.

:Access a owl:disjointWith :Database ;
  owl:disjointWith :SQLQuery ;
  owl:disjointWith :User.