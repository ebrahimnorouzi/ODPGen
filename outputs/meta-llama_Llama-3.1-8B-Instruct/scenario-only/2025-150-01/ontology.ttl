@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Message Protocol Ontology" ;
  rdfs:comment "Modeling MQTT message protocols for automated process data.".

:MQTTMessage a owl:Class ;
  rdfs:label "MQTT Message" ;
  rdfs:comment "A message transmitted via MQTT protocol.".

:MQTTMessageFormat a owl:Class ;
  rdfs:label "MQTT Message Format" ;
  rdfs:comment "Format of an MQTT message, e.g., plain text, CSV, JSON.".

:MQTTMessageEncoding a owl:Class ;
  rdfs:label "MQTT Message Encoding" ;
  rdfs:comment "Encoding of an MQTT message, e.g., character set.".

:MQTTMessageFormatFormat a owl:Class ;
  rdfs:label "MQTT Message Format Format" ;
  rdfs:comment "Format of an MQTT message format, e.g., JSON.".

:hasFormat a owl:Property ;
  rdfs:label "has Format" ;
  rdfs:comment "The format of an MQTT message." ;
  rdfs:domain :MQTTMessage ;
  rdfs:range :MQTTMessageFormat.

:hasEncoding a owl:Property ;
  rdfs:label "has Encoding" ;
  rdfs:comment "The encoding of an MQTT message." ;
  rdfs:domain :MQTTMessage ;
  rdfs:range :MQTTMessageEncoding.

:hasFormatFormat a owl:Property ;
  rdfs:label "has Format Format" ;
  rdfs:comment "The format of an MQTT message format." ;
  rdfs:domain :MQTTMessageFormat ;
  rdfs:range :MQTTMessageFormatFormat.

:MQTTMessageFormatFormat rdfs:subClassOf :MQTTMessageFormat ;
  owl:disjointWith :MQTTMessageFormat.

:MQTTMessageFormat rdfs:subClassOf :MQTTMessage ;
  owl:disjointWith :MQTTMessage.

:MQTTMessageEncoding rdfs:subClassOf :MQTTMessage ;
  owl:disjointWith :MQTTMessage.