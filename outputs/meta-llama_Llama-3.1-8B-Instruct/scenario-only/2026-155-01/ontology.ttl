@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey Ontology" ;
  rdfs:comment "Models the structure of scientific survey activities performed on cultural heritage entities.".

:Survey a owl:Class ;
  rdfs:label "Survey" ;
  rdfs:comment "Scientific survey activity on a cultural heritage entity.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "Result of a survey activity.".

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "Technique used in a survey activity.".

:EquipmentConfiguration a owl:Class ;
  rdfs:label "Equipment Configuration" ;
  rdfs:comment "Setup of equipment used in a survey activity.".

:InterpretationProcess a owl:Class ;
  rdfs:label "Interpretation Process" ;
  rdfs:comment "Process of interpreting survey results.".

:hasObservation a owl:ObjectProperty ;
  rdfs:label "has Observation" ;
  rdfs:comment "Relationship between a survey and its observations." ;
  owl:domain :Survey ;
  owl:range :Observation.

:usesMethod a owl:ObjectProperty ;
  rdfs:label "uses Method" ;
  rdfs:comment "Relationship between a survey and its used methods." ;
  owl:domain :Survey ;
  owl:range :Method.

:usesEquipment a owl:ObjectProperty ;
  rdfs:label "uses Equipment" ;
  rdfs:comment "Relationship between a survey and its used equipment configurations." ;
  owl:domain :Survey ;
  owl:range :EquipmentConfiguration.

:interprets a owl:ObjectProperty ;
  rdfs:label "interprets" ;
  rdfs:comment "Relationship between an interpretation process and its related observations." ;
  owl:domain :InterpretationProcess ;
  owl:range :Observation.

:hasMethod a owl:ObjectProperty ;
  rdfs:label "has Method" ;
  rdfs:comment "Relationship between an equipment configuration and its used methods." ;
  owl:domain :EquipmentConfiguration ;
  owl:range :Method.

:hasEquipment a owl:ObjectProperty ;
  rdfs:label "has Equipment" ;
  rdfs:comment "Relationship between an observation and its related equipment configurations." ;
  owl:domain :Observation ;
  owl:range :EquipmentConfiguration.