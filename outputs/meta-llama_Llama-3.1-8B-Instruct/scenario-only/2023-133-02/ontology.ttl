@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Asthma Patient Monitoring Ontology" ;
  rdfs:comment "Ontology for modeling asthma patient monitoring data".

:AsthmaPatient a owl:Class ;
  rdfs:label "Asthma Patient" ;
  rdfs:comment "A patient with asthma".

:AsthmaSymptom a owl:Class ;
  rdfs:label "Asthma Symptom" ;
  rdfs:comment "A symptom of asthma, e.g. cough, chest tightness".

:Cough a owl:Class ;
  rdfs:label "Cough" ;
  rdfs:comment "A specific asthma symptom, cough" ;
  rdfs:subClassOf :AsthmaSymptom.

:ChestTightness a owl:Class ;
  rdfs:label "Chest Tightness" ;
  rdfs:comment "A specific asthma symptom, chest tightness" ;
  rdfs:subClassOf :AsthmaSymptom.

:Wheezing a owl:Class ;
  rdfs:label "Wheezing" ;
  rdfs:comment "A specific asthma symptom, wheezing" ;
  rdfs:subClassOf :AsthmaSymptom.

:BreathingPattern a owl:Class ;
  rdfs:label "Breathing Pattern" ;
  rdfs:comment "A specific asthma symptom, breathing pattern" ;
  rdfs:subClassOf :AsthmaSymptom.

:Medication a owl:Class ;
  rdfs:label "Medication" ;
  rdfs:comment "A medication taken by an asthma patient".

:OutdoorEnvironmentFeature a owl:Class ;
  rdfs:label "Outdoor Environment Feature" ;
  rdfs:comment "A feature of the outdoor environment, e.g. pollen, AQI".

:Pollen a owl:Class ;
  rdfs:label "Pollen" ;
  rdfs:comment "A specific outdoor environment feature, pollen" ;
  rdfs:subClassOf :OutdoorEnvironmentFeature.

:AirQualityIndex a owl:Class ;
  rdfs:label "Air Quality Index" ;
  rdfs:comment "A specific outdoor environment feature, AQI" ;
  rdfs:subClassOf :OutdoorEnvironmentFeature.

:AsthmaPatientHasSymptom a owl:ObjectProperty ;
  rdfs:label "has symptom" ;
  rdfs:comment "A patient has a symptom" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:AsthmaPatientTakesMedication a owl:ObjectProperty ;
  rdfs:label "takes medication" ;
  rdfs:comment "A patient takes a medication" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Medication.

:AsthmaPatientIsExposedTo a owl:ObjectProperty ;
  rdfs:label "is exposed to" ;
  rdfs:comment "A patient is exposed to an outdoor environment feature" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :OutdoorEnvironmentFeature.

:AsthmaSymptomHasEffectWeight a owl:DatatypeProperty ;
  rdfs:label "has effect weight" ;
  rdfs:comment "A symptom has an effect weight" ;
  rdfs:domain :AsthmaSymptom ;
  rdfs:range xsd:double.

:AsthmaPatientHasCausalRelation a owl:ObjectProperty ;
  rdfs:label "has causal relation" ;
  rdfs:comment "A patient has a causal relation with a symptom" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :AsthmaSymptom.

:AsthmaPatientHasCausalRelationWithPollen a owl:ObjectProperty ;
  rdfs:label "has causal relation with pollen" ;
  rdfs:comment "A patient has a causal relation with pollen" ;
  rdfs:domain :AsthmaPatient ;
  rdfs:range :Pollen.