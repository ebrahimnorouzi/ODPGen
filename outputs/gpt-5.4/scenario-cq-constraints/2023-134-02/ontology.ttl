@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid data interaction log ODP" ;
  rdfs:comment "A minimal ontology design pattern for describing logs of data interactions in Solid-related settings, including the action performed on data, the interacting entity, the log publisher, issuance time, storage location, and application or service used." .

:LogEntry a owl:Class ;
  rdfs:label "Log entry" ;
  rdfs:comment "A record describing a data interaction event for accountability and auditing." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "A type of action performed on data, such as create, update, or erase." .

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "An actor or organization involved in a data interaction or in publishing a log." .

:Data a owl:Class ;
  rdfs:label "Data" ;
  rdfs:comment "Data that is the subject of an interaction and may be stored in a location." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A place where data is stored, such as a location in a Pod." .

:ApplicationService a owl:Class ;
  rdfs:label "Application or service" ;
  rdfs:comment "An application or service used to generate data, if any." .

:hasAction a owl:ObjectProperty ;
  rdfs:label "has action" ;
  rdfs:comment "Relates a log entry to the type of action being performed on the data." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Action .

:hasInteractingEntity a owl:ObjectProperty ;
  rdfs:label "has interacting entity" ;
  rdfs:comment "Relates a log entry to the entity interacting with the data." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Entity .

:hasLogPublisher a owl:ObjectProperty ;
  rdfs:label "has log publisher" ;
  rdfs:comment "Relates a log entry to the entity publishing the log." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Entity .

:hasData a owl:ObjectProperty ;
  rdfs:label "has data" ;
  rdfs:comment "Relates a log entry to the data that is the subject of the interaction." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Data .

:hasStorageLocation a owl:ObjectProperty ;
  rdfs:label "has storage location" ;
  rdfs:comment "Relates data to the location where it is stored." ;
  rdfs:domain :Data ;
  rdfs:range :StorageLocation .

:usedApplicationService a owl:ObjectProperty ;
  rdfs:label "used application or service" ;
  rdfs:comment "Relates a log entry to the application or service used to generate the data, if any." ;
  rdfs:domain :LogEntry ;
  rdfs:range :ApplicationService .

:issuedAt a owl:DatatypeProperty ;
  rdfs:label "issued at" ;
  rdfs:comment "Relates a log entry to the date and time when the log was issued." ;
  rdfs:domain :LogEntry ;
  rdfs:range xsd:dateTime .
