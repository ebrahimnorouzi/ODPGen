@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Court hierarchy and bad check regulation ODP" ;
  rdfs:comment "A minimal ontology design pattern for representing court hierarchies in Indian states and districts, and bad check payment information including transaction type, payment time, and transaction status." .

:State a owl:Class ;
  rdfs:label "State" ;
  rdfs:comment "A state of India used to locate courts and count districts." .

:District a owl:Class ;
  rdfs:label "District" ;
  rdfs:comment "An administrative district within a state." .

:Court a owl:Class ;
  rdfs:label "Court" ;
  rdfs:comment "A court in the legal hierarchy." .

:DistrictCourt a owl:Class ;
  rdfs:label "District court" ;
  rdfs:comment "A court at the district level." ;
  rdfs:subClassOf :Court .

:BadCheck a owl:Class ;
  rdfs:label "Bad check" ;
  rdfs:comment "A check involved in a bad check case or regulation context." .

:CheckPayment a owl:Class ;
  rdfs:label "Check payment" ;
  rdfs:comment "A payment event involving a check." .

:TransactionType a owl:Class ;
  rdfs:label "Transaction type" ;
  rdfs:comment "A type assigned to a check transaction." .

:TransactionStatus a owl:Class ;
  rdfs:label "Transaction status" ;
  rdfs:comment "A status assigned to a check payment transaction." .

:locatedInState a owl:ObjectProperty ;
  rdfs:label "located in state" ;
  rdfs:comment "Relates a district court to the state in which it is located." ;
  rdfs:domain :DistrictCourt ;
  rdfs:range :State .

:hasDistrict a owl:ObjectProperty ;
  rdfs:label "has district" ;
  rdfs:comment "Relates a state to a district that is within it." ;
  rdfs:domain :State ;
  rdfs:range :District .

:hasAuthorityOver a owl:ObjectProperty ;
  rdfs:label "has authority over" ;
  rdfs:comment "Relates a court to another court over which it has authority." ;
  rdfs:domain :Court ;
  rdfs:range :Court .

:hasCheckTransactionType a owl:ObjectProperty ;
  rdfs:label "has check transaction type" ;
  rdfs:comment "Relates a bad check to its check transaction type." ;
  rdfs:domain :BadCheck ;
  rdfs:range :TransactionType .

:hasCheckPayment a owl:ObjectProperty ;
  rdfs:label "has check payment" ;
  rdfs:comment "Relates a bad check to its check payment." ;
  rdfs:domain :BadCheck ;
  rdfs:range :CheckPayment .

:hasTransactionStatus a owl:ObjectProperty ;
  rdfs:label "has transaction status" ;
  rdfs:comment "Relates a check payment to its transaction status." ;
  rdfs:domain :CheckPayment ;
  rdfs:range :TransactionStatus .

:paymentDate a owl:DatatypeProperty ;
  rdfs:label "payment date" ;
  rdfs:comment "The date and time when a check payment occurred." ;
  rdfs:domain :CheckPayment ;
  rdfs:range xsd:dateTime .