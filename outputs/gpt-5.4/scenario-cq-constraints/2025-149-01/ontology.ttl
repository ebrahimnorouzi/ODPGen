@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "RDB SQL access control ontology design pattern" ;
  rdfs:comment "A minimal ontology design pattern for representing relational database schema elements, access-control policies over tables, columns, and rows, and SQL query AST references linked to schema entities, actions, scopes, and enforcement-relevant tags." .

:RelationalDatabase a owl:Class ;
  rdfs:label "Relational database" ;
  rdfs:comment "A relational database treated as a first-class schema entity." .

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "A relational table belonging to a relational database." .

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "A relational column belonging to a table." .

:PrimaryKey a owl:Class ;
  rdfs:label "Primary key" ;
  rdfs:comment "A primary-key relationship or constraint in the schema." .

:ForeignKey a owl:Class ;
  rdfs:label "Foreign key" ;
  rdfs:comment "A foreign-key relationship or constraint in the schema." .

:Agent a owl:Class ;
  rdfs:label "Agent" ;
  rdfs:comment "An agent for whom a policy can be defined and who can execute a query statement." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "An access-control policy defined for a specific agent." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "A high-level semantic action type used by policies and SQL statements." .

:ReadAction a owl:Class ;
  rdfs:label "Read action" ;
  rdfs:comment "A high-level action representing read access." ;
  rdfs:subClassOf :Action .

:ModifyAction a owl:Class ;
  rdfs:label "Modify action" ;
  rdfs:comment "A high-level action representing modification access." ;
  rdfs:subClassOf :Action .

:ActionScope a owl:Class ;
  rdfs:label "Action scope" ;
  rdfs:comment "An operational scope associated with an action." .

:ViewActionScope a owl:Class ;
  rdfs:label "View action scope" ;
  rdfs:comment "An action scope for viewing read results." ;
  rdfs:subClassOf :ActionScope .

:ProcessActionScope a owl:Class ;
  rdfs:label "Process action scope" ;
  rdfs:comment "An action scope for processing read results." ;
  rdfs:subClassOf :ActionScope .

:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "A condition used to define row-level policy restrictions for later enforcement." .

:PolicyTarget a owl:Class ;
  rdfs:label "Policy target" ;
  rdfs:comment "A target resource to which a policy applies, such as a table or column." .

:TablePolicyTarget a owl:Class ;
  rdfs:label "Table policy target" ;
  rdfs:comment "A policy target at table level." ;
  rdfs:subClassOf :PolicyTarget .

:ColumnPolicyTarget a owl:Class ;
  rdfs:label "Column policy target" ;
  rdfs:comment "A policy target at column level." ;
  rdfs:subClassOf :PolicyTarget .

:Effect a owl:Class ;
  rdfs:label "Effect" ;
  rdfs:comment "The effect of a policy, such as prohibition." .

:Prohibition a owl:Class ;
  rdfs:label "Prohibition" ;
  rdfs:comment "A policy effect indicating that an action is prohibited." ;
  rdfs:subClassOf :Effect .

:SQLNode a owl:Class ;
  rdfs:label "SQL node" ;
  rdfs:comment "A node in an AST-based semantic graph for a SQL query." .

:SQLStatement a owl:Class ;
  rdfs:label "SQL statement" ;
  rdfs:comment "A SQL statement represented as a node in the semantic graph." ;
  rdfs:subClassOf :SQLNode .

:SelectStatement a owl:Class ;
  rdfs:label "Select statement" ;
  rdfs:comment "A SQL SELECT statement." ;
  rdfs:subClassOf :SQLStatement .

:UpdateStatement a owl:Class ;
  rdfs:label "Update statement" ;
  rdfs:comment "A SQL UPDATE statement." ;
  rdfs:subClassOf :SQLStatement .

:SQLClause a owl:Class ;
  rdfs:label "SQL clause" ;
  rdfs:comment "A clause within a SQL statement that can be assigned an operational scope." ;
  rdfs:subClassOf :SQLNode .

:ReferenceNode a owl:Class ;
  rdfs:label "Reference node" ;
  rdfs:comment "A reference node in the SQL semantic graph." ;
  rdfs:subClassOf :SQLNode .

:TableRef a owl:Class ;
  rdfs:label "Table reference" ;
  rdfs:comment "A reference to a table in a SQL query." ;
  rdfs:subClassOf :ReferenceNode .

:ColumnRef a owl:Class ;
  rdfs:label "Column reference" ;
  rdfs:comment "A reference to a column in a SQL query." ;
  rdfs:subClassOf :ReferenceNode .

:EnforcementTag a owl:Class ;
  rdfs:label "Enforcement tag" ;
  rdfs:comment "A tag assigned by reasoning for enforcement-relevant outcomes." .

:Violated a owl:Class ;
  rdfs:label "Violated" ;
  rdfs:comment "An enforcement tag indicating that a referenced table or column violates a matching policy." ;
  rdfs:subClassOf :EnforcementTag .

:RowTag a owl:Class ;
  rdfs:label "Row tag" ;
  rdfs:comment "An enforcement tag indicating row-level restriction relevance for a referenced table or column." ;
  rdfs:subClassOf :EnforcementTag .

:hasTable a owl:ObjectProperty ;
  rdfs:label "has table" ;
  rdfs:comment "Links a relational database to a table that belongs to it." ;
  rdfs:domain :RelationalDatabase ;
  rdfs:range :Table .

:hasColumn a owl:ObjectProperty ;
  rdfs:label "has column" ;
  rdfs:comment "Links a table to a column that belongs to it." ;
  rdfs:domain :Table ;
  rdfs:range :Column .

:hasPrimaryKey a owl:ObjectProperty ;
  rdfs:label "has primary key" ;
  rdfs:comment "Links a table to its primary-key relationship." ;
  rdfs:domain :Table ;
  rdfs:range :PrimaryKey .

:primaryKeyColumn a owl:ObjectProperty ;
  rdfs:label "primary key column" ;
  rdfs:comment "Links a primary-key relationship to a participating column." ;
  rdfs:domain :PrimaryKey ;
  rdfs:range :Column .

:hasForeignKey a owl:ObjectProperty ;
  rdfs:label "has foreign key" ;
  rdfs:comment "Links a table to a foreign-key relationship." ;
  rdfs:domain :Table ;
  rdfs:range :ForeignKey .

:foreignKeyColumn a owl:ObjectProperty ;
  rdfs:label "foreign key column" ;
  rdfs:comment "Links a foreign-key relationship to the referencing column." ;
  rdfs:domain :ForeignKey ;
  rdfs:range :Column .

:referencesColumn a owl:ObjectProperty ;
  rdfs:label "references column" ;
  rdfs:comment "Links a foreign-key relationship to the referenced column." ;
  rdfs:domain :ForeignKey ;
  rdfs:range :Column .

:forAgent a owl:ObjectProperty ;
  rdfs:label "for agent" ;
  rdfs:comment "Links a policy to the specific agent for whom it is defined." ;
  rdfs:domain :Policy ;
  rdfs:range :Agent .

:hasEffect a owl:ObjectProperty ;
  rdfs:label "has effect" ;
  rdfs:comment "Links a policy to its effect." ;
  rdfs:domain :Policy ;
  rdfs:range :Effect .

:hasAction a owl:ObjectProperty ;
  rdfs:label "has action" ;
  rdfs:comment "Links a policy or SQL statement to a high-level semantic action type." ;
  rdfs:range :Action .

:hasScope a owl:ObjectProperty ;
  rdfs:label "has scope" ;
  rdfs:comment "Links a policy or SQL clause to an operational action scope." ;
  rdfs:range :ActionScope .

:hasTarget a owl:ObjectProperty ;
  rdfs:label "has target" ;
  rdfs:comment "Links a policy to its target resource abstraction." ;
  rdfs:domain :Policy ;
  rdfs:range :PolicyTarget .

:targetsTable a owl:ObjectProperty ;
  rdfs:label "targets table" ;
  rdfs:comment "Links a table-level policy target to the table it addresses." ;
  rdfs:domain :TablePolicyTarget ;
  rdfs:range :Table .

:targetsColumn a owl:ObjectProperty ;
  rdfs:label "targets column" ;
  rdfs:comment "Links a column-level policy target to the column it addresses." ;
  rdfs:domain :ColumnPolicyTarget ;
  rdfs:range :Column .

:hasCondition a owl:ObjectProperty ;
  rdfs:label "has condition" ;
  rdfs:comment "Links a policy to a condition used for row-level restriction." ;
  rdfs:domain :Policy ;
  rdfs:range :Condition .

:hasClause a owl:ObjectProperty ;
  rdfs:label "has clause" ;
  rdfs:comment "Links a SQL statement to a clause in its AST-based semantic graph." ;
  rdfs:domain :SQLStatement ;
  rdfs:range :SQLClause .

:hasReference a owl:ObjectProperty ;
  rdfs:label "has reference" ;
  rdfs:comment "Links a SQL node to a reference node in the semantic graph." ;
  rdfs:domain :SQLNode ;
  rdfs:range :ReferenceNode .

:executedBy a owl:ObjectProperty ;
  rdfs:label "executed by" ;
  rdfs:comment "Links a query statement to the agent executing it." ;
  rdfs:domain :SQLStatement ;
  rdfs:range :Agent .

:effectiveActionScope a owl:ObjectProperty ;
  rdfs:label "effective action scope" ;
  rdfs:comment "Links a reference node to the effective action scope propagated to it." ;
  rdfs:domain :ReferenceNode ;
  rdfs:range :ActionScope .

:refersToTable a owl:ObjectProperty ;
  rdfs:label "refers to table" ;
  rdfs:comment "Links a table reference in a query to the corresponding schema table." ;
  rdfs:domain :TableRef ;
  rdfs:range :Table .

:refersToColumn a owl:ObjectProperty ;
  rdfs:label "refers to column" ;
  rdfs:comment "Links a column reference in a query to the corresponding schema column." ;
  rdfs:domain :ColumnRef ;
  rdfs:range :Column .

:hasEnforcementTag a owl:ObjectProperty ;
  rdfs:label "has enforcement tag" ;
  rdfs:comment "Links a reference node to an enforcement-relevant tag inferred from matching policy, action, and scope." ;
  rdfs:domain :ReferenceNode ;
  rdfs:range :EnforcementTag .

:sqlName a owl:DatatypeProperty ;
  rdfs:label "SQL name" ;
  rdfs:comment "A SQL-level name for a schema or query element." ;
  rdfs:range xsd:string .

:conditionExpression a owl:DatatypeProperty ;
  rdfs:label "condition expression" ;
  rdfs:comment "A textual expression representing a row-level condition for later enforcement." ;
  rdfs:domain :Condition ;
  rdfs:range xsd:string .