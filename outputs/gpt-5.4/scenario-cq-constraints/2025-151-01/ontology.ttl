@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Evaluation Request ODP" ;
  rdfs:comment "A minimal ontology design pattern for representing an evaluation request as a formal description of a requested action by an assignee on a target asset, optionally enriched with contextual information such as temporal, spatial, role, and request-capability context." .

:EvaluationRequest a owl:Class ;
  rdfs:label "Evaluation Request" ;
  rdfs:comment "A formal description of a requested action by an assignee on a target asset, possibly enriched with additional contextual information for evaluation." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "An action that is requested in an evaluation request." .

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "An entity that issues an evaluation request." .

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "A target asset to which the requested action in an evaluation request applies." .

:ContextInformation a owl:Class ;
  rdfs:label "Context Information" ;
  rdfs:comment "Additional contextual information included in an evaluation request to further constrain evaluation." .

:TemporalContext a owl:Class ;
  rdfs:label "Temporal Context" ;
  rdfs:comment "Context information concerning time, such as weekday-related constraints." ;
  rdfs:subClassOf :ContextInformation .

:SpatialContext a owl:Class ;
  rdfs:label "Spatial Context" ;
  rdfs:comment "Context information concerning location, such as geographic origin constraints." ;
  rdfs:subClassOf :ContextInformation .

:RoleContext a owl:Class ;
  rdfs:label "Role Context" ;
  rdfs:comment "Context information concerning role-related constraints, such as employee status." ;
  rdfs:subClassOf :ContextInformation .

:RequestCapabilityContext a owl:Class ;
  rdfs:label "Request Capability Context" ;
  rdfs:comment "Context information concerning request-capability aspects relevant to evaluation." ;
  rdfs:subClassOf :ContextInformation .

:requestedAction a owl:ObjectProperty ;
  rdfs:label "requested action" ;
  rdfs:comment "Relates an evaluation request to the action being requested." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :Action .

:issuedBy a owl:ObjectProperty ;
  rdfs:label "issued by" ;
  rdfs:comment "Relates an evaluation request to the party issuing it." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :Party .

:targetAsset a owl:ObjectProperty ;
  rdfs:label "target asset" ;
  rdfs:comment "Relates an evaluation request to the asset that is the target of the requested action." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :Asset .

:issuedAt a owl:DatatypeProperty ;
  rdfs:label "issued at" ;
  rdfs:comment "Relates an evaluation request to the date and time at which it was issued." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range xsd:dateTime .

:hasContextInformation a owl:ObjectProperty ;
  rdfs:label "has context information" ;
  rdfs:comment "Relates an evaluation request to additional contextual information that further constrains evaluation." ;
  rdfs:domain :EvaluationRequest ;
  rdfs:range :ContextInformation .