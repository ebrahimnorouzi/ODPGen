@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Policy Access Request ODP" ;
  rdfs:comment "A minimal ontology design pattern for representing a policy, its creator, assignee, issuance date, and the application, access mode, personal data, and purpose involved in a data access request in the Solid governance context." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy that governs access to personal data." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity involved in the policy, such as its creator or assignee." .

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "An application or service used to access data." .

:AccessRequest a owl:Class ;
  rdfs:label "Access Request" ;
  rdfs:comment "A request to access personal data under a policy." .

:AccessMode a owl:Class ;
  rdfs:label "Access Mode" ;
  rdfs:comment "The mode of access being requested for personal data." .

:PersonalData a owl:Class ;
  rdfs:label "Personal Data" ;
  rdfs:comment "Personal data that is being accessed." .

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose for which personal data is accessed." .

:hasPolicyIdentifier a owl:DatatypeProperty ;
  rdfs:label "has policy identifier" ;
  rdfs:comment "Relates a policy to its unique identifier." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:string .

:hasCreator a owl:ObjectProperty ;
  rdfs:label "has creator" ;
  rdfs:comment "Relates a policy to the actor who created it." ;
  rdfs:domain :Policy ;
  rdfs:range :Actor .

:issuedAt a owl:DatatypeProperty ;
  rdfs:label "issued at" ;
  rdfs:comment "Relates a policy to the date and time when it was issued." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:dateTime .

:hasAssignee a owl:ObjectProperty ;
  rdfs:label "has assignee" ;
  rdfs:comment "Relates a policy to the actor to whom it is assigned." ;
  rdfs:domain :Policy ;
  rdfs:range :Actor .

:hasAccessRequest a owl:ObjectProperty ;
  rdfs:label "has access request" ;
  rdfs:comment "Relates a policy to an access request governed by that policy." ;
  rdfs:domain :Policy ;
  rdfs:range :AccessRequest .

:usesApplication a owl:ObjectProperty ;
  rdfs:label "uses application" ;
  rdfs:comment "Relates an access request to the application or service used to access the data." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :Application .

:hasAccessMode a owl:ObjectProperty ;
  rdfs:label "has access mode" ;
  rdfs:comment "Relates an access request to the access mode being requested." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :AccessMode .

:accessesPersonalData a owl:ObjectProperty ;
  rdfs:label "accesses personal data" ;
  rdfs:comment "Relates an access request to the personal data being accessed." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :PersonalData .

:hasPurpose a owl:ObjectProperty ;
  rdfs:label "has purpose" ;
  rdfs:comment "Relates an access request to the purpose for accessing the personal data." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :Purpose .