@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Temporal Indirection for Persistent Identifiers ODP" ;
  rdfs:comment "A minimal ontology design pattern for modeling persistent identifiers that stably denote changing referents over time, including temporal bindings, transitions, observations, and triggering rules." .

:PersistentIdentifier a owl:Class ;
  rdfs:label "Persistent Identifier" ;
  rdfs:comment "A stable identifier that continues across time while referring to different entities at different periods." .

:Referent a owl:Class ;
  rdfs:label "Referent" ;
  rdfs:comment "An entity that is referenced by a persistent identifier during some time interval." .

:TemporalBinding a owl:Class ;
  rdfs:label "Temporal Binding" ;
  rdfs:comment "A time-bounded association between a persistent identifier and a referent." .

:Transition a owl:Class ;
  rdfs:label "Transition" ;
  rdfs:comment "A change event in which a persistent identifier stops being bound to one referent and starts being bound to another." .

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A recorded attribute or value associated with a specific referent." .

:TransitionRule a owl:Class ;
  rdfs:label "Transition Rule" ;
  rdfs:comment "A rule that triggers or explains a transition between referents." .

:hasBinding a owl:ObjectProperty ;
  rdfs:label "has binding" ;
  rdfs:comment "Relates a persistent identifier to a temporal binding that specifies one of its referents over a time interval." ;
  rdfs:domain :PersistentIdentifier ;
  rdfs:range :TemporalBinding .

:bindsIdentifier a owl:ObjectProperty ;
  rdfs:label "binds identifier" ;
  rdfs:comment "Relates a temporal binding to the persistent identifier whose reference it specifies." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :PersistentIdentifier .

:bindsReferent a owl:ObjectProperty ;
  rdfs:label "binds referent" ;
  rdfs:comment "Relates a temporal binding to the referent that is referenced during the binding interval." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range :Referent .

:hasObservation a owl:ObjectProperty ;
  rdfs:label "has observation" ;
  rdfs:comment "Relates a referent to an observation associated with that referent." ;
  rdfs:domain :Referent ;
  rdfs:range :Observation .

:fromBinding a owl:ObjectProperty ;
  rdfs:label "from binding" ;
  rdfs:comment "Relates a transition to the earlier temporal binding that is being ended or superseded." ;
  rdfs:domain :Transition ;
  rdfs:range :TemporalBinding .

:toBinding a owl:ObjectProperty ;
  rdfs:label "to binding" ;
  rdfs:comment "Relates a transition to the later temporal binding that begins after the transition." ;
  rdfs:domain :Transition ;
  rdfs:range :TemporalBinding .

:triggeredByRule a owl:ObjectProperty ;
  rdfs:label "triggered by rule" ;
  rdfs:comment "Relates a transition to the rule that triggered or justified it." ;
  rdfs:domain :Transition ;
  rdfs:range :TransitionRule .

:hasStartTime a owl:DatatypeProperty ;
  rdfs:label "has start time" ;
  rdfs:comment "Specifies the start timestamp of a temporal binding." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range xsd:dateTime .

:hasEndTime a owl:DatatypeProperty ;
  rdfs:label "has end time" ;
  rdfs:comment "Specifies the end timestamp of a temporal binding." ;
  rdfs:domain :TemporalBinding ;
  rdfs:range xsd:dateTime .

:hasTransitionTime a owl:DatatypeProperty ;
  rdfs:label "has transition time" ;
  rdfs:comment "Specifies the timestamp at which a transition occurred." ;
  rdfs:domain :Transition ;
  rdfs:range xsd:dateTime .