@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Cultural Heritage Survey ODP" ;
  rdfs:comment "A minimal ontology design pattern for modeling cultural heritage survey activities, their targets, methods, observations, participants, equipment configurations, interpretations, post-processed outputs, and acquisition parameters." .

:SurveyActivity a owl:Class ;
  rdfs:label "Survey activity" ;
  rdfs:comment "A scientific survey or investigation activity performed on a cultural heritage entity or a feature of interest." .

:CulturalProperty a owl:Class ;
  rdfs:label "Cultural property" ;
  rdfs:comment "A cultural heritage entity that can be the target of a survey or investigation activity." .

:FeatureOfInterest a owl:Class ;
  rdfs:label "Feature of interest" ;
  rdfs:comment "A specific feature or aspect of a cultural property that can be targeted by a survey or investigation activity." .

:Method a owl:Class ;
  rdfs:label "Method" ;
  rdfs:comment "A method or investigation technique adopted in a survey or investigation activity." .

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation produced during a survey or investigation activity." .

:Expert a owl:Class ;
  rdfs:label "Expert" ;
  rdfs:comment "A person participating in a survey or investigation activity." .

:Participation a owl:Class ;
  rdfs:label "Participation" ;
  rdfs:comment "A participation relation linking an expert to a survey activity and specifying the role held in that activity." .

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role held by an expert in a survey or investigation activity." .

:EquipmentConfiguration a owl:Class ;
  rdfs:label "Equipment configuration" ;
  rdfs:comment "A technical configuration used to conduct a survey or investigation activity." .

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware component used within an equipment configuration." .

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software component used within an equipment configuration." .

:Interpretation a owl:Class ;
  rdfs:label "Interpretation" ;
  rdfs:comment "An interpretation or claim supported by observations produced during a survey." .

:PostProcessedOutput a owl:Class ;
  rdfs:label "Post-processed output" ;
  rdfs:comment "An output generated by post-processing and related to underlying acquisition or observation activities." .

:PhotographicAcquisitionCycle a owl:Class ;
  rdfs:label "Photographic acquisition cycle" ;
  rdfs:comment "A photographic acquisition cycle occurring within a survey activity and characterised by acquisition parameters." .

:AcquisitionParameterSet a owl:Class ;
  rdfs:label "Acquisition parameter set" ;
  rdfs:comment "A set of acquisition parameters characterising a specific photographic acquisition cycle." .

:targetsProperty a owl:ObjectProperty ;
  rdfs:label "targets property" ;
  rdfs:comment "Relates a survey activity to the cultural property on which it was performed." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :CulturalProperty .

:targetsFeature a owl:ObjectProperty ;
  rdfs:label "targets feature" ;
  rdfs:comment "Relates a survey activity to a specific feature of interest on which it was performed." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :FeatureOfInterest .

:usesMethod a owl:ObjectProperty ;
  rdfs:label "uses method" ;
  rdfs:comment "Relates a survey activity to the method or investigation technique adopted." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :Method .

:producedObservation a owl:ObjectProperty ;
  rdfs:label "produced observation" ;
  rdfs:comment "Relates a survey activity to an observation produced during that activity." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :Observation .

:hasParticipation a owl:ObjectProperty ;
  rdfs:label "has participation" ;
  rdfs:comment "Relates a survey activity to a participation through which an expert and role are specified." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :Participation .

:involvesExpert a owl:ObjectProperty ;
  rdfs:label "involves expert" ;
  rdfs:comment "Relates a participation to the expert participating in the survey activity." ;
  rdfs:domain :Participation ;
  rdfs:range :Expert .

:withRole a owl:ObjectProperty ;
  rdfs:label "with role" ;
  rdfs:comment "Relates a participation to the role held by the expert in the survey activity." ;
  rdfs:domain :Participation ;
  rdfs:range :Role .

:usesEquipmentConfiguration a owl:ObjectProperty ;
  rdfs:label "uses equipment configuration" ;
  rdfs:comment "Relates a survey activity to the equipment configuration used to conduct it." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :EquipmentConfiguration .

:hasHardware a owl:ObjectProperty ;
  rdfs:label "has hardware" ;
  rdfs:comment "Relates an equipment configuration to a hardware component used within it." ;
  rdfs:domain :EquipmentConfiguration ;
  rdfs:range :Hardware .

:hasSoftware a owl:ObjectProperty ;
  rdfs:label "has software" ;
  rdfs:comment "Relates an equipment configuration to a software component used within it." ;
  rdfs:domain :EquipmentConfiguration ;
  rdfs:range :Software .

:supportsInterpretation a owl:ObjectProperty ;
  rdfs:label "supports interpretation" ;
  rdfs:comment "Relates an observation to an interpretation or claim that it supports." ;
  rdfs:domain :Observation ;
  rdfs:range :Interpretation .

:derivedFromObservation a owl:ObjectProperty ;
  rdfs:label "derived from observation" ;
  rdfs:comment "Relates a post-processed output to an underlying observation activity result from which it was derived." ;
  rdfs:domain :PostProcessedOutput ;
  rdfs:range :Observation .

:hasAcquisitionCycle a owl:ObjectProperty ;
  rdfs:label "has acquisition cycle" ;
  rdfs:comment "Relates a survey activity to a photographic acquisition cycle occurring within it." ;
  rdfs:domain :SurveyActivity ;
  rdfs:range :PhotographicAcquisitionCycle .

:hasAcquisitionParameterSet a owl:ObjectProperty ;
  rdfs:label "has acquisition parameter set" ;
  rdfs:comment "Relates a photographic acquisition cycle to the acquisition parameter set that characterises it." ;
  rdfs:domain :PhotographicAcquisitionCycle ;
  rdfs:range :AcquisitionParameterSet .

:exposureTime a owl:DatatypeProperty ;
  rdfs:label "exposure time" ;
  rdfs:comment "The exposure time value recorded in an acquisition parameter set." ;
  rdfs:domain :AcquisitionParameterSet ;
  rdfs:range xsd:string .

:isoValue a owl:DatatypeProperty ;
  rdfs:label "ISO value" ;
  rdfs:comment "The ISO value recorded in an acquisition parameter set." ;
  rdfs:domain :AcquisitionParameterSet ;
  rdfs:range xsd:string .

:apertureValue a owl:DatatypeProperty ;
  rdfs:label "aperture value" ;
  rdfs:comment "The aperture value recorded in an acquisition parameter set." ;
  rdfs:domain :AcquisitionParameterSet ;
  rdfs:range xsd:string .