@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance registry ontology design pattern" ;
  rdfs:comment "A minimal ontology design pattern for representing a registry of data categories in a Solid setting, including who maintains the registry, when it was created or updated, what data types are available, where a data type is stored, and what policy is associated with the data." .

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry that records available data types, their storage locations, associated policies, and maintenance metadata." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity that can maintain the registry." .

:DataType a owl:Class ;
  rdfs:label "Data type" ;
  rdfs:comment "A category or type of data available in a Pod." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A location where a specific type of data is stored." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy associated with a data type." .

:maintainedBy a owl:ObjectProperty ;
  rdfs:label "maintained by" ;
  rdfs:comment "Relates a registry to the actor maintaining it." ;
  rdfs:domain :Registry ;
  rdfs:range :Actor .

:createdAt a owl:DatatypeProperty ;
  rdfs:label "created at" ;
  rdfs:comment "Relates a registry to the date and time when it was created." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .

:updatedAt a owl:DatatypeProperty ;
  rdfs:label "updated at" ;
  rdfs:comment "Relates a registry to the date and time when it was last updated." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .

:hasDataType a owl:ObjectProperty ;
  rdfs:label "has data type" ;
  rdfs:comment "Relates a registry to a data type that is available." ;
  rdfs:domain :Registry ;
  rdfs:range :DataType .

:storedAt a owl:ObjectProperty ;
  rdfs:label "stored at" ;
  rdfs:comment "Relates a data type to the storage location where it is stored." ;
  rdfs:domain :DataType ;
  rdfs:range :StorageLocation .

:hasPolicy a owl:ObjectProperty ;
  rdfs:label "has policy" ;
  rdfs:comment "Relates a data type to a policy associated with that data." ;
  rdfs:domain :DataType ;
  rdfs:range :Policy .