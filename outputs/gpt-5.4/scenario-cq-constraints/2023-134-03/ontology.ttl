@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid data registry governance pattern" ;
  rdfs:comment "A minimal ontology design pattern for describing a registry of data categories in a Solid context, including its maintainer, creation and update times, storage locations for data categories, and associated policies." .

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry that describes available data categories, their storage locations, and related governance information." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity involved in the Solid ecosystem, such as one that maintains a registry." .

:DataCategory a owl:Class ;
  rdfs:label "Data category" ;
  rdfs:comment "A type or category of data that may be available and stored in a Pod." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A location where a specific data category is stored." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy associated with a data category." .

:maintainedBy a owl:ObjectProperty ;
  rdfs:label "maintained by" ;
  rdfs:comment "Relates a registry to the actor maintaining it." ;
  rdfs:domain :Registry ;
  rdfs:range :Actor .

:hasDataCategory a owl:ObjectProperty ;
  rdfs:label "has data category" ;
  rdfs:comment "Relates a registry to a data category that is available." ;
  rdfs:domain :Registry ;
  rdfs:range :DataCategory .

:storedAt a owl:ObjectProperty ;
  rdfs:label "stored at" ;
  rdfs:comment "Relates a data category to the storage location where it is stored." ;
  rdfs:domain :DataCategory ;
  rdfs:range :StorageLocation .

:hasPolicy a owl:ObjectProperty ;
  rdfs:label "has policy" ;
  rdfs:comment "Relates a data category to a policy associated with that data." ;
  rdfs:domain :DataCategory ;
  rdfs:range :Policy .

:createdAt a owl:DatatypeProperty ;
  rdfs:label "created at" ;
  rdfs:comment "The date and time when a registry was created." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .

:updatedAt a owl:DatatypeProperty ;
  rdfs:label "updated at" ;
  rdfs:comment "The date and time when a registry was last updated." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .
