@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance policy request ODP" ;
  rdfs:comment "A minimal ontology design pattern for representing governance-relevant policy requests in Solid apps, including policy identifier, creator, issuance time, assignee, accessing application or service, requested access mode, personal data category, and access purpose." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A governance or privacy policy statement that describes conditions for accessing personal data." .

:Agent a owl:Class ;
  rdfs:label "Agent" ;
  rdfs:comment "An entity that can create, receive, or use a policy, such as a person, organization, application, or service." .

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "A software application used to access data." ;
  rdfs:subClassOf :Agent .

:Service a owl:Class ;
  rdfs:label "Service" ;
  rdfs:comment "A digital service used to access data." ;
  rdfs:subClassOf :Agent .

:AccessRequest a owl:Class ;
  rdfs:label "Access request" ;
  rdfs:comment "A request or policy-governed act of accessing personal data." .

:AccessMode a owl:Class ;
  rdfs:label "Access mode" ;
  rdfs:comment "A mode of access being requested, such as reading, writing, or appending data." .

:PersonalData a owl:Class ;
  rdfs:label "Personal data" ;
  rdfs:comment "Personal data or a category of personal data that may be accessed." .

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose for which personal data is accessed." .

:hasCreator a owl:ObjectProperty ;
  rdfs:label "has creator" ;
  rdfs:comment "Relates a policy to the agent that created it." ;
  rdfs:domain :Policy ;
  rdfs:range :Agent .

:hasAssignee a owl:ObjectProperty ;
  rdfs:label "has assignee" ;
  rdfs:comment "Relates a policy to the agent to whom it is assigned." ;
  rdfs:domain :Policy ;
  rdfs:range :Agent .

:governsRequest a owl:ObjectProperty ;
  rdfs:label "governs request" ;
  rdfs:comment "Relates a policy to an access request that it governs." ;
  rdfs:domain :Policy ;
  rdfs:range :AccessRequest .

:usesApplication a owl:ObjectProperty ;
  rdfs:label "uses application" ;
  rdfs:comment "Relates an access request to the application used to access the data." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :Application .

:usesService a owl:ObjectProperty ;
  rdfs:label "uses service" ;
  rdfs:comment "Relates an access request to the service used to access the data." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :Service .

:hasAccessMode a owl:ObjectProperty ;
  rdfs:label "has access mode" ;
  rdfs:comment "Relates an access request to the access mode being requested." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :AccessMode .

:accessesPersonalData a owl:ObjectProperty ;
  rdfs:label "accesses personal data" ;
  rdfs:comment "Relates an access request to the personal data being accessed." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :PersonalData .

:hasPurpose a owl:ObjectProperty ;
  rdfs:label "has purpose" ;
  rdfs:comment "Relates an access request to the purpose for accessing personal data." ;
  rdfs:domain :AccessRequest ;
  rdfs:range :Purpose .

:policyIdentifier a owl:DatatypeProperty ;
  rdfs:label "policy identifier" ;
  rdfs:comment "A unique identifier for a policy." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:string .

:issuedAt a owl:DatatypeProperty ;
  rdfs:label "issued at" ;
  rdfs:comment "The date and time when a policy was issued." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:dateTime .

:Policy rdfs:subClassOf
  [
    a owl:Restriction ;
    owl:onProperty :policyIdentifier ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :hasCreator ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :issuedAt ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :hasAssignee ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :governsRequest ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] .

:AccessRequest rdfs:subClassOf
  [
    a owl:Restriction ;
    owl:onProperty :hasAccessMode ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :accessesPersonalData ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Restriction ;
    owl:onProperty :hasPurpose ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
  ] ,
  [
    a owl:Class ;
    owl:unionOf ( :Application :Service )
  ] .

:Application owl:disjointWith :Service .