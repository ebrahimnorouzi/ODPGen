@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ndf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Causal Bayesian Network sprinkler ontology design pattern" ;
  rdfs:comment "A minimal OWL ontology design pattern for representing events and weighted causal relations in the sprinkler causal Bayesian network use case, including direct causation and mediation." .

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "A state or occurrence represented as a node in a causal model." .

:CausalRelation a owl:Class ;
  rdfs:label "Causal relation" ;
  rdfs:comment "A directed causal connection from a cause event to an effect event, optionally annotated with an effect weight." .

:MediatedCausalRelation a owl:Class ;
  rdfs:label "Mediated causal relation" ;
  rdfs:comment "A causal relation whose effect on the target event is mediated through another event rather than being direct." ;
  rdfs:subClassOf :CausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasMediator ;
      owl:someValuesFrom :Event
    ] .

:RainySeasonEvent a owl:Class ;
  rdfs:label "Rainy season event" ;
  rdfs:comment "The event that it is rainy season." ;
  rdfs:subClassOf :Event .

:SprinklerOnEvent a owl:Class ;
  rdfs:label "Sprinkler on event" ;
  rdfs:comment "The event that the sprinkler is on." ;
  rdfs:subClassOf :Event .

:RainingEvent a owl:Class ;
  rdfs:label "Raining event" ;
  rdfs:comment "The event that it is raining." ;
  rdfs:subClassOf :Event .

:PavementWetEvent a owl:Class ;
  rdfs:label "Pavement wet event" ;
  rdfs:comment "The event that the pavement is wet." ;
  rdfs:subClassOf :Event .

:PavementSlipperyEvent a owl:Class ;
  rdfs:label "Pavement slippery event" ;
  rdfs:comment "The event that the pavement is slippery." ;
  rdfs:subClassOf :Event .

:hasCause a owl:ObjectProperty ;
  rdfs:label "has cause" ;
  rdfs:comment "Relates a causal relation to its source event, the cause." ;
  rdfs:domain :CausalRelation ;
  rdfs:range :Event .

:hasEffect a owl:ObjectProperty ;
  rdfs:label "has effect" ;
  rdfs:comment "Relates a causal relation to its target event, the effect." ;
  rdfs:domain :CausalRelation ;
  rdfs:range :Event .

:hasMediator a owl:ObjectProperty ;
  rdfs:label "has mediator" ;
  rdfs:comment "Relates a mediated causal relation to the event through which the causal influence is mediated." ;
  rdfs:domain :MediatedCausalRelation ;
  rdfs:range :Event .

:effectWeight a owl:DatatypeProperty ;
  rdfs:label "effect weight" ;
  rdfs:comment "A numeric weight expressing the strength of a causal relation." ;
  rdfs:domain :CausalRelation ;
  rdfs:range xsd:decimal .

:canInfluence a owl:ObjectProperty ;
  rdfs:label "can influence" ;
  rdfs:comment "Relates an event type to another event type that it may causally influence, either directly or through a represented causal relation." ;
  rdfs:domain :Event ;
  rdfs:range :Event .

:isInfluencedBy a owl:ObjectProperty ;
  rdfs:label "is influenced by" ;
  rdfs:comment "Relates an event type to another event type that may causally influence it." ;
  owl:inverseOf :canInfluence ;
  rdfs:domain :Event ;
  rdfs:range :Event .

:directlyCauses a owl:ObjectProperty ;
  rdfs:label "directly causes" ;
  rdfs:comment "Relates an event type to another event type that it directly causes." ;
  rdfs:subPropertyOf :canInfluence ;
  rdfs:domain :Event ;
  rdfs:range :Event .

:mediatesInfluenceOn a owl:ObjectProperty ;
  rdfs:label "mediates influence on" ;
  rdfs:comment "Relates a mediator event type to an event type whose causal influence depends on that mediator." ;
  rdfs:domain :Event ;
  rdfs:range :Event .

:CausalRelation rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasCause ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Event
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasEffect ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Event
  ] .

:RainySeasonEvent rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :directlyCauses ;
    owl:someValuesFrom :RainingEvent
  ] .

:SprinklerOnEvent rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :directlyCauses ;
    owl:someValuesFrom :PavementWetEvent
  ] .

:RainingEvent rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :directlyCauses ;
    owl:someValuesFrom :PavementWetEvent
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :canInfluence ;
    owl:someValuesFrom :PavementSlipperyEvent
  ] .

:PavementWetEvent rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :directlyCauses ;
    owl:someValuesFrom :PavementSlipperyEvent
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :mediatesInfluenceOn ;
    owl:someValuesFrom :PavementSlipperyEvent
  ] .

:PavementSlipperyEvent rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :isInfluencedBy ;
    owl:someValuesFrom :PavementWetEvent
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :isInfluencedBy ;
    owl:someValuesFrom :RainingEvent
  ] .

:RainySeasonCausesRainRelation a owl:Class ;
  rdfs:label "Rainy season causes rain relation" ;
  rdfs:comment "A causal relation in which rainy season causes rain." ;
  rdfs:subClassOf :CausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasCause ;
      owl:allValuesFrom :RainySeasonEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasEffect ;
      owl:allValuesFrom :RainingEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :effectWeight ;
      owl:someValuesFrom xsd:decimal
    ] .

:SprinklerCausesWetPavementRelation a owl:Class ;
  rdfs:label "Sprinkler causes wet pavement relation" ;
  rdfs:comment "A causal relation in which the sprinkler being on causes the pavement to be wet." ;
  rdfs:subClassOf :CausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasCause ;
      owl:allValuesFrom :SprinklerOnEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasEffect ;
      owl:allValuesFrom :PavementWetEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :effectWeight ;
      owl:someValuesFrom xsd:decimal
    ] .

:RainCausesWetPavementRelation a owl:Class ;
  rdfs:label "Rain causes wet pavement relation" ;
  rdfs:comment "A causal relation in which rain causes the pavement to be wet." ;
  rdfs:subClassOf :CausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasCause ;
      owl:allValuesFrom :RainingEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasEffect ;
      owl:allValuesFrom :PavementWetEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :effectWeight ;
      owl:someValuesFrom xsd:decimal
    ] .

:WetPavementCausesSlipperyPavementRelation a owl:Class ;
  rdfs:label "Wet pavement causes slippery pavement relation" ;
  rdfs:comment "A causal relation in which wet pavement causes slippery pavement." ;
  rdfs:subClassOf :CausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasCause ;
      owl:allValuesFrom :PavementWetEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasEffect ;
      owl:allValuesFrom :PavementSlipperyEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :effectWeight ;
      owl:someValuesFrom xsd:decimal
    ] .

:RainInfluencesSlipperyPavementViaWetPavementRelation a owl:Class ;
  rdfs:label "Rain influences slippery pavement via wet pavement relation" ;
  rdfs:comment "A mediated causal relation in which rain influences slippery pavement through wet pavement rather than directly." ;
  rdfs:subClassOf :MediatedCausalRelation ,
    [ a owl:Restriction ;
      owl:onProperty :hasCause ;
      owl:allValuesFrom :RainingEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasEffect ;
      owl:allValuesFrom :PavementSlipperyEvent
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasMediator ;
      owl:allValuesFrom :PavementWetEvent
    ] .