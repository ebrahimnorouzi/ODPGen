@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "MQTT Process Data ODP" ;
  rdfs:comment "A minimal OWL ontology design pattern for modeling MQTT participants, connections, topics, control packets, payloads, and their alignment with observation and actuation process descriptions." .

### Classes

:MQTTParticipant a owl:Class ;
  rdfs:label "MQTT Participant" ;
  rdfs:comment "An entity participating in MQTT communication, such as a client or broker." .

:MQTTClient a owl:Class ;
  rdfs:label "MQTT Client" ;
  rdfs:comment "An MQTT client participating in MQTT communication." ;
  rdfs:subClassOf :MQTTParticipant .

:MQTTBroker a owl:Class ;
  rdfs:label "MQTT Broker" ;
  rdfs:comment "An MQTT broker participating in MQTT communication." ;
  rdfs:subClassOf :MQTTParticipant .

:NetworkConnection a owl:Class ;
  rdfs:label "MQTT Network Connection" ;
  rdfs:comment "A network connection used by MQTT participants." .

:SOSAPlatform a owl:Class ;
  rdfs:label "SOSA Platform" ;
  rdfs:comment "A platform on which an MQTT client runs." .

:SOSASystem a owl:Class ;
  rdfs:label "SOSA System" ;
  rdfs:comment "A system hosted by an MQTT client, such as a sensor or actuator." .

:SOSASensor a owl:Class ;
  rdfs:label "SOSA Sensor" ;
  rdfs:comment "A sensor system that may publish observations via MQTT." ;
  rdfs:subClassOf :SOSASystem .

:SOSAActuator a owl:Class ;
  rdfs:label "SOSA Actuator" ;
  rdfs:comment "An actuator system that may listen for commands via MQTT." ;
  rdfs:subClassOf :SOSASystem .

:FeatureOfInterest a owl:Class ;
  rdfs:label "Feature Of Interest" ;
  rdfs:comment "A feature of interest referenced by MQTT topic subjects or payload content." .

:ObservableProperty a owl:Class ;
  rdfs:label "Observable Property" ;
  rdfs:comment "A property referenced by MQTT topic subjects or payload content." .

:Topic a owl:Class ;
  rdfs:label "MQTT Topic" ;
  rdfs:comment "An MQTT topic used for publish-subscribe communication." .

:TopicFilter a owl:Class ;
  rdfs:label "MQTT Topic Filter" ;
  rdfs:comment "An MQTT topic filter, possibly containing wildcards." .

:TopicSubject a owl:Class ;
  rdfs:label "MQTT Topic Subject" ;
  rdfs:comment "A subject represented on an MQTT topic, such as a feature of interest or property." .

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT Control Packet" ;
  rdfs:comment "An MQTT control packet exchanged between MQTT participants." .

:PublishPacket a owl:Class ;
  rdfs:label "MQTT PUBLISH Packet" ;
  rdfs:comment "An MQTT PUBLISH control packet." ;
  rdfs:subClassOf :MQTTControlPacket .

:SubscribePacket a owl:Class ;
  rdfs:label "MQTT SUBSCRIBE Packet" ;
  rdfs:comment "An MQTT SUBSCRIBE control packet." ;
  rdfs:subClassOf :MQTTControlPacket .

:UnsubscribePacket a owl:Class ;
  rdfs:label "MQTT UNSUBSCRIBE Packet" ;
  rdfs:comment "An MQTT UNSUBSCRIBE control packet." ;
  rdfs:subClassOf :MQTTControlPacket .

:FixedHeader a owl:Class ;
  rdfs:label "MQTT Fixed Header" ;
  rdfs:comment "The fixed header of an MQTT control packet." .

:VariableHeader a owl:Class ;
  rdfs:label "MQTT Variable Header" ;
  rdfs:comment "The variable header of an MQTT control packet." .

:PacketPayload a owl:Class ;
  rdfs:label "MQTT Packet Payload" ;
  rdfs:comment "The payload of an MQTT control packet." .

:PublishPayload a owl:Class ;
  rdfs:label "MQTT Publish Payload" ;
  rdfs:comment "The payload of an MQTT PUBLISH packet." ;
  rdfs:subClassOf :PacketPayload .

:SubscribePayload a owl:Class ;
  rdfs:label "MQTT Subscribe Payload" ;
  rdfs:comment "The payload of an MQTT SUBSCRIBE packet." ;
  rdfs:subClassOf :PacketPayload .

:UnsubscribePayload a owl:Class ;
  rdfs:label "MQTT Unsubscribe Payload" ;
  rdfs:comment "The payload of an MQTT UNSUBSCRIBE packet." ;
  rdfs:subClassOf :PacketPayload .

:SubscriptionEntry a owl:Class ;
  rdfs:label "Subscription Entry" ;
  rdfs:comment "An entry in an MQTT SUBSCRIBE payload specifying a topic filter and requested QoS." .

:PayloadField a owl:Class ;
  rdfs:label "Payload Field" ;
  rdfs:comment "A field encoded in an MQTT payload." .

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation encoded in an MQTT publish payload." .

:ObservationCollection a owl:Class ;
  rdfs:label "Observation Collection" ;
  rdfs:comment "A collection of observations encoded in an MQTT publish payload." .

:Actuation a owl:Class ;
  rdfs:label "Actuation" ;
  rdfs:comment "An actuation encoded in an MQTT publish payload." .

:ActuationCollection a owl:Class ;
  rdfs:label "Actuation Collection" ;
  rdfs:comment "A collection of actuations encoded in an MQTT publish payload." .

:QuantityValue a owl:Class ;
  rdfs:label "Quantity Value" ;
  rdfs:comment "A quantity value used to represent payload size together with a unit." .

:Unit a owl:Class ;
  rdfs:label "Unit" ;
  rdfs:comment "A unit associated with a quantity value." .

### Disjointness

:MQTTClient owl:disjointWith :MQTTBroker .
:SOSASensor owl:disjointWith :SOSAActuator .
:PublishPacket owl:disjointWith :SubscribePacket , :UnsubscribePacket .
:SubscribePacket owl:disjointWith :UnsubscribePacket .
:PublishPayload owl:disjointWith :SubscribePayload , :UnsubscribePayload .
:SubscribePayload owl:disjointWith :UnsubscribePayload .

### Object Properties

:isConnectedToBroker a owl:ObjectProperty ;
  rdfs:label "is connected to broker" ;
  rdfs:comment "Relates an MQTT client to a broker it is connected to." ;
  rdfs:domain :MQTTClient ;
  rdfs:range :MQTTBroker .

:usesConnection a owl:ObjectProperty ;
  rdfs:label "uses connection" ;
  rdfs:comment "Relates an MQTT participant to a network connection it uses." ;
  rdfs:domain :MQTTParticipant ;
  rdfs:range :NetworkConnection .

:initiatedBy a owl:ObjectProperty ;
  rdfs:label "initiated by" ;
  rdfs:comment "Relates a network connection to the participant that initiated it." ;
  rdfs:domain :NetworkConnection ;
  rdfs:range :MQTTParticipant .

:acceptedBy a owl:ObjectProperty ;
  rdfs:label "accepted by" ;
  rdfs:comment "Relates a network connection to the participant that accepted it." ;
  rdfs:domain :NetworkConnection ;
  rdfs:range :MQTTParticipant .

:runsOnPlatform a owl:ObjectProperty ;
  rdfs:label "runs on platform" ;
  rdfs:comment "Relates an MQTT client to the platform on which it runs." ;
  rdfs:domain :MQTTClient ;
  rdfs:range :SOSAPlatform .

:hostsSystem a owl:ObjectProperty ;
  rdfs:label "hosts system" ;
  rdfs:comment "Relates an MQTT client to a hosted SOSA system." ;
  rdfs:domain :MQTTClient ;
  rdfs:range :SOSASystem .

:publishesToTopic a owl:ObjectProperty ;
  rdfs:label "publishes to topic" ;
  rdfs:comment "Relates a sensor to an MQTT topic on which it publishes observations." ;
  rdfs:domain :SOSASensor ;
  rdfs:range :Topic .

:listensToTopic a owl:ObjectProperty ;
  rdfs:label "listens to topic" ;
  rdfs:comment "Relates an actuator to an MQTT topic on which it listens for commands." ;
  rdfs:domain :SOSAActuator ;
  rdfs:range :Topic .

:hasTopicSubject a owl:ObjectProperty ;
  rdfs:label "has topic subject" ;
  rdfs:comment "Relates an MQTT topic to a topic subject represented on it." ;
  rdfs:domain :Topic ;
  rdfs:range :TopicSubject .

:denotesFeatureOfInterest a owl:ObjectProperty ;
  rdfs:label "denotes feature of interest" ;
  rdfs:comment "Relates a topic subject to a feature of interest it denotes." ;
  rdfs:domain :TopicSubject ;
  rdfs:range :FeatureOfInterest .

:denotesObservableProperty a owl:ObjectProperty ;
  rdfs:label "denotes observable property" ;
  rdfs:comment "Relates a topic subject to an observable property it denotes." ;
  rdfs:domain :TopicSubject ;
  rdfs:range :ObservableProperty .

:matchesTopic a owl:ObjectProperty ;
  rdfs:label "matches topic" ;
  rdfs:comment "Relates a topic filter to a topic matched by the filter." ;
  rdfs:domain :TopicFilter ;
  rdfs:range :Topic .

:sendsPacket a owl:ObjectProperty ;
  rdfs:label "sends packet" ;
  rdfs:comment "Relates an MQTT client to a control packet it sends." ;
  rdfs:domain :MQTTClient ;
  rdfs:range :MQTTControlPacket .

:receivedByBroker a owl:ObjectProperty ;
  rdfs:label "received by broker" ;
  rdfs:comment "Relates an MQTT control packet to a broker that receives it." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range :MQTTBroker .

:forwardedByBroker a owl:ObjectProperty ;
  rdfs:label "forwarded by broker" ;
  rdfs:comment "Relates an MQTT control packet to a broker that forwards it." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range :MQTTBroker .

:hasFixedHeader a owl:ObjectProperty ;
  rdfs:label "has fixed header" ;
  rdfs:comment "Relates an MQTT control packet to its fixed header." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range :FixedHeader .

:hasVariableHeader a owl:ObjectProperty ;
  rdfs:label "has variable header" ;
  rdfs:comment "Relates an MQTT control packet to its variable header." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range :VariableHeader .

:hasPayload a owl:ObjectProperty ;
  rdfs:label "has payload" ;
  rdfs:comment "Relates an MQTT control packet to its payload." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range :PacketPayload .

:hasSubscriptionEntry a owl:ObjectProperty ;
  rdfs:label "has subscription entry" ;
  rdfs:comment "Relates an MQTT subscribe payload to a subscription entry it contains." ;
  rdfs:domain :SubscribePayload ;
  rdfs:range :SubscriptionEntry .

:requestsFilter a owl:ObjectProperty ;
  rdfs:label "requests filter" ;
  rdfs:comment "Relates a subscription entry to the topic filter it requests." ;
  rdfs:domain :SubscriptionEntry ;
  rdfs:range :TopicFilter .

:removesFilter a owl:ObjectProperty ;
  rdfs:label "removes filter" ;
  rdfs:comment "Relates an MQTT unsubscribe payload to a topic filter it removes." ;
  rdfs:domain :UnsubscribePayload ;
  rdfs:range :TopicFilter .

:hasPublishTopic a owl:ObjectProperty ;
  rdfs:label "has publish topic" ;
  rdfs:comment "Relates a publish packet or its variable header to the MQTT topic name used for publishing." ;
  rdfs:range :Topic .

:encodesObservation a owl:ObjectProperty ;
  rdfs:label "encodes observation" ;
  rdfs:comment "Relates a publish payload to an observation it encodes." ;
  rdfs:domain :PublishPayload ;
  rdfs:range :Observation .

:encodesObservationCollection a owl:ObjectProperty ;
  rdfs:label "encodes observation collection" ;
  rdfs:comment "Relates a publish payload to an observation collection it encodes." ;
  rdfs:domain :PublishPayload ;
  rdfs:range :ObservationCollection .

:encodesActuation a owl:ObjectProperty ;
  rdfs:label "encodes actuation" ;
  rdfs:comment "Relates a publish payload to an actuation it encodes." ;
  rdfs:domain :PublishPayload ;
  rdfs:range :Actuation .

:encodesActuationCollection a owl:ObjectProperty ;
  rdfs:label "encodes actuation collection" ;
  rdfs:comment "Relates a publish payload to an actuation collection it encodes." ;
  rdfs:domain :PublishPayload ;
  rdfs:range :ActuationCollection .

:aboutFeatureOfInterest a owl:ObjectProperty ;
  rdfs:label "about feature of interest" ;
  rdfs:comment "Relates an observation or actuation resource to a feature of interest it concerns." ;
  rdfs:range :FeatureOfInterest .

:aboutObservableProperty a owl:ObjectProperty ;
  rdfs:label "about observable property" ;
  rdfs:comment "Relates an observation or actuation resource to an observable property it concerns." ;
  rdfs:range :ObservableProperty .

:hasField a owl:ObjectProperty ;
  rdfs:label "has field" ;
  rdfs:comment "Relates a packet payload to a field encoded in it." ;
  rdfs:domain :PacketPayload ;
  rdfs:range :PayloadField .

:hasPayloadSize a owl:ObjectProperty ;
  rdfs:label "has payload size" ;
  rdfs:comment "Relates a publish payload to a quantity value representing its size." ;
  rdfs:domain :PublishPayload ;
  rdfs:range :QuantityValue .

:hasUnit a owl:ObjectProperty ;
  rdfs:label "has unit" ;
  rdfs:comment "Relates a quantity value to its unit." ;
  rdfs:domain :QuantityValue ;
  rdfs:range :Unit .

### Datatype Properties

:clientId a owl:DatatypeProperty ;
  rdfs:label "client ID" ;
  rdfs:comment "The MQTT client identifier of an MQTT client." ;
  rdfs:domain :MQTTClient ;
  rdfs:range xsd:string .

:host a owl:DatatypeProperty ;
  rdfs:label "host" ;
  rdfs:comment "The host configured for an MQTT broker." ;
  rdfs:domain :MQTTBroker ;
  rdfs:range xsd:string .

:port a owl:DatatypeProperty ;
  rdfs:label "port" ;
  rdfs:comment "The port configured for an MQTT broker." ;
  rdfs:domain :MQTTBroker ;
  rdfs:range xsd:integer .

:isTLSSecured a owl:DatatypeProperty ;
  rdfs:label "is TLS secured" ;
  rdfs:comment "Indicates whether a network connection is TLS-secured." ;
  rdfs:domain :NetworkConnection ;
  rdfs:range xsd:boolean .

:topicName a owl:DatatypeProperty ;
  rdfs:label "topic name" ;
  rdfs:comment "The literal name of an MQTT topic." ;
  rdfs:domain :Topic ;
  rdfs:range xsd:string .

:filterPattern a owl:DatatypeProperty ;
  rdfs:label "filter pattern" ;
  rdfs:comment "The stored MQTT topic filter pattern, possibly containing wildcards." ;
  rdfs:domain :TopicFilter ;
  rdfs:range xsd:string .

:packetIdentifier a owl:DatatypeProperty ;
  rdfs:label "packet identifier" ;
  rdfs:comment "The packet identifier of an MQTT control packet." ;
  rdfs:domain :MQTTControlPacket ;
  rdfs:range xsd:integer .

:qosLevel a owl:DatatypeProperty ;
  rdfs:label "QoS level" ;
  rdfs:comment "The MQTT quality of service level associated with a fixed header or subscription entry." ;
  rdfs:range xsd:integer .

:retainFlag a owl:DatatypeProperty ;
  rdfs:label "retain flag" ;
  rdfs:comment "Indicates whether the RETAIN flag is set in a publish fixed header." ;
  rdfs:domain :FixedHeader ;
  rdfs:range xsd:boolean .

:dupFlag a owl:DatatypeProperty ;
  rdfs:label "DUP flag" ;
  rdfs:comment "Indicates whether the DUP flag is set in a publish fixed header." ;
  rdfs:domain :FixedHeader ;
  rdfs:range xsd:boolean .

:content a owl:DatatypeProperty ;
  rdfs:label "content" ;
  rdfs:comment "The content of an MQTT publish payload." ;
  rdfs:domain :PublishPayload ;
  rdfs:range xsd:string .

:contentType a owl:DatatypeProperty ;
  rdfs:label "content type" ;
  rdfs:comment "The content type of an MQTT publish payload, such as text/plain, text/csv, or application/json." ;
  rdfs:domain :PublishPayload ;
  rdfs:range xsd:string .

:encoding a owl:DatatypeProperty ;
  rdfs:label "encoding" ;
  rdfs:comment "The character or payload encoding used for an MQTT publish payload." ;
  rdfs:domain :PublishPayload ;
  rdfs:range xsd:string .

:delimiter a owl:DatatypeProperty ;
  rdfs:label "delimiter" ;
  rdfs:comment "The delimiter used in an MQTT publish payload, for example for CSV-like content." ;
  rdfs:domain :PublishPayload ;
  rdfs:range xsd:string .

:fieldName a owl:DatatypeProperty ;
  rdfs:label "field name" ;
  rdfs:comment "The name of a field encoded in an MQTT payload." ;
  rdfs:domain :PayloadField ;
  rdfs:range xsd:string .

:numericValue a owl:DatatypeProperty ;
  rdfs:label "numeric value" ;
  rdfs:comment "The numeric value of a quantity value." ;
  rdfs:domain :QuantityValue ;
  rdfs:range xsd:decimal .

### Property hierarchy and restrictions

:hasPublishTopic rdfs:domain :PublishPacket ;
  rdfs:range :Topic .

:hasPublishTopic rdfs:domain :VariableHeader ;
  rdfs:range :Topic .

:PublishPacket rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasFixedHeader ;
    owl:someValuesFrom :FixedHeader
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasVariableHeader ;
    owl:someValuesFrom :VariableHeader
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasPayload ;
    owl:someValuesFrom :PublishPayload
  ] .

:SubscribePacket rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasPayload ;
    owl:someValuesFrom :SubscribePayload
  ] .

:UnsubscribePacket rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasPayload ;
    owl:someValuesFrom :UnsubscribePayload
  ] .

:SubscribePayload rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasSubscriptionEntry ;
    owl:someValuesFrom :SubscriptionEntry
  ] .

:SubscriptionEntry rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :requestsFilter ;
    owl:someValuesFrom :TopicFilter
  ] .

:PublishPayload rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasPayloadSize ;
    owl:someValuesFrom :QuantityValue
  ] .

:QuantityValue rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasUnit ;
    owl:someValuesFrom :Unit
  ] .