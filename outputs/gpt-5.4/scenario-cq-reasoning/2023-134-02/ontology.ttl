@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance log ontology design pattern" ;
  rdfs:comment "A minimal OWL ontology design pattern for representing governance-relevant logs in Solid environments, including actors, publishers, actions on data, storage locations, issuing time, and generating applications or services." .

:Entity a owl:Class ;
  rdfs:label "Entity" ;
  rdfs:comment "A generic actor or organization relevant to governance information, such as a user, provider, application, or service." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity that interacts with data." ;
  rdfs:subClassOf :Entity .

:Publisher a owl:Class ;
  rdfs:label "Publisher" ;
  rdfs:comment "An entity that publishes a log." ;
  rdfs:subClassOf :Entity .

:ApplicationOrService a owl:Class ;
  rdfs:label "Application or service" ;
  rdfs:comment "An application or service that may be used to generate data." ;
  rdfs:subClassOf :Entity .

:DataResource a owl:Class ;
  rdfs:label "Data resource" ;
  rdfs:comment "A data item or collection of data that is acted upon or generated." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A location where data is stored, such as a Pod, container, or resource location." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "A type of action performed on data, such as create, update, or erase." .

:LogEntry a owl:Class ;
  rdfs:label "Log entry" ;
  rdfs:comment "A governance-relevant log record describing an interaction with data." ;
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty :hasAction ;
      owl:someValuesFrom :Action
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :hasActor ;
      owl:someValuesFrom :Actor
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :publishedBy ;
      owl:someValuesFrom :Publisher
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :issuedAtTime ;
      owl:someValuesFrom xsd:dateTime
    ] ,
    [ a owl:Restriction ;
      owl:onProperty :aboutData ;
      owl:someValuesFrom :DataResource
    ] .

:hasAction a owl:ObjectProperty ;
  rdfs:label "has action" ;
  rdfs:comment "Relates a log entry to the type of action performed on data." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Action .

:hasActor a owl:ObjectProperty ;
  rdfs:label "has actor" ;
  rdfs:comment "Relates a log entry to the entity interacting with the data." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Actor .

:publishedBy a owl:ObjectProperty ;
  rdfs:label "published by" ;
  rdfs:comment "Relates a log entry to the entity publishing the log." ;
  rdfs:domain :LogEntry ;
  rdfs:range :Publisher .

:aboutData a owl:ObjectProperty ;
  rdfs:label "about data" ;
  rdfs:comment "Relates a log entry to the data resource that is the subject of the logged action." ;
  rdfs:domain :LogEntry ;
  rdfs:range :DataResource .

:storedAt a owl:ObjectProperty ;
  rdfs:label "stored at" ;
  rdfs:comment "Relates a data resource to the location where it is stored." ;
  rdfs:domain :DataResource ;
  rdfs:range :StorageLocation .

:generatedBy a owl:ObjectProperty ;
  rdfs:label "generated by" ;
  rdfs:comment "Relates a data resource to an application or service used to generate it." ;
  rdfs:domain :DataResource ;
  rdfs:range :ApplicationOrService .

:issuedAtTime a owl:DatatypeProperty ;
  rdfs:label "issued at time" ;
  rdfs:comment "Relates a log entry to the date and time when the log was issued." ;
  rdfs:domain :LogEntry ;
  rdfs:range xsd:dateTime .

:hasCategory a owl:DatatypeProperty ;
  rdfs:label "has category" ;
  rdfs:comment "Associates a data resource with a category label to support discovery of categories of data." ;
  rdfs:domain :DataResource ;
  rdfs:range xsd:string .

:rationale a owl:AnnotationProperty ;
  rdfs:label "rationale" ;
  rdfs:comment "An annotation property for documenting modeling rationale." .