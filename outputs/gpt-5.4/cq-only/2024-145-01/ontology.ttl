@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Court jurisdiction and bad check payment ODP" ;
    rdfs:comment "An ontology design pattern for answering competency questions about Indian states, districts, district courts, court authority relations, and bad check payment transactions including transaction type, payment time, and status." .

### Classes

:State a owl:Class ;
    rdfs:label "State" ;
    rdfs:comment "A state of India used to locate districts and district courts." .

:District a owl:Class ;
    rdfs:label "District" ;
    rdfs:comment "An administrative district located in a state." .

:Court a owl:Class ;
    rdfs:label "Court" ;
    rdfs:comment "A court that may have authority over another court." .

:DistrictCourt a owl:Class ;
    rdfs:label "District court" ;
    rdfs:comment "A court that is a district court and is located in a state." ;
    rdfs:subClassOf :Court .

:CheckTransactionType a owl:Class ;
    rdfs:label "Check transaction type" ;
    rdfs:comment "A category or type of check-related transaction." .

:CheckPayment a owl:Class ;
    rdfs:label "Check payment" ;
    rdfs:comment "A payment made by check." .

:BadCheck a owl:Class ;
    rdfs:label "Bad check" ;
    rdfs:comment "A check that is invalid or dishonored." .

:TransactionStatus a owl:Class ;
    rdfs:label "Transaction status" ;
    rdfs:comment "The status of a check payment transaction." .

### Object Properties

:isInState a owl:ObjectProperty ;
    rdfs:label "is in state" ;
    rdfs:comment "Relates a district or district court to the state in which it is located." ;
    rdfs:domain owl:Thing ;
    rdfs:range :State .

:hasDistrict a owl:ObjectProperty ;
    rdfs:label "has district" ;
    rdfs:comment "Relates a state to a district that is located in it." ;
    rdfs:domain :State ;
    rdfs:range :District ;
    owl:inverseOf :isInState .

:hasAuthorityOver a owl:ObjectProperty ;
    rdfs:label "has authority over" ;
    rdfs:comment "Relates a court to another court over which it has authority." ;
    rdfs:domain :Court ;
    rdfs:range :Court .

:hasCheckTransactionType a owl:ObjectProperty ;
    rdfs:label "has check transaction type" ;
    rdfs:comment "Relates a bad check to its check transaction type." ;
    rdfs:domain :BadCheck ;
    rdfs:range :CheckTransactionType .

:hasCheckPayment a owl:ObjectProperty ;
    rdfs:label "has check payment" ;
    rdfs:comment "Relates a bad check to a check payment associated with it." ;
    rdfs:domain :BadCheck ;
    rdfs:range :CheckPayment .

:hasTransactionStatus a owl:ObjectProperty ;
    rdfs:label "has transaction status" ;
    rdfs:comment "Relates a check payment to its transaction status." ;
    rdfs:domain :CheckPayment ;
    rdfs:range :TransactionStatus .

### Datatype Properties

:paymentDateTime a owl:DatatypeProperty ;
    rdfs:label "payment date time" ;
    rdfs:comment "The date and time when a check payment occurred." ;
    rdfs:domain :CheckPayment ;
    rdfs:range xsd:dateTime .