@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Pseudonym authorship and river trajectory crossing ODP" ;
    rdfs:comment "An ontology design pattern for representing authors using pseudonyms or alternative names when writing works, and rivers with trajectories that cross national parks." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human individual, such as an author." .

:Author a owl:Class ;
    rdfs:label "Author" ;
    rdfs:comment "A person in the role of writing a work." ;
    rdfs:subClassOf :Person .

:NameUsage a owl:Class ;
    rdfs:label "Name usage" ;
    rdfs:comment "A name or designation used by a person in a particular context, such as authorship." .

:Pseudonym a owl:Class ;
    rdfs:label "Pseudonym" ;
    rdfs:comment "A name usage adopted by a person instead of their usual name, especially for publication." ;
    rdfs:subClassOf :NameUsage .

:AlternativeName a owl:Class ;
    rdfs:label "Alternative name" ;
    rdfs:comment "A name usage that is an alternative designation used by a person." ;
    rdfs:subClassOf :NameUsage .

:Work a owl:Class ;
    rdfs:label "Work" ;
    rdfs:comment "A created intellectual or artistic work, such as a book or a collection of poems." .

:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A written work in book form." ;
    rdfs:subClassOf :Work .

:CollectionOfPoems a owl:Class ;
    rdfs:label "Collection of poems" ;
    rdfs:comment "A work consisting of a collection of poems." ;
    rdfs:subClassOf :Work .

:River a owl:Class ;
    rdfs:label "River" ;
    rdfs:comment "A natural flowing watercourse." .

:Trajectory a owl:Class ;
    rdfs:label "Trajectory" ;
    rdfs:comment "The path or course followed by a river." .

:NationalPark a owl:Class ;
    rdfs:label "National park" ;
    rdfs:comment "A protected natural area designated as a national park." .

:hasNameUsage a owl:ObjectProperty ;
    rdfs:label "has name usage" ;
    rdfs:comment "Relates a person to a name usage they use." ;
    rdfs:domain :Person ;
    rdfs:range :NameUsage .

:usedForAuthorshipBy a owl:ObjectProperty ;
    rdfs:label "used for authorship by" ;
    rdfs:comment "Relates a name usage to the person who uses it for authorship." ;
    rdfs:domain :NameUsage ;
    rdfs:range :Person ;
    owl:inverseOf :hasNameUsage .

:wroteWork a owl:ObjectProperty ;
    rdfs:label "wrote work" ;
    rdfs:comment "Relates an author to a work they wrote." ;
    rdfs:domain :Author ;
    rdfs:range :Work .

:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:comment "Relates a work to its author." ;
    rdfs:domain :Work ;
    rdfs:range :Author ;
    owl:inverseOf :wroteWork .

:wroteWorkUsingName a owl:ObjectProperty ;
    rdfs:label "wrote work using name" ;
    rdfs:comment "Relates a person to a name usage they used when writing a work." ;
    rdfs:domain :Person ;
    rdfs:range :NameUsage .

:nameUsedForWork a owl:ObjectProperty ;
    rdfs:label "name used for work" ;
    rdfs:comment "Relates a work to the name usage under which it was written or published." ;
    rdfs:domain :Work ;
    rdfs:range :NameUsage .