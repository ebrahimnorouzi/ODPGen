@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Causal event and state pattern for sprinkler, wet pavement, and slippery pavement" ;
  rdfs:comment "An ontology design pattern for representing events, states, causal relations, intervention outcomes, and causal strength needed to answer competency questions about sprinkler operation, wet pavement, and slippery pavement." .

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "Something that happens and may cause a state or another event." .

:State a owl:Class ;
  rdfs:label "State" ;
  rdfs:comment "A condition or situation that may hold, such as pavement being wet or slippery." .

:Intervention a owl:Class ;
  rdfs:label "Intervention" ;
  rdfs:comment "An action that sets or changes a state in order to assess its outcome." .

:CausalLink a owl:Class ;
  rdfs:label "Causal link" ;
  rdfs:comment "A reified causal relation connecting a cause to an effect and allowing the strength of the causal relation to be described." .

:Outcome a owl:Class ;
  rdfs:label "Outcome" ;
  rdfs:comment "A resulting state or event produced by an intervention." .

:causes a owl:ObjectProperty ;
  rdfs:label "causes" ;
  rdfs:comment "Relates an event or state to a state or event that it causes." ;
  rdfs:domain owl:Thing ;
  rdfs:range owl:Thing .

:hasCause a owl:ObjectProperty ;
  rdfs:label "has cause" ;
  rdfs:comment "Relates a causal link to its cause, which may be an event or a state." ;
  rdfs:domain :CausalLink ;
  rdfs:range owl:Thing .

:hasEffect a owl:ObjectProperty ;
  rdfs:label "has effect" ;
  rdfs:comment "Relates a causal link to its effect, which may be an event or a state." ;
  rdfs:domain :CausalLink ;
  rdfs:range owl:Thing .

:hasCausalLink a owl:ObjectProperty ;
  rdfs:label "has causal link" ;
  rdfs:comment "Relates a cause to a reified causal link in which it participates." ;
  rdfs:domain owl:Thing ;
  rdfs:range :CausalLink .

:hasInterventionTarget a owl:ObjectProperty ;
  rdfs:label "has intervention target" ;
  rdfs:comment "Relates an intervention to the state that the intervention sets or changes." ;
  rdfs:domain :Intervention ;
  rdfs:range :State .

:hasOutcome a owl:ObjectProperty ;
  rdfs:label "has outcome" ;
  rdfs:comment "Relates an intervention to its outcome." ;
  rdfs:domain :Intervention ;
  rdfs:range :Outcome .

:resultsIn a owl:ObjectProperty ;
  rdfs:label "results in" ;
  rdfs:comment "Relates an outcome to the resulting state or event." ;
  rdfs:domain :Outcome ;
  rdfs:range owl:Thing .

:intervenesOn a owl:ObjectProperty ;
  rdfs:label "intervenes on" ;
  rdfs:comment "Relates an intervention to a causal link whose effect is being assessed under the intervention." ;
  rdfs:domain :Intervention ;
  rdfs:range :CausalLink .

:hasTruthValue a owl:DatatypeProperty ;
  rdfs:label "has truth value" ;
  rdfs:comment "Indicates whether a state is asserted to hold or not hold in a scenario or intervention." ;
  rdfs:domain :State ;
  rdfs:range xsd:boolean .

:hasCausalStrength a owl:DatatypeProperty ;
  rdfs:label "has causal strength" ;
  rdfs:comment "Gives a numeric measure of the strength of a causal link." ;
  rdfs:domain :CausalLink ;
  rdfs:range xsd:decimal .