@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Policy evaluation context ODP" ;
    rdfs:comment "An ontology design pattern for representing the minimal context needed to answer competency questions about current time, party location, policy asset and party collections, performed or attempted actions, rule exercise counts and duration, occurred events, recipients of rule results, and financial payments." .

### Classes

:EvaluationContext a owl:Class ;
    rdfs:label "Evaluation Context" ;
    rdfs:comment "A context in which a policy and its rules are being evaluated, including relevant time, actions, events, and payment information." .

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A policy that is being evaluated." .

:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "An asset that may belong to the asset collection of a policy." .

:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:comment "A party that may belong to the party collection of a policy or have a location." .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A location associated with a party." .

:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "An action that may have been performed or attempted in the evaluation context." .

:Rule a owl:Class ;
    rdfs:label "Rule" ;
    rdfs:comment "A rule that may be exercised during policy evaluation." .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "An event that has occurred and about which information is available." .

:Recipient a owl:Class ;
    rdfs:label "Recipient" ;
    rdfs:comment "A recipient that can receive the result of an exercised rule." .

:RecipientCategory a owl:Class ;
    rdfs:label "Recipient Category" ;
    rdfs:comment "A category of recipients that can receive the result of an exercised rule." .

:Payment a owl:Class ;
    rdfs:label "Payment" ;
    rdfs:comment "A financial payment that may or may not have been made." .

### Object Properties

:hasPolicy a owl:ObjectProperty ;
    rdfs:label "has policy" ;
    rdfs:comment "Relates an evaluation context to the policy being evaluated." ;
    rdfs:domain :EvaluationContext ;
    rdfs:range :Policy .

:hasAsset a owl:ObjectProperty ;
    rdfs:label "has asset" ;
    rdfs:comment "Relates a policy to an asset that is part of its asset collection." ;
    rdfs:domain :Policy ;
    rdfs:range :Asset .

:hasParty a owl:ObjectProperty ;
    rdfs:label "has party" ;
    rdfs:comment "Relates a policy to a party that is part of its party collection." ;
    rdfs:domain :Policy ;
    rdfs:range :Party .

:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:comment "Relates a party to its location." ;
    rdfs:domain :Party ;
    rdfs:range :Location .

:hasAction a owl:ObjectProperty ;
    rdfs:label "has action" ;
    rdfs:comment "Relates an evaluation context to an action that was performed or attempted." ;
    rdfs:domain :EvaluationContext ;
    rdfs:range :Action .

:hasRule a owl:ObjectProperty ;
    rdfs:label "has rule" ;
    rdfs:comment "Relates an evaluation context to a rule that is being or has been exercised." ;
    rdfs:domain :EvaluationContext ;
    rdfs:range :Rule .

:hasEvent a owl:ObjectProperty ;
    rdfs:label "has event" ;
    rdfs:comment "Relates an evaluation context to an event that has occurred." ;
    rdfs:domain :EvaluationContext ;
    rdfs:range :Event .