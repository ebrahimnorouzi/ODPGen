@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Ship description and propulsion ontology design pattern" ;
  rdfs:comment "An OWL ontology design pattern for representing ships, their identification, dimensions, ownership, flag state, routes and trajectories, propulsion and engine arrangements, and multimodal ship representation data such as images, sonar signatures, and textual descriptions, sufficient to answer the stated competency questions." .

#################################################################
# Classes
#################################################################

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel that can be identified, described, owned, registered under a flag, equipped with propulsion systems, and represented by data resources." .

:ContainerShip a owl:Class ;
  rdfs:subClassOf :Ship ;
  rdfs:label "Container ship" ;
  rdfs:comment "A ship of the container ship type." .

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organization that can own ships." .

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A person that can own ships." .

:Owner a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:unionOf ( :Organization :Person )
  ] ;
  rdfs:label "Owner" ;
  rdfs:comment "An entity that can own a ship, namely a person or an organization." .

:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "A country used to represent the flag state under which a ship is registered." .

:ShipDimensions a owl:Class ;
  rdfs:label "Ship dimensions" ;
  rdfs:comment "A description of a ship's physical dimensions such as length, beam, and draught." .

:LocationDescription a owl:Class ;
  rdfs:label "Location description" ;
  rdfs:comment "A description of the typical location of a ship." .

:Route a owl:Class ;
  rdfs:label "Route" ;
  rdfs:comment "A route associated with a ship, including actual or predicted routes." .

:PredictedRoute a owl:Class ;
  rdfs:subClassOf :Route ;
  rdfs:label "Predicted route" ;
  rdfs:comment "A route predicted for a ship." .

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "A trajectory associated with movement of a ship." .

:SingleTrajectoryPart a owl:Class ;
  rdfs:label "Single trajectory part" ;
  rdfs:comment "A single part of a trajectory for which information can be recorded." .

:TrajectoryType a owl:Class ;
  rdfs:label "Trajectory type" ;
  rdfs:comment "A category used to distinguish types of trajectories." .

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "An engine used in a ship and associated with fuel, power, and driven components." .

:ElectricEngine a owl:Class ;
  rdfs:subClassOf :Engine ;
  rdfs:label "Electric engine" ;
  rdfs:comment "An engine of electric type." .

:EngineCombination a owl:Class ;
  rdfs:label "Engine combination" ;
  rdfs:comment "A combination of engines that can exist in a ship." .

:FuelType a owl:Class ;
  rdfs:label "Fuel type" ;
  rdfs:comment "A type of fuel used to power an engine." .

:DrivenComponent a owl:Class ;
  rdfs:label "Driven component" ;
  rdfs:comment "A component that is driven by an engine." .

:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion system" ;
  rdfs:comment "A propulsion system that a ship can have." .

:MotorizedPropulsionSystem a owl:Class ;
  rdfs:subClassOf :PropulsionSystem ;
  rdfs:label "Motorized propulsion system" ;
  rdfs:comment "A propulsion system that relies on one or more engines." .