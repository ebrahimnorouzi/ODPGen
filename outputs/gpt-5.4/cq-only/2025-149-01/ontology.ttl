@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ndf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Database policy and SQL AST ODP" ;
  rdfs:comment "An ontology design pattern for representing relational database schemas, policies over schema elements and rows, and SQL queries as AST-based semantic graphs that can be checked against policy constraints." .

#################################################################
# Classes
#################################################################

:RelationalDatabase a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A relational database represented as a first-class schema entity." .

:Table a owl:Class ;
  rdfs:label "Table" ;
  rdfs:comment "A table belonging to a relational database." .

:Column a owl:Class ;
  rdfs:label "Column" ;
  rdfs:comment "A column belonging to a table." .

:PrimaryKey a owl:Class ;
  rdfs:label "Primary Key" ;
  rdfs:comment "A primary-key relationship or constraint in the schema." .

:ForeignKey a owl:Class ;
  rdfs:label "Foreign Key" ;
  rdfs:comment "A foreign-key relationship or constraint linking columns across tables." .

:Agent a owl:Class ;
  rdfs:label "Agent" ;
  rdfs:comment "An agent for whom a policy can be defined and who can execute a query statement." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy defined for a specific agent and applicable to a schema target or row condition." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "A high-level action type used by policies and SQL statements." .

:ReadAction a owl:Class ;
  rdfs:label "Read Action" ;
  rdfs:comment "A high-level read action." ;
  rdfs:subClassOf :Action .

:ModifyAction a owl:Class ;
  rdfs:label "Modify Action" ;
  rdfs:comment "A high-level modify action." ;
  rdfs:subClassOf :Action .

:ActionScope a owl:Class ;
  rdfs:label "Action Scope" ;
  rdfs:comment "An operational scope associated with an action, clause, or reference." .

:ViewActionScope a owl:Class ;
  rdfs:label "View Action Scope" ;
  rdfs:comment "A scope indicating read access for viewing." ;
  rdfs:subClassOf :ActionScope .

:ProcessActionScope a owl:Class ;
  rdfs:label "Process Action Scope" ;
  rdfs:comment "A scope indicating read access for processing." ;
  rdfs:subClassOf :ActionScope .

:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "A condition used to define a row-level policy for later enforcement." .

:Effect a owl:Class ;
  rdfs:label "Effect" ;
  rdfs:comment "The effect of a policy, such as prohibition." .

:Prohibition a owl:Class ;
  rdfs:label "Prohibition" ;
  rdfs:comment "A policy effect indicating that the action is prohibited." ;
  rdfs:subClassOf :Effect .

:SQLNode a owl:Class ;
  rdfs:label "SQL Node" ;
  rdfs:comment "A node in an AST-based semantic graph for a SQL query." .

:SQLStatement a owl:Class ;
  rdfs:label "SQL Statement" ;
  rdfs:comment "A SQL statement represented in the AST-based semantic graph." ;
  rdfs:subClassOf :SQLNode .

:SelectStatement a owl:Class ;
  rdfs:label "Select Statement" ;
  rdfs:comment "A SQL SELECT statement." ;
  rdfs:subClassOf :SQLStatement .

:UpdateStatement a owl:Class ;
  rdfs:label "Update Statement" ;
  rdfs:comment "A SQL UPDATE statement." ;
  rdfs:subClassOf :SQLStatement .

:SQLClause a owl:Class ;
  rdfs:label "SQL Clause" ;
  rdfs:comment "A clause within a SQL statement that can be assigned an operational scope." ;
  rdfs:subClassOf :SQLNode .