@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Registry metadata ODP" ;
    rdfs:comment "An ontology design pattern for representing a registry, its maintainer, creation and update dates, available data types, storage locations for data types, and policies associated with data." .

:Registry a owl:Class ;
    rdfs:label "Registry" ;
    rdfs:comment "A registry that is maintained by an agent, has creation and update dates, and contains available data types." .

:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity responsible for maintaining a registry." .

:DataType a owl:Class ;
    rdfs:label "Data type" ;
    rdfs:comment "A type of data that is available in a registry." .

:StorageLocation a owl:Class ;
    rdfs:label "Storage location" ;
    rdfs:comment "A place or location where a specific type of data is stored." .

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "A policy associated with a type of data." .

:isMaintainedBy a owl:ObjectProperty ;
    rdfs:label "is maintained by" ;
    rdfs:comment "Relates a registry to the agent that maintains it." ;
    rdfs:domain :Registry ;
    rdfs:range :Agent .

:hasAvailableDataType a owl:ObjectProperty ;
    rdfs:label "has available data type" ;
    rdfs:comment "Relates a registry to a type of data that is available in it." ;
    rdfs:domain :Registry ;
    rdfs:range :DataType .

:isStoredIn a owl:ObjectProperty ;
    rdfs:label "is stored in" ;
    rdfs:comment "Relates a data type to the storage location where it is stored." ;
    rdfs:domain :DataType ;
    rdfs:range :StorageLocation .

:hasAssociatedPolicy a owl:ObjectProperty ;
    rdfs:label "has associated policy" ;
    rdfs:comment "Relates a data type to a policy associated with that data." ;
    rdfs:domain :DataType ;
    rdfs:range :Policy .

:creationDate a owl:DatatypeProperty ;
    rdfs:label "creation date" ;
    rdfs:comment "The date and time when a registry was created." ;
    rdfs:domain :Registry ;
    rdfs:range xsd:dateTime .

:updateDate a owl:DatatypeProperty ;
    rdfs:label "update date" ;
    rdfs:comment "The date and time when a registry was last updated." ;
    rdfs:domain :Registry ;
    rdfs:range xsd:dateTime .