@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance policy ODP" ;
  rdfs:comment "An ontology design pattern for representing governance-relevant policy metadata in Solid apps, including policy identity, creator, issuance time, assignee, requesting application or service, requested access mode, personal data involved, and purpose of access." .

#################################################################
# Classes
#################################################################

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A governance or privacy-related policy that captures conditions for accessing personal data." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity involved in the Solid ecosystem, such as a user, provider, or other party relevant to a policy." .

:Application a owl:Class ;
  rdfs:label "Application" ;
  rdfs:comment "An application or service used to access data under a policy." .

:AccessMode a owl:Class ;
  rdfs:label "Access mode" ;
  rdfs:comment "A mode of access being requested for data, such as a type of permitted operation." .

:PersonalData a owl:Class ;
  rdfs:label "Personal data" ;
  rdfs:comment "Personal data that is the subject of access under a policy." .

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "The purpose for which personal data is accessed under a policy." .

#################################################################
# Object Properties
#################################################################

:hasCreator a owl:ObjectProperty ;
  rdfs:label "has creator" ;
  rdfs:comment "Relates a policy to the actor who created it." ;
  rdfs:domain :Policy ;
  rdfs:range :Actor .

:hasAssignee a owl:ObjectProperty ;
  rdfs:label "has assignee" ;
  rdfs:comment "Relates a policy to the actor to whom the policy is assigned." ;
  rdfs:domain :Policy ;
  rdfs:range :Actor .

:usesApplication a owl:ObjectProperty ;
  rdfs:label "uses application" ;
  rdfs:comment "Relates a policy to the application or service being used to access the data." ;
  rdfs:domain :Policy ;
  rdfs:range :Application .

:hasAccessMode a owl:ObjectProperty ;
  rdfs:label "has access mode" ;
  rdfs:comment "Relates a policy to the access mode being requested." ;
  rdfs:domain :Policy ;
  rdfs:range :AccessMode .

:hasPersonalData a owl:ObjectProperty ;
  rdfs:label "has personal data" ;
  rdfs:comment "Relates a policy to the personal data being accessed." ;
  rdfs:domain :Policy ;
  rdfs:range :PersonalData .

:hasPurpose a owl:ObjectProperty ;
  rdfs:label "has purpose" ;
  rdfs:comment "Relates a policy to the purpose for accessing the data." ;
  rdfs:domain :Policy ;
  rdfs:range :Purpose .

#################################################################
# Datatype Properties
#################################################################

:policyIdentifier a owl:DatatypeProperty ;
  rdfs:label "policy identifier" ;
  rdfs:comment "The unique identifier of a policy." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:string .

:issuedAt a owl:DatatypeProperty ;
  rdfs:label "issued at" ;
  rdfs:comment "The date and time when a policy was issued." ;
  rdfs:domain :Policy ;
  rdfs:range xsd:dateTime .