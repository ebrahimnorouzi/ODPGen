@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Maritime ship representation ontology design pattern" ;
  rdfs:comment "An ontology design pattern for representing ships, their identification, dimensions, ownership, flag registration, location and trajectory information, propulsion systems and technologies, engines, fuels, and multimodal ship data resources such as images, sonar data, and textual descriptions." .

### Classes

:Ship a owl:Class ;
  rdfs:label "Ship" ;
  rdfs:comment "A vessel represented in the maritime domain." .

:ShipType a owl:Class ;
  rdfs:label "Ship type" ;
  rdfs:comment "A category or type of ship, such as container ship." .

:Organization a owl:Class ;
  rdfs:label "Organization" ;
  rdfs:comment "An organization that can own ships." .

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A person that can own ships." .

:Country a owl:Class ;
  rdfs:label "Country" ;
  rdfs:comment "A country used for flag registration." .

:Dimension a owl:Class ;
  rdfs:label "Dimension" ;
  rdfs:comment "A measurable ship dimension such as length, beam, or draught." .

:Unit a owl:Class ;
  rdfs:label "Unit" ;
  rdfs:comment "A unit used to express a measured value." .

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A location associated with a ship, including typical location information." .

:Route a owl:Class ;
  rdfs:label "Route" ;
  rdfs:comment "A route associated with a ship." .

:Trajectory a owl:Class ;
  rdfs:label "Trajectory" ;
  rdfs:comment "A trajectory describing vessel movement." .

:TrajectoryType a owl:Class ;
  rdfs:label "Trajectory type" ;
  rdfs:comment "A category used to distinguish types of trajectories." .

:TrajectoryPart a owl:Class ;
  rdfs:label "Trajectory part" ;
  rdfs:comment "A segment or part of a trajectory." .

:PropulsionSystem a owl:Class ;
  rdfs:label "Propulsion system" ;
  rdfs:comment "A propulsion system installed on a ship." .

:Engine a owl:Class ;
  rdfs:label "Engine" ;
  rdfs:comment "An engine used in ship propulsion." .

:EngineType a owl:Class ;
  rdfs:label "Engine type" ;
  rdfs:comment "A category of engine used in ships." .

:Fuel a owl:Class ;
  rdfs:label "Fuel" ;
  rdfs:comment "A fuel used to power ship engines." .

:DrivenComponent a owl:Class ;
  rdfs:label "Driven component" ;
  rdfs:comment "A component driven by a ship engine." .

:PropulsionTechnology a owl:Class ;
  rdfs:label "Propulsion technology" ;
  rdfs:comment "A propulsion technology used within a propulsion system." .

:MotorizedPropulsionTechnology a owl:Class ;
  rdfs:label "Motorized propulsion technology" ;
  rdfs:comment "A propulsion technology powered by engines." ;
  rdfs:subClassOf :PropulsionTechnology .

:NonEnginePropulsionTechnology a owl:Class ;
  rdfs:label "Non-engine propulsion technology" ;
  rdfs:comment "A propulsion technology that does not rely on an engine." ;
  rdfs:subClassOf :PropulsionTechnology .

:WindPropulsionTechnology a owl:Class ;
  rdfs:label "Wind propulsion technology" ;
  rdfs:comment "A propulsion technology based on wind." ;
  rdfs:subClassOf :NonEnginePropulsionTechnology .

:JetPropulsor a owl:Class ;
  rdfs:label "Jet propulsor" ;
  rdfs:comment "A propulsion technology of the jet propulsor kind." ;
  rdfs:subClassOf :MotorizedPropulsionTechnology .

:BladedPropulsor a owl:Class ;
  rdfs:label "Bladed propulsor" ;
  rdfs:comment "A propulsion technology using blades." ;
  rdfs:subClassOf :MotorizedPropulsionTechnology .

:SpecialDesignBladedPropulsor a owl:Class ;
  rdfs:label "Special design bladed propulsor" ;
  rdfs:comment "A bladed propulsor following a special design." ;
  rdfs:subClassOf :BladedPropulsor .

:ScrewPropeller a owl:Class ;
  rdfs:label "Screw propeller" ;
  rdfs:comment "A screw propeller used as a bladed propulsor." ;
  rdfs:subClassOf :BladedPropulsor .

:FixedPitchPropeller a owl:Class ;
  rdfs:label "Fixed pitch propeller" ;
  rdfs:comment "A screw propeller with fixed pitch." ;
  rdfs:subClassOf :ScrewPropeller .

:SupercavitatingPropeller a owl:Class ;
  rdfs:label "Supercavitating propeller" ;
  rdfs:comment "A propeller designed for supercavitating operation." ;
  rdfs:subClassOf :SpecialDesignBladedPropulsor .

:CavitationPreventionTechnology a owl:Class ;
  rdfs:label "Cavitation prevention technology" ;
  rdfs:comment "A technology used to prevent cavitation on motorized propulsion technologies." .

:Sail a owl:Class ;
  rdfs:label "Sail" ;
  rdfs:comment "A sail used as a wind propulsion technology." ;
  rdfs:subClassOf :WindPropulsionTechnology .

:DataRepresentation a owl:Class ;
  rdfs:label "Data representation" ;
  rdfs:comment "A kind of data used to represent a ship." .

:SonarData a owl:Class ;
  rdfs:label "Sonar data" ;
  rdfs:comment "Sonar data resource representing a ship." ;
  rdfs:subClassOf :DataRepresentation .

:ImageResource a owl:Class ;
  rdfs:label "Image resource" ;
  rdfs:comment "An image resource representing a ship." ;
  rdfs:subClassOf :DataRepresentation .

:TextualInformation a owl:Class ;
  rdfs:label "Textual information" ;
  rdfs:comment "Textual information representing a ship." ;
  rdfs:subClassOf :DataRepresentation .

### Object Properties

:hasShipType a owl:ObjectProperty ;
  rdfs:label "has ship type" ;
  rdfs:comment "Relates a ship to its ship type." ;
  rdfs:domain :Ship ;
  rdfs:range :ShipType .

:hasOwner a owl:ObjectProperty ;
  rdfs:label "has owner" ;
  rdfs:comment "Relates a ship to its owner, which can be a person or organization." ;
  rdfs:domain :Ship ;
  rdfs:range owl:Thing .

:registeredUnderFlag a owl:ObjectProperty ;
  rdfs:label "registered under flag" ;
  rdfs:comment "Relates a ship to the country under whose flag it is registered." ;
  rdfs:domain :Ship ;
  rdfs:range :Country .

:hasDimension a owl:ObjectProperty ;
  rdfs:label "has dimension" ;
  rdfs:comment "Relates a ship to a dimension description." ;
  rdfs:domain :Ship ;
  rdfs:range :Dimension .

:hasTypicalLocation a owl:ObjectProperty ;
  rdfs:label "has typical location" ;
  rdfs:comment "Relates a ship to information about its typical location." ;
  rdfs:domain :Ship ;
  rdfs:range :Location .

:hasRoute a owl:ObjectProperty ;
  rdfs:label "has route" ;
  rdfs:comment "Relates a ship to a route." ;
  rdfs:domain :Ship ;
  rdfs:range :Route .

:hasPredictedRoute a owl:ObjectProperty ;
  rdfs:label "has predicted route" ;
  rdfs:comment "Relates a ship to a predicted route." ;
  rdfs:domain :Ship ;
  rdfs:range :Route .

:hasTrajectory a owl:ObjectProperty ;
  rdfs:label "has trajectory" ;
  rdfs:comment "Relates a ship or route to a trajectory." ;
  rdfs:range :Trajectory .

:hasTrajectoryPart a owl:ObjectProperty ;
  rdfs:label "has trajectory part" ;
  rdfs:comment "Relates a trajectory to one of its parts." ;
  rdfs:domain :Trajectory ;
  rdfs:range :TrajectoryPart .

:hasTrajectoryType a owl:ObjectProperty ;
  rdfs:label "has trajectory type" ;
  rdfs:comment "Relates a trajectory to its trajectory type." ;
  rdfs:domain :Trajectory ;
  rdfs:range :TrajectoryType .

:hasPropulsionSystem a owl:ObjectProperty ;
  rdfs:label "has propulsion system" ;
  rdfs:comment "Relates a ship to a propulsion system." ;
  rdfs:domain :Ship ;
  rdfs:range :PropulsionSystem .

:hasEngine a owl:ObjectProperty ;
  rdfs:label "has engine" ;
  rdfs:comment "Relates a propulsion system or ship to an engine." ;
  rdfs:range :Engine .

:hasEngineType a owl:ObjectProperty ;
  rdfs:label "has engine type" ;
  rdfs:comment "Relates an engine to its engine type." ;
  rdfs:domain :Engine ;
  rdfs:range :EngineType .

:poweredByFuel a owl:ObjectProperty ;
  rdfs:label "powered by fuel" ;
  rdfs:comment "Relates an engine to the fuel that powers it." ;
  rdfs:domain :Engine ;
  rdfs:range :Fuel .

:drives a owl:ObjectProperty ;
  rdfs:label "drives" ;
  rdfs:comment "Relates an engine to the component it drives." ;
  rdfs:domain :Engine ;
  rdfs:range :DrivenComponent .

:hasPropulsionTechnology a owl:ObjectProperty ;
  rdfs:label "has propulsion technology" ;
  rdfs:comment "Relates a propulsion system to a propulsion technology used by it." ;
  rdfs:domain :PropulsionSystem ;
  rdfs:range :PropulsionTechnology .

:assists a owl:ObjectProperty ;
  rdfs:label "assists" ;
  rdfs:comment "Relates one propulsion technology to another propulsion technology that it assists." ;
  rdfs:domain :PropulsionTechnology ;
  rdfs:range :PropulsionTechnology .

:hasCavitationPreventionTechnology a owl:ObjectProperty ;
  rdfs:label "has cavitation prevention technology" ;
  rdfs:comment "Relates a motorized propulsion technology to a technology used to prevent cavitation." ;
  rdfs:domain :MotorizedPropulsionTechnology ;
  rdfs:range :CavitationPreventionTechnology .

:hasDataRepresentation a owl:ObjectProperty ;
  rdfs:label "has data representation" ;
  rdfs:comment "Relates a ship to a data representation resource." ;
  rdfs:domain :Ship ;
  rdfs:range :DataRepresentation .

:hasSonarData a owl:ObjectProperty ;
  rdfs:label "has sonar data" ;
  rdfs:comment "Relates a ship to sonar data representing it." ;
  rdfs:domain :Ship ;
  rdfs:range :SonarData .

:hasImageResource a owl:ObjectProperty ;
  rdfs:label "has image resource" ;
  rdfs:comment "Relates a ship to an image resource representing it." ;
  rdfs:domain :Ship ;
  rdfs:range :ImageResource .

:hasTextualInformation a owl:ObjectProperty ;
  rdfs:label "has textual information" ;
  rdfs:comment "Relates a ship to textual information representing it." ;
  rdfs:domain :Ship ;
  rdfs:range :TextualInformation .

### Datatype Properties

:identifier a owl:DatatypeProperty ;
  rdfs:label "identifier" ;
  rdfs:comment "A clear identifier for a ship." ;
  rdfs:domain :Ship ;
  rdfs:range xsd:string .

:dimensionType a owl:DatatypeProperty ;
  rdfs:label "dimension type" ;
  rdfs:comment "The kind of dimension being described, such as length, beam, or draught." ;
  rdfs:domain :Dimension ;
  rdfs:range xsd:string .

:dimensionValue a owl:DatatypeProperty ;
  rdfs:label "dimension value" ;
  rdfs:comment "The numeric value of a ship dimension." ;
  rdfs:domain :Dimension ;
  rdfs:range xsd:decimal .

:hasUnitLabel a owl:DatatypeProperty ;
  rdfs:label "has unit label" ;
  rdfs:comment "The label or symbol of a unit used for a measured value." ;
  rdfs:domain :Unit ;
  rdfs:range xsd:string .

:usesUnit a owl:ObjectProperty ;
  rdfs:label "uses unit" ;
  rdfs:comment "Relates a dimension to the unit used to express it." ;
  rdfs:domain :Dimension ;
  rdfs:range :Unit .

:averageSpeedOverGround a owl:DatatypeProperty ;
  rdfs:label "average speed over ground" ;
  rdfs:comment "The average speed over ground associated with a ship, route, trajectory, or trajectory part." ;
  rdfs:range xsd:decimal .

:bowOffset a owl:DatatypeProperty ;
  rdfs:label "bow offset" ;
  rdfs:comment "The relative placement of the GPS antenna toward the bow or stern." ;
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal .

:sternOffset a owl:DatatypeProperty ;
  rdfs:label "stern offset" ;
  rdfs:comment "The relative placement of the GPS antenna toward the stern." ;
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal .

:portOffset a owl:DatatypeProperty ;
  rdfs:label "port offset" ;
  rdfs:comment "The relative placement of the GPS antenna toward the port side." ;
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal .

:starboardOffset a owl:DatatypeProperty ;
  rdfs:label "starboard offset" ;
  rdfs:comment "The relative placement of the GPS antenna toward the starboard side." ;
  rdfs:domain :Ship ;
  rdfs:range xsd:decimal .

:routeDescription a owl:DatatypeProperty ;
  rdfs:label "route description" ;
  rdfs:comment "A textual description of a ship route." ;
  rdfs:domain :Route ;
  rdfs:range xsd:string .

:trajectoryPartDescription a owl:DatatypeProperty ;
  rdfs:label "trajectory part description" ;
  rdfs:comment "A textual description of a single trajectory part." ;
  rdfs:domain :TrajectoryPart ;
  rdfs:range xsd:string .

:date a owl:DatatypeProperty ;
  rdfs:label "date" ;
  rdfs:comment "A date associated with a route, trajectory, or trajectory part." ;
  rdfs:range xsd:date .

:diameter a owl:DatatypeProperty ;
  rdfs:label "diameter" ;
  rdfs:comment "The diameter of a bladed propulsor or propeller." ;
  rdfs:domain :BladedPropulsor ;
  rdfs:range xsd:decimal .

:bladeCount a owl:DatatypeProperty ;
  rdfs:label "blade count" ;
  rdfs:comment "The number of blades of a bladed propulsor or propeller." ;
  rdfs:domain :BladedPropulsor ;
  rdfs:range xsd:integer .

:storageFormat a owl:DatatypeProperty ;
  rdfs:label "storage format" ;
  rdfs:comment "The format in which a data representation, such as sonar data, is stored." ;
  rdfs:domain :DataRepresentation ;
  rdfs:range xsd:string .

:textContent a owl:DatatypeProperty ;
  rdfs:label "text content" ;
  rdfs:comment "The textual content of a textual information resource." ;
  rdfs:domain :TextualInformation ;
  rdfs:range xsd:string .

:resourceURL a owl:DatatypeProperty ;
  rdfs:label "resource URL" ;
  rdfs:comment "A URL or locator for an image, sonar, or other data resource." ;
  rdfs:domain :DataRepresentation ;
  rdfs:range xsd:anyURI .