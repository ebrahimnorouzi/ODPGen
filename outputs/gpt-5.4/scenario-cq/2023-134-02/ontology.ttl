@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance logging ODP" ;
  rdfs:comment "An ontology design pattern for representing governance-relevant logs in Solid settings, including actors, roles, infrastructure elements, data categories and locations, applications/services, data handling declarations, privacy policies, provenance records, and compliance-relevant events." .

#################################################################
# Classes
#################################################################

:SolidActor a owl:Class ;
  rdfs:label "Solid actor" ;
  rdfs:comment "An entity participating in the Solid ecosystem, such as a user, provider, app provider, or authority." .

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role played by a Solid actor in relation to Solid infrastructure, applications, governance, or data handling." .

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A Solid Pod that stores data and may expose metadata about its specification, installed functionalities, and stored data categories." .

:ApplicationService a owl:Class ;
  rdfs:label "Application or service" ;
  rdfs:comment "An application or service used in the Solid ecosystem, including apps that generate or access data." .

:SolidSpecification a owl:Class ;
  rdfs:label "Solid specification" ;
  rdfs:comment "A Solid specification version or profile that a Pod is running." .

:Functionality a owl:Class ;
  rdfs:label "Functionality" ;
  rdfs:comment "A functionality installed within a Pod." .

:DataCategory a owl:Class ;
  rdfs:label "Data category" ;
  rdfs:comment "A category of data used to support granular discovery, storage, access, and governance." .

:DataResource a owl:Class ;
  rdfs:label "Data resource" ;
  rdfs:comment "A data item or collection of data stored in a Pod and associated with a data category." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A location where data is stored within or in relation to a Pod." .

:PrivacyNotice a owl:Class ;
  rdfs:label "Privacy notice" ;
  rdfs:comment "A machine-readable notice describing data handling practices of a Pod or application/service." .

:DataRequirement a owl:Class ;
  rdfs:label "Data requirement" ;
  rdfs:comment "A declaration of what data an application or service needs to function." .

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy policy" ;
  rdfs:comment "A privacy preference or requirement expressed by a user." .

:DataRequest a owl:Class ;
  rdfs:label "Data request" ;
  rdfs:comment "A request for use of data that can be managed by a user." .

:Decision a owl:Class ;
  rdfs:label "Decision" ;
  rdfs:comment "A decision regarding a data request or the use of data." .

:LogEntry a owl:Class ;
  rdfs:label "Log entry" ;
  rdfs:comment "A provenance or accountability record published to document an interaction with data." .

:ActionType a owl:Class ;
  rdfs:label "Action type" ;
  rdfs:comment "A type of action performed on data, such as create, update, or erase." .

:PolicyChange a owl:Class ;
  rdfs:label "Policy change" ;
  rdfs:comment "A change to a data handling policy that may be recorded for accountability." .

:ConsentRecord a owl:Class ;
  rdfs:label "Consent record" ;
  rdfs:comment "A record of consent kept for accountability and governance." .

:ComplianceEvent a owl:Class ;
  rdfs:label "Compliance event" ;
  rdfs:comment "An event related to legal compliance, such as exercising GDPR-related rights or supporting an audit." .

#################################################################
# Object Properties
#################################################################

:hasRole a owl:ObjectProperty ;
  rdfs:label "has role" ;
  rdfs:comment "Relates a Solid actor to a role it plays." ;
  rdfs:domain :SolidActor ;
  rdfs:range :Role .