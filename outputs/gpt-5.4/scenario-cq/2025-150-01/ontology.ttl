@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "MQTT process data and transport ontology design pattern" ;
  rdfs:comment "An ontology design pattern for representing MQTT participants, network connections, topics, topic filters, control packets, packet structure, payload characteristics, and links to observation and actuation process descriptions in IoT settings." .

#################################################################
# Classes
#################################################################

:MQTTParticipant a owl:Class ;
  rdfs:label "MQTT participant" ;
  rdfs:comment "An entity participating in MQTT communication, such as a client or broker." .

:MQTTClient a owl:Class ;
  rdfs:subClassOf :MQTTParticipant ;
  rdfs:label "MQTT client" ;
  rdfs:comment "An MQTT participant that connects to a broker and sends or receives MQTT control packets." .

:MQTTBroker a owl:Class ;
  rdfs:subClassOf :MQTTParticipant ;
  rdfs:label "MQTT broker" ;
  rdfs:comment "An MQTT participant that accepts client connections and receives or forwards MQTT control packets." .

:MQTTNetworkConnection a owl:Class ;
  rdfs:label "MQTT network connection" ;
  rdfs:comment "A network connection used by MQTT participants, possibly secured with TLS and characterized by initiator and acceptor." .

:SOSAPlatform a owl:Class ;
  rdfs:label "SOSA platform" ;
  rdfs:comment "A platform on which an MQTT client runs." .

:SOSASystem a owl:Class ;
  rdfs:label "SOSA system" ;
  rdfs:comment "A system hosted by an MQTT client, such as a sensor or actuator." .

:SOSASensor a owl:Class ;
  rdfs:subClassOf :SOSASystem ;
  rdfs:label "SOSA sensor" ;
  rdfs:comment "A sensor system that publishes observations via MQTT." .

:SOSAActuator a owl:Class ;
  rdfs:subClassOf :SOSASystem ;
  rdfs:label "SOSA actuator" ;
  rdfs:comment "An actuator system that listens to MQTT topics for commands and may be linked to actuations." .

:SOSAObservation a owl:Class ;
  rdfs:label "SOSA observation" ;
  rdfs:comment "An observation encoded in an MQTT publish payload." .

:SOSAObservationCollection a owl:Class ;
  rdfs:label "SOSA observation collection" ;
  rdfs:comment "A collection of observations encoded in an MQTT publish payload." .

:SOSAActuation a owl:Class ;
  rdfs:label "SOSA actuation" ;
  rdfs:comment "An actuation encoded in an MQTT publish payload." .

:SOSAActuationCollection a owl:Class ;
  rdfs:label "SOSA actuation collection" ;
  rdfs:comment "A collection of actuations encoded in an MQTT publish payload." .

:SOSAFeatureOfInterest a owl:Class ;
  rdfs:label "SOSA feature of interest" ;
  rdfs:comment "A feature of interest referenced from MQTT topic subjects or observations." .

:SOSAProperty a owl:Class ;
  rdfs:label "SOSA property" ;
  rdfs:comment "A property referenced from MQTT topic subjects or observations." .

:MQTTTopic a owl:Class ;
  rdfs:label "MQTT topic" ;
  rdfs:comment "An MQTT topic used in publish communication and matched by topic filters." .

:MQTTTopicFilter a owl:Class ;
  rdfs:label "MQTT topic filter" ;
  rdfs:comment "An MQTT topic filter, possibly containing wildcards, used in subscriptions and unsubscriptions." .

:MQTTTopicSubject a owl:Class ;
  rdfs:label "MQTT topic subject" ;
  rdfs:comment "A subject represented in an MQTT topic, such as a feature of interest or property." .

:MQTTControlPacket a owl:Class ;
  rdfs:label "MQTT control packet" ;
  rdfs:comment "An MQTT control packet sent by a client and received or forwarded by a broker." .