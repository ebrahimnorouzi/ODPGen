@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "ODRL policy evaluation context ODP" ;
  rdfs:comment "An ontology design pattern for representing contextual real-world information used to evaluate ODRL policies, including parties, assets, temporal context, location, actions, events, rule exercise information, recipients, and financial payment status." .

#################################################################
# Classes
#################################################################

:PolicyEvaluation a owl:Class ;
  rdfs:label "Policy evaluation" ;
  rdfs:comment "An evaluation situation for a policy in a particular real-world context." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy that is being evaluated." .

:Asset a owl:Class ;
  rdfs:label "Asset" ;
  rdfs:comment "An asset relevant to the policy being evaluated." .

:AssetCollection a owl:Class ;
  rdfs:label "Asset collection" ;
  rdfs:comment "A collection of assets associated with a policy." .

:Party a owl:Class ;
  rdfs:label "Party" ;
  rdfs:comment "An agent or actor relevant to the policy evaluation." .

:PartyCollection a owl:Class ;
  rdfs:label "Party collection" ;
  rdfs:comment "A collection of parties associated with a policy." .

:Location a owl:Class ;
  rdfs:label "Location" ;
  rdfs:comment "A location associated with a party in the evaluation context." .

:Action a owl:Class ;
  rdfs:label "Action" ;
  rdfs:comment "An action that may be performed or attempted in relation to a policy rule." .

:Rule a owl:Class ;
  rdfs:label "Rule" ;
  rdfs:comment "A rule whose exercise is relevant to policy evaluation." .

:Event a owl:Class ;
  rdfs:label "Event" ;
  rdfs:comment "An event that has occurred and is relevant to policy evaluation." .

:Recipient a owl:Class ;
  rdfs:label "Recipient" ;
  rdfs:comment "A recipient that can receive the result of an exercised rule." .

:RecipientCategory a owl:Class ;
  rdfs:label "Recipient category" ;
  rdfs:comment "A category of recipients that can receive the result of an exercised rule." .

:Payment a owl:Class ;
  rdfs:label "Payment" ;
  rdfs:comment "A financial payment relevant to policy evaluation." .

:Purpose a owl:Class ;
  rdfs:label "Purpose" ;
  rdfs:comment "A purpose for which access to an asset is requested or evaluated." .

:TemporalSegment a owl:Class ;
  rdfs:label "Temporal segment" ;
  rdfs:comment "A bounded temporal segment of an asset, such as a portion of a video stream." .

#################################################################
# Object Properties
#################################################################

:evaluatesPolicy a owl:ObjectProperty ;
  rdfs:label "evaluates policy" ;
  rdfs:comment "Relates a policy evaluation situation to the policy being evaluated." ;
  rdfs:domain :PolicyEvaluation ;
  rdfs:range :Policy .

:hasCurrentTime a owl:ObjectProperty ;
  rdfs:label "has current time" ;
  rdfs:comment "Relates a policy evaluation situation to the current time relevant for evaluation." ;
  rdfs:domain :PolicyEvaluation ;
  rdfs:range :Event .

:hasAssetCollection a owl:ObjectProperty ;
  rdfs:label "has asset collection" ;
  rdfs:comment "Relates a policy to its asset collection." ;
  rdfs:domain :Policy ;
  rdfs:range :AssetCollection .

:hasAssetMember a owl:ObjectProperty ;
  rdfs:label "has asset member" ;
  rdfs:comment "Relates an asset collection to an asset that is part of it." ;
  rdfs:domain :AssetCollection ;
  rdfs:range :Asset .

:hasPartyCollection a owl:ObjectProperty ;
  rdfs:label "has party collection" ;
  rdfs:comment "Relates a policy to its party collection." ;
  rdfs:domain :Policy ;
  rdfs:range :PartyCollection .