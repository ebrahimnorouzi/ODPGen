@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid governance registry ontology design pattern" ;
  rdfs:comment "An ontology design pattern for representing a registry in a Solid setting, including its maintainer, creation and update times, available data categories, where data is stored, and the policy associated with the data." .

#################################################################
# Classes
#################################################################

:Registry a owl:Class ;
  rdfs:label "Registry" ;
  rdfs:comment "A registry that records governance-relevant metadata about data available in a Solid environment." .

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "An entity involved in the Solid environment, such as the maintainer of a registry." .

:DataCategory a owl:Class ;
  rdfs:label "Data category" ;
  rdfs:comment "A type or category of data that may be available in a Pod or other Solid storage." .

:StorageLocation a owl:Class ;
  rdfs:label "Storage location" ;
  rdfs:comment "A location where a specific type of data is stored." .

:Policy a owl:Class ;
  rdfs:label "Policy" ;
  rdfs:comment "A policy associated with data, such as a privacy or data handling policy." .

#################################################################
# Object Properties
#################################################################

:hasMaintainer a owl:ObjectProperty ;
  rdfs:label "has maintainer" ;
  rdfs:comment "Relates a registry to the actor maintaining it." ;
  rdfs:domain :Registry ;
  rdfs:range :Actor .

:listsDataCategory a owl:ObjectProperty ;
  rdfs:label "lists data category" ;
  rdfs:comment "Relates a registry to a data category that it records as available." ;
  rdfs:domain :Registry ;
  rdfs:range :DataCategory .

:storedAt a owl:ObjectProperty ;
  rdfs:label "stored at" ;
  rdfs:comment "Relates a data category to the storage location where that type of data is stored." ;
  rdfs:domain :DataCategory ;
  rdfs:range :StorageLocation .

:hasPolicy a owl:ObjectProperty ;
  rdfs:label "has policy" ;
  rdfs:comment "Relates a data category to the policy associated with that data." ;
  rdfs:domain :DataCategory ;
  rdfs:range :Policy .

#################################################################
# Datatype Properties
#################################################################

:createdAt a owl:DatatypeProperty ;
  rdfs:label "created at" ;
  rdfs:comment "Relates a registry to the date-time when it was created." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .

:updatedAt a owl:DatatypeProperty ;
  rdfs:label "updated at" ;
  rdfs:comment "Relates a registry to the date-time when it was last updated." ;
  rdfs:domain :Registry ;
  rdfs:range xsd:dateTime .