@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Court Hierarchies and Bad Check Crime Regulations ODP" ;
    rdfs:comment "An ontology design pattern for representing court hierarchies and regulations related to bad check crime in support of legal tasks involving primarily unstructured information." .

:Court a owl:Class ;
    rdfs:label "Court" ;
    rdfs:comment "A judicial body that participates in a court hierarchy." .

:CourtHierarchy a owl:Class ;
    rdfs:label "Court Hierarchy" ;
    rdfs:comment "A hierarchical structure organizing courts." .

:Regulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "A legal regulation relevant to the domain." .

:BadCheckCrimeRegulation a owl:Class ;
    rdfs:label "Bad Check Crime Regulation" ;
    rdfs:comment "A regulation specifically related to bad check crime." ;
    rdfs:subClassOf :Regulation .

:InformationResource a owl:Class ;
    rdfs:label "Information Resource" ;
    rdfs:comment "A resource containing information used in legal tasks, primarily unstructured in nature." .

:UnstructuredInformation a owl:Class ;
    rdfs:label "Unstructured Information" ;
    rdfs:comment "Information that is primarily unstructured in nature." ;
    rdfs:subClassOf :InformationResource .

:Court owl:disjointWith :Regulation, :InformationResource .
:Regulation owl:disjointWith :InformationResource .
:CourtHierarchy owl:disjointWith :Regulation, :InformationResource .

:hasCourt a owl:ObjectProperty ;
    rdfs:label "has court" ;
    rdfs:comment "Relates a court hierarchy to a court that is part of it." ;
    rdfs:domain :CourtHierarchy ;
    rdfs:range :Court .

:hasHigherCourt a owl:ObjectProperty ;
    rdfs:label "has higher court" ;
    rdfs:comment "Relates a court to another court that is higher in the hierarchy." ;
    rdfs:domain :Court ;
    rdfs:range :Court .

:hasLowerCourt a owl:ObjectProperty ;
    rdfs:label "has lower court" ;
    rdfs:comment "Relates a court to another court that is lower in the hierarchy." ;
    rdfs:domain :Court ;
    rdfs:range :Court ;
    owl:inverseOf :hasHigherCourt .

:capturesCourtHierarchy a owl:ObjectProperty ;
    rdfs:label "captures court hierarchy" ;
    rdfs:comment "Relates an information resource to a court hierarchy it captures." ;
    rdfs:domain :InformationResource ;
    rdfs:range :CourtHierarchy .

:capturesRegulation a owl:ObjectProperty ;
    rdfs:label "captures regulation" ;
    rdfs:comment "Relates an information resource to a regulation it captures." ;
    rdfs:domain :InformationResource ;
    rdfs:range :Regulation .

:regulatesCrimeType a owl:DatatypeProperty ;
    rdfs:label "regulates crime type" ;
    rdfs:comment "Specifies the crime type addressed by a regulation." ;
    rdfs:domain :BadCheckCrimeRegulation ;
    rdfs:range xsd:string .