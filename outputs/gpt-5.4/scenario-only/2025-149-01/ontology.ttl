@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-nf#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "RDB SQL Access Security ODP" ;
  rdfs:comment "An ontology design pattern for modeling the securing of access to a relational database that is queried via Structured Query Language." .

:RelationalDatabase a owl:Class ;
  rdfs:label "Relational Database" ;
  rdfs:comment "A database organized according to the relational model." .

:SQLQuery a owl:Class ;
  rdfs:label "SQL Query" ;
  rdfs:comment "A query expressed in Structured Query Language and used to query a relational database." .

:Access a owl:Class ;
  rdfs:label "Access" ;
  rdfs:comment "An access to a relational database performed through a query." .

:SecurityControl a owl:Class ;
  rdfs:label "Security Control" ;
  rdfs:comment "A control used to secure access to a relational database." .

:securedBy a owl:ObjectProperty ;
  rdfs:label "secured by" ;
  rdfs:comment "Relates an access to the security control that secures it." ;
  rdfs:domain :Access ;
  rdfs:range :SecurityControl .

:accessesDatabase a owl:ObjectProperty ;
  rdfs:label "accesses database" ;
  rdfs:comment "Relates an access to the relational database being accessed." ;
  rdfs:domain :Access ;
  rdfs:range :RelationalDatabase .

:usesSQLQuery a owl:ObjectProperty ;
  rdfs:label "uses SQL query" ;
  rdfs:comment "Relates an access to the SQL query used to perform it." ;
  rdfs:domain :Access ;
  rdfs:range :SQLQuery .

:queriesDatabase a owl:ObjectProperty ;
  rdfs:label "queries database" ;
  rdfs:comment "Relates an SQL query to the relational database that it queries." ;
  rdfs:domain :SQLQuery ;
  rdfs:range :RelationalDatabase .

:RelationalDatabase owl:disjointWith :SQLQuery, :Access, :SecurityControl .
:SQLQuery owl:disjointWith :Access, :SecurityControl .
:Access owl:disjointWith :SecurityControl .