@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "kHealth-Asthma causal monitoring ontology design pattern" ;
    rdfs:comment "An ontology design pattern for representing pediatric asthma self-monitoring data about symptoms, medication intake, outdoor environmental features, and causal relations with effect weights." .

:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "A person whose asthma-related symptoms, medication intake, and environmental exposures are monitored." .

:PediatricAsthmaPatient a owl:Class ;
    rdfs:label "Pediatric asthma patient" ;
    rdfs:comment "A patient who is a child and has asthma in the kHealth-Asthma monitoring context." ;
    rdfs:subClassOf :Patient .

:Symptom a owl:Class ;
    rdfs:label "Symptom" ;
    rdfs:comment "A manifestation of the patient's asthma condition that is monitored." .

:Cough a owl:Class ;
    rdfs:label "Cough" ;
    rdfs:comment "A symptom consisting of coughing." ;
    rdfs:subClassOf :Symptom .

:ChestTightness a owl:Class ;
    rdfs:label "Chest tightness" ;
    rdfs:comment "A symptom consisting of chest tightness." ;
    rdfs:subClassOf :Symptom .

:Wheezing a owl:Class ;
    rdfs:label "Wheezing" ;
    rdfs:comment "A symptom consisting of wheezing." ;
    rdfs:subClassOf :Symptom .

:BreathingPattern a owl:Class ;
    rdfs:label "Breathing pattern" ;
    rdfs:comment "A monitored breathing pattern symptom or breathing-related manifestation." ;
    rdfs:subClassOf :Symptom .

:MedicationIntake a owl:Class ;
    rdfs:label "Medication intake" ;
    rdfs:comment "An event or record of a patient taking medication." .

:OutdoorEnvironmentFeature a owl:Class ;
    rdfs:label "Outdoor environment feature" ;
    rdfs:comment "A monitored outdoor environmental factor relevant to asthma." .

:Pollen a owl:Class ;
    rdfs:label "Pollen" ;
    rdfs:comment "An outdoor allergen feature representing pollen." ;
    rdfs:subClassOf :OutdoorEnvironmentFeature .

:AirQualityIndex a owl:Class ;
    rdfs:label "Air quality index" ;
    rdfs:comment "An outdoor environment feature representing air quality index (AQI)." ;
    rdfs:subClassOf :OutdoorEnvironmentFeature .

:CausalRelation a owl:Class ;
    rdfs:label "Causal relation" ;
    rdfs:comment "A relation representing that one monitored factor causally affects another, with an associated effect weight." .

:hasSymptom a owl:ObjectProperty ;
    rdfs:label "has symptom" ;
    rdfs:comment "Relates a patient to a monitored symptom they experience." ;
    rdfs:domain :Patient ;
    rdfs:range :Symptom .

:hasMedicationIntake a owl:ObjectProperty ;
    rdfs:label "has medication intake" ;
    rdfs:comment "Relates a patient to a medication intake record." ;
    rdfs:domain :Patient ;
    rdfs:range :MedicationIntake .

:hasOutdoorEnvironmentFeature a owl:ObjectProperty ;
    rdfs:label "has outdoor environment feature" ;
    rdfs:comment "Relates a patient to an outdoor environmental feature relevant to their monitoring context." ;
    rdfs:domain :Patient ;
    rdfs:range :OutdoorEnvironmentFeature .

:hasCausalRelation a owl:ObjectProperty ;
    rdfs:label "has causal relation" ;
    rdfs:comment "Relates a patient to a causal relation relevant to that patient's monitored condition." ;
    rdfs:domain :Patient ;
    rdfs:range :CausalRelation .

:hasCause a owl:ObjectProperty ;
    rdfs:label "has cause" ;
    rdfs:comment "Relates a causal relation to the environmental feature that acts as the cause." ;
    rdfs:domain :CausalRelation ;
    rdfs:range :OutdoorEnvironmentFeature .

:hasEffect a owl:ObjectProperty ;
    rdfs:label "has effect" ;
    rdfs:comment "Relates a causal relation to the symptom that is affected." ;
    rdfs:domain :CausalRelation ;
    rdfs:range :Symptom .

:hasEffectWeight a owl:DatatypeProperty ;
    rdfs:label "has effect weight" ;
    rdfs:comment "Associates a causal relation with a numeric weight expressing the strength of the causal effect." ;
    rdfs:domain :CausalRelation ;
    rdfs:range xsd:decimal .

:Patient owl:disjointWith :Symptom, :MedicationIntake, :OutdoorEnvironmentFeature, :CausalRelation .
:Symptom owl:disjointWith :MedicationIntake, :OutdoorEnvironmentFeature, :CausalRelation .
:MedicationIntake owl:disjointWith :OutdoorEnvironmentFeature, :CausalRelation .
:OutdoorEnvironmentFeature owl:disjointWith :CausalRelation .

:Cough owl:disjointWith :ChestTightness, :Wheezing, :BreathingPattern .
:ChestTightness owl:disjointWith :Wheezing, :BreathingPattern .
:Wheezing owl:disjointWith :BreathingPattern .

:Pollen owl:disjointWith :AirQualityIndex .