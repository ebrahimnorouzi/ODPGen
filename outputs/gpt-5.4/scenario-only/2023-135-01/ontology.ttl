@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Author names and publication names ODP" ;
  rdfs:comment "An ontology design pattern for modeling an author who adopts different names for publishing books, including name changes such as those occurring after marriage." .

:Author a owl:Class ;
  rdfs:label "Author" ;
  rdfs:comment "A person who authors books and may use different names over time or for publication." .

:Book a owl:Class ;
  rdfs:label "Book" ;
  rdfs:comment "A book that is authored and published under a particular author name." .

:Name a owl:Class ;
  rdfs:label "Name" ;
  rdfs:comment "A name used by an author, including legal names, changed names, or publication names." .

:PublicationName a owl:Class ;
  rdfs:label "Publication name" ;
  rdfs:comment "A name adopted by an author for publishing books." ;
  rdfs:subClassOf :Name .

:NameChange a owl:Class ;
  rdfs:label "Name change" ;
  rdfs:comment "A change from one name to another for an author, for example after marriage." .

:Author owl:disjointWith :Book, :Name, :NameChange .
:Book owl:disjointWith :Name, :NameChange .
:Name owl:disjointWith :NameChange .

:hasName a owl:ObjectProperty ;
  rdfs:label "has name" ;
  rdfs:comment "Relates an author to a name used by that author." ;
  rdfs:domain :Author ;
  rdfs:range :Name .

:usesPublicationName a owl:ObjectProperty ;
  rdfs:label "uses publication name" ;
  rdfs:comment "Relates an author to a name adopted for publishing books." ;
  rdfs:domain :Author ;
  rdfs:range :PublicationName ;
  rdfs:subPropertyOf :hasName .

:authorsBook a owl:ObjectProperty ;
  rdfs:label "authors book" ;
  rdfs:comment "Relates an author to a book authored by that author." ;
  rdfs:domain :Author ;
  rdfs:range :Book .

:isPublishedUnderName a owl:ObjectProperty ;
  rdfs:label "is published under name" ;
  rdfs:comment "Relates a book to the publication name under which it is published." ;
  rdfs:domain :Book ;
  rdfs:range :PublicationName .

:hasNameChange a owl:ObjectProperty ;
  rdfs:label "has name change" ;
  rdfs:comment "Relates an author to a name change associated with that author." ;
  rdfs:domain :Author ;
  rdfs:range :NameChange .

:fromName a owl:ObjectProperty ;
  rdfs:label "from name" ;
  rdfs:comment "Relates a name change to the earlier name." ;
  rdfs:domain :NameChange ;
  rdfs:range :Name .

:toName a owl:ObjectProperty ;
  rdfs:label "to name" ;
  rdfs:comment "Relates a name change to the later name." ;
  rdfs:domain :NameChange ;
  rdfs:range :Name .

:nameLiteral a owl:DatatypeProperty ;
  rdfs:label "name literal" ;
  rdfs:comment "The textual form of a name." ;
  rdfs:domain :Name ;
  rdfs:range xsd:string .