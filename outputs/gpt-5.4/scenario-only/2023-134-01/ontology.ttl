@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Solid Governance Challenges ODP" ;
  rdfs:comment "An ontology design pattern for representing governance-relevant information gaps and governance capabilities for Solid apps and Pods, including actor identity and roles, infrastructure metadata, data category discovery, data handling declarations, user privacy policies and decisions, logging and provenance, and legal compliance support." .

### Classes

:SolidActor a owl:Class ;
  rdfs:label "Solid actor" ;
  rdfs:comment "An entity participating in the Solid ecosystem, such as a user or a provider." .

:SolidUser a owl:Class ;
  rdfs:label "Solid user" ;
  rdfs:comment "A Solid actor who uses Pods and apps and may express privacy preferences, manage requests, and exercise rights." ;
  rdfs:subClassOf :SolidActor .

:Provider a owl:Class ;
  rdfs:label "Provider" ;
  rdfs:comment "A Solid actor that provides a Pod or an app." ;
  rdfs:subClassOf :SolidActor .

:PodProvider a owl:Class ;
  rdfs:label "Pod provider" ;
  rdfs:comment "A provider that provides a Pod." ;
  rdfs:subClassOf :Provider .

:AppProvider a owl:Class ;
  rdfs:label "App provider" ;
  rdfs:comment "A provider that provides an app." ;
  rdfs:subClassOf :Provider .

:Pod a owl:Class ;
  rdfs:label "Pod" ;
  rdfs:comment "A Solid Pod used to store data and expose infrastructure metadata, data categories, policies, and records." .

:SolidApp a owl:Class ;
  rdfs:label "Solid app" ;
  rdfs:comment "An application used in the Solid ecosystem that may require data, declare data handling practices, and access Pod data." .

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A role held by a Solid actor in relation to the Solid ecosystem." .

:InfrastructureMetadata a owl:Class ;
  rdfs:label "Infrastructure metadata" ;
  rdfs:comment "Metadata describing a Pod's infrastructure, such as the Solid specification it runs and installed functionalities." .

:SolidSpecification a owl:Class ;
  rdfs:label "Solid specification" ;
  rdfs:comment "A Solid specification that a Pod is running." .

:Functionality a owl:Class ;
  rdfs:label "Functionality" ;
  rdfs:comment "A functionality installed within a Pod." .

:DataCategory a owl:Class ;
  rdfs:label "Data category" ;
  rdfs:comment "A category of data whose existence and storage location in a Pod may need to be discovered for granular access." .

:DataStorageLocation a owl:Class ;
  rdfs:label "Data storage location" ;
  rdfs:comment "A location in a Pod where data of a given category is stored." .

:DataHandlingPractice a owl:Class ;
  rdfs:label "Data handling practice" ;
  rdfs:comment "A declared practice describing how a Pod or app handles data." .

:PrivacyNotice a owl:Class ;
  rdfs:label "Privacy notice" ;
  rdfs:comment "A machine-readable notice describing data handling practices." .

:DataRequirement a owl:Class ;
  rdfs:label "Data requirement" ;
  rdfs:comment "A declaration of what data an app needs to function." .

:PrivacyPolicy a owl:Class ;
  rdfs:label "Privacy policy" ;
  rdfs:comment "A policy expressing a user's privacy preferences and requirements." .

:PrivacyPreference a owl:Class ;
  rdfs:label "Privacy preference" ;
  rdfs:comment "A privacy preference expressed by a user." .

:PrivacyRequirement a owl:Class ;
  rdfs:label "Privacy requirement" ;
  rdfs:comment "A privacy requirement expressed by a user." .

:DataRequest a owl:Class ;
  rdfs:label "Data request" ;
  rdfs:comment "A request for the use of data that a user may manage." .