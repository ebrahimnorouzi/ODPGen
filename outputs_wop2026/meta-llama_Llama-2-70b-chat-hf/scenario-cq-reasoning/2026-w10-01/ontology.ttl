@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "SMARTY Matchmaker Ontology" ;
rdfs:comment "Ontology for matching software and hardware resources".

:Software a owl:Class ;
rdfs:label "Software" ;
rdfs:comment "A software component".

:Hardware a owl:Class ;
rdfs:label "Hardware" ;
rdfs:comment "A hardware resource".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement of a software".

:hasRequirement a owl:ObjectProperty ;
rdfs:label "hasRequirement" ;
rdfs:comment "A software has a requirement".

:hasResource a owl:ObjectProperty ;
rdfs:label "hasResource" ;
rdfs:comment "A software has a resource".

:Resource a owl:Class ;
rdfs:label "Resource" ;
rdfs:comment "A resource required by a software".

:minimumVersion a owl:DatatypeProperty ;
rdfs:label "minimumVersion" ;
rdfs:comment "The minimum version of a software required by a software".

:maximumVersion a owl:DatatypeProperty ;
rdfs:label "maximumVersion" ;
rdfs:comment "The maximum version of a software required by a software".

:exactVersion a owl:DatatypeProperty ;
rdfs:label "exactVersion" ;
rdfs:comment "The exact version of a software required by a software".

:minimumValue a owl:DatatypeProperty ;
rdfs:label "minimumValue" ;
rdfs:comment "The minimum value of a property of a software/hardware required by a software".

:maximumValue a owl:DatatypeProperty ;
rdfs:label "maximumValue" ;
rdfs:comment "The maximum value of a property of a software/hardware required by a software".

:type a owl:ObjectProperty ;
rdfs:label "type" ;
rdfs:comment "The type of a software/hardware required by a software".

:match a owl:ObjectProperty ;
rdfs:label "match" ;
rdfs:comment "A software matches a hardware resource".