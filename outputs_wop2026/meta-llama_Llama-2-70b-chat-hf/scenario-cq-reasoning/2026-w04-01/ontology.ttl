@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Reverse Engineering Knowledge Graph Ontology" ;
rdfs:comment "An ontology for representing knowledge about reverse engineering of binary executables.".

:BinaryExecutable a owl:Class ;
rdfs:label "Binary Executable" ;
rdfs:comment "A binary executable file.".

:SymbolTable a owl:Class ;
rdfs:label "Symbol Table" ;
rdfs:comment "A collection of symbols used in a binary executable.".

:Symbol a owl:Class ;
rdfs:label "Symbol" ;
rdfs:comment "A symbol used in a binary executable.".

:Function a owl:Class ;
rdfs:label "Function" ;
rdfs:comment "A function in a binary executable.".

:Variable a owl:Class ;
rdfs:label "Variable" ;
rdfs:comment "A variable in a binary executable.".

:APICall a owl:Class ;
rdfs:label "API Call" ;
rdfs:comment "An API call in a binary executable.".

:NetworkActivity a owl:Class ;
rdfs:label "Network Activity" ;
rdfs:comment "Network activity in a binary executable.".

:ControlFlow a owl:Class ;
rdfs:label "Control Flow" ;
rdfs:comment "Control flow patterns in a binary executable.".

:Entropy a owl:Class ;
rdfs:label "Entropy" ;
rdfs:comment "Entropy in a binary executable.".

:Obfuscation a owl:Class ;
rdfs:label "Obfuscation" ;
rdfs:comment "Obfuscation patterns in a binary executable.".

:FileSystemAbuse a owl:Class ;
rdfs:label "File System Abuse" ;
rdfs:comment "File system abuse in a binary executable.".

:SuspiciousJump a owl:Class ;
rdfs:label "Suspicious Jump" ;
rdfs:comment "Suspicious jumps into memory in a binary executable.".

:SuspiciousAPICall a owl:Class ;
rdfs:label "Suspicious API Call" ;
rdfs:comment "Suspicious API calls in a binary executable.".

:CryptographicActivity a owl:Class ;
rdfs:label "Cryptographic Activity" ;
rdfs:comment "Cryptographic activity in a binary executable.".

:ImportedFunction a owl:Class ;
rdfs:label "Imported Function" ;
rdfs:comment "An imported function in a binary executable.".

:BinaryExecutable hasSymbolTable :SymbolTable.
:SymbolTable hasSymbol :Symbol.
:Symbol hasName xsd:string.
:Symbol hasType xsd:string.
:Function hasSymbol :Symbol.
:Variable hasSymbol :Symbol.
:APICall hasSymbol :Symbol.
:NetworkActivity hasSymbol :Symbol.
:ControlFlow hasSymbol :Symbol.
:Entropy hasSymbol :Symbol.
:Obfuscation hasSymbol :Symbol.
:FileSystemAbuse hasSymbol :Symbol.
:SuspiciousJump hasSymbol :Symbol.
:SuspiciousAPICall hasSymbol :Symbol.
:CryptographicActivity hasSymbol :Symbol.
:ImportedFunction hasSymbol :Symbol.

:BinaryExecutable hasFunction :Function.
:Function hasName xsd:string.
:Function hasBody xsd:string.
:Variable hasName xsd:string.
:Variable hasType xsd:string.
:APICall hasFunction :Function.
:NetworkActivity hasFunction :Function.
:ControlFlow hasFunction :Function.
:Entropy hasFunction :Function.
:Obfuscation hasFunction :Function.
:FileSystemAbuse hasFunction :Function.
:SuspiciousJump hasFunction :Function.
:SuspiciousAPICall hasFunction :Function.
:CryptographicActivity hasFunction :Function.
:ImportedFunction hasFunction :Function.

:BinaryExecutable hasVariable :Variable.
:Variable hasName xsd:string.
:Variable hasType xsd:string.
:Function hasVariable :Variable.

:BinaryExecutable hasAPICall :APICall.
:APICall hasFunction :Function.
:APICall hasName xsd:string.

:BinaryExecutable hasNetworkActivity :NetworkActivity.
:NetworkActivity hasFunction :Function.
:NetworkActivity hasName xsd:string.

:BinaryExecutable hasControlFlow :ControlFlow.
:ControlFlow hasFunction :Function.
:ControlFlow hasName xsd:string.

:BinaryExecutable hasEntropy :Entropy.
:Entropy hasFunction :Function.
:Entropy hasName xsd:string.

:BinaryExecutable hasObfuscation :Obfuscation.
:Obfuscation hasFunction :Function.
:Obfuscation hasName xsd:string.

:BinaryExecutable hasFileSystemAbuse :FileSystemAbuse.
:FileSystemAbuse hasFunction :Function.
:FileSystemAbuse hasName xsd:string.

:BinaryExecutable hasSuspiciousJump :SuspiciousJump.
:SuspiciousJump hasFunction :Function.
:SuspiciousJump hasName xsd:string.

:BinaryExecutable hasSuspiciousAPICall :SuspiciousAPICall.
:SuspiciousAPICall hasFunction :Function.
:SuspiciousAPICall hasName xsd:string.

:BinaryExecutable hasCryptographicActivity :CryptographicActivity.
:CryptographicActivity hasFunction :Function.
:CryptographicActivity hasName xsd:string.

:BinaryExecutable hasImportedFunction :ImportedFunction.
:ImportedFunction hasFunction :Function.
:ImportedFunction hasName xsd:string.