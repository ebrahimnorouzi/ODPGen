@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "APLO Ontology" ;
rdfs:comment "An ontology for representing pedagogical organization, including frameworks, elements, and their order, objective alignment, evaluation, feedback, learner context, and learner awareness.".

:Frameworks a owl:Class ;
rdfs:label "Pedagogical Framework" ;
rdfs:comment "A set of pedagogical elements and their order, used to support learning objectives.".

:PedagogicalElements a owl:Class ;
rdfs:label "Pedagogical Element" ;
rdfs:comment "A single element of a pedagogical framework, such as a learning objective, pedagogical technique, or assessment exercise.".

:LearningObjectives a owl:Class ;
rdfs:label "Learning Objective" ;
rdfs:comment "A specific skill or knowledge target that a learner should achieve.".

:PedagogicalTechniques a owl:Class ;
rdfs:label "Pedagogical Technique" ;
rdfs:comment "A method or strategy used to support learner progress toward a learning objective.".

:AssessmentExercises a owl:Class ;
rdfs:label "Assessment Exercise" ;
rdfs:comment "A specific evaluation method used to measure learner progress toward a learning objective.".

:Feedback a owl:Class ;
rdfs:label "Feedback" ;
rdfs:comment "Information provided to a learner in response to their performance on an assessment exercise.".

:LearnerContext a owl:Class ;
rdfs:label "Learner Context" ;
rdfs:comment "Information about the learner's current situation, including goals, preferences, challenges, and accessibility needs.".

:LearnerAwareness a owl:Class ;
rdfs:label "Learner Awareness" ;
rdfs:comment "The learner's current understanding or familiarity with a topic or skill.".

:Module a owl:Class ;
rdfs:label "Module" ;
rdfs:comment "A collection of learning resources and activities, organized around a specific learning objective.".

:Media a owl:Class ;
rdfs:label "Media" ;
rdfs:comment "A specific learning resource, such as a video, reading, or interactive activity.".

:Evaluation a owl:Class ;
rdfs:label "Evaluation" ;
rdfs:comment "A method used to assess learner progress toward a learning objective.".

:LearningStrategy a owl:Class ;
rdfs:label "Learning Strategy" ;
rdfs:comment "A specific approach or method used by a learner to achieve a learning objective.".

:InstructionalStep a owl:Class ;
rdfs:label "Instructional Step" ;
rdfs:comment "A specific action or activity used to support learner progress toward a learning objective.".

:AvailablePedagogicalFrameworks a owl:ObjectProperty ;
rdfs:label "Available Pedagogical Frameworks" ;
rdfs:comment "A list of all available pedagogical frameworks.".

:PedagogicalFramework a owl:ObjectProperty ;
rdfs:label "Pedagogical Framework" ;
rdfs:comment "The pedagogical framework that contains a given learning objective or pedagogical element.".

:PedagogicalElementsInFramework a owl:ObjectProperty ;
rdfs:label "Pedagogical Elements in Framework" ;
rdfs:comment "The pedagogical elements that are part of a given pedagogical framework.".

:LearningObjectivesInFramework a owl:ObjectProperty ;
rdfs:label "Learning Objectives in Framework" ;
rdfs:comment "The learning objectives that are supported by a given pedagogical framework.".

:PedagogicalTechniquesInFramework a owl:ObjectProperty ;
rdfs:label "Pedagogical Techniques in Framework" ;
rdfs:comment "The pedagogical techniques that are part of a given pedagogical framework.".

:AssessmentExercisesInFramework a owl:ObjectProperty ;
rdfs:label "Assessment Exercises in Framework" ;
rdfs:comment "The assessment exercises that are part of a given pedagogical framework.".

:FeedbackInFramework a owl:ObjectProperty ;
rdfs:label "Feedback in Framework" ;
rdfs:comment "The feedback that is provided to learners in response to their performance on assessment exercises, within a given pedagogical framework.".

:LearnerContextInFramework a owl:ObjectProperty ;
rdfs:label "Learner Context in Framework" ;
rdfs:comment "The learner context that is considered when selecting learning objectives, pedagogical techniques, or assessment exercises within a given pedagogical framework.".

:LearnerAwarenessInFramework a owl:ObjectProperty ;
rdfs:label "Learner Awareness in Framework" ;
rdfs:comment "The learner's current awareness level for a topic or skill, within a given pedagogical framework.".

:ModuleInFramework a owl:ObjectProperty ;
rdfs:label "Module in Framework" ;
rdfs:comment "The module that is part of a given pedagogical framework.".

:MediaInFramework a owl:ObjectProperty ;
rdfs:label "Media in Framework" ;
rdfs:comment "The media that is part of a given pedagogical framework.".

:EvaluationInFramework a owl:ObjectProperty ;
rdfs:label "Evaluation in Framework" ;
rdfs:comment "The evaluation method that is used to assess learner progress toward a learning objective, within a given pedagogical framework.".

:LearningStrategyInFramework a owl:ObjectProperty ;
rdfs:label "Learning Strategy in Framework" ;
rdfs:comment "The learning strategy that is used by a learner to achieve a learning objective, within a given pedagogical framework.".

:InstructionalStepInFramework a owl:ObjectProperty ;
rdfs:label "Instructional Step in Framework" ;
rdfs:comment "The instructional step that is part of a given pedagogical framework.".

:AvailableLearningObjectives a owl:ObjectProperty ;
rdfs:label "Available Learning Objectives" ;
rdfs:comment "A list of all available learning objectives.".

:LearningObjectiveInModule a owl:ObjectProperty ;
rdfs:label "Learning Objective in Module" ;
rdfs:comment "The learning objective that is supported by a given module.".

:PedagogicalTechniqueInModule a owl:ObjectProperty ;
rdfs:label "Pedagogical Technique in Module" ;
rdfs:comment "The pedagogical technique that is used in a given module.".

:AssessmentExerciseInModule a owl:ObjectProperty ;
rdfs:label "Assessment Exercise in Module" ;
rdfs:comment "The assessment exercise that is part of a given module.".

:FeedbackInModule a owl:ObjectProperty ;
rdfs:label "Feedback in Module" ;
rdfs:comment "The feedback that is provided to learners in response to their performance on assessment exercises, within a given module.".

:LearnerContextInModule a owl:ObjectProperty ;
rdfs:label "Learner Context in Module" ;
rdfs:comment "The learner context that is considered when selecting learning objectives, pedagogical techniques, or assessment exercises within a given module.".

:LearnerAwarenessInModule a owl:ObjectProperty ;
rdfs:label "Learner Awareness in Module" ;
rdfs:comment "The learner's current awareness level for a topic or skill, within a given module.".

:ModuleInModule a owl:ObjectProperty ;
rdfs:label "Module in Module" ;
rdfs:comment "The module that is part of a given module.".

