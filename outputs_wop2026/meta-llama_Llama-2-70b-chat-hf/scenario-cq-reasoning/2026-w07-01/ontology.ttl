:LearningStrategyInModule a owl:ObjectProperty ;
rdfs:label "Learning Strategy in Module" ;
rdfs:comment "The learning strategy that is used by a learner to achieve a learning objective, within a given module.".

:InstructionalStepInModule a owl:ObjectProperty ;
rdfs:label "Instructional Step in Module" ;
rdfs:comment "The instructional step that is part of a given module.".

:AvailablePedagogicalTechniques a owl:ObjectProperty ;
rdfs:label "Available Pedagogical Techniques" ;
rdfs:comment "A list of all available pedagogical techniques.".

:PedagogicalTechniqueInModule a owl:ObjectProperty ;
