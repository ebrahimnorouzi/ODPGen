@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "LCAnet Ontology" ;
rdfs:comment "Ontology for LCAnet".

# Classes
:LCAStudy a owl:Class ;
rdfs:label "LCA Study" ;
rdfs:comment "A study conducted using the EIME software tool".

:Activity a owl:Class ;
rdfs:label "Activity" ;
rdfs:comment "An activity involved in the LCA study".

:Flow a owl:Class ;
rdfs:label "Flow" ;
rdfs:comment "A flow of materials, energy, or information".

:Dataset a owl:Class ;
rdfs:label "Dataset" ;
rdfs:comment "A collection of data used in the LCA study".

:Database a owl:Class ;
rdfs:label "Database" ;
rdfs:comment "A database used to source inventory data".

:Hypothesis a owl:Class ;
rdfs:label "Hypothesis" ;
rdfs:comment "A hypothesis tested in the LCA study".

:Parametrisation a owl:Class ;
rdfs:label "Parametrisation" ;
rdfs:comment "A parametrisation used in the LCA study".

:SystemBoundary a owl:Class ;
rdfs:label "System Boundary" ;
rdfs:comment "The system boundary of the LCA study".

:Actor a owl:Class ;
rdfs:label "Actor" ;
rdfs:comment "An actor involved in the LCA study".

# Properties
:hasInputFlow a owl:ObjectProperty ;
rdfs:label "has input flow" ;
rdfs:comment "An activity has an input flow".

:hasOutputFlow a owl:ObjectProperty ;
rdfs:label "has output flow" ;
rdfs:comment "An activity has an output flow".

:isDependentOn a owl:ObjectProperty ;
rdfs:label "is dependent on" ;
rdfs:comment "An activity is dependent on another activity".

:isInventoryDataset a owl:ObjectProperty ;
rdfs:label "is inventory dataset" ;
rdfs:comment "A dataset is an inventory dataset".

:isEnvironmentalImpactCalculated a owl:ObjectProperty ;
rdfs:label "is environmental impact calculated" ;
rdfs:comment "Environmental impact has been calculated for a flow".

:hasFunctionalUnit a owl:ObjectProperty ;
rdfs:label "has functional unit" ;
rdfs:comment "A flow has a functional unit".

:hasScope a owl:ObjectProperty ;
rdfs:label "has scope" ;
rdfs:comment "A flow has a scope".

:hasResponsibleAgent a owl:ObjectProperty ;
rdfs:label "has responsible agent" ;
rdfs:comment "A flow has a responsible agent".

:hasImpactResult a owl:ObjectProperty ;
rdfs:label "has impact result" ;
rdfs:comment "A flow has an impact result".

:hasContributor a owl:ObjectProperty ;
rdfs:label "has contributor" ;
rdfs:comment "A flow has a contributor".

:hasTotalAmount a owl:ObjectProperty ;
rdfs:label "has total amount" ;
rdfs:comment "A flow has a total amount".