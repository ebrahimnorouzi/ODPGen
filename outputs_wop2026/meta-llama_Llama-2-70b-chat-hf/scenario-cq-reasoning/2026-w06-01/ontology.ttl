@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "PIIRRITE Ontology" ;
rdfs:comment "An ontology for inclusive-by-design pedestrian route planning".

:SpatialEntity a owl:Class ;
rdfs:label "Spatial Entity" ;
rdfs:comment "A physical location or space".

:TopologicalRelation a owl:Class ;
rdfs:label "Topological Relation" ;
rdfs:comment "A relationship between two or more SpatialEntities".

:NavigablePath a owl:Class ;
rdfs:label "Navigable Path" ;
rdfs:comment "A path that can be traversed by a pedestrian".

:PointOfInterest a owl:Class ;
rdfs:label "Point of Interest" ;
rdfs:comment "A location that may be of interest to a user".

:ContextualProperty a owl:Class ;
rdfs:label "Contextual Property" ;
rdfs:comment "A property of a SpatialEntity that may be relevant to a user".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A user's need or preference for a particular ContextualProperty".

:Condition a owl:Class ;
rdfs:label "Condition" ;
rdfs:comment "A constraint on a Requirement".

:ComposedCondition a owl:Class ;
rdfs:label "Composed Condition" ;
rdfs:comment "A composite of Conditions".

:DistanceRequisite a owl:Class ;
rdfs:label "Distance Requisite" ;
rdfs:comment "A requirement related to distance".

:UserProfile a owl:Class ;
rdfs:label "User Profile" ;
rdfs:comment "A collection of Requirements and Conditions that define a user's preferences and needs".

:EnvironmentalCharacteristic a owl:Class ;
rdfs:label "Environmental Characteristic" ;
rdfs:comment "A characteristic of a SpatialEntity that may be relevant to a user's comfort or experience".

:Amenity a owl:Class ;
rdfs:label "Amenity" ;
rdfs:comment "A feature or service that may be of interest to a user".

:RestArea a owl:Class ;
rdfs:label "Rest Area" ;
rdfs:comment "An area that provides a quiet and comfortable space for rest".

:Accessibility a owl:Class ;
rdfs:label "Accessibility" ;
rdfs:comment "A characteristic of a SpatialEntity that relates to its ease of access".

:NoiseLevel a owl:Class ;
rdfs:label "Noise Level" ;
rdfs:comment "A characteristic of a SpatialEntity that relates to the level of noise present".

:Crowdedness a owl:Class ;
rdfs:label "Crowdedness" ;
rdfs:comment "A characteristic of a SpatialEntity that relates to the level of crowding present".

:SpatialEntityHasContextualProperty a owl:ObjectProperty ;
rdfs:label "Spatial Entity Has Contextual Property" ;
rdfs:comment "A relationship between a SpatialEntity and a ContextualProperty".

:SpatialEntityHasTopologicalRelation a owl:ObjectProperty ;
rdfs:label "Spatial Entity Has Topological Relation" ;
rdfs:comment "A relationship between two or more SpatialEntities".

:NavigablePathHasContextualProperty a owl:ObjectProperty ;
rdfs:label "Navigable Path Has Contextual Property" ;
rdfs:comment "A relationship between a NavigablePath and a ContextualProperty".

:NavigablePathHasTopologicalRelation a owl:ObjectProperty ;
rdfs:label "Navigable Path Has Topological Relation" ;
rdfs:comment "A relationship between two or more NavigablePaths".

:RequirementHasCondition a owl:ObjectProperty ;
rdfs:label "Requirement Has Condition" ;
rdfs:comment "A relationship between a Requirement and a Condition".

:UserProfileHasRequirement a owl:ObjectProperty ;
rdfs:label "User Profile Has Requirement" ;
rdfs:comment "A relationship between a UserProfile and a Requirement".

:EnvironmentalCharacteristicHasValue a owl:ObjectProperty ;
rdfs:label "Environmental Characteristic Has Value" ;
rdfs:comment "A relationship between an EnvironmentalCharacteristic and a value".

:AmenityHasType a owl:ObjectProperty ;
rdfs:label "Amenity Has Type" ;
rdfs:comment "A relationship between an Amenity and its type".

:RestAreaHasType a owl:ObjectProperty ;
rdfs:label "Rest Area Has Type" ;
rdfs:comment "A relationship between a RestArea and its type".

:AccessibilityHasLevel a owl:ObjectProperty ;
rdfs:label "Accessibility Has Level" ;
rdfs:comment "A relationship between an Accessibility and its level".

:NoiseLevelHasValue a owl:ObjectProperty ;
rdfs:label "Noise Level Has Value" ;
rdfs:comment "A relationship between a NoiseLevel and its value".

:CrowdednessHasValue a owl:ObjectProperty ;
rdfs:label "Crowdedness Has Value" ;
rdfs:comment "A relationship between a Crowdedness and its value".