@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "WISDOM Stress Detection Ontology" ;
rdfs:comment "A formal representation of stress conditions, stressors, and physiological responses for wearable stress detection".

:Stress a owl:Class ;
rdfs:label "Stress" ;
rdfs:comment "A stress condition or state".

:Stressor a owl:Class ;
rdfs:label "Stressor" ;
rdfs:comment "A stimulus or event that has the potential to induce stress".

:PhysiologicalResponse a owl:Class ;
rdfs:label "PhysiologicalResponse" ;
rdfs:comment "A response to a stressor or stress condition".

:Sensor a owl:Class ;
rdfs:label "Sensor" ;
rdfs:comment "A device that measures physiological or behavioral responses".

:SignalChannel a owl:Class ;
rdfs:label "SignalChannel" ;
rdfs:comment "A specific type of sensor measurement".

:Observation a owl:Class ;
rdfs:label "Observation" ;
rdfs:comment "A measurement or observation of a physiological or behavioral response".

:Activity a owl:Class ;
rdfs:label "Activity" ;
rdfs:comment "A specific type of activity or experimental protocol".

:ExperimentalProtocol a owl:Class ;
rdfs:label "ExperimentalProtocol" ;
rdfs:comment "A specific set of instructions or procedures for conducting an experiment".

:Subject a owl:Class ;
rdfs:label "Subject" ;
rdfs:comment "A person or entity participating in an experiment or study".

:Role a owl:Class ;
rdfs:label "Role" ;
rdfs:comment "A specific position or function within an experiment or study".

:Person a owl:Class ;
rdfs:label "Person" ;
rdfs:comment "A human observer or participant in an experiment or study".

:SensorMeasurement a owl:Class ;
rdfs:label "SensorMeasurement" ;
rdfs:comment "A specific measurement taken by a sensor".

:PPG a owl:Class ;
rdfs:label "PPG" ;
rdfs:comment "A specific type of physiological sensor measuring heart rate and rhythm".

:EDA a owl:Class ;
rdfs:label "EDA" ;
rdfs:comment "A specific type of physiological sensor measuring electrodermal activity".

:Temperature a owl:Class ;
rdfs:label "Temperature" ;
rdfs:comment "A specific type of physiological sensor measuring body temperature".

:Accelerometer a owl:Class ;
rdfs:label "Accelerometer" ;
rdfs:comment "A specific type of sensor measuring acceleration or movement".

:MeasurableProperty a owl:Class ;
rdfs:label "MeasurableProperty" ;
rdfs:comment "A specific type of property that can be measured by a sensor".

:PhysiologicalProperty a owl:Class ;
rdfs:label "PhysiologicalProperty" ;
rdfs:comment "A specific type of property related to physiological responses".

:BehavioralIndicator a owl:Class ;
rdfs:label "BehavioralIndicator" ;
rdfs:comment "A specific type of property related to behavioral responses".

:EnvironmentalFactor a owl:Class ;
rdfs:label "EnvironmentalFactor" ;
rdfs:comment "A specific type of property related to environmental conditions".

:Environment a owl:Class ;
rdfs:label "Environment" ;
rdfs:comment "A specific type of environment or setting".

:Metadata a owl:Class ;
rdfs:label "Metadata" ;
rdfs:comment "Additional information about a physiological record".

:PhysiologicalRecord a owl:Class ;
rdfs:label "PhysiologicalRecord" ;
rdfs:comment "A specific type of data structure storing physiological measurements".

:SignalChannelConnection a owl:Class ;
rdfs:label "SignalChannelConnection" ;
rdfs:comment "A specific type of connection between a signal channel and a physiological record".

:TimeSeriesObservation a owl:Class ;
rdfs:label "TimeSeriesObservation" ;
rdfs:comment "A specific type of observation representing a time-series of measurements".

:ObservationLink a owl:Class ;
rdfs:label "ObservationLink" ;
rdfs:comment "A specific type of connection between an observation and its source data".

:ActivityLink a owl:Class ;
rdfs:label "ActivityLink" ;
rdfs:comment "A specific type of connection between an activity and its associated stress conditions".

:MeasurementLink a owl:Class ;
rdfs:label "MeasurementLink" ;
rdfs:comment "A specific type of connection between a measurement and its associated activity or phase".

:Annotation a owl:Class ;
rdfs:label "Annotation" ;
rdfs:comment "A specific type of additional information or commentary about an activity or phase".

:AnnotationConnection a owl:Class ;
rdfs:label "AnnotationConnection" ;
rdfs:comment "A specific type of connection between an annotation and its associated activity or phase".

:Observer a owl:Class ;
rdfs:label "Observer" ;
rdfs:comment "A specific type of person or entity making an observation or annotation".

:HumanObserver a owl:Class ;
rdfs:label "HumanObserver" ;
rdfs:comment "A specific type of observer that is a human person".

:BiomarkerAssay a owl:Class ;
rdfs:label "BiomarkerAssay" ;
rdfs:comment "A specific type of biological or physiological measurement or test".

:ObservationLinkToBiomarkerAssay a owl:Class ;
rdfs:label "ObservationLinkToBiomarkerAssay" ;
rdfs:comment "A specific type of connection between an observation and a biomarker assay".

:TimeDocumentation a owl:Class ;
rdfs:label "TimeDocumentation" ;
rdfs:comment "A specific type of information about when a biomarker assay was performed".