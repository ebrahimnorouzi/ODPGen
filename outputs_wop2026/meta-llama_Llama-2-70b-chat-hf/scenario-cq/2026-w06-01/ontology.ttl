@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "PIIRRITE Ontology" ;
rdfs:comment "An ontology for inclusive-by-design pedestrian route planning".

:SpatialEntity a owl:Class ;
rdfs:label "Spatial Entity" ;
rdfs:comment "A physical location or space".

:TopologicalRelation a owl:Class ;
rdfs:label "Topological Relation" ;
rdfs:comment "A relationship between two or more SpatialEntities".

:NavigablePath a owl:Class ;
rdfs:label "Navigable Path" ;
rdfs:comment "A path that can be traversed by a pedestrian".

:PointOfInterest a owl:Class ;
rdfs:label "Point of Interest" ;
rdfs:comment "A location with a specific purpose or significance".

:ContextualProperty a owl:Class ;
rdfs:label "Contextual Property" ;
rdfs:comment "A property of a SpatialEntity that can be relevant to a user's preferences or requirements".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A user's need or preference for a specific ContextualProperty".

:UserProfile a owl:Class ;
rdfs:label "User Profile" ;
rdfs:comment "A collection of Requirements that define a user's preferences and needs".

:Condition a owl:Class ;
rdfs:label "Condition" ;
rdfs:comment "A logical statement that defines a relationship between a Requirement and a ContextualProperty".

:ComposedCondition a owl:Class ;
rdfs:label "Composed Condition" ;
rdfs:comment "A Condition composed of multiple Conditions".

:DistanceRequisite a owl:Class ;
rdfs:label "Distance Requisite" ;
rdfs:comment "A Condition that specifies a distance-related requirement".

:ComparisonOperator a owl:Class ;
rdfs:label "Comparison Operator" ;
rdfs:comment "An operator used to compare two values".

:LogicalOperator a owl:Class ;
rdfs:label "Logical Operator" ;
rdfs:comment "An operator used to combine multiple Conditions".

:TargetProperty a owl:Class ;
rdfs:label "Target Property" ;
rdfs:comment "A property of a SpatialEntity that is the target of a Requirement".

:ExpectedValue a owl:Class ;
rdfs:label "Expected Value" ;
rdfs:comment "A value expected by a user for a TargetProperty".

:PropertyValue a owl:Class ;
rdfs:label "Property Value" ;
rdfs:comment "A value associated with a TargetProperty".

:TemporalValidity a owl:Class ;
rdfs:label "Temporal Validity" ;
rdfs:comment "A constraint on the validity of a PropertyValue".

:TemporalInterval a owl:Class ;
rdfs:label "Temporal Interval" ;
rdfs:comment "A specific time period during which a PropertyValue is valid".