@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Software Reverse Engineering Ontology" ;
rdfs:comment "An ontology for representing knowledge about software reverse engineering".

:Function a owl:Class ;
rdfs:label "Function" ;
rdfs:comment "A function in a binary executable".

:Variable a owl:Class ;
rdfs:label "Variable" ;
rdfs:comment "A variable in a binary executable".

:APICall a owl:Class ;
rdfs:label "APICall" ;
rdfs:comment "An API call in a binary executable".

:ControlFlow a owl:Class ;
rdfs:label "ControlFlow" ;
rdfs:comment "A control flow pattern in a binary executable".

:Entropy a owl:Class ;
rdfs:label "Entropy" ;
rdfs:comment "A measure of the entropy of a function".

:Obfuscation a owl:Class ;
rdfs:label "Obfuscation" ;
rdfs:comment "A pattern of data obfuscation in a binary executable".

:FileSystem a owl:Class ;
rdfs:label "FileSystem" ;
rdfs:comment "A file system operation in a binary executable".

:Networking a owl:Class ;
rdfs:label "Networking" ;
rdfs:comment "A networking activity in a binary executable".

:Cryptography a owl:Class ;
rdfs:label "Cryptography" ;
rdfs:comment "A cryptographic activity in a binary executable".

:ImportedFunction a owl:Class ;
rdfs:label "ImportedFunction" ;
rdfs:comment "A function that is imported from another module".

:Symbol a owl:Class ;
rdfs:label "Symbol" ;
rdfs:comment "A symbol in a binary executable".

:Label a owl:Class ;
rdfs:label "Label" ;
rdfs:comment "A label in a binary executable".

:Comment a owl:Class ;
rdfs:label "Comment" ;
rdfs:comment "A comment in a binary executable".

:BinaryExecutable a owl:Class ;
rdfs:label "BinaryExecutable" ;
rdfs:comment "A binary executable".

:SoftwareSupplyChain a owl:Class ;
rdfs:label "SoftwareSupplyChain" ;
rdfs:comment "A software supply chain".

:Malware a owl:Class ;
rdfs:label "Malware" ;
rdfs:comment "Malware in a software supply chain".

:Vulnerability a owl:Class ;
rdfs:label "Vulnerability" ;
rdfs:comment "A vulnerability in a software supply chain".

:Dependency a owl:Class ;
rdfs:label "Dependency" ;
rdfs:comment "A dependency between two software components".

:Behavior a owl:Class ;
rdfs:label "Behavior" ;
rdfs:comment "A behavior of a software component".

:Artifact a owl:Class ;
rdfs:label "Artifact" ;
rdfs:comment "An artifact in a software supply chain".

:ExecutableFile a owl:Class ;
rdfs:label "ExecutableFile" ;
rdfs:comment "An executable file".

:SymbolTable a owl:Class ;
rdfs:label "SymbolTable" ;
rdfs:comment "A symbol table in a binary executable".

:ReverseEngineering a owl:Class ;
rdfs:label "ReverseEngineering" ;
rdfs:comment "The process of reverse engineering a binary executable".

:KnowledgeGraph a owl:Class ;
rdfs:label "KnowledgeGraph" ;
rdfs:comment "A knowledge graph representing the relationships between symbols in a binary executable".

:User a owl:Class ;
rdfs:label "User" ;
rdfs:comment "A user of the reverse engineering tool".

:Renaming a owl:Class ;
rdfs:label "Renaming" ;
rdfs:comment "The act of renaming a label or variable in a binary executable".

:Visualization a owl:Class ;
rdfs:label "Visualization" ;
rdfs:comment "The visualization of the relationships between symbols in a binary executable".

:Understanding a owl:Class ;
rdfs:label "Understanding" ;
rdfs:comment "The understanding of how a program executable works".

:Detection a owl:Class ;
rdfs:label "Detection" ;
rdfs:comment "The detection of malicious or vulnerable code in a binary executable".

:Analysis a owl:Class ;
rdfs:label "Analysis" ;
rdfs:comment "The analysis of a binary executable".

:Result a owl:Class ;
rdfs:label "Result" ;
rdfs:comment "The result of the analysis of a binary executable".