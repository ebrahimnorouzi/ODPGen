@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "SMARTY Matchmaker Ontology" ;
rdfs:comment "An ontology for matching software and hardware resources in a heterogeneous edge computing environment.".

:Software a owl:Class ;
rdfs:label "Software" ;
rdfs:comment "A software component.".

:Hardware a owl:Class ;
rdfs:label "Hardware" ;
rdfs:comment "A hardware component.".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement expressed for a software.".

:Characteristic a owl:Class ;
rdfs:label "Characteristic" ;
rdfs:comment "A characteristic of a software or hardware resource.".

:Match a owl:Class ;
rdfs:label "Match" ;
rdfs:comment "A match between a software and a hardware resource.".

:softwareRequirement a owl:ObjectProperty ;
rdfs:label "softwareRequirement" ;
rdfs:comment "A requirement expressed for a software.".

:hardwareRequirement a owl:ObjectProperty ;
rdfs:label "hardwareRequirement" ;
rdfs:comment "A requirement expressed for a hardware resource.".

:resourceType a owl:DatatypeProperty ;
rdfs:label "resourceType" ;
rdfs:comment "The type of a software or hardware resource.".

:resourceVersion a owl:DatatypeProperty ;
rdfs:label "resourceVersion" ;
rdfs:comment "The version of a software resource.".

:matchScore a owl:DatatypeProperty ;
rdfs:label "matchScore" ;
rdfs:comment "A score indicating the quality of a match.".

:SoftwareRequirement a owl:Class ;
rdfs:label "SoftwareRequirement" ;
rdfs:comment "A requirement expressed for a software.".

:HardwareRequirement a owl:Class ;
rdfs:label "HardwareRequirement" ;
rdfs:comment "A requirement expressed for a hardware resource.".

:Resource a owl:Class ;
rdfs:label "Resource" ;
rdfs:comment "A software or hardware resource.".

:match a owl:ObjectProperty ;
rdfs:label "match" ;
rdfs:comment "A match between a software and a hardware resource.".

:software a owl:ObjectProperty ;
rdfs:label "software" ;
rdfs:comment "A software component.".

:hardware a owl:ObjectProperty ;
rdfs:label "hardware" ;
rdfs:comment "A hardware component.".

:requirement a owl:ObjectProperty ;
rdfs:label "requirement" ;
rdfs:comment "A requirement expressed for a software or hardware resource.".

:characteristic a owl:ObjectProperty ;
rdfs:label "characteristic" ;
rdfs:comment "A characteristic of a software or hardware resource.".