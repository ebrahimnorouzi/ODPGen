@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Prompting Technique Ontology" ;
rdfs:comment "An ontology for representing prompting techniques, tasks, and their relationships.".

:Task a owl:Class ;
rdfs:label "Task" ;
rdfs:comment "A task that can be solved using a prompting technique.".

:DataModality a owl:Class ;
rdfs:label "Data Modality" ;
rdfs:comment "A data modality that can be processed by a foundation model.".

:FoundationModel a owl:Class ;
rdfs:label "Foundation Model" ;
rdfs:comment "A model that can be used to solve a task.".

:PromptingTechnique a owl:Class ;
rdfs:label "Prompting Technique" ;
rdfs:comment "A technique for prompting a foundation model.".

:Constraint a owl:Class ;
rdfs:label "Constraint" ;
rdfs:comment "A constraint that must be satisfied by a foundation model.".

:ModelArchitecture a owl:Class ;
rdfs:label "Model Architecture" ;
rdfs:comment "The architecture of a foundation model.".

:Variant a owl:Class ;
rdfs:label "Variant" ;
rdfs:comment "A variant of a foundation model.".

:Evolution a owl:Class ;
rdfs:label "Evolution" ;
rdfs:comment "An evolution of a foundation model.".

:Prompt a owl:Class ;
rdfs:label "Prompt" ;
rdfs:comment "A prompt that can be used to solve a task.".

:Response a owl:Class ;
rdfs:label "Response" ;
rdfs:comment "A response to a prompt.".

:Chat a owl:Class ;
rdfs:label "Chat" ;
rdfs:comment "A conversation between a human and a foundation model.".

:ConversationLength a owl:DataProperty ;
rdfs:label "Conversation Length" ;
rdfs:comment "The length of a chat.".

:PromptFrequency a owl:DataProperty ;
rdfs:label "Prompt Frequency" ;
rdfs:comment "The frequency of a prompt in a chat.".

:ResponseStatistics a owl:DataProperty ;
rdfs:label "Response Statistics" ;
rdfs:comment "Statistics on the responses to a prompt.".

:SuitablePromptingTechnique a owl:ObjectProperty ;
rdfs:label "Suitable Prompting Technique" ;
rdfs:comment "A prompting technique that is suitable for a given task.".

:SuitableFoundationModel a owl:ObjectProperty ;
rdfs:label "Suitable Foundation Model" ;
rdfs:comment "A foundation model that is suitable for a given task.".

:SuitableDataModality a owl:ObjectProperty ;
rdfs:label "Suitable Data Modality" ;
rdfs:comment "A data modality that can be processed by a given foundation model.".

:SuitableConstraint a owl:ObjectProperty ;
rdfs:label "Suitable Constraint" ;
rdfs:comment "A constraint that must be satisfied by a given foundation model.".

:SuitableModelArchitecture a owl:ObjectProperty ;
rdfs:label "Suitable Model Architecture" ;
rdfs:comment "A model architecture that is suitable for a given task.".

:SuitableVariant a owl:ObjectProperty ;
rdfs:label "Suitable Variant" ;
rdfs:comment "A variant of a foundation model that is suitable for a given task.".

:SuitableEvolution a owl:ObjectProperty ;
rdfs:label "Suitable Evolution" ;
rdfs:comment "An evolution of a foundation model that is suitable for a given task.".