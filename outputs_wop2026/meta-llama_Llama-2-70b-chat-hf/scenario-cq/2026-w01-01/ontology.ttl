@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "LCAnet Ontology" ;
rdfs:comment "An ontology for LCA studies".

:LCAStudy a owl:Class ;
rdfs:label "LCA Study" ;
rdfs:comment "A study conducted using the EIME software tool".

:Prototype a owl:Class ;
rdfs:label "Prototype" ;
rdfs:comment "A Near Memory Computing prototype based on C-SRAM technology".

:BillOfMaterials a owl:Class ;
rdfs:label "Bill of Materials" ;
rdfs:comment "A list of electronic components".

:InventoryData a owl:Class ;
rdfs:label "Inventory Data" ;
rdfs:comment "Data sourced from two databases: CODDE and NegaOctet".

:EnvironmentalImpact a owl:Class ;
rdfs:label "Environmental Impact" ;
rdfs:comment "Calculations performed using the Environmental Footprint 3.0 methodology".

:InputFlow a owl:Class ;
rdfs:label "Input Flow" ;
rdfs:comment "Flows into an activity".

:OutputFlow a owl:Class ;
rdfs:label "Output Flow" ;
rdfs:comment "Flows out of an activity".

:DependencyChain a owl:Class ;
rdfs:label "Dependency Chain" ;
rdfs:comment "Activities and their dependencies".

:FlowDataset a owl:Class ;
rdfs:label "Flow Dataset" ;
rdfs:comment "Datasets from database X".

:ElementaryFlow a owl:Class ;
rdfs:label "Elementary Flow" ;
rdfs:comment "A flow that is not further divisible".

:IntermediateFlow a owl:Class ;
rdfs:label "Intermediate Flow" ;
rdfs:comment "A flow that is derived from other flows".

:ResourceFlow a owl:Class ;
rdfs:label "Resource Flow" ;
rdfs:comment "A flow that represents a resource".

:EmissionFlow a owl:Class ;
rdfs:label "Emission Flow" ;
rdfs:comment "A flow that represents an emission".

:ProductFlow a owl:Class ;
rdfs:label "Product Flow" ;
rdfs:comment "A flow that represents a product".

:FunctionalUnit a owl:Class ;
rdfs:label "Functional Unit" ;
rdfs:comment "A unit of measure for the study".

:Scope a owl:Class ;
rdfs:label "Scope" ;
rdfs:comment "The system boundary of the study".

:ResponsibleAgent a owl:Class ;
rdfs:label "Responsible Agent" ;
rdfs:comment "The actor responsible for the study".

:ImpactResult a owl:Class ;
rdfs:label "Impact Result" ;
rdfs:comment "The result of the environmental impact calculation".

:Contributor a owl:Class ;
rdfs:label "Contributor" ;
rdfs:comment "A flow that contributes to an impact category".

:TopContributor a owl:Class ;
rdfs:label "Top Contributor" ;
rdfs:comment "A flow that is among the top contributors to an impact category".

:TotalFlow a owl:Class ;
rdfs:label "Total Flow" ;
rdfs:comment "The total amount of a flow generated within the system boundary".

:LCAStudy
rdfs:subClassOf :Prototype.

:Prototype
rdfs:subClassOf :BillOfMaterials.

:BillOfMaterials
rdfs:subClassOf :InventoryData.

:InventoryData
rdfs:subClassOf :EnvironmentalImpact.

:InputFlow
rdfs:subClassOf :DependencyChain.

:OutputFlow
rdfs:subClassOf :DependencyChain.

:DependencyChain
rdfs:subClassOf :LCAStudy.

:FlowDataset
rdfs:subClassOf :InventoryData.

:ElementaryFlow
rdfs:subClassOf :FlowDataset.

:IntermediateFlow
rdfs:subClassOf :FlowDataset.

:ResourceFlow
rdfs:subClassOf :IntermediateFlow.

:EmissionFlow
rdfs:subClassOf :IntermediateFlow.

:ProductFlow
rdfs:subClassOf :IntermediateFlow.

:FunctionalUnit
rdfs:subClassOf :LCAStudy.

:Scope
rdfs:subClassOf :LCAStudy.

:ResponsibleAgent
rdfs:subClassOf :LCAStudy.

:ImpactResult
rdfs:subClassOf :EnvironmentalImpact.

:Contributor
rdfs:subClassOf :ImpactResult.

:TopContributor
rdfs:subClassOf :Contributor.

:TotalFlow
rdfs:subClassOf :FlowDataset.