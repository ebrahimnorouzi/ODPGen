@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "APLO Ontology" ;
  rdfs:comment "An ontology for representing pedagogical organization, including frameworks, elements, and their order, objective alignment, evaluation, feedback, learner context, and learner awareness.".

### Classes

:Framework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A pedagogical framework is a structured approach to organizing and delivering instructional content.".

:Element a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "A pedagogical element is a component of a pedagogical framework that represents a specific instructional strategy or technique.".

:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A learning objective is a specific skill or knowledge area that a learner should achieve.".

:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A pedagogical technique is a specific method or approach used to support learner progress toward a learning objective.".

:Evaluation a owl:Class ;
  rdfs:label "Evaluation" ;
  rdfs:comment "An evaluation is a systematic assessment of learner progress toward a learning objective.".

:Feedback a owl:Class ;
  rdfs:label "Feedback" ;
  rdfs:comment "Feedback is a response to learner performance that provides guidance or direction for future learning.".

:Learner a owl:Class ;
  rdfs:label "Learner" ;
  rdfs:comment "A learner is an individual who is engaged in the learning process.".

:LearnerContext a owl:Class ;
  rdfs:label "Learner Context" ;
  rdfs:comment "Learner context refers to the information and circumstances that surround a learner's learning experience.".

:LearnerAwareness a owl:Class ;
  rdfs:label "Learner Awareness" ;
  rdfs:comment "Learner awareness refers to the learner's understanding of their own knowledge and skill levels.".

### Object Properties

:hasFramework a owl:ObjectProperty ;
  rdfs:label "has framework" ;
  rdfs:comment "A learning objective has a framework that provides a structured approach to organizing and delivering instructional content.".

:isAlignedWith a owl:ObjectProperty ;
  rdfs:label "is aligned with" ;
  rdfs:comment "A learning objective is aligned with a pedagogical framework, which provides a structured approach to organizing and delivering instructional content.".

:hasElement a owl:ObjectProperty ;
  rdfs:label "has element" ;
  rdfs:comment "A pedagogical framework has elements that represent specific instructional strategies or techniques.".

:usesTechnique a owl:ObjectProperty ;
  rdfs:label "uses technique" ;
  rdfs:comment "A learning objective uses a pedagogical technique, which is a specific method or approach used to support learner progress.".

:isEvaluatedBy a owl:ObjectProperty ;
  rdfs:label "is evaluated by" ;
  rdfs:comment "A learning objective is evaluated by an evaluation, which is a systematic assessment of learner progress.".

:receivesFeedback a owl:ObjectProperty ;
  rdfs:label "receives feedback" ;
  rdfs:comment "A learning objective receives feedback, which is a response to learner performance that provides guidance or direction for future learning.".

:hasLearner a owl:ObjectProperty ;
  rdfs:label "has learner" ;
  rdfs:comment "A learning objective has a learner, who is an individual engaged in the learning process.".

:isInContext a owl:ObjectProperty ;
  rdfs:label "is in context" ;
  rdfs:comment "A learning objective is in context, which refers to the information and circumstances that surround a learner's learning experience.".

:hasAwareness a owl:ObjectProperty ;
  rdfs:label "has awareness" ;
  rdfs:comment "A learning objective has awareness, which refers to the learner's understanding of their own knowledge and skill levels.".

### Data Properties

:hasName a owl:DataProperty ;
  rdfs:label "has name" ;
  rdfs:comment "A learning objective has a name that identifies it.".

:hasDescription a owl:DataProperty ;
  rdfs:label "has description" ;
  rdfs:comment "A learning objective has a description that provides additional information about the objective.".

:hasType a owl:DataProperty ;
  rdfs:label "has type" ;
  rdfs:comment "A learning objective has a type that categorizes it according to its purpose or focus.".

:hasDifficulty a owl:DataProperty ;
  rdfs:label "has difficulty" ;
  rdfs:comment "A learning objective has difficulty, which reflects the complexity or challenge of the objective.".

:hasPriority a owl:DataProperty ;
  rdfs:label "has priority" ;
  rdfs:comment "A learning objective has priority, which reflects the importance or urgency of the objective.".

:hasStatus a owl:DataProperty ;
  rdfs:label "has status" ;
  rdfs:comment "A learning objective has status, which reflects the current state of the objective.".

### Individuals

:LearningObjective1 a LearningObjective ;
  hasName "Understand the basics of algebra" ;
  hasDescription "Learners will understand the fundamental concepts of algebra, including variables, equations, and functions." ;
  hasType "knowledge" ;
  hasDifficulty "easy" ;
  hasPriority "high" ;
  hasStatus "in progress".

:LearningObjective2 a LearningObjective ;
  hasName "Solve linear equations" ;
  hasDescription "Learners will be able to solve linear equations, including systems of linear equations." ;
  hasType "skill" ;
  hasDifficulty "medium" ;
  hasPriority "high" ;
  hasStatus "in progress".

:LearningObjective3 a LearningObjective ;
  hasName "Graph functions" ;
  hasDescription "Learners will be able to graph functions, including linear and nonlinear functions." ;
  hasType "skill" ;
  hasDifficulty "medium" ;
  hasPriority "high" ;
  hasStatus "in progress".

:Framework1 a Framework ;
  hasName "Linear Algebra" ;
  hasDescription "A framework for teaching linear algebra, including concepts, techniques, and applications." ;
  hasElement ( :Element1, :Element2, :Element3 ).

:Framework2 a Framework ;
  hasName "Calculus" ;
  hasDescription "A framework for teaching calculus, including concepts, techniques, and applications." ;
  hasElement ( :Element4, :Element5, :Element6 ).

:Learner1 a Learner ;
  hasName "John" ;
  hasLearnerContext ( :LearnerContext1 ).

:LearnerContext1 a LearnerContext ;
  hasName "Online course" ;
  hasDescription "An online course that provides instruction and practice in algebra and calculus.".

:LearningObjective1 hasFramework ( :Framework1 ).
:LearningObjective2 hasFramework ( :Framework1 ).
:LearningObjective3 hasFramework ( :Framework2 ).

:Learner1 hasLearningObjective ( :LearningObjective1, :LearningObjective2, :LearningObjective3 ).

