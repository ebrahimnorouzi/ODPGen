@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Malicious Code Detection Ontology" ;
rdfs:comment "An ontology for detecting malicious code in executables".

:MaliciousCode a owl:Class ;
rdfs:label "Malicious Code" ;
rdfs:comment "A class representing malicious code in an executable".

:PersistentAPICall a owl:Class ;
rdfs:label "Persistent API Call" ;
rdfs:comment "A class representing a persistent API call in an executable".

:SuspiciousNetworkingActivity a owl:Class ;
rdfs:label "Suspicious Networking Activity" ;
rdfs:comment "A class representing suspicious networking activity in an executable".

:IndirectControlFlowPattern a owl:Class ;
rdfs:label "Indirect Control Flow Pattern" ;
rdfs:comment "A class representing an indirect control flow pattern in an executable".

:EntropyRatio a owl:Class ;
rdfs:label "Entropy Ratio" ;
rdfs:comment "A class representing the ratio of unique opcodes to the total number of instructions in a function".

:SelfReferentialDecodeLoop a owl:Class ;
rdfs:label "Self-Referential Decode Loop" ;
rdfs:comment "A class representing a self-referential decode loop in an executable".

:FileSystemAbuse a owl:Class ;
rdfs:label "File System Abuse" ;
rdfs:comment "A class representing file system abuse in an executable".

:SuspiciousJumpIntoMemory a owl:Class ;
rdfs:label "Suspicious Jump Into Memory" ;
rdfs:comment "A class representing a suspicious jump into memory in an executable".

:SuspiciousAPICall a owl:Class ;
rdfs:label "Suspicious API Call" ;
rdfs:comment "A class representing a suspicious API call in an executable".

:CryptographicActivity a owl:Class ;
rdfs:label "Cryptographic Activity" ;
rdfs:comment "A class representing cryptographic activity in an executable".

:ImportedFunction a owl:Class ;
rdfs:label "Imported Function" ;
rdfs:comment "A class representing an imported function in an executable".

:Function a owl:Class ;
rdfs:label "Function" ;
rdfs:comment "A class representing a function in an executable".

:MaliciousCode a owl:ObjectProperty ;
rdfs:label "hasMaliciousCode" ;
rdfs:comment "A property representing the presence of malicious code in an executable".

:PersistentAPICall a owl:ObjectProperty ;
rdfs:label "hasPersistentAPICall" ;
rdfs:comment "A property representing a persistent API call in an executable".

:SuspiciousNetworkingActivity a owl:ObjectProperty ;
rdfs:label "hasSuspiciousNetworkingActivity" ;
rdfs:comment "A property representing suspicious networking activity in an executable".

:IndirectControlFlowPattern a owl:ObjectProperty ;
rdfs:label "hasIndirectControlFlowPattern" ;
rdfs:comment "A property representing an indirect control flow pattern in an executable".

:EntropyRatio a owl:ObjectProperty ;
rdfs:label "hasEntropyRatio" ;
rdfs:comment "A property representing the ratio of unique opcodes to the total number of instructions in a function".

:SelfReferentialDecodeLoop a owl:ObjectProperty ;
rdfs:label "hasSelfReferentialDecodeLoop" ;
rdfs:comment "A property representing a self-referential decode loop in an executable".

:FileSystemAbuse a owl:ObjectProperty ;
rdfs:label "hasFileSystemAbuse" ;
rdfs:comment "A property representing file system abuse in an executable".

:SuspiciousJumpIntoMemory a owl:ObjectProperty ;
rdfs:label "hasSuspiciousJumpIntoMemory" ;
rdfs:comment "A property representing a suspicious jump into memory in an executable".

:SuspiciousAPICall a owl:ObjectProperty ;
rdfs:label "hasSuspiciousAPICall" ;
rdfs:comment "A property representing a suspicious API call in an executable".

:CryptographicActivity a owl:ObjectProperty ;
rdfs:label "hasCryptographicActivity" ;
rdfs:comment "A property representing cryptographic activity in an executable".

:ImportedFunction a owl:ObjectProperty ;
rdfs:label "hasImportedFunction" ;
rdfs:comment "A property representing an imported function in an executable".

:Function a owl:ObjectProperty ;
rdfs:label "hasFunction" ;
rdfs:comment "A property representing a function in an executable".