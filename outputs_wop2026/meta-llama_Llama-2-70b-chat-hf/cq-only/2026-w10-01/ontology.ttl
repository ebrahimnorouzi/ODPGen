@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ; rdfs:label "Software/Hardware Requirement Ontology" ; rdfs:comment "An ontology for representing software and hardware requirements.".

:Software a owl:Class ; rdfs:label "Software" ; rdfs:comment "A software system.".
:Hardware a owl:Class ; rdfs:label "Hardware" ; rdfs:comment "A hardware component.".

:Requirement a owl:Class ; rdfs:label "Requirement" ; rdfs:comment "A requirement of a software or hardware system.".
:SoftwareRequirement a owl:Class ; rdfs:label "SoftwareRequirement" ; rdfs:comment "A requirement of a software system.".
:HardwareRequirement a owl:Class ; rdfs:label "HardwareRequirement" ; rdfs:comment "A requirement of a hardware component.".

:hasRequirement a owl:ObjectProperty ; rdfs:label "hasRequirement" ; rdfs:comment "A software or hardware system has a requirement.".
:reqires a owl:ObjectProperty ; rdfs:label "reqires" ; rdfs:comment "A software or hardware system requires a software or hardware component.".
:hasVersion a owl:DatatypeProperty ; rdfs:label "hasVersion" ; rdfs:comment "A software system has a version.".
:version a owl:DatatypeProperty ; rdfs:label "version" ; rdfs:comment "The version of a software system.".
:hasMinimumVersion a owl:DatatypeProperty ; rdfs:label "hasMinimumVersion" ; rdfs:comment "A software system has a minimum version.".
:minimumVersion a owl:DatatypeProperty ; rdfs:label "minimumVersion" ; rdfs:comment "The minimum version of a software system.".
:hasMaximumVersion a owl:DatatypeProperty ; rdfs:label "hasMaximumVersion" ; rdfs:comment "A software system has a maximum version.".
:maximumVersion a owl:DatatypeProperty ; rdfs:label "maximumVersion" ; rdfs:comment "The maximum version of a software system.".
:hasExactVersion a owl:DatatypeProperty ; rdfs:label "hasExactVersion" ; rdfs:comment "A software system has an exact version.".
:exactVersion a owl:DatatypeProperty ; rdfs:label "exactVersion" ; rdfs:comment "The exact version of a software system.".

:SoftwareRequirement rdfs:subClassOf :Requirement.
:HardwareRequirement rdfs:subClassOf :Requirement.
:Software rdfs:subClassOf :HasRequirement.
:Hardware rdfs:subClassOf :HasRequirement.

:hasRequirement rdfs:domain :Software ; rdfs:range :Requirement.
:hasRequirement rdfs:domain :Hardware ; rdfs:range :Requirement.
:reqires rdfs:domain :Requirement ; rdfs:range :Software.
:reqires rdfs:domain :Requirement ; rdfs:range :Hardware.
:hasVersion rdfs:domain :Software ; rdfs:range xsd:string.
:version rdfs:domain :Software ; rdfs:range xsd:string.
:hasMinimumVersion rdfs:domain :Software ; rdfs:range xsd:string.
:minimumVersion rdfs:domain :Software ; rdfs:range xsd:string.
:hasMaximumVersion rdfs:domain :Software ; rdfs:range xsd:string.
:maximumVersion rdfs:domain :Software ; rdfs:range xsd:string.
:hasExactVersion rdfs:domain :Software ; rdfs:range xsd:string.
:exactVersion rdfs:domain :Software ; rdfs:range xsd:string.