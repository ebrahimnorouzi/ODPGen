@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "LCA Model Ontology" ;
rdfs:comment "An ontology for describing LCA models".

:Activity a owl:Class ;
rdfs:label "Activity" ;
rdfs:comment "Represents an activity in an LCA model".

:Flow a owl:Class ;
rdfs:label "Flow" ;
rdfs:comment "Represents a flow in an LCA model".

:InputFlow a owl:ObjectProperty ;
rdfs:label "input flow" ;
rdfs:comment "The input flow of an activity".

:OutputFlow a owl:ObjectProperty ;
rdfs:label "output flow" ;
rdfs:comment "The output flow of an activity".

:Dependency a owl:ObjectProperty ;
rdfs:label "dependency" ;
rdfs:comment "The dependency relationship between activities".

:Dataset a owl:Class ;
rdfs:label "Dataset" ;
rdfs:comment "Represents a dataset in an LCA model".

:FlowDataset a owl:ObjectProperty ;
rdfs:label "flow dataset" ;
rdfs:comment "The dataset associated with a flow".

:ElementaryFlow a owl:Class ;
rdfs:label "Elementary Flow" ;
rdfs:comment "Represents an elementary flow in an LCA model".

:IntermediateFlow a owl:Class ;
rdfs:label "Intermediate Flow" ;
rdfs:comment "Represents an intermediate flow in an LCA model".

:ResourceFlow a owl:Class ;
rdfs:label "Resource Flow" ;
rdfs:comment "Represents a resource flow in an LCA model".

:EmissionFlow a owl:Class ;
rdfs:label "Emission Flow" ;
rdfs:comment "Represents an emission flow in an LCA model".

:ProductFlow a owl:Class ;
rdfs:label "Product Flow" ;
rdfs:comment "Represents a product flow in an LCA model".

:FunctionalUnit a owl:Class ;
rdfs:label "Functional Unit" ;
rdfs:comment "Represents the functional unit of an LCA model".

:Scope a owl:Class ;
rdfs:label "Scope" ;
rdfs:comment "Represents the scope of an LCA model".

:SystemBoundary a owl:Class ;
rdfs:label "System Boundary" ;
rdfs:comment "Represents the system boundary of an LCA model".

:ResponsibleAgent a owl:Class ;
rdfs:label "Responsible Agent" ;
rdfs:comment "Represents the responsible agent of an LCA model".

:ImpactResult a owl:Class ;
rdfs:label "Impact Result" ;
rdfs:comment "Represents the impact result of an LCA model".

:Contributor a owl:Class ;
rdfs:label "Contributor" ;
rdfs:comment "Represents a contributor to an impact category".

:FlowContribution a owl:ObjectProperty ;
rdfs:label "flow contribution" ;
rdfs:comment "The contribution of a flow to an impact category".

:TotalFlow a owl:ObjectProperty ;
rdfs:label "total flow" ;
rdfs:comment "The total amount of a flow generated within the system boundary".