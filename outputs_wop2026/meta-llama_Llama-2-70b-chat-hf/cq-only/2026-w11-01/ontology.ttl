@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Stress and Physiological Response Ontology" ;
rdfs:comment "An ontology for describing stress and physiological responses.".

# Classes
:StressRelatedCondition a owl:Class ;
rdfs:label "Stress-related condition" ;
rdfs:comment "A condition that is related to stress.".

:Stressor a owl:Class ;
rdfs:label "Stressor" ;
rdfs:comment "A stimulus that causes stress.".

:ShortTermStressor a owl:Class ;
rdfs:label "Short-term stressor" ;
rdfs:comment "A stressor that has a short-term impact.".

:PhysiologicalResponse a owl:Class ;
rdfs:label "Physiological response" ;
rdfs:comment "A response to stress that can be measured physiologically.".

:BaselineOrRecoveryState a owl:Class ;
rdfs:label "Baseline or recovery state" ;
rdfs:comment "A state that is either a baseline or recovery state.".

:Activity a owl:Class ;
rdfs:label "Activity" ;
rdfs:comment "An activity that can be described.".

:ExperimentalPhase a owl:Class ;
rdfs:label "Experimental phase" ;
rdfs:comment "A phase of an experiment.".

:Person a owl:Class ;
rdfs:label "Person" ;
rdfs:comment "A person who can perform an activity or be a subject.".

:Subject a owl:Class ;
rdfs:label "Subject" ;
rdfs:comment "A subject who can be measured.".

:Sensor a owl:Class ;
rdfs:label "Sensor" ;
rdfs:comment "A device that can measure physiological or environmental data.".

:PPG a owl:Class ;
rdfs:label "PPG" ;
rdfs:comment "A photoplethysmography sensor.".

:EDA a owl:Class ;
rdfs:label "EDA" ;
rdfs:comment "An electrodermal activity sensor.".

:TemperatureSensor a owl:Class ;
rdfs:label "Temperature sensor" ;
rdfs:comment "A sensor that measures temperature.".

:Accelerometer a owl:Class ;
rdfs:label "Accelerometer" ;
rdfs:comment "A device that measures acceleration.".

:MeasurementPlatform a owl:Class ;
rdfs:label "Measurement platform" ;
rdfs:comment "A device or platform that can be used to measure physiological or environmental data.".

# Properties
:hasStressor a owl:ObjectProperty ;
rdfs:label "has stressor" ;
rdfs:comment "A relationship between a stress-related condition and a stressor.".

:hasPhysiologicalResponse a owl:ObjectProperty ;
rdfs:label "has physiological response" ;
rdfs:comment "A relationship between a stress-related condition and a physiological response.".

:hasBaselineOrRecoveryState a owl:ObjectProperty ;
rdfs:label "has baseline or recovery state" ;
rdfs:comment "A relationship between a stress-related condition and a baseline or recovery state.".

:isAssociatedWith a owl:ObjectProperty ;
rdfs:label "is associated with" ;
rdfs:comment "A relationship between a stressor and an activity or experimental phase.".

:canPerform a owl:ObjectProperty ;
rdfs:label "can perform" ;
rdfs:comment "A relationship between a person and an activity.".

:isMeasuredBy a owl:ObjectProperty ;
rdfs:label "is measured by" ;
rdfs:comment "A relationship between a subject and a sensor.".

:measures a owl:ObjectProperty ;
rdfs:label "measures" ;
rdfs:comment "A relationship between a sensor and a physiological or environmental property.".

:hasMetadata a owl:ObjectProperty ;
rdfs:label "has metadata" ;
rdfs:comment "A relationship between a physiological record and metadata.".

:isConnectedTo a owl:ObjectProperty ;
rdfs:label "is connected to" ;
rdfs:comment "A relationship between a physiological record and its signal channels.".

:hasSignalChannel a owl:ObjectProperty ;
rdfs:label "has signal channel" ;
rdfs:comment "A relationship between a physiological record and a signal channel.".

:indicates a owl:ObjectProperty ;
rdfs:label "indicates" ;
rdfs:comment "A relationship between a signal channel and what it measures.".

:canBeTracedBackTo a owl:ObjectProperty ;
rdfs:label "can be traced back to" ;
rdfs:comment "A relationship between an observation and its source data.".

:isAssignedTo a owl:ObjectProperty ;
rdfs:label "is assigned to" ;
rdfs:comment "A relationship between an observation and the activity or phase during which it was made.".

:linksTo a owl:ObjectProperty ;
rdfs:label "links to" ;
rdfs:comment "A relationship between a measurement and the activity or phase during which it was made.".

:hasAnnotation a owl:ObjectProperty ;
rdfs:label "has annotation" ;
rdfs:comment "A relationship between an activity or phase and an annotation.".

:isAssignedToAnnotator a owl:ObjectProperty ;
rdfs:label "is assigned to annotator" ;
rdfs:comment "A relationship between an annotation and the person who created it.".

:canBeLinkedTo a owl:ObjectProperty ;
rdfs:label "can be linked to" ;
rdfs:comment "A relationship between an observation and a biomarker assay.".

:hasObservation a owl:ObjectProperty ;
rdfs:label "has observation" ;
rdfs:comment "A relationship between a biomarker assay and an observation.".

:canBeDocumented a owl:ObjectProperty ;
rdfs:label "can be documented" ;
rdfs:comment "A relationship between a biomarker assay and a time point.".