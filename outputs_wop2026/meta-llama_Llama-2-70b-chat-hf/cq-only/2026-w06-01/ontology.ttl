@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "PIIRRITE Ontology" ;
rdfs:comment "Ontology for PIIRRITE".

:SpatialEntity a owl:Class ;
rdfs:label "Spatial Entity" ;
rdfs:comment "A physical entity with a location in space".

:NavigablePath a owl:Class ;
rdfs:label "Navigable Path" ;
rdfs:comment "A path that can be traversed by a user".

:PointOfInterest a owl:Class ;
rdfs:label "Point of Interest" ;
rdfs:comment "A location with a specific interest or significance".

:TopologicalRelation a owl:Class ;
rdfs:label "Topological Relation" ;
rdfs:comment "A relationship between two spatial entities".

:Polyline a owl:Class ;
rdfs:label "Polyline" ;
rdfs:comment "A polyline is a sequence of points in space".

:Property a owl:Class ;
rdfs:label "Property" ;
rdfs:comment "A characteristic or attribute of a spatial entity".

:Value a owl:Class ;
rdfs:label "Value" ;
rdfs:comment "A specific value of a property".

:ContextualProperty a owl:Class ;
rdfs:label "Contextual Property" ;
rdfs:comment "A property that is dependent on the context in which it is used".

:TemporalValidity a owl:Class ;
rdfs:label "Temporal Validity" ;
rdfs:comment "A constraint on the validity of a contextual property value".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement of a user".

:Condition a owl:Class ;
rdfs:label "Condition" ;
rdfs:comment "A condition that must be met for a requirement to be fulfilled".

:ComposedCondition a owl:Class ;
rdfs:label "Composed Condition" ;
rdfs:comment "A condition composed of multiple conditions".

:DistanceRequisite a owl:Class ;
rdfs:label "Distance Requisite" ;
rdfs:comment "A requirement related to distance".

:UserProfile a owl:Class ;
rdfs:label "User Profile" ;
rdfs:comment "A profile of a user's requirements".

:ExpectedValue a owl:Class ;
rdfs:label "Expected Value" ;
rdfs:comment "A expected value of a property".

:ComparisonOperator a owl:Class ;
rdfs:label "Comparison Operator" ;
rdfs:comment "An operator used for comparing values".

:LogicalOperator a owl:Class ;
rdfs:label "Logical Operator" ;
rdfs:comment "An operator used for logical operations".

:piirrite:TargetProperty a owl:ObjectProperty ;
rdfs:label "Target Property" ;
rdfs:comment "The property that is the target of a requirement".

:piirrite:ExpectedValue a owl:ObjectProperty ;
rdfs:label "Expected Value" ;
rdfs:comment "The expected value of a property".

:piirrite:Requirement a owl:ObjectProperty ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement of a user".

:piirrite:Condition a owl:ObjectProperty ;
rdfs:label "Condition" ;
rdfs:comment "A condition that must be met for a requirement to be fulfilled".

:piirrite:ComposedCondition a owl:ObjectProperty ;
rdfs:label "Composed Condition" ;
rdfs:comment "A condition composed of multiple conditions".

:piirrite:DistanceRequisite a owl:ObjectProperty ;
rdfs:label "Distance Requisite" ;
rdfs:comment "A requirement related to distance".

:piirrite:UserProfile a owl:ObjectProperty ;
rdfs:label "User Profile" ;
rdfs:comment "A profile of a user's requirements".

:piirrite:ComparisonOperator a owl:ObjectProperty ;
rdfs:label "Comparison Operator" ;
rdfs:comment "An operator used for comparing values".

:piirrite:LogicalOperator a owl:ObjectProperty ;
rdfs:label "Logical Operator" ;
rdfs:comment "An operator used for logical operations".