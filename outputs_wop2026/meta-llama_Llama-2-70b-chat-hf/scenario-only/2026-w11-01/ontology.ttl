@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "WISDOM Ontology" ;
  rdfs:comment "A formal representation of stress conditions, sensors, and physiological signals.".

:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "A stimulus or event that has the potential to induce stress in a subject.".

:PhysiologicalResponse a owl:Class ;
  rdfs:label "PhysiologicalResponse" ;
  rdfs:comment "A response to a stressor that can be measured physiologically.".

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "A device that measures physiological signals.".

:StressState a owl:Class ;
  rdfs:label "StressState" ;
  rdfs:comment "A state of stress or relaxation.".

:Context a owl:Class ;
  rdfs:label "Context" ;
  rdfs:comment "Information about the environment and conditions in which a stressor or physiological response occurs.".

:Stressor a owl:ObjectProperty ;
  rdfs:label "stressor" ;
  rdfs:comment "A relationship between a stressor and a stress state.".

:PhysiologicalResponse a owl:ObjectProperty ;
  rdfs:label "physiologicalResponse" ;
  rdfs:comment "A relationship between a physiological response and a stress state.".

:Sensor a owl:ObjectProperty ;
  rdfs:label "sensor" ;
  rdfs:comment "A relationship between a sensor and a physiological response.".

:Context a owl:ObjectProperty ;
  rdfs:label "context" ;
  rdfs:comment "A relationship between a stress state and contextual information.".

:StressState a owl:SubClassOf :PhysiologicalResponse.
:StressState a owl:SubClassOf :Context.

:PhysiologicalResponse a owl:SubClassOf :Sensor.

:Sensor a owl:SubClassOf :Context.

:Stressor a owl:SubClassOf :PhysiologicalResponse.

:Stressor a owl:SubClassOf :Context.

:PhysiologicalResponse a owl:SubClassOf :StressState.

:Sensor a owl:SubClassOf :StressState.

:Context a owl:SubClassOf :StressState.