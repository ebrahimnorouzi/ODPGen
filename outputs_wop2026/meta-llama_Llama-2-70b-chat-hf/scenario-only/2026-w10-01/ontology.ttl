@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Matchmaker Ontology" ;
rdfs:comment "An ontology for matching software requirements with hardware resources".

:Software a owl:Class ;
rdfs:label "Software" ;
rdfs:comment "A software component with specific requirements".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement expressed for a software component".

:Hardware a owl:Class ;
rdfs:label "Hardware" ;
rdfs:comment "A hardware resource with specific characteristics".

:Characteristic a owl:Class ;
rdfs:label "Characteristic" ;
rdfs:comment "A characteristic of a hardware resource".

:Match a owl:Class ;
rdfs:label "Match" ;
rdfs:comment "A match between a software requirement and a hardware resource".

:Candidate a owl:Class ;
rdfs:label "Candidate" ;
rdfs:comment "A candidate resource that can be used to execute, support, or deploy a software component".

:Software hasRequirement :Requirement ;
rdfs:label "hasRequirement" ;
rdfs:comment "A software component has a requirement".

:Requirement hasValue xsd:string ;
rdfs:label "hasValue" ;
rdfs:comment "A requirement has a value".

:Hardware hasCharacteristic :Characteristic ;
rdfs:label "hasCharacteristic" ;
rdfs:comment "A hardware resource has a characteristic".

:Characteristic hasValue xsd:string ;
rdfs:label "hasValue" ;
rdfs:comment "A characteristic has a value".

:Match hasCandidate :Candidate ;
rdfs:label "hasCandidate" ;
rdfs:comment "A match has a candidate resource".

:Candidate hasMatch :Match ;
rdfs:label "hasMatch" ;
rdfs:comment "A candidate resource has a match".