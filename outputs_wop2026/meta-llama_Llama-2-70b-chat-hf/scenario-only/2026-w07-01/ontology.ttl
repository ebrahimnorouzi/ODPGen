@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Learner Ontology" ;
rdfs:comment "An ontology for modeling learner information, pedagogical organization, evaluation, and feedback.".

# Learner Context
:Learner a owl:Class ;
rdfs:label "Learner" ;
rdfs:comment "A person who is learning.".

:LearnerGoal a owl:Class ;
rdfs:label "Learner Goal" ;
rdfs:comment "A goal that a learner is trying to achieve.".

:LearnerPreference a owl:Class ;
rdfs:label "Learner Preference" ;
rdfs:comment "A preference that a learner has regarding their learning.".

:LearnerChallenge a owl:Class ;
rdfs:label "Learner Challenge" ;
rdfs:comment "A challenge that a learner faces in their learning.".

:LearnerSituation a owl:Class ;
rdfs:label "Learner Situation" ;
rdfs:comment "A situation that a learner is in.".

# Pedagogical Organization
:PedagogicalFramework a owl:Class ;
rdfs:label "Pedagogical Framework" ;
rdfs:comment "A framework that guides the design and implementation of learning experiences.".

:PedagogicalElement a owl:Class ;
rdfs:label "Pedagogical Element" ;
rdfs:comment "A component of a pedagogical framework.".

:PedagogicalOrder a owl:Class ;
rdfs:label "Pedagogical Order" ;
rdfs:comment "The order in which pedagogical elements are presented.".

# Objective Alignment
:LearningObjective a owl:Class ;
rdfs:label "Learning Objective" ;
rdfs:comment "A statement of what a learner should know or be able to do after a learning experience.".

:PedagogicalTechnique a owl:Class ;
rdfs:label "Pedagogical Technique" ;
rdfs:comment "A method or approach used to support learning.".

:LearningResource a owl:Class ;
rdfs:label "Learning Resource" ;
rdfs:comment "A resource used to support learning, such as a textbook, video, or online course.".

:ObjectiveAlignment a owl:Class ;
rdfs:label "Objective Alignment" ;
rdfs:comment "The alignment of a learning objective with pedagogical techniques and learning resources.".

# Evaluation
:AssessmentExercise a owl:Class ;
rdfs:label "Assessment Exercise" ;
rdfs:comment "An activity or task used to evaluate learner progress.".

:EvaluationTechnique a owl:Class ;
rdfs:label "Evaluation Technique" ;
rdfs:comment "A method or approach used to evaluate learner progress.".

:Metric a owl:Class ;
rdfs:label "Metric" ;
rdfs:comment "A measure or standard used to evaluate learner progress.".

:Result a owl:Class ;
rdfs:label "Result" ;
rdfs:comment "The outcome of an assessment exercise.".

# Feedback
:Feedback a owl:Class ;
rdfs:label "Feedback" ;
rdfs:comment "Information or commentary provided in response to learner performance or progress.".

:Source a owl:Class ;
rdfs:label "Source" ;
rdfs:comment "The origin or provider of feedback.".

:TemporalInformation a owl:Class ;
rdfs:label "Temporal Information" ;
rdfs:comment "Information related to the timing or schedule of feedback.".

# Learner Awareness
:LearnerAwareness a owl:Class ;
rdfs:label "Learner Awareness" ;
rdfs:comment "The knowledge or understanding that a learner has about their own learning.".

:Topic a owl:Class ;
rdfs:label "Topic" ;
rdfs:comment "A subject or area of knowledge.".

:Skill a owl:Class ;
rdfs:label "Skill" ;
rdfs:comment "A ability or proficiency that a learner possesses.".

:LearnerAwarenessOfTopic a owl:Class ;
rdfs:label "Learner Awareness of Topic" ;
rdfs:comment "The learner's awareness of their knowledge or understanding of a topic.".

:LearnerAwarenessOfSkill a owl:Class ;
rdfs:label "Learner Awareness of Skill" ;
rdfs:comment "The learner's awareness of their ability or proficiency in a skill.".