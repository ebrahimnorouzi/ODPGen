@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "StorAIge Study Ontology" ;
rdfs:comment "An ontology for describing the StorAIge study and its environmental impact assessment".

:StorAIgeStudy a owl:Class ;
rdfs:label "StorAIge Study" ;
rdfs:comment "A class representing the StorAIge study".

:EnvironmentalImpact a owl:Class ;
rdfs:label "Environmental Impact" ;
rdfs:comment "A class representing the environmental impact of the StorAIge study".

:InventoryData a owl:Class ;
rdfs:label "Inventory Data" ;
rdfs:comment "A class representing inventory data used in the StorAIge study".

:BillOfMaterials a owl:Class ;
rdfs:label "Bill of Materials" ;
rdfs:comment "A class representing the bill of materials for the StorAIge study".

:EIME a owl:Class ;
rdfs:label "EIME" ;
rdfs:comment "A class representing the EIME software tool used in the StorAIge study".

:CODDE a owl:Class ;
rdfs:label "CODDE" ;
rdfs:comment "A class representing the CODDE database used in the StorAIge study".

:NegaOctet a owl:Class ;
rdfs:label "NegaOctet" ;
rdfs:comment "A class representing the NegaOctet database used in the StorAIge study".

:EnvironmentalFootprint a owl:Class ;
rdfs:label "Environmental Footprint" ;
rdfs:comment "A class representing the environmental footprint of the StorAIge study".

:Hypotheses a owl:Class ;
rdfs:label "Hypotheses" ;
rdfs:comment "A class representing the hypotheses of the StorAIge study".

:Parametrisation a owl:Class ;
rdfs:label "Parametrisation" ;
rdfs:comment "A class representing the parametrisation of the StorAIge study".

:SystemBoundary a owl:Class ;
rdfs:label "System Boundary" ;
rdfs:comment "A class representing the system boundary of the StorAIge study".

:Actor a owl:Class ;
rdfs:label "Actor" ;
rdfs:comment "A class representing the actors involved in the StorAIge study".

:StorAIgeStudy rdfs:subClassOf :EnvironmentalImpact.
:InventoryData rdfs:subClassOf :EnvironmentalImpact.
:BillOfMaterials rdfs:subClassOf :InventoryData.
:EIME rdfs:subClassOf :InventoryData.
:CODDE rdfs:subClassOf :InventoryData.
:NegaOctet rdfs:subClassOf :InventoryData.
:EnvironmentalFootprint rdfs:subClassOf :EnvironmentalImpact.
:Hypotheses rdfs:subClassOf :StorAIgeStudy.
:Parametrisation rdfs:subClassOf :StorAIgeStudy.
:SystemBoundary rdfs:subClassOf :StorAIgeStudy.
:Actor rdfs:subClassOf :StorAIgeStudy.

:StorAIgeStudy owl:hasClass :EnvironmentalImpact.
:StorAIgeStudy owl:hasClass :InventoryData.
:StorAIgeStudy owl:hasClass :BillOfMaterials.
:StorAIgeStudy owl:hasClass :EIME.
:StorAIgeStudy owl:hasClass :CODDE.
:StorAIgeStudy owl:hasClass :NegaOctet.
:StorAIgeStudy owl:hasClass :EnvironmentalFootprint.
:StorAIgeStudy owl:hasClass :Hypotheses.
:StorAIgeStudy owl:hasClass :Parametrisation.
:StorAIgeStudy owl:hasClass :SystemBoundary.
:StorAIgeStudy owl:hasClass :Actor.