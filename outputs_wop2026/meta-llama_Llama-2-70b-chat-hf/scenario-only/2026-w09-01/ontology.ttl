@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Climate Services Dataset Ontology" ;
rdfs:comment "An ontology for describing datasets of climate services data.".

:Dataset a owl:Class ;
rdfs:label "Dataset" ;
rdfs:comment "A collection of data values for a single variable.".

:Variable a owl:Class ;
rdfs:label "Variable" ;
rdfs:comment "A variable measured in a dataset.".

:Value a owl:Class ;
rdfs:label "Value" ;
rdfs:comment "A single data value for a variable.".

:Time a owl:Class ;
rdfs:label "Time" ;
rdfs:comment "A variable representing time.".

:AirTemperature a owl:Class ;
rdfs:label "AirTemperature" ;
rdfs:comment "A variable representing air temperature.".

:Italy a owl:Class ;
rdfs:label "Italy" ;
rdfs:comment "A geographic region representing Italy.".

:DatasetHasVariable a owl:ObjectProperty ;
rdfs:label "hasVariable" ;
rdfs:comment "A dataset has a variable.".

:VariableHasValue a owl:ObjectProperty ;
rdfs:label "hasValue" ;
rdfs:comment "A variable has a value.".

:DatasetHasValue a owl:ObjectProperty ;
rdfs:label "hasValue" ;
rdfs:comment "A dataset has a value for a variable.".

:TimeHasValue a owl:ObjectProperty ;
rdfs:label "hasValue" ;
rdfs:comment "Time has a value.".

:AirTemperatureHasValue a owl:ObjectProperty ;
rdfs:label "hasValue" ;
rdfs:comment "Air temperature has a value.".

:ItalyHasDataset a owl:ObjectProperty ;
rdfs:label "hasDataset" ;
rdfs:comment "Italy has a dataset.".

:DatasetIsPublished a owl:ObjectProperty ;
rdfs:label "isPublished" ;
rdfs:comment "A dataset is published.".

:Publisher a owl:Class ;
rdfs:label "Publisher" ;
rdfs:comment "An entity that publishes a dataset.".

:DatasetHasPublisher a owl:ObjectProperty ;
rdfs:label "hasPublisher" ;
rdfs:comment "A dataset has a publisher.".