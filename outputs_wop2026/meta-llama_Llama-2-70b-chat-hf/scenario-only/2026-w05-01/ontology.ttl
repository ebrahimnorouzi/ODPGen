@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Prompting Technique Ontology" ;
rdfs:comment "An ontology for modeling prompting techniques and their applications.".

# Classes

:PromptingTechnique a owl:Class ;
rdfs:label "Prompting Technique" ;
rdfs:comment "A technique for prompting a foundation model.".

:Task a owl:Class ;
rdfs:label "Task" ;
rdfs:comment "A task that requires a prompting technique.".

:DataModality a owl:Class ;
rdfs:label "Data Modality" ;
rdfs:comment "A modality of data that can be used for prompting.".

:Constraint a owl:Class ;
rdfs:label "Constraint" ;
rdfs:comment "A constraint that must be satisfied by a prompting technique.".

:ModelArchitecture a owl:Class ;
rdfs:label "Model Architecture" ;
rdfs:comment "The architecture of a model that can be used for prompting.".

:ModelFamily a owl:Class ;
rdfs:label "Model Family" ;
rdfs:comment "A family of models that can be used for prompting.".

:ModelVariant a owl:Class ;
rdfs:label "Model Variant" ;
rdfs:comment "A variant of a model that can be used for prompting.".

:ModelEvolution a owl:Class ;
rdfs:label "Model Evolution" ;
rdfs:comment "An evolution of a model that can be used for prompting.".

# Properties

:hasPromptingTechnique a owl:ObjectProperty ;
rdfs:label "has prompting technique" ;
rdfs:comment "A task has a prompting technique that can be used to solve it.".

:isApplicableTo a owl:ObjectProperty ;
rdfs:label "is applicable to" ;
rdfs:comment "A prompting technique is applicable to a task.".

:hasDataModality a owl:ObjectProperty ;
rdfs:label "has data modality" ;
rdfs:comment "A prompting technique has a data modality that can be used for prompting.".

:isSubjectTo a owl:ObjectProperty ;
rdfs:label "is subject to" ;
rdfs:comment "A prompting technique is subject to a constraint.".

:hasModelArchitecture a owl:ObjectProperty ;
rdfs:label "has model architecture" ;
rdfs:comment "A prompting technique has a model architecture that can be used for prompting.".

:belongsToModelFamily a owl:ObjectProperty ;
rdfs:label "belongs to model family" ;
rdfs:comment "A prompting technique belongs to a model family.".

:isVariantOf a owl:ObjectProperty ;
rdfs:label "is variant of" ;
rdfs:comment "A prompting technique is a variant of a model.".

:evolvesInto a owl:ObjectProperty ;
rdfs:label "evolves into" ;
rdfs:comment "A prompting technique evolves into a new model.".

# Individuals

:Mike a :Person ;
rdfs:label "Mike" ;
rdfs:comment "The person who needs to solve a task.".

:Task1 a :Task ;
rdfs:label "Task 1" ;
rdfs:comment "A specific task that Mike needs to solve.".

:PromptingTechnique1 a :PromptingTechnique ;
rdfs:label "Prompting Technique 1" ;
rdfs:comment "A prompting technique that can be used to solve Task 1.".

:DataModality1 a :DataModality ;
rdfs:label "Data Modality 1" ;
rdfs:comment "A data modality that can be used for prompting Task 1.".

:Constraint1 a :Constraint ;
rdfs:label "Constraint 1" ;
rdfs:comment "A constraint that must be satisfied by a prompting technique for Task 1.".

:ModelArchitecture1 a :ModelArchitecture ;
rdfs:label "Model Architecture 1" ;
rdfs:comment "The architecture of a model that can be used for prompting Task 1.".

:ModelFamily1 a :ModelFamily ;
rdfs:label "Model Family 1" ;
rdfs:comment "A family of models that can be used for prompting Task 1.".

:ModelVariant1 a :ModelVariant ;
rdfs:label "Model Variant 1" ;
rdfs:comment "A variant of a model that can be used for prompting Task 1.".

:ModelEvolution1 a :ModelEvolution ;
rdfs:label "Model Evolution 1" ;
rdfs:comment "An evolution of a model that can be used for prompting Task 1.".