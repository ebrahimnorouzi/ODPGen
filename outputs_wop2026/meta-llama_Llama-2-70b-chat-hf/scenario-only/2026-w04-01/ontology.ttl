@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "Reverse Engineering Knowledge Graph Ontology" ;
rdfs:comment "An ontology for representing knowledge graphs in the context of reverse engineering binary executables.".

:SymbolTable a owl:Class ;
rdfs:label "Symbol Table" ;
rdfs:comment "A collection of symbols used in a binary file.".

:Symbol a owl:Class ;
rdfs:label "Symbol" ;
rdfs:comment "A single symbol used in a binary file.".

:FunctionSymbol a owl:SubClassOf :Symbol ;
rdfs:label "Function Symbol" ;
rdfs:comment "A symbol representing a function in a binary file.".

:VariableSymbol a owl:SubClassOf :Symbol ;
rdfs:label "Variable Symbol" ;
rdfs:comment "A symbol representing a variable in a binary file.".

:Label a owl:ObjectProperty ;
rdfs:label "Label" ;
rdfs:comment "A label assigned to a symbol.".

:OriginalName a owl:ObjectProperty ;
rdfs:label "Original Name" ;
rdfs:comment "The original name of a symbol.".

:RenamedName a owl:ObjectProperty ;
rdfs:label "Renamed Name" ;
rdfs:comment "The renamed name of a symbol.".

:Dependency a owl:ObjectProperty ;
rdfs:label "Dependency" ;
rdfs:comment "A dependency relationship between two symbols.".

:MalwareBehavior a owl:Class ;
rdfs:label "Malware Behavior" ;
rdfs:comment "Behavior indicative of malware.".

:Vulnerability a owl:Class ;
rdfs:label "Vulnerability" ;
rdfs:comment "A vulnerability in a software supply chain.".

:SoftwareSupplyChain a owl:Class ;
rdfs:label "Software Supply Chain" ;
rdfs:comment "A collection of software components and their dependencies.".

:Component a owl:Class ;
rdfs:label "Component" ;
rdfs:comment "A software component in a software supply chain.".

:DependencyVulnerability a owl:SubClassOf :Vulnerability ;
rdfs:label "Dependency Vulnerability" ;
rdfs:comment "A vulnerability in a software supply chain related to a dependency.".