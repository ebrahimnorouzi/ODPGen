@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "WISDOM Stress Detection Ontology" ;
  rdfs:comment "A formal representation of stress conditions, stressors, and physiological responses for wearable stress detection".

:Stress a owl:Class ;
  rdfs:label "Stress" ;
  rdfs:comment "A state of physical or psychological strain".

:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "A stimulus or event that has the potential to induce stress".

:PhysiologicalResponse a owl:Class ;
  rdfs:label "PhysiologicalResponse" ;
  rdfs:comment "A measurable physiological change in response to a stressor".

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "A device that measures physiological or environmental data".

:SignalChannel a owl:Class ;
  rdfs:label "SignalChannel" ;
  rdfs:comment "A specific type of physiological or environmental data measured by a sensor".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "A measurement or annotation of a physiological or environmental phenomenon".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "A specific type of task or action".

:ExperimentalProtocol a owl:Class ;
  rdfs:label "ExperimentalProtocol" ;
  rdfs:comment "A specific set of instructions for conducting a study".

:Subject a owl:Class ;
  rdfs:label "Subject" ;
  rdfs:comment "A person or entity participating in a study".

:Role a owl:Class ;
  rdfs:label "Role" ;
  rdfs:comment "A specific function or position held by a person or entity".

:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:comment "A human being".

:SensorMeasurement a owl:Class ;
  rdfs:label "SensorMeasurement" ;
  rdfs:comment "A measurement taken by a sensor".

:PPG a owl:Class ;
  rdfs:label "PPG" ;
  rdfs:comment "A type of sensor that measures pulse plethysmography".

:EDA a owl:Class ;
  rdfs:label "EDA" ;
  rdfs:comment "A type of sensor that measures electrodermal activity".

:BloodOxygenSaturation a owl:Class ;
  rdfs:label "BloodOxygenSaturation" ;
  rdfs:comment "A type of sensor that measures blood oxygen saturation".

:Temperature a owl:Class ;
  rdfs:label "Temperature" ;
  rdfs:comment "A type of sensor that measures temperature".

:Accelerometer a owl:Class ;
  rdfs:label "Accelerometer" ;
  rdfs:comment "A type of sensor that measures acceleration".

:ActivityPhase a owl:Class ;
  rdfs:label "ActivityPhase" ;
  rdfs:comment "A specific stage of an activity".

:StressCondition a owl:Class ;
  rdfs:label "StressCondition" ;
  rdfs:comment "A specific type of stress or stress response".

:BiomarkerAssay a owl:Class ;
  rdfs:label "BiomarkerAssay" ;
  rdfs:comment "A specific type of biological or physiological measurement".

:TimeSeriesObservation a owl:Class ;
  rdfs:label "TimeSeriesObservation" ;
  rdfs:comment "A specific type of observation that captures changes over time".

:Annotation a owl:Class ;
  rdfs:label "Annotation" ;
  rdfs:comment "A note or comment associated with a specific observation or activity".

:HumanObserver a owl:Class ;
  rdfs:label "HumanObserver" ;
  rdfs:comment "A person who makes an observation or provides an annotation".