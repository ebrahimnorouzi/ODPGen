@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Climate Services Ontology" ;
  rdfs:comment "An ontology for describing climate services data.".

:Dataset a owl:Class ;
  rdfs:label "Dataset" ;
  rdfs:comment "A collection of data values.".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A variable in a dataset.".

:DependentVariable a owl:Class ;
  rdfs:label "Dependent Variable" ;
  rdfs:comment "A variable that depends on one or more other variables.".

:IndependentVariable a owl:Class ;
  rdfs:label "Independent Variable" ;
  rdfs:comment "A variable that does not depend on any other variable.".

:TemporalVariable a owl:Class ;
  rdfs:label "Temporal Variable" ;
  rdfs:comment "A variable that represents a temporal concept, such as time.".

:SpatialVariable a owl:Class ;
  rdfs:label "Spatial Variable" ;
  rdfs:comment "A variable that represents a spatial concept, such as geographic location.".

:Aggregate a owl:Class ;
  rdfs:label "Aggregate" ;
  rdfs:comment "A variable that represents an aggregation of other variables.".

:Aggregation a owl:ObjectProperty ;
  rdfs:label "Aggregation" ;
  rdfs:comment "The relationship between an aggregate and its components.".

:Component a owl:ObjectProperty ;
  rdfs:label "Component" ;
  rdfs:comment "The relationship between a composite variable and its components.".

:Projection a owl:ObjectProperty ;
  rdfs:label "Projection" ;
  rdfs:comment "The relationship between a composite variable and its sub-dimensional space.".

:Quantization a owl:ObjectProperty ;
  rdfs:label "Quantization" ;
  rdfs:comment "The relationship between a continuous variable and its discrete representation.".

:Discrete a owl:Class ;
  rdfs:label "Discrete" ;
  rdfs:comment "A variable that has a discrete set of values.".

:Continuous a owl:Class ;
  rdfs:label "Continuous" ;
  rdfs:comment "A variable that has a continuous range of values.".

:Binned a owl:Class ;
  rdfs:label "Binned" ;
  rdfs:comment "A variable that has been discretized into a finite number of bins.".

:Sampled a owl:Class ;
  rdfs:label "Sampled" ;
  rdfs:comment "A variable that has been discretized into a finite number of samples.".

:Resolution a owl:ObjectProperty ;
  rdfs:label "Resolution" ;
  rdfs:comment "The relationship between a quantization and its resolution.".

:Coverage a owl:ObjectProperty ;
  rdfs:label "Coverage" ;
  rdfs:comment "The relationship between a dataset and its spatial and temporal coverage.".

:DataSource a owl:Class ;
  rdfs:label "DataSource" ;
  rdfs:comment "A source of data.".

:Serialization a owl:ObjectProperty ;
  rdfs:label "Serialization" ;
  rdfs:comment "The relationship between a dataset and its serialization.".

:Format a owl:Class ;
  rdfs:label "Format" ;
  rdfs:comment "A format for data serialization.".

:URL a owl:ObjectProperty ;
  rdfs:label "URL" ;
  rdfs:comment "The relationship between a dataset and its URL.".

:Process a owl:Class ;
  rdfs:label "Process" ;
  rdfs:comment "A process that generates a dataset.".

:Input a owl:ObjectProperty ;
  rdfs:label "Input" ;
  rdfs:comment "The relationship between a process and its input datasets.".

:Output a owl:ObjectProperty ;
  rdfs:label "Output" ;
  rdfs:comment "The relationship between a process and its output datasets.".

:DataTransformation a owl:Class ;
  rdfs:label "DataTransformation" ;
  rdfs:comment "A process that transforms data.".

:Equivalent a owl:ObjectProperty ;
  rdfs:label "Equivalent" ;
  rdfs:comment "The relationship between two variables that have the same value.".