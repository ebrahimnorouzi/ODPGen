@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "LCAnet Ontology" ;
rdfs:comment "An ontology for LCA studies".

:LCA a owl:Class ;
rdfs:label "LCA" ;
rdfs:comment "A Life Cycle Assessment study".

:Study a owl:Class ;
rdfs:label "Study" ;
rdfs:comment "A research study".

:Prototype a owl:Class ;
rdfs:label "Prototype" ;
rdfs:comment "A Near Memory Computing prototype".

:C-SRAM a owl:Class ;
rdfs:label "C-SRAM" ;
rdfs:comment "A C-SRAM technology".

:BillOfMaterials a owl:Class ;
rdfs:label "BillOfMaterials" ;
rdfs:comment "A bill of materials".

:Inventory a owl:Class ;
rdfs:label "Inventory" ;
rdfs:comment "Inventory data".

:CODDE a owl:Class ;
rdfs:label "CODDE" ;
rdfs:comment "A database of environmental impact data".

:NegaOctet a owl:Class ;
rdfs:label "NegaOctet" ;
rdfs:comment "A database of environmental impact data".

:EnvironmentalFootprint a owl:Class ;
rdfs:label "EnvironmentalFootprint" ;
rdfs:comment "An environmental impact calculation methodology".

:Impact a owl:Class ;
rdfs:label "Impact" ;
rdfs:comment "An environmental impact result".

:Flow a owl:Class ;
rdfs:label "Flow" ;
rdfs:comment "A flow of materials or energy".

:InputFlow a owl:Class ;
rdfs:label "InputFlow" ;
rdfs:comment "An input flow of materials or energy".

:OutputFlow a owl:Class ;
rdfs:label "OutputFlow" ;
rdfs:comment "An output flow of materials or energy".

:Dependency a owl:Class ;
rdfs:label "Dependency" ;
rdfs:comment "A dependency between activities".

:Activity a owl:Class ;
rdfs:label "Activity" ;
rdfs:comment "An activity in a system model".

:FunctionalUnit a owl:Class ;
rdfs:label "FunctionalUnit" ;
rdfs:comment "A functional unit in an LCA model".

:Scope a owl:Class ;
rdfs:label "Scope" ;
rdfs:comment "A system boundary in an LCA model".

:ResponsibleAgent a owl:Class ;
rdfs:label "ResponsibleAgent" ;
rdfs:comment "An agent responsible for an LCA model".

:ImpactCategory a owl:Class ;
rdfs:label "ImpactCategory" ;
rdfs:comment "An environmental impact category".

:Contributor a owl:Class ;
rdfs:label "Contributor" ;
rdfs:comment "A flow that contributes to an impact category".

:TopContributor a owl:Class ;
rdfs:label "TopContributor" ;
rdfs:comment "A flow that is a significant contributor to an impact category".

:TotalFlow a owl:Class ;
rdfs:label "TotalFlow" ;
rdfs:comment "The total amount of a flow generated within a system boundary".