@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
rdfs:label "SMARTY Matchmaker Ontology" ;
rdfs:comment "An ontology for describing software and hardware requirements and matching them with available resources.".

:Software a owl:Class ;
rdfs:label "Software" ;
rdfs:comment "A software component with specific requirements.".

:Hardware a owl:Class ;
rdfs:label "Hardware" ;
rdfs:comment "A hardware component with specific characteristics.".

:Requirement a owl:Class ;
rdfs:label "Requirement" ;
rdfs:comment "A requirement expressed by a software.".

:SoftwareRequirement a owl:ObjectProperty ;
rdfs:label "softwareRequirement" ;
rdfs:comment "A requirement expressed by a software." ;
:Software a :SoftwareRequirement.

:HardwareRequirement a owl:ObjectProperty ;
rdfs:label "hardwareRequirement" ;
rdfs:comment "A requirement expressed by a hardware." ;
:Hardware a :HardwareRequirement.

:Type a owl:DatatypeProperty ;
rdfs:label "type" ;
rdfs:comment "The type of a software or hardware." ;
:Software a :Type ;
:Hardware a :Type.

:MinimumVersion a owl:DatatypeProperty ;
rdfs:label "minimumVersion" ;
rdfs:comment "The minimum version of a software required." ;
:SoftwareRequirement a :MinimumVersion.

:MaximumVersion a owl:DatatypeProperty ;
rdfs:label "maximumVersion" ;
rdfs:comment "The maximum version of a software required." ;
:SoftwareRequirement a :MaximumVersion.

:ExactVersion a owl:DatatypeProperty ;
rdfs:label "exactVersion" ;
rdfs:comment "The exact version of a software required." ;
:SoftwareRequirement a :ExactVersion.

:MinimumValue a owl:DatatypeProperty ;
rdfs:label "minimumValue" ;
rdfs:comment "The minimum value of a property required." ;
:SoftwareRequirement a :MinimumValue.

:MaximumValue a owl:DatatypeProperty ;
rdfs:label "maximumValue" ;
rdfs:comment "The maximum value of a property required." ;
:SoftwareRequirement a :MaximumValue.

:ExactValue a owl:DatatypeProperty ;
rdfs:label "exactValue" ;
rdfs:comment "The exact value of a property required." ;
:SoftwareRequirement a :ExactValue.