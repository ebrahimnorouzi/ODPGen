:Ontology a owl:Ontology ;
rdfs:label "Reverse Engineering Knowledge Graph Ontology" ;
rdfs:comment "An ontology for representing knowledge graphs in the context of reverse engineering binary executables.".

:ReverseEngineering a owl:Class ;
rdfs:label "Reverse Engineering" ;
rdfs:comment "The process of analyzing and understanding the behavior of a binary executable.".

:BinaryExecutable a owl:Class ;
rdfs:label "Binary Executable" ;
rdfs:comment "A file containing machine code that can be executed by a computer.".

:SymbolTable a owl:Class ;
rdfs:label "Symbol Table" ;
rdfs:comment "A collection of symbols used in a binary executable.".

:Symbol a owl:Class ;
rdfs:label "Symbol" ;
rdfs:comment "A name or label associated with a memory location or instruction in a binary executable.".

:Function a owl:Class ;
rdfs:label "Function" ;
rdfs:comment "A block of code that performs a specific task.".

:Variable a owl:Class ;
rdfs:label "Variable" ;
rdfs:comment "A storage location that holds a value.".

:APICall a owl:Class ;
rdfs:label "API Call" ;
rdfs:comment "A request to a software application programming interface.".

:NetworkActivity a owl:Class ;
rdfs:label "Network Activity" ;
rdfs:comment "Any activity involving communication over a network.".

:ControlFlow a owl:Class ;
rdfs:label "Control Flow" ;
rdfs:comment "The order in which instructions are executed in a program.".

:IndirectControlFlow a owl:Class ;
rdfs:label "Indirect Control Flow" ;
rdfs:comment "Control flow that is not directly connected to the main program flow.".

:Entropy a owl:Class ;
rdfs:label "Entropy" ;
rdfs:comment "A measure of the amount of disorder or randomness in a system.".

:Opcodes a owl:Class ;
rdfs:label "Opcodes" ;
rdfs:comment "The machine code instructions that make up a program.".

:Instructions a owl:Class ;
rdfs:label "Instructions" ;
rdfs:comment "The specific steps that a computer follows to execute a program.".

:SelfReferentialDecodeLoops a owl:Class ;
rdfs:label "Self-Referential Decode Loops" ;
rdfs:comment "A pattern of instructions that decode a loop and refer to themselves.".

:FileSystemAbuse a owl:Class ;
rdfs:label "File System Abuse" ;
rdfs:comment "Any activity that exploits vulnerabilities in the file system.".

:SuspiciousJumps a owl:Class ;
rdfs:label "Suspicious Jumps" ;
rdfs:comment "Jumps in memory that are not clearly explained by the program's logic.".

:SuspiciousAPICalls a owl:Class ;
rdfs:label "Suspicious API Calls" ;
rdfs:comment "API calls that are not clearly explained by the program's logic.".

:CryptographicActivity a owl:Class ;
rdfs:label "Cryptographic Activity" ;
rdfs:comment "Any activity that involves encryption or decryption.".

:ImportedFunctions a owl:Class ;
rdfs:label "Imported Functions" ;
rdfs:comment "Functions that are imported from other files or libraries.".

:Percentage a owl:Class ;
rdfs:label "Percentage" ;
rdfs:comment "A measure of the proportion of something.".

