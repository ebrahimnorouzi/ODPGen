:Ontology a owl:Ontology ;
  rdfs:label "Binary Executable Analysis Ontology" ;
  rdfs:comment "An ontology for analyzing binary executable files, focusing on detecting malicious activities, identifying dependencies, and understanding control flow patterns.".

:Executable a owl:Class ;
  rdfs:label "Executable" ;
  rdfs:comment "A binary executable file.".

:API_Call a owl:Class ;
  rdfs:label "API Call" ;
  rdfs:comment "A call to an application programming interface.".

:Persistent_API_Call a owl:Class ;
  rdfs:label "Persistent API Call" ;
  rdfs:comment "A persistent API call, which is executed repeatedly or under certain conditions.".

:Network_Activity a owl:Class ;
  rdfs:label "Network Activity" ;
  rdfs:comment "Network-related activities within the executable.".

:Control_Flow_Pattern a owl:Class ;
  rdfs:label "Control Flow Pattern" ;
  rdfs:comment "Patterns in the control flow of the executable.".

:Indirect_Control_Flow a owl:Class ;
  rdfs:label "Indirect Control Flow" ;
  rdfs:comment "Control flow patterns that are not direct, such as jumps or function calls.".

:Entropy a owl:Class ;
  rdfs:label "Entropy" ;
  rdfs:comment "Measures of randomness or unpredictability in the executable.".

:Opcode a owl:Class ;
  rdfs:label "Opcode" ;
  rdfs:comment "A low-level instruction in a computer's instruction set.".

:Self_Referential_Decode_Loop a owl:Class ;
  rdfs:label "Self-Referential Decode Loop" ;
  rdfs:comment "A pattern of self-referential decode loops that may indicate data obfuscation.".

:File_System_Abuse a owl:Class ;
  rdfs:label "File System Abuse" ;
  rdfs:comment "Unusual or malicious activities related to the file system.".

:Jump_Into_Memory a owl:Class ;
  rdfs:label "Jump into Memory" ;
  rdfs:comment "Jumps or transfers of execution to memory locations.".

:Suspicious_API_Call a owl:Class ;
  rdfs:label "Suspicious API Call" ;
  rdfs:comment "API calls that may be indicative of malicious or suspicious behavior.".

:Cryptographic_Activity a owl:Class ;
  rdfs:label "Cryptographic Activity" ;
  rdfs:comment "Activities related to encryption or decryption within the executable.".

:Imported_Function a owl:Class ;
  rdfs:label "Imported Function" ;
  rdfs:comment "Functions that are not defined within the executable but are called from external libraries.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :API_Call ;
  rdfs:label "containsAPICall" ;
  rdfs:comment "An executable contains a specific API call.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Network_Activity ;
  rdfs:label "containsNetworkActivity" ;
  rdfs:comment "An executable contains network-related activities.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Control_Flow_Pattern ;
  rdfs:label "hasControlFlowPattern" ;
  rdfs:comment "An executable has a specific control flow pattern.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Indirect_Control_Flow ;
  rdfs:label "hasIndirectControlFlow" ;
  rdfs:comment "An executable has indirect control flow patterns.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Entropy ;
  rdfs:label "hasEntropy" ;
  rdfs:comment "An executable has a specific level of entropy.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Opcode ;
  rdfs:label "hasOpcode" ;
  rdfs:comment "An executable contains a specific opcode.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Self_Referential_Decode_Loop ;
  rdfs:label "hasSelfReferentialDecodeLoop" ;
  rdfs:comment "An executable has a self-referential decode loop.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :File_System_Abuse ;
  rdfs:label "hasFileSystemAbuse" ;
  rdfs:comment "An executable has file system abuse.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Jump_Into_Memory ;
  rdfs:label "hasJumpIntoMemory" ;
  rdfs:comment "An executable has jumps into memory.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Suspicious_API_Call ;
  rdfs:label "hasSuspiciousAPICall" ;
  rdfs:comment "An executable has suspicious API calls.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Cryptographic_Activity ;
  rdfs:label "hasCryptographicActivity" ;
  rdfs:comment "An executable has cryptographic activity.".

:Executable rdf:type owl:ObjectProperty ;
  rdfs:domain :Executable ;
  rdfs:range :Imported_Function ;
  rdfs:label "hasImportedFunction" ;
  rdfs:comment "An executable has imported functions.".

:Persistent_API_Call rdf:type owl:ObjectProperty ;
  rdfs:domain :API_Call ;
  rdfs:range :Executable ;
  rdfs:label "isPersistentAPICall" ;
  rdfs:comment "A specific API call is persistent within an executable.".
 .