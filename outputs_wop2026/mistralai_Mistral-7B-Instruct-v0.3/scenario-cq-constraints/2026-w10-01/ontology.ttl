:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Edge Computing Matchmaker Ontology" ;
  rdfs:comment "An ontology for modeling software and hardware requirements and resources in the SMARTY project's edge computing matchmaker.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A piece of software with specific requirements.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A constraint on the software or hardware resources.".

:Property a owl:Class ;
  rdfs:label "Property" ;
  rdfs:comment "A characteristic of software or hardware.".

:Value a owl:Class ;
  rdfs:label "Value" ;
  rdfs:comment "The specific value of a property.".

:Version a owl:Class ;
  rdfs:label "Version" ;
  rdfs:comment "The version of a software.".

:Requires a owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareOrHardware ;
  rdfs:label "Requires" ;
  rdfs:comment "The software or hardware required by a software.".

:HasRequirement a owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :Requirement ;
  rdfs:label "Has Requirement" ;
  rdfs:comment "The requirement of a software.".

:HasProperty a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range :Property ;
  rdfs:label "Has Property" ;
  rdfs:comment "The property that a requirement concerns.".

:HasValue a owl:ObjectProperty ;
  rdfs:domain :Property ;
  rdfs:range :Value ;
  rdfs:label "Has Value" ;
  rdfs:comment "The value of a property.".

:HasVersion a owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :Version ;
  rdfs:label "Has Version" ;
  rdfs:comment "The version of a software.".

:MinimumValue a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:decimal ;
  rdfs:label "Minimum Value" ;
  rdfs:comment "The minimum value for a property.".

:MaximumValue a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:decimal ;
  rdfs:label "Maximum Value" ;
  rdfs:comment "The maximum value for a property.".

:ExactValue a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:decimal ;
  rdfs:label "Exact Value" ;
  rdfs:comment "The exact value for a property.".