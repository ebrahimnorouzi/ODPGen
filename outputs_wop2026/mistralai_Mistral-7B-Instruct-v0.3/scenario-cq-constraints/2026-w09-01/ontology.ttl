@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
    rdfs:label "Data and Variables Ontology" ;
    rdfs:comment "An ontology for describing data and variables in different domains.".

:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "A measurable property or quantity.".

:DependentVariable a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Dependent Variable" ;
                      rdfs:comment "A variable that depends on one or more independent variables." ] ;

:IndependentVariable a owl:Class ;
    rdfs:label "Independent Variable" ;
    rdfs:comment "A variable that does not depend on any other variable.".

:DimensionalSpace a owl:Class ;
    rdfs:label "Dimensional Space" ;
    rdfs:comment "The space on which a variable takes its values.".

:Continuous a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Continuous Dimensional Space" ;
                      rdfs:comment "A dimensional space with an infinite number of points." ].

:Discrete a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Discrete Dimensional Space" ;
                      rdfs:comment "A dimensional space with a finite or countable number of points." ].

:Bounded a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Bounded Dimensional Space" ;
                      rdfs:comment "A dimensional space with a finite number of points." ].

:RescaledVariable a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Rescaled Variable" ;
                      rdfs:comment "A variable that is a rescaled version of another variable." ].

:CompositeVariable a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Composite Variable" ;
                      rdfs:comment "A variable composed of one or more component variables." ].

:AggregatedVariable a owl:Class ;
    rdfs:subClassOf [ a owl:Class ; rdfs:label "Aggregated Variable" ;
                      rdfs:comment "A variable that aggregates one or more other variables." ].

:DerivedFrom a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:label "Derived From" ;
    rdfs:comment "The variable from which a given variable is derived.".

:RescaledFrom a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Rescaled Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:label "Rescaled From" ;
    rdfs:comment "The original (non-rescaled) variable of a rescaled variable.".

:ComponentVariable a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Composite Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:label "Component Variable" ;
    rdfs:comment "A component variable of a composite variable.".

:Aggregates a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Aggregated Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:label "Aggregates" ;
    rdfs:comment "The variable(s) aggregated by an aggregated variable.".

:DependsOn a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Dependent Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Independent Variable" ] ;
    rdfs:label "Depends On" ;
    rdfs:comment "The independent variable(s) on which a dependent variable depends.".

:IsSpecializationOf a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Variable" ] ;
    rdfs:label "Is Specialization Of" ;
    rdfs:comment "A variable that is a specialization of another variable.".

:ConstrainsTo a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; rdfs:label "Variable Specialization" ] ;
    rdfs:range [ a owl:Class ; rdfs:label "Independent Variable" ] ;
    rdfs:label "Constrains To" ;
    rdfs:comment "The independent variable constrained by a variable specialization.".