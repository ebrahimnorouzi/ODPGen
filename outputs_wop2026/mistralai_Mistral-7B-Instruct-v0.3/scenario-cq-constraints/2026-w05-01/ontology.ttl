:Ontology a owl:Ontology ;
  rdfs:label "Foundation Model Prompting Ontology" ;
  rdfs:comment "This ontology describes the concepts related to foundation model prompting, including tasks, data modalities, constraints, model architectures, prompting techniques, and usage patterns.".

:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "A specific problem or objective that a foundation model is expected to solve.".

:DataModality a owl:Class ;
  rdfs:label "Data Modality" ;
  rdfs:comment "The type of data that a foundation model can process.".

:Constraint a owl:Class ;
  rdfs:label "Constraint" ;
  rdfs:comment "A limitation or requirement that a task must adhere to.".

:ModelArchitecture a owl:Class ;
  rdfs:label "Model Architecture" ;
  rdfs:comment "The structure of a foundation model, determined by available resources.".

:FoundationModel a owl:Class ;
  rdfs:label "Foundation Model" ;
  rdfs:comment "A large-scale model trained on diverse data.".

:ModelVariant a owl:Class ;
  rdfs:label "Model Variant" ;
  rdfs:comment "A specific version or adaptation of a foundation model.".

:ModelEvolution a owl:Class ;
  rdfs:label "Model Evolution" ;
  rdfs:comment "An update or improvement to a foundation model.".

:Prompt a owl:Class ;
  rdfs:label "Prompt" ;
  rdfs:comment "A question or instruction given to a foundation model.".

:PromptingTechnique a owl:Class ;
  rdfs:label "Prompting Technique" ;
  rdfs:comment "A method or strategy for crafting prompts to a foundation model.".

:Response a owl:Class ;
  rdfs:label "Response" ;
  rdfs:comment "The output generated by a foundation model in response to a prompt.".

:UsagePattern a owl:Class ;
  rdfs:label "Usage Pattern" ;
  rdfs:comment "A recurring pattern in the interaction between a foundation model and a user.".

:hasTask rdf:Property ;
  rdfs:domain :Task ;
  rdfs:range :Task ;
  rdfs:label "Has Task" ;
  rdfs:comment "The task that a prompt is related to.".

:hasDataModality rdf:Property ;
  rdfs:domain :Task ;
  rdfs:range :DataModality ;
  rdfs:label "Has Data Modality" ;
  rdfs:comment "The data modality that a task involves.".

:hasConstraint rdf:Property ;
  rdfs:domain :Task ;
  rdfs:range :Constraint ;
  rdfs:label "Has Constraint" ;
  rdfs:comment "The constraint that a task must adhere to.".

:hasModelArchitecture rdf:Property ;
  rdfs:domain :FoundationModel ;
  rdfs:range :ModelArchitecture ;
  rdfs:label "Has Model Architecture" ;
  rdfs:comment "The architecture of the foundation model.".

:hasVariant rdf:Property ;
  rdfs:domain :FoundationModel ;
  rdfs:range :ModelVariant ;
  rdfs:label "Has Variant" ;
  rdfs:comment "The specific version or adaptation of a foundation model.".

:hasEvolution rdf:Property ;
  rdfs:domain :FoundationModel ;
  rdfs:range :ModelEvolution ;
  rdfs:label "Has Evolution" ;
  rdfs:comment "The update or improvement to a foundation model.".

:hasPromptingTechnique rdf:Property ;
  rdfs:domain :Prompt ;
  rdfs:range :PromptingTechnique ;
  rdfs:label "Has Prompting Technique" ;
  rdfs:comment "The prompting technique used for a given prompt.".

:hasResponse rdf:Property ;
  rdfs:domain :Prompt ;
  rdfs:range :Response ;
  rdfs:label "Has Response" ;
  rdfs:comment "The response generated by a foundation model for a given prompt.".

:hasUsagePattern rdf:Property ;
  rdfs:domain :Prompt ;
  rdfs:range :UsagePattern ;
  rdfs:label "Has Usage Pattern" ;
  rdfs:comment "The recurring pattern in the interaction between a foundation model and a user for a given prompt.".

:hasNumberOfPrompts rdf:Property ;
  rdfs:domain :UsagePattern ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "Has Number of Prompts" ;
  rdfs:comment "The average number of prompts and responses per chat.".

:hasNumberOfResponses rdf:Property ;
  rdfs:domain :UsagePattern ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "Has Number of Responses" ;
  rdfs:comment "The average number of prompts and responses per chat.".

:isSubmittedTo rdf:Property ;
  rdfs:domain :Prompt ;
  rdfs:range :FoundationModel ;
  rdfs:label "Is Submitted To" ;
  rdfs:comment "The foundation model that a prompt is submitted to.".

:hasNumberOfChats rdf:Property ;
  rdfs:domain :FoundationModel ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "Has Number of Chats" ;
  rdfs:comment "The number of chats conducted per foundation model.".