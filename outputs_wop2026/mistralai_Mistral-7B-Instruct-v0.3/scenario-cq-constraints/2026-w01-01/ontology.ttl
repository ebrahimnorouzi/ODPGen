:Ontology a owl:Ontology ;
  rdfs:label "LCAnet Ontology for StorAIge Study" ;
  rdfs:comment "An ontology for modeling the Life Cycle Assessment (LCA) study of the StorAIge project, using the LCAnet framework.".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An action or process in the LCA study.".

:InputFlow a owl:Class ;
  rdfs:label "Input Flow" ;
  rdfs:comment "A flow of materials, energy, or information entering an activity.".

:OutputFlow a owl:Class ;
  rdfs:label "Output Flow" ;
  rdfs:comment "A flow of materials, energy, or information leaving an activity.".

:Dependency a owl:ObjectProperty ;
  rdfs:label "Depends On" ;
  rdfs:comment "A relationship between activities where one activity depends on the outcome of another.".

:HasInputFlow a owl:ObjectProperty ;
  rdfs:label "Has Input Flow" ;
  rdfs:comment "An activity has one or more input flows.".

:HasOutputFlow a owl:ObjectProperty ;
  rdfs:label "Has Output Flow" ;
  rdfs:comment "An activity has one or more output flows.".

:FlowDataset a owl:Class ;
  rdfs:label "Flow Dataset" ;
  rdfs:comment "A dataset containing information about a flow.".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A source of inventory data for the LCA study.".

:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "A material or energy source used in the LCA study.".

:Emission a owl:Class ;
  rdfs:label "Emission" ;
  rdfs:comment "A release of pollutants into the environment during the LCA study.".

:Product a owl:Class ;
  rdfs:label "Product" ;
  rdfs:comment "A material or energy output of the LCA study.".

:FunctionalUnit a owl:DatatypeProperty ;
  rdfs:label "Functional Unit" ;
  rdfs:comment "The unit of measurement for the LCA study.".

:Scope a owl:DatatypeProperty ;
  rdfs:label "Scope" ;
  rdfs:comment "The system boundary for the LCA study.".

:SystemBoundary a owl:Class ;
  rdfs:label "System Boundary" ;
  rdfs:comment "The physical or functional limits of the LCA study.".

:ResponsibleAgent a owl:DatatypeProperty ;
  rdfs:label "Responsible Agent" ;
  rdfs:comment "The entity responsible for conducting the LCA study.".

:ImpactResult a owl:Class ;
  rdfs:label "Impact Result" ;
  rdfs:comment "The environmental impact of a flow or activity.".

:ImpactCategory a owl:Class ;
  rdfs:label "Impact Category" ;
  rdfs:comment "A category of environmental impact.".

:ContributesTo a owl:ObjectProperty ;
  rdfs:label "Contributes To" ;
  rdfs:comment "A relationship between a flow and an impact category, indicating the flow's contribution to the impact category.".

:SignificantContributor a owl:Class ;
  rdfs:label "Significant Contributor" ;
  rdfs:comment "A flow that contributes significantly (e.g., > 2%) to an impact category.".

:TopContributor a owl:Class ;
  rdfs:label "Top Contributor" ;
  rdfs:comment "The flow that contributes the most to an impact category for a given activity.".

:TotalAmount a owl:DatatypeProperty ;
  rdfs:label "Total Amount" ;
  rdfs:comment "The total amount of a flow within the system boundary.".