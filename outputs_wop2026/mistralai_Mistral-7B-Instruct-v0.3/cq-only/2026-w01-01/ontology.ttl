@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Ontology Design Pattern for LCA Model" ;
  rdfs:comment "This ontology supports competency questions related to LCA models.".

# Classes
:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An action or process in a system model.".

:Flow a owl:Class ;
  rdfs:label "Flow" ;
  rdfs:comment "The movement of matter or energy within or between activities.".

:FlowDataset a owl:Class ;
  rdfs:label "Flow Dataset" ;
  rdfs:comment "A dataset associated with a flow.".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A data storage system.".

:ImpactCategory a owl:Class ;
  rdfs:label "Impact Category" ;
  rdfs:comment "A category of environmental impact.".

:ImpactResult a owl:Class ;
  rdfs:label "Impact Result" ;
  rdfs:comment "The outcome of an impact assessment.".

:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "A material or energy input to an activity.".

:Emission a owl:Class ;
  rdfs:label "Emission" ;
  rdfs:comment "A waste or pollutant output from an activity.".

:Product a owl:Class ;
  rdfs:label "Product" ;
  rdfs:comment "A material or energy output from an activity.".

:ElementaryFlow a owl:ObjectProperty ;
  rdfs:domain :Activity ;
  rdfs:range :Flow ;
  rdfs:label "Elementary Flow" ;
  rdfs:comment "The direct input or output of an activity.".

:IntermediateFlow a owl:ObjectProperty ;
  rdfs:domain :Activity ;
  rdfs:range :Flow ;
  rdfs:label "Intermediate Flow" ;
  rdfs:comment "A flow that is transformed or transferred within an activity.".

:HasFlowDataset a owl:ObjectProperty ;
  rdfs:domain :Flow ;
  rdfs:range :FlowDataset ;
  rdfs:label "Has Flow Dataset" ;
  rdfs:comment "The dataset associated with a flow.".

:GeneratedBy a owl:ObjectProperty ;
  rdfs:domain :FlowDataset ;
  rdfs:range :Database ;
  rdfs:label "Generated By" ;
  rdfs:comment "The database from which a flow dataset is generated.".

:HasImpactResult a owl:ObjectProperty ;
  rdfs:domain :Activity ;
  rdfs:range :ImpactResult ;
  rdfs:label "Has Impact Result" ;
  rdfs:comment "The impact result of an activity.".

:ContributesTo a owl:ObjectProperty ;
  rdfs:domain :Flow ;
  rdfs:range :ImpactCategory ;
  rdfs:label "Contributes To" ;
  rdfs:comment "The impact category contributed by a flow.".

:HasSignificantContribution a owl:ObjectProperty ;
  rdfs:domain :ImpactCategory ;
  rdfs:range :Flow ;
  rdfs:label "Has Significant Contribution" ;
  rdfs:comment "A flow that significantly contributes to an impact category.".

:HasTopContributor a owl:ObjectProperty ;
  rdfs:domain :Activity ;
  rdfs:range :Flow ;
  rdfs:label "Has Top Contributor" ;
  rdfs:comment "The top contributor flow for an activity.".

:HasTotalAmount a owl:ObjectProperty ;
  rdfs:domain :Flow ;
  rdfs:range xsd:decimal ;
  rdfs:label "Has Total Amount" ;
  rdfs:comment "The total amount of a flow within the system boundary.".