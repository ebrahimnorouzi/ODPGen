@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "APLO Ontology" ;
  rdfs:comment "This ontology models the pedagogical organization, objectives, evaluation, feedback, learner context, and learner awareness in an educational setting.".

# Pedagogical Organization
:Framework a owl:Class ;
  rdfs:label "Framework" ;
  rdfs:comment "A collection of interrelated concepts or principles that provide a structure for understanding a subject or system.".

:Element a owl:Class ;
  rdfs:label "Element" ;
  rdfs:comment "A constituent part or aspect of a framework, objective, technique, resource, or assessment exercise.".

:Order a owl:ObjectProperty ;
  rdfs:domain :Framework ;
  rdfs:range :Element ;
  rdfs:label "Order" ;
  rdfs:comment "The sequence in which elements are presented or executed within a framework.".

# Objective Alignment
:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound goal that a learner aims to achieve.".

:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A method or strategy used to facilitate learning.".

:LearningResource a owl:Class ;
  rdfs:label "Learning Resource" ;
  rdfs:comment "A material or tool used to support learning.".

:Alignment a owl:ObjectProperty ;
  rdfs:domain (:LearningObjective :PedagogicalTechnique :LearningResource) ;
  rdfs:range (:LearningObjective :PedagogicalTechnique :LearningResource) ;
  rdfs:label "Alignment" ;
  rdfs:comment "The relationship between a learning objective, pedagogical technique, or learning resource.".

# Evaluation
:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An activity designed to measure a learner's understanding or performance.".

:EvaluationTechnique a owl:Class ;
  rdfs:label "Evaluation Technique" ;
  rdfs:comment "A method or strategy used to assess a learner's understanding or performance.".

:Metric a owl:Class ;
  rdfs:label "Metric" ;
  rdfs:comment "A quantifiable measure used to evaluate a learner's understanding or performance.".

:Result a owl:Class ;
  rdfs:label "Result" ;
  rdfs:comment "The outcome of an assessment exercise, including feedback, awareness observations, or learning strategies used.".

:Produces a owl:ObjectProperty ;
  rdfs:domain :AssessmentExercise ;
  rdfs:range (:Result :EvaluationTechnique :Metric) ;
  rdfs:label "Produces" ;
  rdfs:comment "The relationship between an assessment exercise and its results, evaluation techniques, or metrics.".

# Feedback
:FeedbackResponse a owl:Class ;
  rdfs:label "Feedback Response" ;
  rdfs:comment "A response provided to a learner in response to an assessment exercise.".

:Source a owl:DatatypeProperty ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:string ;
  rdfs:label "Source" ;
  rdfs:comment "The origin of the feedback response.".

:Temporal a owl:DatatypeProperty ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:dateTime ;
  rdfs:label "Temporal" ;
  rdfs:comment "The time at which the feedback response was provided.".

# Learner Context
:Goal a owl:Class ;
  rdfs:label "Goal" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound goal that a learner aims to achieve.".

:Preference a owl:Class ;
  rdfs:label "Preference" ;
  rdfs:comment "A learner's expressed preference for a particular topic or skill.".

:Challenge a owl:Class ;
  rdfs:label "Challenge" ;
  rdfs:comment "A learner's difficulty or obstacle in understanding a particular topic or skill.".

:Situation a owl:Class ;
  rdfs:label "Situation" ;
  rdfs:comment "A learner's current or past context that may influence learning.".

# Learner Awareness
:Topic a owl:Class ;
  rdfs:label "Topic" ;
  rdfs:comment "A subject of study or discussion.".

:Skill a owl:Class ;
  rdfs:label "Skill" ;
  rdfs:comment "An ability or competency that a learner may possess or develop.".

:Awareness a owl:Class ;
  rdfs:label "Awareness" ;
  rdfs:comment "A learner's level of understanding or knowledge about a topic or skill.".

:TopicOrSkill a owl:Class ;
  rdfs:subClassOf [ owl:unionOf (:Topic :Skill) ] ;
  rdfs:label "Topic or Skill" ;
  rdfs:comment "A subject of study or a competency that a learner may possess or develop.".

:AwarenessOf a owl:ObjectProperty ;
  rdfs:domain :Awareness ;
  rdfs:range :TopicOrSkill ;
  rdfs:label "Awareness Of" ;
  rdfs:comment "The topic or skill that a learner is aware of.".

:ChangesOverTime a owl:ObjectProperty ;
  rdfs:domain :Awareness ;
  rdfs:range xsd:date ;
  rdfs:label "Changes Over Time" ;
  rdfs:comment "The time at which a learner's awareness of a topic or skill changed.".