@prefix :     <http://example.org/odp#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.

:Ontology a owl:Ontology ;
  rdfs:label "LCA Study for StorAIge Project" ;
  rdfs:comment "An ontology network for the LCA study of the StorAIge project, evaluating the environmental impact of a Near Memory Computing prototype based on C-SRAM technology.".

# Study metadata
:Study a owl:Class ;
  rdfs:label "Study" ;
  rdfs:comment "Represents a LCA study.".

:Hypothesis a owl:Class ;
  rdfs:label "Hypothesis" ;
  rdfs:comment "A statement made before the experiment, based on which the study is conducted." ;
  rdf:type owl:AnnotationProperty ;
  owl:hasRange xsd:string.

:Parametrisation a owl:Class ;
  rdfs:label "Parametrisation" ;
  rdfs:comment "Parameters used in the study.".

:SystemBoundary a owl:Class ;
  rdfs:label "System Boundary" ;
  rdfs:comment "Defines the scope of the study.".

:Actor a owl:Class ;
  rdfs:label "Actor" ;
  rdfs:comment "Participants involved in the study.".

# Inventory data
:Inventory a owl:Class ;
  rdfs:label "Inventory" ;
  rdfs:comment "Data related to the Bill of Materials describing the electronic components of the prototype.".

:BillOfMaterials a owl:Class ;
  rdfs:label "Bill of Materials" ;
  rdfs:comment "A list of components used in the prototype.".

:Component a owl:Class ;
  rdfs:label "Component" ;
  rdfs:comment "An electronic component used in the prototype.".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A source of inventory data.".

:DatabaseVersion a owl:Class ;
  rdfs:label "Database Version" ;
  rdfs:comment "Specific version of a database.".

:InventoryData a owl:Class ;
  rdfs:label "Inventory Data" ;
  rdfs:comment "Data related to the inventory of components.".

# Environmental impact data
:Impact a owl:Class ;
  rdfs:label "Impact" ;
  rdfs:comment "Environmental impact data calculated using the EF 3.0 methodology.".

:Methodology a owl:Class ;
  rdfs:label "Methodology" ;
  rdfs:comment "The environmental impact calculation methodology used in the study.".

:EnvironmentalFootprint3_0 a owl:Class ;
  rdfs:label "Environmental Footprint 3.0" ;
  rdfs:comment "The Environmental Footprint 3.0 methodology.".

:ImpactData a owl:Class ;
  rdfs:label "Impact Data" ;
  rdfs:comment "Data related to the environmental impact.".

# Disjointness axioms
:Actor disjointWith :Component.
:Database disjointWith :Component.
:DatabaseVersion disjointWith :Component.
:InventoryData disjointWith :Component.
:ImpactData disjointWith :Component.