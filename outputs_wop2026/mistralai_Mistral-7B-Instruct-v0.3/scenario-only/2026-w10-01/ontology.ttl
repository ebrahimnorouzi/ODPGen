@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Digital Asset Matchmaker Ontology" ;
  rdfs:comment "This ontology models the semantic management of digital assets for supporting interoperability in the SMARTY project's matchmaker, which dynamically allocates hardware resources based on software requirements.".

# Digital Asset
:DigitalAsset a owl:Class ;
  rdfs:label "Digital Asset" ;
  rdfs:comment "A digital object that can be managed, such as software or data.".

:hasName a owl:ObjectProperty ;
  rdfs:domain :DigitalAsset ;
  rdfs:range xsd:string ;
  rdfs:label "hasName" ;
  rdfs:comment "The name of the digital asset.".

:hasVersion a owl:DatatypeProperty ;
  rdfs:domain :DigitalAsset ;
  rdfs:range xsd:string ;
  rdfs:label "hasVersion" ;
  rdfs:comment "The version of the digital asset.".

:hasRequirements a owl:ObjectProperty ;
  rdfs:domain :DigitalAsset ;
  rdfs:range :SoftwareRequirements ;
  rdfs:label "hasRequirements" ;
  rdfs:comment "The software requirements of the digital asset.".

# Software Requirements
:SoftwareRequirements a owl:Class ;
  rdfs:label "Software Requirements" ;
  rdfs:comment "The requirements that a digital asset has for execution, support, or deployment.".

:requiresDPU a owl:ObjectProperty ;
  rdfs:domain :SoftwareRequirements ;
  rdfs:range xsd:decimal ;
  rdfs:label "requiresDPU" ;
  rdfs:comment "The minimum DPU requirement for the digital asset.".

:requiresGPU a owl:ObjectProperty ;
  rdfs:domain :SoftwareRequirements ;
  rdfs:range xsd:decimal ;
  rdfs:label "requiresGPU" ;
  rdfs:comment "The minimum GPU requirement for the digital asset.".

# Hardware Resource
:HardwareResource a owl:Class ;
  rdfs:label "Hardware Resource" ;
  rdfs:comment "A physical or virtual resource that can be allocated to execute, support, or deploy a digital asset.".

:hasDPU a owl:ObjectProperty ;
  rdfs:domain :HardwareResource ;
  rdfs:range xsd:decimal ;
  rdfs:label "hasDPU" ;
  rdfs:comment "The DPU capacity of the hardware resource.".

:hasGPU a owl:ObjectProperty ;
  rdfs:domain :HardwareResource ;
  rdfs:range xsd:decimal ;
  rdfs:label "hasGPU" ;
  rdfs:comment "The GPU capacity of the hardware resource.".

:isCompatibleWith a owl:ObjectProperty ;
  rdfs:domain :DigitalAsset ;
  rdfs:range :HardwareResource ;
  rdfs:label "isCompatibleWith" ;
  rdfs:comment "Indicates whether a digital asset can be executed, supported, or deployed on a given hardware resource.".

:Ontology a owl:Ontology ;
  owl:imports <http://example.org/hardware-resources.ttl> ;
  owl:imports <http://example.org/software-catalog.ttl>.