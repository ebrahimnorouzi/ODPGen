# Do NOT score this file as a complete ontology; see metadata.json.
@prefix :     <http://example.org/odp#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.

:Ontology a owl:Ontology ;
    rdfs:label "WISDOM Stress Detection Ontology" ;
    rdfs:comment "A formalized and extensible conceptual data model for representing stress conditions, sensor- and wearable-device-related data structures.".

# Stressors
:Stressor a owl:Class ;
    rdfs:label "Stressor" ;
    rdfs:comment "An event, condition, or stimulus that has the potential to induce stress in a subject.".

# Stress States
:StressState a owl:Class ;
    rdfs:label "Stress State" ;
    rdfs:comment "A subjective state of stress experienced by a subject.".

# Physiological Responses
:PhysiologicalResponse a owl:Class ;
    rdfs:label "Physiological Response" ;
    rdfs:comment "A measurable change in a physiological system in response to a stressor.".

# Sensor Measurements
:SensorMeasurement a owl:Class ;
    rdfs:label "Sensor Measurement" ;
    rdfs:comment "A direct or indirect measurement of a physiological or behavioral response.".

:hasSensor a owl:ObjectProperty ;
    rdfs:domain :SensorMeasurement ;
    rdfs:range :Sensor ;
    rdfs:label "Has Sensor" ;
    rdfs:comment "The sensor used to measure the physiological or behavioral response.".

:hasChannel a owl:ObjectProperty ;
    rdfs:domain :SensorMeasurement ;
    rdfs:range :Channel ;
    rdfs:label "Has Channel" ;
    rdfs:comment "The specific channel of the sensor used to measure the physiological or behavioral response.".

:hasObservableProperty a owl:ObjectProperty ;
    rdfs:domain :SensorMeasurement ;
    rdfs:range :ObservableProperty ;
    rdfs:label "Has Observable Property" ;
    rdfs:comment "The observable property being measured by the sensor.".

:hasSubject a owl:ObjectProperty ;
    rdfs:domain :SensorMeasurement ;
    rdfs:range :Subject ;
    rdfs:label "Has Subject" ;
    rdfs:comment "The subject to whom the sensor measurement pertains.".

:hasActivityPhase a owl:ObjectProperty ;
    rdfs:domain :SensorMeasurement ;
    rdfs:range :ActivityPhase ;
    rdfs:label "Has Activity Phase" ;
    rdfs:comment "The phase of the activity during which the sensor measurement was taken.".

# Contextual Factors
:ContextualFactor a owl:Class ;
    rdfs:label "Contextual Factor" ;
    rdfs:comment "Factors that may influence the stress response, such as environment, social context, or task demands.".