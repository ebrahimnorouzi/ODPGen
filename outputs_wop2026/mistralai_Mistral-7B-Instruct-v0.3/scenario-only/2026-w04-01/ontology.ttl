@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Reverse Engineering Knowledge Graph" ;
  rdfs:comment "A knowledge graph for visualizing the structure of a binary executable and detecting dependency vulnerabilities in a software supply chain.".

# Symbols
:Symbol a owl:Class ;
  rdfs:label "Symbol" ;
  rdfs:comment "A named entity in a binary executable.".

:Name a owl:DatatypeProperty ;
  rdfs:label "Name" ;
  rdfs:comment "The original name of the symbol." ;
  rdf:domain :Symbol ;
  rdfs:range xsd:string.

:Type a owl:ObjectProperty ;
  rdfs:label "Type" ;
  rdfs:comment "The type of the symbol (e.g., variable, function)." ;
  rdf:domain :Symbol ;
  rdfs:range :SymbolType.

:SymbolType a owl:Class ;
  rdfs:label "Symbol Type" ;
  rdfs:comment "A category of symbols (e.g., variable, function)." ;
  rdf:subClassOf owl:Class.

# Relationships between symbols
:Uses a owl:ObjectProperty ;
  rdfs:label "Uses" ;
  rdfs:comment "A symbol that uses another symbol." ;
  rdf:domain :Symbol ;
  rdfs:range :Symbol.

:Defines a owl:ObjectProperty ;
  rdfs:label "Defines" ;
  rdfs:comment "A symbol that defines another symbol." ;
  rdf:domain :Symbol ;
  rdfs:range :Symbol.