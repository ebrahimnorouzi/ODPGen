# Do NOT score this file as a complete ontology; see metadata.json.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Smarty Edge Computing Resource Matchmaker Ontology" ;
  rdfs:comment "An ontology for describing software and hardware resources in the Smarty project.".

# Atomic Requirements
:SoftwareRequirement a owl:Class ;
  rdfs:label "Software Requirement" ;
  rdfs:comment "A requirement expressed by a software.".

:HardwareRequirement a owl:Class ;
  rdfs:label "Hardware Requirement" ;
  rdfs:comment "A requirement expressed by a software for hardware resources.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A piece of software.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware resource.".

:SoftwareProperty a owl:Class ;
  rdfs:label "Software Property" ;
  rdfs:comment "A property of a software.".

:HardwareProperty a owl:Class ;
  rdfs:label "Hardware Property" ;
  rdfs:comment "A property of a hardware resource.".

:SoftwareVersion a owl:Class ;
  rdfs:label "Software Version" ;
  rdfs:comment "A version of a software.".

# Properties
:hasRequirement owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareRequirement ;
  rdfs:label "Has Requirement" ;
  rdfs:comment "A software has a requirement.".

:requires owl:ObjectProperty ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range :(Hardware | Software) ;
  rdfs:label "Requires" ;
  rdfs:comment "A requirement requires a software or hardware resource.".

:hasProperty owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareProperty ;
  rdfs:label "Has Property" ;
  rdfs:comment "A software has a property.".

:hasVersion owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareVersion ;
  rdfs:label "Has Version" ;
  rdfs:comment "A software has a version.".

:propertyValue owl:DatatypeProperty ;
  rdfs:domain :SoftwareProperty ;
  rdfs:range xsd:string ;
  rdfs:label "Property Value" ;
  rdfs:comment "The value of a software property.".

:version owl:DatatypeProperty ;
  rdfs:domain :SoftwareVersion ;
  rdfs:range xsd:string ;
  rdfs:label "Version" ;
  rdfs:comment "The version of a software.".