# Do NOT score this file as a complete ontology; see metadata.json.
@prefix :     <http://example.org/odp#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#>.

:Ontology a owl:Ontology ;
  rdfs:label "WISDOM Ontology for Stress Detection" ;
  rdfs:comment "A formalized and extensible conceptual data model for representing stress conditions, sensor- and wearable-device-related data structures.".

# Requirement 1: Stress-related conditions
:StressCondition a owl:Class ;
  rdfs:label "Stress Condition" ;
  rdfs:comment "A condition that may induce stress in a subject.".

:CognitiveStress a :StressCondition ;
  rdfs:label "Cognitive Stress".

:SocioEvaluativeStress a :StressCondition ;
  rdfs:label "Socio-Evaluative Stress".

:PhysicalStress a :StressCondition ;
  rdfs:label "Physical Stress".

# Requirement 2: Stressors
:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "An event, condition, or stimulus that has the potential to induce stress in a subject.".

# Requirement 3: Short-term stressors
:ShortTermStressor a :Stressor ;
  rdfs:label "Short-Term Stressor".

# Requirement 4: Stress responses
:StressResponse a owl:Class ;
  rdfs:label "Stress Response" ;
  rdfs:comment "A physiological or behavioral response to a stressor.".

# Requirement 5: Baseline or recovery states
:BaselineState a :StressCondition ;
  rdfs:label "Baseline State".

:RecoveryState a :StressCondition ;
  rdfs:label "Recovery State".

# Requirement 6: Activities or experimental phases
:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An activity or experimental phase during which stress-related measurements are taken.".

# Requirement 7: Linking activities to stress conditions
:HasStressCondition owl:ObjectProperty ;
  rdfs:domain :Activity ;
  rdfs:range :StressCondition ;
  rdfs:label "Has Stress Condition".

# Requirement 8: Linking stressors to activity phases
:OccursDuring owl:ObjectProperty ;
  rdfs:domain :Stressor ;
  rdfs:range :Activity ;
  rdfs:label "Occurs During".