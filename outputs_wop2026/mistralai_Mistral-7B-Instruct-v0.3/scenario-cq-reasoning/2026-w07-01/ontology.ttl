:Ontology a owl:Ontology ;
  rdfs:label "APLO Ontology" ;
  rdfs:comment "Ontology for Adaptive Pedagogical Learning Organization".

# Pedagogical Framework
:PedagogicalFramework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A structured set of pedagogical elements.".

:hasFramework rdf:Property ;
  rdfs:domain :LearningObjective ;
  rdfs:range :PedagogicalFramework ;
  rdfs:label "Has Framework" ;
  rdfs:comment "The pedagogical framework associated with a learning objective.".

:containsFramework rdf:Property ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :PedagogicalElement ;
  rdfs:label "Contains Framework" ;
  rdfs:comment "A pedagogical element that belongs to a specific pedagogical framework.".

# Pedagogical Element
:PedagogicalElement a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "A component of a pedagogical framework.".

:precedes rdf:Property ;
  rdfs:domain :PedagogicalElement ;
  rdfs:range :PedagogicalElement ;
  rdfs:label "Precedes" ;
  rdfs:comment "A pedagogical element that occurs before another pedagogical element.".

# Learning Objective
:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A specific learning goal.".

:requiresPriorKnowledge rdf:Property ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Topic ;
  rdfs:label "Requires Prior Knowledge" ;
  rdfs:comment "A topic that must be known before a learning objective can be achieved.".

:developsSkill rdf:Property ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Skill ;
  rdfs:label "Develops Skill" ;
  rdfs:comment "A skill that is developed by a learning objective.".

# Pedagogical Technique
:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A method or strategy used to facilitate learning.".

:supportsLearningObjective rdf:Property ;
  rdfs:domain :PedagogicalTechnique ;
  rdfs:range :LearningObjective ;
  rdfs:label "Supports Learning Objective" ;
  rdfs:comment "A pedagogical technique that can help achieve a learning objective.".

# Learning Resource
:LearningResource a owl:Class ;
  rdfs:label "Learning Resource" ;
  rdfs:comment "A material or tool used to support learning.".

:alignsToLearningObjective rdf:Property ;
  rdfs:domain :LearningResource ;
  rdfs:range :LearningObjective ;
  rdfs:label "Aligns to Learning Objective" ;
  rdfs:comment "A learning resource that is aligned with a specific learning objective.".

# Assessment Exercise
:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An activity used to evaluate learning progress.".

:evaluatesLearningObjective rdf:Property ;
  rdfs:domain :AssessmentExercise ;
  rdfs:range :LearningObjective ;
  rdfs:label "Evaluates Learning Objective" ;
  rdfs:comment "An assessment exercise that evaluates a specific learning objective.".

:usesEvaluationTechnique rdf:Property ;
  rdfs:domain :AssessmentExercise ;
  rdfs:range :EvaluationTechnique ;
