:usesEvaluationMetric rdf:Property ;
  rdfs:domain :EvaluationTechnique ;
  rdfs:range :EvaluationMetric ;
  rdfs:label "Uses Evaluation Metric" ;
  rdfs:comment "An evaluation technique that uses a specific evaluation metric.".

