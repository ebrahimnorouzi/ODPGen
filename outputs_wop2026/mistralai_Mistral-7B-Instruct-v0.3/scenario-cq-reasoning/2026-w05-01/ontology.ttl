@prefix :     <http://example.org/odp#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.

:Ontology a owl:Ontology ;
  rdfs:label "Foundation Model Prompting Ontology" ;
  rdfs:comment "An ontology for describing foundation models, tasks, prompts, and their relationships.".

# Task
:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "A specific problem or objective that a foundation model is expected to solve.".

# Data Modality
:DataModality a owl:Class ;
  rdfs:label "Data Modality" ;
  rdfs:comment "The type of data that a foundation model can process.".

# Task Constraint
:TaskConstraint a owl:Class ;
  rdfs:label "Task Constraint" ;
  rdfs:comment "A specific condition or requirement that a task may have.".

# Foundation Model Architecture
:FoundationModelArchitecture a owl:Class ;
  rdfs:label "Foundation Model Architecture" ;
  rdfs:comment "The structure of a foundation model, determined by available resources.".

# Foundation Model
:FoundationModel a owl:Class ;
  rdfs:label "Foundation Model" ;
  rdfs:comment "A large-scale model trained on diverse data sources.".

# Model Family, Variant, Evolution
:ModelFamily a owl:Class ;
  rdfs:label "Model Family" ;
  rdfs:comment "A group of foundation models sharing common characteristics.".

:ModelVariant a owl:Class ;
  rdfs:label "Model Variant" ;
  rdfs:comment "A specific version or configuration of a foundation model.".

:ModelEvolution a owl:Class ;
  rdfs:label "Model Evolution" ;
  rdfs:comment "An updated or improved version of a foundation model.".

# Prompting Technique
:PromptingTechnique a owl:Class ;
  rdfs:label "Prompting Technique" ;
  rdfs:comment "A method for structuring prompts to foundation models.".

# Prompt
:Prompt a owl:Class ;
  rdfs:label "Prompt" ;
  rdfs:comment "A statement or question submitted to a foundation model.".

# Response
:Response a owl:Class ;
  rdfs:label "Response" ;
  rdfs:comment "The output generated by a foundation model in response to a prompt.".

# hasTask
:Task rdfs:domain :Prompt ;
  rdfs:range :Task ;
  owl:inverseOf :hasPrompt.

# hasDataModality
:Task rdfs:domain :Task ;
  rdfs:range :DataModality ;
  owl:inverseOf :supportsDataModality.

# hasConstraint
:Task rdfs:domain :Task ;
  rdfs:range :TaskConstraint ;
  owl:inverseOf :hasTaskConstraint.

# hasArchitecture
:FoundationModel rdfs:domain :FoundationModel ;
  rdfs:range :FoundationModelArchitecture ;
  owl:inverseOf :hasModelArchitecture.

# hasModelFamily
:FoundationModel rdfs:domain :FoundationModel ;
  rdfs:range :ModelFamily ;
  owl:inverseOf :hasModelFamily.

# hasModelVariant
:FoundationModel rdfs:domain :FoundationModel ;
  rdfs:range :ModelVariant ;
  owl:inverseOf :hasModelVariant.

# hasModelEvolution
:FoundationModel rdfs:domain :FoundationModel ;
  rdfs:range :ModelEvolution ;
  owl:inverseOf :hasModelEvolution.

# hasPromptingTechnique
:Prompt rdfs:domain :Prompt ;
  rdfs:range :PromptingTechnique ;
  owl:inverseOf :hasPromptingTechnique.

# hasResponse
:Prompt rdfs:domain :Prompt ;
  rdfs:range :Response ;
  owl:inverseOf :hasPrompt.

# hasChatCount
:FoundationModel rdfs:domain :FoundationModel ;
  rdfs:range xsd:nonNegativeInteger ;
  owl:inverseOf :hasModelChatCount.

# hasSuitablePromptingTechnique
:Task rdfs:domain :Task ;
  rdfs:range :PromptingTechnique ;
  owl:inverseOf :hasSuitableTask.

# hasSuitableDataModality
:Task rdfs:domain :Task ;
  rdfs:range :DataModality ;
  owl:inverseOf :hasSuitableDataModality.

# hasSuitableConstraint
:Task rdfs:domain :Task ;
  rdfs:range :TaskConstraint ;
  owl:inverseOf :hasSuitableTaskConstraint.

# Examples (not included in the ontology schema)
:Task1 a :Task ;
  rdfs:label "Task 1" ;
  :hasDataModality :Text ;
  :hasTaskConstraint :TimeConstraint.

:Task2 a :Task ;
  rdfs:label "Task 2" ;
  :hasDataModality :Image ;
  :hasTaskConstraint :SizeConstraint.

:Prompt1 a :Prompt ;
  rdfs:label "Prompt 1" ;
  :hasPromptingTechnique :TemplatePrompt ;
  :hasTask :Task1 ;
  :hasResponse :Response1.

:Prompt2 a :Prompt ;
  rdfs:label "Prompt 2" ;
  :hasPromptingTechnique :ChainOfThoughtPrompt ;
  :hasTask :Task2 ;
  :hasResponse :Response2.

:FoundationModel1 a :FoundationModel ;
  rdfs:label "Foundation Model 1" ;
  :hasModelFamily :Transformer ;
  :hasModelVariant :Vicuna ;
  :hasModelEvolution :VicunaV2 ;
  :hasModelArchitecture :MLP ;
  :hasModelChatCount 100.

:FoundationModel2 a :FoundationModel ;
  rdfs:label "Foundation Model 2" ;
  :hasModelFamily :Transformer ;
  :hasModelVariant :Vicuna ;
  :hasModelEvolution :VicunaV3 ;
  :hasModelArchitecture :CNN ;
  :hasModelChatCount 200.

:TemplatePrompt a :PromptingTechnique ;
  rdfs:label "Template Prompt".

:ChainOfThoughtPrompt a :PromptingTechnique ;
  rdfs:label "Chain of Thought Prompt".

:TimeConstraint a :TaskConstraint ;
  rdfs:label "Time Constraint".

:SizeConstraint a :TaskConstraint ;
  rdfs:label "Size Constraint".