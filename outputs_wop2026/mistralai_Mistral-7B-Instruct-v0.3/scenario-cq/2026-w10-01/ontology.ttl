@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Edge Computing Matchmaker Ontology" ;
  rdfs:comment "An ontology for describing software and hardware requirements and resources in the SMARTY project's edge computing matchmaker.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A piece of software with requirements and characteristics.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A specific need or condition that a software has.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A physical device with characteristics.".

:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "Either software or hardware that can be used to execute, support, or deploy other software.".

:HasRequirement a owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :Requirement ;
  rdfs:label "hasRequirement" ;
  rdfs:comment "The requirement that a software has.".

:RequiresResource a owl:ObjectProperty ;
  rdfs:domain :Software ;
  rdfs:range :Resource ;
  rdfs:label "requiresResource" ;
  rdfs:comment "The software or hardware that a software requires.".

:RequirementType a owl:DatatypeProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:string ;
  rdfs:label "requirementType" ;
  rdfs:comment "The type of the requirement (e.g., CPU, memory, version).".

:RequirementValue a owl:DatatypeProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:decimal ;
  rdfs:label "requirementValue" ;
  rdfs:comment "The minimum, maximum, or exact value of the requirement.".

:RequiresSoftwareVersion a owl:DatatypeProperty ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:string ;
  rdfs:label "requiresSoftwareVersion" ;
  rdfs:comment "The required version of a software.".

:HasType a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range :RequirementType ;
  rdfs:label "hasType" ;
  rdfs:comment "The type of the requirement.".

:HasValue a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range :RequirementValue ;
  rdfs:label "hasValue" ;
  rdfs:comment "The value of the requirement.".

:HasSoftwareVersion a owl:ObjectProperty ;
  rdfs:domain :Requirement ;
  rdfs:range :RequiresSoftwareVersion ;
  rdfs:label "hasSoftwareVersion" ;
  rdfs:comment "The required version of a software.".

:IsResource a owl:ObjectProperty ;
  rdfs:domain :Resource ;
  rdfs:range :Hardware ;
  rdfs:inverseOf :requiresResource ;
  rdfs:label "isResource" ;
  rdfs:comment "The hardware that can be used as a resource.".