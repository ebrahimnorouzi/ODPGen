@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Prompting and Foundation Model Selection ODP" ;
    rdfs:comment "An ontology design pattern for representing tasks, prompting techniques, foundation models, modalities, constraints, chats, prompts, and responses in order to support prompt design and analysis of prior chat usage patterns." .

:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "A problem or objective that a user needs to solve by prompting a foundation model." .

:PromptingTechnique a owl:Class ;
    rdfs:label "Prompting technique" ;
    rdfs:comment "A technique used to formulate prompts for solving a task with a foundation model." .

:FoundationModel a owl:Class ;
    rdfs:label "Foundation model" ;
    rdfs:comment "A foundation model that can be prompted to perform tasks and produce responses." .

:ModelArchitecture a owl:Class ;
    rdfs:label "Model architecture" ;
    rdfs:comment "An architecture of a foundation model." .

:ModelFamily a owl:Class ;
    rdfs:label "Model family" ;
    rdfs:comment "A family grouping related foundation models." .

:DataModality a owl:Class ;
    rdfs:label "Data modality" ;
    rdfs:comment "A modality of data involved in a task or processable by a foundation model." .

:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A constraint that applies to a task or to model selection." .

:ConstraintVariable a owl:Class ;
    rdfs:label "Constraint variable" ;
    rdfs:comment "A variable or aspect on which a constraint is imposed." .

:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "An available resource that influences the choice of model architecture." .

:Chat a owl:Class ;
    rdfs:label "Chat" ;
    rdfs:comment "A prior or current conversation consisting of prompts and responses submitted to a foundation model." .

:Prompt a owl:Class ;
    rdfs:label "Prompt" ;
    rdfs:comment "A prompt submitted in a chat, possibly based on a prompting technique and targeting a task." .

:Response a owl:Class ;
    rdfs:label "Response" ;
    rdfs:comment "A response generated by a foundation model for a prompt." .

:hasDataModality a owl:ObjectProperty ;
    rdfs:label "has data modality" ;
    rdfs:comment "Relates a task or foundation model to a data modality involved in the task or processable by the model." ;
    rdfs:domain owl:Thing ;
    rdfs:range :DataModality .

:hasConstraint a owl:ObjectProperty ;
    rdfs:label "has constraint" ;
    rdfs:comment "Relates a task to a constraint that applies to it." ;
    rdfs:domain :Task ;
    rdfs:range :Constraint .

:hasConstraintVariable a owl:ObjectProperty ;
    rdfs:label "has constraint variable" ;
    rdfs:comment "Relates a constraint to the variable or aspect on which the constraint is imposed." ;
    rdfs:domain :Constraint ;
    rdfs:range :ConstraintVariable .

:hasSuitablePromptingTechnique a owl:ObjectProperty ;
    rdfs:label "has suitable prompting technique" ;
    rdfs:comment "Relates a task to a prompting technique considered suitable for solving it." ;
    rdfs:domain :Task ;
    rdfs:range :PromptingTechnique .

:hasArchitecture a owl:ObjectProperty ;
    rdfs:label "has architecture" ;
    rdfs:comment "Relates a foundation model to its architecture." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :ModelArchitecture .

:dependsOnResource a owl:ObjectProperty ;
    rdfs:label "depends on resource" ;
    rdfs:comment "Relates a model architecture to an available resource on which it depends." ;
    rdfs:domain :ModelArchitecture ;
    rdfs:range :Resource .

:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant" ;
    rdfs:comment "Relates a foundation model to one of its variants." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:hasEvolution a owl:ObjectProperty ;
    rdfs:label "has evolution" ;
    rdfs:comment "Relates a foundation model to one of its evolutions." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:memberOfFamily a owl:ObjectProperty ;
    rdfs:label "member of family" ;
    rdfs:comment "Relates a foundation model to the model family it belongs to." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :ModelFamily .

:usesModel a owl:ObjectProperty ;
    rdfs:label "uses model" ;
    rdfs:comment "Relates a chat or prompt to the foundation model used for it." ;
    rdfs:domain owl:Thing ;
    rdfs:range :FoundationModel .

:hasPrompt a owl:ObjectProperty ;
    rdfs:label "has prompt" ;
    rdfs:comment "Relates a chat to a prompt that occurs in it." ;
    rdfs:domain :Chat ;
    rdfs:range :Prompt .

:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response" ;
    rdfs:comment "Relates a chat or prompt to a response generated in that interaction." ;
    rdfs:domain owl:Thing ;
    rdfs:range :Response .

:isBasedOnTechnique a owl:ObjectProperty ;
    rdfs:label "is based on technique" ;
    rdfs:comment "Relates a prompt to the prompting technique on which it is based." ;
    rdfs:domain :Prompt ;
    rdfs:range :PromptingTechnique .

:targetsTask a owl:ObjectProperty ;
    rdfs:label "targets task" ;
    rdfs:comment "Relates a prompt to the task it is intended to solve." ;
    rdfs:domain :Prompt ;
    rdfs:range :Task .

:analyzesChat a owl:ObjectProperty ;
    rdfs:label "analyzes chat" ;
    rdfs:comment "Relates a design or analysis activity to a chat being analyzed." ;
    rdfs:domain owl:Thing ;
    rdfs:range :Chat .

:promptCount a owl:DatatypeProperty ;
    rdfs:label "prompt count" ;
    rdfs:comment "The number of prompts in a chat." ;
    rdfs:domain :Chat ;
    rdfs:range xsd:nonNegativeInteger .

:responseCount a owl:DatatypeProperty ;
    rdfs:label "response count" ;
    rdfs:comment "The number of responses in a chat." ;
    rdfs:domain :Chat ;
    rdfs:range xsd:nonNegativeInteger .

:conversationLength a owl:DatatypeProperty ;
    rdfs:label "conversation length" ;
    rdfs:comment "A statistic or measure of the length of a chat." ;
    rdfs:domain :Chat ;
    rdfs:range xsd:decimal .