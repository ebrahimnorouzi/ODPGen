@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Software and hardware requirement ontology design pattern" ;
    rdfs:comment "An ontology design pattern for representing software requirements over software and hardware resources, including required resource type, constrained property, and minimum, maximum, or exact required values and software versions." .

:Software a owl:Class ;
    rdfs:label "Software" ;
    rdfs:comment "A software asset whose requirements over software or hardware resources can be described." .

:Hardware a owl:Class ;
    rdfs:label "Hardware" ;
    rdfs:comment "A hardware resource that can be required by software." .

:Requirement a owl:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment "A requirement expressed by a software concerning needed software or hardware resources." .

:SoftwareRequirement a owl:Class ;
    rdfs:label "Software requirement" ;
    rdfs:comment "A requirement expressed by a software concerning required software." ;
    rdfs:subClassOf :Requirement .

:HardwareRequirement a owl:Class ;
    rdfs:label "Hardware requirement" ;
    rdfs:comment "A requirement expressed by a software concerning required hardware." ;
    rdfs:subClassOf :Requirement .

:Property a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "A characteristic or property of software or hardware that can be constrained by a requirement." .

:SoftwareType a owl:Class ;
    rdfs:label "Software type" ;
    rdfs:comment "A type or category of software that can be required by a software requirement." .

:HardwareType a owl:Class ;
    rdfs:label "Hardware type" ;
    rdfs:comment "A type or category of hardware that can be required by a hardware requirement." .

:hasRequirement a owl:ObjectProperty ;
    rdfs:label "has requirement" ;
    rdfs:comment "Relates a software to a requirement it expresses." ;
    rdfs:domain :Software ;
    rdfs:range :Requirement .

:requiresSoftware a owl:ObjectProperty ;
    rdfs:label "requires software" ;
    rdfs:comment "Relates a software to software that it requires." ;
    rdfs:domain :Software ;
    rdfs:range :Software .

:requiresHardware a owl:ObjectProperty ;
    rdfs:label "requires hardware" ;
    rdfs:comment "Relates a software to hardware that it requires." ;
    rdfs:domain :Software ;
    rdfs:range :Hardware .

:requiresSoftwareType a owl:ObjectProperty ;
    rdfs:label "requires software type" ;
    rdfs:comment "Relates a software requirement to the type of software required." ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range :SoftwareType .

:requiresHardwareType a owl:ObjectProperty ;
    rdfs:label "requires hardware type" ;
    rdfs:comment "Relates a hardware requirement to the type of hardware required." ;
    rdfs:domain :HardwareRequirement ;
    rdfs:range :HardwareType .

:constrainsProperty a owl:ObjectProperty ;
    rdfs:label "constrains property" ;
    rdfs:comment "Relates a requirement to the property of software or hardware whose value is constrained." ;
    rdfs:domain :Requirement ;
    rdfs:range :Property .

:requiredSoftware a owl:ObjectProperty ;
    rdfs:label "required software" ;
    rdfs:comment "Relates a software requirement to the software resource that is required." ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range :Software .

:requiredHardware a owl:ObjectProperty ;
    rdfs:label "required hardware" ;
    rdfs:comment "Relates a hardware requirement to the hardware resource that is required." ;
    rdfs:domain :HardwareRequirement ;
    rdfs:range :Hardware .

:minimumRequiredValue a owl:DatatypeProperty ;
    rdfs:label "minimum required value" ;
    rdfs:comment "Gives the minimum required value for a constrained property in a requirement." ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string .

:maximumRequiredValue a owl:DatatypeProperty ;
    rdfs:label "maximum required value" ;
    rdfs:comment "Gives the maximum required value for a constrained property in a requirement." ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string .

:exactRequiredValue a owl:DatatypeProperty ;
    rdfs:label "exact required value" ;
    rdfs:comment "Gives the exact required value for a constrained property in a requirement." ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string .

:minimumRequiredVersion a owl:DatatypeProperty ;
    rdfs:label "minimum required version" ;
    rdfs:comment "Gives the minimum required version for software required by a software requirement." ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string .

:maximumRequiredVersion a owl:DatatypeProperty ;
    rdfs:label "maximum required version" ;
    rdfs:comment "Gives the maximum required version for software required by a software requirement." ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string .

:exactRequiredVersion a owl:DatatypeProperty ;
    rdfs:label "exact required version" ;
    rdfs:comment "Gives the exact required version for software required by a software requirement." ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string .