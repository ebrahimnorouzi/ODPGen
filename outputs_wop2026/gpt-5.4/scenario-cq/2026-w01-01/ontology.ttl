# Do NOT score this file as a complete ontology; see metadata.json.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "LCA study and result ODP" ;
    rdfs:comment "An ontology design pattern for representing an LCA study, its activities, flows, data sources, methodology, study metadata, and impact results, grounded in the StorAIge scenario and competency questions." .

#################################################################
# Classes
#################################################################

:LCAStudy a owl:Class ;
    rdfs:label "LCA study" ;
    rdfs:comment "A life cycle assessment study." .

:SystemModel a owl:Class ;
    rdfs:label "system model" ;
    rdfs:comment "A model of the system assessed in the LCA study, including activities and their dependencies." .

:Activity a owl:Class ;
    rdfs:label "activity" ;
    rdfs:comment "A process or activity represented in the system model." .

:Flow a owl:Class ;
    rdfs:label "flow" ;
    rdfs:comment "A flow associated with activities in the LCA model." .

:ElementaryFlow a owl:Class ;
    rdfs:label "elementary flow" ;
    rdfs:comment "A flow exchanged with the environment." ;
    rdfs:subClassOf :Flow .

:IntermediateFlow a owl:Class ;
    rdfs:label "intermediate flow" ;
    rdfs:comment "A flow exchanged between activities within the technosphere." ;
    rdfs:subClassOf :Flow .

:ResourceFlow a owl:Class ;
    rdfs:label "resource flow" ;
    rdfs:comment "A flow classified as a resource." ;
    rdfs:subClassOf :Flow .

:EmissionFlow a owl:Class ;
    rdfs:label "emission flow" ;
    rdfs:comment "A flow classified as an emission." ;
    rdfs:subClassOf :Flow .

:ProductFlow a owl:Class ;
    rdfs:label "product flow" ;
    rdfs:comment "A flow classified as a product." ;
    rdfs:subClassOf :Flow .

:FlowDataset a owl:Class ;
    rdfs:label "flow dataset" ;
    rdfs:comment "A dataset describing a flow and its provenance." .

:Database a owl:Class ;
    rdfs:label "database" ;
    rdfs:comment "A database used as a source of inventory or flow data." .

:SoftwareTool a owl:Class ;
    rdfs:label "software tool" ;
    rdfs:comment "A software tool used to conduct the LCA study." .

:BillOfMaterials a owl:Class ;
    rdfs:label "bill of materials" ;
    rdfs:comment "A bill of materials describing components used as input to the LCA study." .

:Methodology a owl:Class ;
    rdfs:label "methodology" ;
    rdfs:comment "An impact assessment methodology used for environmental impact calculations." .

:FunctionalUnit a owl:Class ;
    rdfs:label "functional unit" ;
    rdfs:comment "The functional unit of the LCA model." .

:Scope a owl:Class ;
    rdfs:label "scope" ;
    rdfs:comment "The scope of the LCA model or study." .

:SystemBoundary a owl:Class ;
    rdfs:label "system boundary" ;
    rdfs:comment "The system boundary of the LCA model or study." .

:Agent a owl:Class ;
    rdfs:label "agent" ;
    rdfs:comment "A responsible actor or agent associated with the LCA study or model." .

:ImpactCategory a owl:Class ;
    rdfs:label "impact category" ;
    rdfs:comment "An environmental impact category." .

:ImpactResult a owl:Class ;
    rdfs:label "impact result" ;
    rdfs:comment "A quantified impact result for an activity or flow in an impact category." .

:ContributionResult a owl:Class ;
    rdfs:label "contribution result" ;
    rdfs:comment "A quantified contribution of a flow to an impact category, including percentage contribution." .

:Hypothesis a owl:Class ;
    rdfs:label "hypothesis" ;
    rdfs:comment "A hypothesis documented as study metadata." .

:Parametrisation a owl:Class ;
    rdfs:label "parametrisation" ;
    rdfs:comment "A parametrisation documented as study metadata." .

#################################################################
# Object Properties
#################################################################

:hasSystemModel a owl:ObjectProperty ;
    rdfs:label "has system model" ;
    rdfs:comment "Relates an LCA study to its system model." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :SystemModel .

:usesSoftwareTool a owl:ObjectProperty ;
    rdfs:label "uses software tool" ;
    rdfs:comment "Relates an LCA study to the software tool used to conduct it." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :SoftwareTool .

:usesBillOfMaterials a owl:ObjectProperty ;
    rdfs:label "uses bill of materials" ;
    rdfs:comment "Relates an LCA study to the bill of materials used as input." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :BillOfMaterials .

:usesMethodology a owl:ObjectProperty ;
    rdfs:label "uses methodology" ;
    rdfs:comment "Relates an LCA study to the impact assessment methodology used." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Methodology .

:hasHypothesis a owl:ObjectProperty ;
    rdfs:label "has hypothesis" ;
    rdfs:comment "Relates an LCA study to a documented hypothesis." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Hypothesis .

:hasParametrisation a owl:ObjectProperty ;
    rdfs:label "has parametrisation" ;
    rdfs:comment "Relates an LCA study to a documented parametrisation." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Parametrisation .

:hasFunctionalUnit a owl:ObjectProperty ;
    rdfs:label "has functional unit" ;
    rdfs:comment "Relates an LCA study to its functional unit." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :FunctionalUnit .

:hasScope a owl:ObjectProperty ;
    rdfs:label "has scope" ;
    rdfs:comment "Relates an LCA study to its scope." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Scope .

:hasSystemBoundary a owl:ObjectProperty ;
    rdfs:label "has system boundary" ;
    rdfs:comment "Relates an LCA study to its system boundary." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :SystemBoundary .

:hasResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has responsible agent" ;
    rdfs:comment "Relates an LCA study to a responsible agent or actor." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Agent .

:includesActivity a owl:ObjectProperty ;
    rdfs:label "includes activity" ;
    rdfs:comment "Relates a system model to an activity it includes." ;
    rdfs:domain :SystemModel ;
    rdfs:range :Activity .

:dependsOnActivity a owl:ObjectProperty ;
    rdfs:label "depends on activity" ;
    rdfs:comment "Relates an activity to another activity on which it depends." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

:hasInputFlow a owl:ObjectProperty ;
    rdfs:label "has input flow" ;
    rdfs:comment "Relates an activity to a flow that is an input to it." ;
    rdfs:domain :Activity ;
    rdfs:range :Flow .

:hasOutputFlow a owl:ObjectProperty ;
    rdfs:label "has output flow" ;
    rdfs:comment "Relates an activity to a flow that is an output from it." ;
    rdfs:domain :Activity ;
    rdfs:range :Flow .

:hasFlowDataset a owl:ObjectProperty ;
    rdfs:label "has flow dataset" ;
    rdfs:comment "Relates a flow to a dataset describing it." ;
    rdfs:domain :Flow ;
    rdfs:range :FlowDataset .

:comesFromDatabase a owl:ObjectProperty ;
    rdfs:label "comes from database" ;
    rdfs:comment "Relates a flow dataset to the database from which it was sourced." ;
    rdfs:domain :FlowDataset ;
    rdfs:range :Database .

:hasImpactResult a owl:ObjectProperty ;
    rdfs:label "has impact result" ;
    rdfs:comment "Relates an activity or flow to an impact result." ;
    rdfs:range :ImpactResult .

:forImpactCategory a owl:ObjectProperty ;
    rdfs:label "for impact category" ;
    rdfs:comment "Relates an impact or contribution result to the impact category it concerns." ;
    rdfs:domain :ImpactResult ;
    rdfs:range :ImpactCategory .

:hasContributionResult a owl:ObjectProperty ;
    rdfs:label "has contribution result" ;
    rdfs:comment "Relates an activity or impact category context to a contribution result." ;
    rdfs:range :ContributionResult .

:contributionOfFlow a owl:ObjectProperty ;
    rdfs:label "contribution of flow" ;
    rdfs:comment "Relates a contribution result to the flow that contributes to an impact category." ;
    rdfs:domain :ContributionResult ;
    rdfs:range :Flow .

:withinSystemBoundary a owl:ObjectProperty ;
    rdfs:label "within system boundary" ;
    rdfs:comment "Relates an activity or flow to the system boundary within which it is considered." ;
    rdfs:range :SystemBoundary .

#################################################################
# Datatype Properties
#################################################################

:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version" ;
    rdfs:comment "Gives the version identifier of a database or methodology." ;
    rdfs:range xsd:string .

:impactValue a owl:DatatypeProperty ;
    rdfs:label "impact value" ;
    rdfs:comment "Gives the numeric value of an impact result." ;
    rdfs:domain :ImpactResult ;
    rdfs:range xsd:decimal .

:contributionPercentage a owl:DatatypeProperty ;
    rdfs:label "contribution percentage" ;
    rdfs:comment "Gives the percentage contribution of a flow to an impact category." ;
    rdfs:domain :ContributionResult ;
    rdfs:range xsd:decimal .

:flowAmount a owl:DatatypeProperty ;
    rdfs:label "flow amount" ;
    rdfs:comment "Gives the numeric amount of a flow generated or used in a given context." ;
    rdfs:range xsd:decimal .