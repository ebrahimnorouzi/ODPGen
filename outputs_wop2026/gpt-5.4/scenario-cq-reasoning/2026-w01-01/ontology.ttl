@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "LCA study and activity-flow ODP" ;
  rdfs:comment "A minimal ontology design pattern for representing an LCA study, its system model activities, flows, data sources, impact assessment results, and study metadata needed to answer the stated competency questions." .

### Classes

:LCAStudy a owl:Class ;
  rdfs:label "LCA study" ;
  rdfs:comment "A life cycle assessment study." .

:SystemModel a owl:Class ;
  rdfs:label "system model" ;
  rdfs:comment "A model of the product system composed of activities and their dependencies." .

:Activity a owl:Class ;
  rdfs:label "activity" ;
  rdfs:comment "A process or activity within the system model." .

:Flow a owl:Class ;
  rdfs:label "flow" ;
  rdfs:comment "A flow associated with activities in the system model." .

:ElementaryFlow a owl:Class ;
  rdfs:label "elementary flow" ;
  rdfs:comment "A flow exchanged with the environment." ;
  rdfs:subClassOf :Flow .

:IntermediateFlow a owl:Class ;
  rdfs:label "intermediate flow" ;
  rdfs:comment "A flow exchanged between activities within the technosphere." ;
  rdfs:subClassOf :Flow .

:ResourceFlow a owl:Class ;
  rdfs:label "resource flow" ;
  rdfs:comment "A flow classified as a resource." ;
  rdfs:subClassOf :Flow .

:EmissionFlow a owl:Class ;
  rdfs:label "emission flow" ;
  rdfs:comment "A flow classified as an emission." ;
  rdfs:subClassOf :Flow .

:ProductFlow a owl:Class ;
  rdfs:label "product flow" ;
  rdfs:comment "A flow classified as a product." ;
  rdfs:subClassOf :Flow .

:FlowDataset a owl:Class ;
  rdfs:label "flow dataset" ;
  rdfs:comment "A dataset describing a flow and its provenance." .

:Database a owl:Class ;
  rdfs:label "database" ;
  rdfs:comment "A database used as a source of inventory or flow datasets." .

:SoftwareTool a owl:Class ;
  rdfs:label "software tool" ;
  rdfs:comment "A software tool used to conduct or support the study." .

:BillOfMaterials a owl:Class ;
  rdfs:label "bill of materials" ;
  rdfs:comment "A bill of materials describing components used as study input." .

:Methodology a owl:Class ;
  rdfs:label "methodology" ;
  rdfs:comment "An impact assessment methodology used in the study." .

:ImpactCategory a owl:Class ;
  rdfs:label "impact category" ;
  rdfs:comment "An environmental impact category." .

:ImpactResult a owl:Class ;
  rdfs:label "impact result" ;
  rdfs:comment "A quantified impact assessment result for an activity or flow in an impact category." .

:FunctionalUnit a owl:Class ;
  rdfs:label "functional unit" ;
  rdfs:comment "The functional unit of an LCA study or model." .

:Scope a owl:Class ;
  rdfs:label "scope" ;
  rdfs:comment "The scope of an LCA study or model." .

:SystemBoundary a owl:Class ;
  rdfs:label "system boundary" ;
  rdfs:comment "The system boundary delimiting what is included in the model." .

:Agent a owl:Class ;
  rdfs:label "agent" ;
  rdfs:comment "An actor or responsible agent associated with the study." .

:Hypothesis a owl:Class ;
  rdfs:label "hypothesis" ;
  rdfs:comment "A study hypothesis." .

:Parametrisation a owl:Class ;
  rdfs:label "parametrisation" ;
  rdfs:comment "A parametrisation used in the study or model." .

### Object Properties

:hasSystemModel a owl:ObjectProperty ;
  rdfs:label "has system model" ;
  rdfs:comment "Relates an LCA study to its system model." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :SystemModel .

:hasActivity a owl:ObjectProperty ;
  rdfs:label "has activity" ;
  rdfs:comment "Relates a system model to an activity it contains." ;
  rdfs:domain :SystemModel ;
  rdfs:range :Activity .

:hasInputFlow a owl:ObjectProperty ;
  rdfs:label "has input flow" ;
  rdfs:comment "Relates an activity to a flow used as input." ;
  rdfs:domain :Activity ;
  rdfs:range :Flow .

:hasOutputFlow a owl:ObjectProperty ;
  rdfs:label "has output flow" ;
  rdfs:comment "Relates an activity to a flow produced as output." ;
  rdfs:domain :Activity ;
  rdfs:range :Flow .

:dependsOnActivity a owl:ObjectProperty ;
  rdfs:label "depends on activity" ;
  rdfs:comment "Relates an activity to another activity on which it depends." ;
  rdfs:domain :Activity ;
  rdfs:range :Activity ;
  rdf:type owl:TransitiveProperty .

:hasFlowDataset a owl:ObjectProperty ;
  rdfs:label "has flow dataset" ;
  rdfs:comment "Relates a flow to a dataset describing it." ;
  rdfs:domain :Flow ;
  rdfs:range :FlowDataset .

:comesFromDatabase a owl:ObjectProperty ;
  rdfs:label "comes from database" ;
  rdfs:comment "Relates a flow dataset to the database from which it originates." ;
  rdfs:domain :FlowDataset ;
  rdfs:range :Database .

:usesSoftwareTool a owl:ObjectProperty ;
  rdfs:label "uses software tool" ;
  rdfs:comment "Relates an LCA study to a software tool used to conduct it." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :SoftwareTool .

:usesBillOfMaterials a owl:ObjectProperty ;
  rdfs:label "uses bill of materials" ;
  rdfs:comment "Relates an LCA study to a bill of materials used as input." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :BillOfMaterials .

:usesMethodology a owl:ObjectProperty ;
  rdfs:label "uses methodology" ;
  rdfs:comment "Relates an LCA study to an impact assessment methodology." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :Methodology .

:hasFunctionalUnit a owl:ObjectProperty ;
  rdfs:label "has functional unit" ;
  rdfs:comment "Relates an LCA study to its functional unit." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :FunctionalUnit .

:hasScope a owl:ObjectProperty ;
  rdfs:label "has scope" ;
  rdfs:comment "Relates an LCA study to its scope." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :Scope .

:hasSystemBoundary a owl:ObjectProperty ;
  rdfs:label "has system boundary" ;
  rdfs:comment "Relates an LCA study to its system boundary." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :SystemBoundary .

:hasResponsibleAgent a owl:ObjectProperty ;
  rdfs:label "has responsible agent" ;
  rdfs:comment "Relates an LCA study to a responsible agent." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :Agent .

:hasHypothesis a owl:ObjectProperty ;
  rdfs:label "has hypothesis" ;
  rdfs:comment "Relates an LCA study to a hypothesis." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :Hypothesis .

:hasParametrisation a owl:ObjectProperty ;
  rdfs:label "has parametrisation" ;
  rdfs:comment "Relates an LCA study to a parametrisation." ;
  rdfs:domain :LCAStudy ;
  rdfs:range :Parametrisation .

:hasImpactResult a owl:ObjectProperty ;
  rdfs:label "has impact result" ;
  rdfs:comment "Relates an activity or flow to an impact result." ;
  rdfs:range :ImpactResult .

:hasImpactCategory a owl:ObjectProperty ;
  rdfs:label "has impact category" ;
  rdfs:comment "Relates an impact result to the impact category it quantifies." ;
  rdfs:domain :ImpactResult ;
  rdfs:range :ImpactCategory .

:hasContributorFlow a owl:ObjectProperty ;
  rdfs:label "has contributor flow" ;
  rdfs:comment "Relates an impact result to a contributing flow." ;
  rdfs:domain :ImpactResult ;
  rdfs:range :Flow .

:withinSystemBoundary a owl:ObjectProperty ;
  rdfs:label "within system boundary" ;
  rdfs:comment "Relates an activity or flow to the system boundary within which it is considered." ;
  rdfs:range :SystemBoundary .

### Datatype Properties

:hasVersion a owl:DatatypeProperty ;
  rdfs:label "has version" ;
  rdfs:comment "Associates a resource with a version identifier." ;
  rdfs:range xsd:string .

:hasAmount a owl:DatatypeProperty ;
  rdfs:label "has amount" ;
  rdfs:comment "Associates a flow or impact result with a quantitative amount." ;
  rdfs:range xsd:decimal .

:hasUnit a owl:DatatypeProperty ;
  rdfs:label "has unit" ;
  rdfs:comment "Associates a quantitative description with its unit." ;
  rdfs:range xsd:string .

:hasContributionPercentage a owl:DatatypeProperty ;
  rdfs:label "has contribution percentage" ;
  rdfs:comment "Associates an impact result with the percentage contribution of a contributing flow." ;
  rdfs:domain :ImpactResult ;
  rdfs:range xsd:decimal .

### Axioms

:ElementaryFlow owl:disjointWith :IntermediateFlow .
:ResourceFlow owl:disjointWith :EmissionFlow .
:ResourceFlow owl:disjointWith :ProductFlow .
:EmissionFlow owl:disjointWith :ProductFlow .

:LCAStudy rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasSystemModel ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :SystemModel
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :usesMethodology ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Methodology
  ] .

:SystemModel rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasActivity ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :Activity
  ] .

:Activity rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasInputFlow ;
    owl:allValuesFrom :Flow
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasOutputFlow ;
    owl:allValuesFrom :Flow
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :dependsOnActivity ;
    owl:allValuesFrom :Activity
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasImpactResult ;
    owl:allValuesFrom :ImpactResult
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :withinSystemBoundary ;
    owl:allValuesFrom :SystemBoundary
  ] .

:Flow rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasFlowDataset ;
    owl:allValuesFrom :FlowDataset
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasImpactResult ;
    owl:allValuesFrom :ImpactResult
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :withinSystemBoundary ;
    owl:allValuesFrom :SystemBoundary
  ] .

:FlowDataset rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :comesFromDatabase ;
    owl:allValuesFrom :Database
  ] .

:ImpactResult rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasImpactCategory ;
    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass :ImpactCategory
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasContributorFlow ;
    owl:allValuesFrom :Flow
  ] .