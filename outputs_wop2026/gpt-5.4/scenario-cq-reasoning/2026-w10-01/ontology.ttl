@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Software and hardware requirement ODP" ;
  rdfs:comment "A minimal ontology design pattern for describing software requirements over software and hardware resources, including required resource type, constrained property, required value kind (minimum, maximum, exact), and required software version." .

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software asset that may require software or hardware resources." .

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware resource that may be required by software." .

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement expressed by a software about a needed software or hardware resource." .

:SoftwareRequirement a owl:Class ;
  rdfs:label "Software requirement" ;
  rdfs:comment "A requirement whose target is software." ;
  rdfs:subClassOf :Requirement ,
    [ a owl:Restriction ;
      owl:onProperty :requiresResource ;
      owl:someValuesFrom :Software
    ] .

:HardwareRequirement a owl:Class ;
  rdfs:label "Hardware requirement" ;
  rdfs:comment "A requirement whose target is hardware." ;
  rdfs:subClassOf :Requirement ,
    [ a owl:Restriction ;
      owl:onProperty :requiresResource ;
      owl:someValuesFrom :Hardware
    ] .

:ResourceType a owl:Class ;
  rdfs:label "Resource type" ;
  rdfs:comment "A type or category of software or hardware resource required by software." .

:PropertySpecification a owl:Class ;
  rdfs:label "Property specification" ;
  rdfs:comment "A specification of a property together with a required value constraint." .

:VersionSpecification a owl:Class ;
  rdfs:label "Version specification" ;
  rdfs:comment "A specification of a required software version constraint." .

:ValueConstraintKind a owl:Class ;
  rdfs:label "Value constraint kind" ;
  rdfs:comment "The kind of value constraint, such as minimum, maximum, or exact." .

:Property a owl:Class ;
  rdfs:label "Property" ;
  rdfs:comment "A characteristic or property of a software or hardware resource that can be constrained by a requirement." .

:requiresRequirement a owl:ObjectProperty ;
  rdfs:label "requires requirement" ;
  rdfs:comment "Relates a software to a requirement it expresses." ;
  rdfs:domain :Software ;
  rdfs:range :Requirement .

:requiresResource a owl:ObjectProperty ;
  rdfs:label "requires resource" ;
  rdfs:comment "Relates a requirement to the software or hardware resource it requires." ;
  rdfs:domain :Requirement ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf ( :Software :Hardware )
  ] .

:requiredResourceType a owl:ObjectProperty ;
  rdfs:label "required resource type" ;
  rdfs:comment "Relates a requirement to the type of software or hardware resource required." ;
  rdfs:domain :Requirement ;
  rdfs:range :ResourceType .

:hasPropertySpecification a owl:ObjectProperty ;
  rdfs:label "has property specification" ;
  rdfs:comment "Relates a requirement to a specification of a constrained property and its required value." ;
  rdfs:domain :Requirement ;
  rdfs:range :PropertySpecification .

:constrainsProperty a owl:ObjectProperty ;
  rdfs:label "constrains property" ;
  rdfs:comment "Relates a property specification to the property being constrained." ;
  rdfs:domain :PropertySpecification ;
  rdfs:range :Property .

:hasValueConstraintKind a owl:ObjectProperty ;
  rdfs:label "has value constraint kind" ;
  rdfs:comment "Relates a property or version specification to the kind of constraint: minimum, maximum, or exact." ;
  rdfs:range :ValueConstraintKind .

:hasVersionSpecification a owl:ObjectProperty ;
  rdfs:label "has version specification" ;
  rdfs:comment "Relates a software requirement to a required software version specification." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range :VersionSpecification .

:requiredValue a owl:DatatypeProperty ;
  rdfs:label "required value" ;
  rdfs:comment "The literal value required for a constrained property." ;
  rdfs:domain :PropertySpecification ;
  rdfs:range xsd:string .

:requiredVersionValue a owl:DatatypeProperty ;
  rdfs:label "required version value" ;
  rdfs:comment "The literal version value required for software." ;
  rdfs:domain :VersionSpecification ;
  rdfs:range xsd:string .

:SoftwareRequirement rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasVersionSpecification ;
    owl:allValuesFrom :VersionSpecification
  ] .

:Requirement rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :requiredResourceType ;
    owl:allValuesFrom :ResourceType
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasPropertySpecification ;
    owl:allValuesFrom :PropertySpecification
  ] .

:PropertySpecification rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :constrainsProperty ;
    owl:allValuesFrom :Property
  ] ,
  [ a owl:Restriction ;
    owl:onProperty :hasValueConstraintKind ;
    owl:allValuesFrom :ValueConstraintKind
  ] .

:VersionSpecification rdfs:subClassOf
  [ a owl:Restriction ;
    owl:onProperty :hasValueConstraintKind ;
    owl:allValuesFrom :ValueConstraintKind
  ] .

:Software owl:disjointWith :Hardware .
:SoftwareRequirement owl:disjointWith :HardwareRequirement .