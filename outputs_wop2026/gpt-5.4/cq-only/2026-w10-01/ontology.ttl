@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Software Requirement ODP" ;
  rdfs:comment "An ontology design pattern for representing software requirements on software or hardware, including the required entity, its type, constrained properties, and constrained software version values." .

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity that may require software or hardware." .

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware entity that may be required by software." .

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement stated by a software for some software or hardware." .

:PropertyType a owl:Class ;
  rdfs:label "Property type" ;
  rdfs:comment "A type of property whose value may be constrained by a requirement, such as memory size or processor speed." .

:ValueConstraint a owl:Class ;
  rdfs:label "Value constraint" ;
  rdfs:comment "A constraint that specifies a minimum, maximum, or exact value for a property of a required software or hardware." .

:VersionConstraint a owl:Class ;
  rdfs:label "Version constraint" ;
  rdfs:comment "A constraint that specifies a minimum, maximum, or exact version for required software." .

:requires a owl:ObjectProperty ;
  rdfs:label "requires" ;
  rdfs:comment "Relates a software to a requirement it states." ;
  rdfs:domain :Software ;
  rdfs:range :Requirement .

:requiredEntity a owl:ObjectProperty ;
  rdfs:label "required entity" ;
  rdfs:comment "Relates a requirement to the software or hardware that is required." ;
  rdfs:domain :Requirement .

:requiredSoftware a owl:ObjectProperty ;
  rdfs:label "required software" ;
  rdfs:comment "Relates a requirement to the software that is required." ;
  rdfs:subPropertyOf :requiredEntity ;
  rdfs:domain :Requirement ;
  rdfs:range :Software .

:requiredHardware a owl:ObjectProperty ;
  rdfs:label "required hardware" ;
  rdfs:comment "Relates a requirement to the hardware that is required." ;
  rdfs:subPropertyOf :requiredEntity ;
  rdfs:domain :Requirement ;
  rdfs:range :Hardware .

:requiredType a owl:ObjectProperty ;
  rdfs:label "required type" ;
  rdfs:comment "Relates a requirement to the type of software or hardware required." ;
  rdfs:domain :Requirement ;
  rdfs:range rdfs:Class .

:hasValueConstraint a owl:ObjectProperty ;
  rdfs:label "has value constraint" ;
  rdfs:comment "Relates a requirement to a constraint on a property value of the required software or hardware." ;
  rdfs:domain :Requirement ;
  rdfs:range :ValueConstraint .

:constrainsPropertyType a owl:ObjectProperty ;
  rdfs:label "constrains property type" ;
  rdfs:comment "Relates a value constraint to the type of property whose value is constrained." ;
  rdfs:domain :ValueConstraint ;
  rdfs:range :PropertyType .

:hasVersionConstraint a owl:ObjectProperty ;
  rdfs:label "has version constraint" ;
  rdfs:comment "Relates a requirement to a version constraint on required software." ;
  rdfs:domain :Requirement ;
  rdfs:range :VersionConstraint .

:minimumValue a owl:DatatypeProperty ;
  rdfs:label "minimum value" ;
  rdfs:comment "Specifies the minimum required value in a value constraint." ;
  rdfs:domain :ValueConstraint ;
  rdfs:range xsd:string .

:maximumValue a owl:DatatypeProperty ;
  rdfs:label "maximum value" ;
  rdfs:comment "Specifies the maximum required value in a value constraint." ;
  rdfs:domain :ValueConstraint ;
  rdfs:range xsd:string .

:exactValue a owl:DatatypeProperty ;
  rdfs:label "exact value" ;
  rdfs:comment "Specifies the exact required value in a value constraint." ;
  rdfs:domain :ValueConstraint ;
  rdfs:range xsd:string .

:minimumVersion a owl:DatatypeProperty ;
  rdfs:label "minimum version" ;
  rdfs:comment "Specifies the minimum required software version in a version constraint." ;
  rdfs:domain :VersionConstraint ;
  rdfs:range xsd:string .

:maximumVersion a owl:DatatypeProperty ;
  rdfs:label "maximum version" ;
  rdfs:comment "Specifies the maximum required software version in a version constraint." ;
  rdfs:domain :VersionConstraint ;
  rdfs:range xsd:string .

:exactVersion a owl:DatatypeProperty ;
  rdfs:label "exact version" ;
  rdfs:comment "Specifies the exact required software version in a version constraint." ;
  rdfs:domain :VersionConstraint ;
  rdfs:range xsd:string .