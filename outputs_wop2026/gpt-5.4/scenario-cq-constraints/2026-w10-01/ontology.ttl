@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
  rdfs:label "Software and hardware requirement pattern" ;
  rdfs:comment "A minimal ontology design pattern for describing software requirements over software and hardware resources, including required resource type, constrained property, required value kind, and required software version." .

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software asset for which requirements can be specified." .

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware resource that can be required by software." .

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement expressed by a software over a software or hardware resource." .

:SoftwareRequirement a owl:Class ;
  rdfs:label "Software requirement" ;
  rdfs:comment "A requirement whose target is software." ;
  rdfs:subClassOf :Requirement .

:HardwareRequirement a owl:Class ;
  rdfs:label "Hardware requirement" ;
  rdfs:comment "A requirement whose target is hardware." ;
  rdfs:subClassOf :Requirement .

:ResourceType a owl:Class ;
  rdfs:label "Resource type" ;
  rdfs:comment "A type used to classify required software or hardware resources." .

:Property a owl:Class ;
  rdfs:label "Property" ;
  rdfs:comment "A property of a required software or hardware resource that is constrained by a requirement." .

:ValueKind a owl:Class ;
  rdfs:label "Value kind" ;
  rdfs:comment "A category indicating whether a required value is minimum, maximum, or exact." .

:VersionKind a owl:Class ;
  rdfs:label "Version kind" ;
  rdfs:comment "A category indicating whether a required software version is minimum, maximum, or exact." .

:hasRequirement a owl:ObjectProperty ;
  rdfs:label "has requirement" ;
  rdfs:comment "Relates a software asset to one of its requirements." ;
  rdfs:domain :Software ;
  rdfs:range :Requirement .

:requiresSoftware a owl:ObjectProperty ;
  rdfs:label "requires software" ;
  rdfs:comment "Relates a software requirement to the software resource required by a software." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range :Software .

:requiresHardware a owl:ObjectProperty ;
  rdfs:label "requires hardware" ;
  rdfs:comment "Relates a hardware requirement to the hardware resource required by a software." ;
  rdfs:domain :HardwareRequirement ;
  rdfs:range :Hardware .

:requiredResourceType a owl:ObjectProperty ;
  rdfs:label "required resource type" ;
  rdfs:comment "Relates a requirement to the type of software or hardware resource that is required." ;
  rdfs:domain :Requirement ;
  rdfs:range :ResourceType .

:constrainsProperty a owl:ObjectProperty ;
  rdfs:label "constrains property" ;
  rdfs:comment "Relates a requirement to the property of the required software or hardware resource whose value is constrained." ;
  rdfs:domain :Requirement ;
  rdfs:range :Property .

:requiredValueKind a owl:ObjectProperty ;
  rdfs:label "required value kind" ;
  rdfs:comment "Relates a requirement to the kind of required value, such as minimum, maximum, or exact." ;
  rdfs:domain :Requirement ;
  rdfs:range :ValueKind .

:requiredVersionKind a owl:ObjectProperty ;
  rdfs:label "required version kind" ;
  rdfs:comment "Relates a software requirement to the kind of required version, such as minimum, maximum, or exact." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range :VersionKind .

:requiredValue a owl:DatatypeProperty ;
  rdfs:label "required value" ;
  rdfs:comment "Gives the required value for a constrained property of a required software or hardware resource." ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:string .

:requiredVersion a owl:DatatypeProperty ;
  rdfs:label "required version" ;
  rdfs:comment "Gives the required version of a software resource required by a software." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range xsd:string .