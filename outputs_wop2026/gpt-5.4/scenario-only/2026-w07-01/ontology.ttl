@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "APLO-inspired learning support ontology design pattern" ;
    rdfs:comment "An ontology design pattern for representing pedagogical organization, learning objective alignment, learner context, awareness, evaluation, and feedback within the scope of the provided learning use case." .

:Learner a owl:Class ;
    rdfs:label "Learner" ;
    rdfs:comment "A person in a learning setting whose goals, preferences, challenges, situations, awareness, strategies, and assessment-related information are represented." .

:Goal a owl:Class ;
    rdfs:label "Goal" ;
    rdfs:comment "A learner goal that may target a skill." .

:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "A subject area that can scope learner preferences, challenges, awareness, or learning resources." .

:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "A capability that can be targeted by goals and can scope learner preferences, challenges, awareness, or objectives." .

:Preference a owl:Class ;
    rdfs:label "Preference" ;
    rdfs:comment "A learner preference that may concern one or more topics or skills." .

:Challenge a owl:Class ;
    rdfs:label "Challenge" ;
    rdfs:comment "A learner challenge that may concern one or more topics or skills." .

:LearnerSituation a owl:Class ;
    rdfs:label "Learner situation" ;
    rdfs:comment "A contextual situation of a learner to which learning objectives may be aligned." .

:AwarenessObservation a owl:Class ;
    rdfs:label "Awareness observation" ;
    rdfs:comment "A learner awareness statement scoped to a topic or skill and associated with temporal information." .

:LearningObjective a owl:Class ;
    rdfs:label "Learning objective" ;
    rdfs:comment "An intended learning outcome that may be aligned to learner situations and supported by pedagogical techniques or learning resource units." .

:PedagogicalTechnique a owl:Class ;
    rdfs:label "Pedagogical technique" ;
    rdfs:comment "A pedagogical approach or method that may support learning objectives or be used in assessment exercises." .

:LearningResourceUnit a owl:Class ;
    rdfs:label "Learning resource unit" ;
    rdfs:comment "A unit of learning material that may support a learning objective." .

:PedagogicalFramework a owl:Class ;
    rdfs:label "Pedagogical framework" ;
    rdfs:comment "A pedagogical organization structure that contains pedagogical elements." .

:PedagogicalElement a owl:Class ;
    rdfs:label "Pedagogical element" ;
    rdfs:comment "An element within a pedagogical framework that may be ordered relative to other elements." .

:AssessmentExercise a owl:Class ;
    rdfs:label "Assessment exercise" ;
    rdfs:comment "An assessment activity that uses evaluation techniques and metrics to produce results." .

:EvaluationTechnique a owl:Class ;
    rdfs:label "Evaluation technique" ;
    rdfs:comment "A technique used by an assessment exercise to evaluate learner performance." .

:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A metric used in evaluation by an assessment exercise." .

:AssessmentResult a owl:Class ;
    rdfs:label "Assessment result" ;
    rdfs:comment "A result produced by an assessment exercise that may support feedback, awareness observations, or learning strategies used." .

:Feedback a owl:Class ;
    rdfs:label "Feedback" ;
    rdfs:comment "A feedback response supported by an assessment result and carrying source and temporal information." .

:LearningStrategy a owl:Class ;
    rdfs:label "Learning strategy" ;
    rdfs:comment "A learning strategy used by a learner and potentially supported by an assessment result." .

:InformationSource a owl:Class ;
    rdfs:label "Information source" ;
    rdfs:comment "A source associated with feedback." .

:TemporalInformation a owl:Class ;
    rdfs:label "Temporal information" ;
    rdfs:comment "Temporal information associated with feedback or awareness observations." .

:Preference owl:disjointWith :Challenge, :LearnerSituation, :AwarenessObservation, :Goal .
:Challenge owl:disjointWith :LearnerSituation, :AwarenessObservation, :Goal .
:LearnerSituation owl:disjointWith :AwarenessObservation, :Goal .
:Topic owl:disjointWith :Skill .
:LearningObjective owl:disjointWith :PedagogicalTechnique, :LearningResourceUnit, :AssessmentExercise, :AssessmentResult, :Feedback .
:AssessmentExercise owl:disjointWith :EvaluationTechnique, :Metric, :AssessmentResult, :Feedback .
:EvaluationTechnique owl:disjointWith :Metric .
:PedagogicalFramework owl:disjointWith :PedagogicalElement .

:pursuesGoal a owl:ObjectProperty ;
    rdfs:label "pursues goal" ;
    rdfs:comment "Relates a learner to a goal the learner pursues." ;
    rdfs:domain :Learner ;
    rdfs:range :Goal .

:targetsSkill a owl:ObjectProperty ;
    rdfs:label "targets skill" ;
    rdfs:comment "Relates a goal to a skill it targets." ;
    rdfs:domain :Goal ;
    rdfs:range :Skill .

:hasPreference a owl:ObjectProperty ;
    rdfs:label "has preference" ;
    rdfs:comment "Relates a learner to a preference." ;
    rdfs:domain :Learner ;
    rdfs:range :Preference .

:hasChallenge a owl:ObjectProperty ;
    rdfs:label "has challenge" ;
    rdfs:comment "Relates a learner to a challenge." ;
    rdfs:domain :Learner ;
    rdfs:range :Challenge .

:hasSituation a owl:ObjectProperty ;
    rdfs:label "has situation" ;
    rdfs:comment "Relates a learner to a learner situation." ;
    rdfs:domain :Learner ;
    rdfs:range :LearnerSituation .

:hasAwarenessObservation a owl:ObjectProperty ;
    rdfs:label "has awareness observation" ;
    rdfs:comment "Relates a learner to an awareness observation." ;
    rdfs:domain :Learner ;
    rdfs:range :AwarenessObservation .

:aboutTopic a owl:ObjectProperty ;
    rdfs:label "about topic" ;
    rdfs:comment "Relates a preference, challenge, awareness observation, or learning resource unit to a topic it concerns." ;
    rdfs:range :Topic .

:aboutSkill a owl:ObjectProperty ;
    rdfs:label "about skill" ;
    rdfs:comment "Relates a preference, challenge, awareness observation, or learning objective to a skill it concerns." ;
    rdfs:range :Skill .

:alignedToSituation a owl:ObjectProperty ;
    rdfs:label "aligned to situation" ;
    rdfs:comment "Relates a learning objective to a learner situation to which it is aligned." ;
    rdfs:domain :LearningObjective ;
    rdfs:range :LearnerSituation .

:supportedByTechnique a owl:ObjectProperty ;
    rdfs:label "supported by technique" ;
    rdfs:comment "Relates a learning objective to a pedagogical technique that supports it." ;
    rdfs:domain :LearningObjective ;
    rdfs:range :PedagogicalTechnique .

:supportedByResourceUnit a owl:ObjectProperty ;
    rdfs:label "supported by resource unit" ;
    rdfs:comment "Relates a learning objective to a learning resource unit that supports it." ;
    rdfs:domain :LearningObjective ;
    rdfs:range :LearningResourceUnit .

:hasElement a owl:ObjectProperty ;
    rdfs:label "has element" ;
    rdfs:comment "Relates a pedagogical framework to a pedagogical element it contains." ;
    rdfs:domain :PedagogicalFramework ;
    rdfs:range :PedagogicalElement .

:precedesElement a owl:ObjectProperty ;
    rdfs:label "precedes element" ;
    rdfs:comment "Relates a pedagogical element to another pedagogical element that follows it in order." ;
    rdfs:domain :PedagogicalElement ;
    rdfs:range :PedagogicalElement .

:usesEvaluationTechnique a owl:ObjectProperty ;
    rdfs:label "uses evaluation technique" ;
    rdfs:comment "Relates an assessment exercise to an evaluation technique it uses." ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :EvaluationTechnique .

:usesMetric a owl:ObjectProperty ;
    rdfs:label "uses metric" ;
    rdfs:comment "Relates an assessment exercise to a metric it uses." ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :Metric .

:producesResult a owl:ObjectProperty ;
    rdfs:label "produces result" ;
    rdfs:comment "Relates an assessment exercise to an assessment result it produces." ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :AssessmentResult .

:supportsFeedback a owl:ObjectProperty ;
    rdfs:label "supports feedback" ;
    rdfs:comment "Relates an assessment result to feedback it supports." ;
    rdfs:domain :AssessmentResult ;
    rdfs:range :Feedback .

:supportsAwarenessObservation a owl:ObjectProperty ;
    rdfs:label "supports awareness observation" ;
    rdfs:comment "Relates an assessment result to an awareness observation it supports." ;
    rdfs:domain :AssessmentResult ;
    rdfs:range :AwarenessObservation .

:supportsLearningStrategy a owl:ObjectProperty ;
    rdfs:label "supports learning strategy" ;
    rdfs:comment "Relates an assessment result to a learning strategy used that it supports." ;
    rdfs:domain :AssessmentResult ;
    rdfs:range :LearningStrategy .

:hasFeedbackSource a owl:ObjectProperty ;
    rdfs:label "has feedback source" ;
    rdfs:comment "Relates feedback to its source." ;
    rdfs:domain :Feedback ;
    rdfs:range :InformationSource .

:hasTemporalInformation a owl:ObjectProperty ;
    rdfs:label "has temporal information" ;
    rdfs:comment "Relates feedback or an awareness observation to associated temporal information." ;
    rdfs:range :TemporalInformation .

:usesLearningStrategy a owl:ObjectProperty ;
    rdfs:label "uses learning strategy" ;
    rdfs:comment "Relates a learner to a learning strategy used by the learner." ;
    rdfs:domain :Learner ;
    rdfs:range :LearningStrategy .

:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description" ;
    rdfs:comment "Provides a textual description for an entity in the pattern when needed." ;
    rdfs:range xsd:string .

:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "has timestamp" ;
    rdfs:comment "Provides a timestamp value as temporal information." ;
    rdfs:domain :TemporalInformation ;
    rdfs:range xsd:dateTime .