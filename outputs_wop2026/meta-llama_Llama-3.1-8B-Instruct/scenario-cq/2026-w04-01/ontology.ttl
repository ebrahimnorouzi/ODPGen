@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software Reverse Engineering Ontology" ;
  rdfs:comment "Ontology for software reverse engineering and vulnerability detection.".

:ExecutableFile a owl:Class ;
  rdfs:label "Executable File" ;
  rdfs:comment "A file containing executable code.".

:Symbol a owl:Class ;
  rdfs:label "Symbol" ;
  rdfs:comment "A symbol in the executable file, such as a function or variable.".

:Function a owl:Class ;
  rdfs:label "Function" ;
  rdfs:comment "A block of code that performs a specific task.".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A storage location that holds a value.".

:API_Call a owl:Class ;
  rdfs:label "API Call" ;
  rdfs:comment "A call to a system or library function.".

:MaliciousAPI_Call a owl:Class ;
  rdfs:label "Malicious API Call" ;
  rdfs:comment "A malicious or suspicious API call.".

:Networking_Activity a owl:Class ;
  rdfs:label "Networking Activity" ;
  rdfs:comment "Suspicious or malicious networking activity.".

:ControlFlow_Pattern a owl:Class ;
  rdfs:label "Control Flow Pattern" ;
  rdfs:comment "A pattern of control flow in the executable file.".

:Entropy_Section a owl:Class ;
  rdfs:label "Entropy Section" ;
  rdfs:comment "A section of the executable file with high entropy.".

:SelfReferentialDecode_Loop a owl:Class ;
  rdfs:label "Self-Referential Decode Loop" ;
  rdfs:comment "A loop that decodes itself.".

:File_System_Abuse a owl:Class ;
  rdfs:label "File System Abuse" ;
  rdfs:comment "Suspicious or malicious file system activity.".

:Jump_To_Memory a owl:Class ;
  rdfs:label "Jump To Memory" ;
  rdfs:comment "A jump to memory in the executable file.".

:Imported_Function a owl:Class ;
  rdfs:label "Imported Function" ;
  rdfs:comment "A function imported from another file.".

:Cryptographic_Activity a owl:Class ;
  rdfs:label "Cryptographic Activity" ;
  rdfs:comment "Suspicious or malicious cryptographic activity.".

:Entropy_Ratio a owl:DatatypeProperty ;
  rdfs:label "Entropy Ratio" ;
  rdfs:comment "The ratio of unique opcodes to the total number of instructions in a function." ;
  rdfs:range xsd:decimal.

:API_Call_Name a owl:DatatypeProperty ;
  rdfs:label "API Call Name" ;
  rdfs:comment "The name of the API call." ;
  rdfs:range xsd:string.

:Symbol_Name a owl:DatatypeProperty ;
  rdfs:label "Symbol Name" ;
  rdfs:comment "The name of the symbol." ;
  rdfs:range xsd:string.

:Function_Name a owl:DatatypeProperty ;
  rdfs:label "Function Name" ;
  rdfs:comment "The name of the function." ;
  rdfs:range xsd:string.

:Variable_Name a owl:DatatypeProperty ;
  rdfs:label "Variable Name" ;
  rdfs:comment "The name of the variable." ;
  rdfs:range xsd:string.

:MaliciousAPI_Call_Name a owl:DatatypeProperty ;
  rdfs:label "Malicious API Call Name" ;
  rdfs:comment "The name of the malicious API call." ;
  rdfs:range xsd:string.

:Networking_Activity_Type a owl:DatatypeProperty ;
  rdfs:label "Networking Activity Type" ;
  rdfs:comment "The type of networking activity." ;
  rdfs:range xsd:string.

:ControlFlow_Pattern_Type a owl:DatatypeProperty ;
  rdfs:label "Control Flow Pattern Type" ;
  rdfs:comment "The type of control flow pattern." ;
  rdfs:range xsd:string.

:Entropy_Section_Type a owl:DatatypeProperty ;
  rdfs:label "Entropy Section Type" ;
  rdfs:comment "The type of entropy section." ;
  rdfs:range xsd:string.

:SelfReferentialDecode_Loop_Type a owl:DatatypeProperty ;
  rdfs:label "Self-Referential Decode Loop Type" ;
  rdfs:comment "The type of self-referential decode loop." ;
  rdfs:range xsd:string.

:File_System_Abuse_Type a owl:DatatypeProperty ;
  rdfs:label "File System Abuse Type" ;
  rdfs:comment "The type of file system abuse." ;
  rdfs:range xsd:string.

:Jump_To_Memory_Type a owl:DatatypeProperty ;
  rdfs:label "Jump To Memory Type" ;
  rdfs:comment "The type of jump to memory." ;
  rdfs:range xsd:string.

:Imported_Function_Percentage a owl:DatatypeProperty ;
  rdfs:label "Imported Function Percentage" ;
  rdfs:comment "The percentage of imported functions." ;
  rdfs:range xsd:decimal.

:Cryptographic_Activity_Type a owl:DatatypeProperty ;
  rdfs:label "Cryptographic Activity Type" ;
  rdfs:comment "The type of cryptographic activity." ;
  rdfs:range xsd:string.

:ExecutableFile_has_Symbol a owl:ObjectProperty ;
  rdfs:label "has Symbol" ;
  rdfs:comment "A symbol in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Symbol.

:Symbol_has_Name a owl:DatatypeProperty ;
  rdfs:label "has Name" ;
  rdfs:comment "The name of the symbol." ;
  rdfs:domain :Symbol ;
  rdfs:range xsd:string.

:Symbol_has_Function a owl:ObjectProperty ;
  rdfs:label "has Function" ;
  rdfs:comment "A function associated with the symbol." ;
  rdfs:domain :Symbol ;
  rdfs:range :Function.

:Function_has_Name a owl:DatatypeProperty ;
  rdfs:label "has Name" ;
  rdfs:comment "The name of the function." ;
  rdfs:domain :Function ;
  rdfs:range xsd:string.

:Function_has_Variable a owl:ObjectProperty ;
  rdfs:label "has Variable" ;
  rdfs:comment "A variable associated with the function." ;
  rdfs:domain :Function ;
  rdfs:range :Variable.

:Variable_has_Name a owl:DatatypeProperty ;
  rdfs:label "has Name" ;
  rdfs:comment "The name of the variable." ;
  rdfs:domain :Variable ;
  rdfs:range xsd:string.

:API_Call_has_Name a owl:DatatypeProperty ;
  rdfs:label "has Name" ;
  rdfs:comment "The name of the API call." ;
  rdfs:domain :API_Call ;
  rdfs:range xsd:string.

:API_Call_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of API call." ;
  rdfs:domain :API_Call ;
  rdfs:range xsd:string.

:MaliciousAPI_Call_has_Name a owl:DatatypeProperty ;
  rdfs:label "has Name" ;
  rdfs:comment "The name of the malicious API call." ;
  rdfs:domain :MaliciousAPI_Call ;
  rdfs:range xsd:string.

:MaliciousAPI_Call_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of malicious API call." ;
  rdfs:domain :MaliciousAPI_Call ;
  rdfs:range xsd:string.

:Networking_Activity_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of networking activity." ;
  rdfs:domain :Networking_Activity ;
  rdfs:range xsd:string.

:ControlFlow_Pattern_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of control flow pattern." ;
  rdfs:domain :ControlFlow_Pattern ;
  rdfs:range xsd:string.

:Entropy_Section_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of entropy section." ;
  rdfs:domain :Entropy_Section ;
  rdfs:range xsd:string.

:SelfReferentialDecode_Loop_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of self-referential decode loop." ;
  rdfs:domain :SelfReferentialDecode_Loop ;
  rdfs:range xsd:string.

:File_System_Abuse_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of file system abuse." ;
  rdfs:domain :File_System_Abuse ;
  rdfs:range xsd:string.

:Jump_To_Memory_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of jump to memory." ;
  rdfs:domain :Jump_To_Memory ;
  rdfs:range xsd:string.

:Imported_Function_has_Percentage a owl:DatatypeProperty ;
  rdfs:label "has Percentage" ;
  rdfs:comment "The percentage of imported functions." ;
  rdfs:domain :Imported_Function ;
  rdfs:range xsd:decimal.

:Cryptographic_Activity_has_Type a owl:DatatypeProperty ;
  rdfs:label "has Type" ;
  rdfs:comment "The type of cryptographic activity." ;
  rdfs:domain :Cryptographic_Activity ;
  rdfs:range xsd:string.

:ExecutableFile_has_Entropy_Section a owl:ObjectProperty ;
  rdfs:label "has Entropy Section" ;
  rdfs:comment "An entropy section in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Entropy_Section.

:Entropy_Section_has_Entropy_Ratio a owl:DatatypeProperty ;
  rdfs:label "has Entropy Ratio" ;
  rdfs:comment "The entropy ratio of the entropy section." ;
  rdfs:domain :Entropy_Section ;
  rdfs:range xsd:decimal.

:ExecutableFile_has_MaliciousAPI_Call a owl:ObjectProperty ;
  rdfs:label "has Malicious API Call" ;
  rdfs:comment "A malicious API call in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :MaliciousAPI_Call.

:ExecutableFile_has_Networking_Activity a owl:ObjectProperty ;
  rdfs:label "has Networking Activity" ;
  rdfs:comment "A networking activity in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Networking_Activity.

:ExecutableFile_has_ControlFlow_Pattern a owl:ObjectProperty ;
  rdfs:label "has Control Flow Pattern" ;
  rdfs:comment "A control flow pattern in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :ControlFlow_Pattern.

:ExecutableFile_has_SelfReferentialDecode_Loop a owl:ObjectProperty ;
  rdfs:label "has Self-Referential Decode Loop" ;
  rdfs:comment "A self-referential decode loop in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :SelfReferentialDecode_Loop.

:ExecutableFile_has_File_System_Abuse a owl:ObjectProperty ;
  rdfs:label "has File System Abuse" ;
  rdfs:comment "A file system abuse in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :File_System_Abuse.

:ExecutableFile_has_Jump_To_Memory a owl:ObjectProperty ;
  rdfs:label "has Jump To Memory" ;
  rdfs:comment "A jump to memory in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Jump_To_Memory.

:ExecutableFile_has_Cryptographic_Activity a owl:ObjectProperty ;
  rdfs:label "has Cryptographic Activity" ;
  rdfs:comment "A cryptographic activity in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Cryptographic_Activity.

:ExecutableFile_has_Imported_Function a owl:ObjectProperty ;
  rdfs:label "has Imported Function" ;
  rdfs:comment "An imported function in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Imported_Function.