@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "LCAnet Ontology" ;
  rdfs:comment "Ontology for Life Cycle Assessment network".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An activity in the LCA model".

:Flow a owl:Class ;
  rdfs:label "Flow" ;
  rdfs:comment "A flow in the LCA model".

:InputFlow a owl:Class ;
  rdfs:label "Input Flow" ;
  rdfs:comment "An input flow in the LCA model" ;
  rdfs:subClassOf :Flow.

:OutputFlow a owl:Class ;
  rdfs:label "Output Flow" ;
  rdfs:comment "An output flow in the LCA model" ;
  rdfs:subClassOf :Flow.

:Dependency a owl:Class ;
  rdfs:label "Dependency" ;
  rdfs:comment "A dependency between activities in the LCA model".

:FlowDataset a owl:Class ;
  rdfs:label "Flow Dataset" ;
  rdfs:comment "A flow dataset in the LCA model".

:Database a owl:Class ;
  rdfs:label "Database" ;
  rdfs:comment "A database in the LCA model".

:Resource a owl:Class ;
  rdfs:label "Resource" ;
  rdfs:comment "A resource flow in the LCA model" ;
  rdfs:subClassOf :Flow.

:Emission a owl:Class ;
  rdfs:label "Emission" ;
  rdfs:comment "An emission flow in the LCA model" ;
  rdfs:subClassOf :Flow.

:Product a owl:Class ;
  rdfs:label "Product" ;
  rdfs:comment "A product flow in the LCA model" ;
  rdfs:subClassOf :Flow.

:FunctionalUnit a owl:Class ;
  rdfs:label "Functional Unit" ;
  rdfs:comment "The functional unit of the LCA model".

:Scope a owl:Class ;
  rdfs:label "Scope" ;
  rdfs:comment "The scope of the LCA model".

:SystemBoundary a owl:Class ;
  rdfs:label "System Boundary" ;
  rdfs:comment "The system boundary of the LCA model".

:ResponsibleAgent a owl:Class ;
  rdfs:label "Responsible Agent" ;
  rdfs:comment "The responsible agent of the LCA model".

:ImpactCategory a owl:Class ;
  rdfs:label "Impact Category" ;
  rdfs:comment "An impact category in the LCA model".

:ImpactResult a owl:Class ;
  rdfs:label "Impact Result" ;
  rdfs:comment "The impact result of a given activity or flow across impact categories".

:FlowContributor a owl:Class ;
  rdfs:label "Flow Contributor" ;
  rdfs:comment "A flow that contributes significantly to a given impact category".

:TopContributor a owl:Class ;
  rdfs:label "Top Contributor" ;
  rdfs:comment "The top contributor to an impact category for a given activity".

:FlowAmount a owl:Class ;
  rdfs:label "Flow Amount" ;
  rdfs:comment "The total amount of a flow generated within the system boundary".

:hasInputFlow a owl:ObjectProperty ;
  rdfs:label "has input flow" ;
  rdfs:comment "The input flows of an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :InputFlow.

:hasOutputFlow a owl:ObjectProperty ;
  rdfs:label "has output flow" ;
  rdfs:comment "The output flows of an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :OutputFlow.

:hasDependency a owl:ObjectProperty ;
  rdfs:label "has dependency" ;
  rdfs:comment "The dependencies of an activity" ;
  rdfs:domain :Activity ;
  rdfs:range :Dependency.

:hasFlowDataset a owl:ObjectProperty ;
  rdfs:label "has flow dataset" ;
  rdfs:comment "The flow datasets of a flow" ;
  rdfs:domain :Flow ;
  rdfs:range :FlowDataset.

:hasDatabase a owl:ObjectProperty ;
  rdfs:label "has database" ;
  rdfs:comment "The database of a flow dataset" ;
  rdfs:domain :FlowDataset ;
  rdfs:range :Database.

:hasResource a owl:ObjectProperty ;
  rdfs:label "has resource" ;
  rdfs:comment "The resource flows of a flow" ;
  rdfs:domain :Flow ;
  rdfs:range :Resource.

:hasEmission a owl:ObjectProperty ;
  rdfs:label "has emission" ;
  rdfs:comment "The emission flows of a flow" ;
  rdfs:domain :Flow ;
  rdfs:range :Emission.

:hasProduct a owl:ObjectProperty ;
  rdfs:label "has product" ;
  rdfs:comment "The product flows of a flow" ;
  rdfs:domain :Flow ;
  rdfs:range :Product.

:hasFunctionalUnit a owl:ObjectProperty ;
  rdfs:label "has functional unit" ;
  rdfs:comment "The functional unit of the LCA model" ;
  rdfs:domain :Activity ;
  rdfs:range :FunctionalUnit.

:hasScope a owl:ObjectProperty ;
  rdfs:label "has scope" ;
  rdfs:comment "The scope of the LCA model" ;
  rdfs:domain :Activity ;
  rdfs:range :Scope.

:hasSystemBoundary a owl:ObjectProperty ;
  rdfs:label "has system boundary" ;
  rdfs:comment "The system boundary of the LCA model" ;
  rdfs:domain :Activity ;
  rdfs:range :SystemBoundary.

:hasResponsibleAgent a owl:ObjectProperty ;
  rdfs:label "has responsible agent" ;
  rdfs:comment "The responsible agent of the LCA model" ;
  rdfs:domain :Activity ;
  rdfs:range :ResponsibleAgent.

:hasImpactCategory a owl:ObjectProperty ;
  rdfs:label "has impact category" ;
  rdfs:comment "The impact categories of an impact result" ;
  rdfs:domain :ImpactResult ;
  rdfs:range :ImpactCategory.

:hasImpactResult a owl:ObjectProperty ;
  rdfs:label "has impact result" ;
  rdfs:comment "The impact results of an activity or flow" ;
  rdfs:domain :Activity ;
  rdfs:range :ImpactResult.

:hasFlowContributor a owl:ObjectProperty ;
  rdfs:label "has flow contributor" ;
  rdfs:comment "The flows that contribute significantly to a given impact category" ;
  rdfs:domain :ImpactResult ;
  rdfs:range :FlowContributor.

:hasTopContributor a owl:ObjectProperty ;
  rdfs:label "has top contributor" ;
  rdfs:comment "The top contributor to an impact category for a given activity" ;
  rdfs:domain :ImpactResult ;
  rdfs:range :TopContributor.

:hasFlowAmount a owl:ObjectProperty ;
  rdfs:label "has flow amount" ;
  rdfs:comment "The total amount of a flow generated within the system boundary" ;
  rdfs:domain :Flow ;
  rdfs:range xsd:decimal.