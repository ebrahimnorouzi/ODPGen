@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "WISDOM Ontology" ;
  rdfs:comment "A formalized and extensible conceptual data model for representing stress conditions, sensor- and wearable-device-related data structures.".

:StressCondition a owl:Class ;
  rdfs:label "Stress Condition" ;
  rdfs:comment "A condition that can be distinguished in a stress-related setting.".

:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "An event, condition, or stimulus that has the potential to induce stress in a subject.".

:ShortTermStressor a owl:Class ;
  rdfs:label "Short-term Stressor" ;
  rdfs:comment "A stressor that can occur in a short-term stress-related setting.".

:StressResponse a owl:Class ;
  rdfs:label "Stress Response" ;
  rdfs:comment "A response caused by a given stressor.".

:BaselineState a owl:Class ;
  rdfs:label "Baseline State" ;
  rdfs:comment "A condition that describes a baseline or recovery state.".

:ActivityPhase a owl:Class ;
  rdfs:label "Activity Phase" ;
  rdfs:comment "An activity or experimental phase that can be described.".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An activity linked to a stress condition.".

:StressorActivityPhase a owl:ObjectProperty ;
  rdfs:label "Stressor Activity Phase" ;
  rdfs:comment "A stressor associated with a specific activity phase." ;
  domain :Stressor ;
  range :ActivityPhase.

:ActivityPhase a owl:Class ;
  rdfs:label "Activity Phase" ;
  rdfs:comment "An activity or experimental phase that can be described.".

:Subject a owl:Class ;
  rdfs:label "Subject" ;
  rdfs:comment "A person taking a role in the model.".

:PhysiologicalSensor a owl:Class ;
  rdfs:label "Physiological Sensor" ;
  rdfs:comment "A sensor used for stress-related measurements.".

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "A device or platform used as a measurement platform.".

:PPGSensor a owl:Class ;
  rdfs:label "PPG Sensor" ;
  rdfs:comment "A sensor that can measure photoplethysmography (PPG) properties.".

:EDASensor a owl:Class ;
  rdfs:label "EDA Sensor" ;
  rdfs:comment "A sensor that can measure electrodermal activity (EDA) properties.".

:TemperatureSensor a owl:Class ;
  rdfs:label "Temperature Sensor" ;
  rdfs:comment "A sensor that can measure temperature properties.".

:Accelerometer a owl:Class ;
  rdfs:label "Accelerometer" ;
  rdfs:comment "A sensor that can capture acceleration-related properties.".

:MeasurableProperty a owl:Class ;
  rdfs:label "Measurable Property" ;
  rdfs:comment "A category of measurable properties.".

:PhysiologicalProperty a owl:Class ;
  rdfs:label "Physiological Property" ;
  rdfs:comment "A physiological property that can be measured.".

:BehavioralIndicator a owl:Class ;
  rdfs:label "Behavioral Indicator" ;
  rdfs:comment "A behavioral indicator that can be described.".

:EnvironmentalFactor a owl:Class ;
  rdfs:label "Environmental Factor" ;
  rdfs:comment "An environmental factor that can be captured.".

:EnvironmentalProperty a owl:Class ;
  rdfs:label "Environmental Property" ;
  rdfs:comment "An environmental property that can be assigned to an environment.".

:PhysiologicalRecord a owl:Class ;
  rdfs:label "Physiological Record" ;
  rdfs:comment "A record that can store metadata for a physiological observation.".

:SignalChannel a owl:Class ;
  rdfs:label "Signal Channel" ;
  rdfs:comment "A channel that can connect a physiological record to its signal.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation that can be described.".

:TimeSeriesObservation a owl:Class ;
  rdfs:label "Time Series Observation" ;
  rdfs:comment "A time series observation that can be assigned temporal information.".

:Annotation a owl:Class ;
  rdfs:label "Annotation" ;
  rdfs:comment "An annotation that can be assigned to an activity or phase.".

:BiomarkerAssay a owl:Class ;
  rdfs:label "Biomarker Assay" ;
  rdfs:comment "A biomarker assay that can be described.".

:Time a owl:DatatypeProperty ;
  rdfs:label "Time" ;
  rdfs:comment "The time of a biomarker assay." ;
  domain :BiomarkerAssay ;
  range xsd:dateTime.