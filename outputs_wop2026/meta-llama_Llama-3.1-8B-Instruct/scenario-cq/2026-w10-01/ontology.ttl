@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software-Hardware Matching Ontology" ;
  rdfs:comment "Ontology for describing software and hardware requirements and characteristics.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware entity.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement of a software or hardware.".

:SoftwareRequirement a owl:Class ;
  rdfs:label "Software Requirement" ;
  rdfs:comment "A requirement of a software.".

:HardwareRequirement a owl:Class ;
  rdfs:label "Hardware Requirement" ;
  rdfs:comment "A requirement of a hardware.".

:SoftwareCharacteristic a owl:Class ;
  rdfs:label "Software Characteristic" ;
  rdfs:comment "A characteristic of a software.".

:HardwareCharacteristic a owl:Class ;
  rdfs:label "Hardware Characteristic" ;
  rdfs:comment "A characteristic of a hardware.".

:Software a :Software ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity.".

:Hardware a :Hardware ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware entity.".

:hasRequirement a owl:ObjectProperty ;
  rdfs:label "has Requirement" ;
  rdfs:comment "A software or hardware has a requirement." ;
  rdfs:domain :Software ;
  rdfs:range :Requirement.

:hasSoftwareRequirement a owl:ObjectProperty ;
  rdfs:label "has Software Requirement" ;
  rdfs:comment "A software has a software requirement." ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareRequirement.

:hasHardwareRequirement a owl:ObjectProperty ;
  rdfs:label "has Hardware Requirement" ;
  rdfs:comment "A hardware has a hardware requirement." ;
  rdfs:domain :Hardware ;
  rdfs:range :HardwareRequirement.

:hasSoftwareCharacteristic a owl:ObjectProperty ;
  rdfs:label "has Software Characteristic" ;
  rdfs:comment "A software has a software characteristic." ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareCharacteristic.

:hasHardwareCharacteristic a owl:ObjectProperty ;
  rdfs:label "has Hardware Characteristic" ;
  rdfs:comment "A hardware has a hardware characteristic." ;
  rdfs:domain :Hardware ;
  rdfs:range :HardwareCharacteristic.

:isRequiredBy a owl:ObjectProperty ;
  rdfs:label "is Required By" ;
  rdfs:comment "A software or hardware is required by another software or hardware." ;
  rdfs:domain :Software ;
  rdfs:range :Software.

:isRequiredSoftware a owl:ObjectProperty ;
  rdfs:label "is Required Software" ;
  rdfs:comment "A software is required by another software." ;
  rdfs:domain :Software ;
  rdfs:range :Software.

:isRequiredHardware a owl:ObjectProperty ;
  rdfs:label "is Required Hardware" ;
  rdfs:comment "A hardware is required by another hardware." ;
  rdfs:domain :Hardware ;
  rdfs:range :Hardware.

:isRequiredType a owl:DatatypeProperty ;
  rdfs:label "is Required Type" ;
  rdfs:comment "The type of software or hardware required." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.

:isRequiredValue a owl:DatatypeProperty ;
  rdfs:label "is Required Value" ;
  rdfs:comment "The required value of a property of a software or hardware." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.

:isRequiredVersion a owl:DatatypeProperty ;
  rdfs:label "is Required Version" ;
  rdfs:comment "The required version of a software." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.

:isRequiredMinValue a owl:DatatypeProperty ;
  rdfs:label "is Required Min Value" ;
  rdfs:comment "The minimum required value of a property of a software or hardware." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.

:isRequiredMaxValue a owl:DatatypeProperty ;
  rdfs:label "is Required Max Value" ;
  rdfs:comment "The maximum required value of a property of a software or hardware." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.

:isRequiredExactValue a owl:DatatypeProperty ;
  rdfs:label "is Required Exact Value" ;
  rdfs:comment "The exact required value of a property of a software or hardware." ;
  rdfs:domain :Software ;
  rdfs:range xsd:string.