@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Pedagogical Organization and Learning Dynamics Ontology" ;
  rdfs:comment "This ontology represents pedagogical organization, including frameworks, elements, and their order; objective alignment across learning objectives, pedagogical techniques, and learning resources; evaluation, including assessment exercises, techniques, metrics, and results; feedback responses, including source and temporal information; learner context, including goals, preferences, challenges, and situations; and learner awareness as topic or skill-scoped information that changes over time.".

:PedagogicalFramework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A pedagogical framework is a structured approach to organizing instructional content and activities.".

:PedagogicalElement a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "A pedagogical element is a component of a pedagogical framework, such as a module or activity.".

:PedagogicalElementOrder a owl:Class ;
  rdfs:label "Pedagogical Element Order" ;
  rdfs:comment "The order in which pedagogical elements are presented to the learner.".

:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound (SMART) goal that a learner aims to accomplish.".

:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A method or approach used to support learning, such as discussion, role-playing, or problem-solving.".

:LearningResource a owl:Class ;
  rdfs:label "Learning Resource" ;
  rdfs:comment "A material or tool used to support learning, such as a textbook, video, or online course.".

:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An activity designed to evaluate a learner's progress toward a learning objective.".

:EvaluationTechnique a owl:Class ;
  rdfs:label "Evaluation Technique" ;
  rdfs:comment "A method used to assess a learner's progress, such as a quiz, test, or project.".

:EvaluationMetric a owl:Class ;
  rdfs:label "Evaluation Metric" ;
  rdfs:comment "A measure used to quantify a learner's progress, such as a grade or score.".

:FeedbackResponse a owl:Class ;
  rdfs:label "Feedback Response" ;
  rdfs:comment "A response to a learner's performance, such as a comment, grade, or recommendation.".

:LearnerContext a owl:Class ;
  rdfs:label "Learner Context" ;
  rdfs:comment "The circumstances and characteristics of a learner, such as their goals, preferences, challenges, and situation.".

:LearnerGoal a owl:Class ;
  rdfs:label "Learner Goal" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound (SMART) goal that a learner aims to accomplish.".

:LearnerPreference a owl:Class ;
  rdfs:label "Learner Preference" ;
  rdfs:comment "A characteristic or trait of a learner, such as their learning style, pace, or interests.".

:LearnerChallenge a owl:Class ;
  rdfs:label "Learner Challenge" ;
  rdfs:comment "A difficulty or obstacle that a learner faces, such as a language barrier or lack of resources.".

:LearnerSituation a owl:Class ;
  rdfs:label "Learner Situation" ;
  rdfs:comment "The circumstances and characteristics of a learner, such as their goals, preferences, challenges, and situation.".

:LearnerAwareness a owl:Class ;
  rdfs:label "Learner Awareness" ;
  rdfs:comment "A learner's understanding or perception of a topic or skill, which can change over time.".

:Topic a owl:Class ;
  rdfs:label "Topic" ;
  rdfs:comment "A subject or area of study, such as mathematics, science, or language arts.".

:Skill a owl:Class ;
  rdfs:label "Skill" ;
  rdfs:comment "A proficiency or ability that a learner can develop, such as writing, problem-solving, or critical thinking.".

:Goal a owl:ObjectProperty ;
  rdfs:label "Goal" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound (SMART) goal that a learner aims to accomplish." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerGoal.

:Preference a owl:ObjectProperty ;
  rdfs:label "Preference" ;
  rdfs:comment "A characteristic or trait of a learner, such as their learning style, pace, or interests." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerPreference.

:Challenge a owl:ObjectProperty ;
  rdfs:label "Challenge" ;
  rdfs:comment "A difficulty or obstacle that a learner faces, such as a language barrier or lack of resources." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerChallenge.

:Situation a owl:ObjectProperty ;
  rdfs:label "Situation" ;
  rdfs:comment "The circumstances and characteristics of a learner, such as their goals, preferences, challenges, and situation." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerSituation.

:Awareness a owl:ObjectProperty ;
  rdfs:label "Awareness" ;
  rdfs:comment "A learner's understanding or perception of a topic or skill, which can change over time." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerAwareness.

:HasPedagogicalElement a owl:ObjectProperty ;
  rdfs:label "Has Pedagogical Element" ;
  rdfs:comment "A pedagogical framework contains one or more pedagogical elements." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :PedagogicalElement.

:Follows a owl:ObjectProperty ;
  rdfs:label "Follows" ;
  rdfs:comment "A pedagogical element follows another pedagogical element in a pedagogical framework." ;
  rdfs:domain :PedagogicalElement ;
  rdfs:range :PedagogicalElement.

:Contains a owl:ObjectProperty ;
  rdfs:label "Contains" ;
  rdfs:comment "A pedagogical framework contains one or more pedagogical elements." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :PedagogicalElement.

:Aligns a owl:ObjectProperty ;
  rdfs:label "Aligns" ;
  rdfs:comment "A learning objective is aligned with one or more pedagogical techniques and learning resources." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :PedagogicalTechnique.

:Supports a owl:ObjectProperty ;
  rdfs:label "Supports" ;
  rdfs:comment "A pedagogical technique supports one or more learning objectives." ;
  rdfs:domain :PedagogicalTechnique ;
  rdfs:range :LearningObjective.

:Uses a owl:ObjectProperty ;
  rdfs:label "Uses" ;
  rdfs:comment "A pedagogical technique uses one or more learning resources." ;
  rdfs:domain :PedagogicalTechnique ;
  rdfs:range :LearningResource.

:HasAssessmentExercise a owl:ObjectProperty ;
  rdfs:label "Has Assessment Exercise" ;
  rdfs:comment "A learning objective is evaluated by one or more assessment exercises." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :AssessmentExercise.

:UsesEvaluationTechnique a owl:ObjectProperty ;
  rdfs:label "Uses Evaluation Technique" ;
  rdfs:comment "An assessment exercise uses one or more evaluation techniques." ;
  rdfs:domain :AssessmentExercise ;
  rdfs:range :EvaluationTechnique.

:UsesEvaluationMetric a owl:ObjectProperty ;
  rdfs:label "Uses Evaluation Metric" ;
  rdfs:comment "An evaluation technique uses one or more evaluation metrics." ;
  rdfs:domain :EvaluationTechnique ;
  rdfs:range :EvaluationMetric.

:ProvidesFeedback a owl:ObjectProperty ;
  rdfs:label "Provides Feedback" ;
  rdfs:comment "A feedback response provides feedback on one or more learning objectives." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range :LearningObjective.

:HasLearnerContext a owl:ObjectProperty ;
  rdfs:label "Has Learner Context" ;
  rdfs:comment "A learning objective is relevant to one or more learner contexts." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :LearnerContext.

:HasTopic a owl:ObjectProperty ;
  rdfs:label "Has Topic" ;
  rdfs:comment "A learning objective is relevant to one or more topics." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Topic.

:HasSkill a owl:ObjectProperty ;
  rdfs:label "Has Skill" ;
  rdfs:comment "A learning objective is relevant to one or more skills." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Skill.

:HasGoal a owl:ObjectProperty ;
  rdfs:label "Has Goal" ;
  rdfs:comment "A learner has one or more goals." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerGoal.

:HasPreference a owl:ObjectProperty ;
  rdfs:label "Has Preference" ;
  rdfs:comment "A learner has one or more preferences." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerPreference.

:HasChallenge a owl:ObjectProperty ;
  rdfs:label "Has Challenge" ;
  rdfs:comment "A learner has one or more challenges." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerChallenge.

:HasSituation a owl:ObjectProperty ;
  rdfs:label "Has Situation" ;
  rdfs:comment "A learner has one or more situations." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerSituation.

:HasAwareness a owl:ObjectProperty ;
  rdfs:label "Has Awareness" ;
  rdfs:comment "A learner has one or more awareness levels." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerAwareness.

:TopicAwareness a owl:ObjectProperty ;
  rdfs:label "Topic Awareness" ;
  rdfs:comment "A learner's awareness level for a topic." ;
  rdfs:domain :Learner ;
  rdfs:range xsd:boolean.

:SkillAwareness a owl:ObjectProperty ;
  rdfs:label "Skill Awareness" ;
  rdfs:comment "A learner's awareness level for a skill." ;
  rdfs:domain :Learner ;
  rdfs:range xsd:boolean.

:LowAwareness a owl:ObjectProperty ;
  rdfs:label "Low Awareness" ;
  rdfs:comment "A topic or skill has low awareness for a learner." ;
  rdfs:domain :Topic ;
  rdfs:range xsd:boolean.

:MostRecentAwareness a owl:ObjectProperty ;
  rdfs:label "Most Recent Awareness" ;
  rdfs:comment "The most recent awareness observation for a learner." ;
  rdfs:domain :Learner ;
  rdfs:range :LearnerAwareness.

:AssessmentEvidence a owl:ObjectProperty ;
  rdfs:label "Assessment Evidence" ;
  rdfs:comment "Assessment evidence contributed to a learner's current awareness observation." ;
  rdfs:domain :LearnerAwareness ;
  rdfs:range :AssessmentExercise.

:Feedback a owl:ObjectProperty ;
  rdfs:label "Feedback" ;
  rdfs:comment "Feedback was given to a learner." ;
  rdfs:domain :Learner ;
  rdfs:range :FeedbackResponse.

:Response a owl:ObjectProperty ;
  rdfs:label "Response" ;
  rdfs:comment "A response was delivered to a learner." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:Source a owl:ObjectProperty ;
  rdfs:label "Source" ;
  rdfs:comment "The source of a feedback response." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:string.

:TemporalInformation a owl:ObjectProperty ;
  rdfs:label "Temporal Information" ;
  rdfs:comment "Temporal information about a feedback response." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:dateTime.

:CorrectiveFeedback a owl:ObjectProperty ;
  rdfs:label "Corrective Feedback" ;
  rdfs:comment "Corrective feedback was given to a learner." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:MotivationalFeedback a owl:ObjectProperty ;
  rdfs:label "Motivational Feedback" ;
  rdfs:comment "Motivational feedback was given to a learner." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:HumanSource a owl:ObjectProperty ;
  rdfs:label "Human Source" ;
  rdfs:comment "The feedback response originated from a human source." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:AutomatedSource a owl:ObjectProperty ;
  rdfs:label "Automated Source" ;
  rdfs:comment "The feedback response originated from an automated or AI source." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:FeedbackEffect a owl:ObjectProperty ;
  rdfs:label "Feedback Effect" ;
  rdfs:comment "The feedback response may affect the learner's next learning strategy." ;
  rdfs:domain :FeedbackResponse ;
  rdfs:range xsd:boolean.

:AwarenessChange a owl:ObjectProperty ;
  rdfs:label "Awareness Change" ;
  rdfs:comment "The learner's awareness changed after feedback or response." ;
  rdfs:domain :Learner ;
  rdfs:range xsd:boolean.

