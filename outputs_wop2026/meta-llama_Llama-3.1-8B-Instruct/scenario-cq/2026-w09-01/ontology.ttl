@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Climate Services Ontology" ;
  rdfs:comment "Ontology for climate services domain".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A variable is a property of a system that can be measured or observed".

:IndependentVariable a owl:Class ;
  rdfs:label "Independent Variable" ;
  rdfs:comment "An independent variable is a variable that is not dependent on any other variable".

:DependentVariable a owl:Class ;
  rdfs:label "Dependent Variable" ;
  rdfs:comment "A dependent variable is a variable that is dependent on one or more other variables".

:DimensionalSpace a owl:Class ;
  rdfs:label "Dimensional Space" ;
  rdfs:comment "A dimensional space is a space in which a variable takes its values".

:ContinuousDimensionalSpace a owl:Class ;
  rdfs:label "Continuous Dimensional Space" ;
  rdfs:comment "A continuous dimensional space is a space in which a variable takes its values continuously".

:DiscreteDimensionalSpace a owl:Class ;
  rdfs:label "Discrete Dimensional Space" ;
  rdfs:comment "A discrete dimensional space is a space in which a variable takes its values discretely".

:VariableDependency a owl:ObjectProperty ;
  rdfs:label "Variable Dependency" ;
  rdfs:comment "A variable dependency is a relationship between a dependent variable and one or more independent variables" ;
  domain :Variable ;
  range :Variable.

:VariableDimensionalSpace a owl:ObjectProperty ;
  rdfs:label "Variable Dimensional Space" ;
  rdfs:comment "A variable dimensional space is a space in which a variable takes its values" ;
  domain :Variable ;
  range :DimensionalSpace.

:IndependentVariableDependency a owl:ObjectProperty ;
  rdfs:label "Independent Variable Dependency" ;
  rdfs:comment "An independent variable dependency is a relationship between a dependent variable and an independent variable" ;
  domain :Variable ;
  range :IndependentVariable.

:DependentVariableDependency a owl:ObjectProperty ;
  rdfs:label "Dependent Variable Dependency" ;
  rdfs:comment "A dependent variable dependency is a relationship between a dependent variable and one or more independent variables" ;
  domain :Variable ;
  range :DependentVariable.

:VariableSpecialization a owl:ObjectProperty ;
  rdfs:label "Variable Specialization" ;
  rdfs:comment "A variable specialization is a relationship between a general variable and a specialized variable" ;
  domain :Variable ;
  range :Variable.

:VariableAggregation a owl:ObjectProperty ;
  rdfs:label "Variable Aggregation" ;
  rdfs:comment "A variable aggregation is a relationship between a dependent variable and an aggregation function" ;
  domain :Variable ;
  range :Variable.

:VariableQuantization a owl:ObjectProperty ;
  rdfs:label "Variable Quantization" ;
  rdfs:comment "A variable quantization is a relationship between a dependent variable and a quantization" ;
  domain :Variable ;
  range :Variable.

:VariableResolution a owl:DatatypeProperty ;
  rdfs:label "Variable Resolution" ;
  rdfs:comment "A variable resolution is a measure of the precision of a variable" ;
  domain :Variable ;
  range xsd:double.

:VariableBinning a owl:DatatypeProperty ;
  rdfs:label "Variable Binning" ;
  rdfs:comment "A variable binning is a measure of the size of a bin in a variable" ;
  domain :Variable ;
  range xsd:double.

:VariableSampling a owl:DatatypeProperty ;
  rdfs:label "Variable Sampling" ;
  rdfs:comment "A variable sampling is a measure of the frequency of sampling in a variable" ;
  domain :Variable ;
  range xsd:double.

:VariableAggregationFunction a owl:DatatypeProperty ;
  rdfs:label "Variable Aggregation Function" ;
  rdfs:comment "A variable aggregation function is a function that aggregates values in a variable" ;
  domain :Variable ;
  range xsd:string.

:VariableQuantizationGranularity a owl:DatatypeProperty ;
  rdfs:label "Variable Quantization Granularity" ;
  rdfs:comment "A variable quantization granularity is a measure of the granularity of a variable" ;
  domain :Variable ;
  range xsd:string.

:VariableDimensionalSpaceType a owl:DatatypeProperty ;
  rdfs:label "Variable Dimensional Space Type" ;
  rdfs:comment "A variable dimensional space type is a measure of the type of a variable dimensional space" ;
  domain :Variable ;
  range xsd:string.

:VariableDependencyType a owl:DatatypeProperty ;
  rdfs:label "Variable Dependency Type" ;
  rdfs:comment "A variable dependency type is a measure of the type of a variable dependency" ;
  domain :Variable ;
  range xsd:string.

:VariableSpecializationType a owl:DatatypeProperty ;
  rdfs:label "Variable Specialization Type" ;
  rdfs:comment "A variable specialization type is a measure of the type of a variable specialization" ;
  domain :Variable ;
  range xsd:string.

:VariableAggregationType a owl:DatatypeProperty ;
  rdfs:label "Variable Aggregation Type" ;
  rdfs:comment "A variable aggregation type is a measure of the type of a variable aggregation" ;
  domain :Variable ;
  range xsd:string.

:VariableQuantizationType a owl:DatatypeProperty ;
  rdfs:label "Variable Quantization Type" ;
  rdfs:comment "A variable quantization type is a measure of the type of a variable quantization" ;
  domain :Variable ;
  range xsd:string.

:VariableResolutionType a owl:DatatypeProperty ;
  rdfs:label "Variable Resolution Type" ;
  rdfs:comment "A variable resolution type is a measure of the type of a variable resolution" ;
  domain :Variable ;
  range xsd:string.

:VariableBinningType a owl:DatatypeProperty ;
  rdfs:label "Variable Binning Type" ;
  rdfs:comment "A variable binning type is a measure of the type of a variable binning" ;
  domain :Variable ;
  range xsd:string.

:VariableSamplingType a owl:DatatypeProperty ;
  rdfs:label "Variable Sampling Type" ;
  rdfs:comment "A variable sampling type is a measure of the type of a variable sampling" ;
  domain :Variable ;
  range xsd:string.