@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Prompting Task Ontology" ;
  rdfs:comment "Ontology for tasks involving prompting foundation models".

:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "A task that can be solved by a foundation model".

:DataModality a owl:Class ;
  rdfs:label "Data Modality" ;
  rdfs:comment "The type of data used in a task".

:Constraint a owl:Class ;
  rdfs:label "Constraint" ;
  rdfs:comment "A limitation or requirement of a task".

:FoundationModel a owl:Class ;
  rdfs:label "Foundation Model" ;
  rdfs:comment "A type of model used for tasks".

:ModelArchitecture a owl:Class ;
  rdfs:label "Model Architecture" ;
  rdfs:comment "The structure of a foundation model".

:PromptingTechnique a owl:Class ;
  rdfs:label "Prompting Technique" ;
  rdfs:comment "A method for generating prompts for a task".

:Prompt a owl:Class ;
  rdfs:label "Prompt" ;
  rdfs:comment "A query or input for a foundation model".

:Response a owl:Class ;
  rdfs:label "Response" ;
  rdfs:comment "The output of a foundation model".

:Chat a owl:Class ;
  rdfs:label "Chat" ;
  rdfs:comment "A conversation between a user and a foundation model".

:ModelFamily a owl:Class ;
  rdfs:label "Model Family" ;
  rdfs:comment "A group of related foundation models".

:ModelVariant a owl:Class ;
  rdfs:label "Model Variant" ;
  rdfs:comment "A specific version of a foundation model".

:ModelEvolution a owl:Class ;
  rdfs:label "Model Evolution" ;
  rdfs:comment "A change or update to a foundation model".

:PromptingTechniqueSuitability a owl:ObjectProperty ;
  rdfs:label "Suitable for Task" ;
  rdfs:comment "A prompting technique suitable for a task" ;
  domain :PromptingTechnique ;
  range :Task.

:TaskDataModality a owl:ObjectProperty ;
  rdfs:label "Task Data Modality" ;
  rdfs:comment "The data modality of a task" ;
  domain :Task ;
  range :DataModality.

:TaskConstraint a owl:ObjectProperty ;
  rdfs:label "Task Constraint" ;
  rdfs:comment "A constraint of a task" ;
  domain :Task ;
  range :Constraint.

:FoundationModelArchitecture a owl:ObjectProperty ;
  rdfs:label "Model Architecture" ;
  rdfs:comment "The architecture of a foundation model" ;
  domain :FoundationModel ;
  range :ModelArchitecture.

:FoundationModelDataModality a owl:ObjectProperty ;
  rdfs:label "Model Data Modality" ;
  rdfs:comment "The data modality of a foundation model" ;
  domain :FoundationModel ;
  range :DataModality.

:PromptingTechniquePrompt a owl:ObjectProperty ;
  rdfs:label "Technique Generates Prompt" ;
  rdfs:comment "A prompting technique generates a prompt" ;
  domain :PromptingTechnique ;
  range :Prompt.

:PromptResponse a owl:ObjectProperty ;
  rdfs:label "Prompt Response" ;
  rdfs:comment "A response to a prompt" ;
  domain :Prompt ;
  range :Response.

:ChatPrompt a owl:ObjectProperty ;
  rdfs:label "Chat Prompt" ;
  rdfs:comment "A prompt in a chat" ;
  domain :Chat ;
  range :Prompt.

:ChatResponse a owl:ObjectProperty ;
  rdfs:label "Chat Response" ;
  rdfs:comment "A response in a chat" ;
  domain :Chat ;
  range :Response.

:ModelFamilyVariant a owl:ObjectProperty ;
  rdfs:label "Model Family Variant" ;
  rdfs:comment "A variant of a model family" ;
  domain :ModelFamily ;
  range :ModelVariant.

:ModelEvolutionVariant a owl:ObjectProperty ;
  rdfs:label "Model Evolution Variant" ;
  rdfs:comment "A variant of a model evolution" ;
  domain :ModelEvolution ;
  range :ModelVariant.

:PromptingTechniqueSuitabilityForDataModality a owl:ObjectProperty ;
  rdfs:label "Suitable for Data Modality" ;
  rdfs:comment "A prompting technique suitable for tasks targeting a data modality" ;
  domain :PromptingTechnique ;
  range :DataModality.

:PromptingTechniqueSuitabilityForConstraint a owl:ObjectProperty ;
  rdfs:label "Suitable for Constraint" ;
  rdfs:comment "A prompting technique suitable for tasks with a constraint" ;
  domain :PromptingTechnique ;
  range :Constraint.

:PromptingTechniqueSuitabilityForTask a owl:ObjectProperty ;
  rdfs:label "Suitable for Task" ;
  rdfs:comment "A prompting technique suitable for a task" ;
  domain :PromptingTechnique ;
  range :Task.

:PromptingTechniqueSuitabilityForTaskDataModality a owl:ObjectProperty ;
  rdfs:label "Suitable for Task Data Modality" ;
  rdfs:comment "A prompting technique suitable for tasks targeting a data modality" ;
  domain :PromptingTechnique ;
  range :DataModality.

:PromptingTechniqueSuitabilityForTaskConstraint a owl:ObjectProperty ;
  rdfs:label "Suitable for Task Constraint" ;
  rdfs:comment "A prompting technique suitable for tasks with a constraint" ;
  domain :PromptingTechnique ;
  range :Constraint.

:PromptingTechniqueSuitabilityForTaskDataModalityConstraint a owl:ObjectProperty ;
  rdfs:label "Suitable for Task Data Modality Constraint" ;
  rdfs:comment "A prompting technique suitable for tasks targeting a data modality with a constraint" ;
  domain :PromptingTechnique ;
  range :Constraint.