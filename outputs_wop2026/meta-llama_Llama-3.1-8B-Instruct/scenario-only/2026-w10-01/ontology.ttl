@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Matchmaker Ontology" ;
  rdfs:comment "Ontology for the SMARTY matchmaker, enabling the semantic management of digital assets and the dynamic allocation of hardware resources.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity, described in a catalogue.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware entity, described in a catalogue.".

:DPU a owl:Class ;
  rdfs:label "DPU" ;
  rdfs:comment "A DPU (Data Processing Unit) hardware entity.".

:GPU a owl:Class ;
  rdfs:label "GPU" ;
  rdfs:comment "A GPU (Graphics Processing Unit) hardware entity.".

:SoftwareCharacteristic a owl:Class ;
  rdfs:label "Software Characteristic" ;
  rdfs:comment "A characteristic of a software entity.".

:HardwareCharacteristic a owl:Class ;
  rdfs:label "Hardware Characteristic" ;
  rdfs:comment "A characteristic of a hardware entity.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement expressed for a software entity.".

:SoftwareCharacteristicType a owl:DatatypeProperty ;
  rdfs:label "Software Characteristic Type" ;
  rdfs:comment "The type of a software characteristic." ;
  rdfs:domain :SoftwareCharacteristic ;
  rdfs:range xsd:string.

:HardwareCharacteristicType a owl:DatatypeProperty ;
  rdfs:label "Hardware Characteristic Type" ;
  rdfs:comment "The type of a hardware characteristic." ;
  rdfs:domain :HardwareCharacteristic ;
  rdfs:range xsd:string.

:RequirementType a owl:DatatypeProperty ;
  rdfs:label "Requirement Type" ;
  rdfs:comment "The type of a requirement." ;
  rdfs:domain :Requirement ;
  rdfs:range xsd:string.

:softwareCharacteristics a owl:ObjectProperty ;
  rdfs:label "Software Characteristics" ;
  rdfs:comment "The characteristics of a software entity." ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareCharacteristic.

:hardwareCharacteristics a owl:ObjectProperty ;
  rdfs:label "Hardware Characteristics" ;
  rdfs:comment "The characteristics of a hardware entity." ;
  rdfs:domain :Hardware ;
  rdfs:range :HardwareCharacteristic.

:requirements a owl:ObjectProperty ;
  rdfs:label "Requirements" ;
  rdfs:comment "The requirements expressed for a software entity." ;
  rdfs:domain :Software ;
  rdfs:range :Requirement.

:matches a owl:ObjectProperty ;
  rdfs:label "Matches" ;
  rdfs:comment "A software entity matches a hardware entity." ;
  rdfs:domain :Software ;
  rdfs:range :Hardware.

:SoftwareCharacteristicType disjoint :HardwareCharacteristicType.
:HardwareCharacteristicType disjoint :SoftwareCharacteristicType.
:RequirementType disjoint :SoftwareCharacteristicType.
:RequirementType disjoint :HardwareCharacteristicType.