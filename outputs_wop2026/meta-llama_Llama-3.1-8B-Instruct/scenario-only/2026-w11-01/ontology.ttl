@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "WISDOM Stress Detection Ontology" ;
  rdfs:comment "Formalized and extensible conceptual data model for representing stress conditions, sensor- and wearable-device-related data structures.".

:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "Event, condition, or stimulus that has the potential to induce stress in a subject.".

:StressState a owl:Class ;
  rdfs:label "Stress State" ;
  rdfs:comment "Current state of stress in a subject.".

:PhysiologicalResponse a owl:Class ;
  rdfs:label "Physiological Response" ;
  rdfs:comment "Physiological changes, such as decreased heart rate variability, that may reflect stress.".

:SensorMeasurement a owl:Class ;
  rdfs:label "Sensor Measurement" ;
  rdfs:comment "Indirect cues to stress by capturing physiological or behavioral responses.".

:ContextualFactor a owl:Class ;
  rdfs:label "Contextual Factor" ;
  rdfs:comment "Factors that influence the stress response, such as demographics or experimental protocol.".

:StressCondition a owl:Class ;
  rdfs:label "Stress Condition" ;
  rdfs:comment "Specific stress condition, such as cognitive stress or socio-evaluative stress.".

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "Device used to measure physiological responses.".

:WearableDevice a owl:Class ;
  rdfs:label "Wearable Device" ;
  rdfs:comment "Device worn by a subject to measure physiological responses.".

:Subject a owl:Class ;
  rdfs:label "Subject" ;
  rdfs:comment "Individual being studied for stress response.".

:ActivityPhase a owl:Class ;
  rdfs:label "Activity Phase" ;
  rdfs:comment "Phase of an activity, such as baseline or stress.".

:ObservableProperty a owl:Class ;
  rdfs:label "Observable Property" ;
  rdfs:comment "Property of a physiological signal, such as heart rate or electrodermal activity.".

:StressDetection a owl:Class ;
  rdfs:label "Stress Detection" ;
  rdfs:comment "Process of identifying stress in a subject.".

:hasStressor a owl:ObjectProperty ;
  rdfs:label "has Stressor" ;
  rdfs:comment "Relationship between a stress condition and its associated stressor." ;
  owl:domain :StressCondition ;
  owl:range :Stressor.

:hasStressState a owl:ObjectProperty ;
  rdfs:label "has Stress State" ;
  rdfs:comment "Relationship between a subject and their current stress state." ;
  owl:domain :Subject ;
  owl:range :StressState.

:hasPhysiologicalResponse a owl:ObjectProperty ;
  rdfs:label "has Physiological Response" ;
  rdfs:comment "Relationship between a stress condition and its associated physiological response." ;
  owl:domain :StressCondition ;
  owl:range :PhysiologicalResponse.

:hasSensorMeasurement a owl:ObjectProperty ;
  rdfs:label "has Sensor Measurement" ;
  rdfs:comment "Relationship between a stress condition and its associated sensor measurement." ;
  owl:domain :StressCondition ;
  owl:range :SensorMeasurement.

:hasContextualFactor a owl:ObjectProperty ;
  rdfs:label "has Contextual Factor" ;
  rdfs:comment "Relationship between a stress condition and its associated contextual factor." ;
  owl:domain :StressCondition ;
  owl:range :ContextualFactor.

:hasStressCondition a owl:ObjectProperty ;
  rdfs:label "has Stress Condition" ;
  rdfs:comment "Relationship between a subject and their current stress condition." ;
  owl:domain :Subject ;
  owl:range :StressCondition.

:hasSensor a owl:ObjectProperty ;
  rdfs:label "has Sensor" ;
  rdfs:comment "Relationship between a wearable device and its associated sensor." ;
  owl:domain :WearableDevice ;
  owl:range :Sensor.

:hasWearableDevice a owl:ObjectProperty ;
  rdfs:label "has Wearable Device" ;
  rdfs:comment "Relationship between a subject and their associated wearable device." ;
  owl:domain :Subject ;
  owl:range :WearableDevice.

:hasActivityPhase a owl:ObjectProperty ;
  rdfs:label "has Activity Phase" ;
  rdfs:comment "Relationship between a stress condition and its associated activity phase." ;
  owl:domain :StressCondition ;
  owl:range :ActivityPhase.

:hasObservableProperty a owl:ObjectProperty ;
  rdfs:label "has Observable Property" ;
  rdfs:comment "Relationship between a physiological signal and its associated observable property." ;
  owl:domain :PhysiologicalResponse ;
  owl:range :ObservableProperty.

:hasStressDetection a owl:ObjectProperty ;
  rdfs:label "has Stress Detection" ;
  rdfs:comment "Relationship between a stress condition and its associated stress detection process." ;
  owl:domain :StressCondition ;
  owl:range :StressDetection.