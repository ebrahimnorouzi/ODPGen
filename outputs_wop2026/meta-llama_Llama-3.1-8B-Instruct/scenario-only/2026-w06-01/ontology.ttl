  rdfs:comment "A rest area is part of a route." ;
  owl:domain :Route ;
  owl:range :RestArea.

:hasNoiseLevel a owl:ObjectProperty ;
  rdfs:label "Has Noise Level" ;
  rdfs:comment "A spatial area has a noise level." ;
  owl:domain :Area ;
  owl:range :NoiseLevel.

:hasCrowdedness a owl:ObjectProperty ;
  rdfs:label "Has Crowdedness" ;
  rdfs:comment "A spatial area has a crowdedness level." ;
  owl:domain :Area ;
  owl:range :Crowdedness.

