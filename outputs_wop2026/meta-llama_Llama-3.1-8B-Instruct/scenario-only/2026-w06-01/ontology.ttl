:Ontology a owl:Ontology ;
  rdfs:label "LyonTech La Doua Campus Navigation Ontology" ;
  rdfs:comment "An ontology for modeling navigation in LyonTech La Doua campus, considering user preferences and constraints.".

:Building a owl:Class ;
  rdfs:label "Building" ;
  rdfs:comment "A spatial area within the campus.".

:Area a owl:Class ;
  rdfs:label "Area" ;
  rdfs:comment "A spatial area within the campus.".

:Route a owl:Class ;
  rdfs:label "Route" ;
  rdfs:comment "A path connecting two points in the campus.".

:Point a owl:Class ;
  rdfs:label "Point" ;
  rdfs:comment "A location within the campus.".

:VerticalTransition a owl:Class ;
  rdfs:label "VerticalTransition" ;
  rdfs:comment "A type of transition between floors (stairs, elevators, escalators).".

:NoiseLevel a owl:DatatypeProperty ;
  rdfs:label "Noise Level" ;
  rdfs:comment "The level of noise in a spatial area." ;
  owl:domain :Area ;
  owl:range xsd:int.

:Crowdedness a owl:DatatypeProperty ;
  rdfs:label "Crowdedness" ;
  rdfs:comment "The level of crowdedness in a spatial area." ;
  owl:domain :Area ;
  owl:range xsd:int.

:RestArea a owl:Class ;
  rdfs:label "Rest Area" ;
  rdfs:comment "A spatial area designed for rest.".

:Amenity a owl:Class ;
  rdfs:label "Amenity" ;
  rdfs:comment "A service or facility available in the campus.".

:VendingMachine a owl:Class ;
  rdfs:label "Vending Machine" ;
  rdfs:comment "A machine dispensing food or drinks." ;
  rdfs:subClassOf :Amenity.

:Toilet a owl:Class ;
  rdfs:label "Toilet" ;
  rdfs:comment "A facility for personal hygiene." ;
  rdfs:subClassOf :Amenity.

:ReceptionBoard a owl:Class ;
  rdfs:label "Reception Board" ;
  rdfs:comment "A display of information about the campus." ;
  rdfs:subClassOf :Amenity.

:Accessibility a owl:DatatypeProperty ;
  rdfs:label "Accessibility" ;
  rdfs:comment "The level of accessibility of a spatial area." ;
  owl:domain :Area ;
  owl:range xsd:int.

:Weather a owl:DatatypeProperty ;
  rdfs:label "Weather" ;
  rdfs:comment "The current weather conditions." ;
  owl:domain :Area ;
  owl:range xsd:string.

:Lighting a owl:DatatypeProperty ;
  rdfs:label "Lighting" ;
  rdfs:comment "The level of lighting in a spatial area." ;
  owl:domain :Area ;
  owl:range xsd:string.

:Noise a owl:DatatypeProperty ;
  rdfs:label "Noise" ;
  rdfs:comment "The level of noise in a spatial area." ;
  owl:domain :Area ;
  owl:range xsd:string.

:UserPreference a owl:Class ;
  rdfs:label "User Preference" ;
  rdfs:comment "A user's preference for navigation.".

:Indoor a owl:DatatypeProperty ;
  rdfs:label "Indoor" ;
  rdfs:comment "Whether a spatial area is indoors or outdoors." ;
  owl:domain :Area ;
  owl:range xsd:boolean.

:Outdoor a owl:DatatypeProperty ;
  rdfs:label "Outdoor" ;
  rdfs:comment "Whether a spatial area is indoors or outdoors." ;
  owl:domain :Area ;
  owl:range xsd:boolean.

:RouteCharacteristics a owl:ObjectProperty ;
  rdfs:label "Route Characteristics" ;
  rdfs:comment "The characteristics of a route." ;
  owl:domain :Route ;
  owl:range :Area.

:RouteCharacteristics rdfs:subPropertyOf :hasArea.

:hasArea a owl:ObjectProperty ;
