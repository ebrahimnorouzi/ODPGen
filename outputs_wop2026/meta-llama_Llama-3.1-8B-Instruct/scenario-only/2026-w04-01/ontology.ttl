@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software Reverse Engineering Knowledge Graph Ontology" ;
  rdfs:comment "Ontology for modeling software reverse engineering knowledge graphs.".

:Symbol a owl:Class ;
  rdfs:label "Symbol" ;
  rdfs:comment "A symbol in a binary executable file.".

:Function a owl:Class ;
  rdfs:label "Function" ;
  rdfs:comment "A function in a binary executable file." ;
  rdfs:subClassOf :Symbol.

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A variable in a binary executable file." ;
  rdfs:subClassOf :Symbol.

:Label a owl:Class ;
  rdfs:label "Label" ;
  rdfs:comment "A label associated with a symbol." ;
  rdfs:subClassOf :Symbol.

:SymbolTable a owl:Class ;
  rdfs:label "Symbol Table" ;
  rdfs:comment "A collection of symbols in a binary executable file." ;
  rdfs:subClassOf :Symbol.

:KnowledgeGraph a owl:Class ;
  rdfs:label "Knowledge Graph" ;
  rdfs:comment "A graph representing the relationships between symbols.".

:hasSymbol a owl:ObjectProperty ;
  rdfs:label "has Symbol" ;
  rdfs:comment "A symbol in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :Symbol.

:hasFunction a owl:ObjectProperty ;
  rdfs:label "has Function" ;
  rdfs:comment "A function in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :Function.

:hasVariable a owl:ObjectProperty ;
  rdfs:label "has Variable" ;
  rdfs:comment "A variable in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :Variable.

:hasLabel a owl:ObjectProperty ;
  rdfs:label "has Label" ;
  rdfs:comment "A label associated with a symbol in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :Label.

:hasSymbolTable a owl:ObjectProperty ;
  rdfs:label "has Symbol Table" ;
  rdfs:comment "A symbol table in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :SymbolTable.

:renamesLabel a owl:ObjectProperty ;
  rdfs:label "renames Label" ;
  rdfs:comment "A label is renamed in a knowledge graph." ;
  rdfs:domain :KnowledgeGraph ;
  rdfs:range :Label.

:disjointSymbolTable a owl:DisjointClasses ;
  rdf:separators ',';
  rdf:members (:SymbolTable :Symbol).

:disjointFunctionVariable a owl:DisjointClasses ;
  rdf:separators ',';
  rdf:members (:Function :Variable).