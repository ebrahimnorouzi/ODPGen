@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Stress-Related Conditions Ontology" ;
  rdfs:comment "An ontology for modeling stress-related conditions and their associated factors.".

:StressRelatedCondition a owl:Class ;
  rdfs:label "Stress-Related Condition" ;
  rdfs:comment "A condition related to stress.".

:Stressor a owl:Class ;
  rdfs:label "Stressor" ;
  rdfs:comment "A factor that causes stress.".

:ShortTermStressor a owl:Class ;
  rdfs:label "Short-Term Stressor" ;
  rdfs:comment "A stressor that occurs in a short-term setting.".

:StressResponse a owl:Class ;
  rdfs:label "Stress Response" ;
  rdfs:comment "A response to a stressor.".

:BaselineCondition a owl:Class ;
  rdfs:label "Baseline Condition" ;
  rdfs:comment "A condition describing a baseline or recovery state.".

:Activity a owl:Class ;
  rdfs:label "Activity" ;
  rdfs:comment "An activity or experimental phase.".

:StressCondition a owl:ObjectProperty ;
  rdfs:label "Stress Condition" ;
  rdfs:comment "The stress-related condition associated with an activity." ;
  rdfs:domain :Activity ;
  rdfs:range :StressRelatedCondition.

:Stressor a owl:ObjectProperty ;
  rdfs:label "Stressor" ;
  rdfs:comment "The stressor associated with an activity." ;
  rdfs:domain :Activity ;
  rdfs:range :Stressor.

:ShortTermStressor a owl:ObjectProperty ;
  rdfs:label "Short-Term Stressor" ;
  rdfs:comment "The short-term stressor occurring in a stress-related setting." ;
  rdfs:domain :Activity ;
  rdfs:range :ShortTermStressor.

:StressResponse a owl:ObjectProperty ;
  rdfs:label "Stress Response" ;
  rdfs:comment "The stress response caused by a stressor." ;
  rdfs:domain :Stressor ;
  rdfs:range :StressResponse.

:BaselineCondition a owl:ObjectProperty ;
  rdfs:label "Baseline Condition" ;
  rdfs:comment "The baseline condition describing a recovery state." ;
  rdfs:domain :Activity ;
  rdfs:range :BaselineCondition.

:Sensor a owl:Class ;
  rdfs:label "Sensor" ;
  rdfs:comment "A device used for stress-related measurements.".

:PhysiologicalSensor a owl:Class ;
  rdfs:label "Physiological Sensor" ;
  rdfs:comment "A sensor measuring physiological properties." ;
  rdfs:subClassOf :Sensor.

:MovementSensor a owl:Class ;
  rdfs:label "Movement Sensor" ;
  rdfs:comment "A sensor capturing movement-related information." ;
  rdfs:subClassOf :Sensor.

:Device a owl:Class ;
  rdfs:label "Device" ;
  rdfs:comment "A device or platform used as a measurement platform.".

:PPGSensor a owl:Class ;
  rdfs:label "PPG Sensor" ;
  rdfs:comment "A sensor measuring PPG properties." ;
  rdfs:subClassOf :PhysiologicalSensor.

:EDASensor a owl:Class ;
  rdfs:label "EDA Sensor" ;
  rdfs:comment "A sensor measuring EDA properties." ;
  rdfs:subClassOf :PhysiologicalSensor.

:TemperatureSensor a owl:Class ;
  rdfs:label "Temperature Sensor" ;
  rdfs:comment "A sensor measuring temperature properties." ;
  rdfs:subClassOf :PhysiologicalSensor.

:AccelerationSensor a owl:Class ;
  rdfs:label "Acceleration Sensor" ;
  rdfs:comment "A sensor measuring acceleration properties." ;
  rdfs:subClassOf :MovementSensor.

:Property a owl:Class ;
  rdfs:label "Property" ;
  rdfs:comment "A category of measurable properties.".

:PhysiologicalProperty a owl:Class ;
  rdfs:label "Physiological Property" ;
  rdfs:comment "A physiological property that can be measured." ;
  rdfs:subClassOf :Property.

:BehavioralIndicator a owl:Class ;
  rdfs:label "Behavioral Indicator" ;
  rdfs:comment "A behavioral indicator that can be described.".

:EnvironmentalFactor a owl:Class ;
  rdfs:label "Environmental Factor" ;
  rdfs:comment "An environmental factor that can be captured.".

:EnvironmentalProperty a owl:Class ;
  rdfs:label "Environmental Property" ;
  rdfs:comment "An environmental property that can be assigned to an environment.".

:PhysiologicalRecord a owl:Class ;
  rdfs:label "Physiological Record" ;
  rdfs:comment "A record of physiological measurements.".

:SignalChannel a owl:Class ;
  rdfs:label "Signal Channel" ;
  rdfs:comment "A channel for storing signal data.".

:Metadata a owl:Class ;
  rdfs:label "Metadata" ;
  rdfs:comment "Metadata that can be stored for a physiological record.".

:Observation a owl:Class ;
  rdfs:label "Observation" ;
  rdfs:comment "An observation of a physiological property.".

:TimeSeriesObservation a owl:Class ;
  rdfs:label "Time-Series Observation" ;
  rdfs:comment "A time-series observation of a physiological property." ;
  rdfs:subClassOf :Observation.

:Annotation a owl:Class ;
  rdfs:label "Annotation" ;
  rdfs:comment "An annotation that can be stored for a physiological record.".

:ActivityPhase a owl:Class ;
  rdfs:label "Activity Phase" ;
  rdfs:comment "A phase of an activity.".

:Observer a owl:Class ;
  rdfs:label "Observer" ;
  rdfs:comment "A human observer who can be identified as the source of an observation.".

:BiomarkerAssay a owl:Class ;
  rdfs:label "Biomarker Assay" ;
  rdfs:comment "A biomarker assay that can be described.".

:Time a owl:DatatypeProperty ;
  rdfs:label "Time" ;
  rdfs:comment "The time of a biomarker assay." ;
  rdfs:domain :BiomarkerAssay ;
  rdfs:range xsd:dateTime.