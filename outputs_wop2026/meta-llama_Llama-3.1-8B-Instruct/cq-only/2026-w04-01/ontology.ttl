@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Malicious Activity Detection Ontology" ;
  rdfs:comment "Ontology for detecting malicious activities in executables".

:Executable a owl:Class ;
  rdfs:label "Executable" ;
  rdfs:comment "An executable file".

:API_Call a owl:Class ;
  rdfs:label "API Call" ;
  rdfs:comment "An API call within an executable".

:Malicious_API_Call a owl:Class ;
  rdfs:label "Malicious API Call" ;
  rdfs:comment "A malicious API call within an executable" ;
  rdfs:subClassOf :API_Call.

:Networking_Activity a owl:Class ;
  rdfs:label "Networking Activity" ;
  rdfs:comment "Suspicious networking activity within an executable".

:Control_Flow_Pattern a owl:Class ;
  rdfs:label "Control Flow Pattern" ;
  rdfs:comment "An indirect control flow pattern in an executable".

:Entropy_Section a owl:Class ;
  rdfs:label "Entropy Section" ;
  rdfs:comment "A section of entropy in an executable".

:Self_Referential_Decode_Loop a owl:Class ;
  rdfs:label "Self-Referential Decode Loop" ;
  rdfs:comment "A pattern of self-referential decode loops in an executable".

:File_System_Abuse a owl:Class ;
  rdfs:label "File System Abuse" ;
  rdfs:comment "File system abuse within an executable".

:Jump_To_Memory a owl:Class ;
  rdfs:label "Jump To Memory" ;
  rdfs:comment "A suspicious jump into memory in an executable".

:Suspicious_API_Call a owl:Class ;
  rdfs:label "Suspicious API Call" ;
  rdfs:comment "A suspicious API call within an executable" ;
  rdfs:subClassOf :API_Call.

:Cryptographic_Activity a owl:Class ;
  rdfs:label "Cryptographic Activity" ;
  rdfs:comment "Cryptographic activity within an executable".

:Imported_Function a owl:Class ;
  rdfs:label "Imported Function" ;
  rdfs:comment "A function in a binary file that is imported".

:Function a owl:Class ;
  rdfs:label "Function" ;
  rdfs:comment "A function in a binary file".

:Imported_Function_Percentage a owl:DatatypeProperty ;
  rdfs:label "Imported Function Percentage" ;
  rdfs:comment "The percentage of functions in a binary file that are imported" ;
  rdfs:range xsd:decimal.

:has_Malicious_API_Call a owl:ObjectProperty ;
  rdfs:label "Has Malicious API Call" ;
  rdfs:comment "An executable has a malicious API call" ;
  rdfs:domain :Executable ;
  rdfs:range :Malicious_API_Call.

:has_Networking_Activity a owl:ObjectProperty ;
  rdfs:label "Has Networking Activity" ;
  rdfs:comment "An executable has suspicious networking activity" ;
  rdfs:domain :Executable ;
  rdfs:range :Networking_Activity.

:has_Control_Flow_Pattern a owl:ObjectProperty ;
  rdfs:label "Has Control Flow Pattern" ;
  rdfs:comment "An executable has an indirect control flow pattern" ;
  rdfs:domain :Executable ;
  rdfs:range :Control_Flow_Pattern.

:has_Entropy_Section a owl:ObjectProperty ;
  rdfs:label "Has Entropy Section" ;
  rdfs:comment "An executable has a section of entropy" ;
  rdfs:domain :Executable ;
  rdfs:range :Entropy_Section.

:has_Self_Referential_Decode_Loop a owl:ObjectProperty ;
  rdfs:label "Has Self-Referential Decode Loop" ;
  rdfs:comment "An executable has a pattern of self-referential decode loops" ;
  rdfs:domain :Executable ;
  rdfs:range :Self_Referential_Decode_Loop.

:has_File_System_Abuse a owl:ObjectProperty ;
  rdfs:label "Has File System Abuse" ;
  rdfs:comment "An executable has file system abuse" ;
  rdfs:domain :Executable ;
  rdfs:range :File_System_Abuse.

:has_Jump_To_Memory a owl:ObjectProperty ;
  rdfs:label "Has Jump To Memory" ;
  rdfs:comment "An executable has a suspicious jump into memory" ;
  rdfs:domain :Executable ;
  rdfs:range :Jump_To_Memory.

:has_Suspicious_API_Call a owl:ObjectProperty ;
  rdfs:label "Has Suspicious API Call" ;
  rdfs:comment "An executable has a suspicious API call" ;
  rdfs:domain :Executable ;
  rdfs:range :Suspicious_API_Call.

:has_Cryptographic_Activity a owl:ObjectProperty ;
  rdfs:label "Has Cryptographic Activity" ;
  rdfs:comment "An executable has cryptographic activity" ;
  rdfs:domain :Executable ;
  rdfs:range :Cryptographic_Activity.

:has_Imported_Function a owl:ObjectProperty ;
  rdfs:label "Has Imported Function" ;
  rdfs:comment "A binary file has an imported function" ;
  rdfs:domain :Executable ;
  rdfs:range :Imported_Function.

:has_Function a owl:ObjectProperty ;
  rdfs:label "Has Function" ;
  rdfs:comment "A binary file has a function" ;
  rdfs:domain :Executable ;
  rdfs:range :Function.

:has_Imported_Function_Percentage a owl:ObjectProperty ;
  rdfs:label "Has Imported Function Percentage" ;
  rdfs:comment "A binary file has the percentage of imported functions" ;
  rdfs:domain :Executable ;
  rdfs:range :Imported_Function_Percentage.