:Ontology a owl:Ontology ;
  rdfs:label "Dimensional Space Ontology" ;
  rdfs:comment "Ontology for modeling dimensional spaces and their properties".

:DimensionalSpace a owl:Class ;
  rdfs:label "Dimensional Space" ;
  rdfs:comment "A dimensional space is a mathematical space in which a variable takes its values".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A variable is a mathematical function that assigns a value to each point in a dimensional space".

:IndependentVariable a owl:Class ;
  rdfs:label "Independent Variable" ;
  rdfs:comment "An independent variable is a variable that is not dependent on any other variable".

:DependentVariable a owl:Class ;
  rdfs:label "Dependent Variable" ;
  rdfs:comment "A dependent variable is a variable that depends on one or more other variables".

:Dimension a owl:Class ;
  rdfs:label "Dimension" ;
  rdfs:comment "A dimension is a characteristic or attribute of a variable".

:DimensionalSpaceDimension a owl:ObjectProperty ;
  rdfs:label "dimensional space dimension" ;
  rdfs:comment "A dimensional space has one or more dimensions" ;
  domain :DimensionalSpace ;
  range :Dimension.

:VariableDimension a owl:ObjectProperty ;
  rdfs:label "variable dimension" ;
  rdfs:comment "A variable has one or more dimensions" ;
  domain :Variable ;
  range :Dimension.

:IndependentVariableOf a owl:ObjectProperty ;
  rdfs:label "independent variable of" ;
  rdfs:comment "A dependent variable depends on one or more independent variables" ;
  domain :DependentVariable ;
  range :IndependentVariable.

:DependentVariableOf a owl:ObjectProperty ;
  rdfs:label "dependent variable of" ;
  rdfs:comment "An independent variable is the independent variable of one or more dependent variables" ;
  domain :IndependentVariable ;
  range :DependentVariable.

:SpecializationOf a owl:ObjectProperty ;
  rdfs:label "specialization of" ;
  rdfs:comment "A variable is a specialization of a more general variable" ;
  domain :Variable ;
  range :Variable.

:ConstrainedBy a owl:ObjectProperty ;
  rdfs:label "constrained by" ;
  rdfs:comment "A variable is constrained by one or more independent variables" ;
  domain :Variable ;
  range :IndependentVariable.

:RescaledVersionOf a owl:ObjectProperty ;
  rdfs:label "rescaled version of" ;
  rdfs:comment "A variable is a rescaled version of another variable" ;
  domain :Variable ;
  range :Variable.

:ComponentVariableOf a owl:ObjectProperty ;
  rdfs:label "component variable of" ;
  rdfs:comment "A composite variable has one or more component variables" ;
  domain :Variable ;
  range :Variable.

:AggregationOf a owl:ObjectProperty ;
  rdfs:label "aggregation of" ;
  rdfs:comment "A variable is aggregated over one or more other variables" ;
  domain :Variable ;
  range :Variable.

:QuantizationOf a owl:ObjectProperty ;
  rdfs:label "quantization of" ;
  rdfs:comment "A variable is quantized over one or more other variables" ;
  domain :Variable ;
  range :Variable.

:DiscretizationOf a owl:ObjectProperty ;
  rdfs:label "discretization of" ;
  rdfs:comment "A variable is discretized over one or more other variables" ;
  domain :Variable ;
  range :Variable.

:ResolutionOf a owl:DatatypeProperty ;
  rdfs:label "resolution" ;
  rdfs:comment "The resolution of a variable is the smallest unit of measurement" ;
  domain :Variable ;
  range xsd:integer.

:BoundingRegionOf a owl:ObjectProperty ;
  rdfs:label "bounding region of" ;
  rdfs:comment "A variable has a bounding region" ;
  domain :Variable ;
  range :BoundingRegion.

:BoundingRegion a owl:Class ;
  rdfs:label "Bounding Region" ;
  rdfs:comment "A bounding region is a region that bounds a variable".

:TemporalCoverageOf a owl:ObjectProperty ;
  rdfs:label "temporal coverage of" ;
  rdfs:comment "A variable has a temporal coverage" ;
  domain :Variable ;
  range :TemporalCoverage.

:GeodeticCoverageOf a owl:ObjectProperty ;
  rdfs:label "geodetic coverage of" ;
  rdfs:comment "A variable has a geodetic coverage" ;
  domain :Variable ;
  range :GeodeticCoverage.

:DataFormatOf a owl:ObjectProperty ;
  rdfs:label "data format of" ;
  rdfs:comment "A dataset has a data format" ;
  domain :Dataset ;
  range :DataFormat.

:DataFormat a owl:Class ;
  rdfs:label "Data Format" ;
  rdfs:comment "A data format is a format in which a dataset is serialized".

:Dataset a owl:Class ;
  rdfs:label "Dataset" ;
  rdfs:comment "A dataset is a collection of data".

:GeneratedBy a owl:ObjectProperty ;
  rdfs:label "generated by" ;
  rdfs:comment "A dataset is generated by a process" ;
  domain :Dataset ;
  range :Process.

:Consumes a owl:ObjectProperty ;
  rdfs:label "consumes" ;
  rdfs:comment "A process consumes one or more datasets as input" ;
  domain :Process ;
  range :Dataset.

:EquivalentTo a owl:ObjectProperty ;
  rdfs:label "equivalent to" ;
  rdfs:comment "Two variables are equivalent if they are modelled by the same provider with the same derivation chain" ;
  domain :Variable ;
  range :Variable.

:ModelledBy a owl:ObjectProperty ;
  rdfs:label "modelled by" ;
  rdfs:comment "A variable is modelled by a provider" ;
  domain :Variable ;
  range :Provider.

:Provider a owl:Class ;
  rdfs:label "Provider" ;
  rdfs:comment "A provider is an organization that models variables".

:DerivationChain a owl:Class ;
  rdfs:label "Derivation Chain" ;
  rdfs:comment "A derivation chain is a sequence of operations that derive a variable".

:Continuous a owl:DatatypeProperty ;
  rdfs:label "continuity" ;
  rdfs:comment "A variable is continuous if it can take any value in its dimensional space" ;
  domain :Variable ;
  range xsd:boolean.

:Discrete a owl:DatatypeProperty ;
  rdfs:label "discreteness" ;
  rdfs:comment "A variable is discrete if it can only take a finite number of values in its dimensional space" ;
  domain :Variable ;
  range xsd:boolean.

:Finite a owl:DatatypeProperty ;
  rdfs:label "finiteness" ;
  rdfs:comment "A variable is finite if it is bounded and can be fully enumerated with finite resources" ;
  domain :Variable ;
  range xsd:boolean.

:TemporalQuantization a owl:Class ;
  rdfs:label "Temporal Quantization" ;
  rdfs:comment "A temporal quantization is a quantization of a temporal continuum".

:GeodeticQuantization a owl:Class ;
  rdfs:label "Geodetic Quantization" ;
  rdfs:comment "A geodetic quantization is a quantization of a geodetic continuum".

:Quantization a owl:Class ;
  rdfs:label "Quantization" ;
  rdfs:comment "A quantization is a discretization of a continuum".

:Continuum a owl:Class ;
  rdfs:label "Continuum" ;
  rdfs:comment "A continuum is a mathematical space in which a variable takes its values".

:Sampling a owl:DatatypeProperty ;
  rdfs:label "sampling" ;
  rdfs:comment "A quantization is obtained by sampling a continuum" ;
  domain :Quantization ;
  range xsd:boolean.

:Binning a owl:DatatypeProperty ;
  rdfs:label "binning" ;
  rdfs:comment "A quantization is obtained by binning a continuum" ;
  domain :Quantization ;
