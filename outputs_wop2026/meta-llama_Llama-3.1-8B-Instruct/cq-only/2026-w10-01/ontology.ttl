@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software/Hardware Requirements Ontology" ;
  rdfs:comment "Ontology for modeling software and hardware requirements.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement of a software.".

:SoftwareRequirement a owl:Class ;
  rdfs:label "Software Requirement" ;
  rdfs:comment "A requirement of a software." ;
  rdfs:subClassOf :Requirement.

:SoftwareHardware a owl:Class ;
  rdfs:label "Software/Hardware" ;
  rdfs:comment "A software or hardware entity.".

:RequiredBy a owl:ObjectProperty ;
  rdfs:label "Required By" ;
  rdfs:comment "The software that requires a software/hardware." ;
  rdfs:domain :Software ;
  rdfs:range :SoftwareHardware.

:RequirementType a owl:DatatypeProperty ;
  rdfs:label "Requirement Type" ;
  rdfs:comment "The type of requirement (software/hardware)." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range xsd:string.

:RequiredValue a owl:DatatypeProperty ;
  rdfs:label "Required Value" ;
  rdfs:comment "The required value of a property." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range xsd:string.

:RequiredVersion a owl:DatatypeProperty ;
  rdfs:label "Required Version" ;
  rdfs:comment "The required version of a software." ;
  rdfs:domain :SoftwareRequirement ;
  rdfs:range xsd:string.

:SoftwareHardwareType a owl:DatatypeProperty ;
  rdfs:label "Software/Hardware Type" ;
  rdfs:comment "The type of software/hardware required." ;
  rdfs:domain :SoftwareHardware ;
  rdfs:range xsd:string.

:SoftwareHardwareProperty a owl:DatatypeProperty ;
  rdfs:label "Software/Hardware Property" ;
  rdfs:comment "The property of a software/hardware required." ;
  rdfs:domain :SoftwareHardware ;
  rdfs:range xsd:string.

:SoftwareHardwarePropertyValue a owl:DatatypeProperty ;
  rdfs:label "Software/Hardware Property Value" ;
  rdfs:comment "The value of a property of a software/hardware required." ;
  rdfs:domain :SoftwareHardware ;
  rdfs:range xsd:string.