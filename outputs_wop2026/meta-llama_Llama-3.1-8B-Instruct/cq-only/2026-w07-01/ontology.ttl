@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Pedagogical Frameworks Ontology" ;
  rdfs:comment "An ontology for modeling pedagogical frameworks and their relationships.".

:PedagogicalFramework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A framework for organizing instructional interventions.".

:PedagogicalElement a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "A component of a pedagogical framework.".

:Follows a owl:ObjectProperty ;
  rdfs:label "Follows" ;
  rdfs:comment "A pedagogical element follows another pedagogical element." ;
  rdfs:domain :PedagogicalElement ;
  rdfs:range :PedagogicalElement.

:Contains a owl:ObjectProperty ;
  rdfs:label "Contains" ;
  rdfs:comment "A pedagogical framework contains a pedagogical element." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :PedagogicalElement.

:Supports a owl:ObjectProperty ;
  rdfs:label "Supports" ;
  rdfs:comment "An instructional step supports a learner working toward a learning objective." ;
  rdfs:domain :InstructionalStep ;
  rdfs:range :LearningObjective.

:AvailableFor a owl:ObjectProperty ;
  rdfs:label "Available For" ;
  rdfs:comment "A pedagogical framework is available for organizing an instructional intervention." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :InstructionalIntervention.

:FirstStep a owl:ObjectProperty ;
  rdfs:label "First Step" ;
  rdfs:comment "The first instructional step in a selected pedagogical framework." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :InstructionalStep.

:NextStep a owl:ObjectProperty ;
  rdfs:label "Next Step" ;
  rdfs:comment "The next instructional step in a selected pedagogical framework." ;
  rdfs:domain :InstructionalStep ;
  rdfs:range :InstructionalStep.

:SupportsLearningObjective a owl:ObjectProperty ;
  rdfs:label "Supports Learning Objective" ;
  rdfs:comment "An instructional step supports a learning objective." ;
  rdfs:domain :InstructionalStep ;
  rdfs:range :LearningObjective.

:AlignsTo a owl:ObjectProperty ;
  rdfs:label "Aligns To" ;
  rdfs:comment "A module or media aligns to a learning objective." ;
  rdfs:domain :Module ;
  rdfs:range :LearningObjective.

:RequiresPriorKnowledge a owl:ObjectProperty ;
  rdfs:label "Requires Prior Knowledge" ;
  rdfs:comment "A learning objective requires prior knowledge of a topic." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Topic.

:DevelopsSkill a owl:ObjectProperty ;
  rdfs:label "Develops Skill" ;
  rdfs:comment "A learning objective develops a skill." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :Skill.

:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A specific goal or outcome that a learner aims to achieve.".

:Topic a owl:Class ;
  rdfs:label "Topic" ;
  rdfs:comment "A subject or subject area that a learner is studying.".

:Skill a owl:Class ;
  rdfs:label "Skill" ;
  rdfs:comment "A specific ability or competence that a learner is developing.".

:Module a owl:Class ;
  rdfs:label "Module" ;
  rdfs:comment "A self-contained unit of instruction that a learner can complete.".

:Media a owl:Class ;
  rdfs:label "Media" ;
  rdfs:comment "A resource or tool that a learner can use to support their learning.".

:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An activity or task that a learner completes to demonstrate their understanding of a learning objective.".

:EvaluationTechnique a owl:Class ;
  rdfs:label "Evaluation Technique" ;
  rdfs:comment "A method or approach used to assess a learner's progress toward a learning objective.".

:EvaluationMetric a owl:Class ;
  rdfs:label "Evaluation Metric" ;
  rdfs:comment "A measure or indicator used to evaluate a learner's progress toward a learning objective.".

:Feedback a owl:Class ;
  rdfs:label "Feedback" ;
  rdfs:comment "Information or guidance provided to a learner to help them understand their progress toward a learning objective.".

:LearningFeedback a owl:Class ;
  rdfs:label "Learning Feedback" ;
  rdfs:comment "Feedback provided to a learner to help them understand their progress toward a learning objective.".

:Learner a owl:Class ;
  rdfs:label "Learner" ;
  rdfs:comment "An individual who is engaged in the process of learning.".

:LearnerGoal a owl:Class ;
  rdfs:label "Learner Goal" ;
  rdfs:comment "A specific goal or outcome that a learner aims to achieve.".

:LearnerPreference a owl:Class ;
  rdfs:label "Learner Preference" ;
  rdfs:comment "A personal preference or characteristic of a learner that influences their learning experience.".

:LearnerChallenge a owl:Class ;
  rdfs:label "Learner Challenge" ;
  rdfs:comment "A difficulty or obstacle that a learner faces in their learning experience.".

:LearnerContext a owl:Class ;
  rdfs:label "Learner Context" ;
  rdfs:comment "The circumstances or environment in which a learner is learning.".

:LearnerSituation a owl:Class ;
  rdfs:label "Learner Situation" ;
  rdfs:comment "The specific circumstances or context in which a learner is learning.".

:LearnerAwareness a owl:Class ;
  rdfs:label "Learner Awareness" ;
  rdfs:comment "A learner's understanding or perception of a topic or skill.".

:LearnerAwarenessObservation a owl:Class ;
  rdfs:label "Learner Awareness Observation" ;
  rdfs:comment "A record or observation of a learner's awareness of a topic or skill.".

:LearnerAssessment a owl:Class ;
  rdfs:label "Learner Assessment" ;
  rdfs:comment "An evaluation or assessment of a learner's progress toward a learning objective.".

:LearnerAssessmentEvidence a owl:Class ;
  rdfs:label "Learner Assessment Evidence" ;
  rdfs:comment "Information or data used to support an assessment or evaluation of a learner's progress.".

:LearnerFeedback a owl:Class ;
  rdfs:label "Learner Feedback" ;
  rdfs:comment "Feedback provided to a learner to help them understand their progress toward a learning objective.".

:LearnerResponse a owl:Class ;
  rdfs:label "Learner Response" ;
  rdfs:comment "A learner's response or reaction to feedback or an assessment.".

