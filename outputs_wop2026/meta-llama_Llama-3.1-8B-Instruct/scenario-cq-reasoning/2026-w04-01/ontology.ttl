@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software Reverse Engineering Ontology" ;
  rdfs:comment "Ontology for software reverse engineering and vulnerability detection.".

:ExecutableFile a owl:Class ;
  rdfs:label "Executable File" ;
  rdfs:comment "A file containing executable code.".

:Symbol a owl:Class ;
  rdfs:label "Symbol" ;
  rdfs:comment "A symbol in the executable file, such as a function or variable.".

:Function a owl:Class ;
  rdfs:label "Function" ;
  rdfs:comment "A block of code that performs a specific task.".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A storage location that holds a value.".

:API_Call a owl:Class ;
  rdfs:label "API Call" ;
  rdfs:comment "A call to a system or library function.".

:MaliciousAPI_Call a owl:Class ;
  rdfs:label "Malicious API Call" ;
  rdfs:comment "A malicious or suspicious API call.".

:Networking_Activity a owl:Class ;
  rdfs:label "Networking Activity" ;
  rdfs:comment "Suspicious or malicious networking activity.".

:ControlFlow_Pattern a owl:Class ;
  rdfs:label "Control Flow Pattern" ;
  rdfs:comment "A pattern of control flow that may indicate vulnerable code.".

:Entropy a owl:Class ;
  rdfs:label "Entropy" ;
  rdfs:comment "A measure of the randomness or unpredictability of code.".

:Opcodes a owl:Class ;
  rdfs:label "Opcodes" ;
  rdfs:comment "A sequence of machine code instructions.".

:Decode_Loop a owl:Class ;
  rdfs:label "Decode Loop" ;
  rdfs:comment "A self-referential decode loop that may indicate data obfuscation.".

:File_System_Abuse a owl:Class ;
  rdfs:label "File System Abuse" ;
  rdfs:comment "Suspicious or malicious file system activity.".

:Jumps_into_Memory a owl:Class ;
  rdfs:label "Jumps into Memory" ;
  rdfs:comment "Suspicious or malicious jumps into memory.".

:API_Call_Pattern a owl:Class ;
  rdfs:label "API Call Pattern" ;
  rdfs:comment "A pattern of API calls that may indicate malicious activity.".

:Cryptographic_Activity a owl:Class ;
  rdfs:label "Cryptographic Activity" ;
  rdfs:comment "Suspicious or malicious cryptographic activity.".

:Imported_Functions a owl:Class ;
  rdfs:label "Imported Functions" ;
  rdfs:comment "Functions imported from external libraries.".

:Imported_Functions_Percentage a owl:DatatypeProperty ;
  rdfs:label "Percentage of Imported Functions" ;
  rdfs:comment "The percentage of functions in the binary file that are imported." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range xsd:decimal.

:has_Symbol a owl:ObjectProperty ;
  rdfs:label "Has Symbol" ;
  rdfs:comment "A symbol in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Symbol.

:has_Function a owl:ObjectProperty ;
  rdfs:label "Has Function" ;
  rdfs:comment "A function in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Function.

:has_Variable a owl:ObjectProperty ;
  rdfs:label "Has Variable" ;
  rdfs:comment "A variable in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Variable.

:has_API_Call a owl:ObjectProperty ;
  rdfs:label "Has API Call" ;
  rdfs:comment "An API call in the executable file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :API_Call.

:has_MaliciousAPI_Call a owl:ObjectProperty ;
  rdfs:label "Has Malicious API Call" ;
  rdfs:comment "A malicious or suspicious API call." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :MaliciousAPI_Call.

:has_Networking_Activity a owl:ObjectProperty ;
  rdfs:label "Has Networking Activity" ;
  rdfs:comment "Suspicious or malicious networking activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Networking_Activity.

:has_ControlFlow_Pattern a owl:ObjectProperty ;
  rdfs:label "Has Control Flow Pattern" ;
  rdfs:comment "A pattern of control flow that may indicate vulnerable code." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :ControlFlow_Pattern.

:has_Entropy a owl:ObjectProperty ;
  rdfs:label "Has Entropy" ;
  rdfs:comment "A measure of the randomness or unpredictability of code." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Entropy.

:has_Opcodes a owl:ObjectProperty ;
  rdfs:label "Has Opcodes" ;
  rdfs:comment "A sequence of machine code instructions." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Opcodes.

:has_Decode_Loop a owl:ObjectProperty ;
  rdfs:label "Has Decode Loop" ;
  rdfs:comment "A self-referential decode loop that may indicate data obfuscation." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Decode_Loop.

:has_File_System_Abuse a owl:ObjectProperty ;
  rdfs:label "Has File System Abuse" ;
  rdfs:comment "Suspicious or malicious file system activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :File_System_Abuse.

:has_Jumps_into_Memory a owl:ObjectProperty ;
  rdfs:label "Has Jumps into Memory" ;
  rdfs:comment "Suspicious or malicious jumps into memory." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Jumps_into_Memory.

:has_API_Call_Pattern a owl:ObjectProperty ;
  rdfs:label "Has API Call Pattern" ;
  rdfs:comment "A pattern of API calls that may indicate malicious activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :API_Call_Pattern.

:has_Cryptographic_Activity a owl:ObjectProperty ;
  rdfs:label "Has Cryptographic Activity" ;
  rdfs:comment "Suspicious or malicious cryptographic activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Cryptographic_Activity.

:has_Imported_Functions a owl:ObjectProperty ;
  rdfs:label "Has Imported Functions" ;
  rdfs:comment "Functions imported from external libraries." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Imported_Functions.

:has_Entropy_Ratio a owl:ObjectProperty ;
  rdfs:label "Has Entropy Ratio" ;
  rdfs:comment "The ratio of unique opcodes to the total number of instructions in a function." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range xsd:decimal.

:has_Entropy_Ratio a owl:FunctionalProperty.

:ExecutableFile rdfs:subClassOf :File.
:ExecutableFile rdfs:subClassOf :Software.

:Symbol rdfs:subClassOf :Code_Element.
:Function rdfs:subClassOf :Code_Element.
:Variable rdfs:subClassOf :Code_Element.
:API_Call rdfs:subClassOf :Code_Element.
:MaliciousAPI_Call rdfs:subClassOf :API_Call.
:Networking_Activity rdfs:subClassOf :Code_Element.
:ControlFlow_Pattern rdfs:subClassOf :Code_Element.
:Entropy rdfs:subClassOf :Code_Element.
:Opcodes rdfs:subClassOf :Code_Element.
:Decode_Loop rdfs:subClassOf :Code_Element.
:File_System_Abuse rdfs:subClassOf :Code_Element.
:Jumps_into_Memory rdfs:subClassOf :Code_Element.
:API_Call_Pattern rdfs:subClassOf :Code_Element.
:Cryptographic_Activity rdfs:subClassOf :Code_Element.
:Imported_Functions rdfs:subClassOf :Code_Element.

:has_Entropy_Ratio rdfs:domain :Function.
:has_Entropy_Ratio rdfs:range xsd:decimal.