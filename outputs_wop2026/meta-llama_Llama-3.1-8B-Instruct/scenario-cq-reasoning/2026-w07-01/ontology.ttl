@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Pedagogical Organization and Delivery Ontology" ;
  rdfs:comment "Ontology for representing pedagogical organization, including frameworks, elements, and their order; objective alignment across learning objectives, pedagogical techniques, and learning resources; evaluation, including assessment exercises, techniques, metrics, and results; feedback responses, including source and temporal information; learner context, including goals, preferences, challenges, and situations; and learner awareness as topic or skill-scoped information that changes over time.".

:PedagogicalFramework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A framework for organizing instructional interventions.".

:PedagogicalElement a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "An element within a pedagogical framework.".

:PedagogicalElementOrder a owl:Class ;
  rdfs:label "Pedagogical Element Order" ;
  rdfs:comment "The order of pedagogical elements within a framework.".

:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound (SMART) goal for a learner.".

:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A method or approach used to support learning objectives.".

:LearningResource a owl:Class ;
  rdfs:label "Learning Resource" ;
  rdfs:comment "A resource used to support learning objectives.".

:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An activity used to evaluate learner progress toward a learning objective.".

:EvaluationTechnique a owl:Class ;
  rdfs:label "Evaluation Technique" ;
  rdfs:comment "A method used to assess learner progress toward a learning objective.".

:EvaluationMetric a owl:Class ;
  rdfs:label "Evaluation Metric" ;
  rdfs:comment "A measure used to evaluate learner progress toward a learning objective.".

:FeedbackResponse a owl:Class ;
  rdfs:label "Feedback Response" ;
  rdfs:comment "A response to learner progress toward a learning objective.".

:LearnerContext a owl:Class ;
  rdfs:label "Learner Context" ;
  rdfs:comment "The circumstances and characteristics of a learner.".

:LearnerGoal a owl:Class ;
  rdfs:label "Learner Goal" ;
  rdfs:comment "A specific, measurable, achievable, relevant, and time-bound (SMART) goal for a learner.".

:LearnerPreference a owl:Class ;
  rdfs:label "Learner Preference" ;
  rdfs:comment "A characteristic or attribute of a learner's learning style or preferences.".

:LearnerChallenge a owl:Class ;
  rdfs:label "Learner Challenge" ;
  rdfs:comment "A difficulty or obstacle faced by a learner.".

:LearnerSituation a owl:Class ;
  rdfs:label "Learner Situation" ;
  rdfs:comment "The circumstances and characteristics of a learner's learning environment.".

:LearnerAwareness a owl:Class ;
  rdfs:label "Learner Awareness" ;
  rdfs:comment "A learner's understanding or perception of a topic or skill.".

:hasPedagogicalFramework a owl:ObjectProperty ;
  rdfs:label "has Pedagogical Framework" ;
  rdfs:comment "A pedagogical framework that supports a learning objective." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :PedagogicalFramework.

:hasPedagogicalElement a owl:ObjectProperty ;
  rdfs:label "has Pedagogical Element" ;
  rdfs:comment "A pedagogical element that supports a learning objective." ;
  rdfs:domain :LearningObjective ;
  rdfs:range :PedagogicalElement.

:hasPedagogicalElementOrder a owl:ObjectProperty ;
  rdfs:label "has Pedagogical Element Order" ;
  rdfs:comment "The order of pedagogical elements within a framework." ;
  rdfs:domain :PedagogicalFramework ;
  rdfs:range :PedagogicalElementOrder.

:hasLearningObjective a owl:ObjectProperty ;
  rdfs:label "has Learning Objective" ;
  rdfs:comment "A learning objective that is supported by a pedagogical technique." ;
  rdfs:domain :PedagogicalTechnique ;
  rdfs:range :LearningObjective.

:hasLearningResource a owl:ObjectProperty ;
