:Ontology a owl:Ontology ;
  rdfs:label "Prompting Technique Ontology" ;
  rdfs:comment "Ontology for describing prompting techniques and tasks.".

:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "A task that requires a prompting technique.".

:DataModality a owl:Class ;
  rdfs:label "Data Modality" ;
  rdfs:comment "The type of data used in a task.".

:Constraint a owl:Class ;
  rdfs:label "Constraint" ;
  rdfs:comment "A limitation or requirement of a task.".

:FoundationModel a owl:Class ;
  rdfs:label "Foundation Model" ;
  rdfs:comment "A type of model used for prompting.".

:ModelArchitecture a owl:Class ;
  rdfs:label "Model Architecture" ;
  rdfs:comment "The structure of a foundation model.".

:PromptingTechnique a owl:Class ;
  rdfs:label "Prompting Technique" ;
  rdfs:comment "A method for generating prompts.".

:Prompt a owl:Class ;
  rdfs:label "Prompt" ;
  rdfs:comment "A question or statement used to elicit a response.".

:Response a owl:Class ;
  rdfs:label "Response" ;
  rdfs:comment "The answer to a prompt.".

:Chat a owl:Class ;
  rdfs:label "Chat" ;
  rdfs:comment "A conversation between a user and a foundation model.".

:ModelFamily a owl:Class ;
  rdfs:label "Model Family" ;
  rdfs:comment "A group of related foundation models.".

:ModelVariant a owl:Class ;
  rdfs:label "Model Variant" ;
  rdfs:comment "A specific version of a foundation model.".

:ModelEvolution a owl:Class ;
  rdfs:label "Model Evolution" ;
  rdfs:comment "A change or update to a foundation model.".

:UsagePattern a owl:Class ;
  rdfs:label "Usage Pattern" ;
  rdfs:comment "A pattern of how a foundation model is used.".

:PromptingTechniqueSuitableForTask a owl:ObjectProperty ;
  rdfs:label "Suitable for Task" ;
  rdfs:comment "A prompting technique suitable for a task." ;
  domain :PromptingTechnique ;
  range :Task.

:TaskHasDataModality a owl:ObjectProperty ;
  rdfs:label "Has Data Modality" ;
  rdfs:comment "A task involves a specific data modality." ;
  domain :Task ;
  range :DataModality.

:TaskHasConstraint a owl:ObjectProperty ;
  rdfs:label "Has Constraint" ;
  rdfs:comment "A task is subject to different constraints." ;
  domain :Task ;
  range :Constraint.

:FoundationModelHasModelArchitecture a owl:ObjectProperty ;
  rdfs:label "Has Model Architecture" ;
  rdfs:comment "A foundation model architecture depends on available resources." ;
  domain :FoundationModel ;
  range :ModelArchitecture.

:FoundationModelHasModelFamily a owl:ObjectProperty ;
  rdfs:label "Has Model Family" ;
  rdfs:comment "A foundation model belongs to a model family." ;
  domain :FoundationModel ;
  range :ModelFamily.

:FoundationModelHasModelVariant a owl:ObjectProperty ;
  rdfs:label "Has Model Variant" ;
  rdfs:comment "A foundation model has a specific variant." ;
  domain :FoundationModel ;
  range :ModelVariant.

:FoundationModelHasModelEvolution a owl:ObjectProperty ;
  rdfs:label "Has Model Evolution" ;
  rdfs:comment "A foundation model has undergone an evolution." ;
  domain :FoundationModel ;
  range :ModelEvolution.

:ChatHasPrompt a owl:ObjectProperty ;
  rdfs:label "Has Prompt" ;
  rdfs:comment "A chat involves a specific prompt." ;
  domain :Chat ;
  range :Prompt.

:ChatHasResponse a owl:ObjectProperty ;
  rdfs:label "Has Response" ;
  rdfs:comment "A chat involves a specific response." ;
  domain :Chat ;
  range :Response.

:ChatHasUsagePattern a owl:ObjectProperty ;
  rdfs:label "Has Usage Pattern" ;
  rdfs:comment "A chat follows a specific usage pattern." ;
  domain :Chat ;
  range :UsagePattern.

:PromptingTechniqueSuitableForDataModality a owl:ObjectProperty ;
  rdfs:label "Suitable for Data Modality" ;
  rdfs:comment "A prompting technique suitable for tasks targeting a data modality." ;
  domain :PromptingTechnique ;
  range :DataModality.

:PromptingTechniqueSuitableForConstraint a owl:ObjectProperty ;
  rdfs:label "Suitable for Constraint" ;
  rdfs:comment "A prompting technique suitable for tasks with a constraint on a variable." ;
  domain :PromptingTechnique ;
  range :Constraint.

:PromptingTechniqueSuitableForModelArchitecture a owl:ObjectProperty ;
  rdfs:label "Suitable for Model Architecture" ;
  rdfs:comment "A prompting technique suitable for a foundation model architecture." ;
  domain :PromptingTechnique ;
  range :ModelArchitecture.

:PromptingTechniqueSuitableForModelFamily a owl:ObjectProperty ;
  rdfs:label "Suitable for Model Family" ;
  rdfs:comment "A prompting technique suitable for a model family." ;
  domain :PromptingTechnique ;
  range :ModelFamily.

:PromptingTechniqueSuitableForModelVariant a owl:ObjectProperty ;
  rdfs:label "Suitable for Model Variant" ;
  rdfs:comment "A prompting technique suitable for a model variant." ;
  domain :PromptingTechnique ;
  range :ModelVariant.

:PromptingTechniqueSuitableForModelEvolution a owl:ObjectProperty ;
  rdfs:label "Suitable for Model Evolution" ;
  rdfs:comment "A prompting technique suitable for a model evolution." ;
  domain :PromptingTechnique ;
