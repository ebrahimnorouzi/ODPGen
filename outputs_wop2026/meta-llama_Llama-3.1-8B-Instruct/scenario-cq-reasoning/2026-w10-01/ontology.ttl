@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Matchmaker Ontology" ;
  rdfs:comment "Ontology for the SMARTY matchmaker, addressing the dynamic allocation of hardware resources.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement expressed by a software.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software described in the catalogue.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware described in the catalogue.".

:SoftwareRequirement a owl:ObjectProperty ;
  rdfs:label "Software Requirement" ;
  rdfs:comment "The requirement of a software." ;
  domain :Software ;
  range :Requirement.

:SoftwareRequiredBy a owl:ObjectProperty ;
  rdfs:label "Software Required By" ;
  rdfs:comment "The software that requires a software." ;
  domain :Software ;
  range :Software.

:SoftwareType a owl:DatatypeProperty ;
  rdfs:label "Software Type" ;
  rdfs:comment "The type of software required by a software." ;
  domain :Software ;
  range xsd:string.

:SoftwareProperty a owl:DatatypeProperty ;
  rdfs:label "Software Property" ;
  rdfs:comment "A property of a software required by a software." ;
  domain :Software ;
  range xsd:string.

:SoftwarePropertyCardinality a owl:DatatypeProperty ;
  rdfs:label "Software Property Cardinality" ;
  rdfs:comment "The cardinality of a property of a software required by a software." ;
  domain :Software ;
  range xsd:string.

:SoftwareVersion a owl:DatatypeProperty ;
  rdfs:label "Software Version" ;
  rdfs:comment "The version of a software required by a software." ;
  domain :Software ;
  range xsd:string.

:SoftwareVersionRequirement a owl:DatatypeProperty ;
  rdfs:label "Software Version Requirement" ;
  rdfs:comment "The requirement for the version of a software required by a software." ;
  domain :Software ;
  range xsd:string.