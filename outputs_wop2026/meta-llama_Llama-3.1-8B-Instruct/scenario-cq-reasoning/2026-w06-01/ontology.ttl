@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "LyonTech La Doua Campus Navigation Ontology" ;
  rdfs:comment "Ontology for navigating LyonTech La Doua campus".

:Space a owl:Class ;
  rdfs:label "Space" ;
  rdfs:comment "Spatial entity in the navigable environment".

:PointOfInterest a owl:Class ;
  rdfs:label "Point of Interest" ;
  rdfs:comment "Spatial entity with a specific purpose".

:Path a owl:Class ;
  rdfs:label "Path" ;
  rdfs:comment "Navigable route between two points".

:ContextualProperty a owl:Class ;
  rdfs:label "Contextual Property" ;
  rdfs:comment "Property of a spatial entity relevant to user preferences".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "User preference or constraint".

:UserProfile a owl:Class ;
  rdfs:label "User Profile" ;
  rdfs:comment "Collection of user preferences and constraints".

:TargetProperty a owl:ObjectProperty ;
  rdfs:label "Target Property" ;
  rdfs:comment "Property of a spatial entity relevant to a user preference" ;
  domain :Space ;
  range :ContextualProperty.

:ExpectedValue a owl:DatatypeProperty ;
  rdfs:label "Expected Value" ;
  rdfs:comment "Value expected by a user for a contextual property" ;
  domain :Requirement ;
  range xsd:string.

:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "Constraint on a user preference or spatial entity property".

:DistanceRequisite a owl:Class ;
  rdfs:label "Distance Requisite" ;
  rdfs:comment "Constraint on distance between two points".

:ComparisonOperator a owl:Class ;
  rdfs:label "Comparison Operator" ;
  rdfs:comment "Operator for comparing values of contextual properties".

:LogicalOperator a owl:Class ;
  rdfs:label "Logical Operator" ;
  rdfs:comment "Operator for combining conditions".

:piirrite:TargetProperty a owl:ObjectProperty ;
  rdfs:label "Target Property" ;
  rdfs:comment "Property of a spatial entity relevant to a user preference" ;
  domain :Space ;
  range :ContextualProperty.

:piirrite:ExpectedValue a owl:DatatypeProperty ;
  rdfs:label "Expected Value" ;
  rdfs:comment "Value expected by a user for a contextual property" ;
  domain :Requirement ;
  range xsd:string.

:piirrite:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "Constraint on a user preference or spatial entity property".

:piirrite:DistanceRequisite a owl:Class ;
  rdfs:label "Distance Requisite" ;
  rdfs:comment "Constraint on distance between two points".

:piirrite:ComparisonOperator a owl:Class ;
  rdfs:label "Comparison Operator" ;
  rdfs:comment "Operator for comparing values of contextual properties".

:piirrite:LogicalOperator a owl:Class ;
  rdfs:label "Logical Operator" ;
  rdfs:comment "Operator for combining conditions".