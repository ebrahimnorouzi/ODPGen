@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Software Reverse Engineering Ontology" ;
  rdfs:comment "Ontology for software reverse engineering and vulnerability detection.".

:ExecutableFile a owl:Class ;
  rdfs:label "Executable File" ;
  rdfs:comment "A file containing executable code.".

:Symbol a owl:Class ;
  rdfs:label "Symbol" ;
  rdfs:comment "A symbol in the executable file, such as a function or variable.".

:Function a owl:Class ;
  rdfs:label "Function" ;
  rdfs:comment "A block of code that performs a specific task.".

:Variable a owl:Class ;
  rdfs:label "Variable" ;
  rdfs:comment "A storage location that holds a value.".

:API_Call a owl:Class ;
  rdfs:label "API Call" ;
  rdfs:comment "A call to an application programming interface.".

:MaliciousAPI_Call a owl:Class ;
  rdfs:label "Malicious API Call" ;
  rdfs:comment "A malicious API call within the executable." ;
  rdfs:subClassOf :API_Call.

:SuspiciousNetworkingActivity a owl:Class ;
  rdfs:label "Suspicious Networking Activity" ;
  rdfs:comment "Suspicious networking activity within the executable.".

:IndirectControlFlow a owl:Class ;
  rdfs:label "Indirect Control Flow" ;
  rdfs:comment "Indirect control flow patterns in the executable file.".

:Entropy a owl:Class ;
  rdfs:label "Entropy" ;
  rdfs:comment "Sections of entropy in the executable file.".

:SelfReferentialDecodeLoop a owl:Class ;
  rdfs:label "Self-Referential Decode Loop" ;
  rdfs:comment "Patterns of self-referential decode loops in the executable file.".

:FileSystemAbuse a owl:Class ;
  rdfs:label "File System Abuse" ;
  rdfs:comment "File system abuse within the executable.".

:SuspiciousJump a owl:Class ;
  rdfs:label "Suspicious Jump" ;
  rdfs:comment "Suspicious jumps into memory in the executable.".

:SuspiciousAPI_Call a owl:Class ;
  rdfs:label "Suspicious API Call" ;
  rdfs:comment "Suspicious API calls contained in the executable file.".

:CryptographicActivity a owl:Class ;
  rdfs:label "Cryptographic Activity" ;
  rdfs:comment "Cryptographic activity within the executable.".

:ImportedFunction a owl:Class ;
  rdfs:label "Imported Function" ;
  rdfs:comment "Functions in the binary file that are imported (i.e., external).".

:Percentage a owl:DatatypeProperty ;
  rdfs:label "Percentage" ;
  rdfs:comment "The percentage of imported functions in the binary file." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range xsd:decimal.

:hasAPI_Call a owl:ObjectProperty ;
  rdfs:label "has API Call" ;
  rdfs:comment "The executable file has an API call." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :API_Call.

:hasMaliciousAPI_Call a owl:ObjectProperty ;
  rdfs:label "has Malicious API Call" ;
  rdfs:comment "The executable file has a malicious API call." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :MaliciousAPI_Call.

:hasSuspiciousNetworkingActivity a owl:ObjectProperty ;
  rdfs:label "has Suspicious Networking Activity" ;
  rdfs:comment "The executable file has suspicious networking activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :SuspiciousNetworkingActivity.

:hasIndirectControlFlow a owl:ObjectProperty ;
  rdfs:label "has Indirect Control Flow" ;
  rdfs:comment "The executable file has indirect control flow patterns." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :IndirectControlFlow.

:hasEntropy a owl:ObjectProperty ;
  rdfs:label "has Entropy" ;
  rdfs:comment "The executable file has sections of entropy." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Entropy.

:hasSelfReferentialDecodeLoop a owl:ObjectProperty ;
  rdfs:label "has Self-Referential Decode Loop" ;
  rdfs:comment "The executable file has patterns of self-referential decode loops." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :SelfReferentialDecodeLoop.

:hasFileSystemAbuse a owl:ObjectProperty ;
  rdfs:label "has File System Abuse" ;
  rdfs:comment "The executable file has file system abuse." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :FileSystemAbuse.

:hasSuspiciousJump a owl:ObjectProperty ;
  rdfs:label "has Suspicious Jump" ;
  rdfs:comment "The executable file has suspicious jumps into memory." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :SuspiciousJump.

:hasSuspiciousAPI_Call a owl:ObjectProperty ;
  rdfs:label "has Suspicious API Call" ;
  rdfs:comment "The executable file has suspicious API calls." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :SuspiciousAPI_Call.

:hasCryptographicActivity a owl:ObjectProperty ;
  rdfs:label "has Cryptographic Activity" ;
  rdfs:comment "The executable file has cryptographic activity." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :CryptographicActivity.

:hasImportedFunction a owl:ObjectProperty ;
  rdfs:label "has Imported Function" ;
  rdfs:comment "The executable file has imported functions." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :ImportedFunction.

:hasPercentage a owl:ObjectProperty ;
  rdfs:label "has Percentage" ;
  rdfs:comment "The executable file has a percentage of imported functions." ;
  rdfs:domain :ExecutableFile ;
  rdfs:range :Percentage.