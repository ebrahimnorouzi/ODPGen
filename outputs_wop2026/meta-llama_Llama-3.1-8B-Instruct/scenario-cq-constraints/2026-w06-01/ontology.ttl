@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "PIIRRITE Ontology" ;
  rdfs:comment "Ontology for pedestrian mobility and inclusive routing".

:Space a owl:Class ;
  rdfs:label "Space" ;
  rdfs:comment "Spatial entity in the navigable environment".

:PointOfInterest a owl:Class ;
  rdfs:label "Point of Interest" ;
  rdfs:comment "Location of interest within the navigable environment".

:Path a owl:Class ;
  rdfs:label "Path" ;
  rdfs:comment "Navigable route between two points in the environment".

:ContextualProperty a owl:Class ;
  rdfs:label "Contextual Property" ;
  rdfs:comment "Property of a spatial entity relevant to user preferences".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "Constraint on the routing system based on user preferences".

:UserProfile a owl:Class ;
  rdfs:label "User Profile" ;
  rdfs:comment "Collection of requirements and preferences for a user".

:TargetProperty a owl:Class ;
  rdfs:label "Target Property" ;
  rdfs:comment "Property of a spatial entity relevant to a requirement".

:ExpectedValue a owl:Class ;
  rdfs:label "Expected Value" ;
  rdfs:comment "Value expected by a user for a target property".

:Condition a owl:Class ;
  rdfs:label "Condition" ;
  rdfs:comment "Constraint on the routing system based on environmental properties".

:DistanceRequisite a owl:Class ;
  rdfs:label "Distance Requisite" ;
  rdfs:comment "Constraint on the routing system based on distance factors".

:ComparisonOperator a owl:Class ;
  rdfs:label "Comparison Operator" ;
  rdfs:comment "Operator for comparing values of contextual properties".

:LogicalOperator a owl:Class ;
  rdfs:label "Logical Operator" ;
  rdfs:comment "Operator for combining conditions in a composed condition".

:piirrite:hasContextualProperty a owl:ObjectProperty ;
  rdfs:label "has Contextual Property" ;
  rdfs:comment "Relationship between a spatial entity and its contextual properties" ;
  rdfs:domain :Space ;
  rdfs:range :ContextualProperty.

:piirrite:hasRequirement a owl:ObjectProperty ;
  rdfs:label "has Requirement" ;
  rdfs:comment "Relationship between a user profile and its requirements" ;
  rdfs:domain :UserProfile ;
  rdfs:range :Requirement.

:piirrite:hasTargetProperty a owl:ObjectProperty ;
  rdfs:label "has Target Property" ;
  rdfs:comment "Relationship between a requirement and its target property" ;
  rdfs:domain :Requirement ;
  rdfs:range :TargetProperty.

:piirrite:hasExpectedValue a owl:ObjectProperty ;
  rdfs:label "has Expected Value" ;
  rdfs:comment "Relationship between a requirement and its expected value" ;
  rdfs:domain :Requirement ;
  rdfs:range :ExpectedValue.

:piirrite:hasCondition a owl:ObjectProperty ;
  rdfs:label "has Condition" ;
  rdfs:comment "Relationship between a requirement and its condition" ;
  rdfs:domain :Requirement ;
  rdfs:range :Condition.

:piirrite:hasDistanceRequisite a owl:ObjectProperty ;
  rdfs:label "has Distance Requisite" ;
  rdfs:comment "Relationship between a requirement and its distance requisite" ;
  rdfs:domain :Requirement ;
  rdfs:range :DistanceRequisite.

:piirrite:hasComparisonOperator a owl:ObjectProperty ;
  rdfs:label "has Comparison Operator" ;
  rdfs:comment "Relationship between a condition and its comparison operator" ;
  rdfs:domain :Condition ;
  rdfs:range :ComparisonOperator.

:piirrite:hasLogicalOperator a owl:ObjectProperty ;
  rdfs:label "has Logical Operator" ;
  rdfs:comment "Relationship between a condition and its logical operator" ;
  rdfs:domain :Condition ;
  rdfs:range :LogicalOperator.