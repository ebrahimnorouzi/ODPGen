@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "SMARTY Matchmaker Ontology" ;
  rdfs:comment "Ontology for the SMARTY matchmaker, enabling the semantic management of digital assets.".

:Software a owl:Class ;
  rdfs:label "Software" ;
  rdfs:comment "A software entity.".

:Hardware a owl:Class ;
  rdfs:label "Hardware" ;
  rdfs:comment "A hardware entity.".

:Requirement a owl:Class ;
  rdfs:label "Requirement" ;
  rdfs:comment "A requirement expressed by a software.".

:SoftwareRequirement a owl:ObjectProperty ;
  rdfs:label "Software Requirement" ;
  rdfs:comment "The requirement of a software." ;
  domain :Software ;
  range :Requirement.

:HardwareRequirement a owl:ObjectProperty ;
  rdfs:label "Hardware Requirement" ;
  rdfs:comment "The requirement of a hardware." ;
  domain :Hardware ;
  range :Requirement.

:RequiredSoftware a owl:ObjectProperty ;
  rdfs:label "Required Software" ;
  rdfs:comment "The software required by a software." ;
  domain :Software ;
  range :Software.

:RequiredHardware a owl:ObjectProperty ;
  rdfs:label "Required Hardware" ;
  rdfs:comment "The hardware required by a software." ;
  domain :Software ;
  range :Hardware.

:SoftwareType a owl:DatatypeProperty ;
  rdfs:label "Software Type" ;
  rdfs:comment "The type of software required by a software." ;
  domain :Software ;
  range xsd:string.

:RequiredValue a owl:DatatypeProperty ;
  rdfs:label "Required Value" ;
  rdfs:comment "The required value of a property of a software/hardware required by a software." ;
  domain :Requirement ;
  range xsd:string.

:RequiredVersion a owl:DatatypeProperty ;
  rdfs:label "Required Version" ;
  rdfs:comment "The required version of a software required by a software." ;
  domain :Software ;
  range xsd:string.