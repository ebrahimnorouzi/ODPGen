@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Pedagogical Organization and Learning Dynamics Ontology" ;
  rdfs:comment "Ontology for representing pedagogical organization, learning objectives, evaluation, feedback, and learner context.".

:PedagogicalFramework a owl:Class ;
  rdfs:label "Pedagogical Framework" ;
  rdfs:comment "A framework for organizing instructional interventions.".

:PedagogicalElement a owl:Class ;
  rdfs:label "Pedagogical Element" ;
  rdfs:comment "An element within a pedagogical framework.".

:PedagogicalElementFollows a owl:ObjectProperty ;
  rdfs:label "Follows" ;
  rdfs:comment "A pedagogical element that follows another pedagogical element." ;
  owl:inverseOf :PedagogicalElementPrecedes ;
  owl:propertyChain (:PedagogicalElementFollows :PedagogicalElementPrecedes).

:PedagogicalElementPrecedes a owl:ObjectProperty ;
  rdfs:label "Precedes" ;
  rdfs:comment "A pedagogical element that precedes another pedagogical element." ;
  owl:inverseOf :PedagogicalElementFollows.

:PedagogicalFrameworkContains a owl:ObjectProperty ;
  rdfs:label "Contains" ;
  rdfs:comment "A pedagogical framework that contains a pedagogical element." ;
  owl:propertyChain (:PedagogicalFrameworkContains :PedagogicalElement).

:LearningObjective a owl:Class ;
  rdfs:label "Learning Objective" ;
  rdfs:comment "A goal or target for a learner.".

:InstructionalStep a owl:Class ;
  rdfs:label "Instructional Step" ;
  rdfs:comment "A step in the instructional process.".

:PedagogicalTechnique a owl:Class ;
  rdfs:label "Pedagogical Technique" ;
  rdfs:comment "A method or approach used in instruction.".

:LearningResource a owl:Class ;
  rdfs:label "Learning Resource" ;
  rdfs:comment "A resource used to support learning.".

:AssessmentExercise a owl:Class ;
  rdfs:label "Assessment Exercise" ;
  rdfs:comment "An exercise used to evaluate learner progress.".

:EvaluationTechnique a owl:Class ;
  rdfs:label "Evaluation Technique" ;
  rdfs:comment "A method used to evaluate learner progress.".

:FeedbackResponse a owl:Class ;
  rdfs:label "Feedback Response" ;
  rdfs:comment "A response to learner progress.".

:LearnerContext a owl:Class ;
  rdfs:label "Learner Context" ;
  rdfs:comment "The circumstances or situation of a learner.".

:LearnerGoal a owl:Class ;
  rdfs:label "Learner Goal" ;
  rdfs:comment "A goal or target for a learner.".

:LearnerPreference a owl:Class ;
  rdfs:label "Learner Preference" ;
  rdfs:comment "A preference or choice of a learner.".

:LearnerChallenge a owl:Class ;
  rdfs:label "Learner Challenge" ;
  rdfs:comment "A challenge or difficulty faced by a learner.".

:LearnerAwareness a owl:Class ;
  rdfs:label "Learner Awareness" ;
  rdfs:comment "The level of awareness or understanding of a learner.".

:LearnerSituation a owl:Class ;
  rdfs:label "Learner Situation" ;
  rdfs:comment "The circumstances or situation of a learner.".

:LearnerFeedback a owl:Class ;
  rdfs:label "Learner Feedback" ;
  rdfs:comment "Feedback given to a learner.".

:LearnerResponse a owl:Class ;
  rdfs:label "Learner Response" ;
  rdfs:comment "A response from a learner.".

:LearnerContextHasGoal a owl:ObjectProperty ;
  rdfs:label "Has Goal" ;
  rdfs:comment "A learner context that has a goal." ;
  owl:propertyChain (:LearnerContextHasGoal :LearnerGoal).

:LearnerContextHasPreference a owl:ObjectProperty ;
  rdfs:label "Has Preference" ;
  rdfs:comment "A learner context that has a preference." ;
  owl:propertyChain (:LearnerContextHasPreference :LearnerPreference).

:LearnerContextHasChallenge a owl:ObjectProperty ;
  rdfs:label "Has Challenge" ;
  rdfs:comment "A learner context that has a challenge." ;
  owl:propertyChain (:LearnerContextHasChallenge :LearnerChallenge).

:LearnerContextHasAwareness a owl:ObjectProperty ;
  rdfs:label "Has Awareness" ;
  rdfs:comment "A learner context that has awareness." ;
  owl:propertyChain (:LearnerContextHasAwareness :LearnerAwareness).

:LearnerContextHasSituation a owl:ObjectProperty ;
  rdfs:label "Has Situation" ;
  rdfs:comment "A learner context that has a situation." ;
  owl:propertyChain (:LearnerContextHasSituation :LearnerSituation).

:LearnerGoalIsTargetedBy a owl:ObjectProperty ;
  rdfs:label "Is Targeted By" ;
  rdfs:comment "A learner goal that is targeted by a skill." ;
  owl:propertyChain (:LearnerGoalIsTargetedBy :Skill).

:LearnerPreferenceIsSatisfiedBy a owl:ObjectProperty ;
  rdfs:label "Is Satisfied By" ;
  rdfs:comment "A learner preference that is satisfied by a learning resource." ;
  owl:propertyChain (:LearnerPreferenceIsSatisfiedBy :LearningResource).

:LearnerChallengeIsAddressedBy a owl:ObjectProperty ;
  rdfs:label "Is Addressed By" ;
  rdfs:comment "A learner challenge that is addressed by a learning resource." ;
  owl:propertyChain (:LearnerChallengeIsAddressedBy :LearningResource).

:LearnerAwarenessIsUpdatedBy a owl:ObjectProperty ;
  rdfs:label "Is Updated By" ;
  rdfs:comment "A learner awareness that is updated by an assessment exercise." ;
  owl:propertyChain (:LearnerAwarenessIsUpdatedBy :AssessmentExercise).

:LearnerSituationIsConsideredIn a owl:ObjectProperty ;
  rdfs:label "Is Considered In" ;
  rdfs:comment "A learner situation that is considered in the selection of a learning objective." ;
  owl:propertyChain (:LearnerSituationIsConsideredIn :LearningObjective).

:LearnerFeedbackIsGivenBy a owl:ObjectProperty ;
  rdfs:label "Is Given By" ;
  rdfs:comment "A learner feedback that is given by an evaluation technique." ;
  owl:propertyChain (:LearnerFeedbackIsGivenBy :EvaluationTechnique).

:LearnerResponseIsFrom a owl:ObjectProperty ;
  rdfs:label "Is From" ;
  rdfs:comment "A learner response that is from a human or automated source." ;
  owl:propertyChain (:LearnerResponseIsFrom :HumanOrAutomatedSource).

:HumanOrAutomatedSource a owl:Class ;
  rdfs:label "Human or Automated Source" ;
  rdfs:comment "A source of learner response, either human or automated.".

:Skill a owl:Class ;
  rdfs:label "Skill" ;
  rdfs:comment "A skill or ability that a learner may possess.".

:Topic a owl:Class ;
  rdfs:label "Topic" ;
  rdfs:comment "A topic or subject of study.".

:Module a owl:Class ;
  rdfs:label "Module" ;
  rdfs:comment "A module or unit of study.".

:Media a owl:Class ;
  rdfs:label "Media" ;
  rdfs:comment "A medium or resource used for learning.".

:AssessmentResult a owl:Class ;
  rdfs:label "Assessment Result" ;
  rdfs:comment "A result of an assessment exercise.".

:EvaluationMetric a owl:Class ;
  rdfs:label "Evaluation Metric" ;
  rdfs:comment "A metric used in evaluation.".

:EvaluationTechniqueType a owl:Class ;
  rdfs:label "Evaluation Technique Type" ;
  rdfs:comment "A type of evaluation technique.".