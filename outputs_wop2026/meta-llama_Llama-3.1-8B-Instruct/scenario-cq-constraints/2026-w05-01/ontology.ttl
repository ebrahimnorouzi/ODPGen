@prefix owl:  <http://www.w3.org/2002/07/owl#>.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#>.
@prefix :     <http://example.org/odp#>.

:Ontology a owl:Ontology ;
  rdfs:label "Prompting Task Model Ontology" ;
  rdfs:comment "Ontology for modeling tasks, prompting techniques, and foundation models.".

:Task a owl:Class ;
  rdfs:label "Task" ;
  rdfs:comment "A task that needs to be solved.".

:DataModality a owl:Class ;
  rdfs:label "Data Modality" ;
  rdfs:comment "The type of data used in a task.".

:Constraint a owl:Class ;
  rdfs:label "Constraint" ;
  rdfs:comment "A limitation or requirement of a task.".

:FoundationModel a owl:Class ;
  rdfs:label "Foundation Model" ;
  rdfs:comment "A type of model used for solving tasks.".

:ModelArchitecture a owl:Class ;
  rdfs:label "Model Architecture" ;
  rdfs:comment "The structure of a foundation model.".

:ModelFamily a owl:Class ;
  rdfs:label "Model Family" ;
  rdfs:comment "A group of related foundation models.".

:ModelVariant a owl:Class ;
  rdfs:label "Model Variant" ;
  rdfs:comment "A variation of a foundation model.".

:ModelEvolution a owl:Class ;
  rdfs:label "Model Evolution" ;
  rdfs:comment "An updated version of a foundation model.".

:PromptingTechnique a owl:Class ;
  rdfs:label "Prompting Technique" ;
  rdfs:comment "A method for generating prompts for a task.".

:Prompt a owl:Class ;
  rdfs:label "Prompt" ;
  rdfs:comment "A query or input for a task.".

:Response a owl:Class ;
  rdfs:label "Response" ;
  rdfs:comment "The output of a task.".

:Chat a owl:Class ;
  rdfs:label "Chat" ;
  rdfs:comment "A conversation between a user and a foundation model.".

:ConversationLength a owl:DatatypeProperty ;
  rdfs:label "Conversation Length" ;
  rdfs:comment "The average length of a chat." ;
  domain :Chat ;
  range xsd:integer.

:PromptCount a owl:DatatypeProperty ;
  rdfs:label "Prompt Count" ;
  rdfs:comment "The number of prompts in a chat." ;
  domain :Chat ;
  range xsd:integer.

:ResponseCount a owl:DatatypeProperty ;
  rdfs:label "Response Count" ;
  rdfs:comment "The number of responses in a chat." ;
  domain :Chat ;
  range xsd:integer.

:SuitableTechnique a owl:ObjectProperty ;
  rdfs:label "Suitable Technique" ;
  rdfs:comment "A prompting technique suitable for a task." ;
  domain :Task ;
  range :PromptingTechnique ;
  inverseProperty :techniqueForTask.

:techniqueForTask a owl:ObjectProperty ;
  rdfs:label "Technique for Task" ;
  rdfs:comment "A prompting technique used for a task." ;
  domain :PromptingTechnique ;
  range :Task ;
  inverseProperty :suitableTechnique.

:promptedBy a owl:ObjectProperty ;
  rdfs:label "Prompted by" ;
  rdfs:comment "A task prompted by a prompting technique." ;
  domain :Task ;
  range :PromptingTechnique.

:hasDataModality a owl:ObjectProperty ;
  rdfs:label "Has Data Modality" ;
  rdfs:comment "A task involving a specific data modality." ;
  domain :Task ;
  range :DataModality.

:hasConstraint a owl:ObjectProperty ;
  rdfs:label "Has Constraint" ;
  rdfs:comment "A task subject to a constraint." ;
  domain :Task ;
  range :Constraint.

:hasModelArchitecture a owl:ObjectProperty ;
  rdfs:label "Has Model Architecture" ;
  rdfs:comment "A foundation model with a specific architecture." ;
  domain :FoundationModel ;
  range :ModelArchitecture.

:hasModelFamily a owl:ObjectProperty ;
  rdfs:label "Has Model Family" ;
  rdfs:comment "A foundation model belonging to a model family." ;
  domain :FoundationModel ;
  range :ModelFamily.

:hasModelVariant a owl:ObjectProperty ;
  rdfs:label "Has Model Variant" ;
  rdfs:comment "A foundation model with a specific variant." ;
  domain :FoundationModel ;
  range :ModelVariant.

:hasModelEvolution a owl:ObjectProperty ;
  rdfs:label "Has Model Evolution" ;
  rdfs:comment "A foundation model with a specific evolution." ;
  domain :FoundationModel ;
  range :ModelEvolution.

:processesDataModality a owl:ObjectProperty ;
  rdfs:label "Processes Data Modality" ;
  rdfs:comment "A foundation model that can process a specific data modality." ;
  domain :FoundationModel ;
  range :DataModality.

:hasPrompt a owl:ObjectProperty ;
  rdfs:label "Has Prompt" ;
  rdfs:comment "A response to a specific prompt." ;
  domain :Response ;
  range :Prompt.

:submittedTo a owl:ObjectProperty ;
  rdfs:label "Submitted to" ;
  rdfs:comment "A prompt submitted to a foundation model." ;
  domain :Prompt ;
  range :FoundationModel.

:hasChat a owl:ObjectProperty ;
  rdfs:label "Has Chat" ;
  rdfs:comment "A response to a specific prompt in a chat." ;
  domain :Response ;
  range :Chat.