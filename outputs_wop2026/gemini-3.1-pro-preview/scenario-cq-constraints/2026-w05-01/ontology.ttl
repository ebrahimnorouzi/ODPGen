@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Foundation Model Prompting Ontology" ;
    rdfs:comment "An ontology design pattern for modeling tasks, foundation models, prompting techniques, and chat interactions." .

# --- Classes ---

:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "A task to be solved by prompting a foundation model." .

:FoundationModel a owl:Class ;
    rdfs:label "Foundation Model" ;
    rdfs:comment "A large AI model that can be prompted to solve tasks." .

:PromptingTechnique a owl:Class ;
    rdfs:label "Prompting Technique" ;
    rdfs:comment "A specific method or technique used to prompt a foundation model." .

:DataModality a owl:Class ;
    rdfs:label "Data Modality" ;
    rdfs:comment "A type of data modality, such as text, image, or audio." .

:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A limitation or condition applied to a task." .

:ModelArchitecture a owl:Class ;
    rdfs:label "Model Architecture" ;
    rdfs:comment "The underlying architecture of a foundation model." .

:ModelFamily a owl:Class ;
    rdfs:label "Model Family" ;
    rdfs:comment "A family or group of related foundation models." .

:Chat a owl:Class ;
    rdfs:label "Chat" ;
    rdfs:comment "A conversation consisting of prompts and responses." .

:Prompt a owl:Class ;
    rdfs:label "Prompt" ;
    rdfs:comment "An input provided to a foundation model." .

:Response a owl:Class ;
    rdfs:label "Response" ;
    rdfs:comment "The output generated by a foundation model in reply to a prompt." .

:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "A variable that is subject to a constraint." .

# --- Object Properties ---

:involvesModality a owl:ObjectProperty ;
    rdfs:label "involves modality" ;
    rdfs:comment "Relates a task to the data modality it involves." ;
    rdfs:domain :Task ;
    rdfs:range :DataModality .

:hasConstraint a owl:ObjectProperty ;
    rdfs:label "has constraint" ;
    rdfs:comment "Relates a task to a constraint it is subject to." ;
    rdfs:domain :Task ;
    rdfs:range :Constraint .

:hasArchitecture a owl:ObjectProperty ;
    rdfs:label "has architecture" ;
    rdfs:comment "Relates a foundation model to its architecture." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :ModelArchitecture .

:belongsToFamily a owl:ObjectProperty ;
    rdfs:label "belongs to family" ;
    rdfs:comment "Relates a foundation model to its model family." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :ModelFamily .

:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant" ;
    rdfs:comment "Relates a foundation model to a variant of it." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:hasEvolution a owl:ObjectProperty ;
    rdfs:label "has evolution" ;
    rdfs:comment "Relates a foundation model to its evolution or successor." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:processesModality a owl:ObjectProperty ;
    rdfs:label "processes modality" ;
    rdfs:comment "Relates a foundation model to a data modality it can process." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :DataModality .

:basedOnTechnique a owl:ObjectProperty ;
    rdfs:label "based on technique" ;
    rdfs:comment "Relates a prompt to the prompting technique it uses." ;
    rdfs:domain :Prompt ;
    rdfs:range :PromptingTechnique .

:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response" ;
    rdfs:comment "Relates a prompt to its corresponding response." ;
    rdfs:domain :Prompt ;
    rdfs:range :Response .

:submittedTo a owl:ObjectProperty ;
    rdfs:label "submitted to" ;
    rdfs:comment "Relates a prompt to the foundation model it is submitted to." ;
    rdfs:domain :Prompt ;
    rdfs:range :FoundationModel .

:containsPrompt a owl:ObjectProperty ;
    rdfs:label "contains prompt" ;
    rdfs:comment "Relates a chat to a prompt it contains." ;
    rdfs:domain :Chat ;
    rdfs:range :Prompt .

:containsResponse a owl:ObjectProperty ;
    rdfs:label "contains response" ;
    rdfs:comment "Relates a chat to a response it contains." ;
    rdfs:domain :Chat ;
    rdfs:range :Response .

:conductedWith a owl:ObjectProperty ;
    rdfs:label "conducted with" ;
    rdfs:comment "Relates a chat to the foundation model it was conducted with." ;
    rdfs:domain :Chat ;
    rdfs:range :FoundationModel .

:suitableFor a owl:ObjectProperty ;
    rdfs:label "suitable for" ;
    rdfs:comment "Relates a prompting technique to a task it is suitable for." ;
    rdfs:domain :PromptingTechnique ;
    rdfs:range :Task .

:targetsTask a owl:ObjectProperty ;
    rdfs:label "targets task" ;
    rdfs:comment "Relates a prompt to the task it targets." ;
    rdfs:domain :Prompt ;
    rdfs:range :Task .

:constrainsVariable a owl:ObjectProperty ;
    rdfs:label "constrains variable" ;
    rdfs:comment "Relates a constraint to the variable it constrains." ;
    rdfs:domain :Constraint ;
    rdfs:range :Variable .

# --- Datatype Properties ---

:conversationLength a owl:DatatypeProperty ;
    rdfs:label "conversation length" ;
    rdfs:comment "The length of a chat conversation, typically measured in number of turns or tokens." ;
    rdfs:domain :Chat ;
    rdfs:range xsd:integer .