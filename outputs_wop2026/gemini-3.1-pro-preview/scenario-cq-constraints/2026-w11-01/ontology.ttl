# Do NOT score this file as a complete ontology; see metadata.json.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "WISDOM Stress Detection Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing stress conditions, stressors, physiological responses, sensors, and contextual information in affective computing and stress detection research." .

### Classes ###

:StressCondition a owl:Class ;
    rdfs:label "Stress Condition" ;
    rdfs:comment "A condition related to the stress state of a subject, such as baseline, stress, or recovery." .

:BaselineCondition a owl:Class ;
    rdfs:subClassOf :StressCondition ;
    rdfs:label "Baseline Condition" ;
    rdfs:comment "A state representing the baseline or resting condition of a subject." .

:RecoveryCondition a owl:Class ;
    rdfs:subClassOf :StressCondition ;
    rdfs:label "Recovery Condition" ;
    rdfs:comment "A state representing the recovery phase of a subject after a stressor." .

:StressState a owl:Class ;
    rdfs:subClassOf :StressCondition ;
    rdfs:label "Stress State" ;
    rdfs:comment "A state representing an active stress condition experienced by a subject." .

:Stressor a owl:Class ;
    rdfs:label "Stressor" ;
    rdfs:comment "An event, condition, or stimulus that has the potential to induce stress." .

:ShortTermStressor a owl:Class ;
    rdfs:subClassOf :Stressor ;
    rdfs:label "Short-Term Stressor" ;
    rdfs:comment "A stressor that occurs over a short duration." .

:StressResponse a owl:Class ;
    rdfs:label "Stress Response" ;
    rdfs:comment "A physiological or behavioral response caused by a stressor." .

:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "An activity or experimental phase during which observations are made." .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human involved in the stress detection scenario, such as a subject or an observer." .

:PersonRole a owl:Class ;
    rdfs:label "Person Role" ;
    rdfs:comment "A role that a person can take in the model." .

:SubjectRole a owl:Class ;
    rdfs:subClassOf :PersonRole ;
    rdfs:label "Subject Role" ;
    rdfs:comment "The role of a person acting as the subject of an experiment or observation." .

:ObserverRole a owl:Class ;
    rdfs:subClassOf :PersonRole ;
    rdfs:label "Observer Role" ;
    rdfs:comment "The role of a person acting as an observer or annotator." .

:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "A device or component used to capture measurements." .

:PhysiologicalSensor a owl:Class ;
    rdfs:subClassOf :Sensor ;
    rdfs:label "Physiological Sensor" ;
    rdfs:comment "A sensor used to measure physiological properties." .

:MovementSensor a owl:Class ;
    rdfs:subClassOf :Sensor ;
    rdfs:label "Movement Sensor" ;
    rdfs:comment "A sensor used to capture movement-related information." .

:PPGSensor a owl:Class ;
    rdfs:subClassOf :PhysiologicalSensor ;
    rdfs:label "PPG Sensor" ;
    rdfs:comment "A photoplethysmography sensor used to measure blood volume changes." .

:EDASensor a owl:Class ;
    rdfs:subClassOf :PhysiologicalSensor ;
    rdfs:label "EDA Sensor" ;
    rdfs:comment "A sensor used to measure electrodermal activity." .

:TemperatureSensor a owl:Class ;
    rdfs:subClassOf :Sensor ;
    rdfs:label "Temperature Sensor" ;
    rdfs:comment "A sensor used to measure temperature." .

:Accelerometer a owl:Class ;
    rdfs:subClassOf :MovementSensor ;
    rdfs:label "Accelerometer" ;
    rdfs:comment "A sensor used to measure acceleration." .

:MeasurementPlatform a owl:Class ;
    rdfs:label "Measurement Platform" ;
    rdfs:comment "A device or platform that hosts sensors for measurement." .

:MeasurableProperty a owl:Class ;
    rdfs:label "Measurable Property" ;
    rdfs:comment "A property that can be captured by a sensor or signal channel." .

:PhysiologicalProperty a owl:Class ;
    rdfs:subClassOf :MeasurableProperty ;
    rdfs:label "Physiological Property" ;
    rdfs:comment "A measurable property related to the physiological state of a subject." .

:BehavioralProperty a owl:Class ;
    rdfs:subClassOf :MeasurableProperty ;
    rdfs:label "Behavioral Property" ;
    rdfs:comment "A measurable property related to the behavior or movement of a subject." .

:EnvironmentalProperty a owl:Class ;
    rdfs:subClassOf :MeasurableProperty ;
    rdfs:label "Environmental Property" ;
    rdfs:comment "A measurable property related to the environment." .

:BloodOxygenSaturation a owl:Class ;
    rdfs:subClassOf :PhysiologicalProperty ;
    rdfs:label "Blood Oxygen Saturation" ;
    rdfs:comment "The fraction of oxygen-saturated hemoglobin relative to total hemoglobin." .

:ElectrodermalActivity a owl:Class ;
    rdfs:subClassOf :PhysiologicalProperty ;
    rdfs:label "Electrodermal Activity" ;
    rdfs:comment "The variation of the electrical properties of the skin." .

:Acceleration a owl:Class ;
    rdfs:subClassOf :BehavioralProperty ;
    rdfs:label "Acceleration" ;
    rdfs:comment "The rate of change of velocity, typically captured to indicate movement." .

:Temperature a owl:Class ;
    rdfs:subClassOf :MeasurableProperty ;
    rdfs:label "Temperature" ;
    rdfs:comment "The degree or intensity of heat present in a substance, object, or environment." .

:Environment a owl:Class ;
    rdfs:label "Environment" ;
    rdfs:comment "The physical surroundings or context in which an activity or observation takes place." .

:PhysiologicalRecord a owl:Class ;
    rdfs:label "Physiological Record" ;
    rdfs:comment "A record containing physiological data collected during an experiment." .

:SignalChannel a owl:Class ;
    rdfs:label "Signal Channel" ;
    rdfs:comment "A specific channel of data within a physiological record." .

:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "A record of a measurement or assessment made during an activity." .

:TimeSeriesObservation a owl:Class ;
    rdfs:subClassOf :Observation ;
    rdfs:label "Time-Series Observation" ;
    rdfs:comment "An observation that is part of a time-series, containing specific temporal information." .

:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:comment "A descriptive note or label assigned to an activity, phase, or dataset." .

:BiomarkerAssay a owl:Class ;
    rdfs:label "Biomarker Assay" ;
    rdfs:comment "An analysis done to determine the presence or amount of a biomarker." .

### Object Properties ###

:causesResponse a owl:ObjectProperty ;
    rdfs:domain :Stressor ;
    rdfs:range :StressResponse ;
    rdfs:label "causes response" ;
    rdfs:comment "Links a stressor to the stress response it induces." .

:hasCondition a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :StressCondition ;
    rdfs:label "has condition" ;
    rdfs:comment "Links an activity or experimental phase to its associated stress condition." .

:hasStressor a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Stressor ;
    rdfs:label "has stressor" ;
    rdfs:comment "Links an activity or experimental phase to the stressor present during it." .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :PersonRole ;
    rdfs:label "has role" ;
    rdfs:comment "Links a person to the role they play in the model." .

:measuresProperty a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Sensor :SignalChannel ) ] ;
    rdfs:range :MeasurableProperty ;
    rdfs:label "measures property" ;
    rdfs:comment "Indicates the property that a sensor or signal channel is designed to measure." .

:hasPlatform a owl:ObjectProperty ;
    rdfs:domain :Sensor ;
    rdfs:range :MeasurementPlatform ;
    rdfs:label "has platform" ;
    rdfs:comment "Links a sensor to the measurement platform or device it belongs to." .

:hasEnvironmentalProperty a owl:ObjectProperty ;
    rdfs:domain :Environment ;
    rdfs:range :EnvironmentalProperty ;
    rdfs:label "has environmental property" ;
    rdfs:comment "Links an environment to its measurable environmental properties." .

:hasSignalChannel a owl:ObjectProperty ;
    rdfs:domain :PhysiologicalRecord ;
    rdfs:range :SignalChannel ;
    rdfs:label "has signal channel" ;
    rdfs:comment "Links a physiological record to its constituent signal channels." .

:hasSourceData a owl:ObjectProperty ;
    rdfs:domain :Observation ;
    rdfs:range :PhysiologicalRecord ;
    rdfs:label "has source data" ;
    rdfs:comment "Traces an observation back to its source physiological record." .

:occursDuring a owl:ObjectProperty ;
    rdfs:domain :Observation ;
    rdfs:range :Activity ;
    rdfs:label "occurs during" ;
    rdfs:comment "Links an observation or measurement to the activity or phase during which it was made." .

:annotatesActivity a owl:ObjectProperty ;
    rdfs:domain :Annotation ;
    rdfs:range :Activity ;
    rdfs:label "annotates activity" ;
    rdfs:comment "Links an annotation to the specific activity or phase it describes." .

:hasObserver a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Annotation :Observation ) ] ;
    rdfs:range :Person ;
    rdfs:label "has observer" ;
    rdfs:comment "Links an annotation or observation to the human observer who created it." .