@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Foundation Model Prompting Ontology" ;
    rdfs:comment "An ontology design pattern for modeling foundation models, tasks, prompting techniques, and chat interactions." .

### Classes ###

:Chat a owl:Class ;
    rdfs:label "Chat" ;
    rdfs:comment "A conversational session consisting of prompts and responses." .

:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A limitation or condition applied to a task." .

:DataModality a owl:Class ;
    rdfs:label "Data Modality" ;
    rdfs:comment "The type or format of data, such as text, image, or audio." .

:FoundationModel a owl:Class ;
    rdfs:label "Foundation Model" ;
    rdfs:comment "A large-scale machine learning model trained on vast amounts of data." .

:FoundationModelArchitecture a owl:Class ;
    rdfs:label "Foundation Model Architecture" ;
    rdfs:comment "The underlying structural design of a foundation model." .

:Prompt a owl:Class ;
    rdfs:label "Prompt" ;
    rdfs:comment "An input provided to a foundation model to elicit a response." .

:PromptingTechnique a owl:Class ;
    rdfs:label "Prompting Technique" ;
    rdfs:comment "A specific method or strategy used to formulate a prompt." .

:Response a owl:Class ;
    rdfs:label "Response" ;
    rdfs:comment "The output generated by a foundation model in reply to a prompt." .

:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "An objective or activity to be accomplished, potentially using a foundation model." .

:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "A specific element or parameter that is subject to a constraint." .

### Object Properties ###

:basedOnTechnique a owl:ObjectProperty ;
    rdfs:label "based on technique" ;
    rdfs:comment "Links a prompt to the prompting technique it utilizes." ;
    rdfs:domain :Prompt ;
    rdfs:range :PromptingTechnique .

:conductedWithModel a owl:ObjectProperty ;
    rdfs:label "conducted with model" ;
    rdfs:comment "Links a chat session to the foundation model used." ;
    rdfs:domain :Chat ;
    rdfs:range :FoundationModel .

:constrainsVariable a owl:ObjectProperty ;
    rdfs:label "constrains variable" ;
    rdfs:comment "Links a constraint to the specific variable it restricts." ;
    rdfs:domain :Constraint ;
    rdfs:range :Variable .

:containsPrompt a owl:ObjectProperty ;
    rdfs:label "contains prompt" ;
    rdfs:comment "Links a chat to a prompt submitted within it." ;
    rdfs:domain :Chat ;
    rdfs:range :Prompt .

:containsResponse a owl:ObjectProperty ;
    rdfs:label "contains response" ;
    rdfs:comment "Links a chat to a response generated within it." ;
    rdfs:domain :Chat ;
    rdfs:range :Response .

:evolvedFrom a owl:ObjectProperty ;
    rdfs:label "evolved from" ;
    rdfs:comment "Links a foundation model to a previous model it was developed from." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:hasArchitecture a owl:ObjectProperty ;
    rdfs:label "has architecture" ;
    rdfs:comment "Links a foundation model to its underlying architecture." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModelArchitecture .

:hasConstraint a owl:ObjectProperty ;
    rdfs:label "has constraint" ;
    rdfs:comment "Links a task to a constraint applied to it." ;
    rdfs:domain :Task ;
    rdfs:range :Constraint .

:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response" ;
    rdfs:comment "Links a prompt to its corresponding response." ;
    rdfs:domain :Prompt ;
    rdfs:range :Response .

:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant" ;
    rdfs:comment "Links a foundation model to another model that is a variation of it." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :FoundationModel .

:isSuitableForTask a owl:ObjectProperty ;
    rdfs:label "is suitable for task" ;
    rdfs:comment "Links a prompting technique to a task it is effective for." ;
    rdfs:domain :PromptingTechnique ;
    rdfs:range :Task .

:processesDataModality a owl:ObjectProperty ;
    rdfs:label "processes data modality" ;
    rdfs:comment "Links a foundation model to a data modality it can handle." ;
    rdfs:domain :FoundationModel ;
    rdfs:range :DataModality .

:submittedToModel a owl:ObjectProperty ;
    rdfs:label "submitted to model" ;
    rdfs:comment "Links a prompt to the foundation model it is sent to." ;
    rdfs:domain :Prompt ;
    rdfs:range :FoundationModel .

:targetsDataModality a owl:ObjectProperty ;
    rdfs:label "targets data modality" ;
    rdfs:comment "Links a task to the data modality it involves." ;
    rdfs:domain :Task ;
    rdfs:range :DataModality .

:targetsTask a owl:ObjectProperty ;
    rdfs:label "targets task" ;
    rdfs:comment "Links a prompt to the task it aims to accomplish." ;
    rdfs:domain :Prompt ;
    rdfs:range :Task .