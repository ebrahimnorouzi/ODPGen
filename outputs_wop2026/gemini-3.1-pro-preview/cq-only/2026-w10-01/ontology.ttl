@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Software and Hardware Requirements Ontology Pattern"@en ;
    rdfs:comment "An ontology design pattern for modeling software and hardware requirements of software applications, including types, properties, values, and versions."@en .

# --- Classes ---

:Software a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "A software program or application."@en .

:Hardware a owl:Class ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "A physical hardware component or device."@en .

:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A condition or capability needed by a software to function properly."@en .

:SoftwareRequirement a owl:Class ;
    rdfs:subClassOf :Requirement ;
    rdfs:label "Software Requirement"@en ;
    rdfs:comment "A requirement specifying a necessary software dependency."@en .

:HardwareRequirement a owl:Class ;
    rdfs:subClassOf :Requirement ;
    rdfs:label "Hardware Requirement"@en ;
    rdfs:comment "A requirement specifying a necessary hardware dependency."@en .

:SoftwareType a owl:Class ;
    rdfs:label "Software Type"@en ;
    rdfs:comment "A category or classification of software (e.g., Operating System, Database)."@en .

:HardwareType a owl:Class ;
    rdfs:label "Hardware Type"@en ;
    rdfs:comment "A category or classification of hardware (e.g., CPU, RAM, GPU)."@en .

:SystemProperty a owl:Class ;
    rdfs:label "System Property"@en ;
    rdfs:comment "A specific measurable or definable property of a software or hardware (e.g., clock speed, memory size, disk space)."@en .

# --- Object Properties ---

:hasRequirement a owl:ObjectProperty ;
    rdfs:domain :Software ;
    rdfs:range :Requirement ;
    rdfs:label "has requirement"@en ;
    rdfs:comment "Links a software to its requirement."@en .

:requiresSoftware a owl:ObjectProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range :Software ;
    rdfs:label "requires software"@en ;
    rdfs:comment "Specifies the exact software required by a software requirement."@en .

:requiresHardware a owl:ObjectProperty ;
    rdfs:domain :HardwareRequirement ;
    rdfs:range :Hardware ;
    rdfs:label "requires hardware"@en ;
    rdfs:comment "Specifies the exact hardware required by a hardware requirement."@en .

:requiresSoftwareType a owl:ObjectProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range :SoftwareType ;
    rdfs:label "requires software type"@en ;
    rdfs:comment "Specifies the type of software required by a software requirement."@en .

:requiresHardwareType a owl:ObjectProperty ;
    rdfs:domain :HardwareRequirement ;
    rdfs:range :HardwareType ;
    rdfs:label "requires hardware type"@en ;
    rdfs:comment "Specifies the type of hardware required by a hardware requirement."@en .

:constrainsProperty a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :SystemProperty ;
    rdfs:label "constrains property"@en ;
    rdfs:comment "Indicates the specific property of the software or hardware that is being constrained by the requirement."@en .

# --- Datatype Properties ---

:hasMinimumValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has minimum value"@en ;
    rdfs:comment "Specifies the minimum required value for a constrained property."@en .

:hasMaximumValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has maximum value"@en ;
    rdfs:comment "Specifies the maximum allowed value for a constrained property."@en .

:hasExactValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has exact value"@en ;
    rdfs:comment "Specifies the exact required value for a constrained property."@en .

:hasMinimumVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has minimum version"@en ;
    rdfs:comment "Specifies the minimum required version of a software."@en .

:hasMaximumVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has maximum version"@en ;
    rdfs:comment "Specifies the maximum allowed version of a software."@en .

:hasExactVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has exact version"@en ;
    rdfs:comment "Specifies the exact required version of a software."@en .