@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Pedagogical and Learner Awareness Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for modeling pedagogical frameworks, instructional steps, learner awareness, assessments, and feedback." .

### Classes ###

:AccessibilityIssue a owl:Class ;
    rdfs:subClassOf :LearnerChallenge ;
    rdfs:label "Accessibility Issue" ;
    rdfs:comment "A specific type of learner challenge related to accessibility needs." .

:AISource a owl:Class ;
    rdfs:subClassOf :AutomatedSource ;
    rdfs:label "AI Source" ;
    rdfs:comment "An artificial intelligence source that produces a response." .