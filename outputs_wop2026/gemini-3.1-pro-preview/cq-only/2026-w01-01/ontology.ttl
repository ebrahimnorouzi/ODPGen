@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Life Cycle Assessment (LCA) Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern to model activities, flows, system boundaries, and impact results for Life Cycle Assessment (LCA) and system modeling." .

### Classes ###

:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A process or activity within a system model that transforms input flows into output flows." .

:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity, such as a person or organization, responsible for the LCA model." .

:Database a owl:Class ;
    rdfs:label "Database" ;
    rdfs:comment "A structured collection of data from which flow datasets are sourced." .

:ElementaryFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Elementary Flow" ;
    rdfs:comment "Material or energy entering the system being studied that has been drawn from the environment without previous human transformation, or material or energy leaving the system being studied that is released into the environment without subsequent human transformation." .

:EmissionFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Emission Flow" ;
    rdfs:comment "A flow representing emissions to air, water, or soil." .

:Flow a owl:Class ;
    rdfs:label "Flow" ;
    rdfs:comment "A material, energy, or information flow that acts as an input or output to an activity." .

:FlowDataset a owl:Class ;
    rdfs:label "Flow Dataset" ;
    rdfs:comment "A dataset containing information and metrics about a specific flow." .

:FunctionalUnit a owl:Class ;
    rdfs:label "Functional Unit" ;
    rdfs:comment "The quantified performance of a product system for use as a reference unit in an LCA study." .

:ImpactCategory a owl:Class ;
    rdfs:label "Impact Category" ;
    rdfs:comment "A class representing environmental issues of concern to which life cycle inventory analysis results may be assigned." .

:ImpactResult a owl:Class ;
    rdfs:label "Impact Result" ;
    rdfs:comment "The quantified environmental impact of an activity or flow for a specific impact category." .

:IntermediateFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Intermediate Flow" ;
    rdfs:comment "A product, material, or energy flow occurring between unit processes of the product system being studied." .

:LCAModel a owl:Class ;
    rdfs:subClassOf :SystemModel ;
    rdfs:label "LCA Model" ;
    rdfs:comment "A specific type of system model used for Life Cycle Assessment." .

:ProductFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Product Flow" ;
    rdfs:comment "A flow representing a product or co-product generated by an activity." .

:ResourceFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Resource Flow" ;
    rdfs:comment "A flow representing natural resources extracted from the environment." .

:Scope a owl:Class ;
    rdfs:label "Scope" ;
    rdfs:comment "The defined scope of the LCA model, detailing what is included and excluded." .

:SystemBoundary a owl:Class ;
    rdfs:label "System Boundary" ;
    rdfs:comment "A set of criteria specifying which unit processes are part of a product system." .

:SystemModel a owl:Class ;
    rdfs:label "System Model" ;
    rdfs:comment "A representation of a system consisting of interconnected activities." .

### Object Properties ###

:comesFromDatabase a owl:ObjectProperty ;
    rdfs:domain :FlowDataset ;
    rdfs:range :Database ;
    rdfs:label "comes from database" ;
    rdfs:comment "Links a flow dataset to the database it originates from." .

:dependsOnActivity a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Activity ;
    rdfs:label "depends on activity" ;
    rdfs:comment "Indicates a dependency chain where one activity relies on the execution or output of another activity." .

:generatedWithin a owl:ObjectProperty ;
    rdfs:domain :Flow ;
    rdfs:range :SystemBoundary ;
    rdfs:label "generated within" ;
    rdfs:comment "Specifies the system boundary within which a flow is generated." .

:hasActivity a owl:ObjectProperty ;
    rdfs:domain :SystemModel ;
    rdfs:range :Activity ;
    rdfs:label "has activity" ;
    rdfs:comment "Links a system model to the activities it contains." .

:hasDataset a owl:ObjectProperty ;
    rdfs:domain :Flow ;
    rdfs:range :FlowDataset ;
    rdfs:label "has dataset" ;
    rdfs:comment "Associates a flow with its corresponding flow dataset." .

:hasFlow a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Flow ;
    rdfs:label "has flow" ;
    rdfs:comment "A super-property linking an activity to its associated flows." .

:hasInputFlow a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasFlow ;
    rdfs:domain :Activity ;
    rdfs:range :Flow ;
    rdfs:label "has input flow" ;
    rdfs:comment "Links an activity to a flow that it consumes or requires as an input." .

:hasOutputFlow a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasFlow ;
    rdfs:domain :Activity ;
    rdfs:range :Flow ;
    rdfs:label "has output flow" ;
    rdfs:comment "Links an activity to a flow that it produces or emits as an output." .

:hasFunctionalUnit a owl:ObjectProperty ;
    rdfs:domain :LCAModel ;
    rdfs:range :FunctionalUnit ;
    rdfs:label "has functional unit" ;
    rdfs:comment "Links an LCA model to its functional unit." .

:hasImpactCategory a owl:ObjectProperty ;
    rdfs:domain :ImpactResult ;
    rdfs:range :ImpactCategory ;
    rdfs:label "has impact category" ;
    rdfs:comment "Links an impact result to the specific impact category it measures." .

:hasImpactResult a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
                  owl:unionOf ( :Activity :Flow ) ] ;
    rdfs:range :ImpactResult ;
    rdfs:label "has impact result" ;
    rdfs:comment "Links an activity or a flow to its calculated impact result." .

:hasResponsibleAgent a owl:ObjectProperty ;
    rdfs:domain :LCAModel ;
    rdfs:range :Agent ;
    rdfs:label "has responsible agent" ;
    rdfs:comment "Links an LCA model to the agent responsible for it." .

:hasScope a owl:ObjectProperty ;
    rdfs:domain :LCAModel ;
    rdfs:range :Scope ;
    rdfs:label "has scope" ;
    rdfs:comment "Links an LCA model to its defined scope." .

:hasSystemBoundary a owl:ObjectProperty ;
    rdfs:domain :LCAModel ;
    rdfs:range :SystemBoundary ;
    rdfs:label "has system boundary" ;
    rdfs:comment "Links an LCA model to its system boundary." .

### Datatype Properties ###

:hasContributionPercentage a owl:DatatypeProperty ;
    rdfs:domain :ImpactResult ;
    rdfs:range xsd:decimal ;
    rdfs:label "has contribution percentage" ;
    rdfs:comment "The percentage contribution of a specific flow or activity to an impact category." .

:hasImpactValue a owl:DatatypeProperty ;
    rdfs:domain :ImpactResult ;
    rdfs:range xsd:decimal ;
    rdfs:label "has impact value" ;
    rdfs:comment "The numerical value of the impact result." .

:hasTotalAmount a owl:DatatypeProperty ;
    rdfs:domain :Flow ;
    rdfs:range xsd:decimal ;
    rdfs:label "has total amount" ;
    rdfs:comment "The total quantified amount of a flow generated or consumed." .