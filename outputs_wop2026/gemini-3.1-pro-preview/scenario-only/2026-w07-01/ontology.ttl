@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Adaptive Pedagogical Learning Ontology (APLO) Pattern" ;
    rdfs:comment "An ontology design pattern representing learner context, pedagogical organization, objective alignment, evaluation, and feedback based on the APLO scenario." .

#################################################################
#    Classes
#################################################################

:Learner a owl:Class ;
    rdfs:label "Learner" ;
    rdfs:comment "An individual who engages in learning activities and pursues educational goals." .

:Goal a owl:Class ;
    rdfs:label "Goal" ;
    rdfs:comment "An objective or target that a learner pursues, which typically targets specific skills." .

:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "An ability or expertise targeted by goals or associated with a learner's context." .

:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "A subject matter or theme that a learner's preferences, challenges, or awareness may relate to." .

:LearnerContextElement a owl:Class ;
    rdfs:label "Learner Context Element" ;
    rdfs:comment "A superclass representing various aspects of a learner's context, such as preferences, challenges, or awareness." .

:Preference a owl:Class ;
    rdfs:subClassOf :LearnerContextElement ;
    rdfs:label "Preference" ;
    rdfs:comment "A specific inclination or choice a learner has regarding topics or skills." .

:Challenge a owl:Class ;
    rdfs:subClassOf :LearnerContextElement ;
    rdfs:label "Challenge" ;
    rdfs:comment "A difficulty or obstacle a learner faces regarding specific topics or skills." .

:Awareness a owl:Class ;
    rdfs:subClassOf :LearnerContextElement ;
    rdfs:label "Awareness" ;
    rdfs:comment "A learner's state of knowledge or consciousness regarding specific topics or skills, which may change over time." .

:LearningObjective a owl:Class ;
    rdfs:label "Learning Objective" ;
    rdfs:comment "A defined educational aim aligned with learner situations and supported by pedagogical techniques or resources." .

:LearnerSituation a owl:Class ;
    rdfs:label "Learner Situation" ;
    rdfs:comment "The specific context, state, or condition of a learner to which learning objectives are aligned." .

:PedagogicalTechnique a owl:Class ;
    rdfs:label "Pedagogical Technique" ;
    rdfs:comment "A method or practice of teaching used to support learning objectives." .

:LearningResourceUnit a owl:Class ;
    rdfs:label "Learning Resource Unit" ;
    rdfs:comment "An educational material or asset used to support learning objectives." .

:AssessmentExercise a owl:Class ;
    rdfs:label "Assessment Exercise" ;
    rdfs:comment "An activity designed to evaluate a learner, using specific techniques and metrics to produce results." .

:EvaluationTechnique a owl:Class ;
    rdfs:label "Evaluation Technique" ;
    rdfs:comment "A specific method used within an assessment exercise to evaluate the learner." .

:Metric a owl:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A standard of measurement used within an assessment exercise." .

:Result a owl:Class ;
    rdfs:label "Result" ;
    rdfs:comment "The outcome produced by an assessment exercise." .

:Feedback a owl:Class ;
    rdfs:label "Feedback" ;
    rdfs:comment "Information provided in response to a result, containing source and temporal information." .

:AwarenessObservation a owl:Class ;
    rdfs:label "Awareness Observation" ;
    rdfs:comment "An observation regarding a learner's awareness, supported by assessment results." .

:LearningStrategy a owl:Class ;
    rdfs:label "Learning Strategy" ;
    rdfs:comment "A strategy used by the learner, the use of which is supported or evidenced by assessment results." .

:PedagogicalFramework a owl:Class ;
    rdfs:label "Pedagogical Framework" ;
    rdfs:comment "An organized structure of pedagogical elements." .

:PedagogicalElement a owl:Class ;
    rdfs:label "Pedagogical Element" ;
    rdfs:comment "A constituent part of a pedagogical framework, which can be ordered sequentially." .

#################################################################
#    Object Properties
#################################################################

:pursuesGoal a owl:ObjectProperty ;
    rdfs:domain :Learner ;
    rdfs:range :Goal ;
    rdfs:label "pursues goal" ;
    rdfs:comment "Relates a learner to a goal they are trying to achieve." .

:targetsSkill a owl:ObjectProperty ;
    rdfs:domain :Goal ;
    rdfs:range :Skill ;
    rdfs:label "targets skill" ;
    rdfs:comment "Relates a goal to the specific skill it aims to develop." .

:hasContextElement a owl:ObjectProperty ;
    rdfs:domain :Learner ;
    rdfs:range :LearnerContextElement ;
    rdfs:label "has context element" ;
    rdfs:comment "Relates a learner to an element of their context (preference, challenge, or awareness)." .

:hasPreference a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasContextElement ;
    rdfs:range :Preference ;
    rdfs:label "has preference" ;
    rdfs:comment "Relates a learner to a specific preference." .

:hasChallenge a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasContextElement ;
    rdfs:range :Challenge ;
    rdfs:label "has challenge" ;
    rdfs:comment "Relates a learner to a specific challenge." .

:hasAwareness a owl:ObjectProperty ;
    rdfs:subPropertyOf :hasContextElement ;
    rdfs:range :Awareness ;
    rdfs:label "has awareness" ;
    rdfs:comment "Relates a learner to their awareness state." .

:aboutTopic a owl:ObjectProperty ;
    rdfs:domain :LearnerContextElement ;
    rdfs:range :Topic ;
    rdfs:label "about topic" ;
    rdfs:comment "Relates a context element (preference, challenge, awareness) to a specific topic." .

:aboutSkill a owl:ObjectProperty ;
    rdfs:domain :LearnerContextElement ;
    rdfs:range :Skill ;
    rdfs:label "about skill" ;
    rdfs:comment "Relates a context element (preference, challenge, awareness) to a specific skill." .

:alignedWithSituation a owl:ObjectProperty ;
    rdfs:domain :LearningObjective ;
    rdfs:range :LearnerSituation ;
    rdfs:label "aligned with situation" ;
    rdfs:comment "Relates a learning objective to the learner situation it addresses." .

:supportedByTechnique a owl:ObjectProperty ;
    rdfs:domain :LearningObjective ;
    rdfs:range :PedagogicalTechnique ;
    rdfs:label "supported by technique" ;
    rdfs:comment "Relates a learning objective to a pedagogical technique that supports it." .

:supportedByResource a owl:ObjectProperty ;
    rdfs:domain :LearningObjective ;
    rdfs:range :LearningResourceUnit ;
    rdfs:label "supported by resource" ;
    rdfs:comment "Relates a learning objective to a learning resource unit that supports it." .

:usesEvaluationTechnique a owl:ObjectProperty ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :EvaluationTechnique ;
    rdfs:label "uses evaluation technique" ;
    rdfs:comment "Relates an assessment exercise to the evaluation technique it employs." .

:usesMetric a owl:ObjectProperty ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :Metric ;
    rdfs:label "uses metric" ;
    rdfs:comment "Relates an assessment exercise to the metric it uses for evaluation." .

:producesResult a owl:ObjectProperty ;
    rdfs:domain :AssessmentExercise ;
    rdfs:range :Result ;
    rdfs:label "produces result" ;
    rdfs:comment "Relates an assessment exercise to the result it generates." .

:supportsFeedback a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :Feedback ;
    rdfs:label "supports feedback" ;
    rdfs:comment "Relates a result to the feedback it informs or supports." .

:supportsAwarenessObservation a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :AwarenessObservation ;
    rdfs:label "supports awareness observation" ;
    rdfs:comment "Relates a result to an awareness observation it evidences." .

:supportsLearningStrategy a owl:ObjectProperty ;
    rdfs:domain :Result ;
    rdfs:range :LearningStrategy ;
    rdfs:label "supports learning strategy" ;
    rdfs:comment "Relates a result to a learning strategy whose use it supports or evidences." .

:hasPedagogicalElement a owl:ObjectProperty ;
    rdfs:domain :PedagogicalFramework ;
    rdfs:range :PedagogicalElement ;
    rdfs:label "has pedagogical element" ;
    rdfs:comment "Relates a pedagogical framework to its constituent elements." .

:hasNextElement a owl:ObjectProperty ;
    rdfs:domain :PedagogicalElement ;
    rdfs:range :PedagogicalElement ;
    rdfs:label "has next element" ;
    rdfs:comment "Defines the sequential order of pedagogical elements within a framework." .

#################################################################
#    Datatype Properties
#################################################################

:hasSourceInformation a owl:DatatypeProperty ;
    rdfs:domain :Feedback ;
    rdfs:range xsd:string ;
    rdfs:label "has source information" ;
    rdfs:comment "Captures the source (e.g., system, instructor) of the feedback." .

:hasFeedbackTime a owl:DatatypeProperty ;
    rdfs:domain :Feedback ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has feedback time" ;
    rdfs:comment "Captures the temporal information indicating when the feedback was provided." .

:hasAwarenessTime a owl:DatatypeProperty ;
    rdfs:domain :Awareness ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has awareness time" ;
    rdfs:comment "Captures the temporal information indicating when the learner's awareness state was recorded, reflecting changes over time." .

#################################################################
#    Disjointness Axioms (Minimal/Sufficient)
#################################################################

[] a owl:AllDisjointClasses ;
    owl:members ( :AssessmentExercise :Goal :Learner :LearningObjective :PedagogicalFramework :Result :Skill :Topic ) .