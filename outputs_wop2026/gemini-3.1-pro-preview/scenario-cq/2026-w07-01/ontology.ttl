@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Adaptive Personalized Learning Ontology (APLO) Pattern" ;
    rdfs:comment "An ontology design pattern representing pedagogical organization, objective alignment, evaluation, feedback responses, learner context, and learner awareness." .

### Classes ###

:Learner a owl:Class ;
    rdfs:label "Learner" ;
    rdfs:comment "A person who is learning and pursuing goals." .

:Goal a owl:Class ;
    rdfs:label "Goal" ;
    rdfs:comment "A target the learner wants to achieve." .

:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "An ability targeted by goals or developed by objectives." .