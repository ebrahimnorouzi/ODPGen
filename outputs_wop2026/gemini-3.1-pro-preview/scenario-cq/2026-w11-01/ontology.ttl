@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "WISDOM Stress Detection Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for modeling stress detection, including stressors, stress conditions, physiological responses, sensors, and contextual factors." .

# --- Classes ---

:StressCondition a owl:Class ;
    rdfs:label "Stress Condition" ;
    rdfs:comment "A state or condition related to stress." .

:BaselineCondition a owl:Class ;
    rdfs:subClassOf :StressCondition ;
    rdfs:label "Baseline Condition" ;
    rdfs:comment "A condition describing a baseline state." .

:RecoveryCondition a owl:Class ;
    rdfs:subClassOf :StressCondition ;
    rdfs:label "Recovery Condition" ;
    rdfs:comment "A condition describing a recovery state." .