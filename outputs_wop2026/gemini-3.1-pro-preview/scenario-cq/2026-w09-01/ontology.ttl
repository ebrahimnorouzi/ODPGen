# Do NOT score this file as a complete ontology; see metadata.json.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Climate Services and Variables Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing datasets, variables (independent, dependent, derived, aggregating), dimensional spaces, quantizations, and data generation processes, motivated by the climate services domain." .

### Classes ###

:Variable a owl:Class ;
    rdfs:label "Variable" ;
    rdfs:comment "A variable that takes values in a dimensional space, such as an independent or dependent variable in a dataset." .

:IndependentVariable a owl:Class ;
    rdfs:subClassOf :Variable ;
    rdfs:label "Independent Variable" ;
    rdfs:comment "A variable that does not depend on other variables, often representing a dimension like time or space." .