@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Life Cycle Assessment (LCA) Ontology Design Pattern" ;
    rdfs:comment "An ontology design pattern for representing Life Cycle Assessment (LCA) studies, system models, activities, flows, and environmental impacts." .

### Classes ###

:LCAStudy a owl:Class ;
    rdfs:label "LCA Study" ;
    rdfs:comment "A Life Cycle Assessment study evaluating the environmental impact of a product or system." .

:SystemModel a owl:Class ;
    rdfs:label "System Model" ;
    rdfs:comment "A model representing the system under study in an LCA, containing activities and boundaries." .

:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A process or activity within an LCA system model that transforms inputs into outputs." .

:Flow a owl:Class ;
    rdfs:label "Flow" ;
    rdfs:comment "A physical or economic flow of materials, energy, or emissions." .

:ElementaryFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Elementary Flow" ;
    rdfs:comment "Material or energy entering the system from the environment without previous human transformation, or leaving the system to the environment without subsequent human transformation." ;
    owl:disjointWith :IntermediateFlow .

:IntermediateFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Intermediate Flow" ;
    rdfs:comment "Product, material, or energy flow occurring between activities of the technosphere." .

:ResourceFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Resource Flow" ;
    rdfs:comment "A flow representing resources extracted from the environment." .

:EmissionFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Emission Flow" ;
    rdfs:comment "A flow representing emissions released into the environment." .

:ProductFlow a owl:Class ;
    rdfs:subClassOf :Flow ;
    rdfs:label "Product Flow" ;
    rdfs:comment "A flow representing a product or co-product generated by an activity." .

:FlowDataset a owl:Class ;
    rdfs:label "Flow Dataset" ;
    rdfs:comment "A dataset providing inventory data for a specific flow." .

:Database a owl:Class ;
    rdfs:label "Database" ;
    rdfs:comment "A database providing life cycle inventory datasets." .

:ImpactResult a owl:Class ;
    rdfs:label "Impact Result" ;
    rdfs:comment "The quantified environmental impact of an activity or flow." .

:ImpactCategory a owl:Class ;
    rdfs:label "Impact Category" ;
    rdfs:comment "A class representing environmental issues of concern to which life cycle inventory results may be assigned." .

:FunctionalUnit a owl:Class ;
    rdfs:label "Functional Unit" ;
    rdfs:comment "The quantified performance of a product system for use as a reference unit." .

:Scope a owl:Class ;
    rdfs:label "Scope" ;
    rdfs:comment "The scope defining the extent of the LCA study." .

:SystemBoundary a owl:Class ;
    rdfs:label "System Boundary" ;
    rdfs:comment "A set of criteria specifying which unit processes are part of a product system." .

:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An actor or responsible party involved in the LCA study or system model." .

:SoftwareTool a owl:Class ;
    rdfs:label "Software Tool" ;
    rdfs:comment "A software application used to conduct the LCA study." .

:BillOfMaterials a owl:Class ;
    rdfs:label "Bill of Materials" ;
    rdfs:comment "A list of the raw materials, sub-assemblies, intermediate assemblies, sub-components, parts, and the quantities of each needed to manufacture an end product." .

:Methodology a owl:Class ;
    rdfs:label "Methodology" ;
    rdfs:comment "The environmental impact calculation methodology used in the study." .

### Object Properties ###

:hasSystemModel a owl:ObjectProperty ;
    rdfs:label "has system model" ;
    rdfs:comment "Links an LCA study to its system model." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :SystemModel .

:hasActivity a owl:ObjectProperty ;
    rdfs:label "has activity" ;
    rdfs:comment "Links a system model to an activity contained within it." ;
    rdfs:domain :SystemModel ;
    rdfs:range :Activity .

:hasInputFlow a owl:ObjectProperty ;
    rdfs:label "has input flow" ;
    rdfs:comment "Links an activity to a flow it consumes as an input." ;
    rdfs:domain :Activity ;
    rdfs:range :Flow .

:hasOutputFlow a owl:ObjectProperty ;
    rdfs:label "has output flow" ;
    rdfs:comment "Links an activity to a flow it produces as an output." ;
    rdfs:domain :Activity ;
    rdfs:range :Flow .

:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "Indicates a dependency chain between activities." ;
    rdfs:domain :Activity ;
    rdfs:range :Activity .

:describesFlow a owl:ObjectProperty ;
    rdfs:label "describes flow" ;
    rdfs:comment "Links a flow dataset to the flow it describes." ;
    rdfs:domain :FlowDataset ;
    rdfs:range :Flow .

:sourcedFrom a owl:ObjectProperty ;
    rdfs:label "sourced from" ;
    rdfs:comment "Links a flow dataset to the database it originates from." ;
    rdfs:domain :FlowDataset ;
    rdfs:range :Database .

:hasFunctionalUnit a owl:ObjectProperty ;
    rdfs:label "has functional unit" ;
    rdfs:comment "Links a system model to its functional unit." ;
    rdfs:domain :SystemModel ;
    rdfs:range :FunctionalUnit .

:hasScope a owl:ObjectProperty ;
    rdfs:label "has scope" ;
    rdfs:comment "Links a system model to its scope." ;
    rdfs:domain :SystemModel ;
    rdfs:range :Scope .

:hasSystemBoundary a owl:ObjectProperty ;
    rdfs:label "has system boundary" ;
    rdfs:comment "Links a system model to its system boundary." ;
    rdfs:domain :SystemModel ;
    rdfs:range :SystemBoundary .

:hasResponsibleAgent a owl:ObjectProperty ;
    rdfs:label "has responsible agent" ;
    rdfs:comment "Links a system model to the agent responsible for it." ;
    rdfs:domain :SystemModel ;
    rdfs:range :Agent .

:hasImpactResult a owl:ObjectProperty ;
    rdfs:label "has impact result" ;
    rdfs:comment "Links an activity or flow to its calculated impact result." ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( :Activity :Flow )
    ] ;
    rdfs:range :ImpactResult .

:forImpactCategory a owl:ObjectProperty ;
    rdfs:label "for impact category" ;
    rdfs:comment "Links an impact result to the specific impact category it measures." ;
    rdfs:domain :ImpactResult ;
    rdfs:range :ImpactCategory .

:generatedWithin a owl:ObjectProperty ;
    rdfs:label "generated within" ;
    rdfs:comment "Links a flow to the system boundary within which it is generated." ;
    rdfs:domain :Flow ;
    rdfs:range :SystemBoundary .

:usesSoftware a owl:ObjectProperty ;
    rdfs:label "uses software" ;
    rdfs:comment "Links an LCA study to the software tool used." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :SoftwareTool .

:basedOnBOM a owl:ObjectProperty ;
    rdfs:label "based on BOM" ;
    rdfs:comment "Links an LCA study to the Bill of Materials it is based on." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :BillOfMaterials .

:usesMethodology a owl:ObjectProperty ;
    rdfs:label "uses methodology" ;
    rdfs:comment "Links an LCA study to the impact calculation methodology used." ;
    rdfs:domain :LCAStudy ;
    rdfs:range :Methodology .

### Datatype Properties ###

:hasContributionPercentage a owl:DatatypeProperty ;
    rdfs:label "has contribution percentage" ;
    rdfs:comment "The percentage contribution of a flow or activity to a specific impact category." ;
    rdfs:domain :ImpactResult ;
    rdfs:range xsd:decimal .

:hasTotalAmount a owl:DatatypeProperty ;
    rdfs:label "has total amount" ;
    rdfs:comment "The total quantified amount of a flow." ;
    rdfs:domain :Flow ;
    rdfs:range xsd:decimal .