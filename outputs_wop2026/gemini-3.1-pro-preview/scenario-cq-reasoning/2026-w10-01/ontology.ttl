@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix :     <http://example.org/odp#> .

:Ontology a owl:Ontology ;
    rdfs:label "Software and Hardware Requirements Ontology Design Pattern"@en ;
    rdfs:comment "An ontology design pattern for representing software and hardware requirements, including resource types, property values, and versions, to support dynamic resource allocation and matchmaking."@en .

# --- Classes ---

:Resource a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "A digital or physical asset, such as software or hardware."@en .

:Software a owl:Class ;
    rdfs:subClassOf :Resource ;
    owl:disjointWith :Hardware ;
    rdfs:label "Software"@en ;
    rdfs:comment "A software resource or application."@en .

:Hardware a owl:Class ;
    rdfs:subClassOf :Resource ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "A hardware resource, such as a DPU or GPU."@en .

:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A specification of a condition or capability needed by a software resource."@en .

:SoftwareRequirement a owl:Class ;
    rdfs:subClassOf :Requirement ;
    owl:disjointWith :HardwareRequirement ;
    rdfs:label "Software Requirement"@en ;
    rdfs:comment "A requirement specifically targeting a software resource."@en .

:HardwareRequirement a owl:Class ;
    rdfs:subClassOf :Requirement ;
    rdfs:label "Hardware Requirement"@en ;
    rdfs:comment "A requirement specifically targeting a hardware resource."@en .

# --- Object Properties ---

:hasRequirement a owl:ObjectProperty ;
    rdfs:domain :Software ;
    rdfs:range :Requirement ;
    rdfs:label "has requirement"@en ;
    rdfs:comment "Links a software to its hardware or software requirements."@en .

:targetsResource a owl:ObjectProperty ;
    rdfs:domain :Requirement ;
    rdfs:range :Resource ;
    rdfs:label "targets resource"@en ;
    rdfs:comment "Links a requirement to the specific resource (software or hardware) it requires."@en .

# --- Datatype Properties ---

:targetsResourceType a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "targets resource type"@en ;
    rdfs:comment "Specifies the type or category of the required software or hardware as a string."@en .

:onResourceProperty a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string ;
    rdfs:label "on resource property"@en ;
    rdfs:comment "Identifies the specific property (e.g., RAM, cores) of the resource that is being constrained by the requirement."@en .

:hasMinValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:decimal ;
    rdfs:label "has minimum value"@en ;
    rdfs:comment "Specifies the minimum required numeric value for the targeted resource property."@en .

:hasMaxValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:decimal ;
    rdfs:label "has maximum value"@en ;
    rdfs:comment "Specifies the maximum allowed numeric value for the targeted resource property."@en .

:hasExactValue a owl:DatatypeProperty ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:decimal ;
    rdfs:label "has exact value"@en ;
    rdfs:comment "Specifies the exact required numeric value for the targeted resource property."@en .

:hasMinVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has minimum version"@en ;
    rdfs:comment "Specifies the minimum required version of the targeted software."@en .

:hasMaxVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has maximum version"@en ;
    rdfs:comment "Specifies the maximum allowed version of the targeted software."@en .

:hasExactVersion a owl:DatatypeProperty ;
    rdfs:domain :SoftwareRequirement ;
    rdfs:range xsd:string ;
    rdfs:label "has exact version"@en ;
    rdfs:comment "Specifies the exact required version of the targeted software."@en .