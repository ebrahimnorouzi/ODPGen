@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/universal#> .

<https://example.org/odp/universal> a owl:Ontology ;
    rdfs:label "Universally Typed Pattern"@en .

:Sensor a owl:Class ; rdfs:label "Sensor"@en .
:Observation a owl:Class ; rdfs:label "Observation"@en .
:FeatureOfInterest a owl:Class ; rdfs:label "Feature of Interest"@en .

:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:label "has feature of interest"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

:resultTime a owl:DatatypeProperty ;
    rdfs:label "result time"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal .
