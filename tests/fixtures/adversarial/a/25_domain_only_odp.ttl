@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/evaluation#> .

:EvaluationRequest a owl:Class ;
    rdfs:label "Evaluation Request"@en ;
    rdfs:comment "A request to evaluate whether an action over a target by a party should be permitted."@en .

:requestedAction a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:label "requested action"@en .

:requestingParty a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:label "requesting party"@en .

:requestedTarget a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:label "requested target"@en .

:context a owl:ObjectProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:label "context"@en .

dcterms:issued a owl:DatatypeProperty ;
    rdfs:domain :EvaluationRequest ;
    rdfs:label "issued"@en .
