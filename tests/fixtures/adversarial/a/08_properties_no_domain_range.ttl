@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/ac#> .

<https://example.org/odp/ac> a owl:Ontology ;
    rdfs:label "Access Control Pattern"@en ;
    rdfs:comment "A pattern for access and usage control requests."@en ;
    owl:versionInfo "1.0.0" .

:Request a owl:Class ;
    rdfs:label "Request"@en ;
    rdfs:comment "The Request concept of the access control pattern."@en .

:Party a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "The Party concept of the access control pattern."@en .

:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:comment "The Asset concept of the access control pattern."@en .

:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "The Action concept of the access control pattern."@en .

:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "The Constraint concept of the access control pattern."@en .

:Permission a owl:Class ;
    rdfs:label "Permission"@en ;
    rdfs:comment "The Permission concept of the access control pattern."@en .

:Prohibition a owl:Class ;
    rdfs:label "Prohibition"@en ;
    rdfs:comment "The Prohibition concept of the access control pattern."@en .

:Duty a owl:Class ;
    rdfs:label "Duty"@en ;
    rdfs:comment "The Duty concept of the access control pattern."@en .

:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    rdfs:comment "The Policy concept of the access control pattern."@en .

:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "The Context concept of the access control pattern."@en .

:Report a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:comment "The Report concept of the access control pattern."@en .

:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    rdfs:comment "The Decision concept of the access control pattern."@en .

:hasRequester a owl:ObjectProperty ;
    rdfs:label "hasRequester"@en ;
    rdfs:comment "The hasRequester relation of the access control pattern."@en .

:hasTarget a owl:ObjectProperty ;
    rdfs:label "hasTarget"@en ;
    rdfs:comment "The hasTarget relation of the access control pattern."@en .

:hasAction a owl:ObjectProperty ;
    rdfs:label "hasAction"@en ;
    rdfs:comment "The hasAction relation of the access control pattern."@en .

:hasConstraint a owl:ObjectProperty ;
    rdfs:label "hasConstraint"@en ;
    rdfs:comment "The hasConstraint relation of the access control pattern."@en .

:hasPermission a owl:ObjectProperty ;
    rdfs:label "hasPermission"@en ;
    rdfs:comment "The hasPermission relation of the access control pattern."@en .

:hasProhibition a owl:ObjectProperty ;
    rdfs:label "hasProhibition"@en ;
    rdfs:comment "The hasProhibition relation of the access control pattern."@en .

:hasDuty a owl:ObjectProperty ;
    rdfs:label "hasDuty"@en ;
    rdfs:comment "The hasDuty relation of the access control pattern."@en .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo"@en ;
    rdfs:comment "The appliesTo relation of the access control pattern."@en .

:isGovernedBy a owl:ObjectProperty ;
    rdfs:label "isGovernedBy"@en ;
    rdfs:comment "The isGovernedBy relation of the access control pattern."@en .

:yieldsDecision a owl:ObjectProperty ;
    rdfs:label "yieldsDecision"@en ;
    rdfs:comment "The yieldsDecision relation of the access control pattern."@en .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext"@en ;
    rdfs:comment "The hasContext relation of the access control pattern."@en .

:hasReport a owl:ObjectProperty ;
    rdfs:label "hasReport"@en ;
