@prefix : <https://example.org/odp/clinical#> .

<https://example.org/odp/clinical> a owl:Ontology ;
    rdfs:label "Clinical Monitoring Pattern"@en ;
    rdfs:comment "A pattern for representing clinical monitoring of patients."@en .

:Patient a owl:Class ;
    rdfs:label "patient"@en ;
    rdfs:comment "The class of all things that are a patient in the clinical monitoring domain."@en ;
    skos:definition "A patient."@en ;
    dcterms:description "Documentation for patient, provided for reuse by downstream ontologies."@en .

