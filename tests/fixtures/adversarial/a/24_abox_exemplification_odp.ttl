PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX plasma: <https://w3id.org/plasma#>
PREFIX oac: <https://w3id.org/oac#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX : <https://example.com/>

:Agreement1 a odrl:Agreement, plasma:DataAgreement ;
  odrl:uid :Agreement1 ;
  odrl:profile oac: ;
  dcterms:issued "2024-02-11T09:30:00"^^xsd:dateTime ;
  dcterms:creator :ControllerA ;
  odrl:permission [
    odrl:assignee :SubjectB ;
    odrl:assigner :ControllerA ;
    oac:application :AppC ;
    odrl:action oac:Read ;
    odrl:target oac:HealthRecord ] .

:ControllerA a plasma:DataController .

:SubjectB a plasma:DataSubject .

:AppC a plasma:App .
