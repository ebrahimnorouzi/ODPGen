@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/observation#> .

<https://example.org/odp/observation> a owl:Ontology ;
    rdfs:label "Sensor Observation Pattern"@en ;
    rdfs:comment "A minimal ontology design pattern relating observations to the sensors that produced them and the features of interest they target."@en .

:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A device that carries out observations."@en .

:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "An act of carrying out a procedure to estimate a property of a feature of interest."@en .

:FeatureOfInterest a owl:Class ;
    rdfs:label "Feature of Interest"@en ;
    rdfs:comment "The real-world entity whose property is being estimated."@en .

:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en .

:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:label "has feature of interest"@en .

:resultTime a owl:DatatypeProperty ;
    rdfs:label "result time"@en .

# The three rdfs:domain and three rdfs:range axioms of the base pattern, with
# subjects and objects independently re-drawn from the same entity roster.
:Sensor rdfs:domain :madeBySensor .
:FeatureOfInterest rdfs:domain :Observation .
:resultTime rdfs:domain :hasFeatureOfInterest .
:Observation rdfs:range :resultTime .
:madeBySensor rdfs:range :FeatureOfInterest .
:hasFeatureOfInterest rdfs:range :Sensor .
