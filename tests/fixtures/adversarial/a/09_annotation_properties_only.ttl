@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/meta#> .

<https://example.org/odp/meta> a owl:Ontology ;
    rdfs:label "Pattern Documentation Vocabulary"@en ;
    :patternName "Sensor Observation" ;
    :patternIntent "To relate observations to the sensors that made them." ;
    :patternScope "Small, reusable, aligned to SOSA." ;
    :patternAuthor "anonymous" ;
    :patternVersion "1.0.0" ;
    :competencyQuestion "Which sensor made a given observation?" ,
                        "What feature of interest does an observation target?" ,
                        "At what time was the result obtained?" ;
    :reuseNote "Reuses SOSA and DUL." ;
    :modellingNote "Observation is reified." ;
    :provenanceNote "Derived from the scenario description." ;
    :exampleUsage "See the accompanying exemplification." .

:patternName a owl:AnnotationProperty ;
    rdfs:label "patternName"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:patternIntent a owl:AnnotationProperty ;
    rdfs:label "patternIntent"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:patternScope a owl:AnnotationProperty ;
    rdfs:label "patternScope"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:patternAuthor a owl:AnnotationProperty ;
    rdfs:label "patternAuthor"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:patternVersion a owl:AnnotationProperty ;
    rdfs:label "patternVersion"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:competencyQuestion a owl:AnnotationProperty ;
    rdfs:label "competencyQuestion"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:reuseNote a owl:AnnotationProperty ;
    rdfs:label "reuseNote"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:modellingNote a owl:AnnotationProperty ;
    rdfs:label "modellingNote"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:provenanceNote a owl:AnnotationProperty ;
    rdfs:label "provenanceNote"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .

:exampleUsage a owl:AnnotationProperty ;
    rdfs:label "exampleUsage"@en ;
    rdfs:comment "Annotation property used to document the pattern."@en .
