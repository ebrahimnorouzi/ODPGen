@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/heritage#> .

<https://example.org/odp/heritage> a owl:Ontology ;
    rdfs:label "Cultural Heritage Survey Pattern"@en ;
    rdfs:comment "An ontology design pattern for cultural heritage survey activities, the records they produce and the interpretations drawn from them."@en .

:Activity a owl:Class ;
    rdfs:label "activity"@en ;
    rdfs:comment "The class of every activity recorded by the cultural heritage survey pattern."@en .

:AerialSurvey a owl:Class ;
    rdfs:label "aerial survey"@en ;
    rdfs:comment "The class of every aerial survey recorded by the cultural heritage survey pattern."@en .

