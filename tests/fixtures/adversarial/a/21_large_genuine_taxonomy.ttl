:Coin a owl:Class ;
    rdfs:label "coin"@en ;
    rdfs:comment "The class of every coin recorded by the cultural heritage survey pattern."@en .

:Collection a owl:Class ;
    rdfs:label "collection"@en ;
    rdfs:comment "The class of every collection recorded by the cultural heritage survey pattern."@en .

