:Monument rdfs:subClassOf :CulturalHeritageEntity .
:Artefact rdfs:subClassOf :CulturalHeritageEntity .
:Site rdfs:subClassOf :CulturalHeritageEntity .
:Landscape rdfs:subClassOf :CulturalHeritageEntity .
:Collection rdfs:subClassOf :CulturalHeritageEntity .
:Document rdfs:subClassOf :CulturalHeritageEntity .
:Building rdfs:subClassOf :Monument .
:Statue rdfs:subClassOf :Monument .
:Bridge rdfs:subClassOf :Monument .
:Fortification rdfs:subClassOf :Monument .
:Ceramic rdfs:subClassOf :Artefact .
:Coin rdfs:subClassOf :Artefact .
:Tool rdfs:subClassOf :Artefact .
:Textile rdfs:subClassOf :Artefact .
:Manuscript rdfs:subClassOf :Artefact .
:ArchaeologicalSite rdfs:subClassOf :Site .
:BurialSite rdfs:subClassOf :Site .
:SettlementSite rdfs:subClassOf :Site .
:Survey rdfs:subClassOf :Activity .
:Excavation rdfs:subClassOf :Activity .
:Conservation rdfs:subClassOf :Activity .
:Documentation rdfs:subClassOf :Activity .
:Interpretation rdfs:subClassOf :Activity .
:GeophysicalSurvey rdfs:subClassOf :Survey .
:AerialSurvey rdfs:subClassOf :Survey .
:FieldWalkingSurvey rdfs:subClassOf :Survey .
:TrenchExcavation rdfs:subClassOf :Excavation .
:OpenAreaExcavation rdfs:subClassOf :Excavation .
:PreventiveConservation rdfs:subClassOf :Conservation .
:RemedialConservation rdfs:subClassOf :Conservation .
:Restoration rdfs:subClassOf :Conservation .
:Person rdfs:subClassOf :Agent .
:Organisation rdfs:subClassOf :Agent .
:Team rdfs:subClassOf :Agent .
:Museum rdfs:subClassOf :Organisation .
:University rdfs:subClassOf :Organisation .
:HeritageAgency rdfs:subClassOf :Organisation .
:Magnetometer rdfs:subClassOf :Equipment .
:GroundPenetratingRadar rdfs:subClassOf :Equipment .
:TotalStation rdfs:subClassOf :Equipment .
:Camera rdfs:subClassOf :Equipment .
:Drone rdfs:subClassOf :Equipment .
:FieldNote rdfs:subClassOf :Record .
:Photograph rdfs:subClassOf :Record .
:Drawing rdfs:subClassOf :Record .
:Measurement rdfs:subClassOf :Record .
:Sample rdfs:subClassOf :Record .
:Dating rdfs:subClassOf :Interpretation .
:Attribution rdfs:subClassOf :Interpretation .
:FunctionalInterpretation rdfs:subClassOf :Interpretation .
:Period rdfs:subClassOf :TimeSpan .
:Instant rdfs:subClassOf :TimeSpan .
:Prehistoric rdfs:subClassOf :Period .
:Classical rdfs:subClassOf :Period .
:Medieval rdfs:subClassOf :Period .
:Modern rdfs:subClassOf :Period .
:Region rdfs:subClassOf :Place .
:Locality rdfs:subClassOf :Place .

:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain :Activity ;
    rdfs:range :Agent .

:usedEquipment a owl:ObjectProperty ;
    rdfs:label "used equipment"@en ;
    rdfs:domain :Activity ;
    rdfs:range :Equipment .

:producedRecord a owl:ObjectProperty ;
    rdfs:label "produced record"@en ;
    rdfs:domain :Activity ;
    rdfs:range :Record .

:targets a owl:ObjectProperty ;
    rdfs:label "targets"@en ;
    rdfs:domain :Activity ;
    rdfs:range :CulturalHeritageEntity .

:tookPlaceAt a owl:ObjectProperty ;
    rdfs:label "took place at"@en ;
    rdfs:domain :Activity ;
    rdfs:range :Place .

:tookPlaceDuring a owl:ObjectProperty ;
    rdfs:label "took place during"@en ;
    rdfs:domain :Activity ;
    rdfs:range :TimeSpan .

:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:domain :Interpretation ;
    rdfs:range :Record .

:interprets a owl:ObjectProperty ;
    rdfs:label "interprets"@en ;
    rdfs:domain :Interpretation ;
    rdfs:range :CulturalHeritageEntity .

:assignsPeriod a owl:ObjectProperty ;
    rdfs:label "assigns period"@en ;
    rdfs:domain :Interpretation ;
    rdfs:range :Period .

:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:domain :CulturalHeritageEntity ;
    rdfs:range :Place .

:belongsToCollection a owl:ObjectProperty ;
    rdfs:label "belongs to collection"@en ;
    rdfs:domain :Artefact ;
    rdfs:range :Collection .

:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:domain :Person ;
    rdfs:range :Organisation .

:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recordedAt"@en ;
    rdfs:domain :Record ;
    rdfs:range xsd:dateTime .

:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "hasIdentifier"@en ;
    rdfs:domain :CulturalHeritageEntity ;
    rdfs:range xsd:string .

:depthInMetres a owl:DatatypeProperty ;
    rdfs:label "depthInMetres"@en ;
    rdfs:domain :TrenchExcavation ;
    rdfs:range xsd:decimal .

:startedOn a owl:DatatypeProperty ;
    rdfs:label "startedOn"@en ;
    rdfs:domain :Activity ;
    rdfs:range xsd:date .

:Monument owl:disjointWith :Artefact .
:Site owl:disjointWith :Artefact .
:Agent owl:disjointWith :Activity .
