@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix : <https://example.org/odp/tiny#> .

<https://example.org/odp/tiny> a owl:Ontology ;
    rdfs:label "Access Request Pattern"@en ;
    dcterms:description "A small, complete and reusable ontology design pattern that captures access requests, the parties that issue them and the assets they target. The pattern answers all three competency questions of the scenario."@en .

:AccessRequest a owl:Class ;
    rdfs:label "Access Request"@en ;
    rdfs:comment "A request by a party to perform an action over a target asset."@en .

:grantsAccess a owl:ObjectProperty ;
    rdfs:label "grants access"@en ;
    rdfs:comment "Relates an access request to whatever it grants access to."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .
