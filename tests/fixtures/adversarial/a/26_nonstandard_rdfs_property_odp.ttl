@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix : <https://example.org/odp/sotw#> .

:StateOfTheWorld a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:label "State of the World"@en ;
    skos:definition "Knowledge representing real-world information aiding policy evaluation."@en .

:currentTime a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:domain :StateOfTheWorld ;
    rdfs:range xsd:dateTime ;
    skos:definition "Denotes the current time of the state of the world."@en .

:currentLocation a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:domain :StateOfTheWorld ;
    skos:definition "Denotes the current location of a party."@en .

:assetCollection a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:domain :StateOfTheWorld ;
    rdfs:range odrl:Asset ;
    skos:definition "Denotes an asset that is part of an asset collection."@en .

:partyCollection a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:domain :StateOfTheWorld ;
    rdfs:range odrl:Party ;
    skos:definition "Denotes a party that is part of a party collection."@en .

:count a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy : ;
    rdfs:domain :StateOfTheWorld ;
    rdfs:range xsd:integer ;
    skos:definition "Denotes the number of times a rule has been exercised."@en .
