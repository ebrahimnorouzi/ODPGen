@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix c0: <https://example.org/odp/observation/copy0#> .
<https://example.org/odp/observation/copy0> a owl:Ontology ;
    rdfs:label "Sensor Observation Pattern"@en ;
    rdfs:comment "A minimal ontology design pattern relating observations to the sensors that produced them and the features of interest they target."@en .

c0:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A device that carries out observations."@en .

c0:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "An act of carrying out a procedure to estimate a property of a feature of interest."@en .

c0:FeatureOfInterest a owl:Class ;
    rdfs:label "Feature of Interest"@en ;
    rdfs:comment "The real-world entity whose property is being estimated."@en .

c0:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en ;
    rdfs:domain c0:Observation ;
    rdfs:range c0:Sensor .

c0:hasFeatureOfInterest a owl:ObjectProperty ;
    rdfs:label "has feature of interest"@en ;
    rdfs:domain c0:Observation ;
    rdfs:range c0:FeatureOfInterest .

c0:resultTime a owl:DatatypeProperty ;
    rdfs:label "result time"@en ;
    rdfs:domain c0:Observation ;
    rdfs:range xsd:dateTime .

