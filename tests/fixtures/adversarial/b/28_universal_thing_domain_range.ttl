@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Every declared property carries both an rdfs:domain and an rdfs:range,
# so domain coverage and range coverage are both exactly 1.0, and every
# domain and range resolves to a term that genuinely exists (owl:Thing).
# Computable from the property roster alone; carries no modelling decision.

<http://example.org/odp> a owl:Ontology ;
    rdfs:label "Universal Relation Pattern" ;
    rdfs:comment "A general-purpose relational pattern applicable to any domain." .

:Request a owl:Class ; rdfs:label "Request" .
:Party a owl:Class ; rdfs:label "Party" .
:Action a owl:Class ; rdfs:label "Action" .
:Asset a owl:Class ; rdfs:label "Asset" .
:Context a owl:Class ; rdfs:label "Context" .
:Constraint a owl:Class ; rdfs:label "Constraint" .
:Policy a owl:Class ; rdfs:label "Policy" .
:Report a owl:Class ; rdfs:label "Report" .
:Decision a owl:Class ; rdfs:label "Decision" .
:Rule a owl:Class ; rdfs:label "Rule" .
:Obligation a owl:Class ; rdfs:label "Obligation" .
:Permission a owl:Class ; rdfs:label "Permission" .
:Prohibition a owl:Class ; rdfs:label "Prohibition" .
:Evaluation a owl:Class ; rdfs:label "Evaluation" .
:Timestamp a owl:Class ; rdfs:label "Timestamp" .

:hasParty a owl:ObjectProperty ; rdfs:label "has party" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasAction a owl:ObjectProperty ; rdfs:label "has action" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasAsset a owl:ObjectProperty ; rdfs:label "has asset" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasContext a owl:ObjectProperty ; rdfs:label "has context" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasConstraint a owl:ObjectProperty ; rdfs:label "has constraint" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasPolicy a owl:ObjectProperty ; rdfs:label "has policy" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasReport a owl:ObjectProperty ; rdfs:label "has report" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasDecision a owl:ObjectProperty ; rdfs:label "has decision" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasRule a owl:ObjectProperty ; rdfs:label "has rule" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasObligation a owl:ObjectProperty ; rdfs:label "has obligation" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasPermission a owl:ObjectProperty ; rdfs:label "has permission" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasProhibition a owl:ObjectProperty ; rdfs:label "has prohibition" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasEvaluation a owl:ObjectProperty ; rdfs:label "has evaluation" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:hasTimestamp a owl:ObjectProperty ; rdfs:label "has timestamp" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
:relatesTo a owl:ObjectProperty ; rdfs:label "relates to" ; rdfs:domain owl:Thing ; rdfs:range owl:Thing .
