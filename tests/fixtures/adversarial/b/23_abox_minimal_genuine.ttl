PREFIX as: <https://www.w3.org/ns/activitystreams#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX plasma: <https://w3id.org/plasma#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX : <https://example.com/>

# A minimal ABox exemplification pattern, in the shape of published pattern
# 2023-134-02: typed individuals wired to one another. Zero owl:Class,
# zero rdfs:subClassOf, zero rdfs:domain, zero rdfs:range. This is what
# three of the fourteen published ODPs actually look like.

:ConsentRecord1 a plasma:ConsentRecord, as:Create ;
  dcterms:issued "2024-02-11T09:41:02"^^xsd:dateTime ;
  as:summary "Carla granted the analytics app access to her step count." ;
  as:actor :Carla ;
  as:object :StepCountResource ;
  as:generator :AnalyticsApp ;
  dcterms:publisher :AnalyticsAppProvider .

:Carla a plasma:DataSubject .

:AnalyticsApp a plasma:App .

:AnalyticsAppProvider a plasma:AppProvider .

:StepCountResource a plasma:Resource .
