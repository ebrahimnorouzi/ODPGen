@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/odp> a owl:Ontology ;
    rdfs:label "Fully Connected Provenance Pattern" ;
    rdfs:comment "Every property is applicable to every class." .

:Agent a owl:Class ;
    rdfs:label "Agent" .

:Activity a owl:Class ;
    rdfs:label "Activity" .

:Artifact a owl:Class ;
    rdfs:label "Artifact" .

:Place a owl:Class ;
    rdfs:label "Place" .

:TimeSpan a owl:Class ;
    rdfs:label "TimeSpan" .

:Role a owl:Class ;
    rdfs:label "Role" .

:Document a owl:Class ;
    rdfs:label "Document" .

:Measurement a owl:Class ;
    rdfs:label "Measurement" .

:relatesTo a owl:ObjectProperty ;
    rdfs:label "relatesTo" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:involves a owl:ObjectProperty ;
    rdfs:label "involves" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:occursAt a owl:ObjectProperty ;
    rdfs:label "occursAt" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:produces a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:hasRole a owl:ObjectProperty ;
    rdfs:label "hasRole" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:describes a owl:ObjectProperty ;
    rdfs:label "describes" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:measures a owl:ObjectProperty ;
    rdfs:label "measures" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

:partOf a owl:ObjectProperty ;
    rdfs:label "partOf" ;
    rdfs:domain :Agent ,
                 :Activity ,
                 :Artifact ,
                 :Place ,
                 :TimeSpan ,
                 :Role ,
                 :Document ,
                 :Measurement ;
    rdfs:range :Agent ,
                :Activity ,
                :Artifact ,
                :Place ,
                :TimeSpan ,
                :Role ,
                :Document ,
                :Measurement .

