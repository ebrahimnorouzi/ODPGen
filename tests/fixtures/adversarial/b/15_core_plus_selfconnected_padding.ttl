@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/odp> a owl:Ontology ;
    rdfs:label "Sensor Reading Provenance Pattern" ;
    rdfs:comment "A small ODP relating a sensor reading to the sensor that produced it, the property observed and the time of observation." .

:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "A device that produces readings." .

:Reading a owl:Class ;
    rdfs:label "Reading" ;
    rdfs:comment "A single measured value produced by a sensor." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty :producedBy ;
        owl:someValuesFrom :Sensor ] .

:ObservedProperty a owl:Class ;
    rdfs:label "Observed Property" ;
    rdfs:comment "The quality a reading quantifies." .

:CalibratedSensor a owl:Class ;
    rdfs:label "Calibrated Sensor" ;
    rdfs:subClassOf :Sensor ;
    rdfs:comment "A sensor with a valid calibration record." .

:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:domain :Reading ;
    rdfs:range :Sensor .

:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:domain :Reading ;
    rdfs:range :ObservedProperty .

:readingTime a owl:DatatypeProperty ;
    rdfs:label "reading time" ;
    rdfs:domain :Reading ;
    rdfs:range xsd:dateTime .

