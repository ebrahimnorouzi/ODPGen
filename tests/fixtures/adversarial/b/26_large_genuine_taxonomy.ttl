@prefix :     <https://example.org/odp/specimencuration#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/odp/specimencuration> a owl:Ontology ;
    rdfs:label "Specimen Curation Ontology Design Pattern" ;
    rdfs:comment "A genuine large pattern: a real subsumption hierarchy of specimen kinds, the events that act on specimens, and the properties that connect them. Included in the adversarial corpus as an OVER-CORRECTION guard, not as an exploit." .

:Specimen a owl:Class ;
    rdfs:label "Specimen" ;
    rdfs:comment "A physical object collected for scientific study." .

:GeologicalSpecimen a owl:Class ;
    rdfs:subClassOf :Specimen ;
    rdfs:label "Geological Specimen" ;
    rdfs:comment "A specimen of geological origin." .

:RockSpecimen a owl:Class ;
    rdfs:subClassOf :GeologicalSpecimen ;
    rdfs:label "Rock Specimen" ;
    rdfs:comment "A specimen consisting of consolidated rock." .

:IgneousRock a owl:Class ;
    rdfs:subClassOf :RockSpecimen ;
    rdfs:label "Igneous Rock" ;
    rdfs:comment "Rock formed by the cooling of magma or lava." .

:PlutonicRock a owl:Class ;
    rdfs:subClassOf :IgneousRock ;
    rdfs:label "Plutonic Rock" ;
    rdfs:comment "Igneous rock crystallised at depth." .

:VolcanicRock a owl:Class ;
    rdfs:subClassOf :IgneousRock ;
    rdfs:label "Volcanic Rock" ;
    rdfs:comment "Igneous rock crystallised at or near the surface." .

:Granite a owl:Class ;
    rdfs:subClassOf :PlutonicRock ;
    rdfs:label "Granite" ;
    rdfs:comment "A coarse-grained felsic plutonic rock." .

:Gabbro a owl:Class ;
    rdfs:subClassOf :PlutonicRock ;
    rdfs:label "Gabbro" ;
    rdfs:comment "A coarse-grained mafic plutonic rock." .

:Basalt a owl:Class ;
    rdfs:subClassOf :VolcanicRock ;
    rdfs:label "Basalt" ;
    rdfs:comment "A fine-grained mafic volcanic rock." .

:Rhyolite a owl:Class ;
    rdfs:subClassOf :VolcanicRock ;
    rdfs:label "Rhyolite" ;
    rdfs:comment "A fine-grained felsic volcanic rock." .

:SedimentaryRock a owl:Class ;
    rdfs:subClassOf :RockSpecimen ;
    rdfs:label "Sedimentary Rock" ;
    rdfs:comment "Rock formed by deposition and lithification." .

:ClasticRock a owl:Class ;
    rdfs:subClassOf :SedimentaryRock ;
    rdfs:label "Clastic Rock" ;
    rdfs:comment "Sedimentary rock formed from transported fragments." .

:ChemicalSedimentaryRock a owl:Class ;
    rdfs:subClassOf :SedimentaryRock ;
    rdfs:label "Chemical Sedimentary Rock" ;
    rdfs:comment "Sedimentary rock formed by precipitation." .

:Sandstone a owl:Class ;
    rdfs:subClassOf :ClasticRock ;
    rdfs:label "Sandstone" ;
    rdfs:comment "A clastic rock dominated by sand-sized grains." .

:Shale a owl:Class ;
    rdfs:subClassOf :ClasticRock ;
    rdfs:label "Shale" ;
    rdfs:comment "A fissile clastic rock dominated by clay-sized grains." .

:Limestone a owl:Class ;
    rdfs:subClassOf :ChemicalSedimentaryRock ;
    rdfs:label "Limestone" ;
    rdfs:comment "A carbonate rock dominated by calcite." .

:Evaporite a owl:Class ;
    rdfs:subClassOf :ChemicalSedimentaryRock ;
    rdfs:label "Evaporite" ;
    rdfs:comment "A rock formed by evaporation of a brine." .

:MetamorphicRock a owl:Class ;
    rdfs:subClassOf :RockSpecimen ;
    rdfs:label "Metamorphic Rock" ;
    rdfs:comment "Rock altered by heat, pressure or fluids." .

:FoliatedRock a owl:Class ;
    rdfs:subClassOf :MetamorphicRock ;
    rdfs:label "Foliated Rock" ;
    rdfs:comment "Metamorphic rock with a planar fabric." .

:NonFoliatedRock a owl:Class ;
    rdfs:subClassOf :MetamorphicRock ;
    rdfs:label "Non Foliated Rock" ;
    rdfs:comment "Metamorphic rock lacking a planar fabric." .

:Schist a owl:Class ;
    rdfs:subClassOf :FoliatedRock ;
    rdfs:label "Schist" ;
    rdfs:comment "A strongly foliated medium-grade metamorphic rock." .

:Gneiss a owl:Class ;
    rdfs:subClassOf :FoliatedRock ;
    rdfs:label "Gneiss" ;
    rdfs:comment "A banded high-grade metamorphic rock." .

:Marble a owl:Class ;
    rdfs:subClassOf :NonFoliatedRock ;
    rdfs:label "Marble" ;
    rdfs:comment "A metamorphosed carbonate rock." .

:Quartzite a owl:Class ;
    rdfs:subClassOf :NonFoliatedRock ;
    rdfs:label "Quartzite" ;
    rdfs:comment "A metamorphosed quartz-rich sandstone." .

:MineralSpecimen a owl:Class ;
    rdfs:subClassOf :GeologicalSpecimen ;
    rdfs:label "Mineral Specimen" ;
    rdfs:comment "A specimen of a single mineral phase." .

:SilicateMineral a owl:Class ;
    rdfs:subClassOf :MineralSpecimen ;
    rdfs:label "Silicate Mineral" ;
    rdfs:comment "A mineral built on silicon-oxygen tetrahedra." .

:CarbonateMineral a owl:Class ;
    rdfs:subClassOf :MineralSpecimen ;
    rdfs:label "Carbonate Mineral" ;
    rdfs:comment "A mineral built on the carbonate anion." .

:SulfideMineral a owl:Class ;
    rdfs:subClassOf :MineralSpecimen ;
    rdfs:label "Sulfide Mineral" ;
    rdfs:comment "A mineral built on the sulfide anion." .

:Quartz a owl:Class ;
    rdfs:subClassOf :SilicateMineral ;
    rdfs:label "Quartz" ;
    rdfs:comment "Crystalline silicon dioxide." .

:Feldspar a owl:Class ;
    rdfs:subClassOf :SilicateMineral ;
    rdfs:label "Feldspar" ;
    rdfs:comment "A framework aluminosilicate mineral group." .

:Calcite a owl:Class ;
    rdfs:subClassOf :CarbonateMineral ;
    rdfs:label "Calcite" ;
    rdfs:comment "The trigonal polymorph of calcium carbonate." .

:Pyrite a owl:Class ;
    rdfs:subClassOf :SulfideMineral ;
    rdfs:label "Pyrite" ;
    rdfs:comment "Cubic iron disulfide." .

:FossilSpecimen a owl:Class ;
    rdfs:subClassOf :GeologicalSpecimen ;
    rdfs:label "Fossil Specimen" ;
    rdfs:comment "Preserved remains or traces of past life." .

:BodyFossil a owl:Class ;
    rdfs:subClassOf :FossilSpecimen ;
    rdfs:label "Body Fossil" ;
    rdfs:comment "A fossil preserving part of an organism itself." .

:TraceFossil a owl:Class ;
    rdfs:subClassOf :FossilSpecimen ;
    rdfs:label "Trace Fossil" ;
    rdfs:comment "A fossil preserving the activity of an organism." .

:BiologicalSpecimen a owl:Class ;
    rdfs:subClassOf :Specimen ;
    rdfs:label "Biological Specimen" ;
    rdfs:comment "A specimen of biological origin." .

:PlantSpecimen a owl:Class ;
    rdfs:subClassOf :BiologicalSpecimen ;
    rdfs:label "Plant Specimen" ;
    rdfs:comment "A specimen taken from a plant." .

:AnimalSpecimen a owl:Class ;
    rdfs:subClassOf :BiologicalSpecimen ;
    rdfs:label "Animal Specimen" ;
    rdfs:comment "A specimen taken from an animal." .

:TissueSample a owl:Class ;
    rdfs:subClassOf :BiologicalSpecimen ;
    rdfs:label "Tissue Sample" ;
    rdfs:comment "A portion of tissue prepared for analysis." .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Something that happens over a bounded interval." .

:CollectionEvent a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Collection Event" ;
    rdfs:comment "The act of collecting a specimen in the field." .

:PreparationEvent a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Preparation Event" ;
    rdfs:comment "The act of preparing a specimen for analysis." .

:AnalysisEvent a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Analysis Event" ;
    rdfs:comment "The act of analysing a specimen." .

:CurationEvent a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Curation Event" ;
    rdfs:comment "The act of accessioning or recuration." .

:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity capable of acting." .

:Person a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Person" ;
    rdfs:comment "An individual human agent." .

:Organisation a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Organisation" ;
    rdfs:comment "A collective agent." .

:Institution a owl:Class ;
    rdfs:subClassOf :Organisation ;
    rdfs:label "Institution" ;
    rdfs:comment "An organisation holding a collection." .

:ResearchGroup a owl:Class ;
    rdfs:subClassOf :Organisation ;
    rdfs:label "Research Group" ;
    rdfs:comment "An organisation carrying out research." .

:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A spatial region." .

:CollectionSite a owl:Class ;
    rdfs:subClassOf :Place ;
    rdfs:label "Collection Site" ;
    rdfs:comment "A place at which specimens were collected." .

:Repository a owl:Class ;
    rdfs:subClassOf :Place ;
    rdfs:label "Repository" ;
    rdfs:comment "A place at which specimens are stored." .

:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:comment "A prescribed way of carrying out an activity." .

:FieldMethod a owl:Class ;
    rdfs:subClassOf :Method ;
    rdfs:label "Field Method" ;
    rdfs:comment "A method applied in the field." .

:LaboratoryMethod a owl:Class ;
    rdfs:subClassOf :Method ;
    rdfs:label "Laboratory Method" ;
    rdfs:comment "A method applied in a laboratory." .

:MicroscopyMethod a owl:Class ;
    rdfs:subClassOf :LaboratoryMethod ;
    rdfs:label "Microscopy Method" ;
    rdfs:comment "A method based on optical or electron microscopy." .

:SpectroscopyMethod a owl:Class ;
    rdfs:subClassOf :LaboratoryMethod ;
    rdfs:label "Spectroscopy Method" ;
    rdfs:comment "A method based on spectral measurement." .

:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "A recorded quantitative determination." .

:MassMeasurement a owl:Class ;
    rdfs:subClassOf :Measurement ;
    rdfs:label "Mass Measurement" ;
    rdfs:comment "A determination of mass." .

:AgeMeasurement a owl:Class ;
    rdfs:subClassOf :Measurement ;
    rdfs:label "Age Measurement" ;
    rdfs:comment "A determination of age." .

:Unit a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:comment "A unit of measure." .

:collectedAt a owl:ObjectProperty ;
    rdfs:domain :CollectionEvent ;
    rdfs:range :CollectionSite ;
    rdfs:label "collected At" ;
    rdfs:comment "Relates a collection event to the site where it took place." .

:collectedBy a owl:ObjectProperty ;
    rdfs:domain :CollectionEvent ;
    rdfs:range :Agent ;
    rdfs:label "collected By" ;
    rdfs:comment "Relates a collection event to the agent who performed it." .

:yieldedSpecimen a owl:ObjectProperty ;
    rdfs:domain :CollectionEvent ;
    rdfs:range :Specimen ;
    rdfs:label "yielded Specimen" ;
    rdfs:comment "Relates a collection event to the specimen it produced." .

:preparedBy a owl:ObjectProperty ;
    rdfs:domain :PreparationEvent ;
    rdfs:range :Agent ;
    rdfs:label "prepared By" ;
    rdfs:comment "Relates a preparation event to the agent who performed it." .

:preparationOf a owl:ObjectProperty ;
    rdfs:domain :PreparationEvent ;
    rdfs:range :Specimen ;
    rdfs:label "preparation Of" ;
    rdfs:comment "Relates a preparation event to the specimen prepared." .

:analysisOf a owl:ObjectProperty ;
    rdfs:domain :AnalysisEvent ;
    rdfs:range :Specimen ;
    rdfs:label "analysis Of" ;
    rdfs:comment "Relates an analysis event to the specimen analysed." .

:usedMethod a owl:ObjectProperty ;
    rdfs:domain :AnalysisEvent ;
    rdfs:range :Method ;
    rdfs:label "used Method" ;
    rdfs:comment "Relates an analysis event to the method applied." .

:producedMeasurement a owl:ObjectProperty ;
    rdfs:domain :AnalysisEvent ;
    rdfs:range :Measurement ;
    rdfs:label "produced Measurement" ;
    rdfs:comment "Relates an analysis event to a measurement it produced." .

:measurementUnit a owl:ObjectProperty ;
    rdfs:domain :Measurement ;
    rdfs:range :Unit ;
    rdfs:label "measurement Unit" ;
    rdfs:comment "Relates a measurement to its unit of measure." .

:curatedBy a owl:ObjectProperty ;
    rdfs:domain :CurationEvent ;
    rdfs:range :Institution ;
    rdfs:label "curated By" ;
    rdfs:comment "Relates a curation event to the holding institution." .

:storedAt a owl:ObjectProperty ;
    rdfs:domain :Specimen ;
    rdfs:range :Repository ;
    rdfs:label "stored At" ;
    rdfs:comment "Relates a specimen to the repository holding it." .

:memberOf a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Organisation ;
    rdfs:label "member Of" ;
    rdfs:comment "Relates a person to an organisation they belong to." .

:derivedFrom a owl:ObjectProperty ;
    rdfs:domain :TissueSample ;
    rdfs:range :AnimalSpecimen ;
    rdfs:label "derived From" ;
    rdfs:comment "Relates a tissue sample to the organism it came from." .

:dominantMineral a owl:ObjectProperty ;
    rdfs:domain :RockSpecimen ;
    rdfs:range :MineralSpecimen ;
    rdfs:label "dominant Mineral" ;
    rdfs:comment "Relates a rock specimen to its dominant mineral phase." .

:hostRock a owl:ObjectProperty ;
    rdfs:domain :FossilSpecimen ;
    rdfs:range :SedimentaryRock ;
    rdfs:label "host Rock" ;
    rdfs:comment "Relates a fossil to the rock in which it is preserved." .

:siteLocatedIn a owl:ObjectProperty ;
    rdfs:domain :CollectionSite ;
    rdfs:range :Place ;
    rdfs:label "site Located In" ;
    rdfs:comment "Relates a collection site to a larger place containing it." .

:catalogueNumber a owl:DatatypeProperty ;
    rdfs:domain :Specimen ;
    rdfs:range xsd:string ;
    rdfs:label "catalogue Number" ;
    rdfs:comment "The catalogue number assigned to a specimen." .

:collectionDate a owl:DatatypeProperty ;
    rdfs:domain :CollectionEvent ;
    rdfs:range xsd:date ;
    rdfs:label "collection Date" ;
    rdfs:comment "The date on which collection took place." .

:measuredValue a owl:DatatypeProperty ;
    rdfs:domain :Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:label "measured Value" ;
    rdfs:comment "The numeric value of a measurement." .

:latitude a owl:DatatypeProperty ;
    rdfs:domain :CollectionSite ;
    rdfs:range xsd:decimal ;
    rdfs:label "latitude" ;
    rdfs:comment "The latitude of a collection site." .

:longitude a owl:DatatypeProperty ;
    rdfs:domain :CollectionSite ;
    rdfs:range xsd:decimal ;
    rdfs:label "longitude" ;
    rdfs:comment "The longitude of a collection site." .

:methodVersion a owl:DatatypeProperty ;
    rdfs:domain :Method ;
    rdfs:range xsd:string ;
    rdfs:label "method Version" ;
    rdfs:comment "The version identifier of a method." .

