@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:Everything a owl:Class ;
    rdfs:label "Everything" ;
    rdfs:comment "Root concept of the pattern." .

:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:subClassOf :Everything .

:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf :Everything .

:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:subClassOf :Everything .

:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf :Everything .

:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf :Everything .

:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:subClassOf :Everything .

:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:subClassOf :Everything .

:Reading a owl:Class ;
    rdfs:label "Reading" ;
    rdfs:subClassOf :Everything .

:Report a owl:Class ;
    rdfs:label "Report" ;
    rdfs:subClassOf :Everything .

:Method a owl:Class ;
    rdfs:label "Method" ;
    rdfs:subClassOf :Everything .

:Sample a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:subClassOf :Everything .

:Instrument a owl:Class ;
    rdfs:label "Instrument" ;
    rdfs:subClassOf :Everything .

