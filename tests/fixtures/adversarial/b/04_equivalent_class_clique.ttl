@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:Event a owl:Class ;
    rdfs:label "Event" .

:Occurrence a owl:Class ;
    rdfs:label "Occurrence" .

:Situation a owl:Class ;
    rdfs:label "Situation" .

:State a owl:Class ;
    rdfs:label "State" .

:Episode a owl:Class ;
    rdfs:label "Episode" .

:Happening a owl:Class ;
    rdfs:label "Happening" .

:Incident a owl:Class ;
    rdfs:label "Incident" .

:Phenomenon a owl:Class ;
    rdfs:label "Phenomenon" .

:describes a owl:ObjectProperty ;
    rdfs:label "describes" ;
    rdfs:domain :Event ;
    rdfs:range :Incident .

:Event owl:equivalentClass :Occurrence .
:Event owl:equivalentClass :Situation .
:Event owl:equivalentClass :State .
:Event owl:equivalentClass :Episode .
:Event owl:equivalentClass :Happening .
:Event owl:equivalentClass :Incident .
:Event owl:equivalentClass :Phenomenon .
:Occurrence owl:equivalentClass :Situation .
:Occurrence owl:equivalentClass :State .
:Occurrence owl:equivalentClass :Episode .
:Occurrence owl:equivalentClass :Happening .
:Occurrence owl:equivalentClass :Incident .
:Occurrence owl:equivalentClass :Phenomenon .
:Situation owl:equivalentClass :State .
:Situation owl:equivalentClass :Episode .
:Situation owl:equivalentClass :Happening .
:Situation owl:equivalentClass :Incident .
:Situation owl:equivalentClass :Phenomenon .
:State owl:equivalentClass :Episode .
:State owl:equivalentClass :Happening .
:State owl:equivalentClass :Incident .
:State owl:equivalentClass :Phenomenon .
:Episode owl:equivalentClass :Happening .
:Episode owl:equivalentClass :Incident .
:Episode owl:equivalentClass :Phenomenon .
:Happening owl:equivalentClass :Incident .
:Happening owl:equivalentClass :Phenomenon .
:Incident owl:equivalentClass :Phenomenon .
