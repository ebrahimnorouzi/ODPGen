@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

:Event a owl:Class ;
    rdfs:label "Event" .

:Person a owl:Class ;
    rdfs:label "Person" .

:Organisation a owl:Class ;
    rdfs:label "Organisation" .

:Location a owl:Class ;
    rdfs:label "Location" .

:Dataset a owl:Class ;
    rdfs:label "Dataset" .

:Policy a owl:Class ;
    rdfs:label "Policy" .

:Sensor a owl:Class ;
    rdfs:label "Sensor" .

:Reading a owl:Class ;
    rdfs:label "Reading" .

:Report a owl:Class ;
    rdfs:label "Report" .

:Method a owl:Class ;
    rdfs:label "Method" .

:Sample a owl:Class ;
    rdfs:label "Sample" .

:Instrument a owl:Class ;
    rdfs:label "Instrument" .

:Bottom a owl:Class ;
    rdfs:label "Bottom" ;
    rdfs:comment "Most specific concept of the pattern." ;
    rdfs:subClassOf :Event ,
                    :Person ,
                    :Organisation ,
                    :Location ,
                    :Dataset ,
                    :Policy ,
                    :Sensor ,
                    :Reading ,
                    :Report ,
                    :Method ,
                    :Sample ,
                    :Instrument .
