<http://example.org/odp> a owl:Ontology ;
    rdfs:label "Pattern for 2023-133-01" .

:AbstractEvent a owl:Class ;
    rdfs:label "abstract event" .

:CausalConnection a owl:Class ;
    rdfs:label "causal connection" .

:CausalDependency a owl:Class ;
    rdfs:label "causal dependency" .

:CausalEdge a owl:Class ;
    rdfs:label "causal edge" .

:CausalLink a owl:Class ;
    rdfs:label "causal link" .

:CausalRelation a owl:Class ;
    rdfs:label "causal relation" .

:CausalRelationship a owl:Class ;
    rdfs:label "causal relationship" .

:Causality a owl:Class ;
    rdfs:label "causality" .

:Cause a owl:Class ;
    rdfs:label "cause" .

:Causes a owl:Class ;
    rdfs:label "causes" .

:ConcreteEvent a owl:Class ;
    rdfs:label "concrete event" .

:Consequence a owl:Class ;
