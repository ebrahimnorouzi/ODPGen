:Situation a owl:Class ;
    rdfs:label "situation" .

:State a owl:Class ;
    rdfs:label "state" .

:cause a owl:ObjectProperty ;
    rdfs:label "cause" ;
    rdfs:domain :Event ,
                 :Occurrence ,
                 :Situation ,
                 :State ,
                 :Node ,
                 :AbstractEvent ,
                 :ConcreteEvent ;
    rdfs:range :Event ,
                :Occurrence ,
                :Situation ,
                :State ,
                :Node ,
                :AbstractEvent ,
                :ConcreteEvent ,
                :Outcome ,
                :Effect ,
                :Consequence ,
                :Result .

