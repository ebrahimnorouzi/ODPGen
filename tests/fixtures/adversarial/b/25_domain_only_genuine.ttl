@prefix ivr:  <https://example.org/odp/incidentreview#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Deliberately in the exact shape of published pattern 2025-151-01:
# one class, every property carrying an rdfs:domain that resolves to it,
# zero rdfs:range, zero rdfs:subClassOf, zero owl:Restriction.
# The published ODP has this shape; a measure that demands range coverage
# or subclass structure disqualifies a real pattern.

ivr:IncidentReview a owl:Class ;
    rdfs:label "Incident Review"@en ;
    rdfs:comment "A pattern describing the review of a reported incident by a responsible party, including what was reviewed, who reviewed it and the outcome reached."@en .

ivr:reviewedIncident a owl:ObjectProperty ;
    rdfs:domain ivr:IncidentReview ;
    rdfs:label "reviewed incident"@en ;
    rdfs:comment "Links a review to the incident under review."@en .

ivr:reviewingParty a owl:ObjectProperty ;
    rdfs:domain ivr:IncidentReview ;
    rdfs:label "reviewing party"@en ;
    rdfs:comment "Links a review to the party carrying it out."@en .

ivr:reviewOutcome a owl:ObjectProperty ;
    rdfs:domain ivr:IncidentReview ;
    rdfs:label "review outcome"@en ;
    rdfs:comment "Links a review to the determination it reached."@en .

ivr:reviewEvidence a owl:ObjectProperty ;
    rdfs:domain ivr:IncidentReview ;
    rdfs:label "review evidence"@en ;
    rdfs:comment "Links a review to the evidence considered during it."@en .

dcterms:issued a owl:DatatypeProperty ;
    rdfs:domain ivr:IncidentReview ;
    rdfs:label "issued"@en ;
    rdfs:comment "The date and time at which the review was issued."@en .
