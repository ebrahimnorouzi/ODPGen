@prefix :     <http://example.org/odp/agentrole#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A genuine, complete, deliberately tiny ODP: the classic n-ary role
# reification. Nine connective axioms. Nothing is missing from it -- it
# simply is a small pattern. A measure that caps it because it is short
# is committing failure mode E3.

:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "The reified holding of a role by an agent." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty :assignedAgent ;
        owl:someValuesFrom :Agent ] ,
      [ a owl:Restriction ;
        owl:onProperty :assignedRole ;
        owl:someValuesFrom :Role ] .

:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "Something capable of holding a role." .

:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A role an agent may hold within some context." .

:assignedAgent a owl:ObjectProperty ;
    rdfs:label "assigned agent" ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Agent .

:assignedRole a owl:ObjectProperty ;
    rdfs:label "assigned role" ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Role .
