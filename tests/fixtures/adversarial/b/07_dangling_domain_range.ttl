@prefix :     <http://example.org/odp#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/odp> a owl:Ontology ;
    rdfs:label "Relational Core Pattern" ;
    rdfs:comment "A richly typed relational pattern." .

:hasSubject a owl:ObjectProperty ;
    rdfs:label "hasSubject" ;
    rdfs:domain :DomainType00 ;
    rdfs:range :RangeType00 .

:hasObject a owl:ObjectProperty ;
    rdfs:label "hasObject" ;
    rdfs:domain :DomainType01 ;
    rdfs:range :RangeType01 .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext" ;
    rdfs:domain :DomainType02 ;
    rdfs:range :RangeType02 .

:hasQualifier a owl:ObjectProperty ;
    rdfs:label "hasQualifier" ;
    rdfs:domain :DomainType03 ;
    rdfs:range :RangeType03 .

:hasSource a owl:ObjectProperty ;
    rdfs:label "hasSource" ;
    rdfs:domain :DomainType04 ;
    rdfs:range :RangeType04 .

:hasTarget a owl:ObjectProperty ;
    rdfs:label "hasTarget" ;
    rdfs:domain :DomainType05 ;
    rdfs:range :RangeType05 .

:hasValue a owl:ObjectProperty ;
    rdfs:label "hasValue" ;
    rdfs:domain :DomainType06 ;
    rdfs:range :RangeType06 .

:hasUnit a owl:ObjectProperty ;
    rdfs:label "hasUnit" ;
    rdfs:domain :DomainType07 ;
    rdfs:range :RangeType07 .

:hasAgent a owl:ObjectProperty ;
    rdfs:label "hasAgent" ;
    rdfs:domain :DomainType08 ;
    rdfs:range :RangeType08 .

:hasPatient a owl:ObjectProperty ;
    rdfs:label "hasPatient" ;
    rdfs:domain :DomainType09 ;
    rdfs:range :RangeType09 .

:hasInstrument a owl:ObjectProperty ;
    rdfs:label "hasInstrument" ;
    rdfs:domain :DomainType10 ;
    rdfs:range :RangeType10 .

:hasResult a owl:ObjectProperty ;
    rdfs:label "hasResult" ;
    rdfs:domain :DomainType11 ;
    rdfs:range :RangeType11 .

