@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix c1: <http://example.org/copy1#> .
@prefix c2: <http://example.org/copy2#> .
@prefix c3: <http://example.org/copy3#> .

<http://example.org/copy1> a owl:Ontology ;
    rdfs:label "Sensor Reading Provenance Pattern" ;
    rdfs:comment "A small ODP relating a sensor reading to the sensor that produced it, the property observed and the time of observation." .

c1:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "A device that produces readings." .

c1:Reading a owl:Class ;
    rdfs:label "Reading" ;
    rdfs:comment "A single measured value produced by a sensor." ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty c1:producedBy ;
        owl:someValuesFrom c1:Sensor ] .

c1:ObservedProperty a owl:Class ;
    rdfs:label "Observed Property" ;
    rdfs:comment "The quality a reading quantifies." .

c1:CalibratedSensor a owl:Class ;
    rdfs:label "Calibrated Sensor" ;
    rdfs:subClassOf c1:Sensor ;
    rdfs:comment "A sensor with a valid calibration record." .

c1:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:domain c1:Reading ;
    rdfs:range c1:Sensor .

c1:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:domain c1:Reading ;
    rdfs:range c1:ObservedProperty .

c1:readingTime a owl:DatatypeProperty ;
    rdfs:label "reading time" ;
    rdfs:domain c1:Reading ;
    rdfs:range xsd:dateTime .

