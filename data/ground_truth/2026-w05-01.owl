<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/peo/"
     xml:base="https://w3id.org/peo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/peo">

    <terms:title xml:lang="en">
        PEO: An Ontology to Scaffold Prompt Engineering for Foundation Models
    </terms:title>

    <rdfs:comment xml:lang="en">
        Foundation models are revolutionizing artificial intelligence by enabling a wide variety of tasks to be solved effectively through prompting. However, designing effective prompts remains a major challenge, as the performance of foundation models is highly dependent on prompt quality. Although numerous scientific and web resources on prompt engineering are available, they are fragmented and rely on heterogeneous, non-interoperable data models, resulting in redundant and inconsistent knowledge silos. We propose PEO, an ontology that formalizes the domain of foundation models and prompt engineering to promote the interoperable representation and exchange of knowledge in this rapidly evolving field. PEO was engineered following the LOT ontology engineering methodology with the goal of supporting users in designing prompt-based solutions by identifying the most appropriate prompting techniques for a given task and foundation model. To this end, the ontology models the core concepts of the domain, including foundation models, tasks, prompting techniques, and chats documenting previous interactions with foundation models.
    </rdfs:comment>

    <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>

</owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- https://w3id.org/peo/dataModality -->

    <rdfs:Datatype rdf:about="https://w3id.org/peo/dataModality">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>audio</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>code</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>image</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>natural language</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>video</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/peo/adoptsSuitableTechniqueFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/adoptsSuitableTechniqueFor">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Prompt"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Task"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/peo/isAdoptedIn"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://w3id.org/peo/isConsideredSuitableFor"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/belongsToModelFamily -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/belongsToModelFamily">
        <owl:inverseOf rdf:resource="https://w3id.org/peo/hasFamilyMember"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/ModelFamily"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/directlyFollows -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/directlyFollows">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/peo/follows"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/follows -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/follows">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasArchitecture -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasArchitecture">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Architecture"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasConstraint -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasConstraint">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Constraint"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasEvolution -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasEvolution">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/peo/hasEvolutionAncestor"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/peo/hasVariant"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasEvolutionAncestor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasEvolutionAncestor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasFamilyMember -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasFamilyMember">
        <rdfs:domain rdf:resource="https://w3id.org/peo/ModelFamily"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasFirstPrompt -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasFirstPrompt">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/peo/hasMessage"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/Chat"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Prompt"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasMessage -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasMessage">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Chat"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/peo/hasMessage"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/peo/follows"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasOperator -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasOperator">
        <owl:inverseOf rdf:resource="https://w3id.org/peo/isOperatorOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Operator"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasSupportedDataModality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasSupportedDataModality">
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasTargetDataModality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasTargetDataModality">
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasValue -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasValue">
        <owl:inverseOf rdf:resource="https://w3id.org/peo/isValueOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Value"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasVariable -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariable">
        <owl:inverseOf rdf:resource="https://w3id.org/peo/isVariableOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Variable"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasVariant -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariant">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/peo/hasVariantAncestor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/hasVariantAncestor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariantAncestor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isAdoptedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isAdoptedIn">
        <rdfs:domain rdf:resource="https://w3id.org/peo/PromptingTechnique"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Prompt"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isConsideredSuitableFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isConsideredSuitableFor">
        <rdfs:domain rdf:resource="https://w3id.org/peo/PromptingTechnique"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Task"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isHeldWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isHeldWith">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Chat"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isInChatTargeting -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isInChatTargeting">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/peo/Task"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/peo/hasMessage"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://w3id.org/peo/targets"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isInChatWithFoundationModel -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isInChatWithFoundationModel">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                    <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/peo/hasMessage"/>
            </rdf:Description>
            <rdf:Description rdf:about="https://w3id.org/peo/isHeldWith"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isOperatorOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isOperatorOf">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Operator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isValueOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isValueOf">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Value"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/isVariableOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/isVariableOf">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/peo/targets -->

    <owl:ObjectProperty rdf:about="https://w3id.org/peo/targets">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Chat"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/Task"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/peo/constraintValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/constraintValue">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/modelFamily -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/modelFamily">
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/operator -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/operator">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/parametersNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/parametersNumber">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Architecture"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/releaseYear -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/releaseYear">
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/supportedDataModality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/supportedDataModality">
        <rdfs:domain rdf:resource="https://w3id.org/peo/FoundationModel"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/dataModality"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/targetDataModality -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/targetDataModality">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Task"/>
        <rdfs:range rdf:resource="https://w3id.org/peo/dataModality"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/peo/variable -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/peo/variable">
        <rdfs:domain rdf:resource="https://w3id.org/peo/Constraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/peo/Architecture -->

    <owl:Class rdf:about="https://w3id.org/peo/Architecture">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/parametersNumber"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        A neural network architecture adopted by a foundation model.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Architecture</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Chat -->

    <owl:Class rdf:about="https://w3id.org/peo/Chat">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/peo/isHeldWith"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/peo/FoundationModel"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/peo/isHeldWith"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/peo/FoundationModel"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasMessage"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
                            <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        An interaction with a foundation model consisting of prompts and responses and addressing a specific task.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Chat</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Constraint -->

    <owl:Class rdf:about="https://w3id.org/peo/Constraint">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasOperator"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/Operator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasValue"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/Value"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasVariable"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/Variable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        A condition associated with a task, defined by a variable, an operator, and a value.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Constraint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/DataModality -->

    <owl:Class rdf:about="https://w3id.org/peo/DataModality">
        <rdfs:comment xml:lang="en">A modality of data that can be processed by a foundation model or targeted by a task.</rdfs:comment>
        <rdfs:label xml:lang="en">Data modality</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/FoundationModel -->

    <owl:Class rdf:about="https://w3id.org/peo/FoundationModel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/belongsToModelFamily"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/ModelFamily"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasArchitecture"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/Architecture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasSupportedDataModality"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/DataModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasArchitecture"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/Architecture"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasEvolution"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/FoundationModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasSupportedDataModality"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/DataModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasVariant"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/FoundationModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/releaseYear"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        A deep learning model designed to process one or more data modalities and solve a variety of tasks through prompting.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Foundation model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/ModelFamily -->

    <owl:Class rdf:about="https://w3id.org/peo/ModelFamily">
        <rdfs:comment xml:lang="en">A family that groups related foundation models belonging to the same model lineage.</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Operator -->

    <owl:Class rdf:about="https://w3id.org/peo/Operator">
        <rdfs:comment xml:lang="en">An operator that specifies how a value is constrained with respect to a variable.</rdfs:comment>
        <rdfs:label xml:lang="en">Operator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Prompt -->

    <owl:Class rdf:about="https://w3id.org/peo/Prompt">
        <rdfs:comment xml:lang="en">
        A text submitted to a foundation model as part of an interaction.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Prompt</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/PromptingTechnique -->

    <owl:Class rdf:about="https://w3id.org/peo/PromptingTechnique">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/isAdoptedIn"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/Prompt"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/isConsideredSuitableFor"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        A technique that guides the definition of prompts for solving tasks with foundation models.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Prompting technique</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Response -->

    <owl:Class rdf:about="https://w3id.org/peo/Response">
        <rdfs:comment xml:lang="en">
        A response generated by a foundation model following a prompt.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Response</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Task -->

    <owl:Class rdf:about="https://w3id.org/peo/Task">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/hasConstraint"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/Constraint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/targetDataModality"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/dataModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/targetDataModality"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/peo/dataModality"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
        A problem to be solved on data of a specific modality and potentially subject to one or more constraints.
    </rdfs:comment>
        <rdfs:label xml:lang="en">Task</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Value -->

    <owl:Class rdf:about="https://w3id.org/peo/Value">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/peo/isValueOf"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A region representing a value involved in the specification of a constraint.</rdfs:comment>
        <rdfs:label xml:lang="en">Value</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/peo/Variable -->

    <owl:Class rdf:about="https://w3id.org/peo/Variable">
        <rdfs:comment xml:lang="en">A concept or parameter whose value is constrained by a constraint.</rdfs:comment>
        <rdfs:label xml:lang="en">Variable</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/peo/architecture1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/architecture1"/>
    


    <!-- https://w3id.org/peo/audio -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/audio">
        <rdf:type rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/chat1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/chat1">
        <rdf:type rdf:resource="https://w3id.org/peo/Chat"/>
        <hasFirstPrompt rdf:resource="https://w3id.org/peo/prompt1"/>
        <isHeldWith rdf:resource="https://w3id.org/peo/model"/>
        <targets rdf:resource="https://w3id.org/peo/task1"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/code -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/code">
        <rdf:type rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/constraint1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/constraint1"/>
    


    <!-- https://w3id.org/peo/image -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/image">
        <rdf:type rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/model -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/model">
        <hasArchitecture rdf:resource="https://w3id.org/peo/architecture1"/>
        <hasEvolution rdf:resource="https://w3id.org/peo/model2"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/model2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/model2"/>
    


    <!-- https://w3id.org/peo/model3 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/model3">
        <hasVariant rdf:resource="https://w3id.org/peo/model"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/natural_language -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/natural_language">
        <rdf:type rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/prompt1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/prompt1">
        <rdf:type rdf:resource="https://w3id.org/peo/Prompt"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/prompt2 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/prompt2">
        <rdf:type rdf:resource="https://w3id.org/peo/Prompt"/>
        <directlyFollows rdf:resource="https://w3id.org/peo/response1"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/prompting_technique1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/prompting_technique1">
        <isAdoptedIn rdf:resource="https://w3id.org/peo/prompt1"/>
        <isConsideredSuitableFor rdf:resource="https://w3id.org/peo/task1"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/response1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/response1">
        <rdf:type rdf:resource="https://w3id.org/peo/Response"/>
        <directlyFollows rdf:resource="https://w3id.org/peo/prompt1"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/task1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/task1">
        <hasConstraint rdf:resource="https://w3id.org/peo/constraint1"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/peo/video -->

    <owl:NamedIndividual rdf:about="https://w3id.org/peo/video">
        <rdf:type rdf:resource="https://w3id.org/peo/DataModality"/>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/peo/directlyFollows"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </owl:intersectionOf>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/peo/hasFirstPrompt"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/peo/Chat"/>
            </owl:Restriction>
        </owl:equivalentClass>
    </owl:Class>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/peo/Architecture"/>
            <rdf:Description rdf:about="https://w3id.org/peo/Chat"/>
            <rdf:Description rdf:about="https://w3id.org/peo/Constraint"/>
            <rdf:Description rdf:about="https://w3id.org/peo/FoundationModel"/>
            <rdf:Description rdf:about="https://w3id.org/peo/Prompt"/>
            <rdf:Description rdf:about="https://w3id.org/peo/Response"/>
            <rdf:Description rdf:about="https://w3id.org/peo/Task"/>
        </owl:members>
    </rdf:Description>
    
    
    <!-- adoptsSuitableTechniqueFor -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/adoptsSuitableTechniqueFor">
    <rdfs:label xml:lang="en">adopts suitable technique for</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a prompt to a task for which the prompt adopts a suitable prompting technique.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- belongsToModelFamily -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/belongsToModelFamily">
    <rdfs:label xml:lang="en">belongs to model family</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to the model family to which it belongs.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- directlyFollows -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/directlyFollows">
    <rdfs:label xml:lang="en">directly follows</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a message to the message that immediately precedes it in a chat.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- follows -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/follows">
    <rdfs:label xml:lang="en">follows</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a message to a preceding message in a chat.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasArchitecture -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasArchitecture">
    <rdfs:label xml:lang="en">has architecture</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to its architecture.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasConstraint -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasConstraint">
    <rdfs:label xml:lang="en">has constraint</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a task to a constraint associated with it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasEvolution -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasEvolution">
    <rdfs:label xml:lang="en">has evolution</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to another foundation model that is a direct evolution of it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasEvolutionAncestor -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasEvolutionAncestor">
    <rdfs:label xml:lang="en">has evolution ancestor</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to another foundation model from which it derives through one or more evolution relationships.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasFamilyMember -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasFamilyMember">
    <rdfs:label xml:lang="en">has family member</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a model family to a foundation model that belongs to it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasFirstPrompt -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasFirstPrompt">
    <rdfs:label xml:lang="en">has first prompt</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a chat to the prompt that initiates it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasMessage -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasMessage">
    <rdfs:label xml:lang="en">has message</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a chat to a prompt or response that is part of it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasOperator -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasOperator">
    <rdfs:label xml:lang="en">has operator</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates an entity to an operator involved in its specification.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasSupportedDataModality -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasSupportedDataModality">
    <rdfs:label xml:lang="en">has supported data modality</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to a data modality that it supports.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasTargetDataModality -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasTargetDataModality">
    <rdfs:label xml:lang="en">has target data modality</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates an entity to the data modality on which it is intended to operate.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasValue -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasValue">
    <rdfs:label xml:lang="en">has value</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates an entity to a value involved in its specification.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasVariable -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariable">
    <rdfs:label xml:lang="en">has variable</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates an entity to a variable involved in its specification.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasVariant -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariant">
    <rdfs:label xml:lang="en">has variant</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to another foundation model that is a direct variant of it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- hasVariantAncestor -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/hasVariantAncestor">
    <rdfs:label xml:lang="en">has variant ancestor</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a foundation model to another foundation model connected to it through one or more variant relationships.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isAdoptedIn -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isAdoptedIn">
    <rdfs:label xml:lang="en">is adopted in</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a prompting technique to a prompt that adopts it.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isConsideredSuitableFor -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isConsideredSuitableFor">
    <rdfs:label xml:lang="en">is considered suitable for</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a prompting technique to a task for which it is considered suitable.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isHeldWith -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isHeldWith">
    <rdfs:label xml:lang="en">is held with</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a chat to the foundation model with which it is conducted.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isInChatTargeting -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isInChatTargeting">
    <rdfs:label xml:lang="en">is in chat targeting</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a message to the task targeted by the chat in which the message occurs.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isInChatWithFoundationModel -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isInChatWithFoundationModel">
    <rdfs:label xml:lang="en">is in chat with foundation model</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a message to the foundation model involved in the chat in which the message occurs.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isOperatorOf -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isOperatorOf">
    <rdfs:label xml:lang="en">is operator of</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates an operator to an entity whose specification involves that operator.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isValueOf -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isValueOf">
    <rdfs:label xml:lang="en">is value of</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a value to an entity whose specification involves that value.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- isVariableOf -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/isVariableOf">
    <rdfs:label xml:lang="en">is variable of</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a variable to an entity whose specification involves that variable.
    </rdfs:comment>
</owl:ObjectProperty>


<!-- targets -->

<owl:ObjectProperty rdf:about="https://w3id.org/peo/targets">
    <rdfs:label xml:lang="en">targets</rdfs:label>
    <rdfs:comment xml:lang="en">
        Relates a chat to the task it addresses.
    </rdfs:comment>
</owl:ObjectProperty>

<!-- constraintValue -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/constraintValue">
    <rdfs:label xml:lang="en">constraint value</rdfs:label>
    <rdfs:comment xml:lang="en">
        Associates a constraint with the value involved in its specification.
    </rdfs:comment>
</owl:DatatypeProperty>


<!-- modelFamily -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/modelFamily">
    <rdfs:label xml:lang="en">model family</rdfs:label>
    <rdfs:comment xml:lang="en">
        Associates a foundation model with the model family to which it belongs.
    </rdfs:comment>
</owl:DatatypeProperty>


<!-- operator -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/operator">
    <rdfs:label xml:lang="en">operator</rdfs:label>
    <rdfs:comment xml:lang="en">
        Associates a constraint with the operator involved in its specification.
    </rdfs:comment>
</owl:DatatypeProperty>


<!-- parametersNumber -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/parametersNumber">
    <rdfs:label xml:lang="en">number of parameters</rdfs:label>
    <rdfs:comment xml:lang="en">
        Specifies the number of parameters of an architecture.
    </rdfs:comment>
</owl:DatatypeProperty>


<!-- releaseYear -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/releaseYear">
    <rdfs:label xml:lang="en">release year</rdfs:label>
    <rdfs:comment xml:lang="en">
        Specifies the year in which a foundation model was released.
    </rdfs:comment>
</owl:DatatypeProperty>


<!-- supportedDataModality -->

<owl:DatatypeProperty rdf:about="https://w3id.org/peo/supportedDataModality">
    <rdfs:label xml:lang="en">supported data modality</rdfs:label>
    <rdfs:comment xml:lang="en">
