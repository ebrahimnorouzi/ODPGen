<?xml version="1.0"?>
<rdf:RDF xmlns="https://burbachs.github.io/WISDOM/wisdom.owl#"
     xml:base="https://burbachs.github.io/WISDOM/wisdom.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dtype="http://www.linkedmodel.org/schema/dtype#"
     xmlns:schema="https://schema.org/"
     xmlns:wisdom="https://burbachs.github.io/WISDOM/wisdom.owl#"
     xmlns:schema1="http://schema.org/">
    <owl:Ontology rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl">
        <owl:imports rdf:resource="http://qudt.org/3.0.0/schema/qudt"/>
        <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/sosa/"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/ssn/"/>
        <dct:bibliographicCitation>Lennart Mackert, Simon Burbach, Paul Schreiber, Maria Maleshkova (2026): WISDOM. https://doi.org/10.5281/zenodo.21677141</dct:bibliographicCitation>
        <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-14</dct:created>
        <dct:creator>
            <rdf:Description>
                <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
                <foaf:homepage rdf:resource="https://orcid.org/0009-0006-7138-7902"/>
                <foaf:mbox rdf:resource="mailto:lennart.mackert@hsu-hh.de"/>
                <foaf:name>Lennart Mackert</foaf:name>
            </rdf:Description>
        </dct:creator>
        <dct:creator>
            <rdf:Description>
                <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
                <foaf:homepage rdf:resource="https://orcid.org/0009-0009-8373-6622"/>
                <foaf:mbox rdf:resource="mailto:burbachs@hsu-hh.de"/>
                <foaf:name>Simon Burbach</foaf:name>
            </rdf:Description>
        </dct:creator>
        <dct:creator>
            <rdf:Description>
                <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
                <foaf:homepage rdf:resource="https://orcid.org/0009-0009-5585-2183"/>
                <foaf:mbox rdf:resource="mailto:schreibp@hsu-hh.de"/>
                <foaf:name>Paul Schreiber</foaf:name>
            </rdf:Description>
        </dct:creator>
        <dct:creator>
            <rdf:Description>
                <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
                <foaf:homepage rdf:resource="https://orcid.org/0000-0003-3458-4748"/>
                <foaf:mbox rdf:resource="mailto:maleshkm@hsu-hh.de"/>
                <foaf:name>Maria Maleshkova</foaf:name>
            </rdf:Description>
        </dct:creator>
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:title>WISDOM: A Wearable Integrated Stress Data Ontology Model</dct:title>
        <bibo:doi>10.5281/zenodo.21677141</bibo:doi>
        <rdfs:comment xml:lang="en">The WISDOM (Wearable Integrated Stress Data Ontology Model) ontology provides a semantic model for representing stress-related knowledge and physiological data collected from wearable devices. It integrates conceptual descriptions of human stress, stress-inducing stimuli, experimental context, wearable sensors, physiological observables, and their corresponding observations into a machine-interpretable knowledge graph. By building upon established semantic web standards, WISDOM enables the harmonization and integration of heterogeneous stress datasets while preserving contextual information about study protocols, stressors, and sensor measurements. The ontology supports interoperability, data integration, advanced analytics, and reproducible research in wearable-based stress detection.</rdfs:comment>
        <rdfs:label xml:lang="en">WISDOM</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/ontology/bibo/doi -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/doi"/>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- http://xmlns.com/foaf/0.1/mbox -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/mbox"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/sosa/hosts -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hosts">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/sosa/isObservedBy -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/isObservedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/sosa/madeObservation -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/madeObservation">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/sosa/observes -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/observes">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </rdf:Description>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#annotatedDuringActivity -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#annotatedDuringActivity">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotatedInRecord"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:comment xml:lang="en">Links an annotation record to the activity or experimental segment that it annotates.</rdfs:comment>
        <rdfs:label xml:lang="en">annotated during activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#causes -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#causes">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isCausedBy"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#StressResponse"/>
        <rdfs:comment xml:lang="en">Links a stressor to an entity that it causes or contributes to.</rdfs:comment>
        <rdfs:label xml:lang="en">causes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasActivityObservation -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasActivityObservation">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#observedDuringActivity"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Links an activity or experimental phase to an observation made during that activity.</rdfs:comment>
        <rdfs:label xml:lang="en">has activity observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationRecord -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationRecord">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotationRecordOf"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:comment xml:lang="en">Links a physiological record to its annotation record.</rdfs:comment>
        <rdfs:label xml:lang="en">has annotation record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedActivity -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedActivity">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedStressor"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:comment xml:lang="en">Links a stressor to the activity or experimental phase associated with it.</rdfs:comment>
        <rdfs:label xml:lang="en">has associated activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedStressor -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedStressor">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:comment xml:lang="en">Links a stress-inducing activity or experimental phase to its associated stressor.</rdfs:comment>
        <rdfs:label xml:lang="en">has associated stressor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasPhysiologicalRecord -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasPhysiologicalRecord">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isPhysiologicalRecordOf"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Subject"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:comment xml:lang="en">Links a study subject to a physiological record containing measurements collected from that subject.</rdfs:comment>
        <rdfs:label xml:lang="en">has physiological record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasSignalChannel -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasSignalChannel">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isSignalChannelOf"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:comment xml:lang="en">Links a physiological record to one of its signal channels.</rdfs:comment>
        <rdfs:label xml:lang="en">has signal channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceChannel -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceChannel">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isSourceChannelOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:comment xml:lang="en">Links an observation to the signal channel from which it was derived.</rdfs:comment>
        <rdfs:label xml:lang="en">has source channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceRecord -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasSourceRecord">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isSourceRecordOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:comment xml:lang="en">Links an observation to the physiological record from which it was derived.</rdfs:comment>
        <rdfs:label xml:lang="en">has source record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasStressCondition -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasStressCondition">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#isStressConditionOf"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#StressCondition"/>
        <rdfs:comment xml:lang="en">Links an activity or experimental phase to the stress condition represented during that phase.</rdfs:comment>
        <rdfs:label xml:lang="en">has stress condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotatedInRecord -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotatedInRecord">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:comment xml:lang="en">Links an activity or experimental segment to the annotation record in which it is annotated.</rdfs:comment>
        <rdfs:label xml:lang="en">is annotated by record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotationRecordOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isAnnotationRecordOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:comment xml:lang="en">Links an annotation record to the physiological record it annotates.</rdfs:comment>
        <rdfs:label xml:lang="en">is annotation record of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isCausedBy -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isCausedBy">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#StressResponse"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:comment xml:lang="en">Links an entity to a stressor that causes or contributes to it.</rdfs:comment>
        <rdfs:label xml:lang="en">is caused by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isPhysiologicalRecordOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isPhysiologicalRecordOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Subject"/>
        <rdfs:comment xml:lang="en">Links a physiological record to the study subject from whom its measurements were collected.</rdfs:comment>
        <rdfs:label xml:lang="en">is physiological record of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isRepresentedBySignalChannel -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isRepresentedBySignalChannel">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#representsObservableProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:comment xml:lang="en">Links an observable property to a signal channel representing it.</rdfs:comment>
        <rdfs:label xml:lang="en">is represented by signal channel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isSignalChannelOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isSignalChannelOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:comment xml:lang="en">Links a signal channel to its physiological record.</rdfs:comment>
        <rdfs:label xml:lang="en">is signal channel of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isSourceChannelOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isSourceChannelOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Links a signal channel to an observation derived from it.</rdfs:comment>
        <rdfs:label xml:lang="en">is source channel of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isSourceRecordOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isSourceRecordOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="en">Links a physiological record to an observation derived from it.</rdfs:comment>
        <rdfs:label xml:lang="en">is source record of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#isStressConditionOf -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#isStressConditionOf">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#StressCondition"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:comment xml:lang="en">Links a stress condition to an activity or experimental phase in which it is represented.</rdfs:comment>
        <rdfs:label xml:lang="en">is stress condition of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#madeAnnotationRecord -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#madeAnnotationRecord">
        <owl:inverseOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#wasMadeByObserver"/>
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#HumanObserver"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:comment xml:lang="en">Links a human observer to an annotation record made by that observer.</rdfs:comment>
        <rdfs:label xml:lang="en">made annotation record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#madeByBiomarkerAssay -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#madeByBiomarkerAssay">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#BiomarkerAssay"/>
        <rdfs:comment xml:lang="en">Links an observation to the biomarker assay by which it was made.</rdfs:comment>
        <rdfs:label xml:lang="en">made by biomarker assay</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#madeByObserver -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#madeByObserver">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#HumanObserver"/>
        <rdfs:comment xml:lang="en">Links an observation to the human observer by whom it was made.</rdfs:comment>
        <rdfs:label xml:lang="en">made by observer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#observedDuringActivity -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#observedDuringActivity">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:comment xml:lang="en">Links an observation to the activity or experimental phase during which it was made.</rdfs:comment>
        <rdfs:label xml:lang="en">observed during activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#representsObservableProperty -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#representsObservableProperty">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">Links a signal channel to the observable property represented by the channel.</rdfs:comment>
        <rdfs:label xml:lang="en">represents observable property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#wasMadeByObserver -->

    <owl:ObjectProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#wasMadeByObserver">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:range rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#HumanObserver"/>
        <rdfs:comment xml:lang="en">Links an annotation record to the human observer by whom it was made.</rdfs:comment>
        <rdfs:label xml:lang="en">was made by observer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/ns/sosa/resultTime -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The instant of time when an observation was completed and its result became available.</rdfs:comment>
        <rdfs:label xml:lang="en">result time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#ageAtAssessment -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#ageAtAssessment">
        <rdfs:domain rdf:resource="https://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">The age of a person in completed years at the time of measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">age at assessment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationTimeStamp -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasAnnotationTimeStamp">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">Timestamp associated with an Annotation Record made by a Human Observer during a stress experiment</rdfs:comment>
        <rdfs:label xml:lang="en">has annotation time stamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasAssayTimeStamp -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasAssayTimeStamp">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#BiomarkerAssay"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">Timestamp indicating when a biomarker assay was performed or recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">has assay time stamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasChannelName -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasChannelName">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of a signal channel.</rdfs:comment>
        <rdfs:label xml:lang="en">has channel name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasDescription -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasDescription">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The description of an activity made by the experimenter observer.</rdfs:comment>
        <rdfs:label xml:lang="en">has description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasFileFormat -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasFileFormat">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The file format of the physiological record.</rdfs:comment>
        <rdfs:label xml:lang="en">has file format</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasFileName -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasFileName">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The file name of the physiological record.</rdfs:comment>
        <rdfs:label xml:lang="en">has file name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasIntensity -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasIntensity">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Qualitative intensity of an activity or experimental phase, for example low, moderate, or high.</rdfs:comment>
        <rdfs:label xml:lang="en">has intensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasNote -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasNote">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A note associated with an annotation record made by a human observer during a stress experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">has note</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfChannels -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfChannels">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of signal channels in a physiological record.</rdfs:comment>
        <rdfs:label xml:lang="en">has number of channels</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfSamples -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasNumberOfSamples">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of samples in a physiological record.</rdfs:comment>
        <rdfs:label xml:lang="en">has number of samples</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasReference -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasReference">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Describes whether a certain activity is linked to an established concept. For example, an activity could reference to an established sports assessment or psychological stressor such as the Trier Social Stress Test</rdfs:comment>
        <rdfs:label xml:lang="en">has Reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#hasSamplingFrequency -->

    <owl:DatatypeProperty rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#hasSamplingFrequency">
        <rdfs:domain rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#SignalChannel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Sampling frequency of a signal channel.</rdfs:comment>
        <rdfs:label xml:lang="en">has sampling frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/Unit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit"/>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person"/>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationX -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationX">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"/>
        <rdfs:comment xml:lang="en">Acceleration along the x-axis as a physiological or movement-related observable property.</rdfs:comment>
        <rdfs:label xml:lang="en">AccelerationX</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationY -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationY">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"/>
        <rdfs:comment xml:lang="en">Acceleration along the y-axis as a physiological or movement-related observable property.</rdfs:comment>
        <rdfs:label xml:lang="en">AccelerationY</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationZ -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationZ">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"/>
        <rdfs:comment xml:lang="en">Acceleration along the z-axis as a physiological or movement-related observable property.</rdfs:comment>
        <rdfs:label xml:lang="en">AccelerationZ</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#Accelerometer -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#Accelerometer">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#MotionSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationX"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationY"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AccelerationZ"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A three-axis motion sensor used to measure acceleration along the x, y, and z axes.</rdfs:comment>
        <rdfs:label xml:lang="en">Accelerometer</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#Activity -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#Activity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Interval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An activity or experimental phase with a temporal extent that can provide context for observations in a stress experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AcuteStressor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AcuteStressor">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:comment xml:lang="en">A stressor that triggers an immediate or short-term physiological or psychological stress response.</rdfs:comment>
        <rdfs:label xml:lang="en">Acute Stressor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AnnotationRecord">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">A file or record containing annotations for phases in a stress experiment. Its temporal context can be represented using time:hasTime with an OWL-Time instant or interval.</rdfs:comment>
        <rdfs:label xml:lang="en">AnnotationRecord</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#AudioSensor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#AudioSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">An audio-based sensor that can produce acoustic or speech-related observations in stress experiments.</rdfs:comment>
        <rdfs:label xml:lang="en">Audio Sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#Baseline -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#Baseline">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#hasStressCondition"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#BaselineCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An initial no-stress reference phase that usually occurs before stress-inducing phases.</rdfs:comment>
        <rdfs:label xml:lang="en">Baseline</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#BaselineCondition -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#BaselineCondition">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#NoStressCondition"/>
        <rdfs:comment xml:lang="en">A no-stress condition representing an initial baseline or reference state before stress-inducing phases.</rdfs:comment>
        <rdfs:label xml:lang="en">Baseline Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#BehavioralProperty -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#BehavioralProperty">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">A property describing observable behavioral characteristics or activities of an individual.</rdfs:comment>
        <rdfs:label xml:lang="en">Behavioral Property</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#BiomarkerAssay -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#BiomarkerAssay">
        <rdfs:comment xml:lang="en">A biomarker assay, such as a blood sample analysis for cortisol or adrenaline. Its temporal context can be represented using time:hasTime with an OWL-Time instant or interval.</rdfs:comment>
        <rdfs:label xml:lang="en">Biomarker Assay</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#BloodOxygenSaturation -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#BloodOxygenSaturation">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"/>
        <rdfs:comment xml:lang="en">Peripheral oxygen saturation as a physiological observable property.</rdfs:comment>
        <rdfs:label xml:lang="en">BloodOxygenSaturation</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#CameraSensor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#CameraSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">A camera-based sensor that can produce visual observations in stress experiments.</rdfs:comment>
        <rdfs:label xml:lang="en">Camera Sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#ChronicStressor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#ChronicStressor">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Stressor"/>
        <rdfs:comment xml:lang="en">A stressor that persists or recurs over an extended period and contributes to long-term stress exposure.</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic Stressor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#CognitiveStressPhase -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#CognitiveStressPhase">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#hasAssociatedStressor"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#CognitiveStressor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A phase labeled as cognitive stress.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Stress Phase</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#CognitiveStressor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#CognitiveStressor">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#AcuteStressor"/>
        <rdfs:comment xml:lang="en">An acute stressor associated with cognitive stress tasks or phases.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Stressor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#EDASensor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#EDASensor">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#ElectrodermalActivity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A physiological sensor used to measure electrodermal activity.</rdfs:comment>
        <rdfs:label xml:lang="en">EDA Sensor</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#ElectrodermalActivity -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#ElectrodermalActivity">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#PhysiologicalProperty"/>
        <rdfs:comment xml:lang="en">Electrodermal activity as a physiological observable property.</rdfs:comment>
        <rdfs:label xml:lang="en">ElectrodermalActivity</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#Environment -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#Environment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>An environment that is prevailing to an experimental segment that can provide context for observations in a stress experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#EnvironmentalProperty -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#EnvironmentalProperty">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">A property describing environmental conditions or external factors that may influence an individual&apos;s stress response.</rdfs:comment>
        <rdfs:label xml:lang="en">Environmental Property</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#ExperimenterObserver -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#ExperimenterObserver">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#HumanObserver"/>
        <rdfs:comment xml:lang="en">An experimenter who records observations during a stress experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment Observer</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#Gesture -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#Gesture">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#BehavioralProperty"/>
        <rdfs:comment>Gestures a subjects does while being observed</rdfs:comment>
        <rdfs:label>Gesture</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#GyroSensor -->

    <owl:Class rdf:about="https://burbachs.github.io/WISDOM/wisdom.owl#GyroSensor">
        <rdfs:subClassOf rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#MotionSensor"/>
