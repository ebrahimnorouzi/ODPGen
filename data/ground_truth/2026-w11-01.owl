                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observes"/>
                <owl:someValuesFrom rdf:resource="https://burbachs.github.io/WISDOM/wisdom.owl#HeartRateVariability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A physiological sensor based on photoplethysmography that is used in the ontology to observe heart rate, heart rate variability, and blood oxygen saturation.</rdfs:comment>
        <rdfs:label xml:lang="en">PPG Sensor</rdfs:label>
    </owl:Class>
    


