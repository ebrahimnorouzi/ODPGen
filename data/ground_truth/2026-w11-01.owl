        <rdfs:comment xml:lang="en">A no-stress condition representing relaxation or recovery between stress-inducing phases.</rdfs:comment>
        <rdfs:label xml:lang="en">Relaxation Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#RelaxationPhase -->

