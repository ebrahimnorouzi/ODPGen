            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A no-stress relaxation or recovery phase that can occur between stress-inducing phases.</rdfs:comment>
        <rdfs:label xml:lang="en">Relaxation Phase</rdfs:label>
