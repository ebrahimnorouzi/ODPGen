            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A phase labeled as physical stress.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Stress Phase</rdfs:label>
    </owl:Class>
    


    <!-- https://burbachs.github.io/WISDOM/wisdom.owl#PhysicalStressor -->

