<http://qudt.org/schema/qudt#numericValue> rdf:type owl:DatatypeProperty .


###  https://w3id.org/lcanet/core#lcaModelHasGoal
:lcaModelHasGoal rdf:type owl:DatatypeProperty ;
                 rdfs:domain :LcaModel ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The lcaModelHasGoal data property represents the objective of the LCA study, defined as a textual description that specifies the intended purpose and use of the LCA results." ;
                 rdfs:label "lca Model Has Goal" .


###  https://w3id.org/lcanet/core#lcaModelHasId
:lcaModelHasId rdf:type owl:DatatypeProperty ;
               rdfs:domain :LcaModel ;
               rdfs:range xsd:string ;
               rdfs:label "lca Model Has Id" .


