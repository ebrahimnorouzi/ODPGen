:scopeHasAssumption rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Scope ;
                    rdfs:range xsd:string ;
                    rdfs:label "scope Has Assumption" .


###  https://w3id.org/lcanet/core#scopeHasFunctionalUnit
:scopeHasFunctionalUnit rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Scope ;
                        rdfs:range xsd:string ;
                        rdfs:label "scope Has Functional Unit" .


###  https://w3id.org/lcanet/core#scopeHasSystemBoundary
:scopeHasSystemBoundary rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Scope ;
                        rdfs:range xsd:string ;
                        rdfs:label "Scope Has System Boundary" .


