@prefix : <https://w3id.org/lcanet/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/lcanet/core#> .

<https://w3id.org/lcanet/core> rdf:type owl:Ontology ;
                                owl:versionIRI <https://w3id.org/lcanet/core/2.2.0> ;
                                owl:imports <https://w3id.org/lcanet/activity> ,
                                            <https://w3id.org/lcanet/actor> ,
                                            <https://w3id.org/lcanet/ia> ,
                                            <https://w3id.org/lcanet/property> ,
                                            <https://w3id.org/lcanet/st> ;
                                <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-4553-3930> ,
                                                                       <https://orcid.org/0000-0003-3896-7295> ,
                                                                       <https://orcid.org/0009-0002-7928-9902> ,
                                                                       "Emmanuelle Core" ;
                                <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0438-6831> ;
                                <http://purl.org/dc/terms/description> """The Core module is the central module of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It defines the basic elements of a LCA study based on ISO 14040 and ISO 14044 such as the goal, scope, etc. 
            It also imports and links the other LCAnet ontology modules (Activity, Actor, Property, Spatiotemporal, and Impact Assessment)
            providing an integration layer between the modules.
            Thus, it serves as a semantic backbone for consistent modeling and reasoning over LCA knowledge.""" ;
                                <http://purl.org/dc/terms/issued> "2026-05-20"^^xsd:date ;
                                <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                <http://purl.org/dc/terms/publisher> <https://www.cea.fr> ;
                                <http://purl.org/dc/terms/title> "The Core module of the Life Cycle Assessment Network Ontology (LCAnet)."@en ;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "core" ;
                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/lcanet/core#" ;
                                rdfs:comment """This ontology imports:
            - Activity module: https://w3id.org/lcanet/activity#
            - Actor module: https://w3id.org/lcanet/actor#
            - Impact Assessment module: https://w3id.org/lcanet/ia#
            - Property module: https://w3id.org/lcanet/property#
            - Spatiotemporal module: https://w3id.org/lcanet/st#
        """ ;
                                rdfs:label "LCAnet-Core" ;
                                owl:priorVersion "2.1.0" ;
                                owl:versionInfo "2.2.0" .

