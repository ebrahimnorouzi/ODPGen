#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/lcanet/core#activityBelongsToLCstage
:activityBelongsToLCstage rdf:type owl:ObjectProperty ;
                          rdfs:domain <https://w3id.org/lcanet/activity#Activity> ;
                          rdfs:range :LifeCycleStage ;
                          rdfs:label "activity belongs to LC stage" .


###  https://w3id.org/lcanet/core#activityHasImpactResult
:activityHasImpactResult rdf:type owl:ObjectProperty ;
                         owl:inverseOf :impactResultConcernsActivity ;
                         rdfs:domain <https://w3id.org/lcanet/activity#Activity> ;
                         rdfs:range <https://w3id.org/lcanet/ia#LcaResult> ;
                         rdfs:label "activity has Impact Result" .


###  https://w3id.org/lcanet/core#flowHasImpactResult
:flowHasImpactResult rdf:type owl:ObjectProperty ;
                     owl:inverseOf :impactResultConcernsFlow ;
                     rdfs:domain <https://w3id.org/lcanet/activity#Flow> ;
                     rdfs:range <https://w3id.org/lcanet/ia#LcaResult> ;
                     rdfs:label "flow has Impact Result" .


###  https://w3id.org/lcanet/core#hasFlowCategory
:hasFlowCategory rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( <https://w3id.org/lcanet/ia#LcaResult>
                                             <https://w3id.org/lcanet/ia#OverallImpactResult>
                                           )
                             ] ;
                 rdfs:range <https://w3id.org/lcanet/activity#FlowTag> ;
                 rdfs:label "has Flow Category" .


###  https://w3id.org/lcanet/core#hasProperty
:hasProperty rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( <https://w3id.org/lcanet/activity#Activity>
                                         <https://w3id.org/lcanet/activity#Flow>
                                         <https://w3id.org/lcanet/actor#Agent>
                                         :LcaModel
                                       )
                         ] ;
             rdfs:range <https://w3id.org/lcanet/property#Property> ;
             rdfs:label "has Property" .


###  https://w3id.org/lcanet/core#hasSpatialAspect
:hasSpatialAspect rdf:type owl:ObjectProperty ;
                  rdfs:domain <https://w3id.org/lcanet/activity#Activity> ;
                  rdfs:range <https://w3id.org/lcanet/st#Location> ;
                  rdfs:label "has Spatial Aspect" .


###  https://w3id.org/lcanet/core#hasTemporalAspect
:hasTemporalAspect rdf:type owl:ObjectProperty ;
                   rdfs:domain <https://w3id.org/lcanet/activity#Activity> ;
                   rdfs:range <http://www.w3.org/2006/time#TemporalEntity> ;
                   rdfs:label "has Temporal Aspect" .


###  https://w3id.org/lcanet/core#impactResultConcernsActivity
:impactResultConcernsActivity rdf:type owl:ObjectProperty ;
                              rdfs:domain <https://w3id.org/lcanet/ia#LcaResult> ;
                              rdfs:range <https://w3id.org/lcanet/activity#Activity> ;
                              rdfs:label "impact Result Concerns Activity" .


###  https://w3id.org/lcanet/core#impactResultConcernsFlow
:impactResultConcernsFlow rdf:type owl:ObjectProperty ;
                          rdfs:domain <https://w3id.org/lcanet/ia#LcaResult> ;
                          rdfs:range <https://w3id.org/lcanet/activity#Flow> ;
                          rdfs:label "impact Result Concerns Flow" .


###  https://w3id.org/lcanet/core#interpretationContainsOIR
:interpretationContainsOIR rdf:type owl:ObjectProperty ;
                           rdfs:domain :Interpretation ;
                           rdfs:range <https://w3id.org/lcanet/ia#OverallImpactResult> ;
                           rdfs:label "interpretation contains OIR" .


###  https://w3id.org/lcanet/core#interpretationDefinedBy
:interpretationDefinedBy rdf:type owl:ObjectProperty ;
                         rdfs:domain :Interpretation ;
                         rdfs:range <https://w3id.org/lcanet/actor#Agent> ;
                         rdfs:label "interpretation defined by" .


###  https://w3id.org/lcanet/core#lcaModeHasScope
:lcaModeHasScope rdf:type owl:ObjectProperty ;
                 rdfs:domain :LcaModel ;
                 rdfs:range :Scope ;
                 rdfs:label "lca model has scope" .


###  https://w3id.org/lcanet/core#lcaModelConcernsLCStage
:lcaModelConcernsLCStage rdf:type owl:ObjectProperty ;
                         rdfs:domain :LcaModel ;
                         rdfs:range :LifeCycleStage ;
                         rdfs:label "lca model concerns LC stage" .


###  https://w3id.org/lcanet/core#lcaModelHasAuthor
:lcaModelHasAuthor rdf:type owl:ObjectProperty ;
                   rdfs:domain :LcaModel ;
                   rdfs:range <https://w3id.org/lcanet/actor#Agent> ;
                   rdfs:label "lca model has author" .


###  https://w3id.org/lcanet/core#lcaModelResultsInInterpretation
:lcaModelResultsInInterpretation rdf:type owl:ObjectProperty ;
                                 rdfs:domain :LcaModel ;
                                 rdfs:range :Interpretation ;
                                 rdfs:label "lca model results in interpretation" .


###  https://w3id.org/lcanet/core#methodologyAssessesTopic
:methodologyAssessesTopic rdf:type owl:ObjectProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( <https://w3id.org/lcanet/ia#Method>
                                                      <https://w3id.org/lcanet/ia#Methodology>
                                                    )
                                      ] ;
                          rdfs:range :Scope ;
                          rdfs:label "methodology assesses topic" .


###  https://w3id.org/lcanet/core#realizedBy
:realizedBy rdf:type owl:ObjectProperty ;
            owl:inverseOf :realizesActivity ;
            rdfs:domain <https://w3id.org/lcanet/activity#Activity> ;
            rdfs:range <https://w3id.org/lcanet/actor#Agent> ;
            rdfs:label "realized by" .


###  https://w3id.org/lcanet/core#realizesActivity
:realizesActivity rdf:type owl:ObjectProperty ;
                  rdfs:domain <https://w3id.org/lcanet/actor#Agent> ;
                  rdfs:range <https://w3id.org/lcanet/activity#Activity> ;
                  rdfs:label "realizes activity" .


###  https://w3id.org/lcanet/core#scopeDefinedBy
:scopeDefinedBy rdf:type owl:ObjectProperty ;
                rdfs:domain :Scope ;
                rdfs:range <https://w3id.org/lcanet/actor#Agent> ;
                rdfs:label "scope defined by" .


###  https://w3id.org/lcanet/core#scopeHasReferenceFlow
:scopeHasReferenceFlow rdf:type owl:ObjectProperty ;
                       rdfs:domain :Scope ;
                       rdfs:range <https://w3id.org/lcanet/activity#ProductFlow> ;
                       rdfs:label "scope has reference flow" .


###  https://w3id.org/lcanet/core#scopeHasSpatialScale
:scopeHasSpatialScale rdf:type owl:ObjectProperty ;
                      rdfs:domain :Scope ;
                      rdfs:range <https://w3id.org/lcanet/st#SpatialScale> ;
                      rdfs:label "scope has spatial scale" .


###  https://w3id.org/lcanet/core#scopeHasTemporalScale
:scopeHasTemporalScale rdf:type owl:ObjectProperty ;
                       rdfs:domain :Scope ;
                       rdfs:range <http://www.w3.org/2006/time#TemporalEntity> ;
                       rdfs:label "scope has temporal scale" .


###  https://w3id.org/lcanet/core#usedBy
:usedBy rdf:type owl:ObjectProperty ;
        rdfs:domain <https://w3id.org/lcanet/activity#Flow> ;
        rdfs:range <https://w3id.org/lcanet/actor#Agent> ;
        rdfs:label "used by" .


