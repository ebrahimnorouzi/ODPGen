@prefix sotw: <https://w3id.org/sotw#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

sotw:EvaluationRequest a owl:Class ;
    rdfs:label "Evaluation Request"@en ;
    rdfs:comment "A pattern describing a request to evaluate whether an action over a target by a party should be permitted, possibly under additional contextual constraints."@en .

sotw:requestedAction a owl:ObjectProperty ;
    rdfs:domain sotw:EvaluationRequest ;
    rdfs:label "requested action"@en ;
    rdfs:comment "Links an evaluation request to the action being requested."@en .

sotw:requestingParty a owl:ObjectProperty ;
    rdfs:domain sotw:EvaluationRequest ;
    rdfs:label "requesting party"@en ;
    rdfs:comment "Links an evaluation request to the party issuing the request."@en .

sotw:requestedTarget a owl:ObjectProperty ;
    rdfs:domain sotw:EvaluationRequest ;
    rdfs:label "requested target"@en ;
    rdfs:comment "Links an evaluation request to the target asset or resource."@en .

sotw:context a owl:ObjectProperty ;
    rdfs:domain sotw:EvaluationRequest ;
    rdfs:label "context"@en ;
    rdfs:comment "Links an evaluation request to additional contextual constraints relevant to evaluation."@en .

dcterms:issued a owl:DatatypeProperty ;
    rdfs:domain sotw:EvaluationRequest ;
    rdfs:label "issued"@en ;
    rdfs:comment "The date and time at which the evaluation request was issued."@en .
