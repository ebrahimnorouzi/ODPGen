# ── LLM-as-a-Judge API Keys ──────────────────────────────────────────────────
# The judge model must NOT be the same family as the generating LLM.
# Supported judge backends: anthropic (Claude), openai (GPT-4o)

# Anthropic API key (for Claude judge)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (for GPT-4o judge)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API key (for Gemini judge)
GOOGLE_API_KEY=your_google_api_key_here

# ── Judge Configuration ──────────────────────────────────────────────────────
# Which judge model to use. Options:
#   claude-sonnet-4-6    (Anthropic)
#   claude-opus-4-6      (Anthropic — highest quality, slower)
#   gpt-4o               (OpenAI)
#   gemini-2.5-pro       (Google — recommended, free tier available)
#   gemini-2.5-flash     (Google — fast, free tier available)
JUDGE_MODEL=gemini-2.5-flash

# Temperature for judge calls (0.0 for maximum reproducibility)
JUDGE_TEMPERATURE=0.0
